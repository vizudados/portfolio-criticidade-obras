		formatString: 0.000
		displayFolder: Base\Nota
		lineageTag: 142a665b-571b-5f0d-ac45-0c209993043c

	/// PedidosNoPrazo ÷ PedidosPrevistos da base, arredondado em 8 casas; vazio sem PedidosPrevistos ou com a parte maior que o todo. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · X entregas' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _n = SUM ( fBaseObra[PedidosNoPrazo] )
			    VAR _d = SUM ( fBaseObra[PedidosPrevistos] )
			    RETURN
			        IF ( _d > 0 && NOT ISBLANK ( _n ) && _n >= 0 && _n <= _d, ROUND ( DIVIDE ( _n, _d ), 8 ) )
			)
		formatString: 0.00%
		displayFolder: Base\Nota
		lineageTag: b6df5d96-aff0-59fd-922b-8151ac22374c

	/// AprovadosPrimeira ÷ ServicosVerificados da base, arredondado em 8 casas; vazio sem ServicosVerificados ou com a parte maior que o todo. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · X inspeção' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _n = SUM ( fBaseObra[AprovadosPrimeira] )
			    VAR _d = SUM ( fBaseObra[ServicosVerificados] )
			    RETURN
			        IF ( _d > 0 && NOT ISBLANK ( _n ) && _n >= 0 && _n <= _d, ROUND ( DIVIDE ( _n, _d ), 8 ) )
