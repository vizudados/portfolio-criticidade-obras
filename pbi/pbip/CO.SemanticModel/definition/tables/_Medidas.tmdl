	/// 1 quando o mês do eixo é o do maior ou o do menor PPC da janela (o desenho escreve o valor nesses meses e no de referência quando não cabem todos); 0 nos demais.
	measure 'T3 · PPC · mês com rótulo' =
			VAR _m = MAX ( dMes[Mes] )
			RETURN
			    IF ( HASONEVALUE ( dMes[Mes] ), INT ( _m = [T3 · PPC · mês do maior · foco] || _m = [T3 · PPC · mês do menor · foco] ) )
		formatString: 0
