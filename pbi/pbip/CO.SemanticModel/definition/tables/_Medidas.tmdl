	/// Cartão de custo da obra em foco: IDC (valor agregado ÷ custo aplicado) e o resultado aplicado em R$, com a marca e os pontos do item custo da nota. Só lê contas · foco.
	measure 'T2 · Cartão custo · HTML' =
			-- 1 · Leituras
			VAR _idc = [IDC · foco]
			VAR _ra = [Resultado aplicado · foco]
			VAR _pto = [Nota · pontos custo · foco]
			VAR _pso = [Nota · possíveis · custo · foco]
			-- 2 · Textos
			VAR _tiN = FORMAT ( _idc, "0.00", "pt-BR" )
			VAR _tiTxt = IF ( ISBLANK ( _idc ), "—", _tiN )
			VAR _traA = ABS ( _ra )
			VAR _traNu = SWITCH ( TRUE (), _traA >= 99950000, FORMAT ( _traA / 1000000, "0.0", "pt-BR" ), _traA >= 999500, FORMAT ( _traA / 1000000, "0.00", "pt-BR" ), _traA >= 999.5, FORMAT ( _traA / 1000, "0", "pt-BR" ), FORMAT ( _traA, "#,0", "pt-BR" ) )
			VAR _traUn = SWITCH ( TRUE (), _traA >= 999500, " mi", _traA >= 999.5, " mil", "" )
			VAR _traN = _traNu & _traUn
			VAR _traZero = _traN = "0"
			VAR _traS = IF ( _traZero, "", SWITCH ( TRUE (), _ra < 0, "−", _ra > 0, "+", "" ) )
			VAR _traTxt = IF ( ISBLANK ( _ra ), "—", _traS & "R$ " & _traN )
			VAR _tkTxt = IF ( ISBLANK ( _pto ), "sem dado na planilha", "⁅" & FORMAT ( _pto, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _pso, "0.0#", "pt-BR" ) & "⁆" )
			VAR _txtCtx = IF ( ISBLANK ( _idc ), "sem aba no mês", IF ( IF ( ISBLANK ( _pto ), "", IF ( _pto >= _pso, "0", IF ( _pto = 0, "2", "1" ) ) ) = "", "", "<i class='a-pop mk mk" & IF ( ISBLANK ( _pto ), "", IF ( _pto >= _pso, "0", IF ( _pto = 0, "2", "1" ) ) ) & "' style='animation-delay:450ms'></i>" ) & "na nota, " & _tkTxt )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tiKP = LEN ( _tiN ) > 0
			VAR _tiKN = IF ( _tiKP, _tiN )
			VAR _tiKS = SUBSTITUTE ( SUBSTITUTE ( _tiKN, ".", "" ), ",", "" )
			VAR _tiKT = IFERROR ( VALUE ( _tiKS ), -1 )
			VAR _tiKOk = _tiKP && _tiKT >= 2 && FORMAT ( _tiKT, REPT ( "0", LEN ( _tiKS ) ) ) = _tiKS
			VAR _tiKD = IF ( CONTAINSSTRING ( _tiKN, "," ), LEN ( _tiKN ) - SEARCH ( ",", _tiKN ), 0 )
			VAR _tiKM = IF ( CONTAINSSTRING ( _tiKN, "." ), "#,##0", "0" ) & IF ( _tiKD > 0, "." & REPT ( "0", _tiKD ) )
			VAR _tiKOd =
			    IF (
			        _tiKOk,
			        "<o-d><o-v>" & _tiKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tiKN, FORMAT ( ROUND ( _tiKT * [@odf] / 1000, 0 ) / POWER ( 10, _tiKD ), _tiKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tiN
			    )
			VAR _tiOd = IF ( ISBLANK ( _idc ), _tiTxt, _tiKOd )
			VAR _traKP = LEN ( _traNu ) > 0
			VAR _traKN = IF ( _traKP, _traNu )
			VAR _traKS = SUBSTITUTE ( SUBSTITUTE ( _traKN, ".", "" ), ",", "" )
			VAR _traKT = IFERROR ( VALUE ( _traKS ), -1 )
			VAR _traKOk = _traKP && _traKT >= 2 && FORMAT ( _traKT, REPT ( "0", LEN ( _traKS ) ) ) = _traKS
			VAR _traKD = IF ( CONTAINSSTRING ( _traKN, "," ), LEN ( _traKN ) - SEARCH ( ",", _traKN ), 0 )
			VAR _traKM = IF ( CONTAINSSTRING ( _traKN, "." ), "#,##0", "0" ) & IF ( _traKD > 0, "." & REPT ( "0", _traKD ) )
			VAR _traKOd =
			    IF (
			        _traKOk,
			        "<o-d><o-v>" & _traKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _traKN, FORMAT ( ROUND ( _traKT * [@odf] / 1000, 0 ) / POWER ( 10, _traKD ), _traKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _traNu
			    )
			VAR _traOd = IF ( ISBLANK ( _ra ), _traTxt, _traS & "R$ " & _traKOd & _traUn )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Custo · IDC" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _tiOd & "</span>" & "<span class='b5 lado2" & IF ( _traS = "−", " ng", "" ) & "'>" & _traOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>Valor agregado ÷ custo aplicado (com a dívida). Ao lado, a diferença em R$.</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Análise Crítica</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Cartões
		lineageTag: dbda1d49-28ca-5f39-880f-73a70db9d735

	/// Cartão 'Nota da obra' da obra em foco no mês de referência (o escuro): a nota e o chip de status (crítico, atenção, estável; com a trava, o motivo) ou, sem a base completa, pendente com os pontos obtidos de quantos já dá para calcular. O verso diz a régua e as faixas de status (lidas das medidas). Só lê contas · foco.
	measure 'T2 · Cartão nota da obra · HTML' =
			-- 1 · Leituras
			VAR _nota = [Nota · nota final · ranking · foco]
			VAR _st = [Nota · status · ranking · foco]
			VAR _pend = [Nota · pendente · ranking · foco]
			VAR _ob = [Nota · pontos obtidos · ranking · foco]
			VAR _po = [Nota · pontos possíveis · ranking · foco]
			VAR _pe = [Nota · pontos perdidos · ranking · foco]
			VAR _faltB = [Nota · itens faltando na base · foco]
			VAR _faltP = [Nota · itens faltando na planilha · foco]
			VAR _fora = [Nota · itens fora da faixa · foco]
			VAR _trv = [Nota · trava · motivo · foco]
			VAR _fxC = [Nota · status · faixa crítico]
			VAR _fxA = [Nota · status · faixa atenção]
			VAR _fxE = [Nota · status · faixa estável]
			VAR _mesC = [Mês de referência · curto]
			-- 2 · Textos
			VAR _nN = FORMAT ( _nota, "0.0#", "pt-BR" )
			VAR _nOb = FORMAT ( _ob, "0.0#", "pt-BR" )
			VAR _nPo = FORMAT ( _po, "0.0#", "pt-BR" )
			VAR _nTxt = SWITCH ( TRUE (), _pend = 1, "pendente · " & _nOb & " de " & _nPo, ISBLANK ( _nota ), "—", "nota " & _nN )
			VAR _tpeTxt = IF ( ISBLANK ( _pe ), "—", FORMAT ( _pe, "0.0#", "pt-BR" ) )
			VAR _semObra = ISBLANK ( _nota ) && _pend <> 1
			VAR _txtFalt = SWITCH ( TRUE (), ( _fora + 0 ) > 0 && ( ( _faltB + 0 ) - ( _fora + 0 ) ) + ( _faltP + 0 ) > 0, IF ( ( ( _faltB + 0 ) - ( _fora + 0 ) ) + ( _faltP + 0 ) = 1, "falta 1", "faltam " & ( ( ( _faltB + 0 ) - ( _fora + 0 ) ) + ( _faltP + 0 ) ) ) & " · " & ( _fora + 0 ) & " fora", ( _fora + 0 ) > 0, IF ( ( _fora + 0 ) = 1, "1 item fora da faixa", ( _fora + 0 ) & " itens fora da faixa" ), SWITCH ( TRUE (), ( ( _faltB + 0 ) - ( _fora + 0 ) ) > 0 && ( _faltP + 0 ) > 0, "faltam " & ( ( ( _faltB + 0 ) - ( _fora + 0 ) ) + ( _faltP + 0 ) ) & " · " & ( _faltP + 0 ) & " da planilha", ( ( _faltB + 0 ) - ( _fora + 0 ) ) > 0, IF ( ( ( _faltB + 0 ) - ( _fora + 0 ) ) = 1, "falta 1 item na base", "faltam " & ( ( _faltB + 0 ) - ( _fora + 0 ) ) & " itens na base" ), ( _faltP + 0 ) > 0, IF ( ( _faltP + 0 ) = 1, "falta 1 item na planilha", "faltam " & ( _faltP + 0 ) & " itens na planilha" ), "" ) )
			VAR _chip = SUBSTITUTE ( IF ( IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) = "", "", "<span class='chip chip" & IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) & "'><i></i>" & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & "</span>" ), "<span class='chip ", "<span style='animation-delay:450ms' class='a-pop chip " )
			VAR _txtCtx =
			    SWITCH (
			        TRUE (),
			        _semObra, "sem aba no mês",
			        _pend = 1, _chip & "⁅" & _txtFalt & "⁆",
			        _trv & "" <> "", _chip & "trava de " & SUBSTITUTE ( _trv, "|", " e " ),
			        _chip & IF ( _pe = 0, "não perde ponto", "perde " & "⁅" & _tpeTxt & "⁆" & " pontos" )
			    )
			VAR _odV = IF ( _pend = 1, _ob, _nota )
			VAR _tnN = FORMAT ( _odV, "0.0#", "pt-BR" )
			VAR _tnTxt = IF ( _semObra, "—", _tnN )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tnKP = LEN ( _tnN ) > 0
			VAR _tnKN = IF ( _tnKP, _tnN )
			VAR _tnKS = SUBSTITUTE ( SUBSTITUTE ( _tnKN, ".", "" ), ",", "" )
			VAR _tnKT = IFERROR ( VALUE ( _tnKS ), -1 )
			VAR _tnKOk = _tnKP && _tnKT >= 2 && FORMAT ( _tnKT, REPT ( "0", LEN ( _tnKS ) ) ) = _tnKS
			VAR _tnKD = IF ( CONTAINSSTRING ( _tnKN, "," ), LEN ( _tnKN ) - SEARCH ( ",", _tnKN ), 0 )
			VAR _tnKM = IF ( CONTAINSSTRING ( _tnKN, "." ), "#,##0", "0" ) & IF ( _tnKD > 0, "." & REPT ( "0", _tnKD ) )
			VAR _tnKOd =
			    IF (
			        _tnKOk,
			        "<o-d><o-v>" & _tnKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tnKN, FORMAT ( ROUND ( _tnKT * [@odf] / 1000, 0 ) / POWER ( 10, _tnKD ), _tnKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tnN
			    )
			VAR _tnOd = IF ( ISBLANK ( _odV ), _tnTxt, _tnKOd )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc escuro' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Nota da obra · " & _mesC & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _tnOd & "</span>" & "<span class='b5 lado2'>" & IF ( _pend = 1, "de " & "⁅" & _nPo & "⁆", "" ) & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>Soma dos nove itens, de 0 a 10; IDC &lt; 0,90 ou atraso &gt; 3 meses: crítica.</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Planilha, base e cronograma</span></div>"
			            & "<div class='regua'>" & "<i class='mk mk2'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxC, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mk1'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxA, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mk0'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxE, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mkm'></i><span>pendente</span>" & "</div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Cartões
		lineageTag: 64092a13-ce4c-5877-9ea7-81beafdf7750

	/// Cartão de prazo da obra em foco: atraso em meses (cronograma agregado), término projetado e o executado acumulado, com a marca e a régua do item prazo da nota. Só lê contas · foco.
	measure 'T2 · Cartão prazo · HTML' =
			-- 1 · Leituras
			VAR _atr = [Prazo · atraso (meses) · foco]
			VAR _term = [Prazo · término projetado · foco]
			VAR _exec = [Físico · executado acumulado · foco]
			VAR _ptf = [Nota · pontos prazo · foco]
			VAR _psf = [Nota · possíveis · prazo · foco]
			-- 2 · Textos
			VAR _taN = FORMAT ( _atr, "0.0", "pt-BR" )
			VAR _taTxt = IF ( ISBLANK ( _atr ), "—", _taN )
			VAR _teN = FORMAT ( ABS ( _exec ) * 100, "0.0", "pt-BR" )
			VAR _teS = IF ( ROUND ( _exec * 100, 1 ) < 0, "−", "" )
			VAR _teTxt = IF ( ISBLANK ( _exec ), "—", _teS & _teN & "%" )
			VAR _txtLado = IF ( ISBLANK ( _atr ), "", IF ( ROUND ( _atr, 1 ) <= 1 && ROUND ( _atr, 1 ) >= -1, "mês", "meses" ) )
			VAR _txtCtx = IF ( ISBLANK ( _atr ), "sem curva prevista", IF ( IF ( ISBLANK ( _ptf ), "", IF ( _ptf >= _psf, "0", IF ( _ptf = 0, "2", "1" ) ) ) = "", "", "<i class='a-pop mk mk" & IF ( ISBLANK ( _ptf ), "", IF ( _ptf >= _psf, "0", IF ( _ptf = 0, "2", "1" ) ) ) & "' style='animation-delay:450ms'></i>" ) & "término " & FORMAT ( _term, "mmm/yy", "pt-BR" ) & " · " & "⁅" & _teTxt & "⁆" & " exec." )
			VAR _fx = SUBSTITUTE ( CALCULATE ( [Nota · item · faixas], dItemNota[Item] = "prazo" ), " · ", "|" )
			VAR _fx1 = SUBSTITUTE ( PATHITEM ( _fx, 1 ), "atraso ", "" )
			VAR _fx2c = SUBSTITUTE ( PATHITEM ( _fx, PATHLENGTH ( _fx ) ), "atraso ", "" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _taKP = LEN ( _taN ) > 0
			VAR _taKN = IF ( _taKP, _taN )
			VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
			VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
			VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
			VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
			VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
			VAR _taKOd =
			    IF (
			        _taKOk,
			        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _taN
			    )
			VAR _taOd = IF ( ISBLANK ( _atr ), _taTxt, _taKOd )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Prazo · atraso" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _taOd & "</span>" & "<span class='b5 lado2'>" & _txtLado & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>Meses atrás do cronograma: o executado de hoje é o previsto de quando.</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Planilha e cronograma</span></div>"
			            & "<div class='regua'>" & "<i class='mk mk0'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fx1, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mk2'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fx2c, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "</div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Cartões
		lineageTag: ea0403e5-8352-5cf2-b36a-efcf271bc4d2

	/// Cartão 'resultado' da obra em foco (frente e verso). Só lê contas · foco.
	measure 'T2 · Cartão resultado · HTML' =
			-- 1 · Leituras
			VAR _res = [Resultado da obra · foco]
			VAR _pct = [Resultado % · foco]
			VAR _ar = [A realizar · foco]
			VAR _mesC = [Mês de referência · curto]
			-- 2 · Textos
			VAR _trA = ABS ( _res )
			VAR _trNu = SWITCH ( TRUE (), _trA >= 99950000, FORMAT ( _trA / 1000000, "0.0", "pt-BR" ), _trA >= 999500, FORMAT ( _trA / 1000000, "0.00", "pt-BR" ), _trA >= 999.5, FORMAT ( _trA / 1000, "0", "pt-BR" ), FORMAT ( _trA, "#,0", "pt-BR" ) )
			VAR _trUn = SWITCH ( TRUE (), _trA >= 999500, " mi", _trA >= 999.5, " mil", "" )
			VAR _trN = _trNu & _trUn
			VAR _trZero = _trN = "0"
			VAR _trS = IF ( _trZero, "", IF ( _res < 0, "−", "" ) )
			VAR _trTxt = IF ( ISBLANK ( _res ), "—", _trS & "R$ " & _trN )
			VAR _tpN = FORMAT ( ABS ( _pct ) * 100, "0.00", "pt-BR" )
			VAR _tpS = SWITCH ( TRUE (), ROUND ( _pct * 100, 2 ) < 0, "−", ROUND ( _pct * 100, 2 ) > 0, "+", "" )
			VAR _tpTxt = IF ( ISBLANK ( _pct ), "—", _tpS & _tpN & "%" )
			VAR _tarA = ABS ( _ar )
			VAR _tarNu = SWITCH ( TRUE (), _tarA >= 99950000, FORMAT ( _tarA / 1000000, "0.0", "pt-BR" ), _tarA >= 999500, FORMAT ( _tarA / 1000000, "0.00", "pt-BR" ), _tarA >= 999.5, FORMAT ( _tarA / 1000, "0", "pt-BR" ), FORMAT ( _tarA, "#,0", "pt-BR" ) )
			VAR _tarUn = SWITCH ( TRUE (), _tarA >= 999500, " mi", _tarA >= 999.5, " mil", "" )
			VAR _tarN = _tarNu & _tarUn
			VAR _tarZero = _tarN = "0"
			VAR _tarS = IF ( _tarZero, "", IF ( _ar < 0, "−", "" ) )
			VAR _tarTxt = IF ( ISBLANK ( _ar ), "—", _tarS & "R$ " & _tarN )
			VAR _txtCtx = IF ( ISBLANK ( _res ), "sem aba no mês", "<span class='" & IF ( _tpS = "−", "ng", "" ) & "'>" & "⁅" & _tpTxt & "⁆" & "</span>" & " do orç. · " & "⁅" & _tarTxt & "⁆" & " a realizar" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _trKP = LEN ( _trNu ) > 0
			VAR _trKN = IF ( _trKP, _trNu )
			VAR _trKS = SUBSTITUTE ( SUBSTITUTE ( _trKN, ".", "" ), ",", "" )
			VAR _trKT = IFERROR ( VALUE ( _trKS ), -1 )
			VAR _trKOk = _trKP && _trKT >= 2 && FORMAT ( _trKT, REPT ( "0", LEN ( _trKS ) ) ) = _trKS
			VAR _trKD = IF ( CONTAINSSTRING ( _trKN, "," ), LEN ( _trKN ) - SEARCH ( ",", _trKN ), 0 )
			VAR _trKM = IF ( CONTAINSSTRING ( _trKN, "." ), "#,##0", "0" ) & IF ( _trKD > 0, "." & REPT ( "0", _trKD ) )
			VAR _trKOd =
			    IF (
			        _trKOk,
			        "<o-d><o-v>" & _trKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _trKN, FORMAT ( ROUND ( _trKT * [@odf] / 1000, 0 ) / POWER ( 10, _trKD ), _trKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _trNu
			    )
			VAR _trOd = IF ( ISBLANK ( _res ), _trTxt, _trS & "R$ " & _trKOd & _trUn )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Resultado da planilha · " & _mesC & "</p>"
			            & "<div class='linha1'><span class='b6 hero" & IF ( _trS = "−", " ng", "" ) & "'>" & _trOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>Como a planilha apresenta: o resultado aplicado mais o que ainda vai se realizar.</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Quadradinho da aba</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Cartões
		lineageTag: 792fac36-736d-5750-ba34-b5b5c99553d1

	/// Cartão 'sem estoque' da obra em foco (frente e verso). Só lê contas · foco.
	measure 'T2 · Cartão sem estoque · HTML' =
			-- 1 · Leituras
			VAR _sem = [Resultado sem ativos · foco]
			VAR _at = [Ativos não consumidos · foco]
			-- 2 · Textos
			VAR _tsA = ABS ( _sem )
			VAR _tsNu = SWITCH ( TRUE (), _tsA >= 99950000, FORMAT ( _tsA / 1000000, "0.0", "pt-BR" ), _tsA >= 999500, FORMAT ( _tsA / 1000000, "0.00", "pt-BR" ), _tsA >= 999.5, FORMAT ( _tsA / 1000, "0", "pt-BR" ), FORMAT ( _tsA, "#,0", "pt-BR" ) )
			VAR _tsUn = SWITCH ( TRUE (), _tsA >= 999500, " mi", _tsA >= 999.5, " mil", "" )
			VAR _tsN = _tsNu & _tsUn
			VAR _tsZero = _tsN = "0"
			VAR _tsS = IF ( _tsZero, "", IF ( _sem < 0, "−", "" ) )
			VAR _tsTxt = IF ( ISBLANK ( _sem ), "—", _tsS & "R$ " & _tsN )
			VAR _tatA = ABS ( _at )
			VAR _tatNu = SWITCH ( TRUE (), _tatA >= 99950000, FORMAT ( _tatA / 1000000, "0.0", "pt-BR" ), _tatA >= 999500, FORMAT ( _tatA / 1000000, "0.00", "pt-BR" ), _tatA >= 999.5, FORMAT ( _tatA / 1000, "0", "pt-BR" ), FORMAT ( _tatA, "#,0", "pt-BR" ) )
			VAR _tatUn = SWITCH ( TRUE (), _tatA >= 999500, " mi", _tatA >= 999.5, " mil", "" )
			VAR _tatN = _tatNu & _tatUn
			VAR _tatZero = _tatN = "0"
			VAR _tatS = IF ( _tatZero, "", IF ( _at < 0, "−", "" ) )
			VAR _tatTxt = IF ( ISBLANK ( _at ), "—", _tatS & "R$ " & _tatN )
			VAR _txtCtx = IF ( ISBLANK ( _sem ), "sem aba no mês", "⁅" & _tatTxt & "⁆" & " pagos e ainda não aplicados" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tsKP = LEN ( _tsNu ) > 0
			VAR _tsKN = IF ( _tsKP, _tsNu )
			VAR _tsKS = SUBSTITUTE ( SUBSTITUTE ( _tsKN, ".", "" ), ",", "" )
			VAR _tsKT = IFERROR ( VALUE ( _tsKS ), -1 )
			VAR _tsKOk = _tsKP && _tsKT >= 2 && FORMAT ( _tsKT, REPT ( "0", LEN ( _tsKS ) ) ) = _tsKS
			VAR _tsKD = IF ( CONTAINSSTRING ( _tsKN, "," ), LEN ( _tsKN ) - SEARCH ( ",", _tsKN ), 0 )
			VAR _tsKM = IF ( CONTAINSSTRING ( _tsKN, "." ), "#,##0", "0" ) & IF ( _tsKD > 0, "." & REPT ( "0", _tsKD ) )
			VAR _tsKOd =
			    IF (
			        _tsKOk,
			        "<o-d><o-v>" & _tsKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tsKN, FORMAT ( ROUND ( _tsKT * [@odf] / 1000, 0 ) / POWER ( 10, _tsKD ), _tsKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tsNu
			    )
			VAR _tsOd = IF ( ISBLANK ( _sem ), _tsTxt, _tsS & "R$ " & _tsKOd & _tsUn )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Sem estoque e adiantamentos" & "</p>"
			            & "<div class='linha1'><span class='b6 hero" & IF ( _tsS = "−", " ng", "" ) & "'>" & _tsOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>Resultado menos o pago e não aplicado: adiantamentos, estoque, equipamentos.</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Resultado menos itens 2 a 6</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Cartões
		lineageTag: c43b02c7-6118-55a5-87b7-74acc9a66a26

	/// CSS dos cartões da T2: o do cartão v2 com flip (camada comum) mais a marca de status antes do contexto (as cores da marca são as mesmas no cartão escuro) e o chip de status do cartão Nota da obra.
	measure 'T2 · Cartão · CSS' =
			-- 4 · Marcação
			[Comum · CSS cartão]
			    & ".kc .ctx .mk{margin-right:7px;vertical-align:-1px}.kc .ctx .chip{height:21px;margin:-1px 8px 0 0;vertical-align:top}"
		displayFolder: T2 Análise crítica\Cartões
		lineageTag: 0eff6795-7218-5e44-b4a4-4d7c61f37e32

	/// CSS da cascata v2 (uma entrada por degrau, colunas iguais).
	measure 'T2 · Cascata · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & "#htmlContent{display:flex!important;align-items:flex-start;width:100vw;height:100vh;padding:0!important}.htmlViewerEntry{display:block!important;flex:1 1 0;min-width:0;margin:0!imp"
			    & "ortant;padding:0!important}.cd{position:relative;height:282px}.cd .b{position:absolute;left:calc(50% - 28px);width:56px}.cd .b.k2{background:#0B0B0C}.cd .b.kd{background:#F7E3E3;bo"
			    & "x-shadow:inset 0 0 0 1px #C43737}.cd .b.kn{background:#C43737}.cd .b.kr{background:repeating-linear-gradient(135deg,#0B0B0C 0 2px,#FFFFFF 2px 6px);box-shadow:inset 0 0 0 1px #0B0B0"
			    & "C}.cd .lg{position:absolute;left:calc(50% + 28px);width:calc(100% - 56px);height:1px;background:rgba(59,59,63,.5)}.cd .z{position:absolute;left:0;right:0;height:1px;background:rgba"
			    & "(59,59,63,.6)}.cd .v{position:absolute;left:-10px;right:-10px;text-align:center;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;white-s"
			    & "pace:nowrap;font-variant-numeric:tabular-nums}.cd .n{position:absolute;left:0;right:0;top:249px;text-align:center;font-size:13px;line-height:16px;color:#3B3B3F}.cd:hover .b{filter:"
			    & "brightness(.94)}"
		displayFolder: T2 Análise crítica\Como o resultado se forma
		lineageTag: 85a652ca-f321-5497-9131-275f588e3612

	/// Um degrau da cascata por entrada (granularidade dDegrau): valor agregado em preto (soma), custo aplicado em vermelho-claro com contorno vermelho (desconta), resultado aplicado, a realizar hachurado (o que a planilha conta e ainda não aconteceu) e o resultado da planilha (resultados em preto; vermelho quando negativos). A barra vai da base ao topo do degrau na mesma escala (y 20–218); a ligação leva o nível ao próximo degrau; o zero atravessa as colunas. O mouse abre o tooltip do degrau.
	measure 'T2 · Cascata · HTML degrau' =
			-- 1 · Leituras
			VAR _deg = SELECTEDVALUE ( dDegrau[Degrau] )
			VAR _ordem = SELECTEDVALUE ( dDegrau[Ordem] )
			VAR _rot = SELECTEDVALUE ( dDegrau[Rotulo] )
			VAR _sinal = SELECTEDVALUE ( dDegrau[Sinal] )
			VAR _aparece = [Cascata · degrau · aparece · foco]
			VAR _v = [Cascata · degrau · valor · foco]
			VAR _base = [Cascata · degrau · base · foco]
			VAR _topo = [Cascata · degrau · topo · foco]
			VAR _max = [Cascata · escala · máximo · foco]
			VAR _min = [Cascata · escala · mínimo · foco]
			-- 2 · Textos
			VAR _tvA = ABS ( _v )
			VAR _tvNu = SWITCH ( TRUE (), _tvA >= 99950000, FORMAT ( _tvA / 1000000, "0.0", "pt-BR" ), _tvA >= 999500, FORMAT ( _tvA / 1000000, "0.00", "pt-BR" ), _tvA >= 999.5, FORMAT ( _tvA / 1000, "0", "pt-BR" ), FORMAT ( _tvA, "#,0", "pt-BR" ) )
			VAR _tvUn = SWITCH ( TRUE (), _tvA >= 999500, " mi", _tvA >= 999.5, " mil", "" )
			VAR _tvN = _tvNu & _tvUn
			VAR _tvZero = _tvN = "0"
			VAR _tvS = IF ( _tvZero, "", IF ( _v < 0, "−", "" ) )
			VAR _tvTxt = IF ( ISBLANK ( _v ), "—", _tvS & "R$ " & _tvN )
			VAR _sinalTxt = SWITCH ( TRUE (), _sinal > 0, "+", _sinal < 0, "−", "" )
			VAR _txtV = IF ( _sinal = 0 || _tvZero, _tvTxt, _sinalTxt & SUBSTITUTE ( _tvTxt, "−", "" ) )
			VAR _vermelho = IF ( _sinal = 0, _v < 0, _sinal < 0 && NOT _tvZero )
			VAR _txtRot =
			    SWITCH (
			        _deg,
			        "ValorAgregado", "Valor<br>agregado",
			        "CustoAplicado", "Custo<br>aplicado",
			        "ResultadoAplicado", "Resultado<br>aplicado",
			        "ARealizar", "A realizar",
			        "Resultado", "Resultado da<br>planilha",
			        _rot
			    )
			VAR _cls = SWITCH ( TRUE (), _sinal = 0, IF ( _v < 0, "kn", "k2" ), _sinal < 0, "kd", _deg = "ARealizar", "kr", "k2" )
			-- 3 · Geometria
			VAR _faixa = _max - _min -- geometria
			VAR _yTopo = 20 + ROUND ( DIVIDE ( _max - _topo, _faixa ) * 198, 0 ) -- geometria
			VAR _yBase = 20 + ROUND ( DIVIDE ( _max - _base, _faixa ) * 198, 0 ) -- geometria
			VAR _h = MAX ( _yBase - _yTopo, 2 ) -- geometria
			VAR _yZero = 20 + ROUND ( DIVIDE ( _max, _faixa ) * 198, 0 ) -- geometria
			VAR _yLig = IF ( _sinal < 0, _yBase, _yTopo ) -- geometria
			VAR _yRot = IF ( _sinal = 0 && _v < 0, _yTopo + _h + 4, _yTopo - 20 ) -- geometria
			VAR _atraso = ( _ordem - 1 ) * 110 -- geometria
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        _aparece = 1 && NOT ISBLANK ( _max ),
			        "<div class='u cd'>"
			            & "<i class='b " & _cls & "' style='top:" & _yTopo & "px;height:" & _h & "px' data-rk='" & _deg & "' data-rp='top,height' data-r0-top='" & _yLig & "px' data-r0-height='0px' data-rd='" & _atraso & "'></i>"
			            & "<i class='z a-gx' style='top:" & _yZero & "px;animation-delay:" & _atraso & "ms'></i>"
			            & IF ( _deg <> "Resultado", "<i class='lg a-gx' style='top:" & IF ( _sinal = 0, IF ( _v < 0, _yBase, _yTopo ), _yLig ) & "px;animation-delay:" & ( _atraso + 600 ) & "ms'></i>", "" )
			            & "<span class='v" & IF ( _vermelho, " ng", "" ) & "' style='top:" & _yRot & "px'>" & "⁅" & _txtV & "⁆" & "</span>"
			            & "<span class='n a-fd' style='animation-delay:" & _atraso & "ms'>" & _txtRot & "</span>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Como o resultado se forma
		lineageTag: dda7c80d-6da7-5a96-b0c7-f491859aec36

