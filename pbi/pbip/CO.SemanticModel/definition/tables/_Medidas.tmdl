	/// Resultado ÷ orçamento (na carteira, soma ÷ soma).
	measure 'Resultado %' =
			DIVIDE ( [Resultado da obra], [Orçamento] )
		formatString: 0.00%
		displayFolder: Base\Obra
		lineageTag: 35ef68c0-e888-5e38-ac55-6907fda8b63d

	/// Resultado da aba anterior ÷ orçamento da aba anterior.
	measure 'Resultado % · mês anterior' =
			DIVIDE ( [Resultado · mês anterior], [Orçamento · mês anterior] )
		formatString: 0.00%
		displayFolder: Base\Obra
		lineageTag: 27431abc-6ac9-56f4-8a50-87638f3e8ddd

	/// Valor agregado (crédito do orçamento) − custo aplicado: o resultado da planilha sem o que ainda é promessa (saldo de contrato e equipamentos). Na carteira, soma.
	measure 'Resultado aplicado' =
			VAR _ca = [Custo aplicado]
			RETURN
			    IF ( NOT ISBLANK ( _ca ), [Crédito do orçamento] - _ca )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Base\Obra
		lineageTag: 2f32d59a-ea9b-5bc3-816d-1dd12308606c

	/// Resultado aplicado ÷ orçamento (na carteira, soma ÷ soma).
