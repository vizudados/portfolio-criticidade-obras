	/// Cartão 'Desembolso do mês': desembolsado, desvio sobre o previsto (só as obras com previsto; preto também quando negativo) e o previsto; verso com a régua da previsão de caixa da nota (o desvio de cada obra, para mais ou para menos; rótulos lidos das contas). Só lê contas · ref.
	measure 'T4 · Cartão desembolso · HTML' =
			-- 1 · Leituras
			VAR _des = [Desembolso · realizado no mês · ref]
			VAR _prev = [Desembolso · previsto no mês · ref]
			VAR _desv = [T4 · Desembolso · desvio no mês · com previsto · ref]
			VAR _fx = [T4 · Desembolso · faixas do fluxo de caixa (lista)]
			-- 2 · Textos
			VAR _tdA = ABS ( _des )
			VAR _tdNu = SWITCH ( TRUE (), _tdA >= 99950000, FORMAT ( _tdA / 1000000, "0.0", "pt-BR" ), _tdA >= 999500, FORMAT ( _tdA / 1000000, "0.00", "pt-BR" ), _tdA >= 999.5, FORMAT ( _tdA / 1000, "0", "pt-BR" ), FORMAT ( _tdA, "#,0", "pt-BR" ) )
			VAR _tdUn = SWITCH ( TRUE (), _tdA >= 999500, " mi", _tdA >= 999.5, " mil", "" )
			VAR _tdN = _tdNu & _tdUn
			VAR _tdZero = _tdN = "0"
			VAR _tdS = IF ( _tdZero, "", IF ( _des < 0, "−", "" ) )
			VAR _tdTxt = IF ( ISBLANK ( _des ), "—", _tdS & "R$ " & _tdN )
			VAR _tpA = ABS ( _prev )
			VAR _tpNu = SWITCH ( TRUE (), _tpA >= 99950000, FORMAT ( _tpA / 1000000, "0.0", "pt-BR" ), _tpA >= 999500, FORMAT ( _tpA / 1000000, "0.00", "pt-BR" ), _tpA >= 999.5, FORMAT ( _tpA / 1000, "0", "pt-BR" ), FORMAT ( _tpA, "#,0", "pt-BR" ) )
			VAR _tpUn = SWITCH ( TRUE (), _tpA >= 999500, " mi", _tpA >= 999.5, " mil", "" )
			VAR _tpN = _tpNu & _tpUn
			VAR _tpZero = _tpN = "0"
			VAR _tpS = IF ( _tpZero, "", IF ( _prev < 0, "−", "" ) )
			VAR _tpTxt = IF ( ISBLANK ( _prev ), "—", _tpS & "R$ " & _tpN )
			VAR _tvN = FORMAT ( ABS ( _desv ) * 100, "0", "pt-BR" )
			VAR _tvS = SWITCH ( TRUE (), ROUND ( _desv * 100, 0 ) < 0, "−", ROUND ( _desv * 100, 0 ) > 0, "+", "" )
			VAR _tvTxt = IF ( ISBLANK ( _desv ), "—", _tvS & _tvN & "%" )
			VAR _txtCtx = "⁅" & _tpTxt & "⁆" & " previsto para o mês"
			VAR _txtRegra = "Desembolsado ÷ previsto − 1. Na nota, por obra, para mais ou para menos:"
			VAR _fxN = IF ( ISBLANK ( _fx ), 0, PATHLENGTH ( _fx ) )
			/* da faixa crítica (vermelha) à de pontos cheios (sálvia) */
			VAR _htmlRegua =
			    CONCATENATEX (
			        GENERATESERIES ( 1, _fxN ),
			        "<i class='mk mk" & SWITCH ( TRUE (), [Value] = 1, 2, [Value] = _fxN, 0, 1 ) & "'></i><span>"
			            & PATHITEM ( _fx, [Value] ) & "</span>",
			        "",
			        [Value], ASC
			    ) /* lista */
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tdKP = LEN ( _tdNu ) > 0
			VAR _tdKN = IF ( _tdKP, _tdNu )
			VAR _tdKS = SUBSTITUTE ( SUBSTITUTE ( _tdKN, ".", "" ), ",", "" )
			VAR _tdKT = IFERROR ( VALUE ( _tdKS ), -1 )
			VAR _tdKOk = _tdKP && _tdKT >= 2 && FORMAT ( _tdKT, REPT ( "0", LEN ( _tdKS ) ) ) = _tdKS
			VAR _tdKD = IF ( CONTAINSSTRING ( _tdKN, "," ), LEN ( _tdKN ) - SEARCH ( ",", _tdKN ), 0 )
			VAR _tdKM = IF ( CONTAINSSTRING ( _tdKN, "." ), "#,##0", "0" ) & IF ( _tdKD > 0, "." & REPT ( "0", _tdKD ) )
			VAR _tdKOd =
			    IF (
			        _tdKOk,
			        "<o-d><o-v>" & _tdKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdKN, FORMAT ( ROUND ( _tdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdKD ), _tdKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdNu
			    )
			VAR _tdOd = IF ( ISBLANK ( _des ), _tdTxt, _tdS & "R$ " & _tdKOd & _tdUn )
			VAR _tvKP = LEN ( _tvN ) > 0
			VAR _tvKN = IF ( _tvKP, _tvN )
			VAR _tvKS = SUBSTITUTE ( SUBSTITUTE ( _tvKN, ".", "" ), ",", "" )
			VAR _tvKT = IFERROR ( VALUE ( _tvKS ), -1 )
			VAR _tvKOk = _tvKP && _tvKT >= 2 && FORMAT ( _tvKT, REPT ( "0", LEN ( _tvKS ) ) ) = _tvKS
			VAR _tvKD = IF ( CONTAINSSTRING ( _tvKN, "," ), LEN ( _tvKN ) - SEARCH ( ",", _tvKN ), 0 )
			VAR _tvKM = IF ( CONTAINSSTRING ( _tvKN, "." ), "#,##0", "0" ) & IF ( _tvKD > 0, "." & REPT ( "0", _tvKD ) )
			VAR _tvKOd =
			    IF (
			        _tvKOk,
			        "<o-d><o-v>" & _tvKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tvKN, FORMAT ( ROUND ( _tvKT * [@odf] / 1000, 0 ) / POWER ( 10, _tvKD ), _tvKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tvN
			    )
			VAR _tvOd = IF ( ISBLANK ( _desv ), _tvTxt, _tvS & _tvKOd & "%" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Desembolso do mês" & "</p>"
			            & "<div class='linha1'><span class='b6 hero" & "" & "'>" & _tdOd & "</span>" & "<span class='b5 lado2" & "" & "'>" & _tvOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Previsto e desembolsado</span></div>"
			            & "<div class='regua'>" & _htmlRegua & "</div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Cartões
		lineageTag: 8be43f51-42e1-5924-9139-31748f1bf2e4

	/// Cartão 'Custo · IDC da carteira' (F3, no lugar do 'Mês anterior'): o IDC da carteira (valor agregado ÷ custo aplicado, soma ÷ soma) e o resultado aplicado em R$ ao lado (vermelho quando negativo); na linha de baixo, a variação do IDC no mês (vermelha quando cai) e quantas obras estão com IDC abaixo de 1. Só lê contas · ref.
	measure 'T4 · Cartão IDC · HTML' =
			-- 1 · Leituras
			VAR _idc = [IDC · ref]
			VAR _var = [T4 · IDC · variação no mês · ref]
			VAR _ra = [Resultado aplicado · ref]
			VAR _abx = [T1 · Custo · obras com IDC abaixo de 1 · ref]
			-- 2 · Textos
			VAR _tiN = FORMAT ( _idc, "0.00", "pt-BR" )
			VAR _tiTxt = IF ( ISBLANK ( _idc ), "—", _tiN )
			VAR _traA = ABS ( _ra )
			VAR _traNu = SWITCH ( TRUE (), _traA >= 99950000, FORMAT ( _traA / 1000000, "0.0", "pt-BR" ), _traA >= 999500, FORMAT ( _traA / 1000000, "0.00", "pt-BR" ), _traA >= 999.5, FORMAT ( _traA / 1000, "0", "pt-BR" ), FORMAT ( _traA, "#,0", "pt-BR" ) )
			VAR _traUn = SWITCH ( TRUE (), _traA >= 999500, " mi", _traA >= 999.5, " mil", "" )
			VAR _traN = _traNu & _traUn
			VAR _traZero = _traN = "0"
			VAR _traS = IF ( _traZero, "", SWITCH ( TRUE (), _ra < 0, "−", _ra > 0, "+", "" ) )
			VAR _traTxt = IF ( ISBLANK ( _ra ), "—", _traS & "R$ " & _traN )
			VAR _tvTxt = IF ( ISBLANK ( _var ), "", SWITCH ( TRUE (), _var > 0, "+", _var < 0, "−", "" ) & "⁅" & FORMAT ( ABS ( _var ), "0.00", "pt-BR" ) & "⁆" & " no mês · " )
			VAR _a = _abx + 0
			VAR _txtCtx = IF ( ISBLANK ( _idc ), "sem aba no mês", "<span class='" & IF ( _var < 0, "ng", "" ) & "'>" & _tvTxt & "</span>" & IF ( _a = 0, "nenhuma obra abaixo de 1", IF ( _a = 1, "1 obra abaixo de 1", "⁅" & _a & "⁆" & " obras abaixo de 1" ) ) )
			VAR _txtRegra = "Valor agregado ÷ custo aplicado, com as obras somadas (com a dívida). Ao lado, o resultado aplicado em R$."
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tiKP = LEN ( _tiN ) > 0
			VAR _tiKN = IF ( _tiKP, _tiN )
			VAR _tiKS = SUBSTITUTE ( SUBSTITUTE ( _tiKN, ".", "" ), ",", "" )
			VAR _tiKT = IFERROR ( VALUE ( _tiKS ), -1 )
			VAR _tiKOk = _tiKP && _tiKT >= 2 && FORMAT ( _tiKT, REPT ( "0", LEN ( _tiKS ) ) ) = _tiKS
			VAR _tiKD = IF ( CONTAINSSTRING ( _tiKN, "," ), LEN ( _tiKN ) - SEARCH ( ",", _tiKN ), 0 )
			VAR _tiKM = IF ( CONTAINSSTRING ( _tiKN, "." ), "#,##0", "0" ) & IF ( _tiKD > 0, "." & REPT ( "0", _tiKD ) )
			VAR _tiKOd =
			    IF (
			        _tiKOk,
			        "<o-d><o-v>" & _tiKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tiKN, FORMAT ( ROUND ( _tiKT * [@odf] / 1000, 0 ) / POWER ( 10, _tiKD ), _tiKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tiN
			    )
			VAR _tiOd = IF ( ISBLANK ( _idc ), _tiTxt, _tiKOd )
			VAR _traKP = LEN ( _traNu ) > 0
			VAR _traKN = IF ( _traKP, _traNu )
			VAR _traKS = SUBSTITUTE ( SUBSTITUTE ( _traKN, ".", "" ), ",", "" )
			VAR _traKT = IFERROR ( VALUE ( _traKS ), -1 )
			VAR _traKOk = _traKP && _traKT >= 2 && FORMAT ( _traKT, REPT ( "0", LEN ( _traKS ) ) ) = _traKS
			VAR _traKD = IF ( CONTAINSSTRING ( _traKN, "," ), LEN ( _traKN ) - SEARCH ( ",", _traKN ), 0 )
			VAR _traKM = IF ( CONTAINSSTRING ( _traKN, "." ), "#,##0", "0" ) & IF ( _traKD > 0, "." & REPT ( "0", _traKD ) )
			VAR _traKOd =
			    IF (
			        _traKOk,
			        "<o-d><o-v>" & _traKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _traKN, FORMAT ( ROUND ( _traKT * [@odf] / 1000, 0 ) / POWER ( 10, _traKD ), _traKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _traNu
			    )
			VAR _traOd = IF ( ISBLANK ( _ra ), _traTxt, _traS & "R$ " & _traKOd & _traUn )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Custo · IDC da carteira" & "</p>"
			            & "<div class='linha1'><span class='b6 hero" & "" & "'>" & _tiOd & "</span>" & "<span class='b5 lado2" & IF ( _traS = "−", " ng", "" ) & "'>" & _traOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Análise Crítica</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Cartões
		lineageTag: 0a0b019f-2914-5d4d-b6fe-080a1e7f80cf

	/// Cartão 'Justificativas do mês': preenchidas entre as exigidas (desvio do desembolso acima de ±10%) e, numa linha só, quais obras deixaram em branco (do maior para o menor |desvio|, sem cortar nome: todas, as 2 primeiras e 'e mais M', ou nenhuma, com 'todas em branco' / 'N em branco'). Só lê contas · ref.
	measure 'T4 · Cartão justificativas · HTML' =
			-- 1 · Leituras
			VAR _ex = [Carteira · justificativas exigidas · ref]
			VAR _pre = [Carteira · justificativas preenchidas · ref]
			VAR _br = [Carteira · justificativas em branco · ref]
			VAR _lista = [Recorte · justificativas em branco (lista) · ref]
			VAR _fora = [Recorte · justificativas em branco fora da lista curta · ref]
			-- 2 · Textos
			VAR _e = _ex + 0
			VAR _p = _pre + 0
			VAR _b = _br + 0
			VAR _tjN = FORMAT ( _p, "#,0", "pt-BR" )
			VAR _tjTxt = IF ( ISBLANK ( _p ), "0", _tjN )
			VAR _txtLado = IF ( _e = 0, "exigidas", "de " & "⁅" & _e & "⁆" & IF ( _e = 1, " exigida", " exigidas" ) )
			VAR _pxCtx = 241 -- geometria
			/* nomes em branco numa linha só, sem cortar nome: todos; senão os 2 primeiros e 'e mais M'; senão nenhum (justificativas_rodape.py) */
			VAR _nbN = IF ( ISBLANK ( _lista ) || _lista = "", 0, PATHLENGTH ( _lista ) )
			VAR _nbPos = IF ( _nbN >= 2, FIND ( "§", SUBSTITUTE ( _lista, "|", "§", _nbN - 1 ) ) )
			VAR _nbTodos =
			    IF (
			        _nbN <= 1,
			        _lista,
			        SUBSTITUTE ( LEFT ( _lista, _nbPos - 1 ), "|", ", " ) & " e " & MID ( _lista, _nbPos + 1, 999 )
			    )
			VAR _nbCorte = FIND ( "§", SUBSTITUTE ( _lista & "|", "|", "§", 2 ), 1, LEN ( _lista ) + 1 )
			VAR _nbPrimeiros = LEFT ( _lista, _nbCorte - 1 )
			VAR _nbResto = IF ( _fora = _p, IF ( _fora = 1, " e outra", " e outras" ), " e mais " & _fora )
			VAR _nbSemTodos = SUBSTITUTE ( _lista, "|", "" )
			VAR _nbSemPrimeiros = SUBSTITUTE ( _nbPrimeiros, "|", "" )
			VAR _nbPxNomesTodosCar = GENERATESERIES ( 1, LEN ( _nbSemTodos ) + 0 )
			VAR _nbPxNomesTodos =
			    SUMX ( _nbPxNomesTodosCar, /* lista */ -- geometria
			        SWITCH (
			            MID ( _nbSemTodos, [Value], 1 ),
			            " ", 3.6, "A", 8.4, "B", 7.5, "C", 7.8, "D", 9.2, "E", 6.6, "F", 6.4, "G", 9.0, "H", 9.3, "I", 3.5,
			            "J", 4.2, "K", 7.6, "L", 6.2, "M", 11.7, "N", 9.8, "O", 9.8, "P", 7.3, "Q", 9.8, "R", 7.8, "S", 7.0,
			            "T", 7.1, "U", 9.0, "V", 8.1, "W", 12.2, "X", 7.7, "Y", 7.2, "Z", 7.5, "Á", 8.4, "Ã", 8.4, "Â", 8.4,
			            "À", 8.4, "É", 6.6, "Ê", 6.6, "Í", 3.5, "Ó", 9.8, "Õ", 9.8, "Ô", 9.8, "Ú", 9.0, "Ç", 7.8,
			            8
			        )
			    )
			VAR _nbPxNomesPrimeirosCar = GENERATESERIES ( 1, LEN ( _nbSemPrimeiros ) + 0 )
			VAR _nbPxNomesPrimeiros =
			    SUMX ( _nbPxNomesPrimeirosCar, /* lista */ -- geometria
			        SWITCH (
			            MID ( _nbSemPrimeiros, [Value], 1 ),
			            " ", 3.6, "A", 8.4, "B", 7.5, "C", 7.8, "D", 9.2, "E", 6.6, "F", 6.4, "G", 9.0, "H", 9.3, "I", 3.5,
			            "J", 4.2, "K", 7.6, "L", 6.2, "M", 11.7, "N", 9.8, "O", 9.8, "P", 7.3, "Q", 9.8, "R", 7.8, "S", 7.0,
			            "T", 7.1, "U", 9.0, "V", 8.1, "W", 12.2, "X", 7.7, "Y", 7.2, "Z", 7.5, "Á", 8.4, "Ã", 8.4, "Â", 8.4,
			            "À", 8.4, "É", 6.6, "Ê", 6.6, "Í", 3.5, "Ó", 9.8, "Õ", 9.8, "Ô", 9.8, "Ú", 9.0, "Ç", 7.8,
			            8
			        )
			    )
			VAR _nbPxTodos = ROUND ( _nbPxNomesTodos + 7 * MAX ( _nbN - 2, 0 ) + IF ( _nbN >= 2, 14, 0 ), 0 ) -- geometria
			VAR _nbPxResto =
			    SWITCH (
			        TRUE (),
			        _fora <> _p, 51 + 7 * ( LEN ( _fora & "" ) - 1 ), -- geometria
			        _fora = 1, 41,
			        50
			    )
			VAR _nbPxPrimeiros = ROUND ( _nbPxNomesPrimeiros + 7 * 1 + _nbPxResto, 0 ) -- geometria
			VAR _nbPxCabe = ROUND ( _pxCtx, 0 ) - 68 -- geometria
			VAR _nbTxt =
			    SWITCH (
			        TRUE (),
			        _b = 0, "nenhuma em branco",
			        _nbPxTodos <= _nbPxCabe, "em branco: " & _nbTodos,
			        _nbN > 2 && _nbPxPrimeiros <= _nbPxCabe,
			            "em branco: " & SUBSTITUTE ( _nbPrimeiros, "|", ", " ) & _nbResto,
			        _p = 0, "todas em branco",
			        _b = _p, "as outras em branco",
			        _b & " em branco"
			    )
			VAR _txtCtx =
			    SWITCH (
			        TRUE (),
			        _e = 0, "nenhuma exigida: tudo dentro de ±10%",
			        _b = 0, "todas as exigidas preenchidas",
			        "⁅" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nbTxt, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "⁆"
			    )
			VAR _txtRegra = "Obras acima de ±10% no mês (exigida) e quantas preencheram o campo; nomes do maior ao menor desvio."
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tjKP = LEN ( _tjN ) > 0
			VAR _tjKN = IF ( _tjKP, _tjN )
			VAR _tjKS = SUBSTITUTE ( SUBSTITUTE ( _tjKN, ".", "" ), ",", "" )
			VAR _tjKT = IFERROR ( VALUE ( _tjKS ), -1 )
			VAR _tjKOk = _tjKP && _tjKT >= 2 && FORMAT ( _tjKT, REPT ( "0", LEN ( _tjKS ) ) ) = _tjKS
			VAR _tjKD = IF ( CONTAINSSTRING ( _tjKN, "," ), LEN ( _tjKN ) - SEARCH ( ",", _tjKN ), 0 )
			VAR _tjKM = IF ( CONTAINSSTRING ( _tjKN, "." ), "#,##0", "0" ) & IF ( _tjKD > 0, "." & REPT ( "0", _tjKD ) )
			VAR _tjKOd =
			    IF (
			        _tjKOk,
			        "<o-d><o-v>" & _tjKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tjKN, FORMAT ( ROUND ( _tjKT * [@odf] / 1000, 0 ) / POWER ( 10, _tjKD ), _tjKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tjN
			    )
			VAR _tjOd = IF ( ISBLANK ( _p ), _tjTxt, _tjKOd )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Justificativas do mês" & "</p>"
			            & "<div class='linha1'><span class='b6 hero" & "" & "'>" & _tjOd & "</span>" & "<span class='b5 lado2" & "" & "'>" & _txtLado & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Justificativa, cada aba</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Cartões
		lineageTag: 28437911-161f-5fd1-90a1-8f405e1d342d

	/// Cartão 'Resultado da carteira' (o escuro, a resposta): resultado da planilha no mês e % do orçamento (vermelho sobre preto quando negativos), obras e orçamento; verso com a regra (aplicado + a realizar). Só lê contas · ref.
	measure 'T4 · Cartão resultado · HTML' =
			-- 1 · Leituras
			VAR _res = [Resultado da obra · ref]
			VAR _pct = [Resultado % · ref]
			VAR _orc = [Orçamento · ref]
			VAR _n = [Obras com análise · ref]
			VAR _mesC = [Mês de referência · curto]
			-- 2 · Textos
			VAR _trA = ABS ( _res )
			VAR _trNu = SWITCH ( TRUE (), _trA >= 99950000, FORMAT ( _trA / 1000000, "0.0", "pt-BR" ), _trA >= 999500, FORMAT ( _trA / 1000000, "0.00", "pt-BR" ), _trA >= 999.5, FORMAT ( _trA / 1000, "0", "pt-BR" ), FORMAT ( _trA, "#,0", "pt-BR" ) )
			VAR _trUn = SWITCH ( TRUE (), _trA >= 999500, " mi", _trA >= 999.5, " mil", "" )
			VAR _trN = _trNu & _trUn
			VAR _trZero = _trN = "0"
			VAR _trS = IF ( _trZero, "", IF ( _res < 0, "−", "" ) )
			VAR _trTxt = IF ( ISBLANK ( _res ), "—", _trS & "R$ " & _trN )
			VAR _tpN = FORMAT ( ABS ( _pct ) * 100, "0.00", "pt-BR" )
			VAR _tpS = SWITCH ( TRUE (), ROUND ( _pct * 100, 2 ) < 0, "−", ROUND ( _pct * 100, 2 ) > 0, "+", "" )
			VAR _tpTxt = IF ( ISBLANK ( _pct ), "—", _tpS & _tpN & "%" )
			VAR _toA = ABS ( _orc )
			VAR _toNu = SWITCH ( TRUE (), _toA >= 99950000, FORMAT ( _toA / 1000000, "0.0", "pt-BR" ), _toA >= 999500, FORMAT ( _toA / 1000000, "0.00", "pt-BR" ), _toA >= 999.5, FORMAT ( _toA / 1000, "0", "pt-BR" ), FORMAT ( _toA, "#,0", "pt-BR" ) )
			VAR _toUn = SWITCH ( TRUE (), _toA >= 999500, " mi", _toA >= 999.5, " mil", "" )
			VAR _toN = _toNu & _toUn
			VAR _toZero = _toN = "0"
			VAR _toS = IF ( _toZero, "", IF ( _orc < 0, "−", "" ) )
			VAR _toTxt = IF ( ISBLANK ( _orc ), "—", _toS & "R$ " & _toN )
			VAR _txtN = IF ( _n = 1, "1 obra", "⁅" & _n & "⁆" & " obras" )
			VAR _txtCtx = _txtN & " · " & "⁅" & _toTxt & "⁆" & " de orçamento"
			VAR _txtRegra = "Soma " & IF ( _n = 1, "da obra", "das " & "⁅" & _n & "⁆" & " obras" ) & ", como a planilha apresenta: o resultado aplicado mais o que ainda vai se realizar."
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _trKP = LEN ( _trNu ) > 0
			VAR _trKN = IF ( _trKP, _trNu )
			VAR _trKS = SUBSTITUTE ( SUBSTITUTE ( _trKN, ".", "" ), ",", "" )
			VAR _trKT = IFERROR ( VALUE ( _trKS ), -1 )
			VAR _trKOk = _trKP && _trKT >= 2 && FORMAT ( _trKT, REPT ( "0", LEN ( _trKS ) ) ) = _trKS
			VAR _trKD = IF ( CONTAINSSTRING ( _trKN, "," ), LEN ( _trKN ) - SEARCH ( ",", _trKN ), 0 )
			VAR _trKM = IF ( CONTAINSSTRING ( _trKN, "." ), "#,##0", "0" ) & IF ( _trKD > 0, "." & REPT ( "0", _trKD ) )
			VAR _trKOd =
			    IF (
			        _trKOk,
			        "<o-d><o-v>" & _trKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _trKN, FORMAT ( ROUND ( _trKT * [@odf] / 1000, 0 ) / POWER ( 10, _trKD ), _trKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _trNu
			    )
			VAR _trOd = IF ( ISBLANK ( _res ), _trTxt, _trS & "R$ " & _trKOd & _trUn )
			VAR _tpKP = LEN ( _tpN ) > 0
			VAR _tpKN = IF ( _tpKP, _tpN )
			VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
			VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
			VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
			VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
			VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
			VAR _tpKOd =
			    IF (
			        _tpKOk,
			        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpN
			    )
			VAR _tpOd = IF ( ISBLANK ( _pct ), _tpTxt, _tpS & _tpKOd & "%" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc escuro' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Resultado da carteira · " & _mesC & "</p>"
			            & "<div class='linha1'><span class='b6 hero" & IF ( _trS = "−", " ng", "" ) & "'>" & _trOd & "</span>" & "<span class='b5 lado2" & IF ( _tpS = "−", " ng", "" ) & "'>" & _tpOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Quadradinho da aba</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Cartões
		lineageTag: e1456fe3-d8c3-5986-997f-b69b472a6b60

	/// Cartão 'Sem estoque e adiantamentos': o resultado sem o que foi pago e não aplicado (vermelho quando negativo). Só lê contas · ref.
	measure 'T4 · Cartão sem estoque · HTML' =
			-- 1 · Leituras
			VAR _sem = [Resultado sem ativos · ref]
			VAR _ativos = [Ativos não consumidos · ref]
			-- 2 · Textos
			VAR _tsA = ABS ( _sem )
			VAR _tsNu = SWITCH ( TRUE (), _tsA >= 99950000, FORMAT ( _tsA / 1000000, "0.0", "pt-BR" ), _tsA >= 999500, FORMAT ( _tsA / 1000000, "0.00", "pt-BR" ), _tsA >= 999.5, FORMAT ( _tsA / 1000, "0", "pt-BR" ), FORMAT ( _tsA, "#,0", "pt-BR" ) )
			VAR _tsUn = SWITCH ( TRUE (), _tsA >= 999500, " mi", _tsA >= 999.5, " mil", "" )
			VAR _tsN = _tsNu & _tsUn
			VAR _tsZero = _tsN = "0"
			VAR _tsS = IF ( _tsZero, "", IF ( _sem < 0, "−", "" ) )
			VAR _tsTxt = IF ( ISBLANK ( _sem ), "—", _tsS & "R$ " & _tsN )
			VAR _taA = ABS ( _ativos )
			VAR _taNu = SWITCH ( TRUE (), _taA >= 99950000, FORMAT ( _taA / 1000000, "0.0", "pt-BR" ), _taA >= 999500, FORMAT ( _taA / 1000000, "0.00", "pt-BR" ), _taA >= 999.5, FORMAT ( _taA / 1000, "0", "pt-BR" ), FORMAT ( _taA, "#,0", "pt-BR" ) )
			VAR _taUn = SWITCH ( TRUE (), _taA >= 999500, " mi", _taA >= 999.5, " mil", "" )
			VAR _taN = _taNu & _taUn
			VAR _taZero = _taN = "0"
			VAR _taS = IF ( _taZero, "", IF ( _ativos < 0, "−", "" ) )
			VAR _taTxt = IF ( ISBLANK ( _ativos ), "—", _taS & "R$ " & _taN )
			VAR _txtCtx = "⁅" & _taTxt & "⁆" & " pagos e ainda não aplicados"
			VAR _txtRegra = "Resultado menos o que foi pago e ainda não virou obra: estoque e adiantamentos."
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tsKP = LEN ( _tsNu ) > 0
			VAR _tsKN = IF ( _tsKP, _tsNu )
			VAR _tsKS = SUBSTITUTE ( SUBSTITUTE ( _tsKN, ".", "" ), ",", "" )
			VAR _tsKT = IFERROR ( VALUE ( _tsKS ), -1 )
			VAR _tsKOk = _tsKP && _tsKT >= 2 && FORMAT ( _tsKT, REPT ( "0", LEN ( _tsKS ) ) ) = _tsKS
			VAR _tsKD = IF ( CONTAINSSTRING ( _tsKN, "," ), LEN ( _tsKN ) - SEARCH ( ",", _tsKN ), 0 )
			VAR _tsKM = IF ( CONTAINSSTRING ( _tsKN, "." ), "#,##0", "0" ) & IF ( _tsKD > 0, "." & REPT ( "0", _tsKD ) )
			VAR _tsKOd =
			    IF (
			        _tsKOk,
			        "<o-d><o-v>" & _tsKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tsKN, FORMAT ( ROUND ( _tsKT * [@odf] / 1000, 0 ) / POWER ( 10, _tsKD ), _tsKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tsNu
			    )
			VAR _tsOd = IF ( ISBLANK ( _sem ), _tsTxt, _tsS & "R$ " & _tsKOd & _tsUn )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Sem estoque e adiantamentos" & "</p>"
			            & "<div class='linha1'><span class='b6 hero" & IF ( _tsS = "−", " ng", "" ) & "'>" & _tsOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Resultado menos itens 2 a 6</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Cartões
		lineageTag: 81aee39d-52e4-5b82-86e5-786ceaf0c64e

	/// CSS dos cartões da T4: o do cartão com flip comum (v2: rótulo em caixa normal, número 42, contexto 14 numa linha; verso creme com 'DE ONDE VEM' em y 82 com régua e 106 sem).
	measure 'T4 · Cartões · CSS' =
			-- 4 · Marcação
			[Comum · CSS cartão]
		displayFolder: T4 Resultado no tempo\Cartões
		lineageTag: ddd4e4ce-9842-5fe0-aa73-c2dccec3cfa9

	/// O que ainda vai se realizar (resultado da planilha − resultado aplicado) no mês anterior ao do contexto.
	measure 'T4 · A realizar · mês anterior' =
			VAR _mes = EDATE ( MAX ( dMes[Mes] ), -1 )
			RETURN
			    CALCULATE ( [A realizar], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: e115f3fd-b02f-5bfd-9391-777f4c0714f7

	/// O que falta realizar (planilha − aplicado) no mês menos o do mês anterior, só das obras com aba nos dois meses.
	measure 'T4 · A realizar · variação no mês' =
			VAR _mesAnt = EDATE ( MAX ( dMes[Mes] ), -1 )
			VAR _comp =
			    FILTER (
			        VALUES ( fAnaliseCritica[Obra] ),
			        NOT ISBLANK ( [A realizar] )
			            && NOT ISBLANK ( CALCULATE ( [A realizar], REMOVEFILTERS ( dMes ), dMes[Mes] = _mesAnt ) )
			    )
			RETURN
			    IF (
			        NOT ISEMPTY ( _comp ),
			        SUMX ( _comp, [A realizar] - CALCULATE ( [A realizar], REMOVEFILTERS ( dMes ), dMes[Mes] = _mesAnt ) )
			    )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: d41834d3-7b0c-51d4-9f9e-78405ab7e148

	/// Desvio do desembolso do mês menos o do mês anterior, em fração (0,01 = 1 p.p.), só das obras com previsto nos dois meses (vazio sem nenhuma).
	measure 'T4 · Desembolso · desvio · variação no mês' =
			VAR _mesAnt = EDATE ( MAX ( dMes[Mes] ), -1 )
			VAR _comp =
			    FILTER (
			        VALUES ( fAnaliseCritica[Obra] ),
			        NOT ISBLANK ( [Desembolso · previsto no mês] )
			            && NOT ISBLANK ( CALCULATE ( [Desembolso · previsto no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _mesAnt ) )
			    )
			VAR _razaoMes =
			    DIVIDE ( SUMX ( _comp, [Desembolso · realizado no mês] ), SUMX ( _comp, [Desembolso · previsto no mês] ) )
			VAR _razaoAnt =
			    DIVIDE (
			        SUMX ( _comp, CALCULATE ( [Desembolso · realizado no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _mesAnt ) ),
			        SUMX ( _comp, CALCULATE ( [Desembolso · previsto no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _mesAnt ) )
			    )
			RETURN
			    IF ( NOT ISEMPTY ( _comp ) && NOT ISBLANK ( _razaoMes ) && NOT ISBLANK ( _razaoAnt ), _razaoMes - _razaoAnt )
		formatString: 0.00%
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: 3f354397-8c1b-5d62-ab94-6a8ddc348ca0

	/// Faixa da previsão de caixa da nota em que a obra caiu no mês do contexto, pelos pontos do item: 0 com os pontos cheios, 1 com parte deles, 2 sem ponto (a faixa crítica: o desembolso fugiu do previsto para mais ou para menos). Vazio sem previsto ou com mais de uma obra no contexto.
	measure 'T4 · Desembolso · faixa do fluxo de caixa' =
			VAR _x = [Nota · X caixa]
			VAR _p = [Nota · pontos caixa]
			VAR _max = [Nota · possíveis · caixa]
			RETURN
			    IF ( NOT ISBLANK ( _x ) && NOT ISBLANK ( _p ), SWITCH ( TRUE (), _p >= _max, 0, _p = 0, 2, 1 ) )
		formatString: 0
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: c09eb671-5e86-5045-8004-b074e0f5c3bf

	/// [T4 · Desembolso · faixa do fluxo de caixa] no mês de referência (seletor do drawer; sem escolha, o último mês).
	measure 'T4 · Desembolso · faixa do fluxo de caixa · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [T4 · Desembolso · faixa do fluxo de caixa], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: 0
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: d030964c-39a5-5315-a958-2a90d39d1bf0

	/// Rótulos curtos das faixas da previsão de caixa da nota, da faixa crítica (sem ponto) para a de pontos cheios, separados por '|' ('> 20%|10% a 20%|< 10%'), montados das constantes 'Nota · limite caixa · ponto inteiro' e '· meio ponto'. O desvio conta em módulo: o verso diz 'para mais ou para menos'.
	measure 'T4 · Desembolso · faixas do fluxo de caixa (lista)' =
			VAR _inteiro = [Nota · limite caixa · ponto inteiro]
			VAR _meio = [Nota · limite caixa · meio ponto]
			VAR _tInteiro = IF ( ROUND ( _inteiro * 100, 2 ) = ROUND ( _inteiro * 100, 0 ), FORMAT ( _inteiro * 100, "0" ), FORMAT ( _inteiro * 100, "0.0#", "pt-BR" ) ) & "%"
			VAR _tMeio = IF ( ROUND ( _meio * 100, 2 ) = ROUND ( _meio * 100, 0 ), FORMAT ( _meio * 100, "0" ), FORMAT ( _meio * 100, "0.0#", "pt-BR" ) ) & "%"
			RETURN
			    IF (
			        NOT ISBLANK ( _inteiro ) && NOT ISBLANK ( _meio ),
			        "> " & _tMeio & "|" & _tInteiro & " a " & _tMeio & "|< " & _tInteiro
			    )
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: 6c57ff16-f26a-5761-b6b7-5272f3332f3c

	/// Limite da faixa crítica da previsão de caixa da Nota da obra, como texto ('20%'), da constante 'Nota · limite caixa · meio ponto' (acima dele, nenhum ponto). As leituras dizem 'mais de 20%, para mais ou para menos'.
	measure 'T4 · Desembolso · limite da faixa crítica' =
			VAR _meio = [Nota · limite caixa · meio ponto]
			RETURN
			    IF ( NOT ISBLANK ( _meio ), IF ( ROUND ( _meio * 100, 2 ) = ROUND ( _meio * 100, 0 ), FORMAT ( _meio * 100, "0" ), FORMAT ( _meio * 100, "0.0#", "pt-BR" ) ) & "%" )
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: e2e367dd-4e70-5a25-9d2c-e4d476b10447

	/// IDC do recorte no mês anterior ao do contexto (na carteira, soma ÷ soma).
	measure 'T4 · IDC · mês anterior' =
