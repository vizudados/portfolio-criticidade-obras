	/// [T3 · Mês · destaque no ritmo] no mês de referência (obra do contexto: tooltip do avanço).
	measure 'T3 · Mês · destaque no ritmo · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [T3 · Mês · destaque no ritmo], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
