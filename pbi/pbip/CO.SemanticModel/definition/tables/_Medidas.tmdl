		lineageTag: 3d9b6b15-8d17-5e05-8f9c-e7d0d9f4719f

	/// O mês mais distante que a linha do tempo desenha (escala): o término previsto, a entrega com a tolerância de 180 dias e o término projetado no mês de referência, entre as obras em andamento e a iniciar.
	measure 'T3 · Linha do tempo · último término' =
			VAR _obras =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@f", [Obra · término previsto],
			            "@t", [Prazo · entrega com tolerância],
			            "@p", [Prazo · término projetado · ref]
			        ),
			        REMOVEFILTERS ( dObra[Obra] ),
			        dObra[Situacao] IN { "Em andamento", "A iniciar" }
			    )
			RETURN
			    MAX ( MAXX ( _obras, [@f] ), MAX ( MAXX ( _obras, [@t] ), MAXX ( _obras, [@p] ) ) )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: 69f4ed10-07a0-590f-85e0-80e9bfaf9447

