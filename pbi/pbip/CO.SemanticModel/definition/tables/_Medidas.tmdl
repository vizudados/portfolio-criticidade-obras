	/// Meses da janela, até o de referência, em que o recorte do contexto tem aba (6 na carteira em jun/26; 4 na TIROL; 8 em ago/26 com a janela de 12).
	measure 'T4 · Meses com aba' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			RETURN
			    COUNTROWS ( FILTER ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), CALCULATE ( [Obras com análise] ) > 0 ) ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: d3808457-0420-564b-9b3d-3d623a8b1962

	/// Artigo do nome da obra nas frases ('a CAJUEIRO', 'o JANGADA'). O cadastro não traz o gênero; JANGADA é o único masculino das obras em andamento (a confirmar com a Construtora).
	measure 'T4 · Obra · artigo' =
			VAR _obra = SELECTEDVALUE ( dObra[Obra] )
			RETURN
			    IF ( _obra IN { "JANGADA" }, "o", "a" )
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: 9d645dc3-af83-5ccb-b546-005c79a32376

	/// Primeiro mês da janela ([Série · primeiro mês] ao de referência) em que o recorte do contexto (carteira do drawer ou uma obra) tem aba na Análise Crítica. É o começo das comparações 'desde janeiro' das leituras.
	measure 'T4 · Primeiro mês com aba' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			RETURN
			    MINX ( FILTER ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), CALCULATE ( [Obras com análise] ) > 0 ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T4 Resultado no tempo\Comum\Contas
		lineageTag: a01c6c27-6bb9-5f1d-92e3-1a8b5b108b77

	/// Resultado aplicado do mês menos o do mês anterior, só das obras com aba nos dois meses (vazio sem nenhuma).
	measure 'T4 · Resultado aplicado · variação no mês' =
			VAR _mesAnt = EDATE ( MAX ( dMes[Mes] ), -1 )
			VAR _comp =
			    FILTER (
			        VALUES ( fAnaliseCritica[Obra] ),
			        NOT ISBLANK ( [Resultado aplicado] )
			            && NOT ISBLANK ( CALCULATE ( [Resultado aplicado], REMOVEFILTERS ( dMes ), dMes[Mes] = _mesAnt ) )
			    )
			RETURN
			    IF (
			        NOT ISEMPTY ( _comp ),
			        SUMX ( _comp, [Resultado aplicado] - CALCULATE ( [Resultado aplicado], REMOVEFILTERS ( dMes ), dMes[Mes] = _mesAnt ) )
			    )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
