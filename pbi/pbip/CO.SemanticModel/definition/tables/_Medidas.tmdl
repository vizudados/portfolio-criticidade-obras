	/// Ao lado do 'Limpar filtros': nenhum filtro ou quantos estão aplicados (mês, obras, obra em foco e a janela, esta só quando não é a de 12 meses).
	measure 'Drawer · HTML estado' =
			-- 1 · Leituras
			VAR _mes = [Recorte · mês escolhido]
			VAR _obras = [Recorte · obras escolhidas]
			VAR _foco = [Recorte · obra em foco escolhida]
			VAR _janela = [Recorte · janela escolhida]
			-- 2 · Textos
			VAR _n = _mes + _obras + _foco + _janela
			VAR _txt = IF ( _n = 0, "Nenhum filtro aplicado", IF ( _n = 1, "1 filtro aplicado", _n & " filtros aplicados" ) )
			-- 4 · Marcação
			RETURN
			    "<div class='u dw' style='display:flex;align-items:center'>" & _txt & "</div>"
		displayFolder: Comum\Desenho
		lineageTag: 91fedcce-bf3d-5711-b484-7972ac3a8638

	/// Nota sob o seletor de obra em foco: sem escolha, vale a mais crítica do mês.
	measure 'Drawer · HTML foco' =
			-- 1 · Leituras
			VAR _escolhida = [Recorte · obra em foco escolhida]
			VAR _foco = [Nota · obra em foco]
			-- 2 · Textos
			VAR _txt =
			    IF (
			        _escolhida = 1,
			        "Obra escolhida: " & _foco & ".",
			        "Sem escolha, vale a obra mais crítica do mês (a que mais perde pontos na nota): " & _foco & "."
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='u dw'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txt, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</div>"
		displayFolder: Comum\Desenho
		lineageTag: cc0a2a6e-50b1-5a7e-93ed-487559e6a52f

	/// Nota sob o seletor de janela (Figma: nota da janela na Tela 01 · Filtros abertos 281:724): de que mês a que mês as séries vão e quantos meses mostram; quando a janela pede mais meses do que o histórico tem, diz que a série começa no início do histórico.
	measure 'Drawer · HTML janela' =
			-- 1 · Leituras
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _n = [Série · meses até a referência]
			VAR _janela = [Série · janela (meses)]
			-- 2 · Textos
			VAR _txtIni = FORMAT ( _ini, "mmm/yy", "pt-BR" )
			VAR _txtRef = FORMAT ( _ref, "mmm/yy", "pt-BR" )
			VAR _txtMeses = IF ( _n = 1, "1 mês", _n & " meses" )
			VAR _txtFaixa = IF ( _n = 1, "só " & _txtRef, _txtIni & " a " & _txtRef & " · " & _txtMeses )
			VAR _txtCorte = IF ( _n < _janela, ", desde o início do histórico", "" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _ref ),
			        "<div class='u dw'>Mostrando " & _txtFaixa & _txtCorte & ".</div>"
			    )
		displayFolder: Comum\Desenho
		lineageTag: 505be409-bae2-5ca2-969e-6962fdd63cfd

	/// Frase do recorte em uso no topo do drawer: mês, quantas obras e, nas telas de uma obra, a obra em foco.
	measure 'Drawer · HTML recorte' =
			-- 1 · Leituras
			VAR _mes = [Mês de referência · longo]
			VAR _n = [Recorte · obras no recorte]
			VAR _foco = [Nota · obra em foco]
			VAR _escolhida = [Recorte · obra em foco escolhida]
			-- 2 · Textos
			VAR _txtObras = IF ( _n = 1, "1 obra em andamento", _n & " obras em andamento" )
			-- 4 · Marcação
			RETURN
			    "<div class='u dw'>Recorte exibido: " & _mes & ", " & _txtObras & ". Vale para todas as telas.</div>"
		displayFolder: Comum\Desenho
		lineageTag: c65f9f2f-75d6-5f87-ba2e-aca546e90d4a

	/// Frase do recorte nas telas de uma obra: mês e obra em foco (escolhida ou a mais crítica).
	measure 'Drawer · HTML recorte obra' =
			-- 1 · Leituras
			VAR _mes = [Mês de referência · longo]
			VAR _foco = [Nota · obra em foco]
			VAR _escolhida = [Recorte · obra em foco escolhida]
			-- 2 · Textos
			VAR _txtFoco = IF ( _escolhida = 1, "obra " & _foco, _foco & ", a obra mais crítica do mês" )  -- critério da nota
			-- 4 · Marcação
			RETURN
			    "<div class='u dw'>Recorte exibido: " & _mes & ", " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtFoco, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & ". O mês vale para todas as telas.</div>"
		displayFolder: Comum\Desenho
		lineageTag: 5531beba-aa5a-5741-8900-364a2e39bfa0

	/// Contagem das obras do recorte por status da nota no mês de referência, com as marcas v2 (informativo: não filtra): críticas, em atenção, estáveis e pendentes (falta item; tracejado).
	measure 'Drawer · HTML status' =
			-- 1 · Leituras
			VAR _mes = [Mês de referência · curto maiúsculo]
			VAR _c = [Nota · carteira · obras críticas · ref] + 0
			VAR _a = [Nota · carteira · obras em atenção · ref] + 0
			VAR _e = [Nota · carteira · obras estáveis · ref] + 0
			VAR _p = [Nota · carteira · obras pendentes · ref] + 0
			-- 4 · Marcação
			RETURN
			    "<div class='u dw'><p class='vs'>STATUS NA NOTA EM " & _mes & "</p><div class='st'>"
			        & "<span><i class='mk mk2'></i>Crítico <b>" & _c & "</b></span>"
			        & "<span><i class='mk mk1'></i>Atenção <b>" & _a & "</b></span>"
			        & "<span><i class='mk mk0'></i>Estável <b>" & _e & "</b></span>"
			        & "<span><i class='mk mkm'></i>Pendente <b>" & _p & "</b></span>"
			    & "</div></div>"
		displayFolder: Comum\Desenho
		lineageTag: ac2c585a-641b-5c13-b796-6aa2c9ea46a3

	/// Marca do status da nota da obra no mês de referência, na gramática do VizuFilter 2.10 (crítico vermelho sólido, atenção ocre sólido, estável sálvia com contorno, pendente tracejado claro); sem obra no mês, sem marca.
	measure 'Drawer · obra · marca' =
			-- 1 · Leituras
			VAR _st = [Nota · status · ranking · ref]
			VAR _pend = [Nota · pendente · ranking · ref]
			-- 4 · Marcação
			RETURN
			    SWITCH ( TRUE (),
			        _pend = 1, "tracejado|#B8B8B8",
			        ISBLANK ( _st ), "",
			        _st = 2, "#C43737",
			        _st = 1, "#C9821F",
			        "#A9CDB9|#6E9F85"
			    )
		displayFolder: Comum\Desenho
		lineageTag: 89f72e30-0b7c-53e0-ba7b-1b2ade0ed650

	/// Rótulo à direita do nome da obra no drawer, pela nota no mês de referência: 'crítico · 5,4' (status e nota) ou 'pendente · 4,0 de 6,0' (pontos obtidos dos possíveis, quando falta item); sem obra no mês, 'sem aba no mês'.
	measure 'Drawer · obra · rótulo' =
			-- 1 · Leituras
			VAR _st = [Nota · status · ranking · ref]
			VAR _pend = [Nota · pendente · ranking · ref]
			VAR _nota = [Nota · nota final · ranking · ref]
			VAR _obt = [Nota · pontos obtidos · ranking · ref]
			VAR _poss = [Nota · pontos possíveis · ranking · ref]
			-- 2 · Textos
			VAR _nN = FORMAT ( _nota, "0.0#", "pt-BR" )
			VAR _nOb = FORMAT ( _obt, "0.0#", "pt-BR" )
			VAR _nPo = FORMAT ( _poss, "0.0#", "pt-BR" )
			VAR _nTxt = SWITCH ( TRUE (), _pend = 1, "pendente · " & _nOb & " de " & _nPo, ISBLANK ( _nota ), "—", "" & _nN )
			VAR _txt = IF ( _pend = 1, _nTxt, SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & " · " & _nN )
			-- 4 · Marcação
			RETURN
			    IF ( ISBLANK ( _pend ), "sem aba no mês", _txt )
		displayFolder: Comum\Desenho
		lineageTag: 80448dc5-ea2d-5b74-a49b-424052c099b1

	/// CSS do bloco Mês de referência da sidebar.
	measure 'Sidebar · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".sd{position:fixed;inset:0}.sd .r{left:0;top:0;color:rgba(233,224,207,.6)}.sd .m{left:0;top:18px;font-size:23px;line-height:28px;color:#F7F4EE}.sd .n{position:absolute;left:0;top:5"
			    & "4px;width:232px;font-size:14px;line-height:19px;color:rgba(233,224,207,.7);white-space:normal}"
		displayFolder: Comum\Desenho
		lineageTag: 6d19a47c-21a4-569d-ac0b-26ffd4601e8a

	/// Bloco 'Mês de referência' da sidebar: o mês do seletor e quantas obras têm planilha no mês (contando, F4).
	measure 'Sidebar · HTML mês' =
			-- 1 · Leituras
			VAR _mes = [Mês de referência · longo]
			VAR _n = [Recorte · obras no total]
			-- 2 · Textos
			VAR _txtN = IF ( _n = 1, "1 obra em andamento", "⁅" & _n & "⁆" & " obras em andamento" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u sd'>"
			        & "<p class='ab vs r'>MÊS DE REFERÊNCIA</p>"
			        & "<p class='ab b6 m'>" & _mes & "</p>"
			        & "<p class='n'>" & _txtN & " · planilhas Análise Crítica · Power Query</p>"
			    & "</div>" & [Comum · JS contador]
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: Comum\Desenho
		lineageTag: 24e6f9d8-b578-5cf7-b39f-9d564a04f03f

	/// Cartão de caixa: desembolso do mês somado, desvio sobre o previsto e quantas obras saíram da faixa cheia do item caixa (para mais ou para menos). Verso com a régua do item (Nota · limite caixa · …). Só lê contas · ref.
	measure 'T1 · Cartão caixa · HTML' =
			-- 1 · Leituras
			VAR _des = [Desembolso · realizado no mês · ref]
			VAR _prev = [Desembolso · previsto no mês · ref]
			VAR _desv = [Desembolso · desvio no mês · ref]
			VAR _nFora = [T1 · Caixa · obras fora da faixa cheia · ref]
			VAR _limInt = [Nota · limite caixa · ponto inteiro]
			VAR _limMeio = [Nota · limite caixa · meio ponto]
			-- 2 · Textos
			VAR _tdA = ABS ( _des )
			VAR _tdNu = SWITCH ( TRUE (), _tdA >= 99950000, FORMAT ( _tdA / 1000000, "0.0", "pt-BR" ), _tdA >= 999500, FORMAT ( _tdA / 1000000, "0.00", "pt-BR" ), _tdA >= 999.5, FORMAT ( _tdA / 1000, "0", "pt-BR" ), FORMAT ( _tdA, "#,0", "pt-BR" ) )
			VAR _tdUn = SWITCH ( TRUE (), _tdA >= 999500, " mi", _tdA >= 999.5, " mil", "" )
			VAR _tdN = _tdNu & _tdUn
			VAR _tdZero = _tdN = "0"
			VAR _tdS = IF ( _tdZero, "", IF ( _des < 0, "−", "" ) )
			VAR _tdTxt = IF ( ISBLANK ( _des ), "—", _tdS & "R$ " & _tdN )
			VAR _tpA = ABS ( _prev )
			VAR _tpNu = SWITCH ( TRUE (), _tpA >= 99950000, FORMAT ( _tpA / 1000000, "0.0", "pt-BR" ), _tpA >= 999500, FORMAT ( _tpA / 1000000, "0.00", "pt-BR" ), _tpA >= 999.5, FORMAT ( _tpA / 1000, "0", "pt-BR" ), FORMAT ( _tpA, "#,0", "pt-BR" ) )
			VAR _tpUn = SWITCH ( TRUE (), _tpA >= 999500, " mi", _tpA >= 999.5, " mil", "" )
			VAR _tpN = _tpNu & _tpUn
			VAR _tpZero = _tpN = "0"
			VAR _tpS = IF ( _tpZero, "", IF ( _prev < 0, "−", "" ) )
			VAR _tpTxt = IF ( ISBLANK ( _prev ), "—", _tpS & "R$ " & _tpN )
			VAR _tvN = FORMAT ( ABS ( _desv ) * 100, "0", "pt-BR" )
			VAR _tvS = SWITCH ( TRUE (), ROUND ( _desv * 100, 0 ) < 0, "−", ROUND ( _desv * 100, 0 ) > 0, "+", "" )
			VAR _tvTxt = IF ( ISBLANK ( _desv ), "—", _tvS & _tvN & "%" )
			VAR _txtCtx = "⁅" & _tpTxt & "⁆" & " previsto" & IF ( _nFora > 0, " · " & "⁅" & _nFora & "⁆" & " fora de " & "⁅" & FORMAT ( _limInt * 100, "0", "pt-BR" ) & "⁆" & "%", "" )
			VAR _txtRegra = "Desvio = desembolsado ÷ previsto − 1. Na nota conta para mais e para menos."
			VAR _txtInt = FORMAT ( _limInt * 100, "0", "pt-BR" ) & "%"
			VAR _txtMeio = FORMAT ( _limMeio * 100, "0", "pt-BR" ) & "%"
			VAR _htmlRegua = "<i class='mk mk2'></i><span>|desvio| &gt; " & _txtMeio & "</span>"
			            & "<i class='mk mk1'></i><span>≤ " & _txtMeio & "</span>"
			            & "<i class='mk mk0'></i><span>&lt; " & _txtInt & "</span>"
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tdKP = LEN ( _tdNu ) > 0
			VAR _tdKN = IF ( _tdKP, _tdNu )
			VAR _tdKS = SUBSTITUTE ( SUBSTITUTE ( _tdKN, ".", "" ), ",", "" )
			VAR _tdKT = IFERROR ( VALUE ( _tdKS ), -1 )
			VAR _tdKOk = _tdKP && _tdKT >= 2 && FORMAT ( _tdKT, REPT ( "0", LEN ( _tdKS ) ) ) = _tdKS
			VAR _tdKD = IF ( CONTAINSSTRING ( _tdKN, "," ), LEN ( _tdKN ) - SEARCH ( ",", _tdKN ), 0 )
			VAR _tdKM = IF ( CONTAINSSTRING ( _tdKN, "." ), "#,##0", "0" ) & IF ( _tdKD > 0, "." & REPT ( "0", _tdKD ) )
			VAR _tdKOd =
			    IF (
			        _tdKOk,
			        "<o-d><o-v>" & _tdKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdKN, FORMAT ( ROUND ( _tdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdKD ), _tdKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdNu
			    )
			VAR _tdOd = IF ( ISBLANK ( _des ), _tdTxt, _tdS & "R$ " & _tdKOd & _tdUn )
			VAR _tvKP = LEN ( _tvN ) > 0
			VAR _tvKN = IF ( _tvKP, _tvN )
			VAR _tvKS = SUBSTITUTE ( SUBSTITUTE ( _tvKN, ".", "" ), ",", "" )
			VAR _tvKT = IFERROR ( VALUE ( _tvKS ), -1 )
			VAR _tvKOk = _tvKP && _tvKT >= 2 && FORMAT ( _tvKT, REPT ( "0", LEN ( _tvKS ) ) ) = _tvKS
			VAR _tvKD = IF ( CONTAINSSTRING ( _tvKN, "," ), LEN ( _tvKN ) - SEARCH ( ",", _tvKN ), 0 )
			VAR _tvKM = IF ( CONTAINSSTRING ( _tvKN, "." ), "#,##0", "0" ) & IF ( _tvKD > 0, "." & REPT ( "0", _tvKD ) )
			VAR _tvKOd =
			    IF (
			        _tvKOk,
			        "<o-d><o-v>" & _tvKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tvKN, FORMAT ( ROUND ( _tvKT * [@odf] / 1000, 0 ) / POWER ( 10, _tvKD ), _tvKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tvN
			    )
			VAR _tvOd = IF ( ISBLANK ( _desv ), _tvTxt, _tvS & _tvKOd & "%" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>Caixa · desembolso do mês</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _tdOd & "</span>" & "<span class='b5 lado2'>" & _tvOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Previsto e desembolsado</span></div>"
			            & "<div class='regua'>" & _htmlRegua & "</div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Cartões
		lineageTag: e4c69920-e396-531d-a880-cd42130b4cc1

	/// Cartão do canteiro: taxa de frequência de acidentes com afastamento nos 12 meses (NBR 14280) e, no contexto, a aprovação na 1.ª inspeção e a conformidade NR-18 do mês. Verso com a régua do item acidentes (média do setor, Nota · limite acidentes · setor). Só lê contas · ref.
	measure 'T1 · Cartão canteiro · HTML' =
			-- 1 · Leituras
			VAR _tf = [Canteiro · taxa de frequência (12 meses) · ref]
			VAR _insp = [Canteiro · aprovação na 1.ª inspeção · ref]
			VAR _nr = [Canteiro · conformidade NR-18 · ref]
			VAR _setor = [Nota · limite acidentes · setor]
			-- 2 · Textos
			VAR _ttN = FORMAT ( _tf, "0.0", "pt-BR" )
			VAR _ttTxt = IF ( ISBLANK ( _tf ), "—", _ttN )
			VAR _tinN = FORMAT ( ABS ( _insp ) * 100, "0", "pt-BR" )
			VAR _tinS = IF ( ROUND ( _insp * 100, 0 ) < 0, "−", "" )
			VAR _tinTxt = IF ( ISBLANK ( _insp ), "—", _tinS & _tinN & "%" )
			VAR _tnrN = FORMAT ( ABS ( _nr ) * 100, "0", "pt-BR" )
			VAR _tnrS = IF ( ROUND ( _nr * 100, 0 ) < 0, "−", "" )
			VAR _tnrTxt = IF ( ISBLANK ( _nr ), "—", _tnrS & _tnrN & "%" )
			VAR _txtCtx = "1.ª inspeção " & "⁅" & _tinTxt & "⁆" & " · NR-18 " & "⁅" & _tnrTxt & "⁆"
			VAR _txtRegra = "Acidentes com afastamento por milhão de horas, em 12 meses (NBR 14280)."
			VAR _tSetor = FORMAT ( _setor, "0.0", "pt-BR" )
			VAR _htmlRegua = "<i class='mk mk0'></i><span>TF = 0</span>"
			            & "<i class='mk mk1'></i><span>até " & _tSetor & " (setor)</span>"
			            & "<i class='mk mk2'></i><span>&gt; " & _tSetor & "</span>"
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _ttKP = LEN ( _ttN ) > 0
			VAR _ttKN = IF ( _ttKP, _ttN )
			VAR _ttKS = SUBSTITUTE ( SUBSTITUTE ( _ttKN, ".", "" ), ",", "" )
			VAR _ttKT = IFERROR ( VALUE ( _ttKS ), -1 )
			VAR _ttKOk = _ttKP && _ttKT >= 2 && FORMAT ( _ttKT, REPT ( "0", LEN ( _ttKS ) ) ) = _ttKS
			VAR _ttKD = IF ( CONTAINSSTRING ( _ttKN, "," ), LEN ( _ttKN ) - SEARCH ( ",", _ttKN ), 0 )
			VAR _ttKM = IF ( CONTAINSSTRING ( _ttKN, "." ), "#,##0", "0" ) & IF ( _ttKD > 0, "." & REPT ( "0", _ttKD ) )
			VAR _ttKOd =
			    IF (
			        _ttKOk,
			        "<o-d><o-v>" & _ttKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _ttKN, FORMAT ( ROUND ( _ttKT * [@odf] / 1000, 0 ) / POWER ( 10, _ttKD ), _ttKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _ttN
			    )
			VAR _ttOd = IF ( ISBLANK ( _tf ), _ttTxt, _ttKOd )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>Canteiro · acidentes</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _ttOd & "</span>" & "<span class='b5 lado2'>" & "TF" & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Base complementar</span></div>"
			            & "<div class='regua'>" & _htmlRegua & "</div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Cartões
		lineageTag: a7bea434-9d6c-57e6-8a3c-da549e54bf86

	/// Cartão de custo (o escuro, a resposta): IDC da carteira (valor agregado ÷ custo aplicado, soma ÷ soma) e, ao lado, o resultado aplicado em R$; quantas obras estão abaixo de 1,00. Verso com a régua do item custo (ponto cheio e trava, lidos das medidas Nota · limite custo · …). Só lê contas · ref.
	measure 'T1 · Cartão custo · HTML' =
			-- 1 · Leituras
			VAR _idc = [IDC · ref]
			VAR _resA = [Resultado aplicado · ref]
			VAR _nAbx = [T1 · Custo · obras com IDC abaixo de 1 · ref]
			VAR _n = [Obras com análise · ref]
			VAR _cheio = [Nota · limite custo · ponto cheio]
			VAR _trv = [Nota · limite custo · trava]
			-- 2 · Textos
			VAR _tiN = FORMAT ( _idc, "0.00", "pt-BR" )
			VAR _tiTxt = IF ( ISBLANK ( _idc ), "—", _tiN )
			VAR _trA = ABS ( _resA )
			VAR _trNu = SWITCH ( TRUE (), _trA >= 99950000, FORMAT ( _trA / 1000000, "0.0", "pt-BR" ), _trA >= 999500, FORMAT ( _trA / 1000000, "0.00", "pt-BR" ), _trA >= 999.5, FORMAT ( _trA / 1000, "0", "pt-BR" ), FORMAT ( _trA, "#,0", "pt-BR" ) )
			VAR _trUn = SWITCH ( TRUE (), _trA >= 999500, " mi", _trA >= 999.5, " mil", "" )
			VAR _trN = _trNu & _trUn
			VAR _trZero = _trN = "0"
			VAR _trS = IF ( _trZero, "", SWITCH ( TRUE (), _resA < 0, "−", _resA > 0, "+", "" ) )
			VAR _trTxt = IF ( ISBLANK ( _resA ), "—", _trS & "R$ " & _trN )
			VAR _txtCtx = SWITCH ( TRUE (), _n = 0, "nenhuma obra no mês", _nAbx = 0, IF ( _n = 1, "a obra agrega o que gasta", "todas agregam o que gastam" ), "⁅" & _nAbx & "⁆" & IF ( _nAbx = 1, " obra abaixo de ", " obras abaixo de " ) & "⁅" & FORMAT ( _cheio, "0.00", "pt-BR" ) & "⁆" )
			VAR _txtRegra = "Valor agregado ÷ custo aplicado (com a dívida). Ao lado, a diferença em R$."
			VAR _tCheio = FORMAT ( _cheio, "0.00", "pt-BR" )
			VAR _tTrv = FORMAT ( _trv, "0.00", "pt-BR" )
			VAR _htmlRegua = "<i class='mk mk0'></i><span>≥ " & _tCheio & "</span>"
			            & "<i class='mk mk1'></i><span>" & _tTrv & " a " & _tCheio & "</span>"
			            & "<i class='mk mk2'></i><span>&lt; " & _tTrv & "</span>"
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tiKP = LEN ( _tiN ) > 0
			VAR _tiKN = IF ( _tiKP, _tiN )
			VAR _tiKS = SUBSTITUTE ( SUBSTITUTE ( _tiKN, ".", "" ), ",", "" )
			VAR _tiKT = IFERROR ( VALUE ( _tiKS ), -1 )
			VAR _tiKOk = _tiKP && _tiKT >= 2 && FORMAT ( _tiKT, REPT ( "0", LEN ( _tiKS ) ) ) = _tiKS
			VAR _tiKD = IF ( CONTAINSSTRING ( _tiKN, "," ), LEN ( _tiKN ) - SEARCH ( ",", _tiKN ), 0 )
			VAR _tiKM = IF ( CONTAINSSTRING ( _tiKN, "." ), "#,##0", "0" ) & IF ( _tiKD > 0, "." & REPT ( "0", _tiKD ) )
			VAR _tiKOd =
			    IF (
			        _tiKOk,
			        "<o-d><o-v>" & _tiKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tiKN, FORMAT ( ROUND ( _tiKT * [@odf] / 1000, 0 ) / POWER ( 10, _tiKD ), _tiKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tiN
			    )
			VAR _tiOd = IF ( ISBLANK ( _idc ), _tiTxt, _tiKOd )
			VAR _trKP = LEN ( _trNu ) > 0
			VAR _trKN = IF ( _trKP, _trNu )
			VAR _trKS = SUBSTITUTE ( SUBSTITUTE ( _trKN, ".", "" ), ",", "" )
			VAR _trKT = IFERROR ( VALUE ( _trKS ), -1 )
			VAR _trKOk = _trKP && _trKT >= 2 && FORMAT ( _trKT, REPT ( "0", LEN ( _trKS ) ) ) = _trKS
			VAR _trKD = IF ( CONTAINSSTRING ( _trKN, "," ), LEN ( _trKN ) - SEARCH ( ",", _trKN ), 0 )
			VAR _trKM = IF ( CONTAINSSTRING ( _trKN, "." ), "#,##0", "0" ) & IF ( _trKD > 0, "." & REPT ( "0", _trKD ) )
			VAR _trKOd =
			    IF (
			        _trKOk,
			        "<o-d><o-v>" & _trKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _trKN, FORMAT ( ROUND ( _trKT * [@odf] / 1000, 0 ) / POWER ( 10, _trKD ), _trKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _trNu
			    )
			VAR _trOd = IF ( ISBLANK ( _resA ), _trTxt, _trS & "R$ " & _trKOd & _trUn )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc escuro' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>Custo · IDC da carteira</p>"
			            & "<div class='linha1'><span class='b6 hero" & IF ( ROUND ( _idc, 2 ) < 1, " ng", "" ) & "'>" & _tiOd & "</span>" & "<span class='b5 lado2" & IF ( _resA < 0 && _trTxt <> "—", " ng", "" ) & "'>" & _trOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Análise Crítica · item custo</span></div>"
			            & "<div class='regua'>" & _htmlRegua & "</div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Cartões
		lineageTag: 528c0fe2-9071-5d91-b64a-aefcff1e00b7

	/// Cartão 'obras em andamento' (frente e verso): obras com aba no mês, orçamento somado e as obras por status da nota (crítico, atenção, estável, pendente). O verso explica a Nota da obra, a trava e a régua dos status, lidas das medidas Nota · status · faixa … e Nota · limite … · trava. Só lê contas · ref.
	measure 'T1 · Cartão obras · HTML' =
			-- 1 · Leituras
			VAR _n = [Obras com análise · ref]
			VAR _orc = [Orçamento · ref]
			VAR _crit = [Nota · carteira · obras críticas · ref]
			VAR _aten = [Nota · carteira · obras em atenção · ref]
			VAR _est = [Nota · carteira · obras estáveis · ref]
			VAR _pend = [Nota · carteira · obras pendentes · ref]
			VAR _max = [Nota · nota · máximo]
			VAR _fxC = [Nota · status · faixa crítico]
			VAR _fxA = [Nota · status · faixa atenção]
			VAR _fxE = [Nota · status · faixa estável]
			VAR _trvC = [Nota · limite custo · trava]
			VAR _trvP = [Nota · limite prazo · trava]
			-- 2 · Textos
			VAR _tnN = FORMAT ( _n, "#,0", "pt-BR" )
			VAR _tnTxt = IF ( ISBLANK ( _n ), "0", _tnN )
			VAR _toA = ABS ( _orc )
			VAR _toNu = SWITCH ( TRUE (), _toA >= 99950000, FORMAT ( _toA / 1000000, "0.0", "pt-BR" ), _toA >= 999500, FORMAT ( _toA / 1000000, "0.00", "pt-BR" ), _toA >= 999.5, FORMAT ( _toA / 1000, "0", "pt-BR" ), FORMAT ( _toA, "#,0", "pt-BR" ) )
			VAR _toUn = SWITCH ( TRUE (), _toA >= 999500, " mi", _toA >= 999.5, " mil", "" )
			VAR _toN = _toNu & _toUn
			VAR _toZero = _toN = "0"
			VAR _toS = IF ( _toZero, "", IF ( _orc < 0, "−", "" ) )
			VAR _toTxt = IF ( ISBLANK ( _orc ), "—", _toS & "R$ " & _toN )
			VAR _c = _crit + 0
			VAR _a = _aten + 0
			VAR _e = _est + 0
			VAR _p = _pend + 0
			VAR _quatro = _c > 0 && _a > 0 && _e > 0 && _p > 0
			VAR _wC = IF ( _c > 0, "⁅" & _c & "⁆" & IF ( _c = 1, " crítica", " críticas" ) )
			VAR _wA = IF ( _a > 0, "⁅" & _a & "⁆" & " atenção" )
			VAR _wE = IF ( _e > 0, "⁅" & _e & "⁆" & IF ( _e = 1, " estável", " estáveis" ) )
			VAR _wP = IF ( _p > 0, "⁅" & _p & "⁆" & IF ( _p = 1, " pendente", " pendentes" ) )
			VAR _palavras = _wC & IF ( _wC <> "" && _wA & _wE & _wP <> "", " · " ) & _wA & IF ( _wA <> "" && _wE & _wP <> "", " · " ) & _wE & IF ( _wE <> "" && _wP <> "", " · " ) & _wP
			VAR _marcas = "<i class='mk mk2 a-pop' style='animation-delay:300ms'></i>" & "⁅" & _c & "⁆" & "<i class='mk mk1 a-pop' style='margin-left:14px;animation-delay:350ms'></i>" & "⁅" & _a & "⁆" & "<i class='mk mk0 a-pop' style='margin-left:14px;animation-delay:400ms'></i>" & "⁅" & _e & "⁆" & "<i class='mk mkm a-pop' style='margin-left:14px;animation-delay:450ms'></i>" & "⁅" & _p & "⁆"
			VAR _txtCtx = SWITCH ( TRUE (), _c + _a + _e + _p = 0, "nenhuma obra no mês", _quatro, _marcas, _palavras )
			VAR _txtMax = FORMAT ( _max, "0", "pt-BR" )
			VAR _txtTrvC = FORMAT ( _trvC, "0.00", "pt-BR" )
			VAR _txtTrvP = FORMAT ( _trvP, "0", "pt-BR" )
			VAR _txtRegra = "De 0 a " & _txtMax & ". IDC &lt; " & _txtTrvC & " ou atraso &gt; " & _txtTrvP & " meses: crítica. Sem item: pendente."
			VAR _htmlRegua = "<i class='mk mk2'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxC, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mk1'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxA, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mk0'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxE, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mkm'></i><span>pendente</span>"
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tnKP = LEN ( _tnN ) > 0
			VAR _tnKN = IF ( _tnKP, _tnN )
			VAR _tnKS = SUBSTITUTE ( SUBSTITUTE ( _tnKN, ".", "" ), ",", "" )
			VAR _tnKT = IFERROR ( VALUE ( _tnKS ), -1 )
			VAR _tnKOk = _tnKP && _tnKT >= 2 && FORMAT ( _tnKT, REPT ( "0", LEN ( _tnKS ) ) ) = _tnKS
			VAR _tnKD = IF ( CONTAINSSTRING ( _tnKN, "," ), LEN ( _tnKN ) - SEARCH ( ",", _tnKN ), 0 )
			VAR _tnKM = IF ( CONTAINSSTRING ( _tnKN, "." ), "#,##0", "0" ) & IF ( _tnKD > 0, "." & REPT ( "0", _tnKD ) )
			VAR _tnKOd =
			    IF (
			        _tnKOk,
			        "<o-d><o-v>" & _tnKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tnKN, FORMAT ( ROUND ( _tnKT * [@odf] / 1000, 0 ) / POWER ( 10, _tnKD ), _tnKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tnN
			    )
			VAR _tnOd = IF ( ISBLANK ( _n ), _tnTxt, _tnKOd )
			VAR _toKP = LEN ( _toNu ) > 0
			VAR _toKN = IF ( _toKP, _toNu )
			VAR _toKS = SUBSTITUTE ( SUBSTITUTE ( _toKN, ".", "" ), ",", "" )
			VAR _toKT = IFERROR ( VALUE ( _toKS ), -1 )
			VAR _toKOk = _toKP && _toKT >= 2 && FORMAT ( _toKT, REPT ( "0", LEN ( _toKS ) ) ) = _toKS
			VAR _toKD = IF ( CONTAINSSTRING ( _toKN, "," ), LEN ( _toKN ) - SEARCH ( ",", _toKN ), 0 )
			VAR _toKM = IF ( CONTAINSSTRING ( _toKN, "." ), "#,##0", "0" ) & IF ( _toKD > 0, "." & REPT ( "0", _toKD ) )
			VAR _toKOd =
			    IF (
			        _toKOk,
			        "<o-d><o-v>" & _toKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _toKN, FORMAT ( ROUND ( _toKT * [@odf] / 1000, 0 ) / POWER ( 10, _toKD ), _toKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _toNu
			    )
			VAR _toOd = IF ( ISBLANK ( _orc ), _toTxt, _toS & "R$ " & _toKOd & _toUn )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>Obras em andamento</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _tnOd & "</span>" & "<span class='b5 lado2'>" & _toOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Análise Crítica + base</span></div>"
			            & "<div class='regua'>" & _htmlRegua & "</div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Cartões
		lineageTag: 1866f639-c32b-5ae7-a950-85e7c77389c9

	/// Cartão de prazo: atraso médio da carteira em meses (cronograma agregado, ponderado pelo orçamento) e a obra de maior atraso. Verso com a régua do item prazo (ponto cheio e trava, das medidas Nota · limite prazo · …). Só lê contas · ref.
	measure 'T1 · Cartão prazo · HTML' =
			-- 1 · Leituras
			VAR _atr = [Prazo · atraso médio (meses) · ref]
			VAR _oMax = [T1 · Prazo · obra de maior atraso · ref]
			VAR _vMax = [T1 · Prazo · maior atraso · ref]
			VAR _lim = [Nota · limite prazo · ponto cheio]
			VAR _trv = [Nota · limite prazo · trava]
			-- 2 · Textos
			VAR _taN = FORMAT ( _atr, "0.0", "pt-BR" )
			VAR _taTxt = IF ( ISBLANK ( _atr ), "—", _taN )
			VAR _txtLado = IF ( ISBLANK ( _atr ), "", IF ( ROUND ( _atr, 1 ) <= 1, "mês", "meses" ) )
			VAR _txtCtx = IF ( _oMax = "", "nenhuma obra atrasada", "maior: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _oMax, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & ", " & "⁅" & FORMAT ( ROUND ( _vMax, 1 ), IF ( ROUND ( _vMax, 1 ) = INT ( ROUND ( _vMax, 1 ) ), "0", "0.0" ), "pt-BR" ) & "⁆" & IF ( ROUND ( _vMax, 1 ) <= 1, " mês", " meses" ) )
			VAR _txtRegra = "Atraso das obras pelo cronograma, em meses, ponderado pelo orçamento."
			VAR _txtLim = FORMAT ( _lim, IF ( _lim = INT ( _lim ), "0", "0.0" ), "pt-BR" ) & IF ( _lim <= 1, " mês", " meses" )
			VAR _txtTrv = FORMAT ( _trv, IF ( _trv = INT ( _trv ), "0", "0.0" ), "pt-BR" ) & IF ( _trv <= 1, " mês", " meses" )
			VAR _htmlRegua = "<i class='mk mk0'></i><span>até " & _txtLim & "</span>"
			            & "<i class='mk mk2'></i><span>&gt; " & _txtTrv & ": crítica</span>"
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _taKP = LEN ( _taN ) > 0
			VAR _taKN = IF ( _taKP, _taN )
			VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
			VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
			VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
			VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
			VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
			VAR _taKOd =
			    IF (
			        _taKOk,
			        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _taN
			    )
			VAR _taOd = IF ( ISBLANK ( _atr ), _taTxt, _taKOd )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>Prazo · atraso médio</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _taOd & "</span>" & "<span class='b5 lado2'>" & _txtLado & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Planilha e cronograma</span></div>"
			            & "<div class='regua'>" & _htmlRegua & "</div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Cartões
		lineageTag: aef74a61-9a78-52c0-a9f9-a9934bcefb07

	/// Obras com aba no mês de referência que não levaram o ponto cheio da previsão de caixa (desvio do desembolso fora da primeira faixa, para mais ou para menos).
	measure 'T1 · Caixa · obras fora da faixa cheia · ref' =
			VAR _mes = [Mês de referência]
			VAR _obras = CALCULATETABLE ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
			RETURN
			    COUNTROWS (
			        FILTER (
			            _obras,
			            CALCULATE ( [Nota · pontos caixa] < [Nota · possíveis · caixa], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
			        )
			    ) + 0
		formatString: 0
		displayFolder: T1 Visão geral\Cartões\Contas
		lineageTag: a8492739-b798-54d2-a47e-f75841ad2137

	/// Obras com aba no mês de referência e IDC abaixo de 1 (gastam mais do que agregam).
	measure 'T1 · Custo · obras com IDC abaixo de 1 · ref' =
			VAR _mes = [Mês de referência]
			VAR _obras = CALCULATETABLE ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
			RETURN
			    COUNTROWS ( FILTER ( _obras, CALCULATE ( [IDC] < 1, REMOVEFILTERS ( dMes ), dMes[Mes] = _mes ) ) ) + 0
		formatString: 0
		displayFolder: T1 Visão geral\Cartões\Contas
		lineageTag: 75654e6b-deef-5681-8558-3bf1fb129e5a

	/// Maior atraso em meses entre as obras do recorte no mês de referência; vazio sem atraso.
	measure 'T1 · Prazo · maior atraso · ref' =
			VAR _mes = [Mês de referência]
			VAR _obras =
			    CALCULATETABLE (
			        ADDCOLUMNS ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), "@a", [Prazo · atraso (meses)] ),
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] = _mes
			    )
			VAR _top = TOPN ( 1, FILTER ( _obras, [@a] > 0 ), [@a], DESC, dObra[Obra], ASC )
			RETURN
			    MAXX ( _top, [@a] )
		formatString: 0.0
		displayFolder: T1 Visão geral\Cartões\Contas
		lineageTag: bcf45302-aed8-52f8-ad21-483fc5bfab55

	/// Obra do recorte com o maior atraso em meses no mês de referência (empate: ordem alfabética); vazio sem atraso.
	measure 'T1 · Prazo · obra de maior atraso · ref' =
			VAR _mes = [Mês de referência]
			VAR _obras =
			    CALCULATETABLE (
			        ADDCOLUMNS ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), "@a", [Prazo · atraso (meses)] ),
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] = _mes
			    )
			VAR _top = TOPN ( 1, FILTER ( _obras, [@a] > 0 ), [@a], DESC, dObra[Obra], ASC )
			RETURN
			    MAXX ( _top, dObra[Obra] )
		displayFolder: T1 Visão geral\Cartões\Contas
		lineageTag: 12388aeb-b323-5479-8ac2-0e1cfe8d05c7

	/// CSS do mapa obra × mês de Como os meses evoluíram (uma entrada por mês da janela).
	measure 'T1 · Semestre · CSS lista' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & "#htmlContent{display:block!important;height:100vh;padding:0!important}.htmlViewerEntry{display:block!important;margin:0!important;padding:0!important}.cm{position:fixed;top:0;heigh"
			    & "t:236px}.cm .cl{position:absolute;display:flex;align-items:center;justify-content:center;box-sizing:border-box;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-siz"
			    & "e:12px;line-height:14px;font-variant-numeric:tabular-nums;font-style:normal;transition:filter .15s;animation:mpEnt .3s ease-out backwards}.cm:hover .cl,.htmlViewerEntry.hover .cm ."
			    & "cl{filter:brightness(.94)}.cm .s2{background:#C43737;color:#FFFFFF}.cm .s1{background:#C9821F;color:#0B0B0C}.cm .s0{background:#A9CDB9;color:#1E5C43}.cm .sm{background:#FFFFFF;bord"
			    & "er:1px dashed #3B3B3F;color:#3B3B3F}.cm .sx{background:#F2F0EB}.cm .nm{position:absolute;left:-104px;width:98px;display:flex;align-items:center;font-family:'Barlow U','Segoe UI',sa"
			    & "ns-serif;font-weight:600;font-size:12px;line-height:14px;letter-spacing:.6px;color:#0B0B0C;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cm .ms{position:absolute;left:"
			    & "-12px;right:-12px;text-align:center;font-size:13px;line-height:16px;color:#6B6B70;white-space:nowrap}.cm .ms.ref{font-weight:600;color:#0B0B0C}@keyframes mpEnt{from{opacity:0}}@med"
			    & "ia (prefers-reduced-motion:reduce){.cm .cl{animation:none}}"
		displayFolder: T1 Visão geral\Como os meses evoluíram
		lineageTag: 0e597079-20a3-599b-b988-ae6acb3480c2

	/// Mapa obra × mês: uma entrada por mês da janela (granularidade dMes[Mes], de 1 a 12 meses até o de referência) com a coluna do mês, uma célula por obra na ordem da lista de obras (Nota · recorte · obras por pontos perdidos (lista), mês de referência), pintada pelo status da obra no mês (crítico, atenção, estável, pendente tracejado, sem aba em creme) e com a nota (ou os pontos obtidos, na pendente) quando a célula tem 24 px ou mais. A primeira coluna escreve os nomes das obras à esquerda; o rótulo do mês segue a regra da janela e o de referência fica em Semibold preto.
	measure 'T1 · Semestre · HTML coluna' =
			-- 1 · Leituras
			VAR _noRecorte = [Série · mês até a referência]
			VAR _lista = [Nota · recorte · obras por pontos perdidos (lista)]
			VAR _n = [Série · meses até a referência]
			VAR _pos = [Série · posição na janela]
			VAR _mesAno = [Mês · rótulo curto]
			VAR _mesAbrev = [Mês · abreviado]
			VAR _ehRef = [Série · é o mês de referência]
			VAR _nOb = IF ( _lista = "", 0, PATHLENGTH ( _lista ) )
			-- 3 · Geometria
			VAR _slot = DIVIDE ( 360, _n ) -- geometria
			VAR _x = 104 + ROUND ( ( _pos - 1 ) * _slot, 0 ) -- geometria
			VAR _w = ROUND ( _slot, 0 ) -- geometria
			VAR _cw = MAX ( 4, ROUND ( _slot, 0 ) - 2 ) -- geometria
			VAR _h = MIN ( 28, INT ( DIVIDE ( 196, _nOb ) ) ) -- geometria
			VAR _yMes = _nOb * _h + 6 -- geometria
			VAR _passo = ROUND ( DIVIDE ( 420, _n ), 0 ) -- geometria
			VAR _atraso = ( _pos - 1 ) * _passo -- geometria
			-- 2 · Textos
			VAR _comAno = _slot >= 48 || _pos = 1 || _mesAbrev = "jan"
			VAR _mostraMes = _slot >= 40 || MOD ( _n - _pos, 2 ) = 0
			VAR _rotMes = IF ( _mostraMes, IF ( _comAno, _mesAno, _mesAbrev ), "" )
			VAR _cabe = _cw >= 24 && _h >= 18
			-- 4 · Marcação
			VAR _celulas =
			    CONCATENATEX (
			        GENERATESERIES ( 1, _nOb ),
			        VAR _o = PATHITEM ( _lista, [Value] )
			        VAR _st = CALCULATE ( [Nota · status · um mês], dObra[Obra] = _o )
			        VAR _pd = CALCULATE ( [Nota · pendente · um mês], dObra[Obra] = _o )
			        VAR _nt = CALCULATE ( [Nota · nota final · um mês], dObra[Obra] = _o )
			        VAR _ob = CALCULATE ( [Nota · pontos obtidos · um mês], dObra[Obra] = _o )
			        VAR _cls = SWITCH ( TRUE (), _pd = 1, "sm", NOT ISBLANK ( _st ), "s" & _st, "sx" )
			        VAR _v = IF ( _pd = 1, _ob, _nt )
			        VAR _txt = IF ( _cabe && NOT ISBLANK ( _v ), "⁅" & IF ( ROUND ( _v, 1 ) >= 10, "10", FORMAT ( _v, "0.0", "pt-BR" ) ) & "⁆", "" )
			        VAR _y = ( [Value] - 1 ) * _h /* geometria */
			        RETURN
			            IF ( _pos = 1, "<p class='nm a-fd' style='top:" & _y & "px;height:" & ( _h - 2 ) & "px;animation-delay:" & ( [Value] - 1 ) * 30 & "ms'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _o, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" )
			                & "<i class='cl " & _cls & "' style='left:0;top:" & _y & "px;width:" & _cw & "px;height:" & ( _h - 2 )
			                & "px;animation-delay:" & ( _atraso + ( [Value] - 1 ) * 30 ) & "ms' data-rk='" & _mesAno & "|" & [Value]
			                & "'>" & _txt & "</i>",
			        "",
			        [Value], ASC
			    )
			VAR _saidaHtml =
			    IF (
			        _noRecorte = 1 && _nOb > 0,
			        "<div class='u cm' style='left:" & _x & "px;width:" & _w & "px'>" & _celulas
			            & "<p class='ms a-fd" & IF ( _ehRef = 1, " ref", "" ) & "' style='top:" & _yMes & "px;animation-delay:" & _atraso & "ms'>" & _rotMes & "</p>"
			        & "</div>" & [Comum · JS contador]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 12, fração f do easing 1−(1−t)³ em milésimos inteiros, tabela densa de 12 passos (C8) */
			VAR _odQ12 =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 230 ), ( 2, 421 ), ( 3, 578 ), ( 4, 704 ), ( 5, 802 ), ( 6, 875 ), ( 7, 928 ), ( 8, 963 ), ( 9, 984 ), ( 10, 995 ), ( 11, 999 ), ( 12, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ12,
			                                IF ( [@odk] = 12, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Como os meses evoluíram
		lineageTag: ce8c9ef3-1633-5949-a139-aac81f1c4957

	/// Subtítulo do painel Como os meses evoluíram: o que o mapa mostra e a janela (nota de cada obra, mês a mês · out/25 a set/26).
	measure 'T1 · Semestre · HTML subtítulo' =
			-- 1 · Leituras
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _n = [Série · meses até a referência]
			-- 2 · Textos
			VAR _txtIni = FORMAT ( _ini, "mmm/yy", "pt-BR" )
			VAR _txtRef = FORMAT ( _ref, "mmm/yy", "pt-BR" )
			VAR _txt = "nota de cada obra, mês a mês · " & IF ( _n = 1, _txtRef, _txtIni & " a " & _txtRef )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _ref ),
			        "<div class='u' style='position:fixed;inset:0'><p class='ab' style='left:0;top:0;font-size:15px;line-height:20px;color:#3B3B3F'>" & _txt & "</p></div>"
			    )
		displayFolder: T1 Visão geral\Como os meses evoluíram
		lineageTag: 66794a5b-1a6f-5f1c-9d00-318d97506569

	/// Leitura do "?" da lista de obras, sobre o próprio painel (L065, 1004 × 631, duas colunas): achado pelos estados da nota, explicação pelas obras críticas (ou pela que mais perde pontos) e pelas pendentes, três destaques que contam (pontos da obra que mais perde, pontos perdidos no item que mais pesa, itens sem dado), o que explica, a nota obra por obra com as linhas dos limites de atenção e de estável (pendente em tracejado) e a régua antiga lida das medidas. Ordem só a da nota. Só lê contas.
	measure 'T1 · Leitura obras · HTML' =
			-- 1 · Leituras
			VAR _mesN = [Mês de referência · nome]
			VAR _mesL = [Mês de referência · longo]
			VAR _c = [Nota · carteira · obras críticas · ref] + 0
			VAR _a = [Nota · carteira · obras em atenção · ref] + 0
			VAR _e = [Nota · carteira · obras estáveis · ref] + 0
			VAR _p = [Nota · carteira · obras pendentes · ref] + 0
			VAR _nObras = [Recorte · obras no recorte] + 0
			VAR _listaCrit = [Nota · recorte · obras críticas (lista)]
			VAR _listaAten = [Nota · recorte · obras em atenção (lista)]
			VAR _listaEst = [Nota · recorte · obras estáveis (lista)]
			VAR _listaPend = [Nota · recorte · obras pendentes (lista)]
			VAR _ranking = [Nota · recorte · obras por pontos perdidos (lista)]
			VAR _falta = [T1 · Leitura · itens sem dado na carteira]
			VAR _ofB = [T1 · Obras · com item faltando na base (lista) · ref] & ""
			VAR _ofP = [T1 · Obras · com item faltando na planilha (lista) · ref] & ""
			VAR _ofF = [T1 · Obras · com item fora da faixa (lista) · ref] & ""
			VAR _ofNB = IF ( _ofB = "", 0, PATHLENGTH ( _ofB ) )
			VAR _ofNP = IF ( _ofP = "", 0, PATHLENGTH ( _ofP ) )
			VAR _ofNF = IF ( _ofF = "", 0, PATHLENGTH ( _ofF ) )
			VAR _ofP1 = PATHITEM ( _ofP, 1 ) & ""
			VAR _ofF1 = PATHITEM ( _ofF, 1 ) & ""
			VAR _onde =
			    SWITCH (
			        TRUE (),
			        _ofNB > 0 && _ofNP > 0 && _ofB = _ofP, "na base complementar e na planilha",
			        _ofNB > 0 && _ofNP = 1, "na base complementar (na " & _ofP1
			            & IF ( PATHCONTAINS ( _ofB, _ofP1 ), ", também na planilha)", ", só na planilha)" ),
			        _ofNB > 0 && _ofNP > 1, "na base complementar (na planilha, em " & _ofNP & " obras)",
			        _ofNP > 0, "na planilha",
			        "na base complementar"
			    )
			VAR _ondeFora = SWITCH ( TRUE (), _ofNF = 0, "", _ofNF = 1, "; na " & _ofF1 & ", há valor fora da faixa", "; em " & _ofNF & " obras, há valor fora da faixa" )
			VAR _ondeSoFora = _ofNB + _ofNP = 0 && _ofNF > 0
			VAR _max = [Nota · nota · máximo]
			VAR _limA = [Nota · status · nota mínima atenção]
			VAR _limE = [Nota · status · nota mínima estável]
			VAR _fxC = [Nota · status · faixa crítico]
			VAR _fxA = [Nota · status · faixa atenção]
			VAR _fxE = [Nota · status · faixa estável]
			VAR _trvC = [Nota · limite custo · trava]
			VAR _trvP = [Nota · limite prazo · trava]
			VAR _top = [T1 · Leitura · item que mais perde] & ""
			VAR _esp = [T1 · Leitura · item mais espalhado] & ""
			VAR _topPerd = CALCULATE ( [Nota · item · perdidos · ref], dItemNota[Item] = _top )
			VAR _o1 = PATHITEM ( _ranking, 1 )
			VAR _perd1 = CALCULATE ( [Nota · pontos perdidos · ranking · ref], dObra[Obra] = _o1 )
			VAR _pend1 = CALCULATE ( [Nota · pendente · ranking · ref], dObra[Obra] = _o1 )
			VAR _st1 = CALCULATE ( [Nota · status · ranking · ref], dObra[Obra] = _o1 )
			VAR _o1L = CALCULATE ( [T1 · Obras · itens que mais perdem (lista) · ref], dObra[Obra] = _o1 ) & ""
			VAR _tops = [T1 · Leitura · itens que mais perdem (lista)] & ""
			VAR _barras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@pos", [T1 · Obras · posição],
			        "@s", [Nota · status · ranking · ref],
			        "@pend", [Nota · pendente · ranking · ref],
			        "@nota", [Nota · nota final · ranking · ref],
			        "@obt", [Nota · pontos obtidos · ranking · ref],
			        "@poss", [Nota · pontos possíveis · ranking · ref]
			    )
			VAR _comPos = FILTER ( _barras, NOT ISBLANK ( [@pos] ) ) /* lista */
			VAR _c1 = PATHITEM ( _listaCrit, 1 )
			VAR _c1Nota = CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _c1 )
			VAR _c1L = CALCULATE ( [T1 · Obras · itens que mais perdem (lista) · ref], dObra[Obra] = _c1 ) & ""
			VAR _c1IN = IF ( _c1L = "", 0, PATHLENGTH ( _c1L ) )
			VAR _c1Ia = PATHITEM ( _c1L, 1 ) & ""
			VAR _c1IaFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c1Ia )
			VAR _c1IaFr = IF ( _c1Ia = "", "", SWITCH ( TRUE (), LEFT ( _c1IaFrase, 3 ) = "os ", "nos " & MID ( _c1IaFrase, 4, 99 ), LEFT ( _c1IaFrase, 3 ) = "as ", "nas " & MID ( _c1IaFrase, 4, 99 ), LEFT ( _c1IaFrase, 2 ) = "o ", "no " & MID ( _c1IaFrase, 3, 99 ), LEFT ( _c1IaFrase, 2 ) = "a ", "na " & MID ( _c1IaFrase, 3, 99 ), "em " & _c1IaFrase ) )
			VAR _c1Ib = PATHITEM ( _c1L, 2 ) & ""
			VAR _c1IbFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c1Ib )
			VAR _c1IbFr = IF ( _c1Ib = "", "", SWITCH ( TRUE (), LEFT ( _c1IbFrase, 3 ) = "os ", "nos " & MID ( _c1IbFrase, 4, 99 ), LEFT ( _c1IbFrase, 3 ) = "as ", "nas " & MID ( _c1IbFrase, 4, 99 ), LEFT ( _c1IbFrase, 2 ) = "o ", "no " & MID ( _c1IbFrase, 3, 99 ), LEFT ( _c1IbFrase, 2 ) = "a ", "na " & MID ( _c1IbFrase, 3, 99 ), "em " & _c1IbFrase ) )
			VAR _c1Ic = PATHITEM ( _c1L, 3 ) & ""
			VAR _c1IcFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c1Ic )
			VAR _c1IcFr = IF ( _c1Ic = "", "", SWITCH ( TRUE (), LEFT ( _c1IcFrase, 3 ) = "os ", "nos " & MID ( _c1IcFrase, 4, 99 ), LEFT ( _c1IcFrase, 3 ) = "as ", "nas " & MID ( _c1IcFrase, 4, 99 ), LEFT ( _c1IcFrase, 2 ) = "o ", "no " & MID ( _c1IcFrase, 3, 99 ), LEFT ( _c1IcFrase, 2 ) = "a ", "na " & MID ( _c1IcFrase, 3, 99 ), "em " & _c1IcFrase ) )
			VAR _c1IFr = SWITCH ( _c1IN, 0, "", 1, _c1IaFr, 2, _c1IaFr & " e " & _c1IbFr, 3, _c1IaFr & ", " & _c1IbFr & " e " & _c1IcFr, "em " & SWITCH ( _c1IN, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _c1IN, "0" ) ) & " itens empatados" )
			VAR _c1Fr = IF ( _c1 = "", "", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c1, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " tem nota " & "⁅" & FORMAT ( _c1Nota, "0.0#", "pt-BR" ) & "⁆" & " e perde mais " & _c1IFr & ". " )
			VAR _c2 = PATHITEM ( _listaCrit, 2 )
			VAR _c2Nota = CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _c2 )
			VAR _c2L = CALCULATE ( [T1 · Obras · itens que mais perdem (lista) · ref], dObra[Obra] = _c2 ) & ""
			VAR _c2IN = IF ( _c2L = "", 0, PATHLENGTH ( _c2L ) )
			VAR _c2Ia = PATHITEM ( _c2L, 1 ) & ""
			VAR _c2IaFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c2Ia )
			VAR _c2IaFr = IF ( _c2Ia = "", "", SWITCH ( TRUE (), LEFT ( _c2IaFrase, 3 ) = "os ", "nos " & MID ( _c2IaFrase, 4, 99 ), LEFT ( _c2IaFrase, 3 ) = "as ", "nas " & MID ( _c2IaFrase, 4, 99 ), LEFT ( _c2IaFrase, 2 ) = "o ", "no " & MID ( _c2IaFrase, 3, 99 ), LEFT ( _c2IaFrase, 2 ) = "a ", "na " & MID ( _c2IaFrase, 3, 99 ), "em " & _c2IaFrase ) )
			VAR _c2Ib = PATHITEM ( _c2L, 2 ) & ""
			VAR _c2IbFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c2Ib )
			VAR _c2IbFr = IF ( _c2Ib = "", "", SWITCH ( TRUE (), LEFT ( _c2IbFrase, 3 ) = "os ", "nos " & MID ( _c2IbFrase, 4, 99 ), LEFT ( _c2IbFrase, 3 ) = "as ", "nas " & MID ( _c2IbFrase, 4, 99 ), LEFT ( _c2IbFrase, 2 ) = "o ", "no " & MID ( _c2IbFrase, 3, 99 ), LEFT ( _c2IbFrase, 2 ) = "a ", "na " & MID ( _c2IbFrase, 3, 99 ), "em " & _c2IbFrase ) )
			VAR _c2Ic = PATHITEM ( _c2L, 3 ) & ""
			VAR _c2IcFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c2Ic )
			VAR _c2IcFr = IF ( _c2Ic = "", "", SWITCH ( TRUE (), LEFT ( _c2IcFrase, 3 ) = "os ", "nos " & MID ( _c2IcFrase, 4, 99 ), LEFT ( _c2IcFrase, 3 ) = "as ", "nas " & MID ( _c2IcFrase, 4, 99 ), LEFT ( _c2IcFrase, 2 ) = "o ", "no " & MID ( _c2IcFrase, 3, 99 ), LEFT ( _c2IcFrase, 2 ) = "a ", "na " & MID ( _c2IcFrase, 3, 99 ), "em " & _c2IcFrase ) )
			VAR _c2IFr = SWITCH ( _c2IN, 0, "", 1, _c2IaFr, 2, _c2IaFr & " e " & _c2IbFr, 3, _c2IaFr & ", " & _c2IbFr & " e " & _c2IcFr, "em " & SWITCH ( _c2IN, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _c2IN, "0" ) ) & " itens empatados" )
			VAR _c2Fr = IF ( _c2 = "", "", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c2, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " tem nota " & "⁅" & FORMAT ( _c2Nota, "0.0#", "pt-BR" ) & "⁆" & " e perde mais " & _c2IFr & ". " )
			VAR _c3 = PATHITEM ( _listaCrit, 3 )
			VAR _c3Nota = CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _c3 )
			VAR _c3L = CALCULATE ( [T1 · Obras · itens que mais perdem (lista) · ref], dObra[Obra] = _c3 ) & ""
			VAR _c3IN = IF ( _c3L = "", 0, PATHLENGTH ( _c3L ) )
			VAR _c3Ia = PATHITEM ( _c3L, 1 ) & ""
			VAR _c3IaFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c3Ia )
			VAR _c3IaFr = IF ( _c3Ia = "", "", SWITCH ( TRUE (), LEFT ( _c3IaFrase, 3 ) = "os ", "nos " & MID ( _c3IaFrase, 4, 99 ), LEFT ( _c3IaFrase, 3 ) = "as ", "nas " & MID ( _c3IaFrase, 4, 99 ), LEFT ( _c3IaFrase, 2 ) = "o ", "no " & MID ( _c3IaFrase, 3, 99 ), LEFT ( _c3IaFrase, 2 ) = "a ", "na " & MID ( _c3IaFrase, 3, 99 ), "em " & _c3IaFrase ) )
			VAR _c3Ib = PATHITEM ( _c3L, 2 ) & ""
			VAR _c3IbFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c3Ib )
			VAR _c3IbFr = IF ( _c3Ib = "", "", SWITCH ( TRUE (), LEFT ( _c3IbFrase, 3 ) = "os ", "nos " & MID ( _c3IbFrase, 4, 99 ), LEFT ( _c3IbFrase, 3 ) = "as ", "nas " & MID ( _c3IbFrase, 4, 99 ), LEFT ( _c3IbFrase, 2 ) = "o ", "no " & MID ( _c3IbFrase, 3, 99 ), LEFT ( _c3IbFrase, 2 ) = "a ", "na " & MID ( _c3IbFrase, 3, 99 ), "em " & _c3IbFrase ) )
			VAR _c3Ic = PATHITEM ( _c3L, 3 ) & ""
			VAR _c3IcFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c3Ic )
			VAR _c3IcFr = IF ( _c3Ic = "", "", SWITCH ( TRUE (), LEFT ( _c3IcFrase, 3 ) = "os ", "nos " & MID ( _c3IcFrase, 4, 99 ), LEFT ( _c3IcFrase, 3 ) = "as ", "nas " & MID ( _c3IcFrase, 4, 99 ), LEFT ( _c3IcFrase, 2 ) = "o ", "no " & MID ( _c3IcFrase, 3, 99 ), LEFT ( _c3IcFrase, 2 ) = "a ", "na " & MID ( _c3IcFrase, 3, 99 ), "em " & _c3IcFrase ) )
			VAR _c3IFr = SWITCH ( _c3IN, 0, "", 1, _c3IaFr, 2, _c3IaFr & " e " & _c3IbFr, 3, _c3IaFr & ", " & _c3IbFr & " e " & _c3IcFr, "em " & SWITCH ( _c3IN, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _c3IN, "0" ) ) & " itens empatados" )
			VAR _c3Fr = IF ( _c3 = "", "", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c3, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " tem nota " & "⁅" & FORMAT ( _c3Nota, "0.0#", "pt-BR" ) & "⁆" & " e perde mais " & _c3IFr & ". " )
			VAR _tFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _top )
			VAR _tFr = IF ( _top = "", "", SWITCH ( TRUE (), LEFT ( _tFrase, 3 ) = "os ", "nos " & MID ( _tFrase, 4, 99 ), LEFT ( _tFrase, 3 ) = "as ", "nas " & MID ( _tFrase, 4, 99 ), LEFT ( _tFrase, 2 ) = "o ", "no " & MID ( _tFrase, 3, 99 ), LEFT ( _tFrase, 2 ) = "a ", "na " & MID ( _tFrase, 3, 99 ), "em " & _tFrase ) )
			VAR _sFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _esp )
			VAR _sFr = IF ( _esp = "", "", SWITCH ( TRUE (), LEFT ( _sFrase, 3 ) = "os ", "nos " & MID ( _sFrase, 4, 99 ), LEFT ( _sFrase, 3 ) = "as ", "nas " & MID ( _sFrase, 4, 99 ), LEFT ( _sFrase, 2 ) = "o ", "no " & MID ( _sFrase, 3, 99 ), LEFT ( _sFrase, 2 ) = "a ", "na " & MID ( _sFrase, 3, 99 ), "em " & _sFrase ) )
			VAR _jN = IF ( _o1L = "", 0, PATHLENGTH ( _o1L ) )
			VAR _ja = PATHITEM ( _o1L, 1 ) & ""
			VAR _jaFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _ja )
			VAR _jaFr = IF ( _ja = "", "", SWITCH ( TRUE (), LEFT ( _jaFrase, 3 ) = "os ", "nos " & MID ( _jaFrase, 4, 99 ), LEFT ( _jaFrase, 3 ) = "as ", "nas " & MID ( _jaFrase, 4, 99 ), LEFT ( _jaFrase, 2 ) = "o ", "no " & MID ( _jaFrase, 3, 99 ), LEFT ( _jaFrase, 2 ) = "a ", "na " & MID ( _jaFrase, 3, 99 ), "em " & _jaFrase ) )
			VAR _jb = PATHITEM ( _o1L, 2 ) & ""
			VAR _jbFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _jb )
			VAR _jbFr = IF ( _jb = "", "", SWITCH ( TRUE (), LEFT ( _jbFrase, 3 ) = "os ", "nos " & MID ( _jbFrase, 4, 99 ), LEFT ( _jbFrase, 3 ) = "as ", "nas " & MID ( _jbFrase, 4, 99 ), LEFT ( _jbFrase, 2 ) = "o ", "no " & MID ( _jbFrase, 3, 99 ), LEFT ( _jbFrase, 2 ) = "a ", "na " & MID ( _jbFrase, 3, 99 ), "em " & _jbFrase ) )
			VAR _jc = PATHITEM ( _o1L, 3 ) & ""
			VAR _jcFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _jc )
			VAR _jcFr = IF ( _jc = "", "", SWITCH ( TRUE (), LEFT ( _jcFrase, 3 ) = "os ", "nos " & MID ( _jcFrase, 4, 99 ), LEFT ( _jcFrase, 3 ) = "as ", "nas " & MID ( _jcFrase, 4, 99 ), LEFT ( _jcFrase, 2 ) = "o ", "no " & MID ( _jcFrase, 3, 99 ), LEFT ( _jcFrase, 2 ) = "a ", "na " & MID ( _jcFrase, 3, 99 ), "em " & _jcFrase ) )
			VAR _jFr = SWITCH ( _jN, 0, "", 1, _jaFr, 2, _jaFr & " e " & _jbFr, 3, _jaFr & ", " & _jbFr & " e " & _jcFr, "em " & SWITCH ( _jN, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _jN, "0" ) ) & " itens empatados" )
			VAR _tsN = IF ( _tops = "", 0, PATHLENGTH ( _tops ) )
			VAR _tsa = PATHITEM ( _tops, 1 ) & ""
			VAR _tsaFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _tsa )
			VAR _tsaFr = IF ( _tsa = "", "", SWITCH ( TRUE (), LEFT ( _tsaFrase, 3 ) = "os ", "nos " & MID ( _tsaFrase, 4, 99 ), LEFT ( _tsaFrase, 3 ) = "as ", "nas " & MID ( _tsaFrase, 4, 99 ), LEFT ( _tsaFrase, 2 ) = "o ", "no " & MID ( _tsaFrase, 3, 99 ), LEFT ( _tsaFrase, 2 ) = "a ", "na " & MID ( _tsaFrase, 3, 99 ), "em " & _tsaFrase ) )
			VAR _tsb = PATHITEM ( _tops, 2 ) & ""
			VAR _tsbFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _tsb )
			VAR _tsbFr = IF ( _tsb = "", "", SWITCH ( TRUE (), LEFT ( _tsbFrase, 3 ) = "os ", "nos " & MID ( _tsbFrase, 4, 99 ), LEFT ( _tsbFrase, 3 ) = "as ", "nas " & MID ( _tsbFrase, 4, 99 ), LEFT ( _tsbFrase, 2 ) = "o ", "no " & MID ( _tsbFrase, 3, 99 ), LEFT ( _tsbFrase, 2 ) = "a ", "na " & MID ( _tsbFrase, 3, 99 ), "em " & _tsbFrase ) )
			VAR _tsc = PATHITEM ( _tops, 3 ) & ""
			VAR _tscFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _tsc )
			VAR _tscFr = IF ( _tsc = "", "", SWITCH ( TRUE (), LEFT ( _tscFrase, 3 ) = "os ", "nos " & MID ( _tscFrase, 4, 99 ), LEFT ( _tscFrase, 3 ) = "as ", "nas " & MID ( _tscFrase, 4, 99 ), LEFT ( _tscFrase, 2 ) = "o ", "no " & MID ( _tscFrase, 3, 99 ), LEFT ( _tscFrase, 2 ) = "a ", "na " & MID ( _tscFrase, 3, 99 ), "em " & _tscFrase ) )
			VAR _tsFr = SWITCH ( _tsN, 0, "", 1, _tsaFr, 2, _tsaFr & " e " & _tsbFr, 3, _tsaFr & ", " & _tsbFr & " e " & _tscFr, "em " & SWITCH ( _tsN, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _tsN, "0" ) ) & " itens empatados" )
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _lcN = IF ( ISBLANK ( _listaCrit ) || _listaCrit = "", 0, PATHLENGTH ( _listaCrit ) )
			VAR _lcPos = IF ( _lcN >= 2, FIND ( "§", SUBSTITUTE ( _listaCrit, "|", "§", _lcN - 1 ) ) )
			VAR _lcTxt = SWITCH ( TRUE (), _lcN = 0, "", _lcN = 1, _listaCrit, SUBSTITUTE ( LEFT ( _listaCrit, _lcPos - 1 ), "|", ", " ) & " e " & MID ( _listaCrit, _lcPos + 1, 999 ) )
			VAR _laN = IF ( ISBLANK ( _listaAten ) || _listaAten = "", 0, PATHLENGTH ( _listaAten ) )
			VAR _laPos = IF ( _laN >= 2, FIND ( "§", SUBSTITUTE ( _listaAten, "|", "§", _laN - 1 ) ) )
			VAR _laTxt = SWITCH ( TRUE (), _laN = 0, "", _laN = 1, _listaAten, SUBSTITUTE ( LEFT ( _listaAten, _laPos - 1 ), "|", ", " ) & " e " & MID ( _listaAten, _laPos + 1, 999 ) )
			VAR _leN = IF ( ISBLANK ( _listaEst ) || _listaEst = "", 0, PATHLENGTH ( _listaEst ) )
			VAR _lePos = IF ( _leN >= 2, FIND ( "§", SUBSTITUTE ( _listaEst, "|", "§", _leN - 1 ) ) )
			VAR _leTxt = SWITCH ( TRUE (), _leN = 0, "", _leN = 1, _listaEst, SUBSTITUTE ( LEFT ( _listaEst, _lePos - 1 ), "|", ", " ) & " e " & MID ( _listaEst, _lePos + 1, 999 ) )
			VAR _lpN = IF ( ISBLANK ( _listaPend ) || _listaPend = "", 0, PATHLENGTH ( _listaPend ) )
			VAR _lpPos = IF ( _lpN >= 2, FIND ( "§", SUBSTITUTE ( _listaPend, "|", "§", _lpN - 1 ) ) )
			VAR _lpTxt = SWITCH ( TRUE (), _lpN = 0, "", _lpN = 1, _listaPend, SUBSTITUTE ( LEFT ( _listaPend, _lpPos - 1 ), "|", ", " ) & " e " & MID ( _listaPend, _lpPos + 1, 999 ) )
			VAR _txtSob = "LEITURA · OBRAS PELA NOTA · " & UPPER ( _mesL )
			VAR _tA = IF ( _a = 0, "", IF ( _laN <= 3, _laTxt, SWITCH ( _a, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _a, "0" ) ) & " obras" ) & IF ( _a = 1, " pede atenção", " pedem atenção" ) )
			VAR _tE = IF ( _e = 0, "", IF ( _leN <= 3, _leTxt, SWITCH ( _e, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _e, "0" ) ) & " obras" ) & IF ( _e = 1, " segue estável", " seguem estáveis" ) )
			VAR _tP = IF ( _p = 0, "", IF ( _c + _a + _e = 0, "", "as outras " ) & IF ( _p = 1, "uma está pendente", SWITCH ( _p, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _p, "0" ) ) & " estão pendentes" ) )
			VAR _nOut = INT ( _a > 0 ) + INT ( _e > 0 ) + INT ( _p > 0 )
			VAR _txtOut =
			    SWITCH (
			        _nOut,
			        0, "",
			        1, _tA & _tE & _tP,
			        2, IF ( _a > 0, _tA & IF ( _e > 0, " e " & _tE, "; " & _tP ), _tE & "; " & _tP ),
			        _tA & ", " & _tE & "; " & _tP
			    )
			VAR _txtAchado =
			    SWITCH (
			        TRUE (),
			        _c + _a + _e + _p = 0, "Nenhuma obra com planilha em " & _mesN & ".",
			        _c + _a + _e = 0, IF ( _p = 1, "A obra está pendente em ", "As " & SWITCH ( _p, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _p, "0" ) ) & " obras estão pendentes em " ) & _mesN & ": " & IF ( _ondeSoFora, "há valor fora da faixa na base complementar", "falta item " & _onde & _ondeFora ) & ".",
			        _c = 0, "Nenhuma obra crítica em " & _mesN & ": " & _txtOut & ".",
			        _c = 1, "Uma obra crítica em " & _mesN & ": " & _lcTxt & "." & IF ( _txtOut = "", "", " " & UPPER ( LEFT ( _txtOut, 1 ) ) & MID ( _txtOut, 2, LEN ( _txtOut ) ) & "." ),
			        UPPER ( LEFT ( SWITCH ( _c, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _c, "0" ) ), 1 ) ) & MID ( SWITCH ( _c, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _c, "0" ) ), 2, LEN ( SWITCH ( _c, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _c, "0" ) ) ) ) & " obras críticas em " & _mesN & ": " & _lcTxt & "." & IF ( _txtOut = "", "", " " & UPPER ( LEFT ( _txtOut, 1 ) ) & MID ( _txtOut, 2, LEN ( _txtOut ) ) & "." )
			    )
			VAR _txtO1 =
			    SWITCH (
			        TRUE (),
			        _o1 = "" || NOT ( _perd1 > 0 ), "Nenhuma obra perdeu pontos nos itens com dado.",
			        _pend1 = 1, "Nos itens que já têm dado, quem mais perde é a " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _o1, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & ", pendente: perde mais " & _jFr & ".",
			        "Quem mais perde pontos é a " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _o1, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & ", " & SWITCH ( _st1, 2, "crítica", 1, "em atenção", "estável" ) & ": perde mais " & _jFr & "."
			    )
			VAR _txtPend = IF ( _p = 0 || _c + _a + _e = 0, "", " " & IF ( _p = 1, "A pendente, ", "As pendentes, " ) & _lpTxt & IF ( _p = 1, ", ainda não tem nota", ", ainda não têm nota" ) & ": " & IF ( _ondeSoFora, "há valor fora da faixa na base complementar", "falta dado " & _onde & _ondeFora ) & "." )
			VAR _txtExplica =
			    IF (
			        _c > 0,
			        TRIM ( _c1Fr & _c2Fr & _c3Fr & IF ( _c > 3, "Há mais obras críticas na lista. ", "" ) ) & _txtPend,
			        _txtO1 & _txtPend
			    )
			VAR _txtOq =
			    SWITCH (
			        TRUE (),
			        _top = "", "Nenhum item da nota perdeu pontos no mês.",
			        _esp = _top && _tsN = 1, UPPER ( LEFT ( _tFrase, 1 ) ) & MID ( _tFrase, 2, LEN ( _tFrase ) ) & " é onde a carteira mais perde, em pontos e em obras atingidas.",
			        "A carteira perde mais pontos " & _tsFr & IF ( _tsN > 1, ", empatados", "" ) & "; a perda que atinge mais obras está " & _sFr & "."
			    )
			VAR _txtP1 = FORMAT ( _perd1, "0.0#", "pt-BR" )
			VAR _p1KP = LEN ( _txtP1 ) > 0
			VAR _p1KN = IF ( _p1KP, _txtP1 )
			VAR _p1KS = SUBSTITUTE ( SUBSTITUTE ( _p1KN, ".", "" ), ",", "" )
			VAR _p1KT = IFERROR ( VALUE ( _p1KS ), -1 )
			VAR _p1KOk = _p1KP && _p1KT >= 2 && FORMAT ( _p1KT, REPT ( "0", LEN ( _p1KS ) ) ) = _p1KS
			VAR _p1KD = IF ( CONTAINSSTRING ( _p1KN, "," ), LEN ( _p1KN ) - SEARCH ( ",", _p1KN ), 0 )
			VAR _p1KM = IF ( CONTAINSSTRING ( _p1KN, "." ), "#,##0", "0" ) & IF ( _p1KD > 0, "." & REPT ( "0", _p1KD ) )
			VAR _p1KOd =
			    IF (
			        _p1KOk,
			        "<o-d><o-v>" & _p1KN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _p1KN, FORMAT ( ROUND ( _p1KT * [@odf] / 1000, 0 ) / POWER ( 10, _p1KD ), _p1KM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _txtP1
			    )
			VAR _txtTop = FORMAT ( _topPerd, "0.0#", "pt-BR" )
			VAR _tpKP = LEN ( _txtTop ) > 0
			VAR _tpKN = IF ( _tpKP, _txtTop )
			VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
			VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
			VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
			VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
			VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
			VAR _tpKOd =
			    IF (
			        _tpKOk,
			        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _txtTop
			    )
			VAR _txtFalta = FORMAT ( _falta, "0" )
			VAR _fKP = LEN ( _txtFalta ) > 0
			VAR _fKN = IF ( _fKP, _txtFalta )
			VAR _fKS = SUBSTITUTE ( SUBSTITUTE ( _fKN, ".", "" ), ",", "" )
			VAR _fKT = IFERROR ( VALUE ( _fKS ), -1 )
			VAR _fKOk = _fKP && _fKT >= 2 && FORMAT ( _fKT, REPT ( "0", LEN ( _fKS ) ) ) = _fKS
			VAR _fKD = IF ( CONTAINSSTRING ( _fKN, "," ), LEN ( _fKN ) - SEARCH ( ",", _fKN ), 0 )
			VAR _fKM = IF ( CONTAINSSTRING ( _fKN, "." ), "#,##0", "0" ) & IF ( _fKD > 0, "." & REPT ( "0", _fKD ) )
			VAR _fKOd =
			    IF (
			        _fKOk,
			        "<o-d><o-v>" & _fKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _fKN, FORMAT ( ROUND ( _fKT * [@odf] / 1000, 0 ) / POWER ( 10, _fKD ), _fKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _txtFalta
			    )
			VAR _txtD1 = IF ( NOT ( _perd1 > 0 ), "pontos perdidos: nenhuma obra perdeu", "pontos que a " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _o1, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " perde, a maior perda da carteira" )
			VAR _txtD2 = IF ( _top = "", "pontos perdidos por item", "pontos perdidos " & _tsFr & IF ( _tsN > 1, ", cada um", "" ) & ", somadas as obras" )
			VAR _txtD3 = IF ( _falta = 1, "item ainda sem dado, somadas as obras", "itens ainda sem dado, somadas as obras" )
			-- 3 · Geometria
			VAR _nLinhas = COUNTROWS ( _comPos ) /* geometria */
			VAR _alt = _nLinhas * 30 -- geometria
			VAR _xA = 108 + ROUND ( _limA / _max * 232, 0 ) -- geometria
			VAR _xE = 108 + ROUND ( _limE / _max * 232, 0 ) -- geometria
			-- 4 · Marcação
			VAR _htmlBarras =
			    CONCATENATEX (
			        _comPos,
			        VAR _pd = [@pend] = 1
			        VAR _lN = MAX ( 2, ROUND ( MIN ( [@nota], _max ) / _max * 232, 0 ) ) -- geometria
			        VAR _lO = MAX ( 2, ROUND ( MIN ( [@obt], _max ) / _max * 232, 0 ) ) -- geometria
			        VAR _lP = ROUND ( MIN ( [@poss], _max ) / _max * 232, 0 ) -- geometria
			        VAR _atraso = 500 + ( [@pos] - 1 ) * 60 -- geometria
			        VAR _barra =
			            IF (
			                _pd,
			                "<u class='a-gx' style='width:" & _lP & "px;animation-delay:" & _atraso & "ms'></u>"
			                    & "<i class='sm' style='width:" & _lO & "px' data-rk='"
			                    & dObra[Obra] & "' data-rd='" & _atraso & "'></i>",
			                "<i class='s" & [@s] & "' style='width:" & _lN & "px' data-rk='" & dObra[Obra] & "' data-rd='"
			                    & _atraso & "'></i>"
			            )
			        RETURN
			            "<div class='r'><b>" & dObra[Obra] & "</b><div class='tr'>" & _barra & "</div></div>",
			        "",
			        [@pos], ASC
			    )
			VAR _htmlDet =
			    "<span class='vs'>Detalhe · nota das " & SWITCH ( _nObras, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _nObras, "0" ) ) & " obras</span>"
			        & "<p class='sub'>as linhas marcam onde começam a atenção e o estável; a pendente vai tracejada até o que já dá para calcular</p>"
			        & "<div class='bp' style='height:" & ( _alt + 22 ) & "px'>" & _htmlBarras
			        & "<i class='lim' style='left:" & _xA & "px;height:" & _alt & "px'></i>"
			        & "<i class='lim' style='left:" & _xE & "px;height:" & _alt & "px'></i>"
			        & "<span class='lr la a-fd' style='left:" & _xA & "px;top:" & ( _alt + 4 ) & "px;animation-delay:400ms'>atenção</span>"
			        & "<span class='lr le a-fd' style='left:" & _xE & "px;top:" & ( _alt + 4 ) & "px;animation-delay:400ms'>estável</span>"
			        & "</div>"
			VAR _htmlDst =
			    "<div class='dst sobre-creme'>"
			        & "<div><b>" & IF ( NOT ( _perd1 > 0 ), "0", _p1KOd ) & "</b><span>" & _txtD1 & "</span></div>"
			        & "<div><b>" & IF ( _top = "", "0", _tpKOd ) & "</b><span>" & _txtD2 & "</span></div>"
			        & "<div><b>" & _fKOd & "</b><span>" & _txtD3 & "</span></div>"
			    & "</div>"
			VAR _txtComoLer =
			    "<p class='cl'>A Nota da obra soma nove itens, de 0 a " & "⁅" & FORMAT ( _max, "0", "pt-BR" ) & "⁆" & " pontos: "
			        & "quatro vêm da Análise Crítica e cinco da base complementar, preenchida a cada mês. Estável com nota " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fxE, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "; atenção de " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fxA, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "; crítico com " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fxC, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & ". IDC abaixo de " & "⁅" & FORMAT ( _trvC, "0.00", "pt-BR" ) & "⁆" & " ou atraso acima de " & "⁅" & FORMAT ( _trvP, "0", "pt-BR" ) & "⁆" & " meses deixam a obra crítica, qualquer que seja a nota. Enquanto falta item, a obra fica pendente: mostra os pontos que já dá para calcular e não recebe status.</p>"
			VAR _esq =
			    "<div class='esq'><span class='vs sob'>" & _txtSob & "</span>"
			        & "<h2 class='ach'>" & _txtAchado & "</h2>"
			        & "<p class='exp'>" & _txtExplica & "</p>"
			        & _htmlDst
			        & "<div class='sec'><span class='vs'>O que explica</span>" & "<p class='oqe'>" & _txtOq & "</p>" & "</div>"
			    & "</div>"
			VAR _dir =
			    "<div class='dir'>" & _htmlDet
			        & "<div class='sec'><span class='vs'>Como ler</span>" & _txtComoLer & "</div>"
			    & "</div>"
			VAR _corpo = "<div class='cols'>" & _esq & "<i class='div'></i>" & _dir & "</div>"
			VAR _saidaHtml =
			    IF ( _nObras > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura da lista de obras pela Nota da obra" & "'><div class='pn pn-obras'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Leituras
		lineageTag: 40e83cbb-8767-5dca-a144-5795864ed6b8

	/// Leitura do "?" de 'Onde a carteira perde pontos', sobre o próprio painel (L065, 464 × 406, condensada): a dimensão em que a perda mais se espalha e a que mais soma pontos perdidos, três destaques em linha que contam (pontos perdidos na dimensão que mais pesa, itens sem dado, justificativas do desembolso preenchidas) e de que obras vem a maior parte da perda. Faixas e conta obra por obra ficam no tooltip da dimensão. Só lê contas.
	measure 'T1 · Leitura pesa · HTML' =
			-- 1 · Leituras
			VAR _mesC = [Mês de referência · curto maiúsculo]
			VAR _mesN = [Mês de referência · nome]
			VAR _nObras = [Recorte · obras no recorte] + 0
			VAR _top = [T1 · Leitura · dimensão que mais perde] & ""
			VAR _esp = [T1 · Leitura · dimensão mais espalhada] & ""
			VAR _espN = [T1 · Leitura · dimensão mais espalhada · obras] + 0
			VAR _stMais = [T1 · Leitura · status que mais perde] & ""
			VAR _topPerd = CALCULATE ( [Nota · item · perdidos · ref], dItemNota[Dimensao] = _top )
			VAR _falta = [T1 · Leitura · itens sem dado na carteira]
			VAR _jusEx = [Carteira · justificativas exigidas · ref] + 0
			VAR _jusPre = [Carteira · justificativas preenchidas · ref] + 0
			VAR _tNome = SWITCH ( _top, "Custo", "o custo", "Prazo", "o prazo", "Caixa", "o caixa", "Qualidade", "a qualidade", "Segurança", "a segurança", "Suprimentos", "os suprimentos", "Gestão", "a gestão", LOWER ( _top ) )
			VAR _tops = [T1 · Leitura · dimensões que mais perdem (lista)] & ""
			VAR _tsN = IF ( _tops = "", 0, PATHLENGTH ( _tops ) )
			VAR _tsa = PATHITEM ( _tops, 1 ) & ""
			VAR _tsaFrase = SWITCH ( _tsa, "Custo", "o custo", "Prazo", "o prazo", "Caixa", "o caixa", "Qualidade", "a qualidade", "Segurança", "a segurança", "Suprimentos", "os suprimentos", "Gestão", "a gestão", LOWER ( _tsa ) )
			VAR _tsaFr = IF ( _tsa = "", "", SWITCH ( TRUE (), LEFT ( _tsaFrase, 3 ) = "os ", "nos " & MID ( _tsaFrase, 4, 99 ), LEFT ( _tsaFrase, 3 ) = "as ", "nas " & MID ( _tsaFrase, 4, 99 ), LEFT ( _tsaFrase, 2 ) = "o ", "no " & MID ( _tsaFrase, 3, 99 ), LEFT ( _tsaFrase, 2 ) = "a ", "na " & MID ( _tsaFrase, 3, 99 ), "em " & _tsaFrase ) )
			VAR _tsb = PATHITEM ( _tops, 2 ) & ""
			VAR _tsbFrase = SWITCH ( _tsb, "Custo", "o custo", "Prazo", "o prazo", "Caixa", "o caixa", "Qualidade", "a qualidade", "Segurança", "a segurança", "Suprimentos", "os suprimentos", "Gestão", "a gestão", LOWER ( _tsb ) )
			VAR _tsbFr = IF ( _tsb = "", "", SWITCH ( TRUE (), LEFT ( _tsbFrase, 3 ) = "os ", "nos " & MID ( _tsbFrase, 4, 99 ), LEFT ( _tsbFrase, 3 ) = "as ", "nas " & MID ( _tsbFrase, 4, 99 ), LEFT ( _tsbFrase, 2 ) = "o ", "no " & MID ( _tsbFrase, 3, 99 ), LEFT ( _tsbFrase, 2 ) = "a ", "na " & MID ( _tsbFrase, 3, 99 ), "em " & _tsbFrase ) )
			VAR _tsc = PATHITEM ( _tops, 3 ) & ""
			VAR _tscFrase = SWITCH ( _tsc, "Custo", "o custo", "Prazo", "o prazo", "Caixa", "o caixa", "Qualidade", "a qualidade", "Segurança", "a segurança", "Suprimentos", "os suprimentos", "Gestão", "a gestão", LOWER ( _tsc ) )
			VAR _tscFr = IF ( _tsc = "", "", SWITCH ( TRUE (), LEFT ( _tscFrase, 3 ) = "os ", "nos " & MID ( _tscFrase, 4, 99 ), LEFT ( _tscFrase, 3 ) = "as ", "nas " & MID ( _tscFrase, 4, 99 ), LEFT ( _tscFrase, 2 ) = "o ", "no " & MID ( _tscFrase, 3, 99 ), LEFT ( _tscFrase, 2 ) = "a ", "na " & MID ( _tscFrase, 3, 99 ), "em " & _tscFrase ) )
			VAR _tsFr = SWITCH ( _tsN, 0, "", 1, _tsaFr, 2, _tsaFr & " e " & _tsbFr, 3, _tsaFr & ", " & _tsbFr & " e " & _tscFr, "em " & SWITCH ( _tsN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _tsN, "0" ) ) & " dimensões empatadas" )
			VAR _sNome = SWITCH ( _esp, "Custo", "o custo", "Prazo", "o prazo", "Caixa", "o caixa", "Qualidade", "a qualidade", "Segurança", "a segurança", "Suprimentos", "os suprimentos", "Gestão", "a gestão", LOWER ( _esp ) )
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _txtSob = "LEITURA · ONDE A CARTEIRA PERDE PONTOS · " & _mesC
			VAR _txtQuantas = IF ( _espN = _nObras, "todas as " & "⁅" & _nObras & "⁆" & " obras", "⁅" & _espN & "⁆" & " das " & "⁅" & _nObras & "⁆" & " obras" )
			VAR _txtAchado =
			    SWITCH (
			        TRUE (),
			        _top = "", "Nenhuma dimensão da nota perdeu pontos em " & _mesN & ".",
			        _esp = _top && _tsN = 1, UPPER ( LEFT ( _tNome, 1 ) ) & MID ( _tNome, 2, LEN ( _tNome ) ) & " é onde a carteira mais perde: em " & _txtQuantas & ".",
			        UPPER ( LEFT ( _sNome, 1 ) ) & MID ( _sNome, 2, LEN ( _sNome ) ) & " é a perda mais espalhada: " & _txtQuantas & "."
			    )
			VAR _txtExp =
			    SWITCH (
			        TRUE (),
			        _top = "", "",
			        _esp = _top && _tsN = 1, "É também a dimensão que mais soma pontos perdidos.",
			        "Em pontos somados, a carteira perde mais " & _tsFr & IF ( _tsN > 1, ", empatados", "" ) & "."
			    )
			VAR _txtFaltaExp = IF ( _falta > 0, " Onde falta dado, a perda ainda não aparece.", "" )
			VAR _txtOq =
			    SWITCH (
			        _stMais,
			        "2", "A maior parte da perda vem das obras críticas.",
			        "1", "A maior parte da perda vem das obras em atenção.",
			        "0", "A maior parte da perda vem das obras estáveis.",
			        "m", "A maior parte da perda vem das obras pendentes.",
			        "Nenhuma obra perdeu pontos no mês."
			    )
			VAR _txtTop = FORMAT ( _topPerd, "0.0#", "pt-BR" )
			VAR _tpKP = LEN ( _txtTop ) > 0
			VAR _tpKN = IF ( _tpKP, _txtTop )
			VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
			VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
			VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
			VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
			VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
			VAR _tpKOd =
			    IF (
			        _tpKOk,
			        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _txtTop
			    )
			VAR _txtFalta = FORMAT ( _falta, "0" )
			VAR _fKP = LEN ( _txtFalta ) > 0
			VAR _fKN = IF ( _fKP, _txtFalta )
			VAR _fKS = SUBSTITUTE ( SUBSTITUTE ( _fKN, ".", "" ), ",", "" )
			VAR _fKT = IFERROR ( VALUE ( _fKS ), -1 )
			VAR _fKOk = _fKP && _fKT >= 2 && FORMAT ( _fKT, REPT ( "0", LEN ( _fKS ) ) ) = _fKS
			VAR _fKD = IF ( CONTAINSSTRING ( _fKN, "," ), LEN ( _fKN ) - SEARCH ( ",", _fKN ), 0 )
			VAR _fKM = IF ( CONTAINSSTRING ( _fKN, "." ), "#,##0", "0" ) & IF ( _fKD > 0, "." & REPT ( "0", _fKD ) )
			VAR _fKOd =
			    IF (
			        _fKOk,
			        "<o-d><o-v>" & _fKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _fKN, FORMAT ( ROUND ( _fKT * [@odf] / 1000, 0 ) / POWER ( 10, _fKD ), _fKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _txtFalta
			    )
			VAR _tjpN = FORMAT ( _jusPre, "#,0", "pt-BR" )
			VAR _tjpTxt = IF ( ISBLANK ( _jusPre ), "0", _tjpN )
			VAR _tjpKP = LEN ( _tjpN ) > 0
			VAR _tjpKN = IF ( _tjpKP, _tjpN )
			VAR _tjpKS = SUBSTITUTE ( SUBSTITUTE ( _tjpKN, ".", "" ), ",", "" )
			VAR _tjpKT = IFERROR ( VALUE ( _tjpKS ), -1 )
			VAR _tjpKOk = _tjpKP && _tjpKT >= 2 && FORMAT ( _tjpKT, REPT ( "0", LEN ( _tjpKS ) ) ) = _tjpKS
			VAR _tjpKD = IF ( CONTAINSSTRING ( _tjpKN, "," ), LEN ( _tjpKN ) - SEARCH ( ",", _tjpKN ), 0 )
			VAR _tjpKM = IF ( CONTAINSSTRING ( _tjpKN, "." ), "#,##0", "0" ) & IF ( _tjpKD > 0, "." & REPT ( "0", _tjpKD ) )
			VAR _tjpKOd =
			    IF (
			        _tjpKOk,
			        "<o-d><o-v>" & _tjpKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tjpKN, FORMAT ( ROUND ( _tjpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tjpKD ), _tjpKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tjpN
			    )
			VAR _tjpOd = IF ( ISBLANK ( _jusPre ), _tjpTxt, _tjpKOd )
			VAR _txtD1 = IF ( _top = "", "pontos perdidos no mês", "perdidos " & _tsFr & IF ( _tsN > 1, ", cada uma, as maiores", ", a maior perda" ) )
			VAR _txtD2 = IF ( _falta = 1, "item sem dado na carteira", "itens sem dado na carteira" )
			VAR _txtD3 = IF ( _jusEx = 0, "nenhum desembolso pediu justificativa", "justificativas do desembolso preenchidas" )
			-- 4 · Marcação
			VAR _htmlDst =
			    "<div class='dst dst-l'>"
			        & "<div class='dl'><b>" & IF ( _top = "", "0", _tpKOd ) & " pts" & "</b><span>" & _txtD1 & "</span></div>"
			        & "<div class='dl'><b>" & _fKOd & "</b><span>" & _txtD2 & "</span></div>"
			        & "<div class='dl'><b>" & IF ( _jusEx = 0, "0", _tjpOd & " de " & "⁅" & _jusEx & "⁆" ) & "</b><span>" & _txtD3 & "</span></div>"
			    & "</div>"
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span>"
			        & "<h2 class='ach'>" & _txtAchado & "</h2>"
			        & "<p class='exp'>" & _txtExp & _txtFaltaExp & "</p>"
			        & _htmlDst
			        & "<div class='sec'><span class='vs'>O que explica</span>" & "<p class='oqe'>" & _txtOq & "</p>" & "</div>"
			VAR _saidaHtml =
			    IF ( _nObras > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura de Onde a carteira perde pontos" & "'><div class='pn pn-peq'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Leituras
		lineageTag: 2cdd69b4-4dd1-5746-8b62-d64ee92caf2e

	/// Leitura do "?" de Como os meses evoluíram, sobre o próprio painel (L065, 464 × 321, condensada mínima): obras críticas e pendentes na nota do primeiro mês da janela ao de referência, quando a piora começou e se firmou (entrou ou abriu em crítico, pela regra nova), o pico e quem saiu de crítico, e três destaques em linha que contam. A linha do tempo fica no tooltip do mês. Só lê contas.
	measure 'T1 · Leitura semestre · HTML' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _nMeses = [Série · meses até a referência] + 0
			VAR _mesC = [Mês de referência · curto maiúsculo]
			VAR _mesN = [Mês de referência · nome]
			VAR _nObras = [Recorte · obras no recorte] + 0
			VAR _critIni = [T1 · Leitura · obras críticas no primeiro mês] + 0
			VAR _critRef = [Nota · carteira · obras críticas · ref] + 0
			VAR _pendIni = [T1 · Leitura · obras pendentes no primeiro mês] + 0
			VAR _pendRef = [Nota · carteira · obras pendentes · ref] + 0
			VAR _ativIni = [T1 · Leitura · ativos no primeiro mês]
			VAR _ativRef = [Ativos não consumidos · ref]
			VAR _fisIni = [T1 · Leitura · desvio físico no primeiro mês]
			VAR _fisRef = [Físico · desvio acumulado p.p. · ref]
			VAR _pico = [T1 · Leitura · pico de obras críticas] + 0
			VAR _picoMes = [T1 · Leitura · mês do pico de obras críticas]
			VAR _e1 = [T1 · Leitura · mês em que a piora começou]
			VAR _e2 = [T1 · Leitura · mês em que a piora se firmou]
			VAR _e1Obras = CALCULATE ( [T1 · Leitura · obras que entraram em crítico (lista)], dMes[Mes] = _e1 )
			VAR _e1Abriu = CALCULATE ( [T1 · Leitura · obras que abriram em crítico (lista)], dMes[Mes] = _e1 )
			VAR _e2Obras = CALCULATE ( [T1 · Leitura · obras que entraram em crítico (lista)], dMes[Mes] = _e2 )
			VAR _e2Abriu = CALCULATE ( [T1 · Leitura · obras que abriram em crítico (lista)], dMes[Mes] = _e2 )
			VAR _saiRef = IF ( _ref > _ini, CALCULATE ( [T1 · Leitura · obras que saíram de crítico (lista)], dMes[Mes] = _ref ) )
			VAR _e1O1 = PATHITEM ( _e1Obras, 1 )
			VAR _e2O1 = PATHITEM ( _e2Obras, 1 )
			VAR _e1L = CALCULATE ( [T1 · Obras · itens que mais perdem (lista)], dMes[Mes] = _e1, dObra[Obra] = _e1O1 ) & ""
			VAR _e2L = CALCULATE ( [T1 · Obras · itens que mais perdem (lista)], dMes[Mes] = _e2, dObra[Obra] = _e2O1 ) & ""
			VAR _i1N = IF ( _e1L = "", 0, PATHLENGTH ( _e1L ) )
			VAR _i1a = PATHITEM ( _e1L, 1 ) & ""
			VAR _i1aFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i1a )
			VAR _i1aFr = IF ( _i1a = "", "", SWITCH ( TRUE (), LEFT ( _i1aFrase, 3 ) = "os ", "nos " & MID ( _i1aFrase, 4, 99 ), LEFT ( _i1aFrase, 3 ) = "as ", "nas " & MID ( _i1aFrase, 4, 99 ), LEFT ( _i1aFrase, 2 ) = "o ", "no " & MID ( _i1aFrase, 3, 99 ), LEFT ( _i1aFrase, 2 ) = "a ", "na " & MID ( _i1aFrase, 3, 99 ), "em " & _i1aFrase ) )
			VAR _i1b = PATHITEM ( _e1L, 2 ) & ""
			VAR _i1bFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i1b )
			VAR _i1bFr = IF ( _i1b = "", "", SWITCH ( TRUE (), LEFT ( _i1bFrase, 3 ) = "os ", "nos " & MID ( _i1bFrase, 4, 99 ), LEFT ( _i1bFrase, 3 ) = "as ", "nas " & MID ( _i1bFrase, 4, 99 ), LEFT ( _i1bFrase, 2 ) = "o ", "no " & MID ( _i1bFrase, 3, 99 ), LEFT ( _i1bFrase, 2 ) = "a ", "na " & MID ( _i1bFrase, 3, 99 ), "em " & _i1bFrase ) )
			VAR _i1c = PATHITEM ( _e1L, 3 ) & ""
			VAR _i1cFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i1c )
			VAR _i1cFr = IF ( _i1c = "", "", SWITCH ( TRUE (), LEFT ( _i1cFrase, 3 ) = "os ", "nos " & MID ( _i1cFrase, 4, 99 ), LEFT ( _i1cFrase, 3 ) = "as ", "nas " & MID ( _i1cFrase, 4, 99 ), LEFT ( _i1cFrase, 2 ) = "o ", "no " & MID ( _i1cFrase, 3, 99 ), LEFT ( _i1cFrase, 2 ) = "a ", "na " & MID ( _i1cFrase, 3, 99 ), "em " & _i1cFrase ) )
			VAR _i1Fr = SWITCH ( _i1N, 0, "", 1, _i1aFr, 2, _i1aFr & " e " & _i1bFr, 3, _i1aFr & ", " & _i1bFr & " e " & _i1cFr, "em " & SWITCH ( _i1N, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _i1N, "0" ) ) & " itens empatados" )
			VAR _i2N = IF ( _e2L = "", 0, PATHLENGTH ( _e2L ) )
			VAR _i2a = PATHITEM ( _e2L, 1 ) & ""
			VAR _i2aFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i2a )
			VAR _i2aFr = IF ( _i2a = "", "", SWITCH ( TRUE (), LEFT ( _i2aFrase, 3 ) = "os ", "nos " & MID ( _i2aFrase, 4, 99 ), LEFT ( _i2aFrase, 3 ) = "as ", "nas " & MID ( _i2aFrase, 4, 99 ), LEFT ( _i2aFrase, 2 ) = "o ", "no " & MID ( _i2aFrase, 3, 99 ), LEFT ( _i2aFrase, 2 ) = "a ", "na " & MID ( _i2aFrase, 3, 99 ), "em " & _i2aFrase ) )
			VAR _i2b = PATHITEM ( _e2L, 2 ) & ""
			VAR _i2bFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i2b )
			VAR _i2bFr = IF ( _i2b = "", "", SWITCH ( TRUE (), LEFT ( _i2bFrase, 3 ) = "os ", "nos " & MID ( _i2bFrase, 4, 99 ), LEFT ( _i2bFrase, 3 ) = "as ", "nas " & MID ( _i2bFrase, 4, 99 ), LEFT ( _i2bFrase, 2 ) = "o ", "no " & MID ( _i2bFrase, 3, 99 ), LEFT ( _i2bFrase, 2 ) = "a ", "na " & MID ( _i2bFrase, 3, 99 ), "em " & _i2bFrase ) )
			VAR _i2c = PATHITEM ( _e2L, 3 ) & ""
			VAR _i2cFrase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i2c )
			VAR _i2cFr = IF ( _i2c = "", "", SWITCH ( TRUE (), LEFT ( _i2cFrase, 3 ) = "os ", "nos " & MID ( _i2cFrase, 4, 99 ), LEFT ( _i2cFrase, 3 ) = "as ", "nas " & MID ( _i2cFrase, 4, 99 ), LEFT ( _i2cFrase, 2 ) = "o ", "no " & MID ( _i2cFrase, 3, 99 ), LEFT ( _i2cFrase, 2 ) = "a ", "na " & MID ( _i2cFrase, 3, 99 ), "em " & _i2cFrase ) )
			VAR _i2Fr = SWITCH ( _i2N, 0, "", 1, _i2aFr, 2, _i2aFr & " e " & _i2bFr, 3, _i2aFr & ", " & _i2bFr & " e " & _i2cFr, "em " & SWITCH ( _i2N, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _i2N, "0" ) ) & " itens empatados" )
			VAR _entRef = IF ( _ref > _ini && _ref <> _e1 && _ref <> _e2, CALCULATE ( [T1 · Leitura · obras que entraram em crítico (lista)], dMes[Mes] = _ref ) )
			VAR _abrRef = IF ( _ref > _ini && _ref <> _e1 && _ref <> _e2, CALCULATE ( [T1 · Leitura · obras que abriram em crítico (lista)], dMes[Mes] = _ref ) )
			VAR _saiO1 = PATHITEM ( _saiRef, 1 )
			VAR _saiSt = CALCULATE ( [Nota · status · ranking · ref], dObra[Obra] = _saiO1 )
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _l1N = IF ( ISBLANK ( _e1Obras ) || _e1Obras = "", 0, PATHLENGTH ( _e1Obras ) )
			VAR _l1Pos = IF ( _l1N >= 2, FIND ( "§", SUBSTITUTE ( _e1Obras, "|", "§", _l1N - 1 ) ) )
			VAR _l1Txt = SWITCH ( TRUE (), _l1N = 0, "", _l1N = 1, _e1Obras, SUBSTITUTE ( LEFT ( _e1Obras, _l1Pos - 1 ), "|", ", " ) & " e " & MID ( _e1Obras, _l1Pos + 1, 999 ) )
			VAR _l2N = IF ( ISBLANK ( _e2Obras ) || _e2Obras = "", 0, PATHLENGTH ( _e2Obras ) )
			VAR _l2Pos = IF ( _l2N >= 2, FIND ( "§", SUBSTITUTE ( _e2Obras, "|", "§", _l2N - 1 ) ) )
			VAR _l2Txt = SWITCH ( TRUE (), _l2N = 0, "", _l2N = 1, _e2Obras, SUBSTITUTE ( LEFT ( _e2Obras, _l2Pos - 1 ), "|", ", " ) & " e " & MID ( _e2Obras, _l2Pos + 1, 999 ) )
			VAR _lsN = IF ( ISBLANK ( _saiRef ) || _saiRef = "", 0, PATHLENGTH ( _saiRef ) )
			VAR _lsPos = IF ( _lsN >= 2, FIND ( "§", SUBSTITUTE ( _saiRef, "|", "§", _lsN - 1 ) ) )
			VAR _lsTxt = SWITCH ( TRUE (), _lsN = 0, "", _lsN = 1, _saiRef, SUBSTITUTE ( LEFT ( _saiRef, _lsPos - 1 ), "|", ", " ) & " e " & MID ( _saiRef, _lsPos + 1, 999 ) )
			VAR _a1N = IF ( ISBLANK ( _e1Abriu ) || _e1Abriu = "", 0, PATHLENGTH ( _e1Abriu ) )
			VAR _a1Pos = IF ( _a1N >= 2, FIND ( "§", SUBSTITUTE ( _e1Abriu, "|", "§", _a1N - 1 ) ) )
			VAR _a1Txt = SWITCH ( TRUE (), _a1N = 0, "", _a1N = 1, _e1Abriu, SUBSTITUTE ( LEFT ( _e1Abriu, _a1Pos - 1 ), "|", ", " ) & " e " & MID ( _e1Abriu, _a1Pos + 1, 999 ) )
			VAR _a2N = IF ( ISBLANK ( _e2Abriu ) || _e2Abriu = "", 0, PATHLENGTH ( _e2Abriu ) )
			VAR _a2Pos = IF ( _a2N >= 2, FIND ( "§", SUBSTITUTE ( _e2Abriu, "|", "§", _a2N - 1 ) ) )
			VAR _a2Txt = SWITCH ( TRUE (), _a2N = 0, "", _a2N = 1, _e2Abriu, SUBSTITUTE ( LEFT ( _e2Abriu, _a2Pos - 1 ), "|", ", " ) & " e " & MID ( _e2Abriu, _a2Pos + 1, 999 ) )
			VAR _lrN = IF ( ISBLANK ( _entRef ) || _entRef = "", 0, PATHLENGTH ( _entRef ) )
			VAR _lrPos = IF ( _lrN >= 2, FIND ( "§", SUBSTITUTE ( _entRef, "|", "§", _lrN - 1 ) ) )
			VAR _lrTxt = SWITCH ( TRUE (), _lrN = 0, "", _lrN = 1, _entRef, SUBSTITUTE ( LEFT ( _entRef, _lrPos - 1 ), "|", ", " ) & " e " & MID ( _entRef, _lrPos + 1, 999 ) )
			VAR _lbN = IF ( ISBLANK ( _abrRef ) || _abrRef = "", 0, PATHLENGTH ( _abrRef ) )
			VAR _lbPos = IF ( _lbN >= 2, FIND ( "§", SUBSTITUTE ( _abrRef, "|", "§", _lbN - 1 ) ) )
			VAR _lbTxt = SWITCH ( TRUE (), _lbN = 0, "", _lbN = 1, _abrRef, SUBSTITUTE ( LEFT ( _abrRef, _lbPos - 1 ), "|", ", " ) & " e " & MID ( _abrRef, _lbPos + 1, 999 ) )
			VAR _txtEntRef = IF ( _lrN = 0, "", _lrTxt & IF ( _lrN = 1, " entrou em crítico", " entraram em crítico" ) ) & IF ( _lbN = 0, "", IF ( _lrN > 0, " e ", "" ) & _lbTxt & IF ( _lbN = 1, " abriu em crítico", " abriram em crítico" ) )
			VAR _abrevIni = FORMAT ( _ini, "mmm", "pt-BR" )
			VAR _txtSob = "LEITURA · COMO OS MESES EVOLUÍRAM · " & IF ( _nMeses <= 1, _mesC, UPPER ( _abrevIni ) & " A " & _mesC )
			VAR _tarA = ABS ( _ativRef )
			VAR _tarNu = SWITCH ( TRUE (), _tarA >= 99950000, FORMAT ( _tarA / 1000000, "0.0", "pt-BR" ), _tarA >= 999500, FORMAT ( _tarA / 1000000, "0.00", "pt-BR" ), _tarA >= 999.5, FORMAT ( _tarA / 1000, "0", "pt-BR" ), FORMAT ( _tarA, "#,0", "pt-BR" ) )
			VAR _tarUn = SWITCH ( TRUE (), _tarA >= 999500, " mi", _tarA >= 999.5, " mil", "" )
			VAR _tarN = _tarNu & _tarUn
			VAR _tarZero = _tarN = "0"
			VAR _tarS = IF ( _tarZero, "", IF ( _ativRef < 0, "−", "" ) )
			VAR _tarTxt = IF ( ISBLANK ( _ativRef ), "—", _tarS & "R$ " & _tarN )
			VAR _taiA = ABS ( _ativIni )
			VAR _taiNu = SWITCH ( TRUE (), _taiA >= 99950000, FORMAT ( _taiA / 1000000, "0.0", "pt-BR" ), _taiA >= 999500, FORMAT ( _taiA / 1000000, "0.00", "pt-BR" ), _taiA >= 999.5, FORMAT ( _taiA / 1000, "0", "pt-BR" ), FORMAT ( _taiA, "#,0", "pt-BR" ) )
			VAR _taiUn = SWITCH ( TRUE (), _taiA >= 999500, " mi", _taiA >= 999.5, " mil", "" )
			VAR _taiN = _taiNu & _taiUn
			VAR _taiZero = _taiN = "0"
			VAR _taiS = IF ( _taiZero, "", IF ( _ativIni < 0, "−", "" ) )
			VAR _taiTxt = IF ( ISBLANK ( _ativIni ), "—", _taiS & "R$ " & _taiN )
			VAR _tfrN = FORMAT ( ABS ( _fisRef ), "0.0", "pt-BR" )
			VAR _tfrS = SWITCH ( TRUE (), ROUND ( _fisRef, 1 ) < 0, "−", ROUND ( _fisRef, 1 ) > 0, "+", "" )
			VAR _tfrTxt = IF ( ISBLANK ( _fisRef ), "—", _tfrS & _tfrN & " p.p." )
			VAR _tfiN = FORMAT ( ABS ( _fisIni ), "0.0", "pt-BR" )
			VAR _tfiS = SWITCH ( TRUE (), ROUND ( _fisIni, 1 ) < 0, "−", ROUND ( _fisIni, 1 ) > 0, "+", "" )
			VAR _tfiTxt = IF ( ISBLANK ( _fisIni ), "—", _tfiS & _tfiN & " p.p." )
			VAR _tarKP = LEN ( _tarNu ) > 0
			VAR _tarKN = IF ( _tarKP, _tarNu )
			VAR _tarKS = SUBSTITUTE ( SUBSTITUTE ( _tarKN, ".", "" ), ",", "" )
			VAR _tarKT = IFERROR ( VALUE ( _tarKS ), -1 )
			VAR _tarKOk = _tarKP && _tarKT >= 2 && FORMAT ( _tarKT, REPT ( "0", LEN ( _tarKS ) ) ) = _tarKS
			VAR _tarKD = IF ( CONTAINSSTRING ( _tarKN, "," ), LEN ( _tarKN ) - SEARCH ( ",", _tarKN ), 0 )
			VAR _tarKM = IF ( CONTAINSSTRING ( _tarKN, "." ), "#,##0", "0" ) & IF ( _tarKD > 0, "." & REPT ( "0", _tarKD ) )
			VAR _tarKOd =
			    IF (
			        _tarKOk,
			        "<o-d><o-v>" & _tarKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tarKN, FORMAT ( ROUND ( _tarKT * [@odf] / 1000, 0 ) / POWER ( 10, _tarKD ), _tarKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tarNu
			    )
			VAR _tarOd = IF ( ISBLANK ( _ativRef ), _tarTxt, _tarS & "R$ " & _tarKOd & _tarUn )
			VAR _tfrKP = LEN ( _tfrN ) > 0
			VAR _tfrKN = IF ( _tfrKP, _tfrN )
			VAR _tfrKS = SUBSTITUTE ( SUBSTITUTE ( _tfrKN, ".", "" ), ",", "" )
			VAR _tfrKT = IFERROR ( VALUE ( _tfrKS ), -1 )
			VAR _tfrKOk = _tfrKP && _tfrKT >= 2 && FORMAT ( _tfrKT, REPT ( "0", LEN ( _tfrKS ) ) ) = _tfrKS
			VAR _tfrKD = IF ( CONTAINSSTRING ( _tfrKN, "," ), LEN ( _tfrKN ) - SEARCH ( ",", _tfrKN ), 0 )
			VAR _tfrKM = IF ( CONTAINSSTRING ( _tfrKN, "." ), "#,##0", "0" ) & IF ( _tfrKD > 0, "." & REPT ( "0", _tfrKD ) )
			VAR _tfrKOd =
			    IF (
			        _tfrKOk,
			        "<o-d><o-v>" & _tfrKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tfrKN, FORMAT ( ROUND ( _tfrKT * [@odf] / 1000, 0 ) / POWER ( 10, _tfrKD ), _tfrKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tfrN
			    )
			VAR _tfrOd = IF ( ISBLANK ( _fisRef ), _tfrTxt, _tfrS & _tfrKOd & " p.p." )
			VAR _tpcN = FORMAT ( _pico, "#,0", "pt-BR" )
			VAR _tpcTxt = IF ( ISBLANK ( _pico ), "0", _tpcN )
			VAR _tpcKP = LEN ( _tpcN ) > 0
			VAR _tpcKN = IF ( _tpcKP, _tpcN )
			VAR _tpcKS = SUBSTITUTE ( SUBSTITUTE ( _tpcKN, ".", "" ), ",", "" )
			VAR _tpcKT = IFERROR ( VALUE ( _tpcKS ), -1 )
			VAR _tpcKOk = _tpcKP && _tpcKT >= 2 && FORMAT ( _tpcKT, REPT ( "0", LEN ( _tpcKS ) ) ) = _tpcKS
			VAR _tpcKD = IF ( CONTAINSSTRING ( _tpcKN, "," ), LEN ( _tpcKN ) - SEARCH ( ",", _tpcKN ), 0 )
			VAR _tpcKM = IF ( CONTAINSSTRING ( _tpcKN, "." ), "#,##0", "0" ) & IF ( _tpcKD > 0, "." & REPT ( "0", _tpcKD ) )
			VAR _tpcKOd =
			    IF (
			        _tpcKOk,
			        "<o-d><o-v>" & _tpcKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpcKN, FORMAT ( ROUND ( _tpcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpcKD ), _tpcKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpcN
			    )
			VAR _tpcOd = IF ( ISBLANK ( _pico ), _tpcTxt, _tpcKOd )
			VAR _txtCrit = IF ( _critIni = _critRef, SWITCH ( _critRef, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _critRef, "0" ) ) & " no início e no fim", "de " & SWITCH ( _critIni, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _critIni, "0" ) ) & " para " & SWITCH ( _critRef, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _critRef, "0" ) ) )
			VAR _txtPend = IF ( _pendIni = _pendRef, SWITCH ( _pendRef, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _pendRef, "0" ) ) & " no início e no fim", "de " & SWITCH ( _pendIni, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _pendIni, "0" ) ) & " para " & SWITCH ( _pendRef, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _pendRef, "0" ) ) )
			VAR _txtAchado =
			    SWITCH (
			        TRUE (),
			        _nMeses <= 1, "Primeiro mês do histórico: " & SWITCH ( _critRef, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _critRef, "0" ) ) & IF ( _critRef <= 1, " crítica", " críticas" ) & " e " & SWITCH ( _pendRef, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _pendRef, "0" ) ) & IF ( _pendRef = 1, " pendente.", " pendentes." ),
			        "Críticas: " & _txtCrit & "; pendentes, " & _txtPend & "."
			    )
			VAR _p1 = IF ( _l1N > 0, _l1Txt & IF ( _i1Fr <> "", ", perdendo mais " & _i1Fr, "" ), "" )
			VAR _q1 = IF ( _a1N = 0, "", _a1Txt & IF ( _a1N = 1, " já abriu crítica", " já abriram críticas" ) )
			VAR _par1 = "(" & _p1 & IF ( _p1 <> "" && _q1 <> "", "; ", "" ) & _q1 & ")"
			VAR _p2 = IF ( _l2N > 0, _l2Txt & IF ( _i2Fr <> "", ", perdendo mais " & _i2Fr, "" ), "" )
			VAR _q2 = IF ( _a2N = 0, "", _a2Txt & IF ( _a2N = 1, " já abriu crítica", " já abriram críticas" ) )
			VAR _par2 = "(" & _p2 & IF ( _p2 <> "" && _q2 <> "", "; ", "" ) & _q2 & ")"
			VAR _txtPiora =
			    IF (
			        ISBLANK ( _e1 ),
			        "Nenhuma obra entrou em crítico no período.",
			        "A piora começou em " & FORMAT ( _e1, "mmmm", "pt-BR" ) & " " & _par1
			            & IF ( ISBLANK ( _e2 ), "", " e se firmou em " & FORMAT ( _e2, "mmmm", "pt-BR" ) & " " & _par2 ) & "."
			    )
			VAR _txtPico =
			    IF (
			        _pico = 0 || ISBLANK ( _picoMes ) || _picoMes = _e1,
			        "",
			        " " & UPPER ( LEFT ( FORMAT ( _picoMes, "mmmm", "pt-BR" ), 1 ) ) & MID ( FORMAT ( _picoMes, "mmmm", "pt-BR" ), 2, LEN ( FORMAT ( _picoMes, "mmmm", "pt-BR" ) ) ) & IF ( _picoMes = _ref, " é", " foi" ) & " o pico"
			    )
			VAR _txtSaida =
			    SWITCH (
			        TRUE (),
			        _lsN = 0 && _txtEntRef = "", IF ( _txtPico = "", "", "." ),
			        _lsN = 0, IF ( _txtPico = "", " Em ", "; em " ) & _mesN & " " & _txtEntRef & ".",
			        IF ( _txtPico = "", " Em ", "; em " ) & _mesN & " " & _lsTxt & IF ( _lsN = 1, " voltou", " voltaram" ) & IF ( _saiSt = 1, " para atenção", " para a faixa estável" ) & IF ( _txtEntRef = "", ".", ", e " & _txtEntRef & "." )
			    )
			VAR _txtJanela = IF ( _nMeses <= 1, "no mês", "nos últimos " & "⁅" & _nMeses & "⁆" & " meses" )
			VAR _txtObrasCrit = IF ( _pico = 1, "obra crítica", "obras críticas" )
			VAR _txtD1 =
			    SWITCH (
			        TRUE (),
			        _pico = 0, "obras críticas " & _txtJanela,
			        _nMeses <= 1, _txtObrasCrit & " em " & FORMAT ( _picoMes, "mmmm", "pt-BR" ),
			        _txtObrasCrit & " em " & FORMAT ( _picoMes, "mmmm", "pt-BR" ) & ", o pico dos " & "⁅" & _nMeses & "⁆" & " meses"
			    )
			VAR _txtAbIni = _abrevIni & "."
			VAR _txtAtivIni =
			    SWITCH (
			        TRUE (),
			        _nMeses <= 1, "",
			        _taiTxt = _tarTxt, " (o mesmo de " & _txtAbIni & ")",
			        " (" & _txtAbIni & ": " & "⁅" & _taiTxt & "⁆" & ")"
			    )
			VAR _txtFisIni =
			    SWITCH (
			        TRUE (),
			        _nMeses <= 1, "",
			        _tfiTxt = _tfrTxt, " (o mesmo de " & _txtAbIni & ")",
			        " (" & _txtAbIni & ": " & IF ( ROUND ( _fisIni, 1 ) < 0, "<span class='ng'>" & "⁅" & _tfiTxt & "⁆" & "</span>", "⁅" & _tfiTxt & "⁆" ) & ")"
			    )
			-- 4 · Marcação
			VAR _htmlDst =
			    "<div class='dst dst-l'>"
			        & "<div class='dl'><b>" & _tpcOd & "</b><span>" & _txtD1 & "</span></div>"
			        & "<div class='dl'><b>" & _tarOd & "</b><span>" & "pagos e não aplicados" & _txtAtivIni & "</span></div>"
			        & "<div class='dl'><b>" & IF ( ROUND ( _fisRef, 1 ) < 0, "<span class='ng'>" & _tfrOd & "</span>", _tfrOd ) & "</b><span>" & "físico ponderado" & _txtFisIni & "</span></div>"
			    & "</div>"
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span>"
			        & "<h2 class='ach'>" & _txtAchado & "</h2>"
			        & "<p class='exp'>" & _txtPiora & _txtPico & _txtSaida & "</p>"
			        & _htmlDst
			VAR _saidaHtml =
			    IF ( _nObras > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura de Como os meses evoluíram" & "'><div class='pn pn-peq pn-meses'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Leituras
		lineageTag: 5ba521bd-5cb2-5b89-a2c0-e41aa9cecfb9

	/// CSS das leituras do "?" da Tela 01 (sobre o painel: superfície, completa em duas colunas, condensadas) e do guia da página.
