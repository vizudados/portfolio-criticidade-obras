	/// CSS do cabeçalho e das linhas da tabela Obras no mês (F3).
	measure 'T4 · Obras · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".htmlViewerEntry{display:block!important;margin:0!important;padding:0!important}.obc{position:fixed;inset:0;background:#FFFFFF;white-space:nowrap}.obc .sub{position:absolute;left:0"
			    & ";top:0;font-size:15px;line-height:20px;color:#3B3B3F}.obc .vs{position:absolute;top:36px;font-size:12px;line-height:16px;letter-spacing:1px;text-transform:uppercase;color:#6B6B70}."
			    & "ob{position:relative;height:91px;border-bottom:1px solid #E1E1E1;background:#FFFFFF;transition:background .15s}.ob:hover,.htmlViewerEntry.hover .ob{background:#F7F4EE}.ob .nm{posit"
			    & "ion:absolute;left:14px;top:10px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:18px;line-height:22px;white-space:nowrap}.ob .ic,.ob .vr,.ob .cx{position:abs"
			    & "olute;top:11px;display:flex;align-items:center;white-space:nowrap;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;line-height:20px}.ob .ic{left:150px}.o"
			    & "b .vr{left:230px;font-size:15px}.ob .cx{right:14px}.ob .ic .mk,.ob .cx .mk{margin-right:6px}.ob .ng{color:#C43737}.ob .js{position:absolute;left:14px;right:14px;top:40px;font-size:"
			    & "13px;line-height:18px;color:#3B3B3F;white-space:normal;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.ob .js.nx{color:#6B6B70}.ob .js.pd{colo"
			    & "r:#C43737}.ob .js .pend{display:inline-block;width:11px;height:11px;margin:0 6px -1px 0;border:1.25px dashed #C43737;box-sizing:border-box}"
		displayFolder: T4 Resultado no tempo\Obras no mês
		lineageTag: 64c1c11d-06fc-5e53-9242-2d78f0373383

	/// Cabeçalho da tabela Obras no mês (F3): o mês e a ordem (subtítulo) e os nomes das colunas (OBRA, IDC, NO MÊS, CAIXA). Fundo branco por cima do subtítulo antigo da casca.
	measure 'T4 · Obras · HTML cabeçalho' =
			-- 1 · Leituras
			VAR _mesC = [Mês de referência · curto]
			-- 4 · Marcação
			RETURN
			    "<div class='u obc'><span class='sub'>" & _mesC & " · IDC, variação no mês, caixa e justificativa"
			        & "</span><span class='vs' style='left:14px'>obra</span><span class='vs' style='left:150px'>IDC</span>"
			        & "<span class='vs' style='left:230px'>no mês</span><span class='vs' style='right:14px'>caixa</span></div>"
		displayFolder: T4 Resultado no tempo\Obras no mês
		lineageTag: 2d66b6d8-c347-51b2-9f3f-8ee9a7bb8e63

	/// Uma linha por obra com aba no mês de referência (granularidade dObra[Obra], ordem T1 · Obras · posição): nome, IDC com a marca dos pontos do item custo (cheio, parte, nenhum), a variação do IDC no mês (vermelha quando cai), o desvio de caixa do mês com a marca da faixa da previsão de caixa (preto também quando negativo) e, embaixo, a justificativa da planilha em até duas linhas; sem ela, 'em branco · exigida acima de ±10%' (vermelho, com a marca de pendência), 'dentro de ±10%: não exigida' ou 'sem previsto no mês'. O limite vem de [Nota · limite caixa · ponto inteiro].
	measure 'T4 · Obras · HTML linha' =
			-- 1 · Leituras
			VAR _obra = [Obra · nome]
			VAR _idc = [IDC · ref]
			VAR _var = [T4 · IDC · variação no mês · ref]
			VAR _ptc = [Nota · pontos custo · ref]
			VAR _psc = [Nota · possíveis · custo · ref]
			VAR _dv = [Desembolso · desvio no mês · ref]
			VAR _fx = [T4 · Desembolso · faixa do fluxo de caixa · ref]
			VAR _prev = [Desembolso · previsto no mês · ref]
			VAR _jus = [Justificativa do desembolso · ref]
			VAR _ex = [Justificativa · exigida · ref]
			VAR _lim = [Nota · limite caixa · ponto inteiro]
			VAR _pos = [T1 · Obras · posição]
			-- 2 · Textos
			VAR _chave = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
			VAR _tiTxt = FORMAT ( _idc, "0.00", "pt-BR" )
			VAR _tvTxt = IF ( ISBLANK ( _var ), "", SWITCH ( TRUE (), _var > 0, "+", _var < 0, "−", "" ) & FORMAT ( ABS ( _var ), "0.00", "pt-BR" ) )
			VAR _tdN = FORMAT ( ABS ( _dv ) * 100, "0", "pt-BR" )
			VAR _tdS = SWITCH ( TRUE (), ROUND ( _dv * 100, 0 ) < 0, "−", ROUND ( _dv * 100, 0 ) > 0, "+", "" )
			VAR _tdTxt = IF ( ISBLANK ( _dv ), "—", _tdS & _tdN & "%" )
			VAR _clsC = IF ( ISBLANK ( _ptc ), "", IF ( _ptc >= _psc, "0", IF ( _ptc = 0, "2", "1" ) ) )
			VAR _txtLim = "±" & FORMAT ( _lim, "0%", "pt-BR" )
			VAR _d0 = ( MAX ( 1, _pos ) - 1 ) * 80 -- geometria
			VAR _temJus = NOT ISBLANK ( _jus ) && TRIM ( _jus ) <> ""
			VAR _htmlJus =
			    SWITCH (
			        TRUE (),
			        _temJus, "<p class='js'>“" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( TRIM ( _jus ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "”</p>",
			        ISBLANK ( _prev ), "<p class='js nx'>sem previsto no mês</p>",
			        _ex = 1, "<p class='js pd'><i class='pend a-pop' style='animation-delay:" & ( _d0 + 300 ) & "ms'></i>" & "em branco · exigida acima de " & _txtLim & "</p>",
			        "<p class='js nx'>dentro de " & _txtLim & ": não exigida</p>"
			    )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _idc ),
			        "<div class='u ob'><b class='nm'>" & _chave & "</b>"
			            & "<span class='ic'>" & IF ( _clsC = "", "", "<i class='mk a-pop mk" & _clsC & "' style='animation-delay:" & _d0 & "ms'></i>" ) & "⁅" & _tiTxt & "⁆" & "</span>"
			            & "<span class='vr" & IF ( _var < 0, " ng", "" ) & "'>" & IF ( _tvTxt = "", "", "⁅" & _tvTxt & "⁆" ) & "</span>"
			            & "<span class='cx'>" & IF ( ISBLANK ( _fx ), "", "<i class='mk a-pop mk" & _fx & "' style='animation-delay:" & ( _d0 + 150 ) & "ms'></i>" )
			            & IF ( ISBLANK ( _dv ), "—", "⁅" & _tdTxt & "⁆" ) & "</span>"
			            & _htmlJus
			        & "</div>" & [Comum · JS contador]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Obras no mês
		lineageTag: 06b616e3-377a-5145-b1d8-024e46f63e6c

	/// CSS das colunas do painel Resultado da carteira, mês a mês (uma entrada por mês).
	measure 'T4 · Mês a mês · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & "#htmlContent{display:flex!important;align-items:flex-start;width:100vw;height:100vh;margin:0!important;padding:0!important}.htmlViewerEntry{display:block!important;flex:1 1 0;min-w"
			    & "idth:0;margin:0!important;padding:0!important}.mc{position:relative;height:312px;transition:background .15s}.mc:hover,.htmlViewerEntry.hover .mc{background:rgba(233,224,207,.3)}.mc"
			    & " .rz{position:absolute;left:0;right:0;height:1px;background:#6B6B70}.mc .br{position:absolute;background:#0B0B0C}.mc .br.ng{background:#C43737}.mc .tq{position:absolute;z-index:1;h"
			    & "eight:3px;background:#0B0B0C;box-shadow:0 0 0 1px #FFFFFF}.mc .vl{position:absolute;z-index:2;text-align:center;font-size:14px;line-height:17px;white-space:nowrap;color:#0B0B0C;tex"
			    & "t-shadow:0 0 2px #FFFFFF,0 0 4px #FFFFFF,0 0 6px #FFFFFF}.mc .ms{position:absolute;left:0;right:0;top:296px;text-align:center;font-size:13px;line-height:16px;color:#3B3B3F;white-sp"
			    & "ace:nowrap}.mc .ms.ref{font-weight:600;color:#0B0B0C}.mc .ms.sem{opacity:.35}"
		displayFolder: T4 Resultado no tempo\Resultado mês a mês
		lineageTag: 71074db1-426b-5e4f-bdfe-3940b581d5ce

	/// CSS do subtítulo e da legenda do Resultado da carteira, mês a mês (F3).
	measure 'T4 · Mês a mês · CSS cabeçalho' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".mlg{position:fixed;inset:0;background:#FFFFFF;display:flex;justify-content:flex-end;align-items:center;font-size:14px;line-height:19px;color:#3B3B3F;white-space:nowrap}.mlg i{disp"
			    & "lay:block;flex:none;margin-right:6px}.mlg span{margin-right:18px}.mlg span:last-child{margin-right:0}.mlg .sp{width:12px;height:12px;background:#0B0B0C}.mlg .sn{width:12px;height:1"
			    & "2px;background:#C43737}.mlg .tq{width:18px;height:3px;background:#0B0B0C}.msb{position:fixed;inset:0;background:#FFFFFF;font-size:15px;line-height:22px;color:#3B3B3F;white-space:no"
			    & "wrap}"
		displayFolder: T4 Resultado no tempo\Resultado mês a mês
		lineageTag: 73d40649-d116-50ff-b65e-4fe8a87262e4

	/// Uma coluna por mês da janela (granularidade dMes[Mes]; coluna = 1068 ÷ n): barra = resultado aplicado da carteira (preta ≥ 0, vermelha < 0) a partir do zero, barra = mín(46; 0,36 × coluna), e o traço do resultado da planilha por cima (a distância é o que falta realizar). Até 8 meses, valor do aplicado em todo mês ('−R$ 340 mil', vermelho quando negativo); de 9 a 12, só no mês de referência e nos meses do maior e do menor aplicado, compacto ('−3,65 mi'). O valor fica do lado de fora da barra (em cima no positivo, embaixo no negativo), preso na coluna. Mês de referência em semibold; mês sem aba só com o rótulo apagado; eixo 'jan/26' até 8 meses e 'jan' (ano só no primeiro mês e em janeiro) acima disso. A barra corre do zero em cascata e o valor conta.
	measure 'T4 · Mês a mês · HTML coluna' =
			-- 1 · Leituras
			VAR _noRecorte = [Série · mês até a referência]
			VAR _ap = [Resultado aplicado]
			VAR _pla = [Resultado da obra]
			VAR _topo = [T4 · Mês a mês · topo da escala]
			VAR _base = [T4 · Mês a mês · base da escala]
			VAR _mes = [Mês · rótulo curto]
			VAR _mesAbrev = [Mês · abreviado]
			VAR _data = [Mês · data]
			VAR _ehRef = [Série · é o mês de referência]
			VAR _pos = [Série · posição na janela]
			VAR _n = [Série · meses até a referência]
			VAR _mx = [T4 · Mês a mês · mês do maior aplicado]
			VAR _mn = [T4 · Mês a mês · mês do menor aplicado]
			-- 2 · Textos
			VAR _trA = ABS ( _ap )
			VAR _trNu = SWITCH ( TRUE (), _trA >= 99950000, FORMAT ( _trA / 1000000, "0.0", "pt-BR" ), _trA >= 999500, FORMAT ( _trA / 1000000, "0.00", "pt-BR" ), _trA >= 999.5, FORMAT ( _trA / 1000, "0", "pt-BR" ), FORMAT ( _trA, "#,0", "pt-BR" ) )
			VAR _trUn = SWITCH ( TRUE (), _trA >= 999500, " mi", _trA >= 999.5, " mil", "" )
			VAR _trN = _trNu & _trUn
			VAR _trZero = _trN = "0"
			VAR _trS = IF ( _trZero, "", IF ( _ap < 0, "−", "" ) )
			VAR _trTxt = IF ( ISBLANK ( _ap ), "—", _trS & "R$ " & _trN )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _trKP = LEN ( _trNu ) > 0
			VAR _trKN = IF ( _trKP, _trNu )
			VAR _trKS = SUBSTITUTE ( SUBSTITUTE ( _trKN, ".", "" ), ",", "" )
			VAR _trKT = IFERROR ( VALUE ( _trKS ), -1 )
			VAR _trKOk = _trKP && _trKT >= 2 && FORMAT ( _trKT, REPT ( "0", LEN ( _trKS ) ) ) = _trKS
			VAR _trKD = IF ( CONTAINSSTRING ( _trKN, "," ), LEN ( _trKN ) - SEARCH ( ",", _trKN ), 0 )
			VAR _trKM = IF ( CONTAINSSTRING ( _trKN, "." ), "#,##0", "0" ) & IF ( _trKD > 0, "." & REPT ( "0", _trKD ) )
			VAR _trKOd =
			    IF (
			        _trKOk,
			        "<o-d><o-v>" & _trKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _trKN, FORMAT ( ROUND ( _trKT * [@odf] / 1000, 0 ) / POWER ( 10, _trKD ), _trKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _trNu
			    )
			VAR _trOd = IF ( ISBLANK ( _ap ), _trTxt, _trS & "R$ " & _trKOd & _trUn )
			VAR _denso = _n >= 9
			VAR _rot = NOT _denso || _ehRef = 1 || _data = _mx || _data = _mn
			VAR _txtR = IF ( _denso, _trS & _trKOd & _trUn, _trOd )
			VAR _txtMes = IF ( _denso, _mesAbrev & IF ( _pos = 1 || MONTH ( _data ) = 1, RIGHT ( _mes, 3 ), "" ), _mes )
			VAR _clsMes = IF ( _ehRef = 1, " ref", "" ) & IF ( ISBLANK ( _ap ), " sem", "" )
			VAR _ngR = IF ( _trS = "−", " ng", "" )
			VAR _clsBr = IF ( _ap < 0, " ng", "" )
			-- 3 · Geometria
			VAR _b = MIN ( 46, ROUND ( 0.36 * 1068 / _n, 0 ) ) -- geometria
			VAR _caixa = IF ( _denso, 56, 80 ) -- geometria
			VAR _meiaCaixa = IF ( _denso, 28, 40 ) -- geometria
			VAR _u = DIVIDE ( 226, _topo - _base ) -- geometria
			VAR _zero = 27 + ROUND ( _topo * _u, 0 ) -- geometria
			VAR _hR = IF ( _ap = 0, 0, MAX ( 2, ROUND ( ABS ( _ap ) * _u, 0 ) ) ) -- geometria
			VAR _yR = IF ( _ap >= 0, _zero - _hR, _zero + 1 ) -- geometria
			VAR _yT = _zero - ROUND ( _pla * _u, 0 ) - 1 -- geometria
			/* o rótulo fica do lado de fora da barra; se o traço da planilha cai ali, passa para o outro lado do traço */
			VAR _yRot0 = IF ( _ap >= 0, _yR - 21, _yR + _hR + 4 ) -- geometria
			VAR _bate = NOT ISBLANK ( _pla ) && _yT >= _yRot0 - 3 && _yT <= _yRot0 + 20 -- geometria
			VAR _yRot = IF ( _bate, IF ( _ap >= 0, _yT - 21, _yT + 6 ), _yRot0 ) -- geometria
			VAR _offR = _meiaCaixa -- geometria
			VAR _caixaCss = "px),calc(100% - " & _caixa & "px));width:" & _caixa & "px'>"
			VAR _atraso = ( _pos - 1 ) * 100 -- geometria
			VAR _corre = "' data-rp='top,height' data-r0-top='" & _zero & "px' data-r0-height='0px' data-rd='"
			-- 4 · Marcação
			VAR _htmlBarras =
			    IF (
			        NOT ISBLANK ( _ap ),
			        IF ( _rot, "<span class='vl b6 a-fd" & _ngR & "' style='animation-delay:" & ( _atraso + 250 ) & "ms;top:" & _yRot & "px;left:clamp(0px,calc(50% - "
			            & _offR & _caixaCss & _txtR & "</span>" )
			            & "<i class='br" & _clsBr & "' style='top:" & _yR & "px;height:" & _hR & "px;left:calc(50% - "
			            & INT ( _b / 2 ) & "px);width:" & _b & "px' data-rk='" & _mes & "|a" & _corre & _atraso & "'></i>"
			            & IF ( ISBLANK ( _pla ), "", "<i class='tq a-pop' style='animation-delay:" & ( _atraso + 600 ) & "ms;top:" & _yT & "px;left:calc(50% - " & ( INT ( _b / 2 ) + 6 )
			                & "px);width:" & ( _b + 12 ) & "px'></i>" )
			    )
			RETURN
			    IF (
			        _noRecorte = 1,
			        "<div class='u mc'><i class='rz a-fd' style='top:" & _zero & "px'></i>" & _htmlBarras
			            & "<p class='ms a-fd" & _clsMes & "' style='animation-delay:" & _atraso & "ms'>" & _txtMes & "</p>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
		displayFolder: T4 Resultado no tempo\Resultado mês a mês
		lineageTag: b5f8c14e-6e71-5b87-af82-3cb9dd72093a

	/// Legenda do Resultado da carteira, mês a mês, na linha do título (F3): resultado aplicado positivo e negativo (barra) e o traço do resultado da planilha. Fundo branco por cima da legenda antiga da casca.
	measure 'T4 · Mês a mês · HTML legenda' =
			-- 4 · Marcação
			"<div class='u mlg'><i class='sp'></i><span>resultado aplicado</span><i class='sn'></i><span>negativo</span><i class='tq'></i><span>resultado da planilha</span></div>"
		displayFolder: T4 Resultado no tempo\Resultado mês a mês
		lineageTag: 1690fe02-3b89-5ade-a0c4-61352331a7a3

	/// Subtítulo do Resultado da carteira, mês a mês (F3): o que a barra e o traço mostram. Fundo branco por cima do subtítulo antigo da casca.
	measure 'T4 · Mês a mês · HTML subtítulo' =
			-- 4 · Marcação
			"<p class='u msb'>barra = resultado aplicado (valor agregado − custo aplicado) · traço = resultado da planilha · a distância é o que ainda vai se realizar</p>"
		displayFolder: T4 Resultado no tempo\Resultado mês a mês
		lineageTag: 0585bac2-73c1-5730-9207-213c3b66a49f

	/// Menor valor entre o resultado aplicado e o resultado da planilha nos meses da janela (zero quando todos são positivos): a base da escala das colunas.
	measure 'T4 · Mês a mês · base da escala' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@a", [Resultado aplicado], "@r", [Resultado da obra] )
			RETURN
			    MIN ( 0, MIN ( MINX ( _meses, [@a] ), MINX ( _meses, [@r] ) ) )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T4 Resultado no tempo\Resultado mês a mês\Contas
		lineageTag: 31a76db9-e303-5163-804d-25484b359cd0

	/// Mês da janela com o maior [Resultado aplicado] do recorte (empate: o mais recente). Com 9 meses ou mais na janela, o painel só escreve o valor no mês de referência e nos meses de máximo e mínimo de cada série.
	measure 'T4 · Mês a mês · mês do maior aplicado' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = FILTER ( ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", [Resultado aplicado] ), NOT ISBLANK ( [@v] ) )
			RETURN
			    MAXX ( TOPN ( 1, _meses, [@v], DESC, dMes[Mes], DESC ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T4 Resultado no tempo\Resultado mês a mês\Contas
		lineageTag: 73fe6d11-14a5-5c57-8ae6-20c801ac660b

	/// Mês da janela com o menor [Resultado aplicado] do recorte (empate: o mais recente). Com 9 meses ou mais na janela, o painel só escreve o valor no mês de referência e nos meses de máximo e mínimo de cada série.
	measure 'T4 · Mês a mês · mês do menor aplicado' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = FILTER ( ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", [Resultado aplicado] ), NOT ISBLANK ( [@v] ) )
			RETURN
			    MAXX ( TOPN ( 1, _meses, [@v], ASC, dMes[Mes], DESC ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T4 Resultado no tempo\Resultado mês a mês\Contas
		lineageTag: cf692437-648b-5fb0-9b9e-e5494effc2b2

	/// Maior valor entre o resultado aplicado e o resultado da planilha nos meses da janela (zero quando todos são negativos): o topo da escala das colunas do painel Resultado da carteira, mês a mês.
	measure 'T4 · Mês a mês · topo da escala' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@a", [Resultado aplicado], "@r", [Resultado da obra] )
			RETURN
			    MAX ( 0, MAX ( MAXX ( _meses, [@a] ), MAXX ( _meses, [@r] ) ) )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T4 Resultado no tempo\Resultado mês a mês\Contas
		lineageTag: 6935cddc-f5fd-5d7a-aa72-fc1513d09c9c

	/// Tooltip de página do mês (par de colunas de Desembolso da carteira): previsto × desembolsado de cada obra no mês, do maior ao menor desvio (marca da faixa da previsão de caixa da nota, que conta o desvio para mais ou para menos; barra divergente do desvio na cor da faixa, com o zero no meio da sua coluna e escala simétrica pelo maior |desvio|), as justificativas preenchidas entre as exigidas no mês com as obras em branco numa linha só (do maior |desvio| para o menor, sem cortar nome: todas, as 2 primeiras e 'e mais M', ou nenhuma) e, fora do primeiro mês, quem entrou ou saiu da faixa crítica. Até 10 obras, todas aparecem; de 11 em diante, as 9 de maior desvio e 'e mais N obras'.
	measure 'T4 · Tooltip mês do desembolso · HTML' =
			-- 1 · Leituras
			VAR _mesC = UPPER ( [Mês · rótulo curto] )
			VAR _mesL = [Mês · longo]
			VAR _mesAnt = [Mês anterior · nome]
			VAR _n = [Obras com análise] + 0
			VAR _primeiro = [Mês · é o primeiro do histórico] = 1
			VAR _ex = [Carteira · justificativas exigidas] + 0
			VAR _pre = [Carteira · justificativas preenchidas] + 0
			VAR _br = [Carteira · justificativas em branco] + 0
			VAR _listaBr = [T4 · Justificativas em branco no mês (lista)]
			VAR _foraRod = [T4 · Tooltip mês do desembolso · em branco fora do rodapé]
			VAR _saiu = [T4 · Desembolso · saíram da faixa crítica (lista)]
			VAR _entrou = [T4 · Desembolso · entraram na faixa crítica (lista)]
			VAR _seguem = [T4 · Desembolso · seguem na faixa crítica] + 0
			VAR _mais = [T4 · Tooltip mês do desembolso · obras fora da lista]
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@pv", [Desembolso · previsto no mês],
			        "@ds", [Desembolso · realizado no mês],
			        "@d", [Desembolso · desvio no mês],
			        "@st", [T4 · Desembolso · faixa do fluxo de caixa],
			        "@selo", [Obra · selo],
			        "@tem", [Obras com análise]
			    )
			VAR _comAba = FILTER ( _obras, [@tem] > 0 ) /* geometria */
			/* passou de 10 obras: as 9 de maior desvio (|desvio|), na ordem de sempre, e a linha 'e mais N obras' */
			VAR _mostra = TOPN ( IF ( _mais > 0, 9, 10 ), _comAba, ABS ( [@d] ), DESC, dObra[Obra], ASC ) /* geometria */
			VAR _o1 = PATHITEM ( _saiu, 1 )
			VAR _e1 = PATHITEM ( _entrou, 1 )
			VAR _dAntS = CALCULATE ( [T4 · Desembolso · desvio · mês anterior], dObra[Obra] = _o1 )
			VAR _dAntE = CALCULATE ( [T4 · Desembolso · desvio · mês anterior], dObra[Obra] = _e1 )
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _lsN = IF ( ISBLANK ( _saiu ) || _saiu = "", 0, PATHLENGTH ( _saiu ) )
			VAR _lsPos = IF ( _lsN >= 2, FIND ( "§", SUBSTITUTE ( _saiu, "|", "§", _lsN - 1 ) ) )
			VAR _lsTxt = SWITCH ( TRUE (), _lsN = 0, "", _lsN = 1, _saiu, SUBSTITUTE ( LEFT ( _saiu, _lsPos - 1 ), "|", ", " ) & " e " & MID ( _saiu, _lsPos + 1, 999 ) )
			VAR _leN = IF ( ISBLANK ( _entrou ) || _entrou = "", 0, PATHLENGTH ( _entrou ) )
			VAR _lePos = IF ( _leN >= 2, FIND ( "§", SUBSTITUTE ( _entrou, "|", "§", _leN - 1 ) ) )
			VAR _leTxt = SWITCH ( TRUE (), _leN = 0, "", _leN = 1, _entrou, SUBSTITUTE ( LEFT ( _entrou, _lePos - 1 ), "|", ", " ) & " e " & MID ( _entrou, _lePos + 1, 999 ) )
			VAR _tdsN = FORMAT ( ABS ( _dAntS ) * 100, "0", "pt-BR" )
			VAR _tdsS = SWITCH ( TRUE (), ROUND ( _dAntS * 100, 0 ) < 0, "−", ROUND ( _dAntS * 100, 0 ) > 0, "+", "" )
			VAR _tdsTxt = IF ( ISBLANK ( _dAntS ), "—", _tdsS & _tdsN & "%" )
			VAR _tdeN = FORMAT ( ABS ( _dAntE ) * 100, "0", "pt-BR" )
			VAR _tdeS = SWITCH ( TRUE (), ROUND ( _dAntE * 100, 0 ) < 0, "−", ROUND ( _dAntE * 100, 0 ) > 0, "+", "" )
			VAR _tdeTxt = IF ( ISBLANK ( _dAntE ), "—", _tdeS & _tdeN & "%" )
			VAR _tprN = FORMAT ( _pre, "#,0", "pt-BR" )
			VAR _tprTxt = IF ( ISBLANK ( _pre ), "0", _tprN )
			VAR _tprKP = LEN ( _tprN ) > 0
			VAR _tprKN = IF ( _tprKP, _tprN )
			VAR _tprKS = SUBSTITUTE ( SUBSTITUTE ( _tprKN, ".", "" ), ",", "" )
			VAR _tprKT = IFERROR ( VALUE ( _tprKS ), -1 )
			VAR _tprKOk = _tprKP && _tprKT >= 2 && FORMAT ( _tprKT, REPT ( "0", LEN ( _tprKS ) ) ) = _tprKS
			VAR _tprKD = IF ( CONTAINSSTRING ( _tprKN, "," ), LEN ( _tprKN ) - SEARCH ( ",", _tprKN ), 0 )
			VAR _tprKM = IF ( CONTAINSSTRING ( _tprKN, "." ), "#,##0", "0" ) & IF ( _tprKD > 0, "." & REPT ( "0", _tprKD ) )
			VAR _tprKOd =
			    IF (
			        _tprKOk,
			        "<o-d><o-v>" & _tprKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tprKN, FORMAT ( ROUND ( _tprKT * [@odf] / 1000, 0 ) / POWER ( 10, _tprKD ), _tprKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tprN
			    )
			VAR _tprOd = IF ( ISBLANK ( _pre ), _tprTxt, _tprKOd )
			VAR _texN = FORMAT ( _ex, "#,0", "pt-BR" )
			VAR _texTxt = IF ( ISBLANK ( _ex ), "0", _texN )
			VAR _texKP = LEN ( _texN ) > 0
			VAR _texKN = IF ( _texKP, _texN )
			VAR _texKS = SUBSTITUTE ( SUBSTITUTE ( _texKN, ".", "" ), ",", "" )
			VAR _texKT = IFERROR ( VALUE ( _texKS ), -1 )
			VAR _texKOk = _texKP && _texKT >= 2 && FORMAT ( _texKT, REPT ( "0", LEN ( _texKS ) ) ) = _texKS
			VAR _texKD = IF ( CONTAINSSTRING ( _texKN, "," ), LEN ( _texKN ) - SEARCH ( ",", _texKN ), 0 )
			VAR _texKM = IF ( CONTAINSSTRING ( _texKN, "." ), "#,##0", "0" ) & IF ( _texKD > 0, "." & REPT ( "0", _texKD ) )
			VAR _texKOd =
			    IF (
			        _texKOk,
			        "<o-d><o-v>" & _texKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _texKN, FORMAT ( ROUND ( _texKT * [@odf] / 1000, 0 ) / POWER ( 10, _texKD ), _texKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _texN
			    )
			VAR _texOd = IF ( ISBLANK ( _ex ), _texTxt, _texKOd )
			/* linha de dados do pé (520 px): JUSTIFICATIVAS (105) · 'P de E' (~10 px por algarismo + 19) · 'preenchidas · ' (90) e o trecho dos nomes, com 2 px de folga */
			VAR _pxJus = ( 307 - ( 11 * LEN ( _tprTxt & _ex ) + 24 ) ) * 13 / 14 -- geometria
			/* nomes em branco numa linha só, sem cortar nome: todos; senão os 2 primeiros e 'e mais M'; senão nenhum (justificativas_rodape.py) */
			VAR _nbN = IF ( ISBLANK ( _listaBr ) || _listaBr = "", 0, PATHLENGTH ( _listaBr ) )
			VAR _nbPos = IF ( _nbN >= 2, FIND ( "§", SUBSTITUTE ( _listaBr, "|", "§", _nbN - 1 ) ) )
			VAR _nbTodos =
			    IF (
			        _nbN <= 1,
			        _listaBr,
			        SUBSTITUTE ( LEFT ( _listaBr, _nbPos - 1 ), "|", ", " ) & " e " & MID ( _listaBr, _nbPos + 1, 999 )
			    )
			VAR _nbCorte = FIND ( "§", SUBSTITUTE ( _listaBr & "|", "|", "§", 2 ), 1, LEN ( _listaBr ) + 1 )
			VAR _nbPrimeiros = LEFT ( _listaBr, _nbCorte - 1 )
			VAR _nbResto = IF ( _foraRod = _pre, IF ( _foraRod = 1, " e outra", " e outras" ), " e mais " & _foraRod )
			VAR _nbSemTodos = SUBSTITUTE ( _listaBr, "|", "" )
			VAR _nbSemPrimeiros = SUBSTITUTE ( _nbPrimeiros, "|", "" )
			VAR _nbPxNomesTodosCar = GENERATESERIES ( 1, LEN ( _nbSemTodos ) + 0 )
			VAR _nbPxNomesTodos =
			    SUMX ( _nbPxNomesTodosCar, /* lista */ -- geometria
			        SWITCH (
			            MID ( _nbSemTodos, [Value], 1 ),
			            " ", 3.6, "A", 8.4, "B", 7.5, "C", 7.8, "D", 9.2, "E", 6.6, "F", 6.4, "G", 9.0, "H", 9.3, "I", 3.5,
			            "J", 4.2, "K", 7.6, "L", 6.2, "M", 11.7, "N", 9.8, "O", 9.8, "P", 7.3, "Q", 9.8, "R", 7.8, "S", 7.0,
			            "T", 7.1, "U", 9.0, "V", 8.1, "W", 12.2, "X", 7.7, "Y", 7.2, "Z", 7.5, "Á", 8.4, "Ã", 8.4, "Â", 8.4,
			            "À", 8.4, "É", 6.6, "Ê", 6.6, "Í", 3.5, "Ó", 9.8, "Õ", 9.8, "Ô", 9.8, "Ú", 9.0, "Ç", 7.8,
			            8
			        )
			    )
			VAR _nbPxNomesPrimeirosCar = GENERATESERIES ( 1, LEN ( _nbSemPrimeiros ) + 0 )
			VAR _nbPxNomesPrimeiros =
			    SUMX ( _nbPxNomesPrimeirosCar, /* lista */ -- geometria
			        SWITCH (
			            MID ( _nbSemPrimeiros, [Value], 1 ),
			            " ", 3.6, "A", 8.4, "B", 7.5, "C", 7.8, "D", 9.2, "E", 6.6, "F", 6.4, "G", 9.0, "H", 9.3, "I", 3.5,
			            "J", 4.2, "K", 7.6, "L", 6.2, "M", 11.7, "N", 9.8, "O", 9.8, "P", 7.3, "Q", 9.8, "R", 7.8, "S", 7.0,
			            "T", 7.1, "U", 9.0, "V", 8.1, "W", 12.2, "X", 7.7, "Y", 7.2, "Z", 7.5, "Á", 8.4, "Ã", 8.4, "Â", 8.4,
			            "À", 8.4, "É", 6.6, "Ê", 6.6, "Í", 3.5, "Ó", 9.8, "Õ", 9.8, "Ô", 9.8, "Ú", 9.0, "Ç", 7.8,
			            8
			        )
			    )
			VAR _nbPxTodos = ROUND ( _nbPxNomesTodos + 7 * MAX ( _nbN - 2, 0 ) + IF ( _nbN >= 2, 14, 0 ), 0 ) -- geometria
			VAR _nbPxResto =
			    SWITCH (
			        TRUE (),
			        _foraRod <> _pre, 51 + 7 * ( LEN ( _foraRod & "" ) - 1 ), -- geometria
			        _foraRod = 1, 41,
			        50
			    )
			VAR _nbPxPrimeiros = ROUND ( _nbPxNomesPrimeiros + 7 * 1 + _nbPxResto, 0 ) -- geometria
			VAR _nbPxCabe = ROUND ( _pxJus, 0 ) - 68 -- geometria
			VAR _nbTxt =
			    SWITCH (
			        TRUE (),
			        _br = 0, "nenhuma em branco",
			        _nbPxTodos <= _nbPxCabe, "em branco: " & _nbTodos,
			        _nbN > 2 && _nbPxPrimeiros <= _nbPxCabe,
			            "em branco: " & SUBSTITUTE ( _nbPrimeiros, "|", ", " ) & _nbResto,
			        _pre = 0, "todas em branco",
			        _br = _pre, "as outras em branco",
			        _br & " em branco"
			    )
			VAR _txtSob = "DESEMBOLSO DA CARTEIRA · " & _mesC & IF ( _primeiro, " · PRIMEIRO MÊS DO HISTÓRICO", "" )
			VAR _htmlJus =
			    SWITCH (
			        TRUE (),
			        _ex = 0, "<b>0</b><span class='dt'>· nenhuma exigida: todo desembolso dentro de ±10%</span>",
			        _br = 0,
			            "<b>" & _texOd & "</b><span class='dt'>"
			                & IF ( _ex = 1, "exigida, preenchida", "exigidas, todas preenchidas" ) & "</span>",
			        "<b>" & _tprOd & " de " & "⁅" & _ex & "⁆" & "</b><span class='dt'>"
			            & IF ( _ex = 1, "preenchida · ", "preenchidas · " ) & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nbTxt, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</span>"
			    )
			VAR _txtSeguem = SWITCH ( _seguem, 0, "nenhuma segue nela", 1, "uma segue nela", SWITCH ( _seguem, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _seguem, "0" ) ) & " seguem nela" )
			VAR _txtRod =
			    SWITCH (
			        TRUE (),
			        _primeiro, "",
			        _lsN + _leN = 0, "Nenhuma obra entrou ou saiu da faixa crítica desde " & _mesAnt & ".",
			        _lsN = 1 && _leN = 0, _o1 & " saiu da faixa crítica (era " & "⁅" & _tdsTxt & "⁆" & " em " & _mesAnt & "); " & _txtSeguem & ".",
			        _leN = 1 && _lsN = 0, _e1 & " entrou na faixa crítica (era " & "⁅" & _tdeTxt & "⁆" & " em " & _mesAnt & "); " & _txtSeguem & ".",
			        _leN = 0, _lsTxt & " saíram da faixa crítica desde " & _mesAnt & "; " & _txtSeguem & ".",
			        _lsN = 0, _leTxt & " entraram na faixa crítica desde " & _mesAnt & "; " & _txtSeguem & ".",
			        _lsTxt & IF ( _lsN = 1, " saiu e ", " saíram e " ) & _leTxt & IF ( _leN = 1, " entrou", " entraram" ) & " na faixa crítica desde " & _mesAnt & "."
			    )
			-- 3 · Geometria
			VAR _max = MAXX ( _comAba, ABS ( [@d] ) ) /* geometria */
			-- 4 · Marcação
			VAR _htmlLinhas =
			    CONCATENATEX (
			        _mostra,
			        VAR _d = [@d]
			        VAR _pA = ABS ( [@pv] )
			        VAR _pNu = SWITCH ( TRUE (), _pA >= 999500, FORMAT ( _pA / 1000000, "0.00", "pt-BR" ), _pA >= 999.5, FORMAT ( _pA / 1000, "0", "pt-BR" ), FORMAT ( _pA, "#,0", "pt-BR" ) )
			        VAR _pUn = SWITCH ( TRUE (), _pA >= 999500, " mi", _pA >= 999.5, " mil", "" )
			        VAR _pS = IF ( [@pv] < 0 && _pNu <> "0", "−", "" )
			        VAR _pKP = LEN ( _pNu ) > 0
			        VAR _pKN = IF ( _pKP, _pNu )
			        VAR _pKS = SUBSTITUTE ( SUBSTITUTE ( _pKN, ".", "" ), ",", "" )
			        VAR _pKT = IFERROR ( VALUE ( _pKS ), -1 )
			        VAR _pKOk = _pKP && _pKT >= 2 && FORMAT ( _pKT, REPT ( "0", LEN ( _pKS ) ) ) = _pKS
			        VAR _pKD = IF ( CONTAINSSTRING ( _pKN, "," ), LEN ( _pKN ) - SEARCH ( ",", _pKN ), 0 )
			        VAR _pKM = IF ( CONTAINSSTRING ( _pKN, "." ), "#,##0", "0" ) & IF ( _pKD > 0, "." & REPT ( "0", _pKD ) )
			        VAR _pKOd =
			            IF (
			                _pKOk,
			                "<o-d><o-v>" & _pKN & "</o-v><o-t aria-hidden='true'>"
			                    & CONCATENATEX (
			                        _odQ,
			                        IF ( [@odk] = 24, _pKN, FORMAT ( ROUND ( _pKT * [@odf] / 1000, 0 ) / POWER ( 10, _pKD ), _pKM, "pt-BR" ) ),
			                        UNICHAR ( 10 ),
			                        [@odk], ASC
			                    )
			                    & "</o-t></o-d>",
			                _pNu
			            )
			        VAR _pTxt = _pS & "R$ " & _pNu & _pUn
			        VAR _pOd = _pS & "R$ " & _pKOd & _pUn
			        VAR _rA = ABS ( [@ds] )
			        VAR _rNu = SWITCH ( TRUE (), _rA >= 999500, FORMAT ( _rA / 1000000, "0.00", "pt-BR" ), _rA >= 999.5, FORMAT ( _rA / 1000, "0", "pt-BR" ), FORMAT ( _rA, "#,0", "pt-BR" ) )
			        VAR _rUn = SWITCH ( TRUE (), _rA >= 999500, " mi", _rA >= 999.5, " mil", "" )
			        VAR _rS = IF ( [@ds] < 0 && _rNu <> "0", "−", "" )
			        VAR _rKP = LEN ( _rNu ) > 0
			        VAR _rKN = IF ( _rKP, _rNu )
			        VAR _rKS = SUBSTITUTE ( SUBSTITUTE ( _rKN, ".", "" ), ",", "" )
			        VAR _rKT = IFERROR ( VALUE ( _rKS ), -1 )
			        VAR _rKOk = _rKP && _rKT >= 2 && FORMAT ( _rKT, REPT ( "0", LEN ( _rKS ) ) ) = _rKS
			        VAR _rKD = IF ( CONTAINSSTRING ( _rKN, "," ), LEN ( _rKN ) - SEARCH ( ",", _rKN ), 0 )
			        VAR _rKM = IF ( CONTAINSSTRING ( _rKN, "." ), "#,##0", "0" ) & IF ( _rKD > 0, "." & REPT ( "0", _rKD ) )
			        VAR _rKOd =
			            IF (
			                _rKOk,
			                "<o-d><o-v>" & _rKN & "</o-v><o-t aria-hidden='true'>"
			                    & CONCATENATEX (
			                        _odQ,
			                        IF ( [@odk] = 24, _rKN, FORMAT ( ROUND ( _rKT * [@odf] / 1000, 0 ) / POWER ( 10, _rKD ), _rKM, "pt-BR" ) ),
			                        UNICHAR ( 10 ),
			                        [@odk], ASC
			                    )
			                    & "</o-t></o-d>",
			                _rNu
			            )
			        VAR _rTxt = _rS & "R$ " & _rNu & _rUn
			        VAR _rOd = _rS & "R$ " & _rKOd & _rUn
			        VAR _qR = ROUND ( _d * 100, 0 )
			        VAR _qS = SWITCH ( TRUE (), _qR > 0, "+", _qR < 0, "−", "" )
			        VAR _qNu = FORMAT ( ABS ( _d ) * 100, "0", "pt-BR" )
			        VAR _qKP = LEN ( _qNu ) > 0
			        VAR _qKN = IF ( _qKP, _qNu )
			        VAR _qKS = SUBSTITUTE ( SUBSTITUTE ( _qKN, ".", "" ), ",", "" )
			        VAR _qKT = IFERROR ( VALUE ( _qKS ), -1 )
			        VAR _qKOk = _qKP && _qKT >= 2 && FORMAT ( _qKT, REPT ( "0", LEN ( _qKS ) ) ) = _qKS
			        VAR _qKD = IF ( CONTAINSSTRING ( _qKN, "," ), LEN ( _qKN ) - SEARCH ( ",", _qKN ), 0 )
			        VAR _qKM = IF ( CONTAINSSTRING ( _qKN, "." ), "#,##0", "0" ) & IF ( _qKD > 0, "." & REPT ( "0", _qKD ) )
			        VAR _qKOd =
			            IF (
			                _qKOk,
			                "<o-d><o-v>" & _qKN & "</o-v><o-t aria-hidden='true'>"
			                    & CONCATENATEX (
			                        _odQ,
			                        IF ( [@odk] = 24, _qKN, FORMAT ( ROUND ( _qKT * [@odf] / 1000, 0 ) / POWER ( 10, _qKD ), _qKM, "pt-BR" ) ),
			                        UNICHAR ( 10 ),
			                        [@odk], ASC
			                    )
			                    & "</o-t></o-d>",
			                _qNu
			            )
			        VAR _qTxt = _qS & _qNu & "%"
			        VAR _qOd = _qS & _qKOd & "%"
			        VAR _w = IF ( ISBLANK ( _d ), 0, MAX ( 1, ROUND ( DIVIDE ( ABS ( _d ), _max ) * 40, 0 ) ) ) -- geometria
			        VAR _x = IF ( _d >= 0, 390, 390 - _w ) -- geometria
			        VAR _corre = IF ( _d < 0, " data-rp='left,width' data-r0-left='390px'" )
			        /* as duas pontas na cor da faixa do fluxo de caixa (o desvio conta para mais ou para menos), nunca pelo sinal */
			        VAR _clsBz = IF ( ISBLANK ( [@st] ), "", " s" & [@st] )
			        RETURN
			            "<div class='lc'>" & IF ( ISBLANK ( _d ), "", "<i class='mk mk" & [@st] & "'></i>" ) & "<span class='nm'>" & dObra[Obra] & IF ( [@selo] = "REAL", "<span class='selo selo-r'>REAL</span>", "" ) & "</span>"
			                & "<span class='pv'>" & IF ( ISBLANK ( [@pv] ), "sem previsto", _pOd ) & "</span><span class='px'>×</span><span class='ds'>" & _rOd & "</span>"
			                & IF ( _w > 0, "<i class='bz" & _clsBz & "' style='left:" & _x & "px;width:" & _w & "px'" & _corre & " data-rk='" & dObra[Obra] & "' data-rd='" & ( RANKX ( _mostra, [@d], _d, DESC ) - 1 ) * 60 & "'></i>" ) /* geometria */
			                & "<span class='p dv'>" & IF ( ISBLANK ( _d ), "—", _qOd ) & "</span></div>",
			        "",
			        [@d], DESC,
			        dObra[Obra], ASC
			    )
			VAR _htmlMais = IF ( _mais > 0, "<i class='vz mais'>e mais " & "⁅" & FORMAT ( _mais, "0" ) & "⁆" & " obras, com desvio mais perto de zero</i>" )
			VAR _nLs = COUNTROWS ( _mostra ) + IF ( _mais > 0, 1, 0 ) /* lista */
			VAR _saidaHtml =
			    IF (
			        _n > 0,
			        "<div class='u tt'><div class='cab'><p class='vs'>" & _txtSob & "</p>"
			            & "<div class='lin1'><div class='tit'><b>" & _mesL & "</b></div></div></div>"
			            & "<div class='corpo lim'><div class='bh'><span class='vs'>PREVISTO × DESEMBOLSADO, POR OBRA</span>"
			            & "<span class='vs'>DESVIO</span></div><div class='lsb ld" & " ls " & SWITCH ( TRUE (), _nLs <= 3, "e1", _nLs <= 6, "e2", _nLs <= 9, "e3", _nLs <= 12, "e4", "e5" ) & "' style='--n:" & _nLs & "'>" & _htmlLinhas & _htmlMais & "</div></div>"
			            & "<div class='pe'><div class='dd'><span class='vs'>JUSTIFICATIVAS</span>"
			            & _htmlJus & "</div>"
			            & IF ( _txtRod <> "", "<p class='rod'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtRod, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" )
			        & "</div></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Tooltips
		lineageTag: 733ec855-ed73-537c-96f7-3d18463328c3

	/// Tooltip de página do mês (coluna de Resultado da carteira, mês a mês): o resultado aplicado de cada obra no mês, do maior ao menor (marca do status da obra na nota, tracejada quando pendente; barra divergente de zero comum, R$ e % do orçamento), o que ainda vai se realizar (a distância até o traço da planilha) contra o mês anterior e, fora do primeiro mês, quantas obras caíram ou subiram no aplicado (F3). Até 10 obras, todas aparecem; de 11 em diante, as 9 de maior peso e 'e mais N obras'.
	measure 'T4 · Tooltip mês · HTML' =
			-- 1 · Leituras
			VAR _mesC = UPPER ( [Mês · rótulo curto] )
			VAR _mesL = [Mês · longo]
			VAR _mesAnt = [Mês anterior · nome]
			VAR _n = [Obras com análise] + 0
			VAR _primeiro = [Mês · é o primeiro do histórico] = 1
			VAR _ativ = [A realizar]
			VAR _ativAnt = [T4 · A realizar · mês anterior]
			VAR _nC = [T4 · Obras que caíram no mês]
			VAR _nS = [T4 · Obras que subiram no mês]
			VAR _m = [T4 · Obras comparáveis no mês]
			VAR _listaS = [T4 · Obras que subiram no mês (lista)]
			VAR _listaC = [T4 · Obras que caíram no mês (lista)]
			VAR _mais = [T4 · Tooltip mês · obras fora da lista]
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@r", [Resultado aplicado],
			        "@p", [Resultado aplicado %],
			        "@st", [Nota · status · um mês],
			        "@pend", [Nota · pendente · um mês],
			        "@selo", [Obra · selo]
			    )
			VAR _comAba = FILTER ( _obras, NOT ISBLANK ( [@r] ) ) /* geometria */
			/* passou de 10 obras: as 9 de maior peso no mês (|R$|), na ordem de sempre, e a linha 'e mais N obras' */
			VAR _mostra = TOPN ( IF ( _mais > 0, 9, 10 ), _comAba, ABS ( [@r] ), DESC, dObra[Obra], ASC ) /* geometria */
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _taA = ABS ( _ativ )
			VAR _taNu = SWITCH ( TRUE (), _taA >= 99950000, FORMAT ( _taA / 1000000, "0.0", "pt-BR" ), _taA >= 999500, FORMAT ( _taA / 1000000, "0.00", "pt-BR" ), _taA >= 999.5, FORMAT ( _taA / 1000, "0", "pt-BR" ), FORMAT ( _taA, "#,0", "pt-BR" ) )
			VAR _taUn = SWITCH ( TRUE (), _taA >= 999500, " mi", _taA >= 999.5, " mil", "" )
			VAR _taN = _taNu & _taUn
			VAR _taZero = _taN = "0"
			VAR _taS = IF ( _taZero, "", IF ( _ativ < 0, "−", "" ) )
			VAR _taTxt = IF ( ISBLANK ( _ativ ), "—", _taS & "R$ " & _taN )
			VAR _taaA = ABS ( _ativAnt )
			VAR _taaNu = SWITCH ( TRUE (), _taaA >= 99950000, FORMAT ( _taaA / 1000000, "0.0", "pt-BR" ), _taaA >= 999500, FORMAT ( _taaA / 1000000, "0.00", "pt-BR" ), _taaA >= 999.5, FORMAT ( _taaA / 1000, "0", "pt-BR" ), FORMAT ( _taaA, "#,0", "pt-BR" ) )
			VAR _taaUn = SWITCH ( TRUE (), _taaA >= 999500, " mi", _taaA >= 999.5, " mil", "" )
			VAR _taaN = _taaNu & _taaUn
			VAR _taaZero = _taaN = "0"
			VAR _taaS = IF ( _taaZero, "", IF ( _ativAnt < 0, "−", "" ) )
			VAR _taaTxt = IF ( ISBLANK ( _ativAnt ), "—", _taaS & "R$ " & _taaN )
			VAR _taKP = LEN ( _taNu ) > 0
			VAR _taKN = IF ( _taKP, _taNu )
			VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
			VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
			VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
			VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
			VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
			VAR _taKOd =
			    IF (
			        _taKOk,
			        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _taNu
			    )
			VAR _taOd = IF ( ISBLANK ( _ativ ), _taTxt, _taS & "R$ " & _taKOd & _taUn )
			VAR _lsN = IF ( ISBLANK ( _listaS ) || _listaS = "", 0, PATHLENGTH ( _listaS ) )
			VAR _lsPos = IF ( _lsN >= 2, FIND ( "§", SUBSTITUTE ( _listaS, "|", "§", _lsN - 1 ) ) )
			VAR _lsTxt = SWITCH ( TRUE (), _lsN = 0, "", _lsN = 1, _listaS, SUBSTITUTE ( LEFT ( _listaS, _lsPos - 1 ), "|", ", " ) & " e " & MID ( _listaS, _lsPos + 1, 999 ) )
			VAR _lcN = IF ( ISBLANK ( _listaC ) || _listaC = "", 0, PATHLENGTH ( _listaC ) )
			VAR _lcPos = IF ( _lcN >= 2, FIND ( "§", SUBSTITUTE ( _listaC, "|", "§", _lcN - 1 ) ) )
			VAR _lcTxt = SWITCH ( TRUE (), _lcN = 0, "", _lcN = 1, _listaC, SUBSTITUTE ( LEFT ( _listaC, _lcPos - 1 ), "|", ", " ) & " e " & MID ( _listaC, _lcPos + 1, 999 ) )
			VAR _txtSob = IF ( _primeiro, "RESULTADO MÊS A MÊS · " & _mesC & " · PRIMEIRO MÊS DO HISTÓRICO", "RESULTADO DA CARTEIRA, MÊS A MÊS · " & _mesC )
			VAR _txtAtivAnt = IF ( ISBLANK ( _ativAnt ), "sem mês anterior", _mesAnt & " " & "⁅" & _taaTxt & "⁆" )
			VAR _txtRod =
			    SWITCH (
			        TRUE (),
			        _primeiro || _m = 0, "",
			        _nC = _m, "Caiu em todas as " & SWITCH ( _m, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _m, "0" ) ) & " obras desde " & _mesAnt & ".",
			        _nS = _m, "Subiu em todas as " & SWITCH ( _m, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _m, "0" ) ) & " obras desde " & _mesAnt & ".",
			        _nC >= _nS,
			            "Caiu em " & SWITCH ( _nC, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nC, "0" ) ) & " das " & SWITCH ( _m, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _m, "0" ) ) & " obras desde " & _mesAnt & IF ( _nS = 0, "; as outras ficaram iguais.", "; só " & _lsTxt & IF ( _nS = 1, " subiu.", " subiram." ) ),
			        "Subiu em " & SWITCH ( _nS, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nS, "0" ) ) & " das " & SWITCH ( _m, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _m, "0" ) ) & " obras desde " & _mesAnt & IF ( _nC = 0, "; nenhuma caiu.", "; só " & _lcTxt & IF ( _nC = 1, " caiu.", " caíram." ) )
			    )
			-- 3 · Geometria
			VAR _max = MAXX ( _comAba, ABS ( [@r] ) ) /* geometria */
			-- 4 · Marcação
			VAR _htmlLinhas =
			    CONCATENATEX (
			        _mostra,
			        VAR _r = [@r]
			        VAR _vA = ABS ( _r )
			        VAR _vNu = SWITCH ( TRUE (), _vA >= 999500, FORMAT ( _vA / 1000000, "0.00", "pt-BR" ), _vA >= 999.5, FORMAT ( _vA / 1000, "0", "pt-BR" ), FORMAT ( _vA, "#,0", "pt-BR" ) )
			        VAR _vUn = SWITCH ( TRUE (), _vA >= 999500, " mi", _vA >= 999.5, " mil", "" )
			        VAR _vS = IF ( _r < 0 && _vNu <> "0", "−", "" )
			        VAR _vKP = LEN ( _vNu ) > 0
			        VAR _vKN = IF ( _vKP, _vNu )
			        VAR _vKS = SUBSTITUTE ( SUBSTITUTE ( _vKN, ".", "" ), ",", "" )
			        VAR _vKT = IFERROR ( VALUE ( _vKS ), -1 )
			        VAR _vKOk = _vKP && _vKT >= 2 && FORMAT ( _vKT, REPT ( "0", LEN ( _vKS ) ) ) = _vKS
			        VAR _vKD = IF ( CONTAINSSTRING ( _vKN, "," ), LEN ( _vKN ) - SEARCH ( ",", _vKN ), 0 )
			        VAR _vKM = IF ( CONTAINSSTRING ( _vKN, "." ), "#,##0", "0" ) & IF ( _vKD > 0, "." & REPT ( "0", _vKD ) )
			        VAR _vKOd =
			            IF (
			                _vKOk,
			                "<o-d><o-v>" & _vKN & "</o-v><o-t aria-hidden='true'>"
			                    & CONCATENATEX (
			                        _odQ,
			                        IF ( [@odk] = 24, _vKN, FORMAT ( ROUND ( _vKT * [@odf] / 1000, 0 ) / POWER ( 10, _vKD ), _vKM, "pt-BR" ) ),
			                        UNICHAR ( 10 ),
			                        [@odk], ASC
			                    )
			                    & "</o-t></o-d>",
			                _vNu
			            )
			        VAR _vTxt = _vS & "R$ " & _vNu & _vUn
			        VAR _vOd = _vS & "R$ " & _vKOd & _vUn
			        VAR _qR = ROUND ( [@p] * 100, 2 )
			        VAR _qS = SWITCH ( TRUE (), _qR > 0, "+", _qR < 0, "−", "" )
			        VAR _qNu = FORMAT ( ABS ( [@p] ) * 100, "0.00", "pt-BR" )
			        VAR _qKP = LEN ( _qNu ) > 0
			        VAR _qKN = IF ( _qKP, _qNu )
			        VAR _qKS = SUBSTITUTE ( SUBSTITUTE ( _qKN, ".", "" ), ",", "" )
			        VAR _qKT = IFERROR ( VALUE ( _qKS ), -1 )
			        VAR _qKOk = _qKP && _qKT >= 2 && FORMAT ( _qKT, REPT ( "0", LEN ( _qKS ) ) ) = _qKS
			        VAR _qKD = IF ( CONTAINSSTRING ( _qKN, "," ), LEN ( _qKN ) - SEARCH ( ",", _qKN ), 0 )
			        VAR _qKM = IF ( CONTAINSSTRING ( _qKN, "." ), "#,##0", "0" ) & IF ( _qKD > 0, "." & REPT ( "0", _qKD ) )
			        VAR _qKOd =
			            IF (
			                _qKOk,
			                "<o-d><o-v>" & _qKN & "</o-v><o-t aria-hidden='true'>"
			                    & CONCATENATEX (
			                        _odQ,
			                        IF ( [@odk] = 24, _qKN, FORMAT ( ROUND ( _qKT * [@odf] / 1000, 0 ) / POWER ( 10, _qKD ), _qKM, "pt-BR" ) ),
			                        UNICHAR ( 10 ),
			                        [@odk], ASC
			                    )
			                    & "</o-t></o-d>",
			                _qNu
			            )
			        VAR _qTxt = _qS & _qNu & "%"
			        VAR _qOd = _qS & _qKOd & "%"
			        VAR _w = MAX ( 1, ROUND ( DIVIDE ( ABS ( _r ), _max ) * 72, 0 ) ) -- geometria
			        VAR _x = IF ( _r >= 0, 240, 240 - _w ) -- geometria
			        VAR _corre = IF ( _r < 0, " data-rp='left,width' data-r0-left='240px'" )
			        VAR _clsBz = IF ( _r < 0, " ng", "" )
			        VAR _ngV = IF ( _vS = "−", " ng", "" )
			        VAR _ngQ = IF ( _qS = "−", " ng", "" )
			        VAR _cls = IF ( [@pend] = 1, "m", IF ( ISBLANK ( [@st] ), "", [@st] & "" ) )
			        RETURN
			            "<div class='lc'>" & IF ( _cls = "", "", "<i class='mk mk" & _cls & "'></i>" ) & "<span class='nm'>" & dObra[Obra] & IF ( [@selo] = "REAL", "<span class='selo selo-r'>REAL</span>", "" ) & "</span>"
			                & "<i class='bz" & _clsBz & "' style='left:" & _x & "px;width:" & _w & "px'" & _corre & " data-rk='" & dObra[Obra] & "' data-rd='" & ( RANKX ( _mostra, [@r], _r, DESC ) - 1 ) * 60 & "'></i>" /* geometria */
			                & "<span class='v" & _ngV & "'>" & _vOd & "</span><span class='p" & _ngQ & "'>" & _qOd & "</span></div>",
			        "",
			        [@r], DESC,
			        dObra[Obra], ASC
			    )
			VAR _htmlMais = IF ( _mais > 0, "<i class='vz mais'>e mais " & "⁅" & FORMAT ( _mais, "0" ) & "⁆" & " obras, com resultado mais perto de zero</i>" )
			VAR _nLs = COUNTROWS ( _mostra ) + IF ( _mais > 0, 1, 0 ) /* lista */
			VAR _saidaHtml =
			    IF (
			        _n > 0,
			        "<div class='u tt'><div class='cab'><p class='vs'>" & _txtSob & "</p>"
			            & "<div class='lin1'><div class='tit'><b>" & _mesL & "</b></div></div></div>"
			            & "<div class='corpo lim'><div class='bh'><span class='vs'>RESULTADO APLICADO DE CADA OBRA · R$ NO MÊS</span>"
			            & "<span class='vs'>% DO ORÇ.</span></div><div class='lsb" & " ls " & SWITCH ( TRUE (), _nLs <= 3, "e1", _nLs <= 6, "e2", _nLs <= 9, "e3", _nLs <= 12, "e4", "e5" ) & "' style='--n:" & _nLs & "'>" & _htmlLinhas & _htmlMais & "</div></div>"
			            & "<div class='pe'><div class='dd'><span class='vs'>A REALIZAR (ATÉ O TRAÇO DA PLANILHA)</span>"
			            & "<b>" & _taOd & "</b><span class='dt'>· " & _txtAtivAnt & "</span></div>"
			            & IF ( _txtRod <> "", "<p class='rod'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtRod, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" )
			        & "</div></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Tooltips
		lineageTag: 62140071-69d2-5bbb-8123-7cd7aa56c043

	/// Tooltip de página da obra (linha de Obras no mês; era a de Desembolso por obra): o desvio sobre o previsto mês a mês (cor = faixa do previsão de caixa da nota, para mais ou para menos; rótulo no mês de referência e no extremo oposto), a justificativa do mês de referência (veio do painel na fase 5: o texto da aba em até 2 linhas, o chip 'EM BRANCO · EXIGIDA', 'dentro de ±10%: não exigida' ou 'sem previsto no mês', com o desvio e se era exigida à direita), o histórico das justificativas nos 5 meses anteriores (os mais antigos numa linha de resumo; some quando nada foi exigido no período) e um rodapé com o que foi exigido e preenchido.
	measure 'T4 · Tooltip obra do desembolso · HTML' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _mesCM = [Mês de referência · curto maiúsculo]
			VAR _iniHist = [Série · primeiro mês]
			VAR _aba = [Aba · ref]
			VAR _obra = [Obra · nome]
			VAR _cod = [Obra · código]
			VAR _selo = [Obra · selo]
			VAR _ini = [Obra · início]
			VAR _fim = [Obra · término previsto]
			VAR _adoSt = [Nota · status · ranking · ref]
			VAR _adoPend = [Nota · pendente · ranking · ref]
			VAR _adoNota = [Nota · nota final · ranking · ref]
			VAR _adoObt = [Nota · pontos obtidos · ranking · ref]
			VAR _adoPoss = [Nota · pontos possíveis · ranking · ref]
			VAR _ex = [T4 · Obra · justificativas exigidas no período] + 0
			VAR _pre = [T4 · Obra · justificativas preenchidas no período] + 0
			VAR _seg = [T4 · Obra · meses seguidos em branco] + 0
			VAR _critIni = [T4 · Obra · faixa crítica do desembolso · início]
			VAR _abaixoIni = [T4 · Obra · abaixo do previsto · início]
			VAR _nAba = [T4 · Meses com aba]
			VAR _rIni = [T4 · Obra · resumo das justificativas · primeiro mês]
			VAR _rFim = [T4 · Obra · resumo das justificativas · último mês]
			VAR _rMeses = [T4 · Obra · resumo das justificativas · meses] + 0
			VAR _rEx = [T4 · Obra · resumo das justificativas · exigidas] + 0
			VAR _rPre = [T4 · Obra · resumo das justificativas · preenchidas] + 0
			VAR _rNao = [T4 · Obra · resumo das justificativas · não exigidas] + 0
			VAR _tR = TRIM ( [Justificativa do desembolso · ref] )
			VAR _exR = [Justificativa · exigida · ref]
			VAR _brR = [Justificativa · em branco · ref]
			VAR _dvR = [Desembolso · desvio no mês · ref]
			VAR _jus =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@rot", [Mês · abreviado],
			        "@tem", [Obras com análise],
			        "@t", [Justificativa do desembolso],
			        "@e", [Justificativa · exigida],
			        "@b", [Justificativa · em branco]
			    )
			/* histórico: os 5 meses antes da referência, um por linha; os anteriores viram a linha de resumo */
			VAR _jusMeses = FILTER ( _jus, [@ate] = 1 && [@tem] > 0 && dMes[Mes] >= EDATE ( _ref, -5 ) && dMes[Mes] < _ref ) /* lista */
			VAR _nHist = [T4 · Tooltip obra do desembolso · meses com aba nos 5 anteriores]
			VAR _nJl = COUNTROWS ( _jusMeses ) + IF ( _rMeses > 0, 1, 0 ) /* lista */
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _txtPer =
			    SWITCH (
			        TRUE (),
			        _iniHist = _ref || ISBLANK ( _iniHist ), _mesCM,
			        YEAR ( _iniHist ) <> YEAR ( _ref ), UPPER ( FORMAT ( _iniHist, "mmm/yy", "pt-BR" ) ) & "–" & _mesCM,
			        UPPER ( FORMAT ( _iniHist, "mmm", "pt-BR" ) ) & "–" & _mesCM
			    )
			VAR _txtDir = IF ( ISBLANK ( _ini ), "", "INÍCIO " & UPPER ( FORMAT ( _ini, "mmm/yy", "pt-BR" ) ) ) & IF ( ISBLANK ( _fim ), "", " · TÉRMINO " & UPPER ( FORMAT ( _fim, "mmm/yy", "pt-BR" ) ) )
			/* Nota da obra no mês de referência: 'nota 7,75 · atenção' ou 'pendente · 5,0 de 6,0' */
			VAR _adoN = FORMAT ( _adoNota, "0.0#", "pt-BR" )
			VAR _adoOb = FORMAT ( _adoObt, "0.0#", "pt-BR" )
			VAR _adoPo = FORMAT ( _adoPoss, "0.0#", "pt-BR" )
			VAR _adoTxt = SWITCH ( TRUE (), _adoPend = 1, "pendente · " & _adoOb & " de " & _adoPo, ISBLANK ( _adoNota ), "—", "nota " & _adoN )
			VAR _txtAdo =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _adoPend ), "",
			        _adoPend = 1, _adoTxt,
			        _adoTxt & " · " & SWITCH ( TRUE (), _adoPend = 1, "pendente", ISBLANK ( _adoSt ), "", _adoSt = 2, "crítico", _adoSt = 1, "atenção", "estável" )
			    )
			VAR _txtAdoC = IF ( _txtAdo = "", "", IF ( _txtDir = "", "", " · " ) & UPPER ( _txtAdo ) )
			/* a Nota da obra entra depois de início · término; se a linha do título não couber nos 520 px (título Barlow 21 ≈
			   12 px por letra, código ≈ 8, selo ≈ 50, vão 24, meta em versalete ≈ 7; medido no JANGADA: 496 de 520), o período fica só 'OUT/25–JUL/28' */
			VAR _txtPerCurto = IF ( ISBLANK ( _ini ) || ISBLANK ( _fim ), _txtDir, UPPER ( FORMAT ( _ini, "mmm/yy", "pt-BR" ) ) & "–" & UPPER ( FORMAT ( _fim, "mmm/yy", "pt-BR" ) ) )
			VAR _pxCab = 12 * LEN ( _obra ) + 8 + 8 * LEN ( _cod ) + IF ( _selo = "" || ISBLANK ( _selo ), 0, 50 ) + 24 + 7 * LEN ( _txtDir & _txtAdoC ) -- geometria
			VAR _txtDirAdo = IF ( _pxCab <= 520, _txtDir, _txtPerCurto ) & _txtAdoC
			VAR _txtFaixa =
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _critIni ), "; na faixa crítica desde " & FORMAT ( _critIni, "mmmm", "pt-BR" ),
			        NOT ISBLANK ( _abaixoIni ), "; abaixo do previsto desde " & FORMAT ( _abaixoIni, "mmmm", "pt-BR" ),
			        ""
			    )
			VAR _txtBranco = IF ( _seg > 0, "; em branco há " & SWITCH ( _seg, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _seg, "0" ) ) & IF ( _seg = 1, " mês", " meses" ), "" )
			VAR _txtRod =
			    SWITCH (
			        TRUE (),
			        _ex = 0, "Dentro de ±10% nos " & SWITCH ( _nAba, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAba, "0" ) ) & " meses: nenhuma justificativa exigida.",
			        _pre = _ex,
			            IF ( _ex = _nAba, "Exigida e preenchida nos " & SWITCH ( _ex, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _ex, "0" ) ) & " meses", "Exigida em " & SWITCH ( _ex, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _ex, "0" ) ) & IF ( _ex = 1, " mês, preenchida", " meses, todas preenchidas" ) ) & _txtFaixa & ".",
			        _pre = 0, UPPER ( LEFT ( SWITCH ( _ex, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _ex, "0" ) ), 1 ) ) & MID ( SWITCH ( _ex, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _ex, "0" ) ), 2, LEN ( SWITCH ( _ex, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _ex, "0" ) ) ) ) & IF ( _ex = 1, " mês exigido, não preenchido", " meses exigidos, nenhum preenchido" ) & _txtBranco & ".",
			        "Exigida em " & SWITCH ( _ex, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _ex, "0" ) ) & " meses, " & SWITCH ( _pre, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _pre, "0" ) ) & IF ( _pre = 1, " preenchida", " preenchidas" ) & _txtBranco & "."
			    )
			/* justificativa do mês de referência (fase 5, veio do painel): texto da aba, chip, não exigida ou sem previsto */
			VAR _tdrN = FORMAT ( ABS ( _dvR ) * 100, "0", "pt-BR" )
			VAR _tdrS = SWITCH ( TRUE (), ROUND ( _dvR * 100, 0 ) < 0, "−", ROUND ( _dvR * 100, 0 ) > 0, "+", "" )
			VAR _tdrTxt = IF ( ISBLANK ( _dvR ), "—", _tdrS & _tdrN & "%" )
			VAR _txtDirR =
			    IF ( ISBLANK ( _dvR ), "SEM PREVISTO NO MÊS", "DESVIO " & "⁅" & _tdrTxt & "⁆" & IF ( _exR = 1, " · EXIGIDA", " · NÃO EXIGIDA" ) )
			VAR _htmlRef =
			    SWITCH (
			        TRUE (),
			        _brR = 1, "<span class='chp'><i></i>Em branco · exigida</span>",
			        NOT ISBLANK ( _tR ) && _tR <> "", "<p class='t'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _tR, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>",
			        ISBLANK ( _exR ), "<p class='t ne'>sem previsto no mês</p>",
			        "<p class='t ne'>dentro de ±10%: não exigida</p>"
			    )
			VAR _clsJl = IF ( _rMeses > 0, " lg", "" )
			VAR _txtRIni = FORMAT ( _rIni, "mmm", "pt-BR" )
			VAR _txtRPer = IF ( _rIni = _rFim, _txtRIni, _txtRIni & "–" & FORMAT ( _rFim, "mmm", "pt-BR" ) )
			VAR _txtRPre =
			    SWITCH (
			        TRUE (),
			        _rPre = 0, "nenhuma preenchida",
			        _rPre = _rEx, IF ( _rEx = 1, "preenchida", "todas preenchidas" ),
			        "⁅" & _rPre & "⁆" & IF ( _rPre = 1, " preenchida", " preenchidas" )
			    )
			VAR _txtResumo =
			    IF (
			        _rEx = 0,
			        "nenhuma exigida (dentro de ±10%)",
			        "⁅" & _rEx & "⁆" & IF ( _rEx = 1, " exigida, ", " exigidas, " ) & _txtRPre
			            & IF ( _rNao > 0, " (" & "⁅" & _rNao & "⁆" & " dentro de ±10%)", "" )
			    )
			VAR _htmlResumo =
			    IF (
			        _rMeses > 0,
			        "<div class='jl lg'><span class='m'>" & _txtRPer & "</span><span class='t ne'>" & _txtResumo & "</span></div>"
			    )
			VAR _htmlJus =
			    _htmlResumo & CONCATENATEX (
			        _jusMeses,
			        VAR _t = TRIM ( [@t] )
			        VAR _cel =
			            SWITCH (
			                TRUE (),
			                [@b] = 1, "<span class='chp'><i></i>Em branco · exigida</span>",
			                NOT ISBLANK ( _t ) && _t <> "", "<span class='t'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _t, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</span>",
			                ISBLANK ( [@e] ), "<span class='t ne'>sem previsto no mês</span>",
			                "<span class='t ne'>não exigida (dentro de ±10%)</span>"
			            )
			        RETURN
			            "<div class='jl" & _clsJl & "'><span class='m'>" & [@rot] & "</span>" & _cel & "</div>",
			        "",
			        dMes[Mes], ASC
			    )
			VAR _n = [Série · meses até a referência]
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@pos", [Série · posição na janela],
			        "@rot", [Mês · abreviado],
			        "@v", [Desembolso · desvio no mês],
			        "@st", [T4 · Desembolso · faixa do fluxo de caixa]
			    )
			VAR _serie = FILTER ( _meses, [@ate] = 1 ) /* lista */
			VAR _com = FILTER ( _serie, NOT ISBLANK ( [@v] ) ) /* lista */
			VAR _vMax = MAXX ( _com, [@v] ) /* lista */
			VAR _vMin = MINX ( _com, [@v] ) /* lista */
			VAR _vRef = MAXX ( FILTER ( _com, dMes[Mes] = _ref ), [@v] ) /* lista */
			VAR _ext = IF ( _vMax - _vRef >= _vRef - _vMin, _vMax, _vMin ) /* lista */
			VAR _mesExt = MINX ( FILTER ( _com, [@v] = _ext && dMes[Mes] <> _ref ), dMes[Mes] ) /* lista */
			VAR _compacto = _n >= 7
			VAR _rLab = SWITCH ( TRUE (), ROUND ( _vRef * 100, 0 ) > 0, "+", ROUND ( _vRef * 100, 0 ) < 0, "−", "" ) & FORMAT ( ABS ( _vRef ) * 100, "0", "pt-BR" ) & "%"
			-- 3 · Geometria
			VAR _pos = MAX ( 0, _vMax ) -- geometria
			VAR _neg = MAX ( 0, - _vMin ) -- geometria
			VAR _esc = DIVIDE ( 60, _pos + _neg ) -- geometria
			VAR _topo = IF ( _pos > 0, 21, 4 ) -- geometria
			VAR _base = _topo + ROUND ( _pos * _esc, 0 ) -- geometria
			VAR _yMes = _base + ROUND ( _neg * _esc, 0 ) + IF ( _neg > 0, 25, 6 ) -- geometria
			VAR _altSerie = _yMes + 17 -- geometria
			VAR _cw = 520 / _n -- geometria
			VAR _bw = MIN ( 40, 2 * ROUND ( 0.275 * _cw, 0 ) ) -- geometria
			VAR _meiaBw = INT ( _bw / 2 ) -- geometria
			VAR _hRef = IF ( ISBLANK ( _vRef ), 0, MAX ( 2, ROUND ( ABS ( _vRef ) * _esc, 0 ) ) ) -- geometria
			VAR _yRotRef = IF ( _vRef >= 0, _base - _hRef - 21, _base + _hRef + 4 ) -- geometria
			VAR _wRef = INT ( LEN ( _rLab ) * 8.5 ) + 2 -- geometria
			VAR _xRef = MAX ( 0, MIN ( ( _n - 0.5 ) * _cw - _wRef / 2, 520 - _wRef ) ) -- geometria
			VAR _htmlSerie =
			    CONCATENATEX (
			        _serie,
			        VAR _v = [@v]
			        VAR _p = [@pos]
			        VAR _tem = NOT ISBLANK ( _v )
			        VAR _h = IF ( _tem, MAX ( 2, ROUND ( ABS ( _v ) * _esc, 0 ) ), 0 ) -- geometria
			        VAR _y = IF ( _v >= 0, _base - _h, _base ) -- geometria
			        VAR _yRot = IF ( _v >= 0, _y - 21, _y + _h + 4 ) -- geometria
			        VAR _ngL = ""
			        VAR _atraso = ( _p - 1 ) * 100 -- geometria
			        VAR _ehRef = dMes[Mes] = _ref
			        VAR _ehExt = dMes[Mes] = _mesExt
			        VAR _tR = ROUND ( _v * 100, 0 )
			        VAR _tS = SWITCH ( TRUE (), _tR > 0, "+", _tR < 0, "−", "" )
			        VAR _tNu = FORMAT ( ABS ( _v ) * 100, "0", "pt-BR" )
			        VAR _tKP = LEN ( _tNu ) > 0
			        VAR _tKN = IF ( _tKP, _tNu )
			        VAR _tKS = SUBSTITUTE ( SUBSTITUTE ( _tKN, ".", "" ), ",", "" )
			        VAR _tKT = IFERROR ( VALUE ( _tKS ), -1 )
			        VAR _tKOk = _tKP && _tKT >= 2 && FORMAT ( _tKT, REPT ( "0", LEN ( _tKS ) ) ) = _tKS
			        VAR _tKD = IF ( CONTAINSSTRING ( _tKN, "," ), LEN ( _tKN ) - SEARCH ( ",", _tKN ), 0 )
			        VAR _tKM = IF ( CONTAINSSTRING ( _tKN, "." ), "#,##0", "0" ) & IF ( _tKD > 0, "." & REPT ( "0", _tKD ) )
			        VAR _tKOd =
			            IF (
			                _tKOk,
			                "<o-d><o-v>" & _tKN & "</o-v><o-t aria-hidden='true'>"
			                    & CONCATENATEX (
			                        _odQ,
			                        IF ( [@odk] = 24, _tKN, FORMAT ( ROUND ( _tKT * [@odf] / 1000, 0 ) / POWER ( 10, _tKD ), _tKM, "pt-BR" ) ),
			                        UNICHAR ( 10 ),
			                        [@odk], ASC
			                    )
			                    & "</o-t></o-d>",
			                _tNu
			            )
			        VAR _tTxt = _tS & _tNu & "%"
			        VAR _tOd = _tS & _tKOd & "%"
			        VAR _tLab = _tTxt
			        VAR _tLabOd = _tOd
			        /* rótulo centrado na coluna e preso à área; o do extremo recua se encostar no da referência */
			        VAR _w = INT ( LEN ( _tLab ) * 8.5 ) + 2 -- geometria
			        VAR _xNat = MAX ( 0, MIN ( ( _p - 0.5 ) * _cw - _w / 2, 520 - _w ) ) -- geometria
			        VAR _colide = _ehExt && ABS ( _yRot - _yRotRef ) < 18 && _xNat + _w > _xRef - 6 -- geometria
			        VAR _x = IF ( _colide, MAX ( 0, _xRef - 6 - _w ), _xNat ) -- geometria
			        VAR _xRel = ROUND ( _x - ( _p - 1 ) * _cw, 0 ) -- geometria
			        VAR _estilo = "top:" & _yRot & "px;left:" & _xRel & "px;width:" & _w & "px"
			        VAR _rot =
			            SWITCH (
			                TRUE (),
			                _tem && _ehRef, "<span class='val fim" & _ngL & "' style='" & _estilo & ";animation-delay:"
			                    & ( _atraso + 700 ) & "ms'>" & _tLabOd & "</span>",
			                _tem && _ehExt, "<span class='val ext" & _ngL & "' style='" & _estilo & "'>" & _tLabOd & "</span>",
			                ""
			            )
			        VAR _corre = "' data-rp='top,height' data-r0-top='" & _base & "px' data-r0-height='0px' data-rd='"
			        RETURN
			            "<div class='c' style='height:" & _altSerie & "px'>" & _rot
			                & IF ( _tem, "<i class='bar s" & [@st] & "' style='top:" & _y & "px;height:" & _h & "px;left:calc(50% - " & _meiaBw & "px);width:" & _bw & "px' data-rk='m" & _p & _corre & _atraso & "'></i>" )
			                & "<span class='ms" & IF ( _ehRef, " ref", IF ( _tem, "", " sem" ) ) & "' style='top:" & _yMes & "px'>" & [@rot] & "</span></div>",
			        "",
			        dMes[Mes], ASC
			    )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( [Orçamento · ref] ),
			        "<div class='u tt'><div class='cab'><p class='vs'>" & "DESEMBOLSO" & " · " & _txtPer & IF ( ISBLANK ( _aba ), "", " · ABA " & _aba ) & "</p>"
			            & "<div class='lin1'><div class='tit'><b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</b><em>" & _cod & "</em>" & "<span class='selo " & IF ( _selo = "REAL", "selo-r", "selo-i" ) & "'>" & _selo & "</span>" & "</div>"
			            & "<p class='vs dir'>" & _txtDirAdo & "</p></div></div>"
			            & "<div class='corpo'><span class='vs'>DESVIO SOBRE O PREVISTO, MÊS A MÊS</span>"
			            & "<div class='sr'>" & _htmlSerie & "</div>"
			            & "<div class='rg'></div><div class='bh'><span class='vs'>JUSTIFICATIVA DE " & _mesCM & "</span>"
			            & "<span class='vs'>" & _txtDirR & "</span></div><div class='jr'>" & _htmlRef & "</div>"
			            & IF (
			                _ex > 0 && _nHist + _rMeses > 0,
			                "<div class='rg'></div><div class='bh'><span class='vs'>NOS MESES ANTERIORES</span>"
			                    & "<span class='vs'>EXIGIDA ACIMA DE ±10%</span></div><div class='jls" & " ls " & SWITCH ( TRUE (), _nJl <= 3, "e1", _nJl <= 6, "e2", _nJl <= 9, "e3", _nJl <= 12, "e4", "e5" ) & "' style='--n:" & _nJl & "'>" & _htmlJus & "</div>"
			            )
			            & "</div><div class='pe'><p class='rod'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtRod, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p></div>"
			        & "</div>" & [Comum · JS contador tooltip] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Tooltips
		lineageTag: 3a457c04-2b15-5b07-8ae9-8db74042657e

	/// CSS v2 dos tooltips de página da T4 (completo, sobre o CSS base): cabeçalho preto com a meta que desce para a 2ª linha quando não cabe, pé preso à base, linhas por obra com barra divergente, mini série por mês pela faixa e histórico das justificativas.
	measure 'T4 · Tooltip · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".tt{position:fixed;inset:0;display:flex;flex-direction:column;background:#FFFFFF;border:1px solid #0B0B0C;border-radius:0;overflow:hidden;color:#0B0B0C}.tt .vs{display:block}.tt .c"
			    & "ab{flex:none;background:#0B0B0C;padding:14px 20px 13px}.tt .cab>.vs{color:#E9E0CF}.tt .cab .lin1{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;colu"
			    & "mn-gap:24px;row-gap:6px;margin-top:4px}.tt .cab .tit{display:flex;align-items:baseline;gap:8px;white-space:nowrap}.tt .cab .tit b{font-family:'Barlow U','Segoe UI',sans-serif;font-"
			    & "weight:600;font-size:21px;line-height:26px;color:#FFFFFF}.tt .cab .tit em{font-style:normal;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:12px;line-height:"
			    & "15px;letter-spacing:1.2px;text-transform:uppercase;color:#E9E0CF}.tt .cab .dir{color:#E9E0CF;white-space:nowrap}.tt .corpo{flex:1 1 auto;min-height:0;overflow:hidden;position:relat"
			    & "ive;margin:16px 20px 0}.tt .bh{display:flex;justify-content:space-between;margin-bottom:9px}.tt .rg{height:1px;background:#E1E1E1;margin:10px 0 10px}.tt .pe{flex:none;margin:8px 20"
			    & "px 14px;padding-top:12px;border-top:1px solid #E1E1E1}.tt .dd{display:flex;align-items:baseline;gap:10px;white-space:nowrap;height:20px}.tt .dd b{font-family:'Barlow U','Segoe UI',"
			    & "sans-serif;font-weight:600;font-size:16px;line-height:20px}.tt .dd .dt{margin-left:-4px;font-size:14px;line-height:19px;color:#3B3B3F;overflow:hidden;text-overflow:ellipsis}.tt .ro"
			    & "d{margin-top:8px;font-size:14px;line-height:19px}.tt .pe .rod:first-child{margin-top:0}.tt .lc{position:relative;height:28px;white-space:nowrap}.tt .lc .mk{position:absolute;left:0"
			    & ";top:9px}.tt .lc .nm{position:absolute;left:19px;top:4px;display:flex;align-items:center;gap:7px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;line-he"
			    & "ight:20px}.tt .lc .bz{position:absolute;top:8px;height:12px;background:#0B0B0C}.tt .lc .bz.ng{background:#C43737}.tt .lc .bz.s0{background:#A9CDB9;box-shadow:inset 0 0 0 1px #6E9F8"
			    & "5}.tt .lc .bz.s1{background:#C9821F}.tt .lc .bz.s2{background:#C43737}.tt .lc .v{position:absolute;right:100px;top:4px;text-align:right;font-family:'Barlow U','Segoe UI',sans-serif"
			    & ";font-weight:600;font-size:16px;line-height:20px}.tt .lc .p{position:absolute;right:0;top:3px;text-align:right;font-size:15px;line-height:21px;color:#3B3B3F}.tt .lc .pv{position:ab"
			    & "solute;right:278px;top:4px;text-align:right;font-size:14px;line-height:19px;color:#3B3B3F}.tt .lc .px{position:absolute;left:246px;top:4px;font-size:14px;line-height:19px;color:#3B"
			    & "3B3F}.tt .lc .ds{position:absolute;left:258px;top:4px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;line-height:20px}.tt .lc .p.dv{top:4px;font-family"
			    & ":'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;line-height:20px;color:#0B0B0C}.tt i.vz{display:block;font-style:normal;color:#3B3B3F;font-size:14px;line-height:19"
			    & "px}.tt i.vz.mais{line-height:28px;padding-left:19px}.tt .sr{position:relative;display:flex;margin-top:9px}.tt .sr .c{position:relative;flex:1 1 0;min-width:0}.tt .sr .c .bar{positi"
			    & "on:absolute}.tt .sr .c .bar.s2{background:#C43737}.tt .sr .c .bar.s1{background:#C9821F}.tt .sr .c .bar.s0{background:#A9CDB9;box-shadow:inset 0 0 0 1px #6E9F85}.tt .sr .c .val{pos"
			    & "ition:absolute;z-index:2;text-align:center;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;white-space:nowrap;color:#0B0B0C}.tt .sr .c "
			    & ".val.ext{color:#3B3B3F}.tt .sr .c .ms{position:absolute;left:0;right:0;text-align:center;font-size:13px;line-height:16px;color:#3B3B3F;white-space:nowrap}.tt .sr .c .ms.ref{font-we"
			    & "ight:600;color:#0B0B0C}.tt .sr .c .ms.sem{opacity:.45}.tt .jl{display:grid;grid-template-columns:72px 1fr;align-items:center;height:29px;white-space:nowrap}.tt .jl .m{font-size:15p"
			    & "x;line-height:21px;font-weight:600}.tt .jl .t{font-size:15px;line-height:21px;overflow:hidden;text-overflow:ellipsis}.tt .jl .t.ne{color:#6B6B70}.tt .jl .chp{justify-self:start}.tt"
			    & " .jr{min-height:21px}.tt .jr .t{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:15px;line-height:21px;white-space:normal;overflow-wra"
			    & "p:anywhere}.tt .jr .t.ne{color:#6B6B70}.tt .sl{position:relative;height:124px;margin-top:9px}.tt .sl svg{position:absolute;left:0;top:0;overflow:visible}.tt .sl .z{stroke:#6B6B70;s"
			    & "troke-width:10;stroke-dasharray:20 30;fill:none}.tt .sl .t{stroke:#0B0B0C;stroke-width:20;fill:none;stroke-linejoin:round;stroke-linecap:round}.tt .sl .t.n{stroke:#C43737}.tt .sl c"
			    & "ircle{fill:#0B0B0C}.tt .sl circle.n{fill:#C43737}.tt .sl .val{position:absolute;z-index:2;text-align:center;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:1"
			    & "4px;line-height:17px;white-space:nowrap;color:#0B0B0C}.tt .sl .val.ext{color:#3B3B3F}.tt .sl .ms{position:absolute;top:108px;text-align:center;font-size:13px;line-height:16px;color"
			    & ":#3B3B3F;white-space:nowrap}.tt .sl .ms.ref{font-weight:600;color:#0B0B0C}.tt .sl .ms.sem{opacity:.45}@keyframes ttFim{from{opacity:0}}.tt .fim{animation:ttFim .2s ease-out backwar"
			    & "ds}.tt .bh+.sl{margin-top:0}.tt .bh .mk{margin-right:6px}@media (prefers-reduced-motion:reduce){.tt .fim{animation:none}}.tt .e1{--k:1.35;--hm:96px}.tt .e2{--k:1.2;--hm:64px}.tt .e"
			    & "3{--k:1.08;--hm:52px}.tt .e4{--k:.95;--hm:40px}.tt .e5{--k:.87;--hm:32px}.tt .corpo{display:flex;flex-direction:column}.tt .ls{flex:1 1 auto;min-height:0;max-height:calc(var(--n,9)"
			    & " * var(--hm,36px))}.tt .ls{display:flex;flex-direction:column}.tt .ls>*{flex:1 1 0;min-height:0}.tt .ls .lc .nm{font-size:min(17px,max(13px,calc(16px * var(--k,1))))}.tt .ls .lc .v"
			    & "{font-size:min(17px,max(13px,calc(16px * var(--k,1))))}.tt .ls .lc .p{font-size:min(17px,max(13px,calc(15px * var(--k,1))))}.tt .ls>.mais{font-size:min(17px,max(13px,calc(14px * va"
			    & "r(--k,1))))}.tt .ls .chi{height:auto;min-height:22px;padding:calc(2px * var(--k,1)) 8px;font-size:max(13px,calc(13px * var(--k,1)))}.tt .ls .mk{width:calc(11px * var(--k,1));height"
			    & ":calc(11px * var(--k,1))}.tt .ld .lc .nm{font-size:min(16px,max(13px,calc(16px * var(--k,1))))}.tt .ld .lc .pv{font-size:min(14px,max(13px,calc(14px * var(--k,1))))}.tt .ld .lc .px"
			    & "{font-size:min(14px,max(13px,calc(14px * var(--k,1))))}.tt .ld .lc .ds{font-size:min(16px,max(13px,calc(16px * var(--k,1))))}.tt .ld .lc .p.dv{font-size:min(16px,max(13px,calc(16px"
			    & " * var(--k,1))))}.tt .ld>.mais{font-size:min(14px,max(13px,calc(14px * var(--k,1))))}.tt .jls .jl .m{font-size:min(19px,max(13px,calc(15px * var(--k,1))))}.tt .jls .jl .t{font-size"
			    & ":min(19px,max(13px,calc(15px * var(--k,1))))}.tt .ls .lc>*,.tt .ls .lc>.dv{top:50%;translate:0 -50%;line-height:1.25}.tt .ls>.mais{display:flex;align-items:center;line-height:1.25}"
			    & ".tt .ls .jl>*{line-height:1.3}.tt .ls>.jl{min-height:auto;height:auto}.tt .ls .jl .t{white-space:normal;overflow:visible;text-overflow:clip;overflow-wrap:anywhere}/*contador*/@keyf"
			    & "rames tqE0{from{opacity:.35}}@keyframes tqP0{from{opacity:0;transform:scale(.5)}}@keyframes tqE1{0%,16.667%{opacity:.35}}@keyframes tqP1{0%,16.667%{opacity:0;transform:scale(.5)}}@"
			    & "keyframes tqE2{0%,28.571%{opacity:.35}}@keyframes tqP2{0%,28.571%{opacity:0;transform:scale(.5)}}@keyframes tqE3{0%,37.5%{opacity:.35}}@keyframes tqP3{0%,37.5%{opacity:0;transform:"
			    & "scale(.5)}}@keyframes tqE4{0%,44.444%{opacity:.35}}@keyframes tqP4{0%,44.444%{opacity:0;transform:scale(.5)}}@keyframes tqE5{0%,50%{opacity:.35}}@keyframes tqP5{0%,50%{opacity:0;tr"
			    & "ansform:scale(.5)}}@keyframes tqE6{0%,54.545%{opacity:.35}}@keyframes tqP6{0%,54.545%{opacity:0;transform:scale(.5)}}@keyframes tqE7{0%,58.333%{opacity:.35}}@keyframes tqP7{0%,58.3"
			    & "33%{opacity:0;transform:scale(.5)}}@keyframes tqE8{0%,61.538%{opacity:.35}}@keyframes tqP8{0%,61.538%{opacity:0;transform:scale(.5)}}@keyframes tqE9{0%,64.286%{opacity:.35}}@keyfra"
			    & "mes tqP9{0%,64.286%{opacity:0;transform:scale(.5)}}@keyframes tqE10{0%,66.667%{opacity:.35}}@keyframes tqP10{0%,66.667%{opacity:0;transform:scale(.5)}}@keyframes tqE11{0%,68.75%{op"
			    & "acity:.35}}@keyframes tqP11{0%,68.75%{opacity:0;transform:scale(.5)}}@keyframes tqE12{0%,70.588%{opacity:.35}}@keyframes tqP12{0%,70.588%{opacity:0;transform:scale(.5)}}@keyframes "
			    & "tqE13{0%,72.222%{opacity:.35}}@keyframes tqP13{0%,72.222%{opacity:0;transform:scale(.5)}}@keyframes tqE14{0%,73.684%{opacity:.35}}@keyframes tqP14{0%,73.684%{opacity:0;transform:sc"
			    & "ale(.5)}}@keyframes tqE15{0%,75%{opacity:.35}}@keyframes tqP15{0%,75%{opacity:0;transform:scale(.5)}}@keyframes tqE16{0%,76.19%{opacity:.35}}@keyframes tqP16{0%,76.19%{opacity:0;tr"
			    & "ansform:scale(.5)}}:is(.mk,.chi,.chip,.chp,circle,.pend){transform-box:fill-box;transform-origin:center}.tt .cab{animation:tqE0 0.2s ease-out}.tt .cab :is(.mk,.chi,.chip,.chp,circl"
			    & "e,.pend){animation:tqP0 0.3s ease-out}.tt .corpo>.bh,.tt .corpo>.vs,.tt .sr,.tt .rg,.tt .jr{animation:tqE1 0.24s ease-out}.tt .corpo>.bh :is(.mk,.chi,.chip,.chp,circle,.pend),.tt ."
			    & "corpo>.vs :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .sr :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .rg :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .jr :is(.mk,.chi,.chip,.chp,circle,."
			    & "pend){animation:tqP1 0.34s ease-out}.tt .ls>:nth-child(1){animation:tqE2 0.28s ease-out}.tt .ls>:nth-child(1) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP2 0.38s ease-out}.t"
			    & "t .ls>:nth-child(2){animation:tqE3 0.32s ease-out}.tt .ls>:nth-child(2) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP3 0.42s ease-out}.tt .ls>:nth-child(3){animation:tqE4 0.3"
			    & "6s ease-out}.tt .ls>:nth-child(3) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP4 0.46s ease-out}.tt .ls>:nth-child(4){animation:tqE5 0.4s ease-out}.tt .ls>:nth-child(4) :is(."
			    & "mk,.chi,.chip,.chp,circle,.pend){animation:tqP5 0.5s ease-out}.tt .ls>:nth-child(5){animation:tqE6 0.44s ease-out}.tt .ls>:nth-child(5) :is(.mk,.chi,.chip,.chp,circle,.pend){animat"
			    & "ion:tqP6 0.54s ease-out}.tt .ls>:nth-child(6){animation:tqE7 0.48s ease-out}.tt .ls>:nth-child(6) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP7 0.58s ease-out}.tt .ls>:nth-c"
			    & "hild(7){animation:tqE8 0.52s ease-out}.tt .ls>:nth-child(7) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP8 0.62s ease-out}.tt .ls>:nth-child(8){animation:tqE9 0.56s ease-out}"
			    & ".tt .ls>:nth-child(8) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP9 0.66s ease-out}.tt .ls>:nth-child(9){animation:tqE10 0.6s ease-out}.tt .ls>:nth-child(9) :is(.mk,.chi,.ch"
