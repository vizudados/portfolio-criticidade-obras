	/// Obras mais novas que mal começaram: menos de 25% executado e início nos 12 meses antes do mês de referência, pelo início. Obras com aba no mês de referência, separadas por '|'.
	measure 'T3 · Linha do tempo · obras no começo (lista)' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@e] < 0.25 && [@ini] >= EDATE ( [Mês de referência], -12 ) ), dObra[Obra], "|", [@ini], ASC, dObra[Obra], ASC )
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: be6f525d-36d0-57e9-9a1d-41c08ecb9e3e

	/// Obras com 70% ou mais executado, atrás do cronograma e com término depois do mês de referência, pelo término. Obras com aba no mês de referência, separadas por '|'.
	measure 'T3 · Linha do tempo · obras perto do fim com atraso (lista)' =
			VAR _ref = [Mês de referência]
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@e] >= 0.70 && [@d] < 0 && [@fim] > _ref ), dObra[Obra], "|", [@fim], ASC, dObra[Obra], ASC )
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: b8a21d0b-d796-5beb-bca7-8b4d0156efe6

	/// 1 quando as obras com orçamento alvo são mais da metade das obras em andamento e há mais de duas (a frase 'na maioria' da leitura); 0 nos outros casos. Ex. ago/26: 0 de 6 em andamento → 0.
	measure 'T3 · Linha do tempo · orçamento alvo · na maioria' =
			VAR _q = [T3 · Linha do tempo · obras com orçamento alvo (quantidade)]
			VAR _n = [Obras com análise · ref] + 0
			RETURN
			    IF ( _q * 2 > _n && _n > 2, 1, 0 )
