	/// Início previsto da última obra a iniciar (out/26).
	measure 'T3 · Linha do tempo · último início a iniciar' =
			VAR _aIniciar =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@ini", [Obra · início],
			            "@tipo", [T3 · Obra · tipo de orçamento cronograma]
			        ),
			        REMOVEFILTERS ( dObra[Obra] ),
			        dObra[Situacao] = "A iniciar"
			    )
			RETURN
			    MAXX ( _aIniciar, [@ini] )
		formatString: dd/mm/yyyy
