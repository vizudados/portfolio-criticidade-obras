			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Cartões
		lineageTag: 5b3dd900-8c4b-5f49-ae63-2606349b8375

	/// CSS dos cartões da T5: o do cartão com flip comum mais a marca no começo do contexto.
	measure 'T5 · Cartões · CSS' =
			-- 4 · Marcação
			[Comum · CSS cartão]
			    & ".kc .ctx .mk{margin-right:6px;vertical-align:-1px}"
		displayFolder: T5 Canteiro\Cartões
		lineageTag: 16a95dcd-6e3e-5be0-8a61-9fa408469c40

	/// Primeiro mês com base complementar das obras do recorte no histórico do painel. Ex.: out/25.
	measure 'T5 · Acidentes · início do histórico' =
			CALCULATE ( MIN ( fBaseObra[Mes] ), REMOVEFILTERS ( dMes ) )
		formatString: dd/mm/yyyy
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: d9f6abe0-6302-52ef-9606-04dd6550f9b6

	/// Meses seguidos sem acidente com afastamento no recorte, contados depois do último mês com acidente até o de referência (a base é mensal: não dá o dia). Sem acidente no histórico, os meses do histórico até o de referência. Ex. set/26: 2 (ago e set, depois do de REDINHA em jul/26).
	measure 'T5 · Acidentes · meses sem acidente' =
			VAR _ref = [Mês de referência]
			VAR _ult = [T5 · Acidentes · último mês]
			VAR _ini = [T5 · Acidentes · início do histórico]
			RETURN
			    IF (
			        NOT ISBLANK ( _ref ) && NOT ISBLANK ( _ini ),
			        IF ( ISBLANK ( _ult ), DATEDIFF ( _ini, _ref, MONTH ) + 1, DATEDIFF ( _ult, _ref, MONTH ) )
			    )
		formatString: 0
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: 3196109c-f883-5ca6-b4cb-d98a6aa1a328

	/// Obras com acidente com afastamento no último mês com acidente, em ordem alfabética, separadas por '|'. Ex. set/26: REDINHA.
	measure 'T5 · Acidentes · obras do último (lista)' =
			VAR _ult = [T5 · Acidentes · último mês]
			RETURN
			    IF (
			        NOT ISBLANK ( _ult ),
			        CONCATENATEX (
			            FILTER (
			                VALUES ( dObra[Obra] ),
			                CALCULATE ( SUM ( fBaseObra[Acidentes] ), REMOVEFILTERS ( dMes ), fBaseObra[Mes] = _ult ) > 0
			            ),
			            dObra[Obra], "|", dObra[Obra], ASC
			        )
			    )
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: 8834f6d8-5f55-5e92-9816-f6f1f258e85b

	/// Último mês, até o de referência, com acidente com afastamento em alguma obra do recorte (todo o histórico da base). Vazio quando nenhum. Ex. set/26: jul/26 (REDINHA).
	measure 'T5 · Acidentes · último mês' =
			VAR _ref = [Mês de referência]
			RETURN
			    CALCULATE ( MAX ( fBaseObra[Mes] ), REMOVEFILTERS ( dMes ), fBaseObra[Mes] <= _ref, fBaseObra[Acidentes] > 0 )
		formatString: dd/mm/yyyy
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: 02a912c4-b8a6-5aaa-a887-9cee90c631e7

	/// Obras com [Canteiro · entregas no prazo] no mês de referência abaixo do ponto cheio da nota ([Nota · limite entregas · ponto cheio]); sem dado não conta. Ex. set/26: 3 (JANGADA, POTENGI e REDINHA).
	measure 'T5 · Entregas · obras abaixo da meta · ref' =
			VAR _lim = [Nota · limite entregas · ponto cheio]
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( dObra[Obra] ), VAR _x = [Canteiro · entregas no prazo · ref] RETURN NOT ISBLANK ( _x ) && _x < _lim ) ) + 0
		formatString: 0
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: a1eef286-869d-5161-9de6-033d7172717c

	/// Obras com [Canteiro · aprovação na 1.ª inspeção] no mês de referência abaixo do ponto cheio da nota ([Nota · limite inspeção · ponto cheio]); sem dado não conta. Ex. set/26: 3 (JANGADA, POTENGI e REDINHA).
	measure 'T5 · Inspeção · obras abaixo da meta · ref' =
			VAR _lim = [Nota · limite inspeção · ponto cheio]
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( dObra[Obra] ), VAR _x = [Canteiro · aprovação na 1.ª inspeção · ref] RETURN NOT ISBLANK ( _x ) && _x < _lim ) ) + 0
		formatString: 0
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: 3ec73caf-9354-5fb2-ad11-9c12af04a08c

	/// Obras com [Canteiro · conformidade NR-18] no mês de referência abaixo do ponto cheio da nota ([Nota · limite NR-18 · ponto cheio]); sem dado não conta. Ex. set/26: 3 (JANGADA, POTENGI e REDINHA).
	measure 'T5 · NR-18 · obras abaixo da meta · ref' =
			VAR _lim = [Nota · limite NR-18 · ponto cheio]
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( dObra[Obra] ), VAR _x = [Canteiro · conformidade NR-18 · ref] RETURN NOT ISBLANK ( _x ) && _x < _lim ) ) + 0
		formatString: 0
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: c662d10f-8506-568c-9cb1-40014ad73ea3

	/// Obras do recorte com base complementar no mês de referência. Ex. set/26: 7.
	measure 'T5 · Obras com base · ref' =
			VAR _ref = [Mês de referência]
			RETURN
			    CALCULATE ( DISTINCTCOUNT ( fBaseObra[Obra] ), REMOVEFILTERS ( dMes ), fBaseObra[Mes] = _ref ) + 0
		formatString: 0
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: 538020a1-3464-5aef-bb42-dfb5081f87c3

	/// Obras com taxa de frequência de 12 meses acima da média do setor ([Nota · limite acidentes · setor]) no mês de referência: as que zeram o item acidentes da nota. Ex. set/26: 2 (REDINHA 11,0 e POTENGI 8,0).
	measure 'T5 · Segurança · obras acima do setor · ref' =
			VAR _lim = [Nota · limite acidentes · setor]
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( dObra[Obra] ), [Canteiro · taxa de frequência (12 meses) · ref] > _lim ) ) + 0
		formatString: 0
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: ee6107de-d6e0-58ee-950e-4b049f6e76da

	/// Obras com algum acidente com afastamento nos 12 meses até o de referência. Ex. set/26: 3 (JANGADA, POTENGI e REDINHA).
	measure 'T5 · Segurança · obras com acidente em 12 meses · ref' =
			COUNTROWS ( FILTER ( VALUES ( dObra[Obra] ), [Canteiro · acidentes 12 meses · ref] > 0 ) ) + 0
		formatString: 0
		displayFolder: T5 Canteiro\Cartões\Contas
		lineageTag: 15d897d4-70d9-5299-a599-7527fe101db0

	/// CSS das colunas espelhadas de Chuva e ritmo (uma entrada por mês da janela).
	measure 'T5 · Chuva · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & "#htmlContent{display:flex!important;align-items:flex-start;width:100vw;height:100vh;margin:0!important;padding:0!important}.htmlViewerEntry{display:block!important;flex:1 1 0;min-w"
			    & "idth:0;margin:0!important;padding:0!important}.cr{position:relative;height:279px;transition:background .15s}.cr:hover,.htmlViewerEntry.hover .cr{background:rgba(233,224,207,.3)}.cr"
			    & " .b0{position:absolute;left:0;right:0;top:118px;height:1px;background:#E1E1E1}.cr .b1{position:absolute;left:0;right:0;top:145px;height:1px;background:#6B6B70}.cr .bc{position:abso"
			    & "lute;background:#E9E0CF}.cr .be{position:absolute;background:#0B0B0C}.cr .vl{position:absolute;left:0;right:0;text-align:center;font-family:'Barlow U','Segoe UI',sans-serif;font-we"
			    & "ight:600;font-size:14px;line-height:17px;white-space:nowrap;color:#0B0B0C}.cr .vl.c{color:#3B3B3F}.cr .ms{position:absolute;left:0;right:0;top:124px;text-align:center;font-size:13p"
			    & "x;line-height:16px;color:#3B3B3F;white-space:nowrap}.cr .ms.ref{font-weight:600;color:#0B0B0C}.cr .ms.sem{opacity:.35}"
		displayFolder: T5 Canteiro\Chuva e ritmo
		lineageTag: ac6e6648-df39-591b-b187-f2443a24d277

	/// Uma coluna por mês da janela (granularidade dMes[Mes]; coluna = 1068 ÷ n, barra = mín(44; 0,36 × coluna)): em cima, os dias impraticáveis por chuva (média por obra, creme) com o valor; no meio, o mês; embaixo, o executado no mês da carteira (preto, % do orçamento) com o valor. Escalas pelo maior mês da janela (T5 · Chuva · topo da escala e T5 · Ritmo · topo da escala). Mês de referência em semibold; o ano entra no primeiro mês e em janeiro quando a janela cruza a virada. As barras correm da linha do meio em cascata.
	measure 'T5 · Chuva · HTML coluna' =
			-- 1 · Leituras
			VAR _noRecorte = [Série · mês até a referência]
			VAR _ch = [Canteiro · dias de chuva]
			VAR _ex = [Físico · executado no mês]
			VAR _topoC = [T5 · Chuva · topo da escala]
			VAR _topoE = [T5 · Ritmo · topo da escala]
			VAR _mes = [Mês · abreviado]
			VAR _mesAno = [Mês · rótulo curto]
			VAR _data = [Mês · data]
			VAR _ehRef = [Série · é o mês de referência]
			VAR _pos = [Série · posição na janela]
			VAR _n = [Série · meses até a referência]
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			-- 2 · Textos
			VAR _tcN = IF ( _ch = INT ( _ch ), FORMAT ( _ch, "0", "pt-BR" ), FORMAT ( _ch, "0.0", "pt-BR" ) )
			VAR _tcTxt = IF ( ISBLANK ( _ch ), "—", _tcN )
			VAR _teN = FORMAT ( ABS ( _ex ) * 100, "0.0", "pt-BR" )
			VAR _teS = IF ( ROUND ( _ex * 100, 1 ) < 0, "−", "" )
			VAR _teTxt = IF ( ISBLANK ( _ex ), "—", _teS & _teN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tcKP = LEN ( _tcN ) > 0
			VAR _tcKN = IF ( _tcKP, _tcN )
			VAR _tcKS = SUBSTITUTE ( SUBSTITUTE ( _tcKN, ".", "" ), ",", "" )
			VAR _tcKT = IFERROR ( VALUE ( _tcKS ), -1 )
			VAR _tcKOk = _tcKP && _tcKT >= 2 && FORMAT ( _tcKT, REPT ( "0", LEN ( _tcKS ) ) ) = _tcKS
			VAR _tcKD = IF ( CONTAINSSTRING ( _tcKN, "," ), LEN ( _tcKN ) - SEARCH ( ",", _tcKN ), 0 )
			VAR _tcKM = IF ( CONTAINSSTRING ( _tcKN, "." ), "#,##0", "0" ) & IF ( _tcKD > 0, "." & REPT ( "0", _tcKD ) )
			VAR _tcKOd =
			    IF (
			        _tcKOk,
			        "<o-d><o-v>" & _tcKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcKN, FORMAT ( ROUND ( _tcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcKD ), _tcKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcN
			    )
			VAR _tcOd = IF ( ISBLANK ( _ch ), _tcTxt, _tcKOd )
			VAR _teKP = LEN ( _teN ) > 0
			VAR _teKN = IF ( _teKP, _teN )
			VAR _teKS = SUBSTITUTE ( SUBSTITUTE ( _teKN, ".", "" ), ",", "" )
			VAR _teKT = IFERROR ( VALUE ( _teKS ), -1 )
			VAR _teKOk = _teKP && _teKT >= 2 && FORMAT ( _teKT, REPT ( "0", LEN ( _teKS ) ) ) = _teKS
			VAR _teKD = IF ( CONTAINSSTRING ( _teKN, "," ), LEN ( _teKN ) - SEARCH ( ",", _teKN ), 0 )
			VAR _teKM = IF ( CONTAINSSTRING ( _teKN, "." ), "#,##0", "0" ) & IF ( _teKD > 0, "." & REPT ( "0", _teKD ) )
			VAR _teKOd =
			    IF (
			        _teKOk,
			        "<o-d><o-v>" & _teKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _teKN, FORMAT ( ROUND ( _teKT * [@odf] / 1000, 0 ) / POWER ( 10, _teKD ), _teKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _teN
			    )
			VAR _teOd = IF ( ISBLANK ( _ex ), _teTxt, _teS & _teKOd & "%" )
			VAR _cruza = YEAR ( _ini ) <> YEAR ( _ref )
			VAR _txtMes = _mes & IF ( _cruza && ( _pos = 1 || MONTH ( _data ) = 1 ), RIGHT ( _mesAno, 3 ), "" )
			VAR _clsMes = IF ( _ehRef = 1, " ref", "" ) & IF ( ISBLANK ( _ch ) && ISBLANK ( _ex ), " sem", "" )
			-- 3 · Geometria
			VAR _b = MIN ( 44, ROUND ( 0.36 * 1068 / _n, 0 ) ) -- geometria
			VAR _hC = IF ( _ch > 0, MAX ( 2, ROUND ( DIVIDE ( _ch, _topoC ) * 88, 0 ) ), 0 ) -- geometria
			VAR _hE = IF ( _ex > 0, MAX ( 2, ROUND ( DIVIDE ( _ex, _topoE ) * 100, 0 ) ), 0 ) -- geometria
			VAR _yC = 118 - _hC -- geometria
			VAR _atraso = ( _pos - 1 ) * 100 -- geometria
			-- 4 · Marcação
			VAR _htmlC =
			    IF (
			        NOT ISBLANK ( _ch ),
			        "<i class='bc' style='top:" & _yC & "px;height:" & _hC & "px;left:calc(50% - " & INT ( _b / 2 ) & "px);width:"
			            & _b & "px' data-rk='" & _mes & "|c' data-rp='top,height' data-r0-top='118px' "
			            & "data-r0-height='0px' data-rd='" & _atraso & "'></i>"
			            & "<span class='vl c a-fd' style='animation-delay:" & ( _atraso + 250 ) & "ms;top:" & ( _yC - 20 ) & "px'>" & _tcOd & "</span>"
			    )
			VAR _htmlE =
			    IF (
			        NOT ISBLANK ( _ex ),
			        "<i class='be' style='top:146px;height:" & _hE & "px;left:calc(50% - " & INT ( _b / 2 ) & "px);width:"
			            & _b & "px' data-rk='" & _mes & "|e' data-rp='height' data-r0-height='0px' data-rd='" & ( _atraso + 50 )
			            & "'></i>"
			            & "<span class='vl a-fd' style='animation-delay:" & ( _atraso + 300 ) & "ms;top:" & ( 146 + _hE + 4 ) & "px'>" & _teOd & "</span>"
			    )
			RETURN
			    IF (
			        _noRecorte = 1,
			        "<div class='u cr'><i class='b0 a-fd'></i><i class='b1 a-fd'></i>" & _htmlC & _htmlE
			            & "<p class='ms a-fd" & _clsMes & "' style='animation-delay:" & _atraso & "ms'>" & _txtMes & "</p>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
		displayFolder: T5 Canteiro\Chuva e ritmo
		lineageTag: 21fcffee-5823-530a-8b07-82be92eb9416

	/// Subtítulo de Chuva e ritmo: o que cada metade da coluna mostra.
	measure 'T5 · Chuva · HTML subtítulo' =
			-- 4 · Marcação
			"<p class='u hsb'><svg class='lg' width='12' height='12'><rect width='12' height='12' fill='#E9E0CF'/></svg>dias impraticáveis por chuva, média por obra (em cima)<span class='sep'>·"
			    & "</span><svg class='lg' width='12' height='12'><rect width='12' height='12' fill='#0B0B0C'/></svg>executado no mês da carteira, % do orçamento (embaixo)</p>"
		displayFolder: T5 Canteiro\Chuva e ritmo
		lineageTag: 22e8d144-e8a2-56c9-b645-1d7138100097

	/// Topo da escala dos dias impraticáveis por chuva (média por obra) na janela: o maior mês arredondado para cima de 2 em 2, no mínimo 10. Ex. set/26: 10 (abr/26, 9,6).
	measure 'T5 · Chuva · topo da escala' =
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _mx = MAXX ( ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			        "@v", [Canteiro · dias de chuva]
			    ), [@v] )
			RETURN
			    MAX ( 10, CEILING ( _mx, 2 ) )
		formatString: 0.00
		displayFolder: T5 Canteiro\Chuva e ritmo\Contas
		lineageTag: 8f88dbe1-0aa4-5962-8f92-9d7ff83af94c

	/// Topo da escala do executado no mês da carteira na janela: o maior mês arredondado para cima de 1 em 1 ponto, no mínimo 2%. Ex. set/26: 5% (set/26, 4,7%).
	measure 'T5 · Ritmo · topo da escala' =
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _mx = MAXX ( ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			        "@v", [Físico · executado no mês]
			    ), [@v] )
			RETURN
			    MAX ( 0.02, CEILING ( _mx, 0.01 ) )
		formatString: 0.00%
		displayFolder: T5 Canteiro\Chuva e ritmo\Contas
		lineageTag: 1b38e703-4986-5b87-9d19-a9baa49e18b8

	/// CSS dos subtítulos e dos nomes de coluna dos painéis da T5.
	measure 'T5 · Cabeçalho · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".hsb{position:fixed;inset:0;background:#FFFFFF;font-size:15px;line-height:22px;color:#3B3B3F;white-space:nowrap;overflow:hidden}.hsb .lg{display:inline-block;vertical-align:-1px;ma"
			    & "rgin:0 6px 0 0}.hsb .sep{margin:0 8px;color:#6B6B70}.obc{position:fixed;inset:0;background:#FFFFFF;white-space:nowrap}.obc .sub{position:absolute;left:0;top:0;font-size:15px;line-h"
			    & "eight:20px;color:#3B3B3F}.obc .vs{position:absolute;top:36px;font-size:12px;line-height:16px;letter-spacing:1px;text-transform:uppercase;color:#6B6B70}"
		displayFolder: T5 Canteiro\Comum
		lineageTag: a9927748-58ed-561f-b22c-6f55d8dec541

	/// Leitura do "?" de Chuva e ritmo, sobre o próprio painel (1068 × 347, completa em duas colunas): se a carteira executou menos nos meses de chuva (achado), o mês mais chuvoso e o ritmo dele (explicação), três destaques (o executado médio nos meses de chuva e nos outros e o do mês mais chuvoso) e, à direita, a quadra chuvosa de Natal e o que é dia impraticável. Só lê contas.
	measure 'T5 · Leitura chuva · HTML' =
			-- 1 · Leituras
			VAR _mesC = [Mês de referência · curto maiúsculo]
			VAR _nCh = [T5 · Leitura chuva · meses chuvosos] + 0
			VAR _nJan = [Série · meses até a referência]
			VAR _prim = [T5 · Leitura chuva · primeiro mês chuvoso]
			VAR _ult = [T5 · Leitura chuva · último mês chuvoso]
			VAR _exCh = [T5 · Leitura chuva · executado médio nos meses chuvosos]
			VAR _exOut = [T5 · Leitura chuva · executado médio nos outros meses]
			VAR _mMax = [T5 · Leitura chuva · mês mais chuvoso]
			VAR _dMax = [T5 · Leitura chuva · dias no mês mais chuvoso]
			VAR _exMax = [T5 · Leitura chuva · executado no mês mais chuvoso]
			VAR _exMin = [T5 · Leitura chuva · menor executado]
			VAR _lim = [T5 · Chuva · limite de mês chuvoso]
			-- 2 · Textos
			VAR _tchN = FORMAT ( ABS ( _exCh ) * 100, "0.0", "pt-BR" )
			VAR _tchS = IF ( ROUND ( _exCh * 100, 1 ) < 0, "−", "" )
			VAR _tchTxt = IF ( ISBLANK ( _exCh ), "—", _tchS & _tchN & "%" )
			VAR _touN = FORMAT ( ABS ( _exOut ) * 100, "0.0", "pt-BR" )
			VAR _touS = IF ( ROUND ( _exOut * 100, 1 ) < 0, "−", "" )
			VAR _touTxt = IF ( ISBLANK ( _exOut ), "—", _touS & _touN & "%" )
			VAR _tmxN = FORMAT ( ABS ( _exMax ) * 100, "0.0", "pt-BR" )
			VAR _tmxS = IF ( ROUND ( _exMax * 100, 1 ) < 0, "−", "" )
			VAR _tmxTxt = IF ( ISBLANK ( _exMax ), "—", _tmxS & _tmxN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tchKP = LEN ( _tchN ) > 0
			VAR _tchKN = IF ( _tchKP, _tchN )
			VAR _tchKS = SUBSTITUTE ( SUBSTITUTE ( _tchKN, ".", "" ), ",", "" )
			VAR _tchKT = IFERROR ( VALUE ( _tchKS ), -1 )
			VAR _tchKOk = _tchKP && _tchKT >= 2 && FORMAT ( _tchKT, REPT ( "0", LEN ( _tchKS ) ) ) = _tchKS
			VAR _tchKD = IF ( CONTAINSSTRING ( _tchKN, "," ), LEN ( _tchKN ) - SEARCH ( ",", _tchKN ), 0 )
			VAR _tchKM = IF ( CONTAINSSTRING ( _tchKN, "." ), "#,##0", "0" ) & IF ( _tchKD > 0, "." & REPT ( "0", _tchKD ) )
			VAR _tchKOd =
			    IF (
			        _tchKOk,
			        "<o-d><o-v>" & _tchKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tchKN, FORMAT ( ROUND ( _tchKT * [@odf] / 1000, 0 ) / POWER ( 10, _tchKD ), _tchKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tchN
			    )
			VAR _tchOd = IF ( ISBLANK ( _exCh ), _tchTxt, _tchS & _tchKOd & "%" )
			VAR _touKP = LEN ( _touN ) > 0
			VAR _touKN = IF ( _touKP, _touN )
			VAR _touKS = SUBSTITUTE ( SUBSTITUTE ( _touKN, ".", "" ), ",", "" )
			VAR _touKT = IFERROR ( VALUE ( _touKS ), -1 )
			VAR _touKOk = _touKP && _touKT >= 2 && FORMAT ( _touKT, REPT ( "0", LEN ( _touKS ) ) ) = _touKS
			VAR _touKD = IF ( CONTAINSSTRING ( _touKN, "," ), LEN ( _touKN ) - SEARCH ( ",", _touKN ), 0 )
			VAR _touKM = IF ( CONTAINSSTRING ( _touKN, "." ), "#,##0", "0" ) & IF ( _touKD > 0, "." & REPT ( "0", _touKD ) )
			VAR _touKOd =
			    IF (
			        _touKOk,
			        "<o-d><o-v>" & _touKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _touKN, FORMAT ( ROUND ( _touKT * [@odf] / 1000, 0 ) / POWER ( 10, _touKD ), _touKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _touN
			    )
			VAR _touOd = IF ( ISBLANK ( _exOut ), _touTxt, _touS & _touKOd & "%" )
			VAR _tmxKP = LEN ( _tmxN ) > 0
			VAR _tmxKN = IF ( _tmxKP, _tmxN )
			VAR _tmxKS = SUBSTITUTE ( SUBSTITUTE ( _tmxKN, ".", "" ), ",", "" )
			VAR _tmxKT = IFERROR ( VALUE ( _tmxKS ), -1 )
			VAR _tmxKOk = _tmxKP && _tmxKT >= 2 && FORMAT ( _tmxKT, REPT ( "0", LEN ( _tmxKS ) ) ) = _tmxKS
			VAR _tmxKD = IF ( CONTAINSSTRING ( _tmxKN, "," ), LEN ( _tmxKN ) - SEARCH ( ",", _tmxKN ), 0 )
			VAR _tmxKM = IF ( CONTAINSSTRING ( _tmxKN, "." ), "#,##0", "0" ) & IF ( _tmxKD > 0, "." & REPT ( "0", _tmxKD ) )
			VAR _tmxKOd =
			    IF (
			        _tmxKOk,
			        "<o-d><o-v>" & _tmxKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tmxKN, FORMAT ( ROUND ( _tmxKT * [@odf] / 1000, 0 ) / POWER ( 10, _tmxKD ), _tmxKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tmxN
			    )
			VAR _tmxOd = IF ( ISBLANK ( _exMax ), _tmxTxt, _tmxS & _tmxKOd & "%" )
			VAR _tdmN = IF ( _dMax = INT ( _dMax ), FORMAT ( _dMax, "0", "pt-BR" ), FORMAT ( _dMax, "0.0", "pt-BR" ) )
			VAR _tdmTxt = IF ( ISBLANK ( _dMax ), "—", _tdmN )
			VAR _nOut = _nJan - _nCh
			VAR _txtSob = "LEITURA · CHUVA E RITMO · " & _mesC
			VAR _txtPer = IF ( _prim = _ult, "No mês de chuva, " & FORMAT ( _prim, "mmmm", "pt-BR" ), "Nos meses de chuva, de " & FORMAT ( _prim, "mmmm", "pt-BR" ) & " a " & FORMAT ( _ult, "mmmm", "pt-BR" ))
			VAR _achado =
			    SWITCH (
			        TRUE (),
			        _nCh = 0, "Nenhum mês da janela teve " & "⁅" & _lim & "⁆" & " ou mais dias de chuva por obra.",
			        _nOut <= 0 || ISBLANK ( _exOut ), "Todos os meses da janela tiveram " & "⁅" & _lim & "⁆" & " ou mais dias de chuva por obra.",
			        _txtPer & ", a carteira executou " & IF ( _exCh < _exOut, "menos", "mais" ) & " que nos outros meses."
			    )
			VAR _explica =
			    IF (
			        ISBLANK ( _mMax ) || _dMax = 0,
			        "",
			        UPPER ( LEFT ( FORMAT ( _mMax, "mmmm", "pt-BR" ), 1 ) ) & MID ( FORMAT ( _mMax, "mmmm", "pt-BR" ), 2, LEN ( FORMAT ( _mMax, "mmmm", "pt-BR" ) ) ) & " foi o mês mais chuvoso, com " & "⁅" & _tdmTxt & "⁆" & " dias parados por obra"
			            & IF ( _exMax = _exMin, ", e teve o menor ritmo do período.", "." )
			    )
			VAR _txtD1 = "executado por mês " & IF ( _nCh = 1, "no mês de chuva", "nos " & "⁅" & _nCh & "⁆" & " meses de chuva" )
			VAR _txtD2 = IF ( _nOut = 1, "no outro mês", "nos outros " & "⁅" & _nOut & "⁆" & " meses" )
			VAR _txtD3 = "executado em " & FORMAT ( _mMax, "mmmm", "pt-BR" )
			VAR _txtOqe =
			    "A quadra chuvosa de Natal vai de março a julho, com pico em abril (normal do INMET para abril: " & "⁅" & "240,5" & "⁆" & " mm). "
			        & "Dia impraticável é o dia em que a chuva para o serviço externo; a base complementar registra quantos "
			        & "houve no mês em cada obra. Mês de chuva, aqui, é o que tem " & "⁅" & _lim & "⁆" & " ou mais por obra."
			-- 4 · Marcação
			VAR _esq =
			    "<div class='esq'><span class='vs sob'>" & _txtSob & "</span>"
			        & "<h2 class='ach'>" & _achado & "</h2>"
			        & IF ( _explica = "", "", "<p class='exp'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _explica, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" )
			        & "<div class='dst sobre-creme'>"
			        & IF ( _nCh > 0, "<div><b>" & _tchOd & "</b><span>" & _txtD1 & "</span></div>" )
			        & IF ( _nOut > 0 && NOT ISBLANK ( _exOut ), "<div><b>" & _touOd & "</b><span>" & _txtD2 & "</span></div>" )
			        & IF ( _nCh > 0, "<div><b>" & _tmxOd & "</b><span>" & _txtD3 & "</span></div>" )
			        & "</div>"
			    & "</div>"
			/* painel de 347: o 'como ler' curto vai para a coluna da direita, abaixo do 'o que explica' */
			VAR _dir =
			    "<div class='dir'>" & "<div class='sec'><span class='vs'>O que explica</span>" & "<p class='oqe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtOqe, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" & "</div>" & "<div class='sec'><span class='vs'>Como ler</span>" & "<p class='cl'>Passe o mouse num mês para ver a chuva e o executado de cada obra.</p>" & "</div>" & "</div>"
			VAR _corpo = "<div class='cols'>" & _esq & "<i class='div'></i>" & _dir & "</div>"
			VAR _saidaHtml =
			    IF ( _nJan > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura de Chuva e ritmo" & "'><div class='pn pn-2c'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Leituras
		lineageTag: 2abebd7c-f786-5d5d-852d-7e5b3143c954

	/// Leitura do "?" de Qualidade, mês a mês, sobre o próprio painel (1068 × 380, completa em duas colunas): a aprovação da carteira no mês contra a meta (achado), as obras abaixo da meta e há quantos meses a menor está abaixo (explicação), dois destaques (a menor obra e os meses da carteira na meta) e, à direita, a aprovação de cada obra no mês e o que o indicador mede. Só lê contas.
	measure 'T5 · Leitura qualidade · HTML' =
			-- 1 · Leituras
			VAR _mesN = [Mês de referência · nome]
			VAR _mesC = [Mês de referência · curto maiúsculo]
			VAR _c = [Canteiro · aprovação na 1.ª inspeção · ref]
			VAR _lim = [Nota · limite inspeção · ponto cheio]
			VAR _lAbx = [T5 · Leitura qualidade · obras abaixo da meta (lista) · ref]
			VAR _dest = [T5 · Qualidade · obra em destaque · ref]
			VAR _vDest = [T5 · Leitura qualidade · aprovação da obra em destaque · ref]
			VAR _mDest = [T5 · Leitura qualidade · meses da obra em destaque abaixo da meta] + 0
			VAR _nMeta = [T5 · Leitura qualidade · meses da carteira na meta] + 0
			VAR _nMeses = [T5 · Leitura qualidade · meses com base] + 0
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@v", [Canteiro · aprovação na 1.ª inspeção · ref],
			        "@pt", [Nota · pontos inspeção · ref],
			        "@ps", [Nota · possíveis · inspeção · ref]
			    )
			VAR _det = FILTER ( _obras, NOT ISBLANK ( [@v] ) ) /* lista */
			-- 2 · Textos
			VAR _tcN = FORMAT ( ABS ( _c ) * 100, "0.0", "pt-BR" )
			VAR _tcS = IF ( ROUND ( _c * 100, 1 ) < 0, "−", "" )
			VAR _tcTxt = IF ( ISBLANK ( _c ), "—", _tcS & _tcN & "%" )
			VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
			VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
			VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
			VAR _tdN = FORMAT ( ABS ( _vDest ) * 100, "0.0", "pt-BR" )
			VAR _tdS = IF ( ROUND ( _vDest * 100, 1 ) < 0, "−", "" )
			VAR _tdTxt = IF ( ISBLANK ( _vDest ), "—", _tdS & _tdN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tdKP = LEN ( _tdN ) > 0
			VAR _tdKN = IF ( _tdKP, _tdN )
			VAR _tdKS = SUBSTITUTE ( SUBSTITUTE ( _tdKN, ".", "" ), ",", "" )
			VAR _tdKT = IFERROR ( VALUE ( _tdKS ), -1 )
			VAR _tdKOk = _tdKP && _tdKT >= 2 && FORMAT ( _tdKT, REPT ( "0", LEN ( _tdKS ) ) ) = _tdKS
			VAR _tdKD = IF ( CONTAINSSTRING ( _tdKN, "," ), LEN ( _tdKN ) - SEARCH ( ",", _tdKN ), 0 )
			VAR _tdKM = IF ( CONTAINSSTRING ( _tdKN, "." ), "#,##0", "0" ) & IF ( _tdKD > 0, "." & REPT ( "0", _tdKD ) )
			VAR _tdKOd =
			    IF (
			        _tdKOk,
			        "<o-d><o-v>" & _tdKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdKN, FORMAT ( ROUND ( _tdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdKD ), _tdKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdN
			    )
			VAR _tdOd = IF ( ISBLANK ( _vDest ), _tdTxt, _tdS & _tdKOd & "%" )
			VAR _txtSob = "LEITURA · QUALIDADE, MÊS A MÊS · " & _mesC
			VAR _achado =
			    "A carteira aprovou " & "⁅" & _tcTxt & "⁆" & " dos serviços na primeira inspeção em " & _mesN
			        & IF ( _c >= _lim, ", na meta de ", ", abaixo da meta de " ) & "⁅" & _tlTxt & "⁆" & "."
			VAR _laN = IF ( ISBLANK ( _lAbx ) || _lAbx = "", 0, PATHLENGTH ( _lAbx ) )
			VAR _laPos = IF ( _laN >= 2, FIND ( "§", SUBSTITUTE ( _lAbx, "|", "§", _laN - 1 ) ) )
			VAR _laTxt = SWITCH ( TRUE (), _laN = 0, "", _laN = 1, _lAbx, SUBSTITUTE ( LEFT ( _lAbx, _laPos - 1 ), "|", ", " ) & " e " & MID ( _lAbx, _laPos + 1, 999 ) )
			VAR _txtAbx =
			    SWITCH (
			        TRUE (),
			        _laN = 0, "Nenhuma obra ficou abaixo da meta no mês.",
			        _laN = 1, "Só " & _laTxt & " ficou abaixo da meta no mês.",
			        UPPER ( LEFT ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ), 1 ) ) & MID ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ), 2, LEN ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ) ) ) & " obras ficaram abaixo da meta: " & _laTxt & "."
			    )
			VAR _txtDest =
			    IF (
			        _laN = 0 || ISBLANK ( _dest ),
			        "",
			        " A menor do mês, " & _dest & ", ficou " & IF ( _mDest = _nMeses, "abaixo em todos os " & "⁅" & _nMeses & "⁆" & " meses da janela.", "abaixo em " & "⁅" & _mDest & "⁆" & " dos " & "⁅" & _nMeses & "⁆" & " meses da janela." )
			    )
			VAR _explica = _txtAbx & _txtDest
			VAR _txtD1 = IF ( ISBLANK ( _dest ), "", _dest & ", a menor do mês" )
			VAR _txtD2 = IF ( _nMeta = 1, "mês da carteira na meta", "meses da carteira na meta" ) & " na janela"
			VAR _txtOqe =
			    "Serviço reprovado na primeira inspeção (FVS) volta para ser refeito: é retrabalho, que pesa no custo e no "
			        & "prazo. Na nota, o ponto cheio do item começa em " & "⁅" & _tlTxt & "⁆" & "."
			-- 4 · Marcação
			VAR _htmlDet =
			    CONCATENATEX (
			        _det,
			        VAR _cls = IF ( ISBLANK ( [@pt] ), "", IF ( [@pt] >= [@ps], "0", IF ( [@pt] = 0, "2", "1" ) ) )
			        VAR _d = 300 + ( RANKX ( _det, [@v], , ASC, Dense ) - 1 ) * 60 -- geometria
			        RETURN
			            "<div class='r a-fd' style='animation-delay:" & _d & "ms'><b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dObra[Obra], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</b><span>" & IF ( _cls = "", "", "<i class='mk a-pop mk" & _cls & "' style='animation-delay:" & ( _d + 100 ) & "ms'></i>" ) & "⁅" & FORMAT ( [@v] * 100, "0.0", "pt-BR" ) & "⁆" & "%</span></div>",
			        "",
			        [@v], ASC, dObra[Obra], ASC
			    )
			VAR _esq =
			    "<div class='esq'><span class='vs sob'>" & _txtSob & "</span>"
			        & "<h2 class='ach'>" & _achado & "</h2>"
			        & "<p class='exp'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _explica, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>"
			        & "<div class='dst sobre-creme'>"
			        & IF ( ISBLANK ( _dest ), "", "<div><b>" & _tdOd & "</b><span>" & _txtD1 & "</span></div>" )
			        & "<div><b>" & "⁅" & _nMeta & "⁆" & " de " & "⁅" & _nMeses & "⁆" & "</b><span>" & _txtD2 & "</span></div>"
			        & "</div>"
			        & "<div class='sec'><span class='vs'>Como ler</span>" & "<p class='cl'>Cada linha fina é uma obra; a preta é a carteira (aprovados ÷ verificados, com as obras somadas) e a grafite, a obra com a menor aprovação no mês. O tracejado é a meta.</p>" & "</div>"
			    & "</div>"
			VAR _dir =
			    "<div class='dir'><span class='vs'>Detalhe</span>"
			        & "<p class='sub'>aprovação na 1.ª inspeção em " & _mesN & ", da menor para a maior</p>"
			        & "<div class='dl'>" & _htmlDet & "</div>"
			        & "<div class='sec'><span class='vs'>O que explica</span>" & "<p class='oqe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtOqe, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" & "</div>"
			    & "</div>"
			VAR _corpo = "<div class='cols'>" & _esq & "<i class='div'></i>" & _dir & "</div>"
			VAR _saidaHtml =
			    IF ( NOT ISBLANK ( _c ), "<div class='u lv' role='dialog' aria-label='" & "Leitura de Qualidade, mês a mês" & "'><div class='pn pn-2c'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Leituras
		lineageTag: 9b8c7fa6-0cbe-5751-844a-f2ce70344271

	/// Leitura do "?" de Segurança por obra, sobre o próprio painel (400 × 380, condensada): quantas obras tiveram acidente com afastamento em 12 meses e quais passam da média do setor (achado), as obras abaixo da meta no checklist NR-18 do mês (explicação) e dois destaques (a taxa de frequência da carteira e a conformidade NR-18 da carteira). Só lê contas.
	measure 'T5 · Leitura segurança · HTML' =
			-- 1 · Leituras
			VAR _mesN = [Mês de referência · nome]
			VAR _mesC = [Mês de referência · curto maiúsculo]
			VAR _n = [T5 · Obras com base · ref]
			VAR _nAc = [T5 · Segurança · obras com acidente em 12 meses · ref]
			VAR _lAcima = [T5 · Leitura segurança · obras acima do setor (lista) · ref]
			VAR _lNr = [T5 · Leitura segurança · obras abaixo da meta (lista) · ref]
			VAR _tf = [Canteiro · taxa de frequência (12 meses) · ref]
			VAR _nr = [Canteiro · conformidade NR-18 · ref]
			VAR _limNr = [Nota · limite NR-18 · ponto cheio]
			-- 2 · Textos
			VAR _ttfN = IF ( _tf = INT ( _tf ), FORMAT ( _tf, "0", "pt-BR" ), FORMAT ( _tf, "0.0", "pt-BR" ) )
			VAR _ttfTxt = IF ( ISBLANK ( _tf ), "—", _ttfN )
			VAR _tnrN = FORMAT ( ABS ( _nr ) * 100, "0.0", "pt-BR" )
			VAR _tnrS = IF ( ROUND ( _nr * 100, 1 ) < 0, "−", "" )
			VAR _tnrTxt = IF ( ISBLANK ( _nr ), "—", _tnrS & _tnrN & "%" )
			VAR _tlN = FORMAT ( ABS ( _limNr ) * 100, "0", "pt-BR" )
			VAR _tlS = IF ( ROUND ( _limNr * 100, 0 ) < 0, "−", "" )
			VAR _tlTxt = IF ( ISBLANK ( _limNr ), "—", _tlS & _tlN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _ttfKP = LEN ( _ttfN ) > 0
			VAR _ttfKN = IF ( _ttfKP, _ttfN )
			VAR _ttfKS = SUBSTITUTE ( SUBSTITUTE ( _ttfKN, ".", "" ), ",", "" )
			VAR _ttfKT = IFERROR ( VALUE ( _ttfKS ), -1 )
			VAR _ttfKOk = _ttfKP && _ttfKT >= 2 && FORMAT ( _ttfKT, REPT ( "0", LEN ( _ttfKS ) ) ) = _ttfKS
			VAR _ttfKD = IF ( CONTAINSSTRING ( _ttfKN, "," ), LEN ( _ttfKN ) - SEARCH ( ",", _ttfKN ), 0 )
			VAR _ttfKM = IF ( CONTAINSSTRING ( _ttfKN, "." ), "#,##0", "0" ) & IF ( _ttfKD > 0, "." & REPT ( "0", _ttfKD ) )
			VAR _ttfKOd =
			    IF (
			        _ttfKOk,
			        "<o-d><o-v>" & _ttfKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _ttfKN, FORMAT ( ROUND ( _ttfKT * [@odf] / 1000, 0 ) / POWER ( 10, _ttfKD ), _ttfKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _ttfN
			    )
			VAR _ttfOd = IF ( ISBLANK ( _tf ), _ttfTxt, _ttfKOd )
			VAR _tnrKP = LEN ( _tnrN ) > 0
			VAR _tnrKN = IF ( _tnrKP, _tnrN )
			VAR _tnrKS = SUBSTITUTE ( SUBSTITUTE ( _tnrKN, ".", "" ), ",", "" )
			VAR _tnrKT = IFERROR ( VALUE ( _tnrKS ), -1 )
			VAR _tnrKOk = _tnrKP && _tnrKT >= 2 && FORMAT ( _tnrKT, REPT ( "0", LEN ( _tnrKS ) ) ) = _tnrKS
			VAR _tnrKD = IF ( CONTAINSSTRING ( _tnrKN, "," ), LEN ( _tnrKN ) - SEARCH ( ",", _tnrKN ), 0 )
			VAR _tnrKM = IF ( CONTAINSSTRING ( _tnrKN, "." ), "#,##0", "0" ) & IF ( _tnrKD > 0, "." & REPT ( "0", _tnrKD ) )
			VAR _tnrKOd =
			    IF (
			        _tnrKOk,
			        "<o-d><o-v>" & _tnrKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tnrKN, FORMAT ( ROUND ( _tnrKT * [@odf] / 1000, 0 ) / POWER ( 10, _tnrKD ), _tnrKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tnrN
			    )
			VAR _tnrOd = IF ( ISBLANK ( _nr ), _tnrTxt, _tnrS & _tnrKOd & "%" )
			VAR _laN = IF ( ISBLANK ( _lAcima ) || _lAcima = "", 0, PATHLENGTH ( _lAcima ) )
			VAR _laPos = IF ( _laN >= 2, FIND ( "§", SUBSTITUTE ( _lAcima, "|", "§", _laN - 1 ) ) )
			VAR _laTxt = SWITCH ( TRUE (), _laN = 0, "", _laN = 1, _lAcima, SUBSTITUTE ( LEFT ( _lAcima, _laPos - 1 ), "|", ", " ) & " e " & MID ( _lAcima, _laPos + 1, 999 ) )
			VAR _lnN = IF ( ISBLANK ( _lNr ) || _lNr = "", 0, PATHLENGTH ( _lNr ) )
			VAR _lnPos = IF ( _lnN >= 2, FIND ( "§", SUBSTITUTE ( _lNr, "|", "§", _lnN - 1 ) ) )
			VAR _lnTxt = SWITCH ( TRUE (), _lnN = 0, "", _lnN = 1, _lNr, SUBSTITUTE ( LEFT ( _lNr, _lnPos - 1 ), "|", ", " ) & " e " & MID ( _lNr, _lnPos + 1, 999 ) )
			VAR _txtSob = "LEITURA · SEGURANÇA · " & _mesC
			VAR _txtAc =
			    SWITCH (
			        TRUE (),
			        _nAc = 0, "Nenhuma das " & SWITCH ( _n, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " obras teve acidente com afastamento em 12 meses",
			        _nAc = 1, "Uma das " & SWITCH ( _n, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " obras teve acidente com afastamento em 12 meses",
			        UPPER ( LEFT ( SWITCH ( _nAc, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAc, "0" ) ), 1 ) ) & MID ( SWITCH ( _nAc, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAc, "0" ) ), 2, LEN ( SWITCH ( _nAc, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAc, "0" ) ) ) ) & " das " & SWITCH ( _n, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " obras tiveram acidente com afastamento em 12 meses"
			    )
			VAR _achado =
			    _txtAc & SWITCH (
			        TRUE (),
			        _nAc = 0, ".",
			        _laN = 0, IF ( _nAc = 1, ", dentro da média do setor.", ", todas dentro da média do setor." ),
			        "; " & _laTxt & IF ( _laN = 1, " passa", " passam" ) & " da média do setor."
			    )
			VAR _explica =
			    IF (
			        _lnN = 0,
			        "No checklist NR-18 de " & _mesN & ", todas as obras ficaram com " & "⁅" & _tlTxt & "⁆" & " ou mais.",
			        "No checklist NR-18 de " & _mesN & ", " & _lnTxt & IF ( _lnN = 1, " ficou", " ficaram" ) & " abaixo de " & "⁅" & _tlTxt & "⁆" & "."
			    )
			-- 4 · Marcação
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _achado & "</h2>"
			        & "<p class='exp'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _explica, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>"
			        & "<div class='dst sobre-creme'>"
			        & "<div><b>" & _ttfOd & "</b><span>" & "acidentes por milhão de HHT na carteira" & "</span></div>"
			        & "<div><b>" & _tnrOd & "</b><span>" & "da NR-18 conforme na carteira" & "</span></div>"
			        & "</div>"
			VAR _saidaHtml =
			    IF ( _n > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura de Segurança por obra" & "'><div class='pn pn-t4p pn-t5p'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Leituras
		lineageTag: d54a789c-bbf1-5600-afd1-d43d70e982b3

	/// Leitura do "?" de Suprimentos por obra, sobre o próprio painel (400 × 347, condensada): quantas obras receberam menos que a meta de pedidos no prazo e completos e quais (achado), os pedidos da carteira (explicação) e dois destaques (a taxa da carteira e a da pior obra). Só lê contas.
	measure 'T5 · Leitura suprimentos · HTML' =
			-- 1 · Leituras
			VAR _mesN = [Mês de referência · nome]
			VAR _mesC = [Mês de referência · curto maiúsculo]
			VAR _n = [T5 · Obras com base · ref]
			VAR _lAbx = [T5 · Leitura suprimentos · obras abaixo da meta (lista) · ref]
			VAR _np = [Canteiro · pedidos no prazo · ref] + 0
			VAR _pp = [Canteiro · pedidos previstos · ref] + 0
			VAR _x = [Canteiro · entregas no prazo · ref]
			VAR _pior = [T5 · Leitura suprimentos · pior obra · ref]
			VAR _xPior = [T5 · Leitura suprimentos · pior entrega · ref]
			VAR _lim = [Nota · limite entregas · ponto cheio]
			-- 2 · Textos
			VAR _txN = FORMAT ( ABS ( _x ) * 100, "0.0", "pt-BR" )
			VAR _txS = IF ( ROUND ( _x * 100, 1 ) < 0, "−", "" )
			VAR _txTxt = IF ( ISBLANK ( _x ), "—", _txS & _txN & "%" )
			VAR _tpN = FORMAT ( ABS ( _xPior ) * 100, "0.0", "pt-BR" )
			VAR _tpS = IF ( ROUND ( _xPior * 100, 1 ) < 0, "−", "" )
			VAR _tpTxt = IF ( ISBLANK ( _xPior ), "—", _tpS & _tpN & "%" )
			VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
			VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
			VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _txKP = LEN ( _txN ) > 0
			VAR _txKN = IF ( _txKP, _txN )
			VAR _txKS = SUBSTITUTE ( SUBSTITUTE ( _txKN, ".", "" ), ",", "" )
			VAR _txKT = IFERROR ( VALUE ( _txKS ), -1 )
			VAR _txKOk = _txKP && _txKT >= 2 && FORMAT ( _txKT, REPT ( "0", LEN ( _txKS ) ) ) = _txKS
			VAR _txKD = IF ( CONTAINSSTRING ( _txKN, "," ), LEN ( _txKN ) - SEARCH ( ",", _txKN ), 0 )
			VAR _txKM = IF ( CONTAINSSTRING ( _txKN, "." ), "#,##0", "0" ) & IF ( _txKD > 0, "." & REPT ( "0", _txKD ) )
			VAR _txKOd =
			    IF (
			        _txKOk,
			        "<o-d><o-v>" & _txKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _txKN, FORMAT ( ROUND ( _txKT * [@odf] / 1000, 0 ) / POWER ( 10, _txKD ), _txKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _txN
			    )
			VAR _txOd = IF ( ISBLANK ( _x ), _txTxt, _txS & _txKOd & "%" )
			VAR _tpKP = LEN ( _tpN ) > 0
			VAR _tpKN = IF ( _tpKP, _tpN )
			VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
			VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
			VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
			VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
			VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
			VAR _tpKOd =
			    IF (
			        _tpKOk,
			        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpN
			    )
			VAR _tpOd = IF ( ISBLANK ( _xPior ), _tpTxt, _tpS & _tpKOd & "%" )
			VAR _laN = IF ( ISBLANK ( _lAbx ) || _lAbx = "", 0, PATHLENGTH ( _lAbx ) )
			VAR _laPos = IF ( _laN >= 2, FIND ( "§", SUBSTITUTE ( _lAbx, "|", "§", _laN - 1 ) ) )
			VAR _laTxt = SWITCH ( TRUE (), _laN = 0, "", _laN = 1, _lAbx, SUBSTITUTE ( LEFT ( _lAbx, _laPos - 1 ), "|", ", " ) & " e " & MID ( _lAbx, _laPos + 1, 999 ) )
			VAR _txtSob = "LEITURA · SUPRIMENTOS · " & _mesC
			VAR _achado =
			    SWITCH (
			        TRUE (),
			        _laN = 0, "Todas as " & SWITCH ( _n, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " obras receberam pelo menos " & "⁅" & _tlTxt & "⁆" & " dos pedidos no prazo e "
			            & "completos em " & _mesN & ".",
			        _laN = 1, "Só " & _laTxt & " recebeu menos de " & "⁅" & _tlTxt & "⁆" & " dos pedidos no prazo e completos em " & _mesN & ".",
			        UPPER ( LEFT ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ), 1 ) ) & MID ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ), 2, LEN ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ) ) ) & " obras receberam menos de " & "⁅" & _tlTxt & "⁆" & " dos pedidos no prazo e completos: " & _laTxt & "."
			    )
			VAR _explica = "Na carteira, " & "⁅" & _np & "⁆" & " de " & "⁅" & _pp & "⁆" & IF ( _pp = 1, " pedido chegou", " pedidos chegaram" ) & " no prazo e completos."
			VAR _txtD2 = IF ( ISBLANK ( _pior ), "", "na " & _pior & ", a menor do mês" )
			-- 4 · Marcação
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _achado, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</h2>"
			        & "<p class='exp'>" & _explica & "</p>"
			        & "<div class='dst sobre-creme'>"
			        & "<div><b>" & _txOd & "</b><span>" & "da carteira no prazo e completos" & "</span></div>"
			        & IF ( ISBLANK ( _pior ), "", "<div><b>" & _tpOd & "</b><span>" & _txtD2 & "</span></div>" )
			        & "</div>"
			VAR _saidaHtml =
			    IF ( _pp > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura de Suprimentos por obra" & "'><div class='pn pn-t4p pn-t5p'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Leituras
		lineageTag: 300c086f-56d3-5a60-b2a9-575633fddb98

	/// CSS das leituras do "?" da Tela 05: a superfície, a completa em duas colunas e a condensada da T4 (leituras_t4.CSS_LEI), o sobretítulo numa linha das condensadas e a lista do detalhe.
	measure 'T5 · Leitura · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".lv{position:fixed;inset:0}.lv .pn{position:absolute;inset:0;background:#FFFFFF;border:1px solid #0B0B0C;border-radius:16px;overflow:hidden;color:#0B0B0C}.lv .sob{display:block;pad"
			    & "ding-right:44px}.lv .ach{margin-top:7px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:23px;line-height:28px}.lv .exp{margin-top:10px;font-size:17px;line-he"
			    & "ight:26px}.lv .dst{margin-top:12px;display:flex;gap:12px;padding:12px;background:#E9E0CF}.lv .dst>div{flex:1 1 0;min-width:0}.lv .dst>div:empty{display:none}.lv .dst b{display:bloc"
