	/// Obras com [Canteiro · entregas no prazo] no mês de referência abaixo do ponto cheio da nota, da menor para a maior. Ex. set/26: POTENGI|REDINHA|JANGADA.
	measure 'T5 · Leitura suprimentos · obras abaixo da meta (lista) · ref' =
			CONCATENATEX (
			    FILTER ( VALUES ( dObra[Obra] ), VAR _x = [Canteiro · entregas no prazo · ref] RETURN NOT ISBLANK ( _x ) && _x < [Nota · limite entregas · ponto cheio] ),
			    dObra[Obra], "|", [Canteiro · entregas no prazo · ref], ASC, dObra[Obra], ASC
			)
		displayFolder: T5 Canteiro\Leituras\Contas
		lineageTag: 743acad3-bc2a-5872-9208-b74406c89c5e

	/// Entregas no prazo e completas da pior obra no mês de referência. Ex. set/26: 76,9% (POTENGI, 20 de 26).
	measure 'T5 · Leitura suprimentos · pior entrega · ref' =
			VAR _obra = [T5 · Leitura suprimentos · pior obra · ref]
			RETURN
			    IF ( NOT ISBLANK ( _obra ), CALCULATE ( [Canteiro · entregas no prazo · ref], dObra[Obra] = _obra ) )
