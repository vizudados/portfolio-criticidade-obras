	/// Como o executado do mês andou: cresce (nunca cai), cai (nunca sobe) ou oscila. Pares de meses seguidos dentro da janela; obra do contexto.
	measure 'T3 · Ritmo · tendência do executado' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@v", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · executado no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@a", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · executado no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = EDATE ( _m, -1 ) )
			    )
			VAR _pares = FILTER ( _meses, dMes[Mes] > _jan && NOT ISBLANK ( [@v] ) && NOT ISBLANK ( [@a] ) )
			VAR _sobe = COUNTROWS ( FILTER ( _pares, ROUND ( [@v] - [@a], 6 ) > 0 ) ) + 0
			VAR _desce = COUNTROWS ( FILTER ( _pares, ROUND ( [@v] - [@a], 6 ) < 0 ) ) + 0
			RETURN
			    IF (
			        COUNTROWS ( _pares ) > 0,
			        SWITCH (
			            TRUE (),
			            _sobe > 0 && _desce = 0, "cresce",
			            _desce > 0 && _sobe = 0, "cai",
			            _sobe = 0 && _desce = 0, "constante",
			            "oscila"
			        )
			    )
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 4a2f5699-a2df-5e91-a1ca-0167fb20e1c3

	/// [T3 · Ritmo · tendência do executado] da obra em foco.
	measure 'T3 · Ritmo · tendência do executado · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Ritmo · tendência do executado], dObra[Obra] = _obra )
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 908dba55-befb-510c-9bf8-0665ba4bac6c

	/// O que o cronograma pede mês a mês: acelera (o previsto do mês nunca cai e sobe ao menos uma vez), desacelera, constante ou varia. Pares de meses seguidos dentro da janela; obra do contexto.
	measure 'T3 · Ritmo · tendência do previsto' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@v", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · previsto no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@a", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · previsto no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = EDATE ( _m, -1 ) )
			    )
			VAR _pares = FILTER ( _meses, dMes[Mes] > _jan && NOT ISBLANK ( [@v] ) && NOT ISBLANK ( [@a] ) )
			VAR _sobe = COUNTROWS ( FILTER ( _pares, ROUND ( [@v] - [@a], 6 ) > 0 ) ) + 0
			VAR _desce = COUNTROWS ( FILTER ( _pares, ROUND ( [@v] - [@a], 6 ) < 0 ) ) + 0
			RETURN
			    IF (
			        COUNTROWS ( _pares ) > 0,
			        SWITCH (
			            TRUE (),
			            _sobe > 0 && _desce = 0, "acelera",
			            _desce > 0 && _sobe = 0, "desacelera",
			            _sobe = 0 && _desce = 0, "constante",
			            "varia"
			        )
			    )
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 805fcc65-7030-54f0-a3bf-bf4da04ca5fe

	/// [T3 · Ritmo · tendência do previsto] da obra em foco.
	measure 'T3 · Ritmo · tendência do previsto · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Ritmo · tendência do previsto], dObra[Obra] = _obra )
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 6b2732d8-b644-58e8-805e-7eabe5b6848a

	/// Primeiro mês da sequência, terminada na referência e dentro da janela, em que a obra ficou no status da nota de hoje ('crítica desde abril'); o mês pendente conta como um estado à parte, então passar de pendente a crítico abre uma sequência nova. Uma obra no contexto.
	measure 'T3 · Status · início da sequência' =
			VAR _ref = [Mês de referência]
			VAR _hoje = CALCULATE ( IF ( [Nota · pendente · um mês] = 1, -1, [Nota · status · um mês] ), REMOVEFILTERS ( dMes ), dMes[Mes] = _ref )
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@s", VAR _m = dMes[Mes] RETURN CALCULATE ( IF ( [Nota · pendente · um mês] = 1, -1, [Nota · status · um mês] ), REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@s] ) )
			VAR _quebra = MAXX ( FILTER ( _com, [@s] <> _hoje ), dMes[Mes] )
			VAR _inicio = MINX ( FILTER ( _com, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] )
			RETURN
			    IF ( NOT ISBLANK ( _hoje ), _inicio )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 3302c3ac-ccb0-55fc-b755-c7a41197d945

