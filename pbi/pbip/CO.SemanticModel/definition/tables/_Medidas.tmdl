	/// Nomes das obras do recorte no mês de referência, em ordem alfabética, separados por vírgula.
	measure 'Recorte · obras (lista)' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE (
			        CONCATENATEX ( VALUES ( fAnaliseCritica[Obra] ), fAnaliseCritica[Obra], ", ", fAnaliseCritica[Obra], ASC ),
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] = _mes
			    )
		displayFolder: Base\Recorte
		lineageTag: 2ba6554f-eb09-529e-af4a-2c1b4e492a16

