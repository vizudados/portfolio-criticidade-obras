	/// Primeiro mês da série (na janela) com o maior % executado no mês (o melhor mês).
	measure 'T3 · Série · mês de maior executado' =
			VAR _ref = [Mês de referência]
			VAR _alvo = [T3 · Série · executado no mês · máximo]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@v", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · executado no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			RETURN
			    MINX ( FILTER ( _meses, NOT ISBLANK ( [@v] ) && [@v] = _alvo ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: d66fb265-d9d9-5a30-84ae-a81eabb7b04d

	/// [T3 · Série · mês de maior executado] da obra em foco.
	measure 'T3 · Série · mês de maior executado · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Série · mês de maior executado], dObra[Obra] = _obra )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: c94aea8f-01e6-5afb-b6d0-572fc6a140e4

