		lineageTag: cb19f1e4-837e-531d-a935-a26bfcabd113

	/// 1 quando há aba da Análise Crítica ou da base complementar no contexto (obra × mês); vazio sem nenhuma.
	measure 'Nota · obra presente' =
			IF ( NOT ISEMPTY ( fAnaliseCritica ) || NOT ISEMPTY ( fBaseObra ), 1 )
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: c79fbb91-a14c-529e-a3c6-3a94e342f490

	/// 1 quando a obra está no contexto e falta algum item (sem nota nem status); 0 quando completa. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · pendente' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    IF ( [Nota · obra presente] = 1, IF ( [Nota · completa] = 1, 0, 1 ) )
			)
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 971fc201-f3ca-5f81-8951-a5a6bef3cf4a

	/// [Nota · pendente] lido de dRankingNota quando há uma obra e um mês no contexto e a obra tem dado no mês; senão, a própria [Nota · pendente]. Mesmo valor, mais rápido nas listas que iteram obras × meses.
	measure 'Nota · pendente · ranking' =
			VAR _o = SELECTEDVALUE ( dObra[Obra] )
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _m )
			RETURN
			    IF (
			        NOT ISBLANK ( _o ) && NOT ISBLANK ( _m ) && NOT ISEMPTY ( _linha ),
			        MAXX ( _linha, dRankingNota[Pendente] ),
			        [Nota · pendente]
			    )
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 49ca00f3-0b82-52f0-8876-b88f1231a473

	/// [Nota · pendente] de uma obra num mês, lido de dRankingNota (a mesma medida, guardada no refresh). Uma obra e um mês no contexto; senão, vazio.
	measure 'Nota · pendente · um mês' =
			VAR _o = SELECTEDVALUE ( dObra[Obra] )
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _m )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && HASONEVALUE ( dMes[Mes] ), MAXX ( _linha, dRankingNota[Pendente] ) )
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: c12ab813-5cfb-5ca3-8897-412a6936ac22

	/// Pontos da frequência de acidentes (máx. 0,5): TF = 0 → 0,5 · 0 < TF ≤ 7,5 → 0,25 · TF > 7,5 → 0; vazio sem dado. Uma obra; com várias, soma.
	measure 'Nota · pontos acidentes' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    VAR _x = [Nota · X acidentes]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x <= 0, 0.5,
			            _x <= 7.5, 0.25,
			            0
			        ) )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: db7b728f-3931-59cc-aa87-0093dbdfedc7

	/// Pontos da análise crítica (máx. 0,5): 3 de 3 → 0,5 · 2 de 3 → 0,25 · 0 ou 1 de 3 → 0; vazio sem dado. Uma obra; com várias, soma.
	measure 'Nota · pontos análise crítica' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    VAR _x = [Nota · X análise crítica]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x >= 3, 0.5,
			            _x >= 2, 0.25,
			            0
			        ) )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 8b411da6-25bb-50ab-8a42-7e19d0cb588f

	/// Pontos da previsão de caixa (máx. 1): desvio < 10% → 1 · 10% ≤ desvio ≤ 20% → 0,5 · desvio > 20% → 0; vazio sem dado. Uma obra; com várias, soma.
	measure 'Nota · pontos caixa' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    VAR _x = [Nota · X caixa]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x < 0.1, 1,
			            _x <= 0.2, 0.5,
			            0
			        ) )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 1d6fd5c1-a65f-5612-8751-754825d2fd07

	/// Pontos do custo (máx. 3): IDC ≥ 1,00 → 3 · 0,98 ≤ IDC < 1,00 → 2,5 · 0,96 ≤ IDC < 0,98 → 2 · 0,94 ≤ IDC < 0,96 → 1,5 · 0,92 ≤ IDC < 0,94 → 1 · 0,90 ≤ IDC < 0,92 → 0,5 · IDC < 0,90 → 0; vazio sem dado. Uma obra; com várias, soma.
	measure 'Nota · pontos custo' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    VAR _x = [Nota · X custo]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x >= 1, 3,
			            _x >= 0.98, 2.5,
			            _x >= 0.96, 2,
			            _x >= 0.94, 1.5,
			            _x >= 0.92, 1,
			            _x >= 0.9, 0.5,
			            0
			        ) )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: b5feb162-ebf8-54ad-9701-f5a7050177d8

	/// Pontos das entregas de material (máx. 0,5): entregas ≥ 90% → 0,5 · 80% ≤ entregas < 90% → 0,25 · entregas < 80% → 0; vazio sem dado. Uma obra; com várias, soma.
	measure 'Nota · pontos entregas' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    VAR _x = [Nota · X entregas]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x >= 0.9, 0.5,
			            _x >= 0.8, 0.25,
			            0
			        ) )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: a98b0b18-018a-53e7-bdb1-febf145bf147

	/// Pontos da aprovação na 1.ª inspeção (máx. 1): aprovação ≥ 95% → 1 · 90% ≤ aprovação < 95% → 0,75 · 85% ≤ aprovação < 90% → 0,5 · 80% ≤ aprovação < 85% → 0,25 · aprovação < 80% → 0; vazio sem dado. Uma obra; com várias, soma.
	measure 'Nota · pontos inspeção' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    VAR _x = [Nota · X inspeção]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x >= 0.95, 1,
			            _x >= 0.9, 0.75,
			            _x >= 0.85, 0.5,
			            _x >= 0.8, 0.25,
			            0
			        ) )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 5ed2ccaa-6d2d-5767-8aa0-d2dd5f0f9037

	/// Pontos do canteiro (NR-18) (máx. 0,5): conformidade ≥ 95% → 0,5 · 85% ≤ conformidade < 95% → 0,25 · conformidade < 85% → 0; vazio sem dado. Uma obra; com várias, soma.
	measure 'Nota · pontos NR-18' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    VAR _x = [Nota · X NR-18]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x >= 0.95, 0.5,
			            _x >= 0.85, 0.25,
			            0
			        ) )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 8830d983-dbc6-5263-98cf-76423a92ab79

	/// Soma dos pontos dos itens com dado.
	measure 'Nota · pontos obtidos' =
			VAR _p =
			    [Nota · pontos custo]
			        + [Nota · pontos prazo]
			        + [Nota · pontos PPC]
			        + [Nota · pontos caixa]
			        + [Nota · pontos inspeção]
			        + [Nota · pontos acidentes]
			        + [Nota · pontos NR-18]
			        + [Nota · pontos entregas]
			        + [Nota · pontos análise crítica]
			RETURN
			    IF ( NOT ISBLANK ( _p ), ROUND ( _p, 8 ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 3102d215-713a-524c-9922-180d88a061a5

	/// [Nota · pontos obtidos] de uma obra num mês, lido de dRankingNota (a mesma medida, guardada no refresh). Uma obra e um mês no contexto; senão, vazio.
	measure 'Nota · pontos obtidos · um mês' =
			VAR _o = SELECTEDVALUE ( dObra[Obra] )
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _m )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && HASONEVALUE ( dMes[Mes] ), MAXX ( _linha, dRankingNota[Obtidos] ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 03f2ea28-7b8a-557b-8fdb-a9ad9910975a

	/// Pontos possíveis − pontos obtidos: ordem das obras, obra em foco e 'onde a carteira perde pontos'.
	measure 'Nota · pontos perdidos' =
			VAR _p = [Nota · pontos possíveis]
			RETURN
			    IF ( NOT ISBLANK ( _p ), ROUND ( _p - [Nota · pontos obtidos], 8 ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 7d22c483-96be-5b43-930c-58e3cd0c71f2

	/// [Nota · pontos perdidos] de uma obra num mês, lido de dRankingNota (a mesma medida, guardada no refresh). Uma obra e um mês no contexto; senão, vazio.
	measure 'Nota · pontos perdidos · um mês' =
			VAR _o = SELECTEDVALUE ( dObra[Obra] )
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _m )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && HASONEVALUE ( dMes[Mes] ), MAXX ( _linha, dRankingNota[Perdidos] ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 5b57d325-e9d5-5788-a1f3-060c62cfabce

	/// Soma dos máximos dos itens com dado (10 com tudo preenchido); vazio sem nenhum item.
	measure 'Nota · pontos possíveis' =
			VAR _p =
			    [Nota · possíveis · custo]
			        + [Nota · possíveis · prazo]
			        + [Nota · possíveis · PPC]
			        + [Nota · possíveis · caixa]
			        + [Nota · possíveis · inspeção]
			        + [Nota · possíveis · acidentes]
			        + [Nota · possíveis · NR-18]
			        + [Nota · possíveis · entregas]
			        + [Nota · possíveis · análise crítica]
			RETURN
			    IF ( NOT ISBLANK ( _p ), ROUND ( _p, 8 ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: b065a16b-23a4-5a1d-9c2d-ea270f72259a

	/// [Nota · pontos possíveis] de uma obra num mês, lido de dRankingNota (a mesma medida, guardada no refresh). Uma obra e um mês no contexto; senão, vazio.
	measure 'Nota · pontos possíveis · um mês' =
			VAR _o = SELECTEDVALUE ( dObra[Obra] )
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _m )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && HASONEVALUE ( dMes[Mes] ), MAXX ( _linha, dRankingNota[Possiveis] ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 16ec35a9-2630-519e-bac9-9ddfdded4209

	/// Pontos do plano semanal (máx. 1): PPC ≥ 80% → 1 · 70% ≤ PPC < 80% → 0,5 · 60% ≤ PPC < 70% → 0,25 · PPC < 60% → 0; vazio sem dado. Uma obra; com várias, soma.
	measure 'Nota · pontos PPC' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    VAR _x = [Nota · X PPC]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x >= 0.8, 1,
			            _x >= 0.7, 0.5,
			            _x >= 0.6, 0.25,
			            0
			        ) )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 7d4bfec0-3db1-59ba-8bce-4c8f801a37f8

	/// Pontos do atraso (máx. 2): atraso ≤ 0,5 mês → 2 · 0,5 mês < atraso ≤ 1 mês → 1,5 · 1 mês < atraso ≤ 2 meses → 1 · 2 meses < atraso ≤ 3 meses → 0,5 · atraso > 3 meses → 0; vazio sem dado. Uma obra; com várias, soma.
	measure 'Nota · pontos prazo' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    VAR _x = [Nota · X prazo]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x <= 0.5, 2,
			            _x <= 1, 1.5,
			            _x <= 2, 1,
			            _x <= 3, 0.5,
			            0
			        ) )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 1d7c8346-e083-567f-b4b1-6c3783b378f0

	/// Máximo da frequência de acidentes (0,5) quando o item tem dado. Uma obra; com várias, soma.
