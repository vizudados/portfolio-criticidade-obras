/// Medidas do relatório (contas e desenho). Gerada a partir de pbi/dax/**/*.dax; não edite à mão.
table _Medidas
	lineageTag: aba96582-cd66-5cdb-9901-670cc99765bd

	/// Acidentes com afastamento no mês (base complementar).
	measure 'Canteiro · acidentes' =
			SUM ( fBaseObra[Acidentes] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: d82d984c-83ce-5ec1-950f-184f50982b5d

	/// Acidentes com afastamento nos 12 meses até o mês (base complementar).
	measure 'Canteiro · acidentes 12 meses' =
			SUM ( fBaseObra[Acidentes12m] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: 8a619532-2650-5b4e-9788-6787501d523f

	/// Serviços aprovados na primeira inspeção (base complementar).
	measure 'Canteiro · aprovados na 1.ª inspeção' =
			SUM ( fBaseObra[AprovadosPrimeira] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: 3ef077ab-f690-58b6-a8c9-e2d99175a59d

	/// Serviços aprovados na primeira inspeção ÷ serviços verificados (na carteira, soma ÷ soma); vazio sem o denominador.
	measure 'Canteiro · aprovação na 1.ª inspeção' =
			VAR _d = [Canteiro · serviços verificados]
			RETURN
			    IF ( _d > 0, DIVIDE ( [Canteiro · aprovados na 1.ª inspeção], _d ) )
		formatString: 0.00%
		displayFolder: Base\Canteiro
		lineageTag: 8cb387c9-b9b9-561d-9e07-46f727d04ee2

	/// Itens conformes ÷ itens aplicáveis do checklist NR-18 (na carteira, soma ÷ soma); vazio sem o denominador.
	measure 'Canteiro · conformidade NR-18' =
			VAR _d = [Canteiro · NR-18 aplicáveis]
			RETURN
			    IF ( _d > 0, DIVIDE ( [Canteiro · NR-18 conformes], _d ) )
		formatString: 0.00%
		displayFolder: Base\Canteiro
		lineageTag: 255dae91-e449-5699-9987-027c4fb93031

	/// Dias impraticáveis por chuva; na carteira, a média (base complementar).
	measure 'Canteiro · dias de chuva' =
			AVERAGE ( fBaseObra[DiasChuva] )
		formatString: 0.0
		displayFolder: Base\Canteiro
		lineageTag: 2f7b3b4f-e095-5da8-b63c-aa1552b6cad6

	/// Dias perdidos por acidente no mês (NBR 14280) (base complementar).
	measure 'Canteiro · dias perdidos' =
			SUM ( fBaseObra[DiasPerdidos] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: 3bbfb902-fdfa-5dd6-ab24-3791079c5fa5

	/// Dias perdidos nos 12 meses até o mês (base complementar).
	measure 'Canteiro · dias perdidos 12 meses' =
			SUM ( fBaseObra[DiasPerdidos12m] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: ef58c2c9-526a-5e6e-93fa-7a5a36a9a15d

	/// Pedidos entregues no prazo e completos ÷ pedidos com entrega prevista (na carteira, soma ÷ soma); vazio sem o denominador.
	measure 'Canteiro · entregas no prazo' =
			VAR _d = [Canteiro · pedidos previstos]
			RETURN
			    IF ( _d > 0, DIVIDE ( [Canteiro · pedidos no prazo], _d ) )
		formatString: 0.00%
		displayFolder: Base\Canteiro
		lineageTag: 647f1aea-2363-5494-abd7-01e3ebdf728a

	/// Horas-homem trabalhadas no mês (base complementar).
	measure 'Canteiro · HHT' =
			SUM ( fBaseObra[HHT] )
		formatString: #,0
		displayFolder: Base\Canteiro
		lineageTag: 4933d394-8a53-5dc2-af93-f22fb28f6a3c

	/// Horas-homem trabalhadas nos 12 meses até o mês (base complementar).
	measure 'Canteiro · HHT 12 meses' =
			SUM ( fBaseObra[HHT12m] )
		formatString: #,0
		displayFolder: Base\Canteiro
		lineageTag: eb38a31c-6398-5518-85c8-f2a7786d832b

	/// Itens aplicáveis do checklist NR-18 (base complementar).
	measure 'Canteiro · NR-18 aplicáveis' =
			SUM ( fBaseObra[NR18Aplicaveis] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: f7dfd2a5-f7dd-5d09-b912-ec07340d1d13

	/// Itens conformes do checklist NR-18 (base complementar).
	measure 'Canteiro · NR-18 conformes' =
			SUM ( fBaseObra[NR18Conformes] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: be7591fe-a69c-55b2-aad4-fc4148d5b214

	/// Pedidos entregues no prazo e completos (base complementar).
	measure 'Canteiro · pedidos no prazo' =
			SUM ( fBaseObra[PedidosNoPrazo] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: b28599d3-fbe3-534e-97c4-29b49f7fd734

	/// Pedidos com entrega prevista no mês (base complementar).
	measure 'Canteiro · pedidos previstos' =
			SUM ( fBaseObra[PedidosPrevistos] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: 97a16bec-0eb5-5125-8398-053c29d6dedf

	/// PPC do mês (pacotes concluídos ÷ planejados); na carteira, a média (base complementar).
	measure 'Canteiro · PPC' =
			AVERAGE ( fBaseObra[PPC] )
		formatString: 0.00%
		displayFolder: Base\Canteiro
		lineageTag: 2e356d71-598d-5bd2-b49f-fa3fe911dca4

	/// Serviços verificados no mês (FVS) (base complementar).
	measure 'Canteiro · serviços verificados' =
			SUM ( fBaseObra[ServicosVerificados] )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: ff757954-ee37-5a65-aa6f-855a1d9af5cc

	/// Taxa de frequência de acidentes com afastamento nos 12 meses até o mês (NBR 14280): acidentes × 1.000.000 ÷ HHT.
	measure 'Canteiro · taxa de frequência (12 meses)' =
			VAR _h = [Canteiro · HHT 12 meses]
			RETURN
			    IF ( _h > 0, DIVIDE ( [Canteiro · acidentes 12 meses] * 1000000, _h ) )
		formatString: 0.0
		displayFolder: Base\Canteiro
		lineageTag: 9525126c-51e7-5c98-a04b-935035f319ca

	/// Taxa de gravidade nos 12 meses até o mês (NBR 14280): dias perdidos × 1.000.000 ÷ HHT. Só informação.
	measure 'Canteiro · taxa de gravidade (12 meses)' =
			VAR _h = [Canteiro · HHT 12 meses]
			RETURN
			    IF ( _h > 0, DIVIDE ( [Canteiro · dias perdidos 12 meses] * 1000000, _h ) )
		formatString: 0
		displayFolder: Base\Canteiro
		lineageTag: d865bc9a-9723-5711-b551-4f79047a3e31

	/// Obras do recorte com justificativa em branco no mês do contexto (desvio do desembolso acima de ±10%).
	measure 'Carteira · justificativas em branco' =
			SUMX ( VALUES ( fAnaliseCritica[Obra] ), [Justificativa · em branco] )
		formatString: 0
		displayFolder: Base\Desembolso
		lineageTag: 9c6d6e70-447b-5827-a8fe-e269d7b85b78

	/// Obras do recorte com justificativa exigidas no mês do contexto (desvio do desembolso acima de ±10%).
	measure 'Carteira · justificativas exigidas' =
			SUMX ( VALUES ( fAnaliseCritica[Obra] ), [Justificativa · exigida] )
		formatString: 0
		displayFolder: Base\Desembolso
		lineageTag: 9d30dfd2-1acd-5ad0-9e13-5bd6c5966653

	/// Justificativas exigidas no mês do contexto que estão preenchidas na planilha.
	measure 'Carteira · justificativas preenchidas' =
			[Carteira · justificativas exigidas] - [Carteira · justificativas em branco]
		formatString: 0
		displayFolder: Base\Desembolso
		lineageTag: 63f95b67-24e3-527c-947b-ec0273101f81

	/// Desembolsado no mês ÷ previsto no mês − 1, só com as obras que têm previsto (vazio sem um dos dois).
	measure 'Desembolso · desvio no mês' =
			VAR _prev = [Desembolso · previsto no mês]
			VAR _real = [Desembolso · realizado com previsto no mês]
			RETURN
			    IF ( NOT ISBLANK ( _prev ) && NOT ISBLANK ( _real ), DIVIDE ( _real, _prev ) - 1 )
		formatString: 0.00%
		displayFolder: Base\Desembolso
		lineageTag: d8e68ae9-6a3d-5453-958e-6f7018c511c3

	/// Desembolsado no mês − previsto no mês, em R$, só com as obras que têm previsto (vazio sem um dos dois).
	measure 'Desembolso · diferença no mês' =
			VAR _prev = [Desembolso · previsto no mês]
			VAR _real = [Desembolso · realizado com previsto no mês]
			RETURN
			    IF ( NOT ISBLANK ( _prev ) && NOT ISBLANK ( _real ), _real - _prev )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Base\Desembolso
		lineageTag: 0e166530-d2c9-55a4-8069-d510653b4049

	/// Desembolsado no mês só das obras do contexto que têm previsto no mês (regra 'sem previsto'). Na obra, igual ao desembolsado quando ela tem previsto; vazio quando não tem.
	measure 'Desembolso · realizado com previsto no mês' =
			SUMX (
			    VALUES ( fAnaliseCritica[Obra] ),
			    IF ( NOT ISBLANK ( [Desembolso · previsto no mês] ), [Desembolso · realizado no mês] )
			)
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Base\Desembolso
		lineageTag: b9bc3935-4032-58fc-82e6-47be4cce1a4a

	/// Justificativa digitada na aba para a diferença do desembolso (uma obra e um mês no contexto).
	measure 'Justificativa do desembolso' =
			SELECTEDVALUE ( fAnaliseCritica[Justificativa] )
		displayFolder: Base\Desembolso
		lineageTag: 5b57dae1-bde3-56e8-a88f-78d2e8b089d0

	/// 1 quando a justificativa é exigida e a aba não traz texto; 0 senão.
	measure 'Justificativa · em branco' =
			VAR _exigida = [Justificativa · exigida]
			VAR _texto = TRIM ( [Justificativa do desembolso] )
			RETURN
			    IF ( NOT ISBLANK ( _exigida ), IF ( _exigida = 1 && ( ISBLANK ( _texto ) || _texto = "" ), 1, 0 ) )
		formatString: 0
		displayFolder: Base\Desembolso
		lineageTag: cf46df45-dacd-53c8-ade5-1cfda2f1fb30

	/// 1 quando o desvio do desembolso do mês passa de ±10% (regra proposta, a validar com a Construtora); 0 senão.
	measure 'Justificativa · exigida' =
			VAR _desvio = [Desembolso · desvio no mês]
			RETURN
			    IF ( NOT ISBLANK ( _desvio ), IF ( ABS ( _desvio ) > 0.10, 1, 0 ) )
		formatString: 0
		displayFolder: Base\Desembolso
		lineageTag: a2dfd57b-a46b-5d58-bfea-46d12d734e7f

	/// Executado acumulado − previsto acumulado, em pontos percentuais (< 0 = atrasada); na carteira, ponderado pelo orçamento das obras que têm previsto. Vazio quando a aba não traz o previsto.
	measure 'Físico · desvio acumulado p.p.' =
			VAR _linhas = FILTER ( fAnaliseCritica, NOT ISBLANK ( fAnaliseCritica[PrevAcum] ) && NOT ISBLANK ( fAnaliseCritica[ExecAcum] ) )
			VAR _orc = SUMX ( _linhas, fAnaliseCritica[Orcamento] )
			RETURN
			    IF ( _orc > 0, DIVIDE ( SUMX ( _linhas, ( fAnaliseCritica[ExecAcum] - fAnaliseCritica[PrevAcum] ) * fAnaliseCritica[Orcamento] ), _orc ) * 100 )
		formatString: +0.00;-0.00;0.00
		displayFolder: Base\Físico
		lineageTag: ed5119b9-5b81-50bc-8860-7ff04e5f9b8a

	/// % executado acumulado (na carteira, ponderado pelo orçamento).
	measure 'Físico · executado acumulado' =
			DIVIDE (
			    SUMX ( fAnaliseCritica, fAnaliseCritica[ExecAcum] * fAnaliseCritica[Orcamento] ),
			    SUMX ( fAnaliseCritica, fAnaliseCritica[Orcamento] )
			)
		formatString: 0.00%
		displayFolder: Base\Físico
		lineageTag: e47cece0-122e-54d1-a983-aad70e00005a

	/// % executado acumulado só das abas que trazem o previsto, ponderado pelo orçamento: o mesmo grupo do previsto e do desvio da carteira (obra sem previsto, ex.: JANGADA, fica fora). Igual ao executado acumulado quando todas têm previsto.
	measure 'Físico · executado acumulado · com previsto' =
			VAR _linhas = FILTER ( fAnaliseCritica, NOT ISBLANK ( fAnaliseCritica[PrevAcum] ) && NOT ISBLANK ( fAnaliseCritica[ExecAcum] ) )
			RETURN
			    DIVIDE ( SUMX ( _linhas, fAnaliseCritica[ExecAcum] * fAnaliseCritica[Orcamento] ), SUMX ( _linhas, fAnaliseCritica[Orcamento] ) )
		formatString: 0.00%
		displayFolder: Base\Físico
		lineageTag: c0fe1325-481b-56df-a8d5-cc10442fd99c

	/// % executado do mês (na carteira, ponderado pelo orçamento).
	measure 'Físico · executado no mês' =
			DIVIDE (
			    SUMX ( fAnaliseCritica, fAnaliseCritica[ExecMes] * fAnaliseCritica[Orcamento] ),
			    SUMX ( fAnaliseCritica, fAnaliseCritica[Orcamento] )
			)
		formatString: 0.00%
		displayFolder: Base\Físico
		lineageTag: b583fc92-2cd0-523d-9f0d-b81743d0fc17

	/// Obras com executado e sem previsto acumulado na aba (ficam fora do previsto e do desvio da carteira), em ordem alfabética; vazio quando todas têm previsto.
	measure 'Físico · obras sem previsto (lista)' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( fAnaliseCritica[Obra] ),
			            "@p", CALCULATE ( MAX ( fAnaliseCritica[PrevAcum] ) ),
			            "@e", CALCULATE ( MAX ( fAnaliseCritica[ExecAcum] ) )
			        ),
			        ISBLANK ( [@p] ) && NOT ISBLANK ( [@e] )
			    )
			RETURN
			    CONCATENATEX ( _obras, fAnaliseCritica[Obra], ", ", fAnaliseCritica[Obra], ASC )
		displayFolder: Base\Físico
		lineageTag: 84136fdf-4264-5bd1-868e-86175e9f8ac4

	/// % previsto acumulado (na carteira, ponderado pelo orçamento). Obra sem previsto na aba fica fora da média.
	measure 'Físico · previsto acumulado' =
			DIVIDE (
			    SUMX ( FILTER ( fAnaliseCritica, NOT ISBLANK ( fAnaliseCritica[PrevAcum] ) ), fAnaliseCritica[PrevAcum] * fAnaliseCritica[Orcamento] ),
			    SUMX ( FILTER ( fAnaliseCritica, NOT ISBLANK ( fAnaliseCritica[PrevAcum] ) ), fAnaliseCritica[Orcamento] )
			)
		formatString: 0.00%
		displayFolder: Base\Físico
		lineageTag: 552a9cc4-98bc-587a-b225-1ddba8d7b5d5

	/// % previsto do mês (na carteira, ponderado pelo orçamento). Obra sem previsto na aba fica fora da média.
	measure 'Físico · previsto no mês' =
			DIVIDE (
			    SUMX ( FILTER ( fAnaliseCritica, NOT ISBLANK ( fAnaliseCritica[PrevMes] ) ), fAnaliseCritica[PrevMes] * fAnaliseCritica[Orcamento] ),
			    SUMX ( FILTER ( fAnaliseCritica, NOT ISBLANK ( fAnaliseCritica[PrevMes] ) ), fAnaliseCritica[Orcamento] )
			)
		formatString: 0.00%
		displayFolder: Base\Físico
		lineageTag: d4fb02ff-46d3-5cf4-910d-b6014bb61786

	/// Nome do mês anterior ao do contexto, minúsculo (maio), para as frases de comparação do tooltip do mês.
	measure 'Mês anterior · nome' =
			VAR _mes = EDATE ( MAX ( dMes[Mes] ), -1 )
			RETURN
			    FORMAT ( _mes, "mmmm", "pt-BR" )
		displayFolder: Base\Mês
		lineageTag: a81e9300-dd96-5421-a2b5-aa98d25ea619

	/// Mês anterior ao de referência, abreviado (mai/26); vazio quando a referência é o primeiro mês do histórico.
	measure 'Mês anterior à referência · curto' =
			VAR _mes = EDATE ( [Mês de referência], -1 )
			RETURN
			    LOOKUPVALUE ( dMes[MesAno], dMes[Mes], _mes )
		displayFolder: Base\Mês
		lineageTag: ef8cf071-764d-5d9f-9adf-5d3b25ed8226

	/// Nome do mês anterior ao de referência, minúsculo (maio), para as frases de comparação.
	measure 'Mês anterior à referência · nome' =
			VAR _mes = EDATE ( [Mês de referência], -1 )
			RETURN
			    FORMAT ( _mes, "mmmm", "pt-BR" )
		displayFolder: Base\Mês
		lineageTag: f838c426-074c-5371-95c7-109ac64e880f

	/// Mês escolhido no seletor do drawer (dMesRef, desconectada); sem escolha, ou com a linha "Último mês", o mês dessa linha (o mais recente que pelo menos metade das obras já fechou).
	measure 'Mês de referência' =
			VAR _auto = SELECTEDVALUE ( dMesRef[Automatico], TRUE () )
			VAR _ultimo = CALCULATE ( MAX ( dMesRef[MesRef] ), REMOVEFILTERS ( dMesRef ), dMesRef[Automatico] = TRUE () )
			RETURN
			    IF ( _auto, _ultimo, MAX ( dMesRef[MesRef] ) )
		formatString: dd/mm/yyyy
		displayFolder: Base\Mês
		lineageTag: 355bb808-912f-5f9a-a9e0-8a708ed82607

	/// Mês de referência abreviado (jun/26).
	measure 'Mês de referência · curto' =
			VAR _mes = [Mês de referência]
			RETURN
			    LOOKUPVALUE ( dMes[MesAno], dMes[Mes], _mes )
		displayFolder: Base\Mês
		lineageTag: a881eebc-4ddb-5bf0-bf47-ba4723134743

	/// Mês de referência abreviado em caixa alta (JUN/26), para sobretítulos.
	measure 'Mês de referência · curto maiúsculo' =
			UPPER ( [Mês de referência · curto] )
		displayFolder: Base\Mês
		lineageTag: 282602d5-aec6-5183-8d67-9d789777dda7

	/// Mês de referência por extenso (junho de 2026), para o cabeçalho e as frases.
	measure 'Mês de referência · longo' =
			VAR _mes = [Mês de referência]
			RETURN
			    LOOKUPVALUE ( dMes[MesAnoLongo], dMes[Mes], _mes )
		displayFolder: Base\Mês
		lineageTag: 9863a86f-a714-55b5-a609-1a75176c85a8

	/// Nome do mês de referência, minúsculo (junho), para as frases das leituras.
	measure 'Mês de referência · nome' =
			VAR _mes = [Mês de referência]
			RETURN
			    FORMAT ( _mes, "mmmm", "pt-BR" )
		displayFolder: Base\Mês
		lineageTag: 2be1cd0d-a3f1-547d-b8f3-3c13c58d3193

	/// Mês do eixo abreviado sem ano (jun).
	measure 'Mês · abreviado' =
			SELECTEDVALUE ( dMes[MesAbrev] )
		displayFolder: Base\Mês
		lineageTag: 57157c0d-8060-50a4-9c45-c9850c3c2085

	/// Mês do eixo (primeiro dia), no contexto do gráfico ou do tooltip.
	measure 'Mês · data' =
			MAX ( dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: Base\Mês
		lineageTag: 3bb49a96-67a1-5ffe-a4dd-dc3ede3048c5

	/// Mês do eixo com ano (junho de 2026).
	measure 'Mês · longo' =
			SELECTEDVALUE ( dMes[MesAnoLongo] )
		displayFolder: Base\Mês
		lineageTag: 2d984a07-8e91-5e36-9ec3-9a58b4d47719

	/// Mês do eixo por extenso, minúsculo (junho).
	measure 'Mês · nome' =
			SELECTEDVALUE ( dMes[MesNome] )
		displayFolder: Base\Mês
		lineageTag: 6c326adb-8289-5f9d-8291-fc39703a74b2

	/// Ordem do mês do eixo no histórico (1 = primeiro mês).
	measure 'Mês · ordem' =
			SELECTEDVALUE ( dMes[Ordem] )
		formatString: 0
		displayFolder: Base\Mês
		lineageTag: 3ec9c5b2-91e5-5f98-b358-9c76244b265d

	/// Mês do eixo abreviado (jun/26).
	measure 'Mês · rótulo curto' =
			SELECTEDVALUE ( dMes[MesAno] )
		displayFolder: Base\Mês
		lineageTag: 8cecfd55-0d8b-5536-8e81-3fe4a827edc3

	/// 1 quando o mês do contexto é o primeiro mês do histórico (sem comparação com o anterior); 0 nos outros.
	measure 'Mês · é o primeiro do histórico' =
			VAR _mes = MAX ( dMes[Mes] )
			VAR _ini = CALCULATE ( MIN ( dMes[Mes] ), REMOVEFILTERS ( dMes ) )
			RETURN
			    IF ( _mes = _ini, 1, 0 )
		formatString: 0
		displayFolder: Base\Mês
		lineageTag: ea451288-755a-59eb-b8ba-59fc1adde40d

	/// Quantos meses a série olha até o mês de referência, escolhidos no drawer (dJanela, desconectada): 12, 9, 6 ou 3; sem escolha, 12.
	measure 'Série · janela (meses)' =
			SELECTEDVALUE ( dJanela[Meses], 12 )
		formatString: 0
		displayFolder: Base\Mês
		lineageTag: e7d9c9a2-1aea-5298-a931-d596d36bbd04

	/// Quantos meses a série mostra: do primeiro mês da janela ao mês de referência (8 em ago/26 com janela de 12, porque o histórico começa em jan/26).
	measure 'Série · meses até a referência' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			RETURN
			    COUNTROWS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ) )
		formatString: 0
		displayFolder: Base\Mês
		lineageTag: 1029ea05-e222-5776-8bad-81a5bd2c6bdf

	/// 1 no mês do eixo que está na janela (do primeiro mês da janela ao de referência); vazio fora dela. Os gráficos mês a mês filtram por esta conta.
	measure 'Série · mês até a referência' =
			VAR _mes = MAX ( dMes[Mes] )
			RETURN
			    IF ( _mes >= [Série · primeiro mês] && _mes <= [Mês de referência], 1 )
		formatString: 0
		displayFolder: Base\Mês
		lineageTag: 1675fa9d-f53b-5a1a-b84f-a3ca67aa3ae9

	/// Posição do mês do eixo dentro da janela (1 = primeiro mês da janela); vazio fora dela. Para a geometria das séries (x de cada coluna ou ponto).
	measure 'Série · posição na janela' =
			VAR _mes = MAX ( dMes[Mes] )
			VAR _ini = [Série · primeiro mês]
			RETURN
			    IF ( _mes >= _ini && _mes <= [Mês de referência], DATEDIFF ( _ini, _mes, MONTH ) + 1 )
		formatString: 0
		displayFolder: Base\Mês
		lineageTag: 134d1ce3-e48d-5a64-bb22-b95b8d179134

	/// Primeiro mês da janela: o mês de referência menos (janela − 1) meses, nunca antes do primeiro mês do histórico (jan/26). Ponto de partida das séries e das leituras ("desde", "em x de y meses").
	measure 'Série · primeiro mês' =
			VAR _ref = [Mês de referência]
			VAR _ini = CALCULATE ( MIN ( dMes[Mes] ), REMOVEFILTERS ( dMes ) )
			VAR _janela = EDATE ( _ref, 1 - [Série · janela (meses)] )
			RETURN
			    IF ( NOT ISBLANK ( _ref ), MAX ( _ini, _janela ) )
		formatString: dd/mm/yyyy
		displayFolder: Base\Mês
		lineageTag: 3c6c8dbe-eda7-5421-9838-8c2f4c2bfddc

	/// 1 quando o mês do eixo é o mês de referência (destaque no eixo); 0 nos outros.
	measure 'Série · é o mês de referência' =
			VAR _mes = MAX ( dMes[Mes] )
			RETURN
			    IF ( _mes = [Mês de referência], 1, 0 )
		formatString: 0
		displayFolder: Base\Mês
		lineageTag: adb67034-a67b-5ea0-a2ca-bb2f9b0ad7f1

	/// As checagens da aba do mês que falharam, separadas por '|' (conta|justificativa|previsto); vazio quando todas passam ou sem aba. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · análise crítica · checagens (lista)' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _conta = INT ( ABS ( SUM ( fAnaliseCritica[Resultado] ) - SUM ( fAnaliseCritica[ResultadoRegra] ) ) < 1 )
			    VAR _just = INT ( NOT ( [Justificativa · em branco] = 1 ) )
			    VAR _prev = SELECTEDVALUE ( fAnaliseCritica[PrevAcum] )
			    VAR _ant = SELECTEDVALUE ( fAnaliseCritica[PrevAcumAnterior] )
			    VAR _naoCaiu = INT ( ISBLANK ( _prev ) || ISBLANK ( _ant ) || _prev >= _ant - 0.000001 )
			    VAR _t = { ( "conta", _conta ), ( "justificativa", _just ), ( "previsto", _naoCaiu ) }
			    RETURN
			        IF ( NOT ISEMPTY ( fAnaliseCritica ), CONCATENATEX ( FILTER ( _t, [Value2] = 0 ), [Value1], "|" ) )
			)
		displayFolder: Base\Nota
		lineageTag: 955cb072-0498-5d60-a60e-da7051bd164f

	/// Obras do recorte com status críticas no mês do contexto (só as com nota; a pendente não entra). Conta as linhas de dRankingNota. Um mês no contexto; com mais de um, vazio.
	measure 'Nota · carteira · obras críticas' =
			IF (
			    HASONEVALUE ( dMes[Mes] ),
			    COUNTROWS (
			        FILTER (
			            dRankingNota,
			            dRankingNota[Mes] = VALUES ( dMes[Mes] )
			                && dRankingNota[TemAC] = 1
			                && dRankingNota[Obra] IN VALUES ( dObra[Obra] )
			                && dRankingNota[Status] == 2
			        )
			    )
			)
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 9f882fea-7039-54c7-b114-df58e480a1cf

