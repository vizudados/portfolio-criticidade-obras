	/// 1 quando o executado do mês ficou abaixo do previsto em todos os meses da janela que trazem o previsto (obra do contexto); 0 senão; vazio quando nenhum mês traz o previsto.
	measure 'T3 · Ritmo · abaixo do previsto em toda a série' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@e", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · executado no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@p", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · previsto no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _serie = FILTER ( _meses, NOT ISBLANK ( [@e] ) && NOT ISBLANK ( [@p] ) )
			RETURN
			    IF ( COUNTROWS ( _serie ) > 0, IF ( COUNTROWS ( FILTER ( _serie, [@e] >= [@p] ) ) = 0, 1, 0 ) )
		formatString: 0
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 18f47ff2-56f7-56e3-b206-d0a9eb40e070

	/// Primeiro mês da sequência, terminada na referência, em que o executado do mês ficou abaixo do previsto (vazio quando a referência não está nessa condição ou não traz o previsto). Meses da janela com previsto; obra do contexto.
	measure 'T3 · Ritmo · executa abaixo desde' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@e", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · executado no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@p", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · previsto no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _serie = FILTER ( _meses, NOT ISBLANK ( [@e] ) && NOT ISBLANK ( [@p] ) )
			VAR _quebra = MAXX ( FILTER ( _serie, NOT ( [@e] < [@p] ) ), dMes[Mes] )
			VAR _inicio = MINX ( FILTER ( _serie, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] )
			VAR _naRef = COUNTROWS ( FILTER ( _serie, dMes[Mes] = _ref && [@e] < [@p] ) ) > 0
			RETURN
			    IF ( _naRef, _inicio )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: c9e4d443-24f2-5f1b-ba32-63df47d40f9a

	/// [T3 · Ritmo · executa abaixo desde] da obra em foco.
	measure 'T3 · Ritmo · executa abaixo desde · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Ritmo · executa abaixo desde], dObra[Obra] = _obra )
