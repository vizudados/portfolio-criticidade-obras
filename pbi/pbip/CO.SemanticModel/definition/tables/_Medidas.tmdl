	/// CSS de Itens da nota (uma entrada por item, linhas de 76, minissérie à direita) e do subtítulo.
	measure 'T2 · Itens · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & "#htmlContent{padding:0!important}.htmlViewerEntry{display:block!important;margin:0!important;padding:0!important}.it{position:relative;height:76px;border-bottom:1px solid #E1E1E1;w"
			    & "hite-space:nowrap}.it .nm{position:absolute;left:0;top:12px;font-size:15px;line-height:19px;font-weight:600}.it .ln{position:absolute;left:0;right:165px;top:40px;display:flex;align"
			    & "-items:baseline;gap:10px;overflow:hidden}.it .ln b{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;font-variant-numeric:tabular-nums}.i"
			    & "t .ln span{font-size:13px;line-height:17px;color:#3B3B3F;overflow:hidden;text-overflow:ellipsis}.it .chi{position:absolute;right:0;top:11px}.it .sr{position:absolute;right:0;top:40"
			    & "px;width:141px;height:26px}.it .sr i{position:absolute;bottom:0;width:9px}.it .sr i.c{background:#A9CDB9}.it .sr i.p{background:#C9821F}.it .sr i.z{background:#C43737}.it .sr i.v{h"
			    & "eight:1px!important;background:#CFCCC6}.it .sr i.r{outline:1px solid #0B0B0C;outline-offset:1px}.it:hover{background:rgba(233,224,207,.3)}.ss{position:fixed;inset:0;font-size:15px;"
			    & "line-height:20px;color:#3B3B3F;white-space:nowrap}"
		displayFolder: T2 Análise crítica\Itens da nota
		lineageTag: 7cf24329-d79f-5dd7-b5e4-1b3b2a51caea

	/// Um item da nota por entrada (granularidade dItemNota, na ordem de T2 · Itens · posição): nome, o chip de pontos de possíveis (cheio, parcial, zero; sem dado tracejado, com 'falta na base' ou 'sem dado na planilha' conforme a fonte), o X e a faixa atingida e, à direita, a minissérie dos pontos do item nos meses da janela (fração dos pontos; o mês de referência contornado). O mouse abre o tooltip do item.
	measure 'T2 · Itens · HTML linha' =
			-- 1 · Leituras
			VAR _cod = SELECTEDVALUE ( dItemNota[Item] )
			VAR _nome = [Nota · item · nome médio]
			VAR _fonte = [Nota · item · fonte]
			VAR _max = [Nota · item · máximo]
			VAR _pts = [Nota · item · pontos · foco]
			VAR _poss = [Nota · item · possíveis · foco]
			VAR _x = [Nota · item · X · foco]
			VAR _fx = [Nota · item · faixa atingida · foco]
			VAR _fora = [Nota · item · fora da faixa · foco]
			VAR _temObra = NOT ISBLANK ( [Nota · pontos possíveis · ranking · foco] )
			VAR _ref = [Mês de referência]
			VAR _n = [Série · meses até a referência]
			VAR _todos =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@pos", [Série · posição na janela],
			        "@v", [Nota · item · pontos · foco no mês],
			        "@p", [Nota · item · possíveis · foco no mês]
			    )
			VAR _meses = FILTER ( _todos, [@ate] = 1 ) /* lista */
			-- 2 · Textos
			VAR _caTxt = IF ( ISBLANK ( _pts ), "sem dado na planilha", "⁅" & FORMAT ( _pts, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _poss, "0.0#", "pt-BR" ) & "⁆" )
			VAR _caCls = SWITCH ( TRUE (), ISBLANK ( _pts ), "f", _pts >= _poss, "c", _pts = 0, "z", "p" )
			VAR _caHtml = "<span class='a-pop chi chi-" & _caCls & "' style='animation-delay:" & 450 & "ms'><span>" & _caTxt & "</span></span>"
			VAR _cbTxt = IF ( ISBLANK ( _pts ), "falta na base", "⁅" & FORMAT ( _pts, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _poss, "0.0#", "pt-BR" ) & "⁆" )
			VAR _cbCls = SWITCH ( TRUE (), ISBLANK ( _pts ), "f", _pts >= _poss, "c", _pts = 0, "z", "p" )
			VAR _cbHtml = "<span class='a-pop chi chi-" & _cbCls & "' style='animation-delay:" & 450 & "ms'><span>" & _cbTxt & "</span></span>"
			VAR _tmxTxt = IF ( ISBLANK ( _max ), "—", FORMAT ( _max, "0.0#", "pt-BR" ) )
			VAR _chip =
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _pts ) && _poss = 0, "<span class='a-pop chi chi-n' style='animation-delay:450ms'>não conta</span>",
			        ISBLANK ( _pts ) && _fora = 1, "<span class='a-pop chi chi-f' style='animation-delay:450ms'>fora da faixa</span>",
			        _fonte = "Análise Crítica", _caHtml,
			        _cbHtml
			    )
			VAR _xA1 = ROUND ( ABS ( _x ) * 100, 1 )
			VAR _xPct = "⁅" & FORMAT ( _xA1, "0.0", "pt-BR" ) & "⁆" & "%"
			VAR _xMes = "⁅" & FORMAT ( ABS ( _x ), "0.0", "pt-BR" ) & "⁆" & IF ( ROUND ( ABS ( _x ), 1 ) <= 1, " mês", " meses" )
			VAR _txtX =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _pts ), "",
			        _cod = "custo", "<b class='" & IF ( _x < 1, "ng", "" ) & "'>IDC " & "⁅" & FORMAT ( _x, "0.00", "pt-BR" ) & "⁆" & "</b>",
			        _cod = "prazo",
			            "<b>" & IF ( ROUND ( _x, 1 ) > 0, "atraso de " & _xMes, IF ( ROUND ( _x, 1 ) < 0, "adiantada " & _xMes, "em dia" ) ) & "</b>",
			        _cod = "acidentes", "<b>TF " & "⁅" & FORMAT ( _x, "0.0", "pt-BR" ) & "⁆" & "</b>",
			        _cod = "analise", "<b>" & "⁅" & FORMAT ( _x, "0" ) & "⁆" & " de 3 checagens</b>",
			        "<b>" & _xPct & "</b>"
			    )
			VAR _txtFaixa =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _pts ), "vale até " & "⁅" & _tmxTxt & "⁆" & IF ( _max < 2, " ponto", " pontos" ),
			        SUBSTITUTE ( SUBSTITUTE ( _fx, "<", "&lt;" ), ">", "&gt;" )
			    )
			-- 3 · Geometria
			VAR _x0 = 141 - _n * 12 + 3 -- geometria
			-- 4 · Marcação
			VAR _serie =
			    CONCATENATEX (
			        _meses,
			        VAR _xb = _x0 + ( [@pos] - 1 ) * 12 /* geometria */
			        VAR _cls = SWITCH ( TRUE (), ISBLANK ( [@v] ) || [@p] = 0, "v", [@v] >= [@p], "c", [@v] = 0, "z", "p" )
			        VAR _hb = IF ( _cls = "z", 3, MAX ( 3, ROUND ( DIVIDE ( [@v], [@p] ) * 26, 0 ) ) ) /* geometria */
			        /* F4: a barra cresce da base (corrida; o traço do mês sem dado tem altura fixa e só aparece) */
			        VAR _rd = ( [@pos] - 1 ) * 40 /* geometria */
			        VAR _corre = IF ( _cls = "v", ";animation-delay:" & _rd & "ms'", "' data-rk='" & _cod & "|" & FORMAT ( dMes[Mes], "yyyymm" ) & "' data-rp='height' data-r0-height='0px' data-rd='" & _rd & "'" ) /* geometria */
			        RETURN
			            "<i class='" & _cls & IF ( _cls = "v", " a-fd", "" ) & IF ( dMes[Mes] = _ref, " r", "" ) & "' style='left:" & _xb & "px;height:" & _hb & "px" & _corre & "></i>",
			        "",
			        dMes[Mes], ASC
			    )
			VAR _saidaHtml =
			    IF (
			        _temObra && NOT ISBLANK ( _cod ),
			        "<div class='u it' data-rr='" & _cod & "'><p class='nm'>" & _nome & "</p>" & _chip
			            & "<p class='ln'>" & _txtX & IF ( _txtFaixa = "", "", "<span>" & _txtFaixa & "</span>" ) & "</p>"
			            & "<div class='sr'>" & _serie & "</div>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Itens da nota
		lineageTag: 5224cc6a-2250-561c-984f-a650d7853a04

	/// Subtítulo de Itens da nota: diz a ordem das linhas (quem mais perde pontos primeiro) e o que a minissérie mostra. O total perdido já está no cartão Nota da obra e não se repete aqui.
	measure 'T2 · Itens · HTML subtítulo' =
			-- 1 · Leituras
			VAR _po = [Nota · pontos possíveis · ranking · foco]
			-- 4 · Marcação
			RETURN
			    IF ( NOT ISBLANK ( _po ), "<p class='u ss'>pontos de cada item, quem mais perde primeiro · à direita, os pontos mês a mês</p>" )
		displayFolder: T2 Análise crítica\Itens da nota
		lineageTag: bc4ade07-47b0-5b97-a2df-ae1784284a6b

	/// Ordem do item da nota da linha (dItemNota) no painel Itens da nota, para a obra em foco no mês de referência: primeiro os que perdem pontos (mais pontos perdidos antes), depois os cheios e depois os sem dado; empate pela ordem da régua.
	measure 'T2 · Itens · posição' =
			VAR _grupo =
			    IF ( ISBLANK ( [Nota · item · pontos · foco] ), 2, IF ( [Nota · item · perdidos · foco] > 0, 0, 1 ) )
			VAR _perd = [Nota · item · perdidos · foco] + 0
			VAR _ordem = [Nota · item · ordem]
			VAR _todos =
			    ADDCOLUMNS (
			        ALL ( dItemNota[Item] ),
			        "@g", IF ( ISBLANK ( [Nota · item · pontos · foco] ), 2, IF ( [Nota · item · perdidos · foco] > 0, 0, 1 ) ),
			        "@p", [Nota · item · perdidos · foco] + 0,
			        "@o", [Nota · item · ordem]
			    )
			VAR _antes =
			    COUNTROWS (
			        FILTER (
			            _todos,
			            [@g] < _grupo || ( [@g] = _grupo && ( [@p] > _perd || ( [@p] = _perd && [@o] < _ordem ) ) )
			        )
			    )
			RETURN
			    IF ( HASONEVALUE ( dItemNota[Item] ), _antes + 1 )
		formatString: 0
		displayFolder: T2 Análise crítica\Itens da nota\Contas
		lineageTag: 13856777-85aa-5a2f-a3fd-6a36e38046e0

	/// Leitura do "?" de Como o resultado se forma, sobre o painel (508 × 350, condensada): o que a obra agregou contra o que já virou obra (resultado aplicado e IDC), quanto da planilha ainda vai se realizar (saldo de contrato e equipamentos) e três destaques que contam. Só lê contas.
	measure 'T2 · Leitura forma · HTML' =
			-- 1 · Leituras
			VAR _obra = [Nota · obra em foco]
			VAR _va = [Crédito do orçamento · foco]
			VAR _ca = [Custo aplicado · foco]
			VAR _ra = [Resultado aplicado · foco]
			VAR _ar = [A realizar · foco]
			VAR _res = [Resultado da obra · foco]
			VAR _idc = [IDC · foco]
			VAR _divida = [Dívida da obra · foco]
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tvaA = ABS ( _va )
			VAR _tvaNu = SWITCH ( TRUE (), _tvaA >= 99950000, FORMAT ( _tvaA / 1000000, "0.0", "pt-BR" ), _tvaA >= 999500, FORMAT ( _tvaA / 1000000, "0.00", "pt-BR" ), _tvaA >= 999.5, FORMAT ( _tvaA / 1000, "0", "pt-BR" ), FORMAT ( _tvaA, "#,0", "pt-BR" ) )
			VAR _tvaUn = SWITCH ( TRUE (), _tvaA >= 999500, " mi", _tvaA >= 999.5, " mil", "" )
			VAR _tvaN = _tvaNu & _tvaUn
			VAR _tvaZero = _tvaN = "0"
			VAR _tvaS = IF ( _tvaZero, "", IF ( _va < 0, "−", "" ) )
			VAR _tvaTxt = IF ( ISBLANK ( _va ), "—", _tvaS & "R$ " & _tvaN )
			VAR _tcaA = ABS ( _ca )
			VAR _tcaNu = SWITCH ( TRUE (), _tcaA >= 99950000, FORMAT ( _tcaA / 1000000, "0.0", "pt-BR" ), _tcaA >= 999500, FORMAT ( _tcaA / 1000000, "0.00", "pt-BR" ), _tcaA >= 999.5, FORMAT ( _tcaA / 1000, "0", "pt-BR" ), FORMAT ( _tcaA, "#,0", "pt-BR" ) )
			VAR _tcaUn = SWITCH ( TRUE (), _tcaA >= 999500, " mi", _tcaA >= 999.5, " mil", "" )
			VAR _tcaN = _tcaNu & _tcaUn
			VAR _tcaZero = _tcaN = "0"
			VAR _tcaS = IF ( _tcaZero, "", IF ( _ca < 0, "−", "" ) )
			VAR _tcaTxt = IF ( ISBLANK ( _ca ), "—", _tcaS & "R$ " & _tcaN )
			VAR _traA = ABS ( _ra )
			VAR _traNu = SWITCH ( TRUE (), _traA >= 99950000, FORMAT ( _traA / 1000000, "0.0", "pt-BR" ), _traA >= 999500, FORMAT ( _traA / 1000000, "0.00", "pt-BR" ), _traA >= 999.5, FORMAT ( _traA / 1000, "0", "pt-BR" ), FORMAT ( _traA, "#,0", "pt-BR" ) )
			VAR _traUn = SWITCH ( TRUE (), _traA >= 999500, " mi", _traA >= 999.5, " mil", "" )
			VAR _traN = _traNu & _traUn
			VAR _traZero = _traN = "0"
			VAR _traS = IF ( _traZero, "", SWITCH ( TRUE (), _ra < 0, "−", _ra > 0, "+", "" ) )
			VAR _traTxt = IF ( ISBLANK ( _ra ), "—", _traS & "R$ " & _traN )
			VAR _tarA = ABS ( _ar )
			VAR _tarNu = SWITCH ( TRUE (), _tarA >= 99950000, FORMAT ( _tarA / 1000000, "0.0", "pt-BR" ), _tarA >= 999500, FORMAT ( _tarA / 1000000, "0.00", "pt-BR" ), _tarA >= 999.5, FORMAT ( _tarA / 1000, "0", "pt-BR" ), FORMAT ( _tarA, "#,0", "pt-BR" ) )
			VAR _tarUn = SWITCH ( TRUE (), _tarA >= 999500, " mi", _tarA >= 999.5, " mil", "" )
			VAR _tarN = _tarNu & _tarUn
			VAR _tarZero = _tarN = "0"
			VAR _tarS = IF ( _tarZero, "", IF ( _ar < 0, "−", "" ) )
			VAR _tarTxt = IF ( ISBLANK ( _ar ), "—", _tarS & "R$ " & _tarN )
			VAR _tresA = ABS ( _res )
			VAR _tresNu = SWITCH ( TRUE (), _tresA >= 99950000, FORMAT ( _tresA / 1000000, "0.0", "pt-BR" ), _tresA >= 999500, FORMAT ( _tresA / 1000000, "0.00", "pt-BR" ), _tresA >= 999.5, FORMAT ( _tresA / 1000, "0", "pt-BR" ), FORMAT ( _tresA, "#,0", "pt-BR" ) )
			VAR _tresUn = SWITCH ( TRUE (), _tresA >= 999500, " mi", _tresA >= 999.5, " mil", "" )
			VAR _tresN = _tresNu & _tresUn
			VAR _tresZero = _tresN = "0"
			VAR _tresS = IF ( _tresZero, "", SWITCH ( TRUE (), _res < 0, "−", _res > 0, "+", "" ) )
			VAR _tresTxt = IF ( ISBLANK ( _res ), "—", _tresS & "R$ " & _tresN )
			VAR _tdvA = ABS ( _divida )
			VAR _tdvNu = SWITCH ( TRUE (), _tdvA >= 99950000, FORMAT ( _tdvA / 1000000, "0.0", "pt-BR" ), _tdvA >= 999500, FORMAT ( _tdvA / 1000000, "0.00", "pt-BR" ), _tdvA >= 999.5, FORMAT ( _tdvA / 1000, "0", "pt-BR" ), FORMAT ( _tdvA, "#,0", "pt-BR" ) )
			VAR _tdvUn = SWITCH ( TRUE (), _tdvA >= 999500, " mi", _tdvA >= 999.5, " mil", "" )
			VAR _tdvN = _tdvNu & _tdvUn
			VAR _tdvZero = _tdvN = "0"
			VAR _tdvS = IF ( _tdvZero, "", IF ( _divida < 0, "−", "" ) )
			VAR _tdvTxt = IF ( ISBLANK ( _divida ), "—", _tdvS & "R$ " & _tdvN )
			VAR _tvaKP = LEN ( _tvaNu ) > 0
			VAR _tvaKN = IF ( _tvaKP, _tvaNu )
			VAR _tvaKS = SUBSTITUTE ( SUBSTITUTE ( _tvaKN, ".", "" ), ",", "" )
			VAR _tvaKT = IFERROR ( VALUE ( _tvaKS ), -1 )
			VAR _tvaKOk = _tvaKP && _tvaKT >= 2 && FORMAT ( _tvaKT, REPT ( "0", LEN ( _tvaKS ) ) ) = _tvaKS
			VAR _tvaKD = IF ( CONTAINSSTRING ( _tvaKN, "," ), LEN ( _tvaKN ) - SEARCH ( ",", _tvaKN ), 0 )
			VAR _tvaKM = IF ( CONTAINSSTRING ( _tvaKN, "." ), "#,##0", "0" ) & IF ( _tvaKD > 0, "." & REPT ( "0", _tvaKD ) )
			VAR _tvaKOd =
			    IF (
			        _tvaKOk,
			        "<o-d><o-v>" & _tvaKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tvaKN, FORMAT ( ROUND ( _tvaKT * [@odf] / 1000, 0 ) / POWER ( 10, _tvaKD ), _tvaKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tvaNu
			    )
			VAR _tvaOd = IF ( ISBLANK ( _va ), _tvaTxt, _tvaS & "R$ " & _tvaKOd & _tvaUn )
			VAR _tcaKP = LEN ( _tcaNu ) > 0
			VAR _tcaKN = IF ( _tcaKP, _tcaNu )
			VAR _tcaKS = SUBSTITUTE ( SUBSTITUTE ( _tcaKN, ".", "" ), ",", "" )
			VAR _tcaKT = IFERROR ( VALUE ( _tcaKS ), -1 )
			VAR _tcaKOk = _tcaKP && _tcaKT >= 2 && FORMAT ( _tcaKT, REPT ( "0", LEN ( _tcaKS ) ) ) = _tcaKS
			VAR _tcaKD = IF ( CONTAINSSTRING ( _tcaKN, "," ), LEN ( _tcaKN ) - SEARCH ( ",", _tcaKN ), 0 )
			VAR _tcaKM = IF ( CONTAINSSTRING ( _tcaKN, "." ), "#,##0", "0" ) & IF ( _tcaKD > 0, "." & REPT ( "0", _tcaKD ) )
			VAR _tcaKOd =
			    IF (
			        _tcaKOk,
			        "<o-d><o-v>" & _tcaKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcaKN, FORMAT ( ROUND ( _tcaKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcaKD ), _tcaKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcaNu
			    )
			VAR _tcaOd = IF ( ISBLANK ( _ca ), _tcaTxt, _tcaS & "R$ " & _tcaKOd & _tcaUn )
			VAR _tarKP = LEN ( _tarNu ) > 0
			VAR _tarKN = IF ( _tarKP, _tarNu )
			VAR _tarKS = SUBSTITUTE ( SUBSTITUTE ( _tarKN, ".", "" ), ",", "" )
			VAR _tarKT = IFERROR ( VALUE ( _tarKS ), -1 )
			VAR _tarKOk = _tarKP && _tarKT >= 2 && FORMAT ( _tarKT, REPT ( "0", LEN ( _tarKS ) ) ) = _tarKS
			VAR _tarKD = IF ( CONTAINSSTRING ( _tarKN, "," ), LEN ( _tarKN ) - SEARCH ( ",", _tarKN ), 0 )
			VAR _tarKM = IF ( CONTAINSSTRING ( _tarKN, "." ), "#,##0", "0" ) & IF ( _tarKD > 0, "." & REPT ( "0", _tarKD ) )
			VAR _tarKOd =
			    IF (
			        _tarKOk,
			        "<o-d><o-v>" & _tarKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tarKN, FORMAT ( ROUND ( _tarKT * [@odf] / 1000, 0 ) / POWER ( 10, _tarKD ), _tarKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tarNu
			    )
			VAR _tarOd = IF ( ISBLANK ( _ar ), _tarTxt, _tarS & "R$ " & _tarKOd & _tarUn )
			VAR _txtIdc = FORMAT ( _idc, "0.00", "pt-BR" )
			VAR _txtSob = "LEITURA · COMO O RESULTADO SE FORMA · " & UPPER ( _obra ) & " · " & [Mês de referência · curto maiúsculo]
			VAR _txtAchado =
			    IF (
			        _ra >= 0,
			        "A obra agregou mais do que gastou no que executou: resultado aplicado de " & "<span class='nw'>" & "⁅" & _traTxt & "⁆" & "</span>" & ", IDC " & "⁅" & _txtIdc & "⁆" & ".",
			        "A obra gastou mais do que agregou no que executou: resultado aplicado de " & "<span class='nw'>" & "<span class='ng'>" & "⁅" & _traTxt & "⁆" & "</span>" & "</span>" & ", IDC " & "⁅" & _txtIdc & "⁆" & "."
			    )
			VAR _txtExplica =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _ar ) || _ar = 0, "A planilha não soma nada a realizar: o resultado dela é o aplicado.",
			        _ra < 0 && _res >= 0, "A planilha mostra " & "<span class='nw'>" & "⁅" & _tresTxt & "⁆" & "</span>" & " porque soma " & "<span class='nw'>" & "⁅" & _tarTxt & "⁆" & "</span>" & " a realizar (saldo de contrato e equipamentos), que ainda não aconteceu.",
			        "A planilha soma " & "<span class='nw'>" & "⁅" & _tarTxt & "⁆" & "</span>" & " a realizar (saldo de contrato e equipamentos) e chega a " & "<span class='nw'>" & "⁅" & _tresTxt & "⁆" & "</span>" & "."
			    )
			    & IF ( _divida > 0, " A dívida da obra (" & "<span class='nw'>" & "⁅" & _tdvTxt & "⁆" & "</span>" & ") entra no custo.", "" )
			-- 4 · Marcação
			VAR _htmlDst =
			    "<div class='dst sobre-creme'>"
			        & "<div><b>" & _tvaOd & "</b><span>" & "agregados: o executado vezes o orçamento" & "</span></div>"
			        & "<div><b>" & _tcaOd & "</b><span>" & "de custo do que já virou obra, com a dívida" & "</span></div>"
			        & "<div><b>" & _tarOd & "</b><span>" & "a realizar: a planilha conta e ainda não aconteceu" & "</span></div>"
			    & "</div>"
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _txtAchado & "</h2>"
			        & "<p class='exp'>" & _txtExplica & "</p>" & _htmlDst
			VAR _saidaHtml =
			    IF ( NOT ISBLANK ( _res ), "<div class='u lv' role='dialog' aria-label='" & "Leitura de Como o resultado se forma" & "'><div class='pn '>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Leituras
		lineageTag: 247cfb91-9320-5e0a-b1f7-aea84468e0e0

	/// Leitura do "?" de Itens da nota, sobre o painel (548 × 767, desde a F3; era 372 × 388): a nota e o status da obra em foco (ou, pendente, quantos itens faltam e quanto já perde) e de onde vêm os pontos perdidos; a matriz item × mês com as marcas dos pontos e a linha da obra com o status de cada mês. Só lê contas.
	measure 'T2 · Leitura itens da nota · HTML' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _obra = [Nota · obra em foco]
			VAR _mesC = [Mês de referência · curto maiúsculo]
			VAR _mesN = [Mês de referência · nome]
			VAR _nota = [Nota · nota final · ranking · foco]
			VAR _st = [Nota · status · ranking · foco]
			VAR _pend = [Nota · pendente · ranking · foco]
			VAR _pe = [Nota · pontos perdidos · ranking · foco]
			VAR _po = [Nota · pontos possíveis · ranking · foco]
			VAR _faltB = [Nota · itens faltando na base · foco] + 0
			VAR _faltP = [Nota · itens faltando na planilha · foco] + 0
			VAR _fora = [Nota · itens fora da faixa · foco] + 0
			VAR _fB = _faltB - _fora
			VAR _plL = [Nota · itens faltando na planilha (lista) · foco] & ""
			VAR _plF = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = PATHITEM ( _plL, 1 ) )
			VAR _perdemCod = [T2 · Leitura · itens que perdem pontos (lista) · foco]
			VAR _nPerdem = IF ( _perdemCod = "", 0, PATHLENGTH ( _perdemCod ) ) /* geometria */
			VAR _c1 = PATHITEM ( _perdemCod, 1 )
			VAR _c2 = PATHITEM ( _perdemCod, 2 )
			VAR _c3 = PATHITEM ( _perdemCod, 3 )
			VAR _nTopo = [T2 · Leitura · itens que mais perdem (quantos) · foco] + 0
			VAR _mx = [T2 · Leitura · pontos de cada item, mês a mês (lista) · foco]
			VAR _p1 = CALCULATE ( [Nota · item · perdidos · foco], dItemNota[Item] = _c1 )
			VAR _p2 = CALCULATE ( [Nota · item · perdidos · foco], dItemNota[Item] = _c2 )
			VAR _f1 = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c1 )
			VAR _f2 = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c2 )
			VAR _p3 = CALCULATE ( [Nota · item · perdidos · foco], dItemNota[Item] = _c3 )
			VAR _f3 = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c3 )
			VAR _itens =
			    ADDCOLUMNS (
			        VALUES ( dItemNota[Item] ),
			        "@o", [Nota · item · ordem],
			        "@rot", [Nota · item · nome curto]
			    )
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@ord", [Mês · ordem],
			        "@rot", [Mês · abreviado]
			    )
			VAR _serie = FILTER ( _meses, [@ate] = 1 ) /* lista */
			VAR _nCol = COUNTROWS ( _serie ) /* geometria */
			-- 2 · Textos
			VAR _nN = FORMAT ( _nota, "0.0#", "pt-BR" )
			VAR _nOb = FORMAT ( [Nota · pontos obtidos · ranking · foco], "0.0#", "pt-BR" )
			VAR _nPo = FORMAT ( _po, "0.0#", "pt-BR" )
			VAR _nTxt = SWITCH ( TRUE (), _pend = 1, "pendente · " & _nOb & " de " & _nPo, ISBLANK ( _nota ), "—", "nota " & _nN )
			VAR _tpeTxt = IF ( ISBLANK ( _pe ), "—", FORMAT ( _pe, "0.0#", "pt-BR" ) )
			VAR _tpoTxt = IF ( ISBLANK ( _po ), "—", FORMAT ( _po, "0.0#", "pt-BR" ) )
			VAR _tp1Txt = IF ( ISBLANK ( _p1 ), "—", FORMAT ( _p1, "0.0#", "pt-BR" ) )
			VAR _tp2Txt = IF ( ISBLANK ( _p2 ), "—", FORMAT ( _p2, "0.0#", "pt-BR" ) )
			VAR _txtSob = "LEITURA · ITENS DA NOTA · " & UPPER ( _obra ) & " · " & _mesC
			VAR _de1 = SWITCH ( TRUE (), LEFT ( _f1, 3 ) = "os ", "dos " & MID ( _f1, 4, 99 ), LEFT ( _f1, 3 ) = "as ", "das " & MID ( _f1, 4, 99 ), LEFT ( _f1, 2 ) = "o ", "do " & MID ( _f1, 3, 99 ), LEFT ( _f1, 2 ) = "a ", "da " & MID ( _f1, 3, 99 ), _f1 )
			VAR _de2 = SWITCH ( TRUE (), LEFT ( _f2, 3 ) = "os ", "dos " & MID ( _f2, 4, 99 ), LEFT ( _f2, 3 ) = "as ", "das " & MID ( _f2, 4, 99 ), LEFT ( _f2, 2 ) = "o ", "do " & MID ( _f2, 3, 99 ), LEFT ( _f2, 2 ) = "a ", "da " & MID ( _f2, 3, 99 ), _f2 )
			VAR _de3 = SWITCH ( TRUE (), LEFT ( _f3, 3 ) = "os ", "dos " & MID ( _f3, 4, 99 ), LEFT ( _f3, 3 ) = "as ", "das " & MID ( _f3, 4, 99 ), LEFT ( _f3, 2 ) = "o ", "do " & MID ( _f3, 3, 99 ), LEFT ( _f3, 2 ) = "a ", "da " & MID ( _f3, 3, 99 ), _f3 )
			VAR _em1 = SWITCH ( TRUE (), LEFT ( _f1, 3 ) = "os ", "nos " & MID ( _f1, 4, 99 ), LEFT ( _f1, 3 ) = "as ", "nas " & MID ( _f1, 4, 99 ), LEFT ( _f1, 2 ) = "o ", "no " & MID ( _f1, 3, 99 ), LEFT ( _f1, 2 ) = "a ", "na " & MID ( _f1, 3, 99 ), _f1 )
			VAR _em2 = SWITCH ( TRUE (), LEFT ( _f2, 3 ) = "os ", "nos " & MID ( _f2, 4, 99 ), LEFT ( _f2, 3 ) = "as ", "nas " & MID ( _f2, 4, 99 ), LEFT ( _f2, 2 ) = "o ", "no " & MID ( _f2, 3, 99 ), LEFT ( _f2, 2 ) = "a ", "na " & MID ( _f2, 3, 99 ), _f2 )
			VAR _em3 = SWITCH ( TRUE (), LEFT ( _f3, 3 ) = "os ", "nos " & MID ( _f3, 4, 99 ), LEFT ( _f3, 3 ) = "as ", "nas " & MID ( _f3, 4, 99 ), LEFT ( _f3, 2 ) = "o ", "no " & MID ( _f3, 3, 99 ), LEFT ( _f3, 2 ) = "a ", "na " & MID ( _f3, 3, 99 ), _f3 )
			VAR _seg = _nTopo = 1 && _nPerdem >= 2 && ( _nPerdem = 2 || ROUND ( _p2 - _p3, 8 ) <> 0 )
			VAR _deTopo = SWITCH ( _nTopo, 1, _de1, 2, _de1 & " e " & _de2, 3, _de1 & ", " & _de2 & " e " & _de3, "de " & SWITCH ( _nTopo, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _nTopo, "0" ) ) & " itens empatados" )
			VAR _emTopo = SWITCH ( _nTopo, 1, _em1, 2, _em1 & " e " & _em2, 3, _em1 & ", " & _em2 & " e " & _em3, "em " & SWITCH ( _nTopo, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _nTopo, "0" ) ) & " itens empatados" )
			VAR _txtOnde =
			    SWITCH (
			        TRUE (),
			        _nPerdem = 1, "todos " & _de1,
			        _nTopo = _nPerdem, "todos " & _deTopo & ", " & "⁅" & _tp1Txt & "⁆" & " cada",
			        _nTopo > 3, _deTopo & ", " & "⁅" & _tp1Txt & "⁆" & " cada",
			        _nTopo > 1, "mais " & _deTopo & ", " & "⁅" & _tp1Txt & "⁆" & " cada",
			        _seg, "mais " & _de1 & " (" & "⁅" & _tp1Txt & "⁆" & ") e " & _de2 & " (" & "⁅" & _tp2Txt & "⁆" & ")",
			        "mais " & _de1 & " (" & "⁅" & _tp1Txt & "⁆" & ")"
			    )
			VAR _txtTotal = IF ( _tpeTxt = _nN || _tpeTxt = _tp1Txt, "Os pontos perdidos", "Os " & "⁅" & _tpeTxt & "⁆" & " pontos perdidos" )
			VAR _txtFalta =
			    SWITCH ( TRUE (),
			        _fB > 0 && _faltP > 0, "faltam " & SWITCH ( _fB + _faltP, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _fB + _faltP, "0" ) ) & " itens, " & SWITCH ( _faltP, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _faltP, "0" ) ) & " na planilha",
			        _fB > 0, IF ( _fB = 1, "falta um item", "faltam " & SWITCH ( _fB, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _fB, "0" ) ) & " itens" ) & " na base",
			        _faltP > 0, IF ( _faltP = 1, "falta " & _plF, "faltam " & SWITCH ( _faltP, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _faltP, "0" ) ) & " itens" ) & " na planilha",
			        ""
			    )
			VAR _txtFora =
			    IF ( _fora = 0, "",
			        IF ( _txtFalta = "",
			            IF ( _fora = 1, "um item está fora da faixa", SWITCH ( _fora, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _fora, "0" ) ) & " itens estão fora da faixa" ),
			            "; " & IF ( _fora = 1, "um está fora da faixa", SWITCH ( _fora, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _fora, "0" ) ) & " estão fora da faixa" ) ) )
			VAR _txtAchado =
			    SWITCH (
			        TRUE (),
			        _pend = 1,
			            "Pendente: " & _txtFalta & _txtFora & ". "
			            & IF ( _pe = 0, "No que já dá para calcular, não perde ponto.",
			                "No que já dá para calcular, perde " & "⁅" & _tpeTxt & "⁆" & " de " & "⁅" & _tpoTxt & "⁆" & ", mais " & _emTopo & "." ),
			        _pe = 0, "Nota " & "⁅" & _nN & "⁆" & ", " & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & ": não perde ponto em nenhum item.",
			        "Nota " & "⁅" & _nN & "⁆" & ", " & IF ( _st = 1, "em ", "" ) & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & ". " & _txtTotal & " vêm " & _txtOnde & "."
			    )
			VAR _htmlCab =
			    "<span></span>" & CONCATENATEX (
			        _serie,
			        VAR _vePar = _nCol <= 7 || MOD ( DATEDIFF ( dMes[Mes], _ref, MONTH ), 2 ) = 0
			        RETURN
			            "<span class='h a-fd" & IF ( dMes[Mes] = _ref, " ref", "" ) & "' style='animation-delay:" & ( [@ord] - 1 ) * 100 & "ms'>" & IF ( _vePar, [@rot], "" ) & "</span>",
			        "",
			        dMes[Mes], ASC
			    )
			VAR _htmlLinhas =
			    CONCATENATEX (
			        _itens,
			        VAR _i = dItemNota[Item]
			        RETURN
			            "<span class='r'>" & [@rot] & "</span>"
			                & CONCATENATEX (
			                    _serie,
			                    VAR _m = dMes[Mes]
			                    VAR _k = _i & "@" & FORMAT ( _m, "yyyymm" ) & "="
			                    VAR _pk = SEARCH ( _k, _mx, 1, 0 )
			                    VAR _c = IF ( _pk = 0, "f", MID ( _mx, _pk + LEN ( _k ), 1 ) )
			                    VAR _cls = SWITCH ( _c, "c", "mk0", "p", "mk1", "z", "mk2", "n", "mkn", "x", "mkx", "mkm" )
			                    VAR _atraso = ( [@ord] - 1 ) * 100 -- geometria
			                    RETURN
			                        "<span class='c'><i class='mk " & _cls & "' style='animation-delay:" & _atraso & "ms'></i></span>",
			                    "",
			                    dMes[Mes], ASC
			                ),
			        "",
			        [@o], ASC
			    )
			VAR _htmlObra =
			    "<span class='r ob'>Obra</span>" & CONCATENATEX (
			        _serie,
			        VAR _atraso = 600 + ( [@ord] - 1 ) * 100 -- geometria
			        VAR _k = "obra@" & FORMAT ( dMes[Mes], "yyyymm" ) & "="
			        VAR _pk = SEARCH ( _k, _mx, 1, 0 )
			        VAR _c = IF ( _pk = 0, "", MID ( _mx, _pk + LEN ( _k ), 1 ) )
			        VAR _mk = IF ( _c IN { "", "|" }, "", "<i class='mk mk" & _c & "'></i>" )
			        RETURN
			            "<span class='c ob'>" & SUBSTITUTE ( _mk, "'></i>", "' style='animation-delay:" & _atraso & "ms'></i>" ) & "</span>",
			        "",
			        dMes[Mes], ASC
			    )
			VAR _htmlLeg =
			    "<p class='lg'><i class='mk mk0'></i>cheio<i class='mk mk1'></i>parcial<i class='mk mk2'></i>zero"
			        & "<i class='mk mkm'></i>sem dado" & IF ( SEARCH ( "=x", _mx, 1, 0 ) > 0, "<i class='mk mkx'></i>fora", "" ) & "</p>"
			-- 4 · Marcação
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _txtAchado & "</h2>"
			        & "<div class='sec' style='margin-top:10px'><span class='vs'>Pontos de cada item, mês a mês</span>"
			        & "<div class='mx c8' style='grid-template-columns:132px repeat(" & _nCol & ",1fr)'>" & _htmlCab & _htmlLinhas & _htmlObra & "</div>" & _htmlLeg & "</div>"
			VAR _saidaHtml =
			    IF ( NOT ISBLANK ( _po ), "<div class='u lv' role='dialog' aria-label='" & "Leitura de Itens da nota" & "'><div class='pn e it'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida] )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Leituras
		lineageTag: 110c2320-30ee-559d-8fc4-e237c52e1346

	/// Leitura do "?" de IDC, mês a mês, sobre o painel (508 × 377, condensada): de onde o IDC saiu e onde está, desde quando está abaixo de 1 (se estiver), quantos meses da janela ficaram abaixo, e três destaques que contam (IDC de agora, o menor da janela e a trava). Só lê contas.
	measure 'T2 · Leitura mês a mês · HTML' =
			-- 1 · Leituras
			VAR _obra = [Nota · obra em foco]
			VAR _ref = [Mês de referência]
			VAR _ini = [T2 · Leitura · primeiro mês com aba · foco]
			VAR _idc = [IDC · foco]
			VAR _idcIni = [T2 · IDC · no primeiro mês com aba · foco]
			VAR _min = [T2 · IDC · mínimo na janela]
			VAR _mMin = [T2 · IDC · mês do menor]
			VAR _nAbx = [T2 · IDC · meses abaixo de 1 na janela] + 0
			VAR _desde = [T2 · IDC · abaixo de 1 desde]
			VAR _nMeses = [T2 · Leitura · meses com aba · foco] + 0
			VAR _trv = [Nota · limite custo · trava]
			-- 2 · Textos
			VAR _t = FORMAT ( _idc, "0.00", "pt-BR" )
			VAR _tIni = FORMAT ( _idcIni, "0.00", "pt-BR" )
			VAR _tMin = FORMAT ( _min, "0.00", "pt-BR" )
			VAR _tTrv = FORMAT ( _trv, "0.00", "pt-BR" )
			VAR _txtSob = "LEITURA · IDC, MÊS A MÊS · " & UPPER ( _obra ) & " · " & [Mês de referência · curto maiúsculo]
			VAR _txtAchado =
			    SWITCH (
			        TRUE (),
			        _ini = _ref || ISBLANK ( _idcIni ), "IDC de " & "⁅" & _t & "⁆" & " no primeiro mês com planilha na janela.",
			        ROUND ( _idc, 2 ) = ROUND ( _idcIni, 2 ), "O IDC está em " & "⁅" & _t & "⁆" & ", o mesmo de " & FORMAT ( _ini, "mmmm", "pt-BR" ) & ".",
			        "O IDC foi de " & "⁅" & _tIni & "⁆" & " em " & FORMAT ( _ini, "mmmm", "pt-BR" ) & " para " & "⁅" & _t & "⁆" & " agora."
			    )
			VAR _txtExplica =
			    SWITCH (
			        TRUE (),
			        _nAbx = 0, "Em nenhum mês da janela a obra gastou mais do que agregou.",
			        NOT ISBLANK ( _desde ) && _desde = _ini, "Abaixo de 1 em todos os meses com planilha: a obra gasta mais do que agrega.",
			        NOT ISBLANK ( _desde ), "Abaixo de 1 desde " & FORMAT ( _desde, "mmmm", "pt-BR" ) & ": " & "⁅" & _nAbx & "⁆" & IF ( _nAbx = 1, " mês", " meses" ) & " da janela gastando mais do que agrega.",
			        "⁅" & _nAbx & "⁆" & IF ( _nAbx = 1, " mês", " meses" ) & " da janela abaixo de 1; agora a obra agrega o que gasta."
			    )
			    & IF ( _idc < _trv, " Abaixo de " & "⁅" & _tTrv & "⁆" & ", a obra fica crítica pela trava.", "" )
			-- 4 · Marcação
			VAR _htmlDst =
			    "<div class='dst sobre-creme'>"
			        & "<div><b>" & "<span class='" & IF ( _idc < 1, "ng", "" ) & "'>" & "⁅" & _t & "⁆" & "</span>" & "</b><span>" & "IDC no mês de referência" & "</span></div>"
			        & "<div><b>" & "⁅" & _tMin & "⁆" & "</b><span>" & "o menor da janela, em " & FORMAT ( _mMin, "mmm/yy", "pt-BR" ) & "</span></div>"
			        & "<div><b>" & "⁅" & _nAbx & "⁆" & " de " & "⁅" & _nMeses & "⁆" & "</b><span>" & "meses abaixo de 1 na janela" & "</span></div>"
			    & "</div>"
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _txtAchado & "</h2>"
			        & "<p class='exp'>" & _txtExplica & "</p>" & _htmlDst
			VAR _saidaHtml =
			    IF ( NOT ISBLANK ( _idc ), "<div class='u lv' role='dialog' aria-label='" & "Leitura de IDC, mês a mês" & "'><div class='pn '>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida] )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Leituras
		lineageTag: 31edd3e9-782f-5097-9bf2-87531418f291

	/// Leitura do "?" de A nota, mês a mês, sobre o painel (372 × 388, estreita): de onde a nota saiu e onde está, o status e a trava, quantos meses da janela foram críticos, e dois destaques que contam. Só lê contas.
	measure 'T2 · Leitura nota mês a mês · HTML' =
			-- 1 · Leituras
			VAR _obra = [Nota · obra em foco]
			VAR _ini = [T2 · Nota · primeiro mês com nota na janela · foco]
			VAR _ult = [T2 · Nota · último mês com nota na janela · foco]
			VAR _nIni = [T2 · Nota · no primeiro mês com nota na janela · foco]
			VAR _nota = [Nota · nota final · ranking · foco]
			VAR _st = [Nota · status · ranking · foco]
			VAR _pend = [Nota · pendente · ranking · foco]
			VAR _trv = [Nota · trava · motivo · foco] & ""
			VAR _nCrit = [T2 · Nota · meses críticos na janela · foco] + 0
			-- 2 · Textos
			VAR _t = FORMAT ( _nota, "0.0#", "pt-BR" )
			VAR _tIni = FORMAT ( _nIni, "0.0#", "pt-BR" )
			VAR _txtSob = "LEITURA · A NOTA, MÊS A MÊS · " & UPPER ( _obra )
			VAR _txtAchado =
			    SWITCH (
			        TRUE (),
			        _pend = 1, "Sem nota no mês de referência: falta item.",
			        ISBLANK ( _ini ) || _ini = _ult, "Nota " & "⁅" & _t & "⁆" & ", a primeira da janela.",
			        ROUND ( _nota, 2 ) = ROUND ( _nIni, 2 ), "Nota " & "⁅" & _t & "⁆" & ", a mesma de " & FORMAT ( _ini, "mmmm", "pt-BR" ) & ".",
			        "A nota foi de " & "⁅" & _tIni & "⁆" & " em " & FORMAT ( _ini, "mmmm", "pt-BR" ) & " para " & "⁅" & _t & "⁆" & "."
			    )
			VAR _txtExplica =
			    IF ( _pend = 1, "",
			        "Hoje está " & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" )
			            & IF ( _trv <> "", ", pela trava de " & SUBSTITUTE ( _trv, "|", " e " ), "" ) & ". "
			            & SWITCH ( _nCrit, 0, "Nenhum mês da janela foi crítico.", 1, "Um mês da janela foi crítico.", "⁅" & _nCrit & "⁆" & " meses da janela foram críticos." ) )
			-- 4 · Marcação
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _txtAchado & "</h2>"
			        & "<p class='exp'>" & _txtExplica & "</p>"
			VAR _saidaHtml =
			    IF ( NOT ISBLANK ( _ult ), "<div class='u lv' role='dialog' aria-label='" & "Leitura de A nota, mês a mês" & "'><div class='pn e'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida] )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Leituras
		lineageTag: 8fdb950c-0f3c-58f0-9ab5-19d8692a3646

	/// CSS v2 das leituras do "?" (superfície do tamanho do painel, achado, explicação, destaques, seções e a matriz dos itens da nota) e do guia da Tela 02 (1120, duas colunas). Não depende da CSS da T1.
	measure 'T2 · Leitura · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".lv{position:fixed;inset:0}.lv .pn{position:absolute;inset:0;background:#FFFFFF;border:1px solid #0B0B0C;border-radius:16px;overflow:hidden;color:#0B0B0C;padding:18px 20px}.lv .pn."
			    & "q{padding:18px 24px}.lv .pn.e{padding:18px 18px}.lv .sob{display:block;padding-right:32px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.lv .ach span,.lv .exp span,.lv "
			    & ".nw{white-space:nowrap}.lv .ach{margin-top:12px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:21px;line-height:26px}.lv .pn.q .ach{font-size:23px;line-heig"
			    & "ht:28px}.lv .exp{margin-top:10px;font-size:17px;line-height:26px;color:#3B3B3F}.lv .dst{margin-top:14px;background:#E9E0CF;display:grid;grid-template-columns:repeat(3,1fr);column-g"
			    & "ap:14px;padding:12px 16px}.lv .dst b{display:block;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:23px;line-height:28px;white-space:nowrap;font-variant-nume"
			    & "ric:tabular-nums}.lv .dst>div>span{display:block;margin-top:2px;font-size:14px;line-height:19px;color:#3B3B3F}.lv .sec{margin-top:14px}.lv .sec>.vs{display:block;margin-bottom:4px}"
			    & ".lv .oqe{font-size:15px;line-height:21px}.lv .mx{display:grid;align-items:center;row-gap:2px;margin-top:8px;font-size:14px;line-height:19px}.lv .mx .h{text-align:center;font-size:1"
			    & "3px;line-height:16px;white-space:nowrap;color:#3B3B3F}.lv .mx .h.ref{font-weight:600;color:#0B0B0C}.lv .mx .r{white-space:nowrap}.lv .mx .c{display:flex;justify-content:center}.lv "
			    & ".mx .ob{border-top:1px solid #E1E1E1;padding-top:5px;margin-top:4px}.lv .mx .r.ob{font-weight:600;font-size:15px;line-height:21px}.lv .mx .c .mk{animation:mxEntra .25s ease-out bac"
			    & "kwards}@keyframes mxEntra{from{opacity:0;transform:scale(.4)}}@media (prefers-reduced-motion:reduce){.lv .mx .c .mk{animation:none}}.lv .pn.e.it{padding:14px 18px}.lv .pn.e.it .ach"
			    & "{margin-top:8px}.lv .mx.c8{row-gap:0;margin-top:4px;font-size:13px;line-height:15px}.lv .mx.c8 .r.ob{font-size:14px;line-height:19px}.lv .mk.mkn{box-shadow:inset 0 0 0 1px #C9C9CC}"
			    & ".lv .mk.mkx{border:1px dashed #C43737}.lv .lg{display:flex;align-items:center;gap:5px;margin-top:6px;font-size:13px;line-height:16px;color:#3B3B3F;white-space:nowrap}.lv .lg .mk{ma"
			    & "rgin-left:8px}.lv .lg .mk:first-child{margin-left:0}.lv svg.x{position:absolute;right:11px;top:7px;width:26px;height:26px;display:block;z-index:5}"
		displayFolder: T2 Análise crítica\Leituras
		lineageTag: 2efa7e92-cadc-56bb-9605-1d8d5de68af8

	/// Em quantos meses da janela (do primeiro mês da janela ao de referência) o item da linha teve valor diferente de zero na obra em foco: zero = o item não entrou na conta desta obra no período.
	measure 'Item · meses com valor · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", [Item · valor · foco no mês] )
			RETURN
			    COUNTROWS ( FILTER ( _meses, NOT ISBLANK ( [@v] ) && [@v] <> 0 ) ) + 0
		formatString: 0
		displayFolder: T2 Análise crítica\Leituras\Contas
		lineageTag: 3655b3c5-7bfd-5041-b397-a0487d18f016

	/// Quantos itens empatam no topo dos pontos perdidos da obra em foco no mês de referência (os primeiros da lista 'itens que perdem pontos'); vazio quando nenhum perde. A frase cita todos os empatados (auditoria da Fase 2, minor 2).
	measure 'T2 · Leitura · itens que mais perdem (quantos) · foco' =
			VAR _obra = [Nota · obra em foco]
			VAR _itens =
			    ADDCOLUMNS (
			        ALL ( dItemNota[Item] ),
			        "@p", ROUND ( CALCULATE ( [Nota · item · perdidos · ref], dObra[Obra] = _obra ), 8 )
			    )
			VAR _perdem = FILTER ( _itens, [@p] > 0 )
			VAR _max = MAXX ( _perdem, [@p] )
			RETURN
			    COUNTROWS ( FILTER ( _perdem, [@p] = _max ) )
		formatString: 0
		displayFolder: T2 Análise crítica\Leituras\Contas
		lineageTag: 17f69905-9564-5783-939c-e9704b2c0f35

	/// Códigos (dItemNota) dos itens que perdem pontos na obra em foco no mês de referência, do que mais perde ao que menos perde (empate pela ordem da régua), separados por '|'; vazio quando nenhum perde. A obra em foco é lida uma vez só (cada conta · foco a recalcula).
	measure 'T2 · Leitura · itens que perdem pontos (lista) · foco' =
			VAR _obra = [Nota · obra em foco]
			VAR _itens =
			    ADDCOLUMNS (
			        ALL ( dItemNota[Item] ),
			        "@p", CALCULATE ( [Nota · item · perdidos · ref], dObra[Obra] = _obra ),
			        "@o", [Nota · item · ordem]
			    )
			VAR _perdem = FILTER ( _itens, [@p] > 0 )
			RETURN
			    CONCATENATEX ( _perdem, dItemNota[Item], "|", [@p], DESC, [@o], ASC )
		displayFolder: T2 Análise crítica\Leituras\Contas
		lineageTag: 159ed3a0-9c7d-5db4-afaa-4d0fdb119c51

	/// Em quantos meses da janela (do primeiro mês da janela ao de referência) a obra em foco tem aba Análise Crítica.
	measure 'T2 · Leitura · meses com aba · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@r", [Resultado da obra · foco no mês] )
			RETURN
			    COUNTROWS ( FILTER ( _meses, NOT ISBLANK ( [@r] ) ) ) + 0
		formatString: 0
		displayFolder: T2 Análise crítica\Leituras\Contas
		lineageTag: 56f24158-be98-5a66-b78a-11d2b93c37ee

	/// Matriz item × mês da obra em foco na janela (do primeiro mês da janela ao de referência), como lista 'item@AAAAMM=classe' separada por '|': c cheio (todos os pontos possíveis), p parcial, z zero, f sem dado, x valor fora da faixa (sem pontos, mas não por falta; Fase 3, rodada 3), n neutro (item que vale 0 de 0); no fim, a linha da obra 'obra@AAAAMM=status' (2, 1, 0, m pendente). A obra em foco é lida uma vez só: cada leitura de uma conta · foco no mês recalcula a obra em foco, e a matriz faria mais de 80 delas.
	measure 'T2 · Leitura · pontos de cada item, mês a mês (lista) · foco' =
			VAR _obra = [Nota · obra em foco]
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _cel =
			    ADDCOLUMNS (
			        CROSSJOIN ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), ALL ( dItemNota[Item] ) ),
			        "@pt", CALCULATE ( [Nota · item · pontos], dObra[Obra] = _obra ),
			        "@ps", CALCULATE ( [Nota · item · possíveis], dObra[Obra] = _obra ),
			        "@fx", CALCULATE ( [Nota · item · fora da faixa], dObra[Obra] = _obra )
			    )
			RETURN
			    CONCATENATEX (
			        _cel,
			        dItemNota[Item] & "@" & FORMAT ( dMes[Mes], "yyyymm" ) & "="
			            & SWITCH (
			                TRUE (),
			                ISBLANK ( [@pt] ) && [@fx] = 1, "x",
			                ISBLANK ( [@pt] ), "f",
			                [@ps] = 0, "n",
			                [@pt] >= [@ps], "c",
			                [@pt] = 0, "z",
			                "p"
			            ),
			        "|"
			    )
			        & "|"
			        & CONCATENATEX (
			            FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			            VAR _st = CALCULATE ( [Nota · status · ranking], dObra[Obra] = _obra )
			            VAR _pd = CALCULATE ( [Nota · pendente · ranking], dObra[Obra] = _obra )
			            RETURN
			                "obra@" & FORMAT ( dMes[Mes], "yyyymm" ) & "=" & IF ( _pd = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ),
			            "|"
			        )
		displayFolder: T2 Análise crítica\Leituras\Contas
		lineageTag: df110c31-99e7-55ef-bd04-341b1837e662

	/// Primeiro mês da janela em que a obra em foco tem aba (jan/26 na REDINHA com janela de 12 em ago/26; jun/26 na TIROL).
	measure 'T2 · Leitura · primeiro mês com aba · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@r", [Resultado da obra · foco no mês] )
			RETURN
			    MINX ( FILTER ( _meses, NOT ISBLANK ( [@r] ) ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T2 Análise crítica\Leituras\Contas
		lineageTag: 62d8f0b8-c2c1-54c5-b095-2638ea8594f3

	/// CSS do painel 'A nota, mês a mês' (um HTML só, sem granularidade).
	measure 'T2 · Nota mês a mês · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".nm2{position:fixed;inset:0}.nm2 .ar{position:absolute;left:0;top:30px;width:372px;height:220px}.nm2 .lm{position:absolute;left:0;right:0;height:0;border-top:1px dashed #6B6B70}.nm"
			    & "2 .lm span{position:absolute;right:0;top:-16px;font-size:12px;line-height:14px;color:#6B6B70}.nm2 .z{position:absolute;left:0;right:0;height:1px;background:#0B0B0C}.nm2 .b{position"
			    & ":absolute;bottom:0;box-sizing:border-box}.nm2 .b.s2{background:#C43737}.nm2 .b.s1{background:#C9821F}.nm2 .b.s0{background:#A9CDB9}.nm2 .b.sm{background:#FFFFFF;border:1px dashed #"
			    & "3B3B3F}.nm2 .v{position:absolute;width:50px;margin-left:-25px;text-align:center;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;white-s"
			    & "pace:nowrap;font-variant-numeric:tabular-nums}.nm2 .ms{position:absolute;width:44px;margin-left:-22px;text-align:center;font-size:13px;line-height:16px;color:#3B3B3F;white-space:no"
			    & "wrap}.nm2 .ms.ref{font-weight:600;color:#0B0B0C}.nm2 .ms.sem{opacity:.35}.nm2 .tx{position:absolute;left:0;right:0;bottom:0;font-size:14px;line-height:19px;color:#3B3B3F}"
		displayFolder: T2 Análise crítica\Nota, mês a mês
		lineageTag: 86b64e27-52e3-5b4f-90e0-6dd3c5c2dab6

	/// A nota da obra em foco mês a mês na janela: barras na cor do status (pendente tracejado até os pontos obtidos) de 0 ao máximo da nota, linhas tracejadas nos limites de estável e de atenção (lidos das medidas), rótulo no mês de referência, na maior e na menor nota, e embaixo uma linha com o que a nota fez desde o primeiro mês da janela.
	measure 'T2 · Nota mês a mês · HTML' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _n = [Série · meses até a referência]
			VAR _max = [Nota · nota · máximo]
			VAR _limA = [Nota · status · nota mínima atenção]
			VAR _limE = [Nota · status · nota mínima estável]
			VAR _todos =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@pos", [Série · posição na janela],
			        "@rotAno", [Mês · rótulo curto],
			        "@rot", [Mês · abreviado],
			        "@nota", [Nota · nota final · foco no mês],
			        "@st", [Nota · status · foco no mês],
			        "@pend", [Nota · pendente · foco no mês],
			        "@obt", [Nota · pontos obtidos · foco no mês]
			    )
			VAR _meses = FILTER ( _todos, [@ate] = 1 ) /* lista */
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@nota] ) ) /* lista */
			VAR _vMax = MAXX ( _com, [@nota] ) /* geometria */
			VAR _vMin = MINX ( _com, [@nota] ) /* geometria */
			VAR _mMax = MAXX ( FILTER ( _com, [@nota] = _vMax ), dMes[Mes] ) /* geometria */
			VAR _mMin = MAXX ( FILTER ( _com, [@nota] = _vMin ), dMes[Mes] ) /* geometria */
			VAR _ini = MINX ( _com, dMes[Mes] ) /* geometria */
			VAR _nIni = MAXX ( FILTER ( _com, dMes[Mes] = _ini ), [@nota] ) /* geometria */
			VAR _nRef = MAXX ( FILTER ( _com, dMes[Mes] = _ref ), [@nota] ) /* geometria */
			-- 3 · Geometria
			VAR _slot = DIVIDE ( 372, _n ) -- geometria
			VAR _bw = MIN ( 24, ROUND ( _slot - 8, 0 ) ) -- geometria
			VAR _k = DIVIDE ( 196, _max ) -- geometria
			VAR _yA = 220 - ROUND ( _limA * _k, 0 ) -- geometria
			VAR _yE = 220 - ROUND ( _limE * _k, 0 ) -- geometria
			VAR _passo = ROUND ( DIVIDE ( 420, _n ), 0 ) -- geometria
			-- 2 · Textos
			VAR _txtVar =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _nRef ), "sem nota no mês de referência",
			        _ini = _ref || ISBLANK ( _nIni ), "primeiro mês com nota na janela",
			        ROUND ( _nRef, 2 ) = ROUND ( _nIni, 2 ), "mesma nota de " & FORMAT ( _ini, "mmm/yy", "pt-BR" ),
			        "de " & "⁅" & FORMAT ( _nIni, "0.0#", "pt-BR" ) & "⁆" & " em " & FORMAT ( _ini, "mmm/yy", "pt-BR" ) & " para " & "⁅" & FORMAT ( _nRef, "0.0#", "pt-BR" ) & "⁆" & " agora"
			    )
			-- 4 · Marcação
			VAR _barras =
			    CONCATENATEX (
			        _meses,
			        VAR _pd = [@pend] = 1
			        VAR _v = IF ( _pd, [@obt], [@nota] )
			        VAR _tem = NOT ISBLANK ( _v )
			        VAR _h = IF ( _tem, MAX ( ROUND ( _v * _k, 0 ), 2 ), 0 ) /* geometria */
			        VAR _xc = ROUND ( ( [@pos] - 0.5 ) * _slot, 0 ) /* geometria */
			        VAR _cls = IF ( _pd, "sm", "s" & [@st] )
			        VAR _ehRef = dMes[Mes] = _ref
			        VAR _rotula = _tem && NOT _pd && ( _ehRef || dMes[Mes] = _mMax || dMes[Mes] = _mMin || _n <= 6 )
			        VAR _rotMes = IF ( _n <= 6 || [@pos] = 1 || [@rot] = "jan", [@rotAno], [@rot] )
			        VAR _mostraMes = _slot >= 40 || MOD ( _n - [@pos], 2 ) = 0
			        VAR _rd = ( [@pos] - 1 ) * _passo /* geometria */
			        RETURN
			            IF ( _tem, "<i class='b " & _cls & "' style='left:" & ( _xc - ROUND ( _bw / 2, 0 ) ) & "px;width:" & _bw & "px;height:" & _h & "px' data-rk='n" & FORMAT ( dMes[Mes], "yyyymm" ) & "' data-rp='height' data-r0-height='0px' data-rd='" & _rd & "'></i>" ) /* geometria */
			                & IF ( _rotula, "<span class='v' style='left:" & _xc & "px;top:" & ( 220 - _h - 19 ) & "px'>" & "⁅" & FORMAT ( _v, "0.0#", "pt-BR" ) & "⁆" & "</span>" )
			                & IF ( _mostraMes, "<span class='ms a-fd" & IF ( _ehRef, " ref", IF ( _tem, "", " sem" ) ) & "' style='left:" & _xc & "px;top:226px;animation-delay:" & _rd & "ms'>" & _rotMes & "</span>" ),
			        "",
			        dMes[Mes], ASC
			    )
			VAR _saidaHtml =
			    IF (
			        NOT ISEMPTY ( _com ),
			        "<div class='u nm2'><div class='ar'>"
			            & "<i class='lm a-fd' style='top:" & _yE & "px'><span>estável</span></i>"
			            & "<i class='lm a-fd' style='top:" & _yA & "px;animation-delay:80ms'><span>atenção</span></i>"
			            & "<i class='z a-gx' style='top:220px'></i>" & _barras & "</div>"
			            & "<p class='tx'>" & _txtVar & "</p>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Nota, mês a mês
		lineageTag: c932ab4d-ae3b-53bc-b829-fee40de00d53

	/// Valor do item sobre o orçamento projetado (coluna % do quadradinho).
	measure 'Item · % do orçamento' =
			DIVIDE ( [Item · valor], [Orçamento] )
		formatString: 0.00%
