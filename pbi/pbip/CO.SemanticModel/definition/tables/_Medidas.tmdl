		displayFolder: Base\Obra
		lineageTag: 4326a590-1be2-5127-9e33-ee2ad389cd56

	/// Tipo do orçamento na aba do mês de referência, curto e minúsculo (preliminar, legal, executivo).
	measure 'Tipo de orçamento · ref' =
			VAR _mes = [Mês de referência]
			VAR _tipo =
			    CALCULATE ( SELECTEDVALUE ( fAnaliseCritica[TipoOrcamento] ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
			RETURN
			    LOWER ( TRIM ( SUBSTITUTE ( SUBSTITUTE ( _tipo, "Orçamento", "" ), "orçamento", "" ) ) )
		displayFolder: Base\Obra
		lineageTag: 27487463-005c-5bc3-bd8a-6694492cad91

