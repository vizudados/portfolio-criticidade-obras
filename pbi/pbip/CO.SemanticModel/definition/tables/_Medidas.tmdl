	/// CSS das colunas do painel Desembolso da carteira (uma entrada por mês da janela).
	measure 'T4 · Desembolso · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & "#htmlContent{display:flex!important;align-items:flex-start;width:100vw;height:100vh;margin:0!important;padding:0!important}.htmlViewerEntry{display:block!important;flex:1 1 0;min-w"
			    & "idth:0;margin:0!important;padding:0!important}.dc{position:relative;height:279px;transition:background .15s}.dc:hover,.htmlViewerEntry.hover .dc{background:rgba(233,224,207,.3)}.dc"
			    & " .rz{position:absolute;left:0;right:0;top:255px;height:1px;background:#6B6B70}.dc .bp,.dc .bd{position:absolute}.dc .bp{background:#E9E0CF}.dc .bd{background:#0B0B0C}.dc .dv{positi"
			    & "on:absolute;text-align:center;font-size:14px;line-height:17px;white-space:nowrap;color:#0B0B0C}.dc .dv.d13{font-size:13px}.dc .ms{position:absolute;left:0;right:0;top:263px;text-al"
			    & "ign:center;font-size:13px;line-height:16px;color:#3B3B3F;white-space:nowrap}.dc .ms.ref{font-weight:600;color:#0B0B0C}.dc .ms.sem{opacity:.35}"
		displayFolder: T4 Resultado no tempo\Desembolso da carteira
		lineageTag: 7d28bb1e-4213-56b2-8b7e-3c3fe0923303

	/// Um par de colunas por mês da janela (granularidade dMes[Mes]; coluna = 1068 ÷ n, barra = mín(44; 0,36 × coluna)): previsto (creme) × desembolsado (preto) na mesma escala, com o desvio sobre o previsto em cima (só as obras com previsto; preto também quando negativo; cabe em todo mês até 12; 13 px a partir de 10). Mês de referência em semibold; mês sem aba só com o rótulo apagado; o ano entra no primeiro mês e em janeiro quando a janela cruza a virada. As colunas correm da base em cascata e o desvio conta.
	measure 'T4 · Desembolso · HTML coluna' =
			-- 1 · Leituras
			VAR _noRecorte = [Série · mês até a referência]
			VAR _prev = [Desembolso · previsto no mês]
			VAR _real = [Desembolso · realizado no mês]
			VAR _desv = [T4 · Desembolso · desvio no mês · com previsto]
			VAR _topo = [T4 · Desembolso · topo da escala]
			VAR _mes = [Mês · abreviado]
			VAR _mesAno = [Mês · rótulo curto]
			VAR _data = [Mês · data]
			VAR _ehRef = [Série · é o mês de referência]
			VAR _pos = [Série · posição na janela]
			VAR _n = [Série · meses até a referência]
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			-- 2 · Textos
			VAR _tdN = FORMAT ( ABS ( _desv ) * 100, "0", "pt-BR" )
			VAR _tdS = SWITCH ( TRUE (), ROUND ( _desv * 100, 0 ) < 0, "−", ROUND ( _desv * 100, 0 ) > 0, "+", "" )
			VAR _tdTxt = IF ( ISBLANK ( _desv ), "—", _tdS & _tdN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tdKP = LEN ( _tdN ) > 0
			VAR _tdKN = IF ( _tdKP, _tdN )
			VAR _tdKS = SUBSTITUTE ( SUBSTITUTE ( _tdKN, ".", "" ), ",", "" )
			VAR _tdKT = IFERROR ( VALUE ( _tdKS ), -1 )
			VAR _tdKOk = _tdKP && _tdKT >= 2 && FORMAT ( _tdKT, REPT ( "0", LEN ( _tdKS ) ) ) = _tdKS
			VAR _tdKD = IF ( CONTAINSSTRING ( _tdKN, "," ), LEN ( _tdKN ) - SEARCH ( ",", _tdKN ), 0 )
			VAR _tdKM = IF ( CONTAINSSTRING ( _tdKN, "." ), "#,##0", "0" ) & IF ( _tdKD > 0, "." & REPT ( "0", _tdKD ) )
			VAR _tdKOd =
			    IF (
			        _tdKOk,
			        "<o-d><o-v>" & _tdKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdKN, FORMAT ( ROUND ( _tdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdKD ), _tdKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdN
			    )
			VAR _tdOd = IF ( ISBLANK ( _desv ), _tdTxt, _tdS & _tdKOd & "%" )
			VAR _cruza = YEAR ( _ini ) <> YEAR ( _ref )
			VAR _txtMes = _mes & IF ( _cruza && ( _pos = 1 || MONTH ( _data ) = 1 ), RIGHT ( _mesAno, 3 ), "" )
			VAR _clsMes = IF ( _ehRef = 1, " ref", "" ) & IF ( ISBLANK ( _real ) && ISBLANK ( _prev ), " sem", "" )
			-- 3 · Geometria
			VAR _b = MIN ( 44, ROUND ( 0.36 * 1068 / _n, 0 ) ) -- geometria
			VAR _caixa = MIN ( 70, INT ( 1068 / _n ) ) -- geometria
			VAR _meiaCaixa = INT ( _caixa / 2 ) -- geometria
			VAR _xP = _b + 2 -- geometria
			VAR _u = DIVIDE ( 231, _topo ) -- geometria
			VAR _hP = MAX ( 0, ROUND ( _prev * _u, 0 ) ) -- geometria
			VAR _hR = MAX ( 0, ROUND ( _real * _u, 0 ) ) -- geometria
			VAR _yP = 255 - _hP -- geometria
			VAR _yR = 255 - _hR -- geometria
			VAR _yRot = MIN ( _yP, _yR ) - 21 -- geometria
			VAR _atraso = ( _pos - 1 ) * 100 -- geometria
			VAR _corre = "' data-rp='top,height' data-r0-top='255px' data-r0-height='0px' data-rd='"
			VAR _clsDv = IF ( _n >= 10, " d13", "" )
			-- 4 · Marcação
			VAR _htmlBarras =
			    IF (
			        NOT ISBLANK ( _real ) || NOT ISBLANK ( _prev ),
			        "<i class='bp' style='top:" & _yP & "px;height:" & _hP & "px;left:calc(50% - " & _xP & "px);width:" & _b
			            & "px' data-rk='" & _mes & "|p" & _corre & _atraso & "'></i>"
			            & "<i class='bd' style='top:" & _yR & "px;height:" & _hR & "px;left:calc(50% + 1px);width:" & _b
			            & "px' data-rk='" & _mes & "|d" & _corre & ( _atraso + 50 ) & "'></i>"
			            & IF (
			                NOT ISBLANK ( _desv ),
			                "<span class='dv b6 a-fd" & _clsDv & "' style='animation-delay:" & ( _atraso + 250 ) & "ms;top:" & _yRot & "px;left:calc(50% - " & _meiaCaixa
			                    & "px);width:" & _caixa & "px'>" & _tdOd & "</span>"
			            )
			    )
			RETURN
			    IF (
			        _noRecorte = 1,
			        "<div class='u dc'><i class='rz a-fd'></i>" & _htmlBarras
			            & "<p class='ms a-fd" & _clsMes & "' style='animation-delay:" & _atraso & "ms'>" & _txtMes & "</p>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
		displayFolder: T4 Resultado no tempo\Desembolso da carteira
		lineageTag: 7d04225d-2c80-59b7-b3e3-53445d3b647e

	/// Desvio do desembolso do mês sobre o previsto só com as obras que têm previsto: desembolsado dessas obras ÷ previsto − 1 (vazio sem previsto). Na obra, igual a [Desembolso · desvio no mês].
	measure 'T4 · Desembolso · desvio no mês · com previsto' =
			VAR _prev = [Desembolso · previsto no mês]
			VAR _real = [T4 · Desembolso · realizado com previsto no mês]
			RETURN
			    IF ( NOT ISBLANK ( _prev ) && NOT ISBLANK ( _real ), DIVIDE ( _real, _prev ) - 1 )
		formatString: 0.00%
		displayFolder: T4 Resultado no tempo\Desembolso da carteira\Contas
		lineageTag: 1d9e3bbd-e821-51f6-b95f-22a59666a66d

	/// [T4 · Desembolso · desvio no mês · com previsto] no mês de referência (seletor do drawer; sem escolha, o último mês).
	measure 'T4 · Desembolso · desvio no mês · com previsto · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [T4 · Desembolso · desvio no mês · com previsto], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: 0.00%
		displayFolder: T4 Resultado no tempo\Desembolso da carteira\Contas
		lineageTag: c79b1654-7697-50e0-afdc-99beb69f2174

	/// Desembolsado no mês só das obras do contexto que têm previsto no mês (regra 'sem previsto': a obra sem previsto fica fora do previsto e do desvio da carteira). Igual ao desembolsado quando todas têm previsto.
	measure 'T4 · Desembolso · realizado com previsto no mês' =
			SUMX (
			    VALUES ( fAnaliseCritica[Obra] ),
			    IF ( NOT ISBLANK ( [Desembolso · previsto no mês] ), [Desembolso · realizado no mês] )
			)
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T4 Resultado no tempo\Desembolso da carteira\Contas
		lineageTag: b856151e-0555-5085-ae0e-3e25919de1d0

	/// Maior valor entre o previsto e o desembolsado do mês nos meses da janela: o topo da escala das colunas.
	measure 'T4 · Desembolso · topo da escala' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@p", [Desembolso · previsto no mês], "@d", [Desembolso · realizado no mês] )
			RETURN
			    MAX ( MAXX ( _meses, [@p] ), MAXX ( _meses, [@d] ) )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T4 Resultado no tempo\Desembolso da carteira\Contas
		lineageTag: a61f10e4-33f2-5f2d-ab44-db16a3d10cce

	/// Leitura do "?" de Desembolso da carteira, sobre o próprio painel (L065, Figma 391:6596, 1068 × 347, completa em duas colunas): em quantos meses a carteira gastou acima do previsto e para onde vai o desvio (achado), quem está na faixa crítica da previsão de caixa da nota (fora do previsto além do limite, para mais ou para menos), três destaques que contam e o 'como ler'; à direita, a grade das justificativas no período (exigida e preenchida · em branco · não exigida · sem aba) e as causas mais repetidas nas justificativas. Só lê contas.
	measure 'T4 · Leitura desembolso · HTML' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _mesL = [Mês de referência · longo]
			VAR _mesN = [Mês de referência · nome]
			VAR _ini = [T4 · Primeiro mês com aba]
			VAR _nAba = [T4 · Meses com aba] + 0
			VAR _nJan = [Série · meses até a referência]
			VAR _nAcima = [T4 · Leitura desembolso · meses acima do previsto] + 0
			VAR _desde = [T4 · Leitura desembolso · acima do previsto desde]
			VAR _seq = [T4 · Leitura desembolso · desvio · sequência · início]
			VAR _varDes = [T4 · Leitura desembolso · desvio · variação no mês]
			VAR _crit = [T4 · Leitura desembolso · obras na faixa crítica (lista)]
			VAR _lim = [T4 · Desembolso · limite da faixa crítica]
			VAR _exc = [T4 · Leitura desembolso · obra de maior excesso]
			VAR _excRs = CALCULATE ( [Desembolso · diferença no mês · ref], dObra[Obra] = _exc )
			VAR _excBranco = CALCULATE ( [Justificativa · em branco · ref], dObra[Obra] = _exc )
			VAR _artExc = CALCULATE ( [T4 · Obra · artigo], dObra[Obra] = _exc )
			VAR _prevIni = [T4 · Leitura desembolso · previsto no primeiro mês]
			VAR _desIni = [T4 · Leitura desembolso · desembolsado no primeiro mês]
			VAR _pico = [T4 · Leitura desembolso · pico do desvio]
			VAR _picoObra = [T4 · Leitura desembolso · obra do pico]
			VAR _picoMes = [T4 · Leitura desembolso · mês do pico]
			VAR _artPico = CALCULATE ( [T4 · Obra · artigo], dObra[Obra] = _picoObra )
			VAR _causas = [T4 · Leitura desembolso · causas mais frequentes (lista)]
			VAR _semJus = [T4 · Leitura desembolso · obras sem nenhuma justificativa (lista)]
			VAR _brancoPer = [T4 · Leitura desembolso · justificativas em branco no período] + 0
			VAR _sj1 = PATHITEM ( _semJus, 1 )
			VAR _sj1Ex = CALCULATE ( [T4 · Obra · justificativas exigidas no período], dObra[Obra] = _sj1 )
			VAR _artSj1 = CALCULATE ( [T4 · Obra · artigo], dObra[Obra] = _sj1 )
			/* grade das justificativas no período (coluna da direita; veio da leitura de Desembolso por obra na fase 5) */
			VAR _obrasG =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@pos", [T1 · Obras · posição],
			        "@hist", [T4 · Meses com aba],
			        "@ex", [T4 · Obra · justificativas exigidas no período],
			        "@pre", [T4 · Obra · justificativas preenchidas no período]
			    )
			VAR _naGrade = FILTER ( _obrasG, [@hist] > 0 ) /* lista */
			VAR _prePer = [T4 · Leitura desembolso · justificativas preenchidas no período]
			VAR _mesesTodos =
			    ADDCOLUMNS ( VALUES ( dMes[Mes] ), "@ate", [Série · mês até a referência], "@mp", [Série · posição na janela] )
			VAR _meses = FILTER ( _mesesTodos, [@ate] = 1 ) /* lista */
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _iniN = FORMAT ( _ini, "mmmm", "pt-BR" )
			VAR _per = IF ( _nAba = _nJan, SWITCH ( _nJan, 3, "trimestre", 6, "semestre", "período" ), "período" )
			VAR _iniL = _iniN & IF ( YEAR ( _ini ) <> YEAR ( _ref ), " de " & YEAR ( _ini ), "" )
			VAR _txtSob = "LEITURA · DESEMBOLSO DA CARTEIRA · " & UPPER ( IF ( _ini = _ref, _mesL, _iniL & " a " & _mesL ) )
			VAR _tnaN = FORMAT ( _nAcima, "#,0", "pt-BR" )
			VAR _tnaTxt = IF ( ISBLANK ( _nAcima ), "0", _tnaN )
			VAR _tnaKP = LEN ( _tnaN ) > 0
			VAR _tnaKN = IF ( _tnaKP, _tnaN )
			VAR _tnaKS = SUBSTITUTE ( SUBSTITUTE ( _tnaKN, ".", "" ), ",", "" )
			VAR _tnaKT = IFERROR ( VALUE ( _tnaKS ), -1 )
			VAR _tnaKOk = _tnaKP && _tnaKT >= 2 && FORMAT ( _tnaKT, REPT ( "0", LEN ( _tnaKS ) ) ) = _tnaKS
			VAR _tnaKD = IF ( CONTAINSSTRING ( _tnaKN, "," ), LEN ( _tnaKN ) - SEARCH ( ",", _tnaKN ), 0 )
			VAR _tnaKM = IF ( CONTAINSSTRING ( _tnaKN, "." ), "#,##0", "0" ) & IF ( _tnaKD > 0, "." & REPT ( "0", _tnaKD ) )
			VAR _tnaKOd =
			    IF (
			        _tnaKOk,
			        "<o-d><o-v>" & _tnaKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tnaKN, FORMAT ( ROUND ( _tnaKT * [@odf] / 1000, 0 ) / POWER ( 10, _tnaKD ), _tnaKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tnaN
			    )
			VAR _tnaOd = IF ( ISBLANK ( _nAcima ), _tnaTxt, _tnaKOd )
			VAR _txtSeq = IF ( _seq = _ref, " em " & _mesN, " desde " & FORMAT ( _seq, "mmmm", "pt-BR" ) )
			VAR _txtAchado =
			    IF (
			        _nAcima = 0,
			        IF ( _nAba <= 1, "Não passou do previsto em " & _mesN & ".", "Não passou do previsto em nenhum dos " & "⁅" & _nAba & "⁆" & " meses do " & _per & "." ),
			        "Acima do previsto " & IF ( _nAcima = _nAba, "nos " & _tnaOd & " meses do " & _per, "em " & _tnaOd & " dos " & "⁅" & _nAba & "⁆" & " meses" )
			            & SWITCH (
			                TRUE (),
			                ISBLANK ( _seq ), ", e estável.",
			                _varDes > 0, ", e piorando: o desvio da carteira sobe" & _txtSeq & ".",
			                ", mas melhorando: o desvio da carteira cai" & _txtSeq & "."
			            )
			    )
			VAR _lcN = IF ( ISBLANK ( _crit ) || _crit = "", 0, PATHLENGTH ( _crit ) )
			VAR _lcPos = IF ( _lcN >= 2, FIND ( "§", SUBSTITUTE ( _crit, "|", "§", _lcN - 1 ) ) )
			VAR _lcTxt = SWITCH ( TRUE (), _lcN = 0, "", _lcN = 1, _crit, SUBSTITUTE ( LEFT ( _crit, _lcPos - 1 ), "|", ", " ) & " e " & MID ( _crit, _lcPos + 1, 999 ) )
			VAR _critSem = SUBSTITUTE ( SUBSTITUTE ( "|" & _crit & "|", "|" & _exc & "|", "|" ), "||", "|" )
			VAR _critSemL = MID ( _critSem, 2, MAX ( 0, LEN ( _critSem ) - 2 ) )
			VAR _excNaCrit = _exc <> "" && _lcN > 0 && PATHCONTAINS ( _crit, _exc )
			VAR _lcsN = IF ( ISBLANK ( _critSemL ) || _critSemL = "", 0, PATHLENGTH ( _critSemL ) )
			VAR _lcsPos = IF ( _lcsN >= 2, FIND ( "§", SUBSTITUTE ( _critSemL, "|", "§", _lcsN - 1 ) ) )
			VAR _lcsTxt = SWITCH ( TRUE (), _lcsN = 0, "", _lcsN = 1, _critSemL, SUBSTITUTE ( LEFT ( _critSemL, _lcsPos - 1 ), "|", ", " ) & " e " & MID ( _critSemL, _lcsPos + 1, 999 ) )
			VAR _txtExc = _artExc & " " & _exc & ", com o maior excesso em reais" & IF ( _excBranco = 1, " e sem justificativa", "" )
			/* faixa crítica da previsão de caixa da nota: fora do previsto além do limite, para mais ou para menos */
			VAR _txtFora = "fora do previsto em mais de " & "⁅" & _lim & "⁆" & ", para mais ou para menos"
			VAR _txtCrit =
			    SWITCH (
			        TRUE (),
			        _lcN = 0, "nenhuma obra está " & _txtFora,
			        _excNaCrit && _lcN = 1, "uma obra está " & _txtFora & ": " & _txtExc,
			        _excNaCrit, SWITCH ( _lcN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _lcN, "0" ) ) & " obras estão " & _txtFora & " — " & SUBSTITUTE ( _critSemL, "|", ", " ) & " e " & _txtExc,
			        _lcN = 1, "uma obra está " & _txtFora & ": " & _lcTxt,
			        SWITCH ( _lcN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _lcN, "0" ) ) & " obras estão " & _txtFora & ": " & _lcTxt
			    )
			VAR _txtExplica =
			    IF (
			        _nAcima = 0,
			        "Em " & _mesN & ", " & _txtCrit & ".",
			        "Em " & _mesN & ", " & _txtCrit & "."
			    )
			VAR _texA = ABS ( _excRs )
			VAR _texNu = SWITCH ( TRUE (), _texA >= 99950000, FORMAT ( _texA / 1000000, "0.0", "pt-BR" ), _texA >= 999500, FORMAT ( _texA / 1000000, "0.00", "pt-BR" ), _texA >= 999.5, FORMAT ( _texA / 1000, "0", "pt-BR" ), FORMAT ( _texA, "#,0", "pt-BR" ) )
			VAR _texUn = SWITCH ( TRUE (), _texA >= 999500, " mi", _texA >= 999.5, " mil", "" )
			VAR _texN = _texNu & _texUn
			VAR _texZero = _texN = "0"
			VAR _texS = IF ( _texZero, "", IF ( _excRs < 0, "−", "" ) )
			VAR _texTxt = IF ( ISBLANK ( _excRs ), "—", _texS & "R$ " & _texN )
			VAR _texKP = LEN ( _texNu ) > 0
			VAR _texKN = IF ( _texKP, _texNu )
			VAR _texKS = SUBSTITUTE ( SUBSTITUTE ( _texKN, ".", "" ), ",", "" )
			VAR _texKT = IFERROR ( VALUE ( _texKS ), -1 )
			VAR _texKOk = _texKP && _texKT >= 2 && FORMAT ( _texKT, REPT ( "0", LEN ( _texKS ) ) ) = _texKS
			VAR _texKD = IF ( CONTAINSSTRING ( _texKN, "," ), LEN ( _texKN ) - SEARCH ( ",", _texKN ), 0 )
			VAR _texKM = IF ( CONTAINSSTRING ( _texKN, "." ), "#,##0", "0" ) & IF ( _texKD > 0, "." & REPT ( "0", _texKD ) )
			VAR _texKOd =
			    IF (
			        _texKOk,
			        "<o-d><o-v>" & _texKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _texKN, FORMAT ( ROUND ( _texKT * [@odf] / 1000, 0 ) / POWER ( 10, _texKD ), _texKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _texNu
			    )
			VAR _texOd = IF ( ISBLANK ( _excRs ), _texTxt, _texS & "R$ " & _texKOd & _texUn )
			VAR _tdiA = ABS ( _desIni )
			VAR _tdiNu = SWITCH ( TRUE (), _tdiA >= 99950000, FORMAT ( _tdiA / 1000000, "0.0", "pt-BR" ), _tdiA >= 999500, FORMAT ( _tdiA / 1000000, "0.00", "pt-BR" ), _tdiA >= 999.5, FORMAT ( _tdiA / 1000, "0", "pt-BR" ), FORMAT ( _tdiA, "#,0", "pt-BR" ) )
			VAR _tdiUn = SWITCH ( TRUE (), _tdiA >= 999500, " mi", _tdiA >= 999.5, " mil", "" )
			VAR _tdiN = _tdiNu & _tdiUn
			VAR _tdiZero = _tdiN = "0"
			VAR _tdiS = IF ( _tdiZero, "", IF ( _desIni < 0, "−", "" ) )
			VAR _tdiTxt = IF ( ISBLANK ( _desIni ), "—", _tdiS & "R$ " & _tdiN )
			VAR _tdiKP = LEN ( _tdiNu ) > 0
			VAR _tdiKN = IF ( _tdiKP, _tdiNu )
			VAR _tdiKS = SUBSTITUTE ( SUBSTITUTE ( _tdiKN, ".", "" ), ",", "" )
			VAR _tdiKT = IFERROR ( VALUE ( _tdiKS ), -1 )
			VAR _tdiKOk = _tdiKP && _tdiKT >= 2 && FORMAT ( _tdiKT, REPT ( "0", LEN ( _tdiKS ) ) ) = _tdiKS
			VAR _tdiKD = IF ( CONTAINSSTRING ( _tdiKN, "," ), LEN ( _tdiKN ) - SEARCH ( ",", _tdiKN ), 0 )
			VAR _tdiKM = IF ( CONTAINSSTRING ( _tdiKN, "." ), "#,##0", "0" ) & IF ( _tdiKD > 0, "." & REPT ( "0", _tdiKD ) )
			VAR _tdiKOd =
			    IF (
			        _tdiKOk,
			        "<o-d><o-v>" & _tdiKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdiKN, FORMAT ( ROUND ( _tdiKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdiKD ), _tdiKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdiNu
			    )
			VAR _tdiOd = IF ( ISBLANK ( _desIni ), _tdiTxt, _tdiS & "R$ " & _tdiKOd & _tdiUn )
			VAR _tpiA = ABS ( _prevIni )
			VAR _tpiNu = SWITCH ( TRUE (), _tpiA >= 99950000, FORMAT ( _tpiA / 1000000, "0.0", "pt-BR" ), _tpiA >= 999500, FORMAT ( _tpiA / 1000000, "0.00", "pt-BR" ), _tpiA >= 999.5, FORMAT ( _tpiA / 1000, "0", "pt-BR" ), FORMAT ( _tpiA, "#,0", "pt-BR" ) )
			VAR _tpiUn = SWITCH ( TRUE (), _tpiA >= 999500, " mi", _tpiA >= 999.5, " mil", "" )
			VAR _tpiN = _tpiNu & _tpiUn
			VAR _tpiZero = _tpiN = "0"
			VAR _tpiS = IF ( _tpiZero, "", IF ( _prevIni < 0, "−", "" ) )
			VAR _tpiTxt = IF ( ISBLANK ( _prevIni ), "—", _tpiS & "R$ " & _tpiN )
			VAR _tpcN = FORMAT ( ABS ( _pico ) * 100, "0", "pt-BR" )
			VAR _tpcS = SWITCH ( TRUE (), ROUND ( _pico * 100, 0 ) < 0, "−", ROUND ( _pico * 100, 0 ) > 0, "+", "" )
			VAR _tpcTxt = IF ( ISBLANK ( _pico ), "—", _tpcS & _tpcN & "%" )
			VAR _tpcKP = LEN ( _tpcN ) > 0
			VAR _tpcKN = IF ( _tpcKP, _tpcN )
			VAR _tpcKS = SUBSTITUTE ( SUBSTITUTE ( _tpcKN, ".", "" ), ",", "" )
			VAR _tpcKT = IFERROR ( VALUE ( _tpcKS ), -1 )
			VAR _tpcKOk = _tpcKP && _tpcKT >= 2 && FORMAT ( _tpcKT, REPT ( "0", LEN ( _tpcKS ) ) ) = _tpcKS
			VAR _tpcKD = IF ( CONTAINSSTRING ( _tpcKN, "," ), LEN ( _tpcKN ) - SEARCH ( ",", _tpcKN ), 0 )
			VAR _tpcKM = IF ( CONTAINSSTRING ( _tpcKN, "." ), "#,##0", "0" ) & IF ( _tpcKD > 0, "." & REPT ( "0", _tpcKD ) )
			VAR _tpcKOd =
			    IF (
			        _tpcKOk,
			        "<o-d><o-v>" & _tpcKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpcKN, FORMAT ( ROUND ( _tpcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpcKD ), _tpcKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpcN
			    )
			VAR _tpcOd = IF ( ISBLANK ( _pico ), _tpcTxt, _tpcS & _tpcKOd & "%" )
			VAR _txtD1 = "maior excesso sobre o previsto em " & _mesN & ": " & _artExc & " " & _exc
			VAR _txtD2 = "desembolsados em " & _iniN & "; previstos " & "⁅" & SUBSTITUTE ( _tpiTxt, " ", UNICHAR ( 160 ) ) & "⁆"
			VAR _txtD3 = "desvio d" & _artPico & " " & _picoObra & " em " & FORMAT ( _picoMes, "mmmm", "pt-BR" ) & IF ( _nAba > 1, ", o pico do " & _per, "" )
			VAR _nC = IF ( ISBLANK ( _causas ) || _causas = "", 0, PATHLENGTH ( _causas ) )
			VAR _causasTxt =
			    SUBSTITUTE (
			        SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "|" & _causas & "|", "|efetivo|", "|efetivo|" ), "|aditivo|", "|aditivos|" ), "|medicao|", "|medições concentradas|" ), "|postergada|", "|medições postergadas|" ), "|compra|", "|compras antecipadas|" ), "|sinal|", "|pagamentos de sinal de contrato|" ), "|outra|", "|outras causas|" ),
			        "|", "", 1
			    )
			VAR _causasL = LEFT ( _causasTxt, MAX ( 0, LEN ( _causasTxt ) - 1 ) )
			VAR _lcaN = IF ( ISBLANK ( _causasL ) || _causasL = "", 0, PATHLENGTH ( _causasL ) )
			VAR _lcaPos = IF ( _lcaN >= 2, FIND ( "§", SUBSTITUTE ( _causasL, "|", "§", _lcaN - 1 ) ) )
			VAR _lcaTxt = SWITCH ( TRUE (), _lcaN = 0, "", _lcaN = 1, _causasL, SUBSTITUTE ( LEFT ( _causasL, _lcaPos - 1 ), "|", ", " ) & " e " & MID ( _causasL, _lcaPos + 1, 999 ) )
			VAR _txtCausas =
			    SWITCH (
			        _nC,
			        0, IF ( _prePer = 0, "Nenhum excesso exigido trouxe justificativa no período", "Nenhuma causa se repete nas justificativas preenchidas" ),
			        1, "As justificativas repetem uma causa — " & _lcaTxt,
			        "As justificativas repetem " & SWITCH ( _nC, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nC, "0" ) ) & " causas — " & _lcaTxt
			    )
			VAR _lsjN = IF ( ISBLANK ( _semJus ) || _semJus = "", 0, PATHLENGTH ( _semJus ) )
			VAR _lsjPos = IF ( _lsjN >= 2, FIND ( "§", SUBSTITUTE ( _semJus, "|", "§", _lsjN - 1 ) ) )
			VAR _lsjTxt = SWITCH ( TRUE (), _lsjN = 0, "", _lsjN = 1, _semJus, SUBSTITUTE ( LEFT ( _semJus, _lsjPos - 1 ), "|", ", " ) & " e " & MID ( _semJus, _lsjPos + 1, 999 ) )
			VAR _txtSemJus =
			    SWITCH (
			        TRUE (),
			        _lsjN = 1, "só " & _artSj1 & " " & _sj1 & " não explicou nenhum dos " & SWITCH ( _sj1Ex, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _sj1Ex, "0" ) ) & IF ( _sj1Ex = 1, " mês exigido", " meses exigidos" ),
			        _lsjN > 1, _lsjTxt & " não explicaram nenhum dos meses exigidos",
			        _brancoPer = 0, "todas as justificativas exigidas foram preenchidas",
			        SWITCH ( _brancoPer, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _brancoPer, "0" ) ) & IF ( _brancoPer = 1, " ficou em branco", " ficaram em branco" )
			    )
			VAR _txtOqe = _txtCausas & "."
			-- 3 · Geometria
			/* grade na coluna da direita (371): nome 100 px (Segoe 14; PONTA NEGRA ≈ 91, F4: sem reticências), coluna do mês =
			   mín(24; (371 − 100 − 52) ÷ n), o resto para 'de exigidas'; cabeçalho com a inicial do mês */
			VAR _cw = MIN ( 24, INT ( 219 / _nJan ) ) -- geometria
			VAR _resto = 271 - _nJan * _cw -- geometria
			VAR _grid = " style='grid-template-columns:100px repeat(" & _nJan & "," & _cw & "px) 1fr'"
			VAR _txtDe = IF ( _resto >= 100, "DE EXIGIDAS", "DE EXIG." )
			-- 4 · Marcação
			VAR _htmlDst =
			    "<div class='dst sobre-creme'>"
			        & IF ( _exc <> "", "<div><b>" & _texOd & "</b><span>" & _txtD1 & "</span></div>", "<div></div>" )
			        & "<div><b>" & _tdiOd & "</b><span>" & _txtD2 & "</span></div>"
			        & "<div><b>" & _tpcOd & "</b><span>" & _txtD3 & "</span></div>"
			    & "</div>"
			VAR _htmlGrade =
			    CONCATENATEX (
			        _naGrade,
			        VAR _o = dObra[Obra]
			        VAR _cel =
			            CONCATENATEX (
			                ADDCOLUMNS ( _meses, "@t", [Obras com análise], "@e", [Justificativa · exigida], "@b", [Justificativa · em branco] ),
			                "<i class='" & SWITCH ( TRUE (), ISBLANK ( [@t] ), "v", [@b] = 1, "b", [@e] = 1, "p", "n" ) & "' style='animation-delay:" & ( [@pos] * 12 + [@mp] ) * 30 & "ms'></i>",
			                "",
			                dMes[Mes], ASC
			            )
			        RETURN
			            "<div class='r'" & _grid & "><b>" & _o & "</b>" & _cel & "<em>" & IF ( [@ex] = 0, "—", "⁅" & [@pre] & "⁆" & " de " & "⁅" & [@ex] & "⁆" ) & "</em></div>",
			        "",
			        [@pos], ASC
			    )
			VAR _htmlCabGrade =
			    "<div class='h'" & _grid & "><span></span>"
			        & CONCATENATEX (
			            _meses,
			            VAR _m = UPPER ( FORMAT ( dMes[Mes], "mmm", "pt-BR" ) )
			            RETURN
			                "<span" & IF ( dMes[Mes] = _ref, " class='rf'", "" ) & ">" & LEFT ( _m, 1 ) & "</span>",
			            "",
			            dMes[Mes], ASC
			        ) /* lista */
			        & "<span class='de'>" & _txtDe & "</span></div>"
			VAR _esq =
			    "<div class='esq'><span class='vs sob'>" & _txtSob & "</span>"
			        & "<h2 class='ach'>" & _txtAchado & "</h2>"
			        & "<p class='exp'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtExplica, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>"
			        & _htmlDst
			        & "<div class='sec'><span class='vs'>Como ler</span>" & "<p class='cl'>Passe o mouse num mês para ver previsto, desembolsado e desvio de cada obra.</p>" & "</div>"
			    & "</div>"
			VAR _dir =
			    "<div class='dir'><span class='vs'>Detalhe · justificativas no " & SWITCH ( _nJan, 3, "trimestre", 6, "semestre", "período" ) & "</span>"
			        & "<div class='gj'>" & _htmlCabGrade & _htmlGrade
			        & "<div class='lg'><span><i class='p'></i>preenchida</span><span><i class='b'></i>em branco</span>"
			        & "<span><i class='n'></i>não exigida</span></div></div>"
			        & "<div class='sec'><span class='vs'>O que explica</span>" & "<p class='oqe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtOqe, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" & "</div>"
			    & "</div>"
			VAR _corpo = "<div class='cols'>" & _esq & "<i class='div'></i>" & _dir & "</div>"
			VAR _saidaHtml =
			    IF ( _nAba > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura de Desembolso da carteira" & "'><div class='pn pn-2c'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Leituras
		lineageTag: a49f51c7-a5ee-5a34-8c2f-6a674b40ba43

	/// Leitura do "?" de Resultado da carteira, mês a mês, sobre o próprio painel (L065, 1068 × 380, completa em duas colunas; F3): o sentido do resultado aplicado no período e onde a planilha fecha (achado), quantas obras caíram no aplicado e as negativas, três destaques que contam, e, à direita, o que falta realizar mês a mês (a distância entre a barra e o traço) e o que separa o aplicado da planilha. Só lê contas.
	measure 'T4 · Leitura mês · HTML' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _mesL = [Mês de referência · longo]
			VAR _mesN = [Mês de referência · nome]
			VAR _mesAntN = [Mês anterior à referência · nome]
			VAR _ini = [T4 · Primeiro mês com aba]
			VAR _nAba = [T4 · Meses com aba]
			VAR _nComp = [T4 · Leitura mês · meses comparáveis]
			VAR _nQueda = [T4 · Leitura mês · meses com queda]
			VAR _nSemQueda = [T4 · Leitura mês · meses sem queda]
			VAR _seqIni = [T4 · Leitura mês · sequência · início]
			VAR _var = [T4 · Resultado aplicado · variação no mês · ref]
			VAR _ap = [Resultado aplicado · ref]
			VAR _res = [Resultado da obra · ref]
			VAR _ar = [A realizar · ref]
			VAR _pct = [Resultado aplicado % · ref]
			VAR _obrasCairam = [T4 · Obras que caíram no mês · ref]
			VAR _obrasComp = [T4 · Obras comparáveis no mês · ref]
			VAR _neg = [T4 · Leitura mês · obras negativas (lista)]
			VAR _negCairam = [T4 · Leitura mês · negativas que caíram]
			VAR _arSeq = [T4 · Leitura mês · a realizar · sequência · início]
			VAR _arVar = [T4 · A realizar · variação no mês · ref]
			VAR _pctIni = [T4 · Leitura mês · resultado % no primeiro mês]
			VAR _oMaior = [T4 · Leitura mês · obra de maior resultado]
			VAR _rMaior = CALCULATE ( [Resultado aplicado · ref], dObra[Obra] = _oMaior )
			VAR _negRef = [T4 · Obras com resultado negativo · ref] + 0
			VAR _negIni = [T4 · Obras com resultado negativo · no primeiro mês] + 0
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@pos", [Série · posição na janela],
			        "@rot", [Mês · abreviado],
			        "@a", [A realizar]
			    )
			VAR _det = FILTER ( _meses, [@ate] = 1 ) /* lista */
			VAR _detCom = FILTER ( _det, NOT ISBLANK ( [@a] ) ) /* lista */
			VAR _detMax = MAXX ( _detCom, ABS ( [@a] ) ) /* geometria */
			VAR _detIni = MINX ( _detCom, dMes[Mes] ) /* geometria */
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _iniN = FORMAT ( _ini, "mmmm", "pt-BR" )
			VAR _iniL = _iniN & IF ( YEAR ( _ini ) <> YEAR ( _ref ), " de " & YEAR ( _ini ), "" )
			VAR _txtSob = "LEITURA · RESULTADO DA CARTEIRA, MÊS A MÊS · " & UPPER ( IF ( _ini = _ref, _mesL, _iniL & " a " & _mesL ) )
			VAR _tapA = ABS ( _ap )
			VAR _tapNu = SWITCH ( TRUE (), _tapA >= 99950000, FORMAT ( _tapA / 1000000, "0.0", "pt-BR" ), _tapA >= 999500, FORMAT ( _tapA / 1000000, "0.00", "pt-BR" ), _tapA >= 999.5, FORMAT ( _tapA / 1000, "0", "pt-BR" ), FORMAT ( _tapA, "#,0", "pt-BR" ) )
			VAR _tapUn = SWITCH ( TRUE (), _tapA >= 999500, " mi", _tapA >= 999.5, " mil", "" )
			VAR _tapN = _tapNu & _tapUn
			VAR _tapZero = _tapN = "0"
			VAR _tapS = IF ( _tapZero, "", IF ( _ap < 0, "−", "" ) )
			VAR _tapTxt = IF ( ISBLANK ( _ap ), "—", _tapS & "R$ " & _tapN )
			VAR _tapKP = LEN ( _tapNu ) > 0
			VAR _tapKN = IF ( _tapKP, _tapNu )
			VAR _tapKS = SUBSTITUTE ( SUBSTITUTE ( _tapKN, ".", "" ), ",", "" )
			VAR _tapKT = IFERROR ( VALUE ( _tapKS ), -1 )
			VAR _tapKOk = _tapKP && _tapKT >= 2 && FORMAT ( _tapKT, REPT ( "0", LEN ( _tapKS ) ) ) = _tapKS
			VAR _tapKD = IF ( CONTAINSSTRING ( _tapKN, "," ), LEN ( _tapKN ) - SEARCH ( ",", _tapKN ), 0 )
			VAR _tapKM = IF ( CONTAINSSTRING ( _tapKN, "." ), "#,##0", "0" ) & IF ( _tapKD > 0, "." & REPT ( "0", _tapKD ) )
			VAR _tapKOd =
			    IF (
			        _tapKOk,
			        "<o-d><o-v>" & _tapKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tapKN, FORMAT ( ROUND ( _tapKT * [@odf] / 1000, 0 ) / POWER ( 10, _tapKD ), _tapKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tapNu
			    )
			VAR _tapOd = IF ( ISBLANK ( _ap ), _tapTxt, _tapS & "R$ " & _tapKOd & _tapUn )
			VAR _trA = ABS ( _res )
			VAR _trNu = SWITCH ( TRUE (), _trA >= 99950000, FORMAT ( _trA / 1000000, "0.0", "pt-BR" ), _trA >= 999500, FORMAT ( _trA / 1000000, "0.00", "pt-BR" ), _trA >= 999.5, FORMAT ( _trA / 1000, "0", "pt-BR" ), FORMAT ( _trA, "#,0", "pt-BR" ) )
			VAR _trUn = SWITCH ( TRUE (), _trA >= 999500, " mi", _trA >= 999.5, " mil", "" )
			VAR _trN = _trNu & _trUn
			VAR _trZero = _trN = "0"
			VAR _trS = IF ( _trZero, "", IF ( _res < 0, "−", "" ) )
			VAR _trTxt = IF ( ISBLANK ( _res ), "—", _trS & "R$ " & _trN )
			VAR _tarA = ABS ( _ar )
			VAR _tarNu = SWITCH ( TRUE (), _tarA >= 99950000, FORMAT ( _tarA / 1000000, "0.0", "pt-BR" ), _tarA >= 999500, FORMAT ( _tarA / 1000000, "0.00", "pt-BR" ), _tarA >= 999.5, FORMAT ( _tarA / 1000, "0", "pt-BR" ), FORMAT ( _tarA, "#,0", "pt-BR" ) )
			VAR _tarUn = SWITCH ( TRUE (), _tarA >= 999500, " mi", _tarA >= 999.5, " mil", "" )
			VAR _tarN = _tarNu & _tarUn
			VAR _tarZero = _tarN = "0"
			VAR _tarS = IF ( _tarZero, "", IF ( _ar < 0, "−", "" ) )
			VAR _tarTxt = IF ( ISBLANK ( _ar ), "—", _tarS & "R$ " & _tarN )
			VAR _txtTend =
			    SWITCH (
			        TRUE (),
			        _nComp = 0, "Primeiro mês do histórico",
			        _var < 0 && _nQueda = _nComp, "O resultado aplicado cai todo mês desde " & _iniN,
			        _var < 0 && _seqIni < _ref, "O resultado aplicado cai desde " & FORMAT ( _seqIni, "mmmm", "pt-BR" ),
			        _var < 0, "O resultado aplicado caiu em " & SWITCH ( _nQueda, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nQueda, "0" ) ) & " dos " & SWITCH ( _nComp, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nComp, "0" ) ) & " meses",
			        _var > 0 && _nQueda = 0, "O resultado aplicado sobe todo mês desde " & _iniN,
			        _var > 0 && _seqIni < _ref, "O resultado aplicado sobe desde " & FORMAT ( _seqIni, "mmmm", "pt-BR" ),
			        _var > 0, "O resultado aplicado subiu em " & SWITCH ( _nSemQueda, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nSemQueda, "0" ) ) & " dos " & SWITCH ( _nComp, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nComp, "0" ) ) & " meses",
			        "O resultado aplicado fica estável em " & _mesN
			    )
			VAR _txtAchado = _txtTend & "; em " & _mesN & " fecha em <span class='" & IF ( _tapS = "−", "ng", "" ) & "'>" & _tapOd & "</span>, e a planilha, com o que ainda vai se " & "realizar, em <span class='" & IF ( _trS = "−", "ng", "" ) & "'>" & "⁅" & _trTxt & "⁆" & "</span>."
			VAR _lnN = IF ( ISBLANK ( _neg ) || _neg = "", 0, PATHLENGTH ( _neg ) )
			VAR _lnPos = IF ( _lnN >= 2, FIND ( "§", SUBSTITUTE ( _neg, "|", "§", _lnN - 1 ) ) )
			VAR _lnTxt = SWITCH ( TRUE (), _lnN = 0, "", _lnN = 1, _neg, SUBSTITUTE ( LEFT ( _neg, _lnPos - 1 ), "|", ", " ) & " e " & MID ( _neg, _lnPos + 1, 999 ) )
			VAR _txtObras =
			    IF (
			        _obrasComp = 0,
			        "",
			        UPPER ( LEFT ( SWITCH ( _obrasCairam, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _obrasCairam, "0" ) ), 1 ) ) & MID ( SWITCH ( _obrasCairam, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _obrasCairam, "0" ) ), 2, LEN ( SWITCH ( _obrasCairam, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _obrasCairam, "0" ) ) ) ) & " das " & SWITCH ( _obrasComp, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _obrasComp, "0" ) ) & IF ( _obrasCairam = 1, " fechou ", " fecharam " ) & _mesN & " abaixo de " & _mesAntN & " no aplicado"
			    )
			VAR _txtNeg =
			    SWITCH (
			        TRUE (),
			        _obrasComp = 0, "",
			        _lnN = 0, "; nenhuma obra fecha o mês com o aplicado no negativo",
			        _negCairam = _lnN && _lnN = 1, "; a negativa, " & _lnTxt & ", pesa cada vez mais",
			        _negCairam = _lnN, "; as " & SWITCH ( _lnN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _lnN, "0" ) ) & " negativas, " & _lnTxt & ", pesam cada vez mais",
			        "; " & _lnTxt & IF ( _lnN = 1, " segue negativa", " seguem negativas" )
			    )
			VAR _txtExplica = _txtObras & _txtNeg & IF ( _txtObras = "", "", "." )
			VAR _tpiN = FORMAT ( ABS ( _pctIni ) * 100, "0.00", "pt-BR" )
			VAR _tpiS = SWITCH ( TRUE (), ROUND ( _pctIni * 100, 2 ) < 0, "−", ROUND ( _pctIni * 100, 2 ) > 0, "+", "" )
			VAR _tpiTxt = IF ( ISBLANK ( _pctIni ), "—", _tpiS & _tpiN & "%" )
			VAR _tpiKP = LEN ( _tpiN ) > 0
			VAR _tpiKN = IF ( _tpiKP, _tpiN )
			VAR _tpiKS = SUBSTITUTE ( SUBSTITUTE ( _tpiKN, ".", "" ), ",", "" )
			VAR _tpiKT = IFERROR ( VALUE ( _tpiKS ), -1 )
			VAR _tpiKOk = _tpiKP && _tpiKT >= 2 && FORMAT ( _tpiKT, REPT ( "0", LEN ( _tpiKS ) ) ) = _tpiKS
			VAR _tpiKD = IF ( CONTAINSSTRING ( _tpiKN, "," ), LEN ( _tpiKN ) - SEARCH ( ",", _tpiKN ), 0 )
			VAR _tpiKM = IF ( CONTAINSSTRING ( _tpiKN, "." ), "#,##0", "0" ) & IF ( _tpiKD > 0, "." & REPT ( "0", _tpiKD ) )
			VAR _tpiKOd =
			    IF (
			        _tpiKOk,
			        "<o-d><o-v>" & _tpiKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpiKN, FORMAT ( ROUND ( _tpiKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpiKD ), _tpiKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpiN
			    )
			VAR _tpiOd = IF ( ISBLANK ( _pctIni ), _tpiTxt, _tpiS & _tpiKOd & "%" )
			VAR _tpN = FORMAT ( ABS ( _pct ) * 100, "0.00", "pt-BR" )
			VAR _tpS = SWITCH ( TRUE (), ROUND ( _pct * 100, 2 ) < 0, "−", ROUND ( _pct * 100, 2 ) > 0, "+", "" )
			VAR _tpTxt = IF ( ISBLANK ( _pct ), "—", _tpS & _tpN & "%" )
			VAR _trmA = ABS ( _rMaior )
			VAR _trmNu = SWITCH ( TRUE (), _trmA >= 99950000, FORMAT ( _trmA / 1000000, "0.0", "pt-BR" ), _trmA >= 999500, FORMAT ( _trmA / 1000000, "0.00", "pt-BR" ), _trmA >= 999.5, FORMAT ( _trmA / 1000, "0", "pt-BR" ), FORMAT ( _trmA, "#,0", "pt-BR" ) )
			VAR _trmUn = SWITCH ( TRUE (), _trmA >= 999500, " mi", _trmA >= 999.5, " mil", "" )
			VAR _trmN = _trmNu & _trmUn
			VAR _trmZero = _trmN = "0"
			VAR _trmS = IF ( _trmZero, "", IF ( _rMaior < 0, "−", "" ) )
			VAR _trmTxt = IF ( ISBLANK ( _rMaior ), "—", _trmS & "R$ " & _trmN )
			VAR _trmKP = LEN ( _trmNu ) > 0
			VAR _trmKN = IF ( _trmKP, _trmNu )
			VAR _trmKS = SUBSTITUTE ( SUBSTITUTE ( _trmKN, ".", "" ), ",", "" )
			VAR _trmKT = IFERROR ( VALUE ( _trmKS ), -1 )
			VAR _trmKOk = _trmKP && _trmKT >= 2 && FORMAT ( _trmKT, REPT ( "0", LEN ( _trmKS ) ) ) = _trmKS
			VAR _trmKD = IF ( CONTAINSSTRING ( _trmKN, "," ), LEN ( _trmKN ) - SEARCH ( ",", _trmKN ), 0 )
			VAR _trmKM = IF ( CONTAINSSTRING ( _trmKN, "." ), "#,##0", "0" ) & IF ( _trmKD > 0, "." & REPT ( "0", _trmKD ) )
			VAR _trmKOd =
			    IF (
			        _trmKOk,
			        "<o-d><o-v>" & _trmKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _trmKN, FORMAT ( ROUND ( _trmKT * [@odf] / 1000, 0 ) / POWER ( 10, _trmKD ), _trmKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _trmNu
			    )
			VAR _trmOd = IF ( ISBLANK ( _rMaior ), _trmTxt, _trmS & "R$ " & _trmKOd & _trmUn )
			VAR _tngN = FORMAT ( _negRef, "#,0", "pt-BR" )
			VAR _tngTxt = IF ( ISBLANK ( _negRef ), "0", _tngN )
			VAR _tngKP = LEN ( _tngN ) > 0
			VAR _tngKN = IF ( _tngKP, _tngN )
			VAR _tngKS = SUBSTITUTE ( SUBSTITUTE ( _tngKN, ".", "" ), ",", "" )
			VAR _tngKT = IFERROR ( VALUE ( _tngKS ), -1 )
			VAR _tngKOk = _tngKP && _tngKT >= 2 && FORMAT ( _tngKT, REPT ( "0", LEN ( _tngKS ) ) ) = _tngKS
			VAR _tngKD = IF ( CONTAINSSTRING ( _tngKN, "," ), LEN ( _tngKN ) - SEARCH ( ",", _tngKN ), 0 )
			VAR _tngKM = IF ( CONTAINSSTRING ( _tngKN, "." ), "#,##0", "0" ) & IF ( _tngKD > 0, "." & REPT ( "0", _tngKD ) )
			VAR _tngKOd =
			    IF (
			        _tngKOk,
			        "<o-d><o-v>" & _tngKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tngKN, FORMAT ( ROUND ( _tngKT * [@odf] / 1000, 0 ) / POWER ( 10, _tngKD ), _tngKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tngN
			    )
			VAR _tngOd = IF ( ISBLANK ( _negRef ), _tngTxt, _tngKOd )
			VAR _txtD1 = "do orçamento no aplicado em " & _iniN & IF ( _ini = _ref, "", "; <span class='" & IF ( _tpS = "−", "ng", "" ) & "'>" & "⁅" & _tpTxt & "⁆" & "</span> em " & _mesN )
			VAR _txtD2 = _oMaior & " em " & _mesN & IF ( _rMaior > 0, ", o maior aplicado", ", a menor perda" )
			VAR _txtD3 = IF ( _negRef = 1, "obra", "obras" ) & " com o aplicado negativo em " & _mesN & IF ( _ini = _ref, "", "; " & IF ( _negIni = 0, "nenhuma", SWITCH ( _negIni, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _negIni, "0" ) ) ) & " em " & _iniN )
			VAR _txtDist =
			    IF (
			        ISBLANK ( _arSeq ),
			        "",
			        " A distância entre a barra e o traço " & IF ( _arVar > 0, "cresce", "encolhe" )
			            & IF ( _arSeq = EDATE ( _ini, 1 ), " todo mês", " desde " & FORMAT ( _arSeq, "mmmm", "pt-BR" ) ) & "."
			    )
			VAR _txtOqe =
			    "A planilha soma ao resultado o que ainda vai se realizar: saldo de contrato, adiantamentos, estoque e "
			        & "equipamentos, pagos e ainda não aplicados. O resultado aplicado é só o que já virou obra: valor agregado "
			        & "− custo aplicado. Em " & _mesN & ", faltam " & "⁅" & _tarTxt & "⁆" & " para chegar ao da planilha." & _txtDist
			-- 3 · Geometria
			VAR _hMax = 50 -- geometria
			-- 4 · Marcação
			VAR _htmlDet =
			    CONCATENATEX (
			        _det,
			        VAR _a = [@a]
			        VAR _tem = NOT ISBLANK ( _a )
			        VAR _h = IF ( _tem, MAX ( 2, ROUND ( DIVIDE ( ABS ( _a ), _detMax ) * _hMax, 0 ) ), 0 ) -- geometria
			        VAR _ehRef = dMes[Mes] = _ref
			        VAR _ehIni = dMes[Mes] = _detIni
			        VAR _aA = ABS ( _a )
			        VAR _txtA = IF ( _a < 0, "−", "" ) & "R$ " & IF ( _aA >= 999500, FORMAT ( _aA / 1000000, "0.00", "pt-BR" ) & " mi", FORMAT ( _aA / 1000, "0", "pt-BR" ) & " mil" )
			        VAR _atraso = 600 + ( [@pos] - 1 ) * 80 -- geometria
			        VAR _clsVal = IF ( _ehIni, " ini", "" ) & IF ( _ehRef, " fim", "" )
			        RETURN
			            "<div class='c'>"
			                & IF ( _tem && ( _ehRef || _ehIni ), "<span class='val a-fd" & _clsVal & "' style='animation-delay:" & ( _atraso + 400 ) & "ms;top:" & ( 84 - _h - 21 ) & "px'>" & "⁅" & _txtA & "⁆" & "</span>" )
			                & IF ( _tem, "<i style='top:" & ( 84 - _h ) & "px;height:" & _h & "px' data-rk='a" & [@pos] & "' data-rp='top,height' data-r0-top='84px' data-r0-height='0px' data-rd='" & _atraso & "'></i>" )
			                & "<span class='ms a-fd" & IF ( _ehRef, " ref", "" ) & "' style='animation-delay:" & _atraso & "ms;top:88px'>" & [@rot] & "</span>"
			            & "</div>",
			        "",
			        dMes[Mes], ASC
			    )
			VAR _htmlDst =
			    "<div class='dst sobre-creme'>"
			        & "<div><b>" & "<span class='" & IF ( _tpiS = "−", "ng", "" ) & "'>" & _tpiOd & "</span>" & "</b><span>" & _txtD1 & "</span></div>"
			        & "<div><b>" & _trmOd & "</b><span>" & _txtD2 & "</span></div>"
			        & "<div><b>" & _tngOd & "</b><span>" & _txtD3 & "</span></div>"
			    & "</div>"
			VAR _esq =
			    "<div class='esq'><span class='vs sob'>" & _txtSob & "</span>"
			        & "<h2 class='ach'>" & _txtAchado & "</h2>"
			        & IF ( _txtExplica = "", "", "<p class='exp'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtExplica, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" )
			        & _htmlDst
			        & "<div class='sec'><span class='vs'>Como ler</span>" & "<p class='cl'>Passe o mouse num mês para ver o aplicado de cada obra.</p>" & "</div>"
			    & "</div>"
			VAR _dir =
			    "<div class='dir'><span class='vs'>Detalhe</span>"
			        & "<p class='sub'>o que falta realizar, mês a mês · a distância entre a barra e o traço</p>"
			        & "<div class='mb'>" & _htmlDet & "</div>"
			        & "<div class='sec'><span class='vs'>O que explica</span>" & "<p class='oqe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtOqe, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" & "</div>"
			    & "</div>"
			VAR _corpo = "<div class='cols'>" & _esq & "<i class='div'></i>" & _dir & "</div>"
			VAR _saidaHtml =
			    IF ( NOT ISBLANK ( _ap ), "<div class='u lv' role='dialog' aria-label='" & "Leitura de Resultado da carteira, mês a mês" & "'><div class='pn pn-2c'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Leituras
		lineageTag: 145c0252-dafc-5136-8d3a-412ef4a11747

	/// Leitura do "?" de Obras no mês, sobre o próprio painel (L065, 400 × 767, condensada; F3): quantas obras estão com IDC abaixo de 1 e qual mais caiu no mês (achado), as justificativas de caixa exigidas, preenchidas e em branco, com os nomes (explicação), e três destaques: o IDC da carteira, a maior queda do IDC e as justificativas em branco. Só lê contas.
	measure 'T4 · Leitura obras · HTML' =
			-- 1 · Leituras
			VAR _mesL = [Mês de referência · longo]
			VAR _mesN = [Mês de referência · nome]
			VAR _mesAntN = [Mês anterior à referência · nome]
			VAR _nObras = [Obras com análise · ref] + 0
			VAR _abx = [T1 · Custo · obras com IDC abaixo de 1 · ref] + 0
			VAR _nQueda = [T4 · Leitura obras · obras com IDC em queda] + 0
			VAR _oQueda = [T4 · Leitura obras · obra de maior queda do IDC]
			VAR _vQueda = [T4 · Leitura obras · maior queda do IDC]
			VAR _idc = [IDC · ref]
			VAR _ex = [Carteira · justificativas exigidas · ref] + 0
			VAR _pre = [Carteira · justificativas preenchidas · ref] + 0
			VAR _br = [Carteira · justificativas em branco · ref] + 0
			VAR _lBr = [Recorte · justificativas em branco (lista) · ref]
			VAR _lim = [Nota · limite caixa · ponto inteiro]
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _txtSob = "LEITURA · OBRAS NO MÊS<br>" & UPPER ( _mesL )
			VAR _txtLim = "±" & FORMAT ( _lim, "0%", "pt-BR" )
			VAR _txtAbx =
			    SWITCH (
			        TRUE (),
			        _abx = 0, "Nenhuma das " & SWITCH ( _nObras, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nObras, "0" ) ) & " obras está com IDC abaixo de 1",
			        _abx = _nObras, "As " & SWITCH ( _nObras, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nObras, "0" ) ) & " obras estão com IDC abaixo de 1",
			        UPPER ( LEFT ( SWITCH ( _abx, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _abx, "0" ) ), 1 ) ) & MID ( SWITCH ( _abx, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _abx, "0" ) ), 2, LEN ( SWITCH ( _abx, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _abx, "0" ) ) ) ) & " das " & SWITCH ( _nObras, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nObras, "0" ) ) & IF ( _abx = 1, " obras está", " obras estão" ) & " com IDC abaixo de 1: gastam mais do que agregam"
			    )
			VAR _txtQueda =
			    IF (
			        ISBLANK ( _oQueda ),
			        "; nenhuma perdeu IDC desde " & _mesAntN & ".",
			        "; " & IF ( _nQueda = 1, "só ", "" ) & CALCULATE ( [T4 · Obra · artigo], dObra[Obra] = _oQueda ) & " " & _oQueda & IF ( _nQueda = 1, " perdeu IDC desde ", " foi a que mais perdeu IDC desde " ) & _mesAntN & "."
			    )
			VAR _achado = _txtAbx & _txtQueda
			VAR _txtBr = SUBSTITUTE ( _lBr & "", "|", ", " )
			VAR _explica =
			    SWITCH (
			        TRUE (),
			        _ex = 0, "No caixa, nenhuma obra passou de " & "⁅" & _txtLim & "⁆" & " sobre o previsto em " & _mesN & ": nenhuma "
			            & "justificativa foi exigida.",
			        _br = 0, "No caixa, " & SWITCH ( _ex, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _ex, "0" ) ) & IF ( _ex = 1, " obra passou", " obras passaram" ) & " de " & "⁅" & _txtLim & "⁆"
			            & " sobre o previsto e " & IF ( _ex = 1, "justificou", "todas justificaram" ) & " na planilha.",
			        "No caixa, " & SWITCH ( _ex, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _ex, "0" ) ) & IF ( _ex = 1, " obra passou", " obras passaram" ) & " de " & "⁅" & _txtLim & "⁆"
			            & " sobre o previsto; " & IF ( _br = 1, "ficou em branco a justificativa de ", "ficaram em branco as de " ) & _txtBr & "."
			    )
			VAR _tiN = FORMAT ( _idc, "0.00", "pt-BR" )
			VAR _tiTxt = IF ( ISBLANK ( _idc ), "—", _tiN )
			VAR _tiKP = LEN ( _tiN ) > 0
			VAR _tiKN = IF ( _tiKP, _tiN )
			VAR _tiKS = SUBSTITUTE ( SUBSTITUTE ( _tiKN, ".", "" ), ",", "" )
			VAR _tiKT = IFERROR ( VALUE ( _tiKS ), -1 )
			VAR _tiKOk = _tiKP && _tiKT >= 2 && FORMAT ( _tiKT, REPT ( "0", LEN ( _tiKS ) ) ) = _tiKS
			VAR _tiKD = IF ( CONTAINSSTRING ( _tiKN, "," ), LEN ( _tiKN ) - SEARCH ( ",", _tiKN ), 0 )
			VAR _tiKM = IF ( CONTAINSSTRING ( _tiKN, "." ), "#,##0", "0" ) & IF ( _tiKD > 0, "." & REPT ( "0", _tiKD ) )
			VAR _tiKOd =
			    IF (
			        _tiKOk,
			        "<o-d><o-v>" & _tiKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tiKN, FORMAT ( ROUND ( _tiKT * [@odf] / 1000, 0 ) / POWER ( 10, _tiKD ), _tiKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tiN
			    )
			VAR _tiOd = IF ( ISBLANK ( _idc ), _tiTxt, _tiKOd )
			VAR _tqTxt = IF ( ISBLANK ( _vQueda ), "—", "−" & FORMAT ( ABS ( _vQueda ), "0.00", "pt-BR" ) )
			VAR _txtD2 = IF ( ISBLANK ( _oQueda ), "nenhuma obra perdeu IDC no mês", "no IDC da " & _oQueda & ", a maior queda do mês" )
			VAR _txtD3 = IF ( _br = 1, "justificativa em branco", "justificativas em branco" ) & " de " & "⁅" & _ex & "⁆" & IF ( _ex = 1, " exigida", " exigidas" )
			-- 4 · Marcação
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _achado & "</h2>"
			        & "<p class='exp'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _explica, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>"
			        & "<div class='dst sobre-creme'>"
			        & "<div><b>" & _tiOd & "</b><span>" & "IDC da carteira em " & _mesN & "</span></div>"
			        & "<div><b>" & "<span class='ng'>" & "⁅" & _tqTxt & "⁆" & "</span>" & "</b><span>" & _txtD2 & "</span></div>"
			        & "<div><b>" & "⁅" & _br & "⁆" & "</b><span>" & _txtD3 & "</span></div>"
			        & "</div>"
			        & "<div class='sec'><span class='vs'>Como ler</span>" & "<p class='cl'>Cada linha é uma obra, na ordem da nota: o IDC com a marca dos pontos do custo, a variação dele no mês, o desvio de caixa com a marca da faixa e a justificativa da planilha. Passe o mouse numa obra para ver o caixa mês a mês e as justificativas anteriores.</p>" & "</div>"
			VAR _saidaHtml =
			    IF ( _nObras > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura de Obras no mês" & "'><div class='pn pn-t4p'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T4 Resultado no tempo\Leituras
		lineageTag: d6a2a158-3448-520f-bdc2-ac358faf75ca

	/// CSS v2 das leituras do "?" da Tela 04 (sobre o painel: superfície, completa em duas colunas, condensada, grade das justificativas) e do guia da página em duas colunas (independe da T1).
	measure 'T4 · Leitura · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".lv{position:fixed;inset:0}.lv .pn{position:absolute;inset:0;background:#FFFFFF;border:1px solid #0B0B0C;border-radius:16px;overflow:hidden;color:#0B0B0C}.lv .sob{display:block;pad"
