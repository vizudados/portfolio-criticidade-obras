			RETURN
			    CALCULATE ( [T3 · Série · posição da aba anterior], dObra[Obra] = _obra )
		formatString: 0
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 112df342-d12b-53ab-bb10-2ba02540683f

