	/// Primeiro mês da sequência, terminada na referência, em que o executado do mês ficou no previsto ou acima (vazio quando a referência não está nessa condição ou não traz o previsto). Meses da janela com previsto; obra do contexto.
	measure 'T3 · Ritmo · executa acima desde' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@e", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · executado no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@p", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · previsto no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _serie = FILTER ( _meses, NOT ISBLANK ( [@e] ) && NOT ISBLANK ( [@p] ) )
			VAR _quebra = MAXX ( FILTER ( _serie, NOT ( [@e] >= [@p] ) ), dMes[Mes] )
			VAR _inicio = MINX ( FILTER ( _serie, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] )
			VAR _naRef = COUNTROWS ( FILTER ( _serie, dMes[Mes] = _ref && [@e] >= [@p] ) ) > 0
			RETURN
			    IF ( _naRef, _inicio )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 24658daf-4166-57b9-9442-18c244f557c5

	/// [T3 · Ritmo · executa acima desde] da obra em foco.
	measure 'T3 · Ritmo · executa acima desde · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Ritmo · executa acima desde], dObra[Obra] = _obra )
		formatString: dd/mm/yyyy
