	/// Obras do recorte na faixa crítica da previsão de caixa da nota (sem ponto: o desembolso fugiu do previsto para mais ou para menos) no mês de referência, da mais para a menos crítica ([T1 · Obras · posição]), separadas por '|'.
	measure 'T4 · Leitura desembolso · obras na faixa crítica (lista)' =
			VAR _mes = [Mês de referência]
			VAR _obras = CALCULATETABLE (
			        ADDCOLUMNS (
			            FILTER ( VALUES ( dObra[Obra] ), [Obras com análise] > 0 ),
			            "@s", [T4 · Desembolso · faixa do fluxo de caixa],
			            "@pos", [T1 · Obras · posição]
			        ),
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] = _mes
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@s] = 2 ), dObra[Obra], "|", [@pos], ASC )
