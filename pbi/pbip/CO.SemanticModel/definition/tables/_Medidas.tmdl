	/// IDC do mês menos o do mês anterior, arredondados em 2 casas como a tela mostra (vazio sem um dos dois).
	measure 'T4 · IDC · variação no mês' =
			VAR _a = [IDC]
			VAR _b = [T4 · IDC · mês anterior]
