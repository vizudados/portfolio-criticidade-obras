	/// Quantos meses seguidos, terminando no mês do contexto e dentro da janela, o físico da obra ficou do mesmo lado do limite da nota ([T3 · Status desvio físico]: 3 = 'terceiro mês seguido dentro do limite').
	measure 'T3 · Físico · meses seguidos na faixa' =
			VAR _mes = MAX ( dMes[Mes] )
			VAR _s = [T3 · Status desvio físico]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _mes ),
			        "@s", VAR _m = dMes[Mes] RETURN CALCULATE ( [T3 · Status desvio físico], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@s] ) )
			VAR _quebra = MAXX ( FILTER ( _com, [@s] <> _s ), dMes[Mes] )
			RETURN
			    IF ( NOT ISBLANK ( _s ), COUNTROWS ( FILTER ( _com, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ) ) )
		formatString: 0
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 042da28c-e801-5770-af6f-1e8093d72121

	/// [T3 · Físico · meses seguidos na faixa] no mês de referência.
	measure 'T3 · Físico · meses seguidos na faixa · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [T3 · Físico · meses seguidos na faixa], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: 0
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: ff5bee7f-7a0f-5795-9acf-6f869176f0da

	/// Cada vez que o físico da obra do contexto cruzou o limite da nota, dentro da janela, da mais antiga à mais nova, separadas por '|': mês por extenso § mês abreviado § status de antes § status novo (0 dentro, 2 fora) § meses no status novo (até a mudança seguinte ou até a referência). Mudança vinda de antes da janela não conta.
	measure 'T3 · Físico · mudanças de faixa (lista)' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@s", VAR _m = dMes[Mes] RETURN CALCULATE ( [T3 · Status desvio físico], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@a", VAR _m = dMes[Mes] RETURN CALCULATE ( [T3 · Status desvio físico], REMOVEFILTERS ( dMes ), dMes[Mes] = EDATE ( _m, -1 ) )
			    )
			VAR _mud = FILTER ( _meses, dMes[Mes] > _jan && NOT ISBLANK ( [@s] ) && NOT ISBLANK ( [@a] ) && [@s] <> [@a] )
			VAR _lista =
			    ADDCOLUMNS (
			        _mud,
			        "@prox", VAR _m = dMes[Mes] RETURN MINX ( FILTER ( _mud, dMes[Mes] > _m ), dMes[Mes] )
			    )
			RETURN
			    CONCATENATEX (
			        _lista,
			        FORMAT ( dMes[Mes], "mmmm", "pt-BR" ) & "§" & FORMAT ( dMes[Mes], "mmm", "pt-BR" ) & "§" & [@a] & "§" & [@s]
			            & "§" & DATEDIFF ( dMes[Mes], COALESCE ( [@prox], EDATE ( _ref, 1 ) ), MONTH ),
			        "|",
			        dMes[Mes], ASC
			    )
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: f1d6b7ae-3866-536d-972f-39686a5d1794

	/// [T3 · Físico · mudanças de faixa (lista)] da obra em foco.
	measure 'T3 · Físico · mudanças de faixa (lista) · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Físico · mudanças de faixa (lista)], dObra[Obra] = _obra )
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 2449067f-3d6b-581a-84ce-a7d477500374

	/// Primeiro mês da sequência, terminada na referência e dentro da janela, em que a obra ficou do mesmo lado do cronograma (atrás, no previsto ou à frente: [T3 · Físico · lado do cronograma]). 'Atrás desde fevereiro'.
	measure 'T3 · Físico · sinal · início da sequência' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@d", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _serie = ADDCOLUMNS ( FILTER ( _meses, NOT ISBLANK ( [@d] ) ), "@l", IF ( NOT ISBLANK ( [@d] ), SIGN ( ROUND ( [@d], 1 ) ) ) )
			VAR _ladoRef = MAXX ( FILTER ( _serie, dMes[Mes] = _ref ), [@l] )
			VAR _quebra = MAXX ( FILTER ( _serie, [@l] <> _ladoRef ), dMes[Mes] )
			RETURN
			    IF ( NOT ISBLANK ( _ladoRef ), MINX ( FILTER ( _serie, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] ) )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 4a49445a-fcba-581c-ba00-ab191eca1de2

	/// Primeiro mês da sequência anterior (de outro lado do cronograma) à que termina na referência, dentro da janela; vazio quando a obra ficou do mesmo lado em toda a série. 'Atrás em janeiro; à frente desde fevereiro'.
	measure 'T3 · Físico · sinal · início da sequência anterior' =
			VAR _ref = [Mês de referência]
			VAR _ini = [T3 · Físico · sinal · início da sequência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@d", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _antes = ADDCOLUMNS ( FILTER ( _meses, NOT ISBLANK ( [@d] ) && dMes[Mes] < _ini ), "@l", IF ( NOT ISBLANK ( [@d] ), SIGN ( ROUND ( [@d], 1 ) ) ) )
			VAR _ladoAntes = MAXX ( FILTER ( _antes, dMes[Mes] = EDATE ( _ini, -1 ) ), [@l] )
			VAR _quebra = MAXX ( FILTER ( _antes, [@l] <> _ladoAntes ), dMes[Mes] )
			RETURN
			    IF ( NOT ISBLANK ( _ladoAntes ), MINX ( FILTER ( _antes, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] ) )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 63f72fd7-fa81-55ea-b1fb-6ac69ac7cf2c

	/// [T3 · Físico · sinal · início da sequência] da obra em foco.
	measure 'T3 · Físico · sinal · início da sequência · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Físico · sinal · início da sequência], dObra[Obra] = _obra )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: d2c7c44c-241d-5de7-ae3a-057393a7296e

	/// Como a distância ao cronograma (|desvio físico|) anda até a referência, dentro da janela: cresce ou cai quando os dois últimos meses ou mais vão no mesmo sentido; oscila quando o último mês inverteu o sentido. Uma obra no contexto.
	measure 'T3 · Físico · tendência da distância' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@d", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@a", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = EDATE ( _m, -1 ) )
			    )
			VAR _serie = FILTER ( _meses, NOT ISBLANK ( [@d] ) )
			VAR _comDelta = ADDCOLUMNS ( _serie, "@sg", IF ( ISBLANK ( [@a] ) || dMes[Mes] = _jan, BLANK (), SIGN ( ROUND ( ABS ( [@d] ) - ABS ( [@a] ), 3 ) ) ) )
			VAR _sgRef = MAXX ( FILTER ( _comDelta, dMes[Mes] = _ref ), [@sg] )
			VAR _quebra = MAXX ( FILTER ( _comDelta, ISBLANK ( [@sg] ) || [@sg] <> _sgRef ), dMes[Mes] )
			VAR _passos = DATEDIFF ( _quebra, _ref, MONTH )
			RETURN
			    IF (
			        NOT ISBLANK ( _sgRef ),
			        SWITCH ( TRUE (), _passos >= 2 && _sgRef > 0, "cresce", _passos >= 2 && _sgRef < 0, "cai", "oscila" )
			    )
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: c134b82a-f4bc-5cd4-92cc-9bbe72539b83

	/// Mês de partida da tendência da distância ao cronograma (o último mês antes da sequência; com 'oscila', o primeiro mês da série na janela). 'A distância cresce todo mês desde janeiro'.
	measure 'T3 · Físico · tendência da distância desde' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@d", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@a", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = EDATE ( _m, -1 ) )
			    )
			VAR _serie = FILTER ( _meses, NOT ISBLANK ( [@d] ) )
			VAR _comDelta = ADDCOLUMNS ( _serie, "@sg", IF ( ISBLANK ( [@a] ) || dMes[Mes] = _jan, BLANK (), SIGN ( ROUND ( ABS ( [@d] ) - ABS ( [@a] ), 3 ) ) ) )
			VAR _sgRef = MAXX ( FILTER ( _comDelta, dMes[Mes] = _ref ), [@sg] )
			VAR _quebra = MAXX ( FILTER ( _comDelta, ISBLANK ( [@sg] ) || [@sg] <> _sgRef ), dMes[Mes] )
			VAR _passos = DATEDIFF ( _quebra, _ref, MONTH )
			RETURN
			    IF ( NOT ISBLANK ( _sgRef ), IF ( _passos >= 2, _quebra, MINX ( _serie, dMes[Mes] ) ) )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: ff209e24-b8f1-5dd6-8117-33e40731a383

