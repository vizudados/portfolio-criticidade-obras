	/// 1 quando a obra tem os 9 itens com dado; 0 quando falta algum; vazio sem obra no contexto. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · completa' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _f = [Nota · itens faltando]
