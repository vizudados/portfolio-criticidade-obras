	/// Índice de desempenho de custo: valor agregado ÷ custo aplicado (na carteira, soma ÷ soma). Acima de 1, a obra gastou menos do que o orçamento previa para o que executou.
	measure IDC =
			VAR _ca = [Custo aplicado]
			RETURN
			    IF ( _ca > 0, DIVIDE ( [Crédito do orçamento], _ca ) )
		formatString: 0.000
		displayFolder: Base\Obra
		lineageTag: 37995f45-f461-536b-bd63-2fae21201e46

