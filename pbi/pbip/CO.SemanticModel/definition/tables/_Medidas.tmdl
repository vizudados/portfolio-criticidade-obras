	/// CSS do bloco Desembolso do mês v2.
	measure 'T2 · Desembolso · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".dm{position:fixed;inset:0}.dm .c{position:absolute;width:186px}.dm .c .vs{display:flex;align-items:center;gap:6px}.dm .c .vs i{display:block;width:10px;height:10px;flex:none}.dm ."
			    & "c .vs i.pv{background:#E9E0CF;box-shadow:inset 0 0 0 1px #E1E1E1}.dm .c .vs i.dv{background:#0B0B0C}.dm .c b{display:flex;align-items:center;gap:7px;margin-top:4px;font-family:'Bar"
			    & "low U','Segoe UI',sans-serif;font-weight:600;font-size:21px;line-height:26px;white-space:nowrap;font-variant-numeric:tabular-nums}.dm .br{position:absolute;left:0;height:10px}.dm ."
			    & "br.pv{background:#E9E0CF}.dm .br.dv{background:#0B0B0C}.dm .js{position:absolute;left:0;right:0;top:156px;bottom:0;background:#F7F4EE;border-radius:6px;padding:16px}.dm .js .vs{dis"
			    & "play:block}.dm .js p{margin-top:8px;font-size:15px;line-height:21px;color:#3B3B3F;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}"
		displayFolder: T2 Análise crítica\Desembolso do mês
		lineageTag: f81452cb-0ff8-51e4-9ef6-5ede26d66302

	/// Desembolso do mês da obra em foco: previsto e desembolsado (com as barras creme × preta na mesma escala), diferença e × previsto com a marca dos pontos da previsão de caixa na nota (cheio, parcial ou zero, pelas faixas do item) e os pontos ao lado do rótulo, e a justificativa da planilha (exigida acima de ±10%; em branco vira aviso). Desvio e diferença negativos ficam em preto (decisão do Alisson).
	measure 'T2 · Desembolso · HTML' =
			-- 1 · Leituras
			VAR _prev = [Desembolso · previsto no mês · foco]
			VAR _real = [Desembolso · realizado no mês · foco]
			VAR _dif = [Desembolso · diferença no mês · foco]
			VAR _desv = [Desembolso · desvio no mês · foco]
			VAR _ptx = [Nota · pontos caixa · foco]
			VAR _psx = [Nota · possíveis · caixa · foco]
			VAR _exig = [Justificativa · exigida · foco]
			VAR _branco = [Justificativa · em branco · foco]
			VAR _just = [Justificativa do desembolso · foco]
			-- 2 · Textos
			VAR _tpA = ABS ( _prev )
			VAR _tpNu = SWITCH ( TRUE (), _tpA >= 99950000, FORMAT ( _tpA / 1000000, "0.0", "pt-BR" ), _tpA >= 999500, FORMAT ( _tpA / 1000000, "0.00", "pt-BR" ), _tpA >= 999.5, FORMAT ( _tpA / 1000, "0", "pt-BR" ), FORMAT ( _tpA, "#,0", "pt-BR" ) )
			VAR _tpUn = SWITCH ( TRUE (), _tpA >= 999500, " mi", _tpA >= 999.5, " mil", "" )
			VAR _tpN = _tpNu & _tpUn
			VAR _tpZero = _tpN = "0"
			VAR _tpS = IF ( _tpZero, "", IF ( _prev < 0, "−", "" ) )
			VAR _tpTxt = IF ( ISBLANK ( _prev ), "—", _tpS & "R$ " & _tpN )
			VAR _trA = ABS ( _real )
			VAR _trNu = SWITCH ( TRUE (), _trA >= 99950000, FORMAT ( _trA / 1000000, "0.0", "pt-BR" ), _trA >= 999500, FORMAT ( _trA / 1000000, "0.00", "pt-BR" ), _trA >= 999.5, FORMAT ( _trA / 1000, "0", "pt-BR" ), FORMAT ( _trA, "#,0", "pt-BR" ) )
			VAR _trUn = SWITCH ( TRUE (), _trA >= 999500, " mi", _trA >= 999.5, " mil", "" )
			VAR _trN = _trNu & _trUn
			VAR _trZero = _trN = "0"
			VAR _trS = IF ( _trZero, "", IF ( _real < 0, "−", "" ) )
			VAR _trTxt = IF ( ISBLANK ( _real ), "—", _trS & "R$ " & _trN )
			VAR _tdA = ABS ( _dif )
			VAR _tdNu = SWITCH ( TRUE (), _tdA >= 99950000, FORMAT ( _tdA / 1000000, "0.0", "pt-BR" ), _tdA >= 999500, FORMAT ( _tdA / 1000000, "0.00", "pt-BR" ), _tdA >= 999.5, FORMAT ( _tdA / 1000, "0", "pt-BR" ), FORMAT ( _tdA, "#,0", "pt-BR" ) )
			VAR _tdUn = SWITCH ( TRUE (), _tdA >= 999500, " mi", _tdA >= 999.5, " mil", "" )
			VAR _tdN = _tdNu & _tdUn
			VAR _tdZero = _tdN = "0"
			VAR _tdS = IF ( _tdZero, "", SWITCH ( TRUE (), _dif < 0, "−", _dif > 0, "+", "" ) )
			VAR _tdTxt = IF ( ISBLANK ( _dif ), "—", _tdS & "R$ " & _tdN )
			VAR _tvN = FORMAT ( ABS ( _desv ) * 100, "0", "pt-BR" )
			VAR _tvS = SWITCH ( TRUE (), ROUND ( _desv * 100, 0 ) < 0, "−", ROUND ( _desv * 100, 0 ) > 0, "+", "" )
			VAR _tvTxt = IF ( ISBLANK ( _desv ), "—", _tvS & _tvN & "%" )
			VAR _tiTxt = IF ( ISBLANK ( _ptx ), "sem dado na planilha", "⁅" & FORMAT ( _ptx, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _psx, "0.0#", "pt-BR" ) & "⁆" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tpKP = LEN ( _tpNu ) > 0
			VAR _tpKN = IF ( _tpKP, _tpNu )
			VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
			VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
			VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
			VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
			VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
			VAR _tpKOd =
			    IF (
			        _tpKOk,
			        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpNu
			    )
			VAR _tpOd = IF ( ISBLANK ( _prev ), _tpTxt, _tpS & "R$ " & _tpKOd & _tpUn )
			VAR _trKP = LEN ( _trNu ) > 0
			VAR _trKN = IF ( _trKP, _trNu )
			VAR _trKS = SUBSTITUTE ( SUBSTITUTE ( _trKN, ".", "" ), ",", "" )
			VAR _trKT = IFERROR ( VALUE ( _trKS ), -1 )
			VAR _trKOk = _trKP && _trKT >= 2 && FORMAT ( _trKT, REPT ( "0", LEN ( _trKS ) ) ) = _trKS
			VAR _trKD = IF ( CONTAINSSTRING ( _trKN, "," ), LEN ( _trKN ) - SEARCH ( ",", _trKN ), 0 )
			VAR _trKM = IF ( CONTAINSSTRING ( _trKN, "." ), "#,##0", "0" ) & IF ( _trKD > 0, "." & REPT ( "0", _trKD ) )
			VAR _trKOd =
			    IF (
			        _trKOk,
			        "<o-d><o-v>" & _trKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _trKN, FORMAT ( ROUND ( _trKT * [@odf] / 1000, 0 ) / POWER ( 10, _trKD ), _trKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _trNu
			    )
			VAR _trOd = IF ( ISBLANK ( _real ), _trTxt, _trS & "R$ " & _trKOd & _trUn )
			VAR _tdKP = LEN ( _tdNu ) > 0
			VAR _tdKN = IF ( _tdKP, _tdNu )
			VAR _tdKS = SUBSTITUTE ( SUBSTITUTE ( _tdKN, ".", "" ), ",", "" )
			VAR _tdKT = IFERROR ( VALUE ( _tdKS ), -1 )
			VAR _tdKOk = _tdKP && _tdKT >= 2 && FORMAT ( _tdKT, REPT ( "0", LEN ( _tdKS ) ) ) = _tdKS
			VAR _tdKD = IF ( CONTAINSSTRING ( _tdKN, "," ), LEN ( _tdKN ) - SEARCH ( ",", _tdKN ), 0 )
			VAR _tdKM = IF ( CONTAINSSTRING ( _tdKN, "." ), "#,##0", "0" ) & IF ( _tdKD > 0, "." & REPT ( "0", _tdKD ) )
			VAR _tdKOd =
			    IF (
			        _tdKOk,
			        "<o-d><o-v>" & _tdKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdKN, FORMAT ( ROUND ( _tdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdKD ), _tdKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdNu
			    )
			VAR _tdOd = IF ( ISBLANK ( _dif ), _tdTxt, _tdS & "R$ " & _tdKOd & _tdUn )
			VAR _tvKP = LEN ( _tvN ) > 0
			VAR _tvKN = IF ( _tvKP, _tvN )
			VAR _tvKS = SUBSTITUTE ( SUBSTITUTE ( _tvKN, ".", "" ), ",", "" )
			VAR _tvKT = IFERROR ( VALUE ( _tvKS ), -1 )
			VAR _tvKOk = _tvKP && _tvKT >= 2 && FORMAT ( _tvKT, REPT ( "0", LEN ( _tvKS ) ) ) = _tvKS
			VAR _tvKD = IF ( CONTAINSSTRING ( _tvKN, "," ), LEN ( _tvKN ) - SEARCH ( ",", _tvKN ), 0 )
			VAR _tvKM = IF ( CONTAINSSTRING ( _tvKN, "." ), "#,##0", "0" ) & IF ( _tvKD > 0, "." & REPT ( "0", _tvKD ) )
			VAR _tvKOd =
			    IF (
			        _tvKOk,
			        "<o-d><o-v>" & _tvKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tvKN, FORMAT ( ROUND ( _tvKT * [@odf] / 1000, 0 ) / POWER ( 10, _tvKD ), _tvKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tvN
			    )
			VAR _tvOd = IF ( ISBLANK ( _desv ), _tvTxt, _tvS & _tvKOd & "%" )
			VAR _txtRot = IF ( _exig = 1, "Justificativa · exigida acima de ±10%", "Justificativa · não exigida (dentro de ±10%)" )
			VAR _txtJust =
			    SWITCH (
			        TRUE (),
			        _branco = 1, "Em branco: a planilha não traz a justificativa exigida.",
			        TRIM ( _just ) = "", "Sem justificativa na planilha.",
			        SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( TRIM ( _just ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
			    )
			-- 3 · Geometria
			VAR _maior = MAX ( ABS ( _prev ), ABS ( _real ) ) -- geometria
			VAR _wP = IF ( ISBLANK ( _prev ), 0, MAX ( ROUND ( DIVIDE ( ABS ( _prev ), _maior ) * 372, 0 ), 2 ) ) -- geometria
			VAR _wR = IF ( ISBLANK ( _real ), 0, MAX ( ROUND ( DIVIDE ( ABS ( _real ), _maior ) * 372, 0 ), 2 ) ) -- geometria
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _prev ) || NOT ISBLANK ( _real ),
			        "<div class='u dm'>"
			            & "<div class='c' style='left:0;top:0'><span class='vs'><i class='pv a-pop'></i>Previsto</span><b>" & _tpOd & "</b></div>"
			            & "<div class='c' style='left:186px;top:0'><span class='vs'><i class='dv a-pop' style='animation-delay:90ms'></i>Desembolsado</span><b>" & _trOd & "</b></div>"
			            & "<i class='br pv' style='top:55px;width:" & _wP & "px' data-rk='dp' data-rp='width'></i>"
			            & "<i class='br dv' style='top:69px;width:" & _wR & "px' data-rk='dr' data-rp='width' data-rd='90'></i>"
			            & "<div class='c' style='left:0;top:95px'><span class='vs'>Diferença</span><b>" & _tdOd & "</b></div>"
			            & "<div class='c' style='left:186px;top:95px'><span class='vs'>× previsto" & IF ( ISBLANK ( _ptx ), "", " · <span>" & _tiTxt & "</span>" ) & "</span><b>" & IF ( IF ( ISBLANK ( _ptx ), "", IF ( _ptx >= _psx, "0", IF ( _ptx = 0, "2", "1" ) ) ) = "", "", "<i class='a-pop mk mk" & IF ( ISBLANK ( _ptx ), "", IF ( _ptx >= _psx, "0", IF ( _ptx = 0, "2", "1" ) ) ) & "' style='animation-delay:700ms'></i>" ) & "<span>" & _tvOd & "</span></b></div>"
			            & "<div class='js'><span class='vs'>" & _txtRot & "</span><p>" & _txtJust & "</p></div>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Desembolso do mês
		lineageTag: a9e9ac7e-f19e-5a26-92cd-1b24dca9e8fb

	/// CSS do IDC mês a mês (uma entrada por mês da janela; colunas iguais) e do subtítulo.
	measure 'T2 · Mês a mês · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & "#htmlContent{display:flex!important;align-items:flex-start;width:100vw;height:100vh;margin:0!important;padding:0 20px 0 0!important;box-sizing:border-box!important}.htmlViewerEntry"
			    & "{display:block!important;flex:1 1 0;min-width:0;margin:0!important;padding:0!important}.mm{position:relative;height:281px}.mm .l1{position:absolute;left:0;right:0;height:0;border-t"
			    & "op:1px solid #0B0B0C}.mm .l9{position:absolute;left:0;right:0;height:0;border-top:1px dashed #C43737}.mm .b{position:absolute;left:calc(50% - 9px);width:18px}.mm .b.q0{background:#"
			    & "A9CDB9}.mm .b.q1{background:#C9821F}.mm .b.q2{background:#C43737}.mm .v{position:absolute;left:-30px;right:-30px;text-align:center;font-family:'Barlow U','Segoe UI',sans-serif;font"
			    & "-weight:600;font-size:14px;line-height:17px;white-space:nowrap;font-variant-numeric:tabular-nums;color:#0B0B0C;text-shadow:1px 0 0 #FFF,-1px 0 0 #FFF,0 1px 0 #FFF,0 -1px 0 #FFF,1px"
			    & " 1px 0 #FFF,-1px -1px 0 #FFF,1px -1px 0 #FFF,-1px 1px 0 #FFF,0 0 3px #FFF}.mm .v.ng{color:#C43737}.mm .ms{position:absolute;left:-12px;right:-12px;top:265px;text-align:center;font-"
			    & "size:13px;line-height:16px;white-space:nowrap;color:#3B3B3F}.mm .ms.ref{font-weight:600;color:#0B0B0C}.mm .ms.sem{opacity:.35}.mm:hover .b{filter:brightness(.92)}.ms2{position:fixe"
			    & "d;inset:0;font-size:15px;line-height:20px;color:#3B3B3F;white-space:nowrap}"
		displayFolder: T2 Análise crítica\IDC, mês a mês
		lineageTag: c1b7ede9-7ddd-5ace-8514-b25991a39eac

	/// IDC mês a mês da obra em foco: uma entrada por mês da janela (granularidade dMes, colunas iguais), com a barra da linha de 1,00 até o IDC (sálvia acima, ocre entre 1,00 e a trava, vermelha abaixo dela), as linhas de 1,00 e da trava atravessando as colunas, o rótulo no mês de referência e no maior e no menor IDC, e o mês no eixo (com mais de oito meses, só a sigla; o ano no primeiro mês e em janeiro). Mês sem aba: só o rótulo do mês, apagado. O mouse abre o tooltip do mês (os valores em R$).
	measure 'T2 · Mês a mês · HTML coluna' =
			-- 1 · Leituras
			VAR _noRecorte = [Série · mês até a referência]
			VAR _n = [Série · meses até a referência]
			VAR _pos = [Série · posição na janela]
			VAR _mesAno = [Mês · rótulo curto]
			VAR _mesAbrev = [Mês · abreviado]
			VAR _ehRef = [Série · é o mês de referência]
			VAR _idc = [IDC · foco no mês]
			VAR _max = [T2 · IDC · máximo na janela]
			VAR _min = [T2 · IDC · mínimo na janela]
			VAR _extremo = [T2 · IDC · mês com rótulo]
			VAR _cheio = [Nota · limite custo · ponto cheio]
			VAR _trv = [Nota · limite custo · trava]
			-- 3 · Geometria
			VAR _hi = MAX ( _max, _cheio ) + 0.02 -- geometria
			VAR _lo = MIN ( _min, _trv ) - 0.02 -- geometria
			VAR _k = DIVIDE ( 216, _hi - _lo ) -- geometria
			VAR _y1 = 20 + ROUND ( ( _hi - _cheio ) * _k, 0 ) -- geometria
			VAR _y9 = 20 + ROUND ( ( _hi - _trv ) * _k, 0 ) -- geometria
			VAR _yV = 20 + ROUND ( ( _hi - _idc ) * _k, 0 ) -- geometria
			VAR _yTop = MIN ( _y1, _yV ) -- geometria
			VAR _h = MAX ( ABS ( _yV - _y1 ), 2 ) -- geometria
			VAR _yRot = IF ( _idc >= _cheio, _yTop - 20, _yTop + _h + 3 ) -- geometria
			VAR _atraso = ( _pos - 1 ) * ROUND ( DIVIDE ( 420, _n ), 0 ) -- geometria
			-- 2 · Textos
			VAR _cls = SWITCH ( TRUE (), ISBLANK ( _idc ), "", ROUND ( _idc, 2 ) >= _cheio, "q0", ROUND ( _idc, 2 ) >= _trv, "q1", "q2" )
			VAR _rotula = NOT ISBLANK ( _idc ) && ( _ehRef = 1 || _extremo = 1 || _n <= 6 )
			VAR _txtV = FORMAT ( _idc, "0.00", "pt-BR" )
			VAR _comAno = _n <= 8 || _pos = 1 || _mesAbrev = "jan"
			VAR _rotMes = IF ( _comAno, _mesAno, _mesAbrev )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        _noRecorte = 1 && NOT ISBLANK ( _max ),
			        "<div class='u mm'>"
			            & "<i class='l1 a-gx' style='top:" & _y1 & "px;animation-delay:" & _atraso & "ms'></i>"
			            & "<i class='l9 a-gx' style='top:" & _y9 & "px;animation-delay:" & _atraso & "ms'></i>"
			            & IF ( ISBLANK ( _idc ), "", "<i class='b " & _cls & "' style='top:" & _yTop & "px;height:" & _h & "px' data-rk='m" & _pos & "' data-rp='top,height' data-r0-top='" & _y1 & "px' data-r0-height='0px' data-rd='" & _atraso & "'></i>" )
			            & IF ( _rotula, "<span class='v" & IF ( _cls = "q2", " ng", "" ) & "' style='top:" & _yRot & "px'>" & "⁅" & _txtV & "⁆" & "</span>" )
			            & "<span class='ms a-fd" & IF ( _ehRef = 1, " ref", IF ( ISBLANK ( _idc ), " sem", "" ) ) & "' style='animation-delay:" & _atraso & "ms'>" & _rotMes & "</span>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\IDC, mês a mês
		lineageTag: 34b849da-801a-50f9-8679-e9425cd4f3da

	/// Subtítulo do IDC mês a mês com a régua e a janela em uso: linha cheia em 1,00, tracejada na trava · jan–set/26 (um mês só: set/26). Os limites vêm das medidas Nota · limite custo · ….
	measure 'T2 · Mês a mês · HTML subtítulo' =
			-- 1 · Leituras
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _n = [Série · meses até a referência]
			VAR _cheio = [Nota · limite custo · ponto cheio]
			VAR _trv = [Nota · limite custo · trava]
			-- 2 · Textos
			VAR _txtRef = FORMAT ( _ref, "mmm/yy", "pt-BR" )
			VAR _txtIni = IF ( YEAR ( _ini ) = YEAR ( _ref ), FORMAT ( _ini, "mmm", "pt-BR" ), FORMAT ( _ini, "mmm/yy", "pt-BR" ) )
			VAR _txtJanela = IF ( _n <= 1, _txtRef, _txtIni & "–" & _txtRef )
			VAR _txt = "linha em " & "⁅" & FORMAT ( _cheio, "0.00", "pt-BR" ) & "⁆" & " · tracejado na trava, " & "⁅" & FORMAT ( _trv, "0.00", "pt-BR" ) & "⁆" & " · " & _txtJanela
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF ( NOT ISBLANK ( _ref ), "<p class='u ms2'>" & _txt & "</p>" & [Comum · JS contador] )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\IDC, mês a mês
		lineageTag: c072602c-e1a1-5b5b-ba3b-2be0ef5d1620

	/// Primeiro mês da sequência atual de IDC abaixo de 1 que chega ao mês de referência (vazio quando o IDC de referência não está abaixo de 1).
	measure 'T2 · IDC · abaixo de 1 desde' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@i", VAR _v = [IDC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
			VAR _ultimoOk = MAXX ( FILTER ( _meses, NOT ISBLANK ( [@i] ) && [@i] >= 1 ), dMes[Mes] )
			VAR _abaixo = FILTER ( _meses, NOT ISBLANK ( [@i] ) && [@i] < 1 && ( ISBLANK ( _ultimoOk ) || dMes[Mes] > _ultimoOk ) )
			RETURN
			    IF ( MAXX ( FILTER ( _meses, dMes[Mes] = _ref ), [@i] ) < 1, MINX ( _abaixo, dMes[Mes] ) )
		formatString: dd/mm/yyyy
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: 0bf0849d-14c3-5b18-a379-308f06fbb3a2

	/// Meses da janela em que o IDC da obra em foco ficou abaixo de 1 (gastou mais do que agregou).
	measure 'T2 · IDC · meses abaixo de 1 na janela' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@i", VAR _v = [IDC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
			RETURN
			    COUNTROWS ( FILTER ( _meses, NOT ISBLANK ( [@i] ) && [@i] < 1 ) ) + 0
		formatString: 0
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: b7e0c29e-3d1f-540d-80d2-b7f1d98cdc97

	/// O maior IDC da obra em foco nos meses da janela (do primeiro ao de referência); vazio sem aba.
	measure 'T2 · IDC · máximo na janela' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@i", [IDC · foco no mês] )
			RETURN
			    MAXX ( FILTER ( _meses, NOT ISBLANK ( [@i] ) ), [@i] )
		formatString: 0.000
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: 425984cb-005b-59fb-8512-069d8a947858

	/// 1 quando o mês do eixo é o do maior ou o do menor IDC da janela (o desenho escreve o valor nesses meses e no de referência); 0 nos demais.
	measure 'T2 · IDC · mês com rótulo' =
			VAR _m = MAX ( dMes[Mes] )
			RETURN
			    IF ( HASONEVALUE ( dMes[Mes] ), INT ( _m = [T2 · IDC · mês do maior] || _m = [T2 · IDC · mês do menor] ) )
		formatString: 0
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: b71d6823-4b06-597d-bbda-f643e820faca

	/// Mês da janela com o maior IDC da obra em foco (empate: o mais recente); vazio sem aba.
	measure 'T2 · IDC · mês do maior' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = FILTER ( ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@i", VAR _v = [IDC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) ), NOT ISBLANK ( [@i] ) )
			VAR _x = MAXX ( _meses, [@i] )
			RETURN
			    MAXX ( FILTER ( _meses, [@i] = _x ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: 6525e207-982f-5eda-948a-1ff5ed92b28d

	/// Mês da janela com o menor IDC da obra em foco (empate: o mais recente); vazio sem aba.
	measure 'T2 · IDC · mês do menor' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = FILTER ( ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@i", VAR _v = [IDC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) ), NOT ISBLANK ( [@i] ) )
			VAR _x = MINX ( _meses, [@i] )
			RETURN
			    MAXX ( FILTER ( _meses, [@i] = _x ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: 128c3f9b-e947-5c84-9f34-284825c3eefc

	/// O menor IDC da obra em foco nos meses da janela (do primeiro ao de referência); vazio sem aba.
	measure 'T2 · IDC · mínimo na janela' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@i", [IDC · foco no mês] )
			RETURN
			    MINX ( FILTER ( _meses, NOT ISBLANK ( [@i] ) ), [@i] )
		formatString: 0.000
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: 428b3302-5e11-5fc0-9e2c-a3bf3f2a8670

	/// IDC da obra em foco no primeiro mês da janela em que ela tem aba.
	measure 'T2 · IDC · no primeiro mês com aba · foco' =
			VAR _ini = [T2 · Leitura · primeiro mês com aba · foco]
			RETURN
			    CALCULATE ( [IDC · foco no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _ini )
		formatString: 0.00
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: f96f83a4-3e37-5c23-8267-8dc7cb64f83c

	/// Meses da janela em que a obra em foco esteve crítica na nota.
	measure 'T2 · Nota · meses críticos na janela · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _obra = [Nota · obra em foco]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@s", CALCULATE ( [Nota · status · um mês], dObra[Obra] = _obra ) )
			RETURN
			    COUNTROWS ( FILTER ( _meses, [@s] == 2 ) ) + 0
		formatString: 0
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: cf3b11c5-88ac-5303-9f2c-de4776219d06

	/// Nota da obra em foco no primeiro mês da janela em que ela tem nota completa.
	measure 'T2 · Nota · no primeiro mês com nota na janela · foco' =
			VAR _ini = [T2 · Nota · primeiro mês com nota na janela · foco]
			RETURN
			    CALCULATE ( [Nota · nota final · foco no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _ini )
		formatString: 0.00
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
		lineageTag: cefaab18-0a7a-5d11-ac55-6f3716269394

	/// O primeiro mês da janela em que a obra em foco tem nota completa.
	measure 'T2 · Nota · primeiro mês com nota na janela · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _obra = [Nota · obra em foco]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@n", CALCULATE ( [Nota · nota final · um mês], dObra[Obra] = _obra ) )
			RETURN
			    MINX ( FILTER ( _meses, NOT ISBLANK ( [@n] ) ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T2 Análise crítica\IDC, mês a mês\Contas
