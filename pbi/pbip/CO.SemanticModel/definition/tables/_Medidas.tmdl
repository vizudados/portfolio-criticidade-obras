	/// [T4 · A realizar · variação no mês] no mês de referência (seletor do drawer; sem escolha, o último mês).
	measure 'T4 · A realizar · variação no mês · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [T4 · A realizar · variação no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: a09e8ce1-4dfe-58fa-8294-07f575cacda8

	/// Causa da justificativa do desembolso (uma obra e um mês no contexto), lida do texto da planilha: efetivo, aditivo, medicao (medição concentrada), postergada (medição postergada), compra (compra antecipada), sinal (sinal de contrato) ou outra; vazio sem texto.
	measure 'T4 · Justificativa · causa' =
			VAR _t = TRIM ( [Justificativa do desembolso] )
			RETURN
			    IF (
			        NOT ISBLANK ( _t ) && _t <> "",
			        SWITCH (
			            TRUE (),
			            CONTAINSSTRING ( _t, "efetivo" ), "efetivo",
			            CONTAINSSTRING ( _t, "aditivo" ), "aditivo",
			            CONTAINSSTRING ( _t, "duas parcelas" ), "medicao",
			            CONTAINSSTRING ( _t, "postergad" ), "postergada",
			            CONTAINSSTRING ( _t, "compra antecipada" ), "compra",
			            CONTAINSSTRING ( _t, "sinal de contrato" ), "sinal",
			            "outra"
			        )
			    )
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: b180264d-2c1d-5d06-a7d3-ec9a0e7b70c2

	/// Primeiro mês da sequência, na janela e terminando no de referência, em que a carteira desembolsou acima do previsto; vazio quando o mês de referência ficou abaixo.
	measure 'T4 · Leitura desembolso · acima do previsto desde' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", [T4 · Desembolso · desvio no mês · com previsto] )
			VAR _vRef = MAXX ( FILTER ( _meses, dMes[Mes] = _ref ), [@v] )
			VAR _vale = ADDCOLUMNS ( _meses, "@ok", IF ( NOT ISBLANK ( [@v] ) && [@v] > 0, 1, 0 ) )
			VAR _noRef = MAXX ( FILTER ( _vale, dMes[Mes] = _ref ), [@ok] ) = 1
			VAR _quebra = MAXX ( FILTER ( _vale, [@ok] = 0 ), dMes[Mes] )
			VAR _inicio = MINX ( FILTER ( _vale, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] )
			RETURN
			    IF ( _noRef, _inicio )
		formatString: dd/mm/yyyy
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: dae4b784-225a-5369-a52d-bb444442ce91

	/// As três causas mais repetidas nas justificativas dos meses com desembolso acima de +10% (excesso exigido), na janela; códigos de 'T4 · Justificativa · causa' separados por '|', da mais para a menos frequente.
	measure 'T4 · Leitura desembolso · causas mais frequentes (lista)' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _pares =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( fAnaliseCritica, fAnaliseCritica[Obra], fAnaliseCritica[Mes] ),
			            "@c", [T4 · Justificativa · causa],
			            "@d", [Desembolso · desvio no mês]
			        ),
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] >= _ini && dMes[Mes] <= _ref
			    )
			VAR _excesso = FILTER ( _pares, [@d] > 0.10 && NOT ISBLANK ( [@c] ) && [@c] <> "outra" )
			VAR _ordem = DATATABLE ( "@c", STRING, "@o", INTEGER, { { "efetivo", 1 }, { "aditivo", 2 }, { "medicao", 3 }, { "postergada", 4 }, { "compra", 5 }, { "sinal", 6 } } )
			VAR _contagem =
			    ADDCOLUMNS (
			        _ordem,
			        "@n", VAR _c = [@c] RETURN COUNTROWS ( FILTER ( _excesso, [@c] = _c ) ) + 0
			    )
			VAR _top = TOPN ( 3, FILTER ( _contagem, [@n] > 0 ), [@n], DESC, [@o], ASC )
			RETURN
			    CONCATENATEX ( _top, [@c], "|", [@n], DESC, [@o], ASC )
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: 31fe1fe4-991e-58dc-aafc-f5459121d540

	/// [Desembolso · realizado no mês] no primeiro mês com aba do recorte, até o de referência.
	measure 'T4 · Leitura desembolso · desembolsado no primeiro mês' =
			VAR _ini = [T4 · Primeiro mês com aba]
			RETURN
			    CALCULATE ( [Desembolso · realizado no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _ini )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: 5b26d695-a346-5e60-80c1-bbc6ee2594cf

	/// Primeiro mês da sequência, na janela e terminando no de referência, em que o desvio do desembolso da carteira (só as obras com previsto nos dois meses) andou no mesmo sentido do último mês (sobe desde / cai desde).
	measure 'T4 · Leitura desembolso · desvio · sequência · início' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] > _ini && dMes[Mes] <= _ref ), "@v", [T4 · Desembolso · desvio · variação no mês] )
			VAR _sentidos = ADDCOLUMNS ( _meses, "@s", IF ( ISBLANK ( [@v] ), BLANK (), SIGN ( ROUND ( [@v], 4 ) ) ) )
			VAR _sinal = MAXX ( FILTER ( _sentidos, dMes[Mes] = _ref ), [@s] )
			VAR _quebra = MAXX ( FILTER ( _sentidos, ISBLANK ( [@s] ) || [@s] <> _sinal ), dMes[Mes] )
			VAR _inicio = MINX ( FILTER ( _sentidos, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] )
			RETURN
			    IF ( NOT ISBLANK ( _sinal ) && _sinal <> 0, _inicio )
		formatString: dd/mm/yyyy
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: 1b101b55-fae8-5296-8d17-227e0ee0f7d8

	/// Desvio do desembolso da carteira no mês de referência menos o do mês anterior, em pontos percentuais (> 0: sobe), só com as obras que têm previsto nos dois meses.
	measure 'T4 · Leitura desembolso · desvio · variação no mês' =
			VAR _ref = [Mês de referência]
			VAR _v = CALCULATE ( [T4 · Desembolso · desvio · variação no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _ref )
			RETURN
			    IF ( NOT ISBLANK ( _v ), _v * 100 )
		formatString: +0.00;-0.00;0.00
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: 97a6c696-3412-5810-919d-3871d77dcc42

	/// Justificativas exigidas e deixadas em branco na janela, somadas pelas obras do recorte.
	measure 'T4 · Leitura desembolso · justificativas em branco no período' =
			SUMX ( VALUES ( dObra[Obra] ), [T4 · Obra · justificativas em branco no período] ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Leituras\Contas
