	/// [Nota · nota final] da obra em foco (a que mais perde pontos na nota, ou a escolhida), no mês de referência (lida de dRankingNota, por [Nota · nota final · ranking · ref]).
	measure 'Nota · nota final · ranking · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _obra )
		formatString: 0.00
		displayFolder: Base\Obra em foco
		lineageTag: e67eab85-4d2a-5150-8671-9536b585ffc6

	/// Obra escolhida no seletor de obra (dObraFoco); na linha automática (ou sem escolha), a que mais perde pontos na nota no mês de referência entre as obras do recorte (empate: menor nota, com a pendente depois das que têm nota; depois o nome). Lê o ranking guardado em dRankingNota (as mesmas medidas, calculadas no refresh): uma conta só por chamada.
	measure 'Nota · obra em foco' =
			VAR _auto = SELECTEDVALUE ( dObraFoco[Automatico], TRUE () )
			VAR _escolha = IF ( _auto, BLANK (), SELECTEDVALUE ( dObraFoco[ObraFoco] ) )
			VAR _mes = [Mês de referência]
			VAR _recorte = VALUES ( dObra[Obra] )
			VAR _obras = FILTER ( dRankingNota, dRankingNota[Mes] = _mes && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte )
			VAR _maisPerde =
			    MAXX (
			        TOPN ( 1, _obras, dRankingNota[Perdidos], DESC, dRankingNota[NotaOrdem], ASC, dRankingNota[Obra], ASC ),
			        dRankingNota[Obra]
			    )
			RETURN
			    COALESCE ( _escolha, _maisPerde )
		displayFolder: Base\Obra em foco
		lineageTag: 7a7c153d-0134-537f-bb7c-50dc3185edf3

