	/// Primeiro mês da janela com o maior atraso em meses da obra do contexto (o rótulo do máximo e do mínimo no mini gráfico do tooltip do avanço quando os rótulos não cabem todos).
	measure 'T3 · Série · mês do maior atraso' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@v", VAR _m = dMes[Mes] RETURN CALCULATE ( [Prazo · atraso (meses)], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@v] ) )
			VAR _alvo = MAXX ( _com, [@v] )
			RETURN
			    MINX ( FILTER ( _com, [@v] = _alvo ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 17b88367-8dc8-59a6-9625-52ecfb8c91fa

