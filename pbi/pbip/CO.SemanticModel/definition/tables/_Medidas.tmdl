	/// Obras com taxa de frequência de 12 meses acima da média do setor, da maior para a menor. Ex. set/26: REDINHA|POTENGI.
	measure 'T5 · Leitura segurança · obras acima do setor (lista) · ref' =
			CONCATENATEX (
			    FILTER ( VALUES ( dObra[Obra] ), [Canteiro · taxa de frequência (12 meses) · ref] > [Nota · limite acidentes · setor] ),
			    dObra[Obra], "|", - [Canteiro · taxa de frequência (12 meses) · ref], ASC, dObra[Obra], ASC
