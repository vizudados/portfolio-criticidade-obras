	/// Ordem da obra na linha do tempo: as em andamento na ordem do avanço (as sem aba no mês depois delas, pelo início); depois as a iniciar, pelo início previsto. Vazio para as concluídas.
	measure 'T3 · Linha do tempo · posição' =
			VAR _sit = SELECTEDVALUE ( dObra[Situacao] )
			VAR _obra = SELECTEDVALUE ( dObra[Obra] )
			VAR _ini = SELECTEDVALUE ( dObra[Inicio] )
			VAR _pos = [T3 · Avanço · posição]
			VAR _mesma =
			    CALCULATETABLE (
			        SUMMARIZE ( dObra, dObra[Obra], dObra[Inicio] ),
			        REMOVEFILTERS ( dObra[Obra] ),
			        dObra[Situacao] = _sit
			    )
			VAR _antes = COUNTROWS ( FILTER ( _mesma, dObra[Inicio] < _ini || ( dObra[Inicio] = _ini && dObra[Obra] < _obra ) ) ) + 0
			RETURN
			    SWITCH (
			        TRUE (),
			        _sit = "Em andamento", IF ( NOT ISBLANK ( _pos ), _pos, 50 + _antes ),
			        _sit = "A iniciar", 100 + _antes
			    )
		formatString: 0
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: 02acfb1f-56e5-5878-a3ce-b5de3822eea0

	/// Início mais antigo entre as obras em andamento e a iniciar (escala).
	measure 'T3 · Linha do tempo · primeiro início' =
			CALCULATE (
			    MIN ( dObra[Inicio] ),
			    REMOVEFILTERS ( dObra[Obra] ),
			    dObra[Situacao] IN { "Em andamento", "A iniciar" }
			)
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: b5d5825b-341b-5608-bdd5-cbaef42835de

	/// Início mais antigo entre as obras em andamento.
	measure 'T3 · Linha do tempo · primeiro início em andamento' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			VAR _top = TOPN ( 1, FILTER ( _obras, TRUE () ), [@ini], ASC, dObra[Obra], ASC )
			RETURN
			    MAXX ( _top, [@ini] )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: 5127ba73-0df7-5cde-bf1a-d7e82a3009f1

	/// Obra em andamento com o término previsto mais próximo depois do mês de referência.
	measure 'T3 · Linha do tempo · próxima a terminar' =
			VAR _ref = [Mês de referência]
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    MAXX ( TOPN ( 1, FILTER ( _obras, [@fim] > _ref ), [@fim], ASC, dObra[Obra], ASC ), dObra[Obra] )
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: dd9b80a0-9675-5f79-a4a3-86d27b7595c8

	/// Tipo de orçamento das obras a iniciar quando é o mesmo em todas (legal); vazio quando varia.
	measure 'T3 · Linha do tempo · tipo das obras a iniciar' =
			VAR _aIniciar =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@ini", [Obra · início],
			            "@tipo", [T3 · Obra · tipo de orçamento cronograma]
			        ),
			        REMOVEFILTERS ( dObra[Obra] ),
			        dObra[Situacao] = "A iniciar"
			    )
			VAR _tipos = DISTINCT ( SELECTCOLUMNS ( _aIniciar, "@t", [@tipo] ) )
			RETURN
			    IF ( COUNTROWS ( _tipos ) = 1, MAXX ( _tipos, [@t] ) )
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: f75dfe43-8191-5c9e-8733-064059a8e70f

	/// Término previsto da primeira obra de [T3 · Linha do tempo · obras perto do fim com atraso (lista)].
	measure 'T3 · Linha do tempo · término da primeira perto do fim' =
			VAR _obra = PATHITEM ( [T3 · Linha do tempo · obras perto do fim com atraso (lista)], 1 )
			RETURN
			    LOOKUPVALUE ( dObra[TerminoPrevisto], dObra[Obra], _obra )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: a0a34eba-7038-56cd-88bd-30e212ba0228

	/// Término previsto da [T3 · Linha do tempo · próxima a terminar].
	measure 'T3 · Linha do tempo · término da próxima a terminar' =
