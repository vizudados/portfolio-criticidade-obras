		displayFolder: T2 Análise crítica\O quadradinho\Contas
		lineageTag: b9e9b2c9-aa24-5665-b18e-652a3930f7ed

	/// Tooltip de página do degrau da cascata (Como o resultado se forma): as linhas do quadradinho que formam o degrau, com o sinal da conta (zeros esmaecidos), o degrau mês a mês e uma linha de rodapé por degrau, presa ao pé. No resultado aplicado e no resultado da planilha, os degraus da conta (o "−" em vermelho) e o resultado mês a mês com valores positivos e negativos. Estado vazio: degrau todo em zero.
	measure 'T2 · Tooltip degrau · HTML' =
			-- 1 · Leituras
			VAR _deg = SELECTEDVALUE ( dDegrau[Degrau] )
			VAR _ordemDeg = [Cascata · degrau · ordem]
			VAR _rotDeg = SELECTEDVALUE ( dDegrau[Rotulo] )
			VAR _sinal = SELECTEDVALUE ( dDegrau[Sinal] )
			VAR _ref = [Mês de referência]
			VAR _obra = [Nota · obra em foco]
			VAR _mesCM = [Mês de referência · curto maiúsculo]
			VAR _mesN = [Mês de referência · nome]
			VAR _nDeg = [Cascata · degraus · foco]
			VAR _v = [Cascata · degrau · valor · foco]
			VAR _pctOrc = [Cascata · degrau · % do orçamento · foco]
			VAR _exec = [Físico · executado acumulado · foco]
			VAR _idc = [IDC · foco]
			VAR _pctRes = [Resultado % · foco]
			VAR _vVA = CALCULATE ( [Cascata · degrau · valor · foco], dDegrau[Degrau] = "ValorAgregado" )
			VAR _vCA = CALCULATE ( [Cascata · degrau · valor · foco], dDegrau[Degrau] = "CustoAplicado" )
			VAR _vRA = CALCULATE ( [Cascata · degrau · valor · foco], dDegrau[Degrau] = "ResultadoAplicado" )
			VAR _vAR = CALCULATE ( [Cascata · degrau · valor · foco], dDegrau[Degrau] = "ARealizar" )
			VAR _vR = CALCULATE ( [Cascata · degrau · valor · foco], dDegrau[Degrau] = "Resultado" )
			VAR _tabCompoe = { ( "ValorAgregado", "Credito", 1, 1 ), ( "CustoAplicado", "Desembolsado", 1, 1 ), ( "CustoAplicado", "ContasPagar", 1, 2 ), ( "CustoAplicado", "Divida", 1, 3 ), ( "CustoAplicado", "AdiantServicos", -1, 4 ), ( "CustoAplicado", "AdiantMateriais", -1, 5 ), ( "CustoAplicado", "Estoque", -1, 6 ), ( "CustoAplicado", "ReceitaPersonalizacao", -1, 7 ), ( "ARealizar", "SaldoContrato", 1, 1 ), ( "ARealizar", "Equipamentos", 1, 2 ) } /* lista */
			VAR _compoe = FILTER ( _tabCompoe, [Value1] = _deg ) /* lista */
			VAR _linhas =
			    ADDCOLUMNS (
			        _compoe,
			        "@rot", VAR _c = [Value2] RETURN CALCULATE ( [Item · rótulo], dItem[Item] = _c ),
			        "@v", VAR _c = [Value2] RETURN CALCULATE ( [Item · valor · foco], dItem[Item] = _c )
			    ) /* lista */
			VAR _nSer = [Série · meses até a referência]
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@ord", [Mês · ordem],
			        "@pos", [Série · posição na janela],
			        "@v", [Cascata · degrau · valor · foco no mês],
			        "@rot", [Mês · abreviado]
			    )
			VAR _serie = FILTER ( _meses, [@ate] = 1 ) /* lista */
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _ehConta = _deg IN { "ResultadoAplicado", "Resultado" }
			VAR _zero = ( ISBLANK ( _v ) || _v = 0 ) && NOT _ehConta
			VAR _txtSob = "COMO O RESULTADO SE FORMA · " & UPPER ( _obra ) & " · " & _mesCM
			VAR _tpoN = FORMAT ( ABS ( _pctOrc ) * 100, "0.00", "pt-BR" )
			VAR _tpoS = SWITCH ( TRUE (), ROUND ( _pctOrc * 100, 2 ) < 0, "−", ROUND ( _pctOrc * 100, 2 ) > 0, "+", "" )
			VAR _tpoTxt = IF ( ISBLANK ( _pctOrc ), "—", _tpoS & _tpoN & "%" )
			VAR _tprN = FORMAT ( ABS ( _pctRes ) * 100, "0.00", "pt-BR" )
			VAR _tprS = SWITCH ( TRUE (), ROUND ( _pctRes * 100, 2 ) < 0, "−", ROUND ( _pctRes * 100, 2 ) > 0, "+", "" )
			VAR _tprTxt = IF ( ISBLANK ( _pctRes ), "—", _tprS & _tprN & "%" )
			VAR _txtDir =
			    IF (
			        _ehConta,
			        "RESULTADO · " & "<span class='" & IF ( _tpoS = "−", "ng", "" ) & "'>" & "⁅" & _tpoTxt & "⁆" & "</span>" & " DO ORÇAMENTO",
			        IF ( _sinal < 0, "DESCONTA", "SOMA" ) & " · " & "⁅" & SUBSTITUTE ( _tpoTxt, "+", "" ) & "⁆" & " DO ORÇAMENTO"
			    )
			VAR _txtCod = "DEGRAU " & _ordemDeg & " DE " & _nDeg
			VAR _nLs = IF ( _ehConta, 3, COUNTROWS ( _linhas ) ) /* lista */
			VAR _htmlItens =
			    CONCATENATEX (
			        _linhas,
			        VAR _iv = [@v]
			        VAR _z = ISBLANK ( _iv ) || _iv = 0
			        VAR _iTxt = "R$ " & FORMAT ( ABS ( _iv + 0 ), "#,0.00", "pt-BR" )
			        RETURN
			            "<div class='lin cf so" & IF ( _z, " z", "" ) & "'><span class='sg" & IF ( [Value3] < 0, " ng'>−", "'>+" ) & "</span>"
			                & "<span class='n'>" & [@rot] & "</span><span class='v'>" & "⁅" & _iTxt & "⁆" & "</span></div>",
			        "",
			        [Value4], ASC
			    )
			VAR _t1A = ABS ( _vVA )
			VAR _t1Nu = SWITCH ( TRUE (), _t1A >= 99950000, FORMAT ( _t1A / 1000000, "0.0", "pt-BR" ), _t1A >= 999500, FORMAT ( _t1A / 1000000, "0.00", "pt-BR" ), _t1A >= 999.5, FORMAT ( _t1A / 1000, "0", "pt-BR" ), FORMAT ( _t1A, "#,0", "pt-BR" ) )
			VAR _t1Un = SWITCH ( TRUE (), _t1A >= 999500, " mi", _t1A >= 999.5, " mil", "" )
			VAR _t1N = _t1Nu & _t1Un
			VAR _t1Zero = _t1N = "0"
			VAR _t1S = IF ( _t1Zero, "", IF ( _vVA < 0, "−", "" ) )
			VAR _t1Txt = IF ( ISBLANK ( _vVA ), "—", _t1S & "R$ " & _t1N )
			VAR _t2A = ABS ( _vCA )
			VAR _t2Nu = SWITCH ( TRUE (), _t2A >= 99950000, FORMAT ( _t2A / 1000000, "0.0", "pt-BR" ), _t2A >= 999500, FORMAT ( _t2A / 1000000, "0.00", "pt-BR" ), _t2A >= 999.5, FORMAT ( _t2A / 1000, "0", "pt-BR" ), FORMAT ( _t2A, "#,0", "pt-BR" ) )
			VAR _t2Un = SWITCH ( TRUE (), _t2A >= 999500, " mi", _t2A >= 999.5, " mil", "" )
			VAR _t2N = _t2Nu & _t2Un
			VAR _t2Zero = _t2N = "0"
			VAR _t2S = IF ( _t2Zero, "", IF ( _vCA < 0, "−", "" ) )
			VAR _t2Txt = IF ( ISBLANK ( _vCA ), "—", _t2S & "R$ " & _t2N )
			VAR _t3A = ABS ( _vRA )
			VAR _t3Nu = SWITCH ( TRUE (), _t3A >= 99950000, FORMAT ( _t3A / 1000000, "0.0", "pt-BR" ), _t3A >= 999500, FORMAT ( _t3A / 1000000, "0.00", "pt-BR" ), _t3A >= 999.5, FORMAT ( _t3A / 1000, "0", "pt-BR" ), FORMAT ( _t3A, "#,0", "pt-BR" ) )
			VAR _t3Un = SWITCH ( TRUE (), _t3A >= 999500, " mi", _t3A >= 999.5, " mil", "" )
			VAR _t3N = _t3Nu & _t3Un
			VAR _t3Zero = _t3N = "0"
			VAR _t3S = IF ( _t3Zero, "", IF ( _vRA < 0, "−", "" ) )
			VAR _t3Txt = IF ( ISBLANK ( _vRA ), "—", _t3S & "R$ " & _t3N )
			VAR _t4A = ABS ( _vAR )
			VAR _t4Nu = SWITCH ( TRUE (), _t4A >= 99950000, FORMAT ( _t4A / 1000000, "0.0", "pt-BR" ), _t4A >= 999500, FORMAT ( _t4A / 1000000, "0.00", "pt-BR" ), _t4A >= 999.5, FORMAT ( _t4A / 1000, "0", "pt-BR" ), FORMAT ( _t4A, "#,0", "pt-BR" ) )
			VAR _t4Un = SWITCH ( TRUE (), _t4A >= 999500, " mi", _t4A >= 999.5, " mil", "" )
			VAR _t4N = _t4Nu & _t4Un
			VAR _t4Zero = _t4N = "0"
			VAR _t4S = IF ( _t4Zero, "", IF ( _vAR < 0, "−", "" ) )
			VAR _t4Txt = IF ( ISBLANK ( _vAR ), "—", _t4S & "R$ " & _t4N )
			VAR _t5A = ABS ( _vR )
			VAR _t5Nu = SWITCH ( TRUE (), _t5A >= 99950000, FORMAT ( _t5A / 1000000, "0.0", "pt-BR" ), _t5A >= 999500, FORMAT ( _t5A / 1000000, "0.00", "pt-BR" ), _t5A >= 999.5, FORMAT ( _t5A / 1000, "0", "pt-BR" ), FORMAT ( _t5A, "#,0", "pt-BR" ) )
			VAR _t5Un = SWITCH ( TRUE (), _t5A >= 999500, " mi", _t5A >= 999.5, " mil", "" )
			VAR _t5N = _t5Nu & _t5Un
			VAR _t5Zero = _t5N = "0"
			VAR _t5S = IF ( _t5Zero, "", IF ( _vR < 0, "−", "" ) )
			VAR _t5Txt = IF ( ISBLANK ( _vR ), "—", _t5S & "R$ " & _t5N )
			VAR _lin = "<div class='lin cf so'><span class='sg"
			VAR _htmlContaRA =
			    _lin & "'>+</span><span class='n'>Valor agregado</span><span class='v'>" & "⁅" & _t1Txt & "⁆" & "</span></div>"
			        & _lin & " ng'>−</span><span class='n'>Custo aplicado</span><span class='v'>" & "⁅" & _t2Txt & "⁆" & "</span></div>"
			        & _lin & "'>=</span><span class='n'>Resultado aplicado</span><span class='v'>" & "<span class='" & IF ( _t3S = "−", "ng", "" ) & "'>" & "⁅" & _t3Txt & "⁆" & "</span>" & "</span></div>"
			VAR _htmlContaR =
			    _lin & "'>+</span><span class='n'>Resultado aplicado</span><span class='v'>" & "<span class='" & IF ( _t3S = "−", "ng", "" ) & "'>" & "⁅" & _t3Txt & "⁆" & "</span>" & "</span></div>"
			        & _lin & "'>+</span><span class='n'>A realizar</span><span class='v'>" & "⁅" & _t4Txt & "⁆" & "</span></div>"
			        & _lin & "'>=</span><span class='n'>Resultado da planilha</span><span class='v'>" & "<span class='" & IF ( _t5S = "−", "ng", "" ) & "'>" & "⁅" & _t5Txt & "⁆" & "</span>" & "</span></div>"
			VAR _titLista = IF ( _ehConta, "Degraus da conta", "Linhas da planilha que formam o degrau" )
			VAR _txtSerieTit = _rotDeg & ", mês a mês"
			VAR _comV = FILTER ( _serie, NOT ISBLANK ( [@v] ) ) /* lista */
			VAR _vRef = MAXX ( FILTER ( _comV, dMes[Mes] = _ref ), [@v] ) /* geometria */
			VAR _vMax = MAXX ( _comV, [@v] ) /* geometria */
			VAR _vMin = MINX ( _comV, [@v] ) /* geometria */
			VAR _ext = IF ( _vRef >= _vMax, _vMin, _vMax ) /* geometria */
			VAR _mesExt = MINX ( FILTER ( _comV, [@v] = _ext && dMes[Mes] <> _ref ), dMes[Mes] ) /* geometria */
			VAR _posExt = MINX ( FILTER ( _comV, dMes[Mes] = _mesExt ), [@pos] ) /* geometria */
			VAR _pos = MAX ( _vMax, 0 ) -- geometria
			VAR _neg = MAX ( - _vMin, 0 ) -- geometria
			VAR _todaNeg = _pos = 0 -- geometria
			VAR _esc = IF ( _todaNeg, _neg, _pos + _neg ) -- geometria
			VAR _yZero = IF ( _todaNeg, 64, 20 + ROUND ( DIVIDE ( _pos, _esc ) * 44, 0 ) ) -- geometria
			VAR _wSer = DIVIDE ( 524, _nSer ) -- geometria
			VAR _bSer = MIN ( 48, ROUND ( _wSer - 16, 0 ) ) -- geometria
			VAR _hRef = MAX ( ROUND ( DIVIDE ( ABS ( _vRef ), _esc ) * 44, 0 ), 2 ) -- geometria
			VAR _yRef = IF ( _todaNeg || _vRef >= 0, _yZero - _hRef - 20, _yZero + _hRef + 4 ) -- geometria
			VAR _lRef = MIN ( MAX ( ROUND ( ( _nSer - 0.5 ) * _wSer, 0 ) - 40, -14 ), 458 ) -- geometria
			VAR _hExt = MAX ( ROUND ( DIVIDE ( ABS ( _ext ), _esc ) * 44, 0 ), 2 ) -- geometria
			VAR _yExt = IF ( _todaNeg || _ext >= 0, _yZero - _hExt - 20, _yZero + _hExt + 4 ) -- geometria
			VAR _lExt0 = MIN ( MAX ( ROUND ( ( _posExt - 0.5 ) * _wSer, 0 ) - 40, -14 ), 458 ) -- geometria
			VAR _toca = ABS ( _lExt0 - _lRef ) < 80 && ABS ( _yExt - _yRef ) < 17 -- geometria
			VAR _lExt = IF ( _toca, IF ( _lExt0 <= _lRef, _lRef - 80, _lRef + 80 ), _lExt0 ) -- geometria
			VAR _extVe = NOT _toca || ( ABS ( _lExt - _lExt0 ) <= _wSer / 2 && _lExt >= -14 && _lExt <= 458 ) -- geometria
			VAR _htmlSerie =
			    CONCATENATEX (
			        _serie,
			        VAR _p = [@v]
			        VAR _tem = NOT ISBLANK ( _p )
			        VAR _h = IF ( _tem, MAX ( ROUND ( DIVIDE ( ABS ( _p ), _esc ) * 44, 0 ), 2 ), 0 ) -- geometria
			        VAR _sobe = _todaNeg || _p >= 0
			        VAR _top = IF ( _sobe, _yZero - _h, _yZero ) -- geometria
			        VAR _atraso = ( [@pos] - 1 ) * 60 -- geometria
			        VAR _colL = ROUND ( ( [@pos] - 1 ) * _wSer, 0 ) -- geometria
			        VAR _ehRef = dMes[Mes] = _ref
			        VAR _ehExt = dMes[Mes] = _mesExt && _ext <> _vRef && _extVe
			        VAR _fA = ABS ( _p )
			        VAR _fNu = SWITCH ( TRUE (), _fA >= 99950000, FORMAT ( _fA / 1000000, "0.0", "pt-BR" ), _fA >= 999500, FORMAT ( _fA / 1000000, "0.00", "pt-BR" ), _fA >= 999.5, FORMAT ( _fA / 1000, "0", "pt-BR" ), FORMAT ( _fA, "#,0", "pt-BR" ) )
			        VAR _fUn = SWITCH ( TRUE (), _fA >= 999500, " mi", _fA >= 999.5, " mil", "" )
			        VAR _fN = _fNu & _fUn
			        VAR _fZero = _fN = "0"
			        VAR _fS = IF ( _fZero, "", IF ( _p < 0, "−", "" ) )
			        VAR _fTxt = IF ( ISBLANK ( _p ), "—", _fS & "R$ " & _fN )
			        VAR _ngRot = IF ( _fS = "−", " ng", "" )
			        VAR _yRot = IF ( _sobe, _top - 20, _top + _h + 4 ) -- geometria
			        VAR _cls = IF ( _p = 0, "z0", IF ( _ehRef, "nr", "nt" ) & IF ( _p < 0, " ng", "" ) )
			        VAR _rot =
			            SWITCH (
			                TRUE (),
			                _tem && _ehRef, "<span class='val fim" & _ngRot & "' style='left:" & ( _lRef - _colL ) & "px;top:" & _yRot & "px;animation-delay:" & ( _atraso + 700 ) & "ms'>" & "⁅" & _fTxt & "⁆" & "</span>",
			                _tem && _ehExt, "<span class='val" & _ngRot & "' style='left:" & ( _lExt - _colL ) & "px;top:" & _yRot & "px'>" & "⁅" & _fTxt & "⁆" & "</span>",
			                ""
			            )
			        RETURN
			            "<div class='c'>" & _rot
			                & IF ( _tem, "<i class='bar " & _cls & "' style='top:" & _top & "px;height:" & _h & "px' data-rk='m" & [@ord] & "' data-rp='top,height' data-r0-top='" & _yZero & "px' data-r0-height='0px' data-rd='" & _atraso & "'></i>" )
			                & "<span class='ms" & IF ( _ehRef, " ref", IF ( _tem, "", " sem" ) ) & "'>" & [@rot] & "</span></div>",
			        "",
			        dMes[Mes], ASC
			    )
			VAR _altSerie =
			    IF ( _todaNeg, 86, _yZero + ROUND ( DIVIDE ( _neg, _esc ) * 44, 0 ) + IF ( _neg > 0, 21, 0 ) + 22 ) -- geometria
			VAR _teN = FORMAT ( ABS ( _exec ) * 100, "0.0", "pt-BR" )
			VAR _teS = IF ( ROUND ( _exec * 100, 1 ) < 0, "−", "" )
			VAR _teTxt = IF ( ISBLANK ( _exec ), "—", _teS & _teN & "%" )
			VAR _txtIdc = FORMAT ( _idc, "0.00", "pt-BR" )
			VAR _txtRod =
			    SWITCH (
			        TRUE (),
			        _zero, "Nada lançado em " & _mesN & ": o degrau fica em zero.",
			        _deg = "ValorAgregado", "Único degrau que cresce com o físico: " & "⁅" & _teTxt & "⁆" & " executado × orçamento.",
			        _deg = "CustoAplicado", "O que já virou obra, com a dívida. IDC = agregado ÷ este custo: " & "⁅" & _txtIdc & "⁆" & ".",
			        _deg = "ResultadoAplicado", "O que a obra já ganhou ou perdeu no que executou.",
			        _deg = "ARealizar", "A planilha conta como ganho e ainda não aconteceu.",
			        "É o que a planilha apresenta: " & "<span class='" & IF ( _tprS = "−", "ng", "" ) & "'>" & "⁅" & _tprTxt & "⁆" & "</span>" & " do orçamento."
			    )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _deg ) && NOT ISBLANK ( [Orçamento · foco] ),
			        "<div class='u tt'><div class='cab sobre-preto'><p class='vs sob'>" & _txtSob & "</p>"
			            & "<div class='tl'><div class='tit'><b>" & _rotDeg & "</b>" & "<em class='vs'>" & _txtCod & "</em>" & "</div>"
			            & "<p class='vs dir'>" & _txtDir & "</p></div></div>"
			            & "<div class='corpo crp'><div class='bh'><span class='vs'>" & _titLista & "</span><span class='vs'>Valor</span></div>"
			            & "<div class='lsb" & " ls " & SWITCH ( TRUE (), _nLs <= 3, "e1", _nLs <= 6, "e2", _nLs <= 9, "e3", _nLs <= 12, "e4", "e5" ) & "' style='--n:" & _nLs & "'>" & SWITCH ( _deg, "ResultadoAplicado", _htmlContaRA, "Resultado", _htmlContaR, _htmlItens ) & "</div>"
			            & IF ( _vMax = 0 && _vMin = 0, "", "<div class='rg'></div><span class='vs sl'>" & _txtSerieTit & "</span>" & "<div class='ser' style='--alt:" & _altSerie & "px;--b:" & _bSer & "px'>" & _htmlSerie & "</div>" ) & "</div>"
			            & "<div class='rp'><div class='rg'></div>" & "<p class='rod'>" & _txtRod & "</p></div>"
			        & "</div>" & [Comum · JS contador tooltip] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Tooltips
		lineageTag: 212e6ae1-8f84-5011-84a3-eec032ad5ba5

	/// Tooltip de página do item da nota (linha de Itens da nota): as faixas do item como estão no modelo, com a faixa atingida marcada na cor dos pontos, o X do mês, os pontos do item mês a mês na obra em foco e, no rodapé preso ao pé, o que mudou desde o mês anterior. Estados: com dado, sem dado (falta na base / sem dado na planilha), valor fora da faixa válida.
	measure 'T2 · Tooltip item da nota · HTML' =
			-- 1 · Leituras
			VAR _cod = SELECTEDVALUE ( dItemNota[Item] )
			VAR _nome = [Nota · item · nome]
			VAR _fonte = [Nota · item · fonte]
			VAR _pts = [Nota · item · pontos · foco]
			VAR _poss = [Nota · item · possíveis · foco]
			VAR _x = [Nota · item · X · foco]
			VAR _fx = [Nota · item · faixa atingida · foco]
			VAR _faixas = [Nota · item · faixas]
			VAR _ptsAnt = [T2 · Item da nota · pontos no mês anterior · foco]
			VAR _possAnt = [T2 · Item da nota · possíveis no mês anterior · foco]
			VAR _foraAnt = [T2 · Item da nota · fora da faixa no mês anterior · foco] + 0
			VAR _ref = [Mês de referência]
			VAR _obra = [Nota · obra em foco]
			VAR _mesCM = [Mês de referência · curto maiúsculo]
			VAR _mesN = [Mês de referência · nome]
			VAR _mesAntN = [Mês anterior à referência · nome]
			VAR _nSer = [Série · meses até a referência]
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@ord", [Mês · ordem],
			        "@pos", [Série · posição na janela],
			        "@v", [Nota · item · pontos · foco no mês],
			        "@p", [Nota · item · possíveis · foco no mês],
			        "@rot", [Mês · abreviado]
			    )
			VAR _serie =
			    ADDCOLUMNS (
			        FILTER ( _meses, [@ate] = 1 ), /* lista */
			        "@s",
			            IF (
			                ISBLANK ( [@v] ) || [@p] = 0, BLANK (),
			                IF ( [@v] >= [@p], 0, IF ( [@v] = 0, 2, 1 ) )
			            )
			    ) /* lista */
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _caTxt = IF ( ISBLANK ( _pts ), "sem dado na planilha", FORMAT ( _pts, "0.0#", "pt-BR" ) & " de " & FORMAT ( _poss, "0.0#", "pt-BR" ) )
			VAR _cbTxt = IF ( ISBLANK ( _pts ), "falta na base", FORMAT ( _pts, "0.0#", "pt-BR" ) & " de " & FORMAT ( _poss, "0.0#", "pt-BR" ) )
			VAR _cnTxt = IF ( ISBLANK ( _ptsAnt ), "falta na base", FORMAT ( _ptsAnt, "0.0#", "pt-BR" ) & " de " & FORMAT ( _possAnt, "0.0#", "pt-BR" ) )
			VAR _txtPts = IF ( _fonte = "Análise Crítica", _caTxt, _cbTxt )
			VAR _fora = [Nota · item · fora da faixa · foco]
			VAR _txtDir =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _pts ) && _fora = 1, "valor fora da faixa válida",
			        NOT ISBLANK ( _pts ) && _poss = 0, "não conta",
			        "⁅" & _txtPts & "⁆"
			    )
			VAR _txtSob = "ITENS DA NOTA · " & UPPER ( _obra ) & " · " & _mesCM & " · " & UPPER ( _fonte )
			VAR _xA1 = ROUND ( ABS ( _x ) * 100, 1 )
			VAR _xPct = FORMAT ( _xA1, "0.0", "pt-BR" ) & "%"
			VAR _xMes = FORMAT ( ABS ( _x ), "0.0", "pt-BR" ) & IF ( ROUND ( ABS ( _x ), 1 ) <= 1, " mês", " meses" )
			VAR _txtX =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _pts ), "",
			        _cod = "custo", "<b class='" & IF ( _x < 1, "ng", "" ) & "'>IDC " & FORMAT ( _x, "0.00", "pt-BR" ) & "</b>",
			        _cod = "prazo",
			            "<b>" & IF ( ROUND ( _x, 1 ) > 0, "atraso de " & _xMes, IF ( ROUND ( _x, 1 ) < 0, "adiantada " & _xMes, "em dia" ) ) & "</b>",
			        _cod = "acidentes", "<b>TF " & FORMAT ( _x, "0.0", "pt-BR" ) & "</b>",
			        _cod = "analise", "<b>" & FORMAT ( _x, "0" ) & " de 3 checagens</b>",
			        "<b>" & _xPct & "</b>"
			    )
			VAR _clsOn = IF ( ISBLANK ( _pts ) || _poss = 0, "mkv", IF ( _pts >= _poss, "mk0", IF ( _pts = 0, "mk2", "mk1" ) ) )
			VAR _segs = SUBSTITUTE ( _faixas, " · ", "|" )
			VAR _nSeg = IF ( _segs = "", 0, PATHLENGTH ( _segs ) )
			VAR _htmlFx =
			    CONCATENATEX (
			        GENERATESERIES ( 1, _nSeg ),
			        VAR _sg = PATHITEM ( _segs, [Value] )
			        VAR _on = NOT ISBLANK ( _fx ) && LEFT ( _sg, LEN ( _fx ) + 2 ) = _fx & " →"
			        RETURN
			            "<span class='f" & IF ( _on, " on", "" ) & "'><i class='mk " & IF ( _on, _clsOn, "mkv" ) & "'></i>"
			                & SUBSTITUTE ( SUBSTITUTE ( _sg, "<", "&lt;" ), ">", "&gt;" ) & "</span>",
			        "",
			        [Value], ASC
			    ) /* lista */
			VAR _txtNota = [Nota · item · explica]
			VAR _nFx = MAX ( 1, ROUNDUP ( _nSeg / 2, 0 ) )
			VAR _txtFxTit = "Faixas"
			VAR _txtNoMes = IF ( _txtX = "", "", "No mês: " & _txtX )
			VAR _comV = FILTER ( _serie, NOT ISBLANK ( [@v] ) ) /* lista */
			VAR _vRef = MAXX ( FILTER ( _comV, dMes[Mes] = _ref ), [@v] ) /* geometria */
			VAR _vMax = MAXX ( _comV, [@v] ) /* geometria */
			VAR _vMin = MINX ( _comV, [@v] ) /* geometria */
			VAR _ext = IF ( _vRef >= _vMax, _vMin, _vMax ) /* geometria */
			VAR _mesExt = MINX ( FILTER ( _comV, [@v] = _ext && dMes[Mes] <> _ref ), dMes[Mes] ) /* geometria */
			VAR _posExt = MINX ( FILTER ( _comV, dMes[Mes] = _mesExt ), [@pos] ) /* geometria */
			VAR _pos = MAX ( _vMax, 0 ) -- geometria
			VAR _neg = MAX ( - _vMin, 0 ) -- geometria
			VAR _todaNeg = _pos = 0 -- geometria
			VAR _esc = IF ( _todaNeg, _neg, _pos + _neg ) -- geometria
			VAR _yZero = IF ( _todaNeg, 64, 20 + ROUND ( DIVIDE ( _pos, _esc ) * 44, 0 ) ) -- geometria
			VAR _wSer = DIVIDE ( 524, _nSer ) -- geometria
			VAR _bSer = MIN ( 48, ROUND ( _wSer - 16, 0 ) ) -- geometria
			VAR _hRef = MAX ( ROUND ( DIVIDE ( ABS ( _vRef ), _esc ) * 44, 0 ), 2 ) -- geometria
			VAR _yRef = IF ( _todaNeg || _vRef >= 0, _yZero - _hRef - 20, _yZero + _hRef + 4 ) -- geometria
			VAR _lRef = MIN ( MAX ( ROUND ( ( _nSer - 0.5 ) * _wSer, 0 ) - 40, -14 ), 458 ) -- geometria
			VAR _hExt = MAX ( ROUND ( DIVIDE ( ABS ( _ext ), _esc ) * 44, 0 ), 2 ) -- geometria
			VAR _yExt = IF ( _todaNeg || _ext >= 0, _yZero - _hExt - 20, _yZero + _hExt + 4 ) -- geometria
			VAR _lExt0 = MIN ( MAX ( ROUND ( ( _posExt - 0.5 ) * _wSer, 0 ) - 40, -14 ), 458 ) -- geometria
			VAR _toca = ABS ( _lExt0 - _lRef ) < 80 && ABS ( _yExt - _yRef ) < 17 -- geometria
			VAR _lExt = IF ( _toca, IF ( _lExt0 <= _lRef, _lRef - 80, _lRef + 80 ), _lExt0 ) -- geometria
			VAR _extVe = NOT _toca || ( ABS ( _lExt - _lExt0 ) <= _wSer / 2 && _lExt >= -14 && _lExt <= 458 ) -- geometria
			VAR _htmlSerie =
			    CONCATENATEX (
			        _serie,
			        VAR _p = [@v]
			        VAR _tem = NOT ISBLANK ( _p )
			        VAR _h = IF ( _tem, MAX ( ROUND ( DIVIDE ( ABS ( _p ), _esc ) * 44, 0 ), 2 ), 0 ) -- geometria
			        VAR _sobe = _todaNeg || _p >= 0
			        VAR _top = IF ( _sobe, _yZero - _h, _yZero ) -- geometria
			        VAR _atraso = ( [@pos] - 1 ) * 60 -- geometria
			        VAR _colL = ROUND ( ( [@pos] - 1 ) * _wSer, 0 ) -- geometria
			        VAR _ehRef = dMes[Mes] = _ref
			        VAR _ehExt = dMes[Mes] = _mesExt && _ext <> _vRef && _extVe
			        VAR _fTxt = FORMAT ( _p, "0.0#", "pt-BR" )
			        VAR _fS = ""
			        VAR _ngRot = ""
			        VAR _yRot = IF ( _sobe, _top - 20, _top + _h + 4 ) -- geometria
			        VAR _cls = IF ( ISBLANK ( [@s] ), "z0", "s" & [@s] )
			        VAR _rot =
			            SWITCH (
			                TRUE (),
			                _tem && _ehRef, "<span class='val fim" & _ngRot & "' style='left:" & ( _lRef - _colL ) & "px;top:" & _yRot & "px;animation-delay:" & ( _atraso + 700 ) & "ms'>" & "⁅" & _fTxt & "⁆" & "</span>",
			                _tem && _ehExt, "<span class='val" & _ngRot & "' style='left:" & ( _lExt - _colL ) & "px;top:" & _yRot & "px'>" & "⁅" & _fTxt & "⁆" & "</span>",
			                ""
			            )
			        RETURN
			            "<div class='c'>" & _rot
			                & IF ( _tem, "<i class='bar " & _cls & "' style='top:" & _top & "px;height:" & _h & "px' data-rk='m" & [@ord] & "' data-rp='top,height' data-r0-top='" & _yZero & "px' data-r0-height='0px' data-rd='" & _atraso & "'></i>" )
			                & "<span class='ms" & IF ( _ehRef, " ref", IF ( _tem, "", " sem" ) ) & "'>" & [@rot] & "</span></div>",
			        "",
			        dMes[Mes], ASC
			    )
			VAR _altSerie =
			    IF ( _todaNeg, 86, _yZero + ROUND ( DIVIDE ( _neg, _esc ) * 44, 0 ) + IF ( _neg > 0, 21, 0 ) + 22 ) -- geometria
			VAR _txtRod =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _ptsAnt ) && ISBLANK ( _pts ),
			            SWITCH (
			                TRUE (),
			                _foraAnt = 1 && _fora = 1, "Valor fora da faixa em " & _mesAntN & " e em " & _mesN & ".",
			                _fora = 1, "Sem dado em " & _mesAntN & "; em " & _mesN & ", o valor está fora da faixa.",
			                _foraAnt = 1, "Em " & _mesAntN & ", o valor estava fora da faixa; agora falta o dado.",
			                "Sem dado em " & _mesAntN & " nem em " & _mesN & "."
			            ),
			        ISBLANK ( _ptsAnt ), IF ( _foraAnt = 1, "Em " & _mesAntN & ", o valor estava fora da faixa.", "Em " & _mesAntN & ", o item não tinha dado." ),
			        ISBLANK ( _pts ), "Era " & "⁅" & _cnTxt & "⁆" & " em " & _mesAntN & IF ( _fora = 1, "; agora o valor está fora da faixa.", "; agora falta o dado." ),
			        ROUND ( _pts, 2 ) = ROUND ( _ptsAnt, 2 ) && _poss = _possAnt, "Mesmos pontos de " & _mesAntN & ".",
			        "Era " & "⁅" & _cnTxt & "⁆" & " em " & _mesAntN & "."
			    )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _cod ) && NOT ISBLANK ( [Nota · pontos possíveis · ranking · foco] ),
			        "<div class='u tt'><div class='cab sobre-preto'><p class='vs sob'>" & _txtSob & "</p>"
			            & "<div class='tl'><div class='tit'><b>" & _nome & "</b>" & "</div>"
			            & "<p class='vs dir'>" & _txtDir & "</p></div></div>"
			            & "<div class='corpo crp'><div class='bh'><span class='vs'>" & _txtFxTit & "</span><span class='vs'>" & "⁅" & _txtNoMes & "⁆" & "</span></div>"
			            & "<div class='fx" & " ls " & SWITCH ( TRUE (), _nFx <= 3, "e1", _nFx <= 6, "e2", _nFx <= 9, "e3", _nFx <= 12, "e4", "e5" ) & "' style='--n:" & _nFx & "'>" & _htmlFx & "</div>"
			            & IF ( _txtNota = "", "", "<p class='nt'>" & SUBSTITUTE ( SUBSTITUTE ( _txtNota, "<", "&lt;" ), ">", "&gt;" ) & "</p>" )
			            & IF ( ISEMPTY ( _comV ), "<div class='rg'></div><p class='vz'>Nenhum mês da janela tem dado deste item.</p>", "<div class='rg'></div><span class='vs sl'>" & "Pontos, mês a mês" & "</span>" & "<div class='ser' style='--alt:" & _altSerie & "px;--b:" & _bSer & "px'>" & _htmlSerie & "</div>" ) & "</div>"
			            & "<div class='rp'><div class='rg'></div>" & "<span class='vs'>" & "Desde " & _mesAntN & "</span>" & "<p class='rod'>" & _txtRod & "</p></div>"
			        & "</div>" & [Comum · JS contador tooltip] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Tooltips
		lineageTag: 502196f3-7b16-5586-8f43-ec0c2e479a97

	/// Tooltip de página do mês (coluna do IDC, mês a mês): como o resultado se formou no mês (valor agregado, custo aplicado, resultado aplicado com o IDC, a realizar e o resultado da planilha), o que mudou desde o mês anterior e o desembolso do mês (desvio negativo em preto); a justificativa vai no rodapé, numa linha, preso ao pé. Primeiro mês do histórico: sem o bloco 'desde'.
	measure 'T2 · Tooltip mês · HTML' =
			-- 1 · Leituras
			VAR _mesL = [Mês · longo]
			VAR _mesAntN = [Mês anterior · nome]
			VAR _obra = [Nota · obra em foco]
			VAR _selo = [Obra em foco · selo]
			VAR _aba = [Aba · foco no mês]
			VAR _primeiro = [Mês · é o primeiro do histórico] = 1
			VAR _exec = [Físico · executado acumulado · foco no mês]
			VAR _prev = [Físico · previsto acumulado · foco no mês]
			VAR _cred = [Crédito do orçamento · foco no mês]
			VAR _ca = [Custo aplicado · foco no mês]
			VAR _ra = [Resultado aplicado · foco no mês]
			VAR _ar = [A realizar · foco no mês]
			VAR _res = [Resultado da obra · foco no mês]
			VAR _idc = [IDC · foco no mês]
			VAR _pct = [Resultado % · foco no mês]
			VAR _pctAnt = [Resultado % · mês anterior · foco no mês]
			VAR _var = [Resultado · variação p.p. · foco no mês]
			VAR _estAnt = [Estoque de materiais · mês anterior · foco no mês]
			VAR _dr = [Desembolso · realizado no mês · foco no mês]
			VAR _dp = [Desembolso · previsto no mês · foco no mês]
			VAR _desv = [Desembolso · desvio no mês · foco no mês]
			VAR _pfx = CALCULATE ( [Nota · item · pontos · foco no mês], dItemNota[Item] = "caixa" )
			VAR _sfx = CALCULATE ( [Nota · item · possíveis · foco no mês], dItemNota[Item] = "caixa" )
			VAR _just = [Justificativa do desembolso · foco no mês]
			VAR _exig = [Justificativa · exigida · foco no mês]
			VAR _branco = [Justificativa · em branco · foco no mês]
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tcA = ABS ( _cred )
			VAR _tcNu = SWITCH ( TRUE (), _tcA >= 99950000, FORMAT ( _tcA / 1000000, "0.0", "pt-BR" ), _tcA >= 999500, FORMAT ( _tcA / 1000000, "0.00", "pt-BR" ), _tcA >= 999.5, FORMAT ( _tcA / 1000, "0", "pt-BR" ), FORMAT ( _tcA, "#,0", "pt-BR" ) )
			VAR _tcUn = SWITCH ( TRUE (), _tcA >= 999500, " mi", _tcA >= 999.5, " mil", "" )
			VAR _tcN = _tcNu & _tcUn
			VAR _tcZero = _tcN = "0"
			VAR _tcS = IF ( _tcZero, "", IF ( _cred < 0, "−", "" ) )
			VAR _tcTxt = IF ( ISBLANK ( _cred ), "—", _tcS & "R$ " & _tcN )
			VAR _tcKP = LEN ( _tcNu ) > 0
			VAR _tcKN = IF ( _tcKP, _tcNu )
			VAR _tcKS = SUBSTITUTE ( SUBSTITUTE ( _tcKN, ".", "" ), ",", "" )
			VAR _tcKT = IFERROR ( VALUE ( _tcKS ), -1 )
			VAR _tcKOk = _tcKP && _tcKT >= 2 && FORMAT ( _tcKT, REPT ( "0", LEN ( _tcKS ) ) ) = _tcKS
			VAR _tcKD = IF ( CONTAINSSTRING ( _tcKN, "," ), LEN ( _tcKN ) - SEARCH ( ",", _tcKN ), 0 )
			VAR _tcKM = IF ( CONTAINSSTRING ( _tcKN, "." ), "#,##0", "0" ) & IF ( _tcKD > 0, "." & REPT ( "0", _tcKD ) )
			VAR _tcKOd =
			    IF (
			        _tcKOk,
			        "<o-d><o-v>" & _tcKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcKN, FORMAT ( ROUND ( _tcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcKD ), _tcKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcNu
			    )
			VAR _tcOd = IF ( ISBLANK ( _cred ), _tcTxt, _tcS & "R$ " & _tcKOd & _tcUn )
			VAR _tcaA = ABS ( _ca )
			VAR _tcaNu = SWITCH ( TRUE (), _tcaA >= 99950000, FORMAT ( _tcaA / 1000000, "0.0", "pt-BR" ), _tcaA >= 999500, FORMAT ( _tcaA / 1000000, "0.00", "pt-BR" ), _tcaA >= 999.5, FORMAT ( _tcaA / 1000, "0", "pt-BR" ), FORMAT ( _tcaA, "#,0", "pt-BR" ) )
			VAR _tcaUn = SWITCH ( TRUE (), _tcaA >= 999500, " mi", _tcaA >= 999.5, " mil", "" )
			VAR _tcaN = _tcaNu & _tcaUn
			VAR _tcaZero = _tcaN = "0"
			VAR _tcaS = IF ( _tcaZero, "", IF ( _ca < 0, "−", "" ) )
			VAR _tcaTxt = IF ( ISBLANK ( _ca ), "—", _tcaS & "R$ " & _tcaN )
			VAR _tcaKP = LEN ( _tcaNu ) > 0
			VAR _tcaKN = IF ( _tcaKP, _tcaNu )
			VAR _tcaKS = SUBSTITUTE ( SUBSTITUTE ( _tcaKN, ".", "" ), ",", "" )
			VAR _tcaKT = IFERROR ( VALUE ( _tcaKS ), -1 )
			VAR _tcaKOk = _tcaKP && _tcaKT >= 2 && FORMAT ( _tcaKT, REPT ( "0", LEN ( _tcaKS ) ) ) = _tcaKS
			VAR _tcaKD = IF ( CONTAINSSTRING ( _tcaKN, "," ), LEN ( _tcaKN ) - SEARCH ( ",", _tcaKN ), 0 )
			VAR _tcaKM = IF ( CONTAINSSTRING ( _tcaKN, "." ), "#,##0", "0" ) & IF ( _tcaKD > 0, "." & REPT ( "0", _tcaKD ) )
			VAR _tcaKOd =
			    IF (
			        _tcaKOk,
			        "<o-d><o-v>" & _tcaKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcaKN, FORMAT ( ROUND ( _tcaKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcaKD ), _tcaKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcaNu
			    )
			VAR _tcaOd = IF ( ISBLANK ( _ca ), _tcaTxt, _tcaS & "R$ " & _tcaKOd & _tcaUn )
			VAR _traA = ABS ( _ra )
			VAR _traNu = SWITCH ( TRUE (), _traA >= 99950000, FORMAT ( _traA / 1000000, "0.0", "pt-BR" ), _traA >= 999500, FORMAT ( _traA / 1000000, "0.00", "pt-BR" ), _traA >= 999.5, FORMAT ( _traA / 1000, "0", "pt-BR" ), FORMAT ( _traA, "#,0", "pt-BR" ) )
			VAR _traUn = SWITCH ( TRUE (), _traA >= 999500, " mi", _traA >= 999.5, " mil", "" )
			VAR _traN = _traNu & _traUn
			VAR _traZero = _traN = "0"
			VAR _traS = IF ( _traZero, "", IF ( _ra < 0, "−", "" ) )
			VAR _traTxt = IF ( ISBLANK ( _ra ), "—", _traS & "R$ " & _traN )
			VAR _traKP = LEN ( _traNu ) > 0
			VAR _traKN = IF ( _traKP, _traNu )
			VAR _traKS = SUBSTITUTE ( SUBSTITUTE ( _traKN, ".", "" ), ",", "" )
			VAR _traKT = IFERROR ( VALUE ( _traKS ), -1 )
			VAR _traKOk = _traKP && _traKT >= 2 && FORMAT ( _traKT, REPT ( "0", LEN ( _traKS ) ) ) = _traKS
			VAR _traKD = IF ( CONTAINSSTRING ( _traKN, "," ), LEN ( _traKN ) - SEARCH ( ",", _traKN ), 0 )
			VAR _traKM = IF ( CONTAINSSTRING ( _traKN, "." ), "#,##0", "0" ) & IF ( _traKD > 0, "." & REPT ( "0", _traKD ) )
			VAR _traKOd =
			    IF (
			        _traKOk,
			        "<o-d><o-v>" & _traKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _traKN, FORMAT ( ROUND ( _traKT * [@odf] / 1000, 0 ) / POWER ( 10, _traKD ), _traKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _traNu
			    )
			VAR _traOd = IF ( ISBLANK ( _ra ), _traTxt, _traS & "R$ " & _traKOd & _traUn )
			VAR _tarA = ABS ( _ar )
			VAR _tarNu = SWITCH ( TRUE (), _tarA >= 99950000, FORMAT ( _tarA / 1000000, "0.0", "pt-BR" ), _tarA >= 999500, FORMAT ( _tarA / 1000000, "0.00", "pt-BR" ), _tarA >= 999.5, FORMAT ( _tarA / 1000, "0", "pt-BR" ), FORMAT ( _tarA, "#,0", "pt-BR" ) )
			VAR _tarUn = SWITCH ( TRUE (), _tarA >= 999500, " mi", _tarA >= 999.5, " mil", "" )
			VAR _tarN = _tarNu & _tarUn
			VAR _tarZero = _tarN = "0"
			VAR _tarS = IF ( _tarZero, "", IF ( _ar < 0, "−", "" ) )
			VAR _tarTxt = IF ( ISBLANK ( _ar ), "—", _tarS & "R$ " & _tarN )
			VAR _tarKP = LEN ( _tarNu ) > 0
			VAR _tarKN = IF ( _tarKP, _tarNu )
			VAR _tarKS = SUBSTITUTE ( SUBSTITUTE ( _tarKN, ".", "" ), ",", "" )
			VAR _tarKT = IFERROR ( VALUE ( _tarKS ), -1 )
			VAR _tarKOk = _tarKP && _tarKT >= 2 && FORMAT ( _tarKT, REPT ( "0", LEN ( _tarKS ) ) ) = _tarKS
			VAR _tarKD = IF ( CONTAINSSTRING ( _tarKN, "," ), LEN ( _tarKN ) - SEARCH ( ",", _tarKN ), 0 )
			VAR _tarKM = IF ( CONTAINSSTRING ( _tarKN, "." ), "#,##0", "0" ) & IF ( _tarKD > 0, "." & REPT ( "0", _tarKD ) )
			VAR _tarKOd =
			    IF (
			        _tarKOk,
			        "<o-d><o-v>" & _tarKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tarKN, FORMAT ( ROUND ( _tarKT * [@odf] / 1000, 0 ) / POWER ( 10, _tarKD ), _tarKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tarNu
			    )
			VAR _tarOd = IF ( ISBLANK ( _ar ), _tarTxt, _tarS & "R$ " & _tarKOd & _tarUn )
			VAR _tresA = ABS ( _res )
			VAR _tresNu = SWITCH ( TRUE (), _tresA >= 99950000, FORMAT ( _tresA / 1000000, "0.0", "pt-BR" ), _tresA >= 999500, FORMAT ( _tresA / 1000000, "0.00", "pt-BR" ), _tresA >= 999.5, FORMAT ( _tresA / 1000, "0", "pt-BR" ), FORMAT ( _tresA, "#,0", "pt-BR" ) )
			VAR _tresUn = SWITCH ( TRUE (), _tresA >= 999500, " mi", _tresA >= 999.5, " mil", "" )
			VAR _tresN = _tresNu & _tresUn
			VAR _tresZero = _tresN = "0"
			VAR _tresS = IF ( _tresZero, "", IF ( _res < 0, "−", "" ) )
			VAR _tresTxt = IF ( ISBLANK ( _res ), "—", _tresS & "R$ " & _tresN )
			VAR _tresKP = LEN ( _tresNu ) > 0
			VAR _tresKN = IF ( _tresKP, _tresNu )
			VAR _tresKS = SUBSTITUTE ( SUBSTITUTE ( _tresKN, ".", "" ), ",", "" )
			VAR _tresKT = IFERROR ( VALUE ( _tresKS ), -1 )
			VAR _tresKOk = _tresKP && _tresKT >= 2 && FORMAT ( _tresKT, REPT ( "0", LEN ( _tresKS ) ) ) = _tresKS
			VAR _tresKD = IF ( CONTAINSSTRING ( _tresKN, "," ), LEN ( _tresKN ) - SEARCH ( ",", _tresKN ), 0 )
			VAR _tresKM = IF ( CONTAINSSTRING ( _tresKN, "." ), "#,##0", "0" ) & IF ( _tresKD > 0, "." & REPT ( "0", _tresKD ) )
			VAR _tresKOd =
			    IF (
			        _tresKOk,
			        "<o-d><o-v>" & _tresKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tresKN, FORMAT ( ROUND ( _tresKT * [@odf] / 1000, 0 ) / POWER ( 10, _tresKD ), _tresKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tresNu
			    )
			VAR _tresOd = IF ( ISBLANK ( _res ), _tresTxt, _tresS & "R$ " & _tresKOd & _tresUn )
			VAR _teN = FORMAT ( ABS ( _exec ) * 100, "0.0", "pt-BR" )
			VAR _teS = IF ( ROUND ( _exec * 100, 1 ) < 0, "−", "" )
			VAR _teTxt = IF ( ISBLANK ( _exec ), "—", _teS & _teN & "%" )
			VAR _tpvN = FORMAT ( ABS ( _prev ) * 100, "0.0", "pt-BR" )
			VAR _tpvS = IF ( ROUND ( _prev * 100, 1 ) < 0, "−", "" )
			VAR _tpvTxt = IF ( ISBLANK ( _prev ), "—", _tpvS & _tpvN & "%" )
			VAR _tpN = FORMAT ( ABS ( _pct ) * 100, "0.00", "pt-BR" )
			VAR _tpS = SWITCH ( TRUE (), ROUND ( _pct * 100, 2 ) < 0, "−", ROUND ( _pct * 100, 2 ) > 0, "+", "" )
			VAR _tpTxt = IF ( ISBLANK ( _pct ), "—", _tpS & _tpN & "%" )
			VAR _tpaN = FORMAT ( ABS ( _pctAnt ) * 100, "0.00", "pt-BR" )
			VAR _tpaS = SWITCH ( TRUE (), ROUND ( _pctAnt * 100, 2 ) < 0, "−", ROUND ( _pctAnt * 100, 2 ) > 0, "+", "" )
			VAR _tpaTxt = IF ( ISBLANK ( _pctAnt ), "—", _tpaS & _tpaN & "%" )
			VAR _tvN = FORMAT ( ABS ( _var ), "0.00", "pt-BR" )
			VAR _tvS = SWITCH ( TRUE (), ROUND ( _var, 2 ) < 0, "−", ROUND ( _var, 2 ) > 0, "+", "" )
			VAR _tvTxt = IF ( ISBLANK ( _var ), "—", _tvS & _tvN & " p.p." )
			VAR _teaA = ABS ( _estAnt )
			VAR _teaNu = SWITCH ( TRUE (), _teaA >= 99950000, FORMAT ( _teaA / 1000000, "0.0", "pt-BR" ), _teaA >= 999500, FORMAT ( _teaA / 1000000, "0.00", "pt-BR" ), _teaA >= 999.5, FORMAT ( _teaA / 1000, "0", "pt-BR" ), FORMAT ( _teaA, "#,0", "pt-BR" ) )
			VAR _teaUn = SWITCH ( TRUE (), _teaA >= 999500, " mi", _teaA >= 999.5, " mil", "" )
			VAR _teaN = _teaNu & _teaUn
			VAR _teaZero = _teaN = "0"
			VAR _teaS = IF ( _teaZero, "", IF ( _estAnt < 0, "−", "" ) )
			VAR _teaTxt = IF ( ISBLANK ( _estAnt ), "—", _teaS & "R$ " & _teaN )
			VAR _tdrA = ABS ( _dr )
			VAR _tdrNu = SWITCH ( TRUE (), _tdrA >= 99950000, FORMAT ( _tdrA / 1000000, "0.0", "pt-BR" ), _tdrA >= 999500, FORMAT ( _tdrA / 1000000, "0.00", "pt-BR" ), _tdrA >= 999.5, FORMAT ( _tdrA / 1000, "0", "pt-BR" ), FORMAT ( _tdrA, "#,0", "pt-BR" ) )
			VAR _tdrUn = SWITCH ( TRUE (), _tdrA >= 999500, " mi", _tdrA >= 999.5, " mil", "" )
			VAR _tdrN = _tdrNu & _tdrUn
			VAR _tdrZero = _tdrN = "0"
			VAR _tdrS = IF ( _tdrZero, "", IF ( _dr < 0, "−", "" ) )
			VAR _tdrTxt = IF ( ISBLANK ( _dr ), "—", _tdrS & "R$ " & _tdrN )
			VAR _tdpA = ABS ( _dp )
			VAR _tdpNu = SWITCH ( TRUE (), _tdpA >= 99950000, FORMAT ( _tdpA / 1000000, "0.0", "pt-BR" ), _tdpA >= 999500, FORMAT ( _tdpA / 1000000, "0.00", "pt-BR" ), _tdpA >= 999.5, FORMAT ( _tdpA / 1000, "0", "pt-BR" ), FORMAT ( _tdpA, "#,0", "pt-BR" ) )
			VAR _tdpUn = SWITCH ( TRUE (), _tdpA >= 999500, " mi", _tdpA >= 999.5, " mil", "" )
			VAR _tdpN = _tdpNu & _tdpUn
			VAR _tdpZero = _tdpN = "0"
			VAR _tdpS = IF ( _tdpZero, "", IF ( _dp < 0, "−", "" ) )
			VAR _tdpTxt = IF ( ISBLANK ( _dp ), "—", _tdpS & "R$ " & _tdpN )
			VAR _tdvN = FORMAT ( ABS ( _desv ) * 100, "0", "pt-BR" )
			VAR _tdvS = SWITCH ( TRUE (), ROUND ( _desv * 100, 0 ) < 0, "−", ROUND ( _desv * 100, 0 ) > 0, "+", "" )
			VAR _tdvTxt = IF ( ISBLANK ( _desv ), "—", _tdvS & _tdvN & "%" )
			VAR _tdvKP = LEN ( _tdvN ) > 0
			VAR _tdvKN = IF ( _tdvKP, _tdvN )
			VAR _tdvKS = SUBSTITUTE ( SUBSTITUTE ( _tdvKN, ".", "" ), ",", "" )
			VAR _tdvKT = IFERROR ( VALUE ( _tdvKS ), -1 )
			VAR _tdvKOk = _tdvKP && _tdvKT >= 2 && FORMAT ( _tdvKT, REPT ( "0", LEN ( _tdvKS ) ) ) = _tdvKS
			VAR _tdvKD = IF ( CONTAINSSTRING ( _tdvKN, "," ), LEN ( _tdvKN ) - SEARCH ( ",", _tdvKN ), 0 )
			VAR _tdvKM = IF ( CONTAINSSTRING ( _tdvKN, "." ), "#,##0", "0" ) & IF ( _tdvKD > 0, "." & REPT ( "0", _tdvKD ) )
			VAR _tdvKOd =
			    IF (
			        _tdvKOk,
			        "<o-d><o-v>" & _tdvKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdvKN, FORMAT ( ROUND ( _tdvKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdvKD ), _tdvKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdvN
			    )
			VAR _tdvOd = IF ( ISBLANK ( _desv ), _tdvTxt, _tdvS & _tdvKOd & "%" )
			VAR _tfxTxt = IF ( ISBLANK ( _pfx ), "sem dado na planilha", FORMAT ( _pfx, "0.0#", "pt-BR" ) & " de " & FORMAT ( _sfx, "0.0#", "pt-BR" ) )
			VAR _txtSob = "IDC, MÊS A MÊS · " & UPPER ( _obra ) & IF ( _selo = "", "", " · " & _selo ) & IF ( _primeiro, " · PRIMEIRO MÊS DO HISTÓRICO", "" )
			VAR _txtDir = "IDC " & "⁅" & FORMAT ( _idc, "0.00", "pt-BR" ) & "⁆" & " · EXECUTADO " & "⁅" & _teTxt & "⁆" & " × PREVISTO " & "⁅" & _tpvTxt & "⁆"
			VAR _lin = "<div class='lin cf'><span class='sg"
			VAR _htmlConta =
			    _lin & "'>+</span><span class='n'>Valor agregado</span><span class='v'>" & _tcOd & "</span><span class='d'>orçamento × executado</span></div>"
			        & _lin & " ng'>−</span><span class='n'>Custo aplicado</span><span class='v'>" & _tcaOd & "</span><span class='d'>o que já virou obra</span></div>"
			        & _lin & "'>=</span><span class='n'>Resultado aplicado</span><span class='v" & IF ( _ra < 0, " ng", "" ) & "'>" & _traOd & "</span><span class='d'>IDC " & "⁅" & FORMAT ( _idc, "0.00", "pt-BR" ) & "⁆" & "</span></div>"
			        & _lin & "'>+</span><span class='n'>A realizar</span><span class='v'>" & _tarOd & "</span><span class='d'>saldo de contrato e equipamentos</span></div>"
			        & _lin & "'>=</span><span class='n'>Resultado da planilha</span><span class='v" & IF ( _res < 0, " ng", "" ) & "'>" & _tresOd & "</span><span class='d'>" & "⁅" & _tpTxt & "⁆" & " do orçamento</span></div>"
			VAR _txtDesde = "Resultado de " & "<span class='" & IF ( _tpaS = "−", "ng", "" ) & "'>" & "⁅" & _tpaTxt & "⁆" & "</span>" & " para " & "<span class='" & IF ( _tpS = "−", "ng", "" ) & "'>" & "⁅" & _tpTxt & "⁆" & "</span>" & " (" & "<span class='" & IF ( _tvS = "−", "ng", "" ) & "'>" & "⁅" & _tvTxt & "⁆" & "</span>" & ")" & IF ( ISBLANK ( _estAnt ), ".", "; o estoque era " & "⁅" & _teaTxt & "⁆" & "." )
			VAR _txtJust =
			    SWITCH (
			        TRUE (),
			        _branco = 1, "Justificativa exigida e não preenchida.",
			        _exig = 1 && TRIM ( _just ) <> "", "Justificativa: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( LOWER ( LEFT ( TRIM ( _just ), 1 ) ) & MID ( TRIM ( _just ), 2, 200 ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ),
			        ""
			    )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _cred ),
			        "<div class='u tt'><div class='cab sobre-preto'><p class='vs sob'>" & _txtSob & "</p>"
			            & "<div class='tl'><div class='tit'><b>" & _mesL & "</b>" & "<em class='vs'>" & IF ( _aba = "", BLANK (), "ABA " & _aba ) & "</em>" & "</div>"
			            & "<p class='vs dir'>" & _txtDir & "</p></div></div>"
			            & "<div class='corpo" & IF ( _txtJust = "", "", " crp" ) & "'><span class='vs sl'>Como o resultado se formou</span>"
			            & "<div class='lsb" & " ls " & SWITCH ( TRUE (), 5 <= 3, "e1", 5 <= 6, "e2", 5 <= 9, "e3", 5 <= 12, "e4", "e5" ) & "' style='--n:" & 5 & "'>" & _htmlConta & "</div>"
			            & IF ( NOT _primeiro && NOT ISBLANK ( _pctAnt ), "<div class='rg'></div><span class='vs sl'>Desde " & _mesAntN & "</span><p class='tx'>" & _txtDesde & "</p>" )
			            & "<div class='rg'></div><span class='vs sl'>Desembolso do mês" & IF ( ISBLANK ( _pfx ), "", " · previsão de " & "caixa " & "⁅" & _tfxTxt & "⁆" ) & "</span>"
			            & "<p class='des'>" & IF ( IF ( ISBLANK ( _pfx ), "", IF ( _pfx >= _sfx, "0", IF ( _pfx = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( _pfx ), "", IF ( _pfx >= _sfx, "0", IF ( _pfx = 0, "2", "1" ) ) ) & "'></i>" ) & "⁅" & _tdrTxt & "⁆" & " × " & "⁅" & _tdpTxt & "⁆" & " previsto<b>" & _tdvOd & "</b></p></div>"
			            & IF ( _txtJust = "", "", "<div class='rp'><div class='rg'></div>" & "<p class='rod'>" & _txtJust & "</p></div>" )
			        & "</div>" & [Comum · JS contador tooltip]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T2 Análise crítica\Tooltips
		lineageTag: 72c4799c-f973-5e18-a225-ffac4145a4b5

	/// CSS dos tooltips v2 da T2 (cartão branco 560, cabeçalho preto com a meta que quebra de linha, linhas de item, degrau e conta, faixa, série de uma só e rodapé preso ao pé; F4: corpo flexível, lista com escala e cascata de entrada). Não depende da CSS de tooltip da T1.
	measure 'T2 · Tooltip · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".tt{position:fixed;inset:0;background:#FFFFFF;border:1px solid #0B0B0C;border-radius:0;overflow:hidden;color:#0B0B0C}.tt .cab{background:#0B0B0C;padding:14px 18px 13px}.tt .cab .so"
			    & "b{display:block;color:rgba(233,224,207,.75);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tt .cab .tl{display:flex;flex-wrap:wrap;justify-content:space-between;align-i"
			    & "tems:baseline;column-gap:24px;row-gap:6px;margin-top:4px}.tt .cab .tit{display:flex;align-items:baseline;gap:10px;white-space:nowrap;min-width:0}.tt .cab .tit b{font-family:'Barlow"
			    & " U','Segoe UI',sans-serif;font-weight:600;font-size:21px;line-height:26px;color:#FFFFFF}.tt .cab .tit em{font-style:normal;color:rgba(233,224,207,.85)}.tt .cab .dir{color:rgba(233,"
			    & "224,207,.75);white-space:nowrap}.tt .corpo{padding:16px 18px 0}.tt .corpo .vs{display:block}.tt .sl{margin-bottom:6px}.tt .bh{display:flex;justify-content:space-between;margin-bott"
			    & "om:6px}.tt .rg{height:1px;background:#E1E1E1;margin:12px 0 11px}.tt .tx{font-size:15px;line-height:21px}.tt .vz{font-size:15px;line-height:21px;color:#3B3B3F}.tt .lin{display:grid;"
			    & "align-items:center;height:24px;white-space:nowrap}.tt .lin .v{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;line-height:20px;text-align:right;font-var"
			    & "iant-numeric:tabular-nums}.tt .lin.it{grid-template-columns:1fr 170px}.tt .lin.it .d2{font-size:15px;line-height:21px;overflow:hidden;text-overflow:ellipsis}.tt .lin.mais{display:b"
			    & "lock;font-size:14px;line-height:24px;color:#3B3B3F}.tt .lin.dg{grid-template-columns:28px 1fr 170px}.tt .lin.dg .o{font-size:13px;line-height:16px;color:#6B6B70}.tt .lin.dg .n{font"
			    & "-size:15px;line-height:21px;overflow:hidden;text-overflow:ellipsis}.tt .lin.dg.z .n,.tt .lin.dg.z .v{color:#6B6B70;opacity:.75}.tt .lin.dg.z .o{opacity:.6}.tt .lin.cf{grid-template"
			    & "-columns:20px 180px 100px 1fr;height:26px}.tt .lin.cf.so{grid-template-columns:20px 1fr 150px}.tt .lin.cf.z .n,.tt .lin.cf.z .v,.tt .lin.cf.z .sg{color:#6B6B70;opacity:.75}.tt .lin"
			    & ".cf .sg,.tt .lin.cf .n{font-weight:600;font-size:15px;line-height:21px}.tt .lin.cf .n{overflow:hidden;text-overflow:ellipsis}.tt .lin.cf .d{padding-left:16px;font-size:14px;line-he"
			    & "ight:19px;color:#3B3B3F;overflow:hidden;text-overflow:ellipsis}.tt .faixa{display:flex;align-items:center;gap:6px;white-space:nowrap;font-size:14px;line-height:19px}.tt .faixa .mk{"
			    & "margin-left:10px}.tt .faixa .mk:first-child{margin-left:0}.tt .des{display:flex;align-items:center;gap:6px;font-size:15px;line-height:21px;white-space:nowrap}.tt .des b{font-family"
			    & ":'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;margin-left:8px}.tt .rp{position:absolute;left:18px;right:18px;bottom:16px}.tt .rp .rg{margin:0 0 11px}.tt .rp .vs{"
			    & "display:block;margin-bottom:4px}.tt .rod{height:21px;font-size:15px;line-height:21px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tt .ser{display:flex;position:relati"
			    & "ve;width:524px}.tt .ser .c{flex:1 1 0;min-width:0;text-align:center;position:relative;height:var(--alt,86px)}.tt .ser .c .val{position:absolute;width:80px;text-align:center;font-fa"
			    & "mily:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;white-space:nowrap;font-variant-numeric:tabular-nums;text-shadow:1px 0 0 #FFFFFF,-1px 0 0 #FFF"
			    & "FFF,0 1px 0 #FFFFFF,0 -1px 0 #FFFFFF,0 0 3px #FFFFFF}.tt .ser .c .bar{position:absolute;left:calc(50% - var(--b,48px) / 2);width:var(--b,48px)}.tt .ser .c .bar.nt{background:rgba(1"
			    & "1,11,12,.18)}.tt .ser .c .bar.nt.ng{background:rgba(196,55,55,.35)}.tt .ser .c .bar.nr{background:#0B0B0C}.tt .ser .c .bar.nr.ng{background:#C43737}.tt .ser .c .bar.s2{background:#"
