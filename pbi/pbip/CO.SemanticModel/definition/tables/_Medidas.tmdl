	/// Resultado sem estoque e adiantamentos: resultado − ativos não consumidos.
	measure 'Resultado sem ativos' =
			[Resultado da obra] - [Ativos não consumidos]
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Base\Obra
		lineageTag: e71552c3-4ad7-59d4-90f8-b48835622da9

	/// Resultado apresentado na aba anterior de cada obra, somado.
	measure 'Resultado · mês anterior' =
			SUM ( fAnaliseCritica[ResultadoAnterior] )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Base\Obra
		lineageTag: 0b304824-8bec-5ba1-a467-0acd7031c527

	/// Resultado − resultado do mês anterior, em R$; compara só as obras com aba no mês e no mês anterior (vazio sem nenhuma).
	measure 'Resultado · variação no mês' =
			VAR _comp = FILTER ( VALUES ( fAnaliseCritica[Obra] ), NOT ISBLANK ( [Resultado · mês anterior] ) )
			RETURN
			    IF ( NOT ISEMPTY ( _comp ), SUMX ( _comp, [Resultado da obra] - [Resultado · mês anterior] ) )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Base\Obra
		lineageTag: e1f7c790-279b-5d83-aa5b-a0ad568dff13

	/// Resultado % − resultado % do mês anterior, em pontos percentuais; compara só as obras com aba no mês e no mês anterior (vazio sem nenhuma).
	measure 'Resultado · variação p.p.' =
			VAR _comp = FILTER ( VALUES ( fAnaliseCritica[Obra] ), NOT ISBLANK ( [Resultado · mês anterior] ) )
			RETURN
			    IF (
			        NOT ISEMPTY ( _comp ),
			        (
			            DIVIDE ( SUMX ( _comp, [Resultado da obra] ), SUMX ( _comp, [Orçamento] ) )
			                - DIVIDE ( SUMX ( _comp, [Resultado · mês anterior] ), SUMX ( _comp, [Orçamento · mês anterior] ) )
			        ) * 100
			    )
		formatString: +0.00;-0.00;0.00
		displayFolder: Base\Obra
		lineageTag: 960a2463-bdb0-5f99-bea4-145d1e8a4d61

	/// Item 2: saldo de contrato.
	measure 'Saldo de contrato' =
			SUM ( fAnaliseCritica[SaldoContrato] )
