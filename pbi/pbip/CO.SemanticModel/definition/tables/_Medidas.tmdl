	/// Meses da janela em que o PPC da obra em foco chegou à meta (o ponto cheio do item PPC da nota).
	measure 'T3 · PPC · meses na meta · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", VAR _v = [Canteiro · PPC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@v] ) )
			VAR _meta = [Nota · limite PPC · ponto cheio]
			RETURN
			    COUNTROWS ( FILTER ( _com, [@v] >= _meta ) ) + 0
		formatString: 0
		displayFolder: T3 Avanço físico\PPC mês a mês\Contas
		lineageTag: 1b5855f9-c10a-5ab4-8abe-47c5e80cbefe

	/// PPC médio das obras com base no mês de referência (média simples, como a carteira lê o PPC).
	measure 'T3 · PPC · média das obras · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [Canteiro · PPC], REMOVEFILTERS ( dObra[Obra] ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: 0.00%
		displayFolder: T3 Avanço físico\PPC mês a mês\Contas
		lineageTag: 5e93b1a0-2e27-5d01-87b5-651871ab10ea

	/// PPC da obra em foco no mês anterior ao do eixo (vazio sem base nesse mês).
	measure 'T3 · PPC · mês anterior · foco no mês' =
			VAR _m = EDATE ( MAX ( dMes[Mes] ), -1 )
			RETURN
			    CALCULATE ( [Canteiro · PPC · foco no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
		formatString: 0.00%
