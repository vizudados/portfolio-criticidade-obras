	/// Obras do recorte (com aba da Análise Crítica) que perderam pontos nos itens do contexto (item ou dimensão). Lido de dItemRankingNota.
	measure 'Nota · item · obras que perderam pontos' =
			VAR _t =
			    GROUPBY (
			        FILTER ( FILTER (
			        dItemRankingNota,
			        dItemRankingNota[Item] IN VALUES ( dItemNota[Item] )
			            && dItemRankingNota[Obra] IN VALUES ( dObra[Obra] )
			            && dItemRankingNota[Mes] IN VALUES ( dMes[Mes] )
			    ), dItemRankingNota[TemAC] = 1 ),
			        dItemRankingNota[Obra],
			        "@perde", SUMX ( CURRENTGROUP (), dItemRankingNota[Possiveis] - dItemRankingNota[Pontos] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _t, ROUND ( [@perde], 8 ) > 0 ) )
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: d08730b1-6672-5511-9898-e1c38e066585

	/// Ordem do item na régua (1 = custo), para desempate nas listas.
	measure 'Nota · item · ordem' =
			SELECTEDVALUE ( dItemNota[Ordem] )
