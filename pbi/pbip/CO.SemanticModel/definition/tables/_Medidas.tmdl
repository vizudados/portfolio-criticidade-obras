	/// Obras do recorte com resultado aplicado (R$) menor que o do mês anterior, no mês do contexto.
	measure 'T4 · Obras que caíram no mês' =
			VAR _obras = ADDCOLUMNS ( VALUES ( fAnaliseCritica[Obra] ), "@v", [T4 · Resultado aplicado · variação no mês] )
			RETURN
			    COUNTROWS ( FILTER ( _obras, [@v] < 0 ) ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 09ce9a5f-74de-5c03-a6f6-c38be28c87ba

	/// Nomes das obras com resultado aplicado (R$) menor que o do mês anterior, no mês do contexto, em ordem alfabética, separados por '|'.
	measure 'T4 · Obras que caíram no mês (lista)' =
			VAR _obras = ADDCOLUMNS ( VALUES ( fAnaliseCritica[Obra] ), "@v", [T4 · Resultado aplicado · variação no mês] )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@v] < 0 ), fAnaliseCritica[Obra], "|", fAnaliseCritica[Obra], ASC )
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 03de7fe7-b67d-5a87-9662-44ccb8585222

	/// Obras do recorte com resultado aplicado (R$) maior que o do mês anterior, no mês do contexto.
	measure 'T4 · Obras que subiram no mês' =
			VAR _obras = ADDCOLUMNS ( VALUES ( fAnaliseCritica[Obra] ), "@v", [T4 · Resultado aplicado · variação no mês] )
			RETURN
			    COUNTROWS ( FILTER ( _obras, [@v] > 0 ) ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 98a308ab-67ff-52c1-9772-dea14dcf11bc

	/// Nomes das obras com resultado aplicado (R$) maior que o do mês anterior, no mês do contexto, em ordem alfabética, separados por '|'.
	measure 'T4 · Obras que subiram no mês (lista)' =
			VAR _obras = ADDCOLUMNS ( VALUES ( fAnaliseCritica[Obra] ), "@v", [T4 · Resultado aplicado · variação no mês] )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@v] > 0 ), fAnaliseCritica[Obra], "|", fAnaliseCritica[Obra], ASC )
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: e6d8ce0d-c936-556c-82e1-83b9247eabb9

	/// Justificativas exigidas e em branco no mês do contexto além das 2 primeiras obras da lista (o M de 'em branco: A, B e mais M' no rodapé do tooltip); vazio com até 2 em branco.
	measure 'T4 · Tooltip mês do desembolso · em branco fora do rodapé' =
			VAR _n = [Carteira · justificativas em branco] + 0
			RETURN
			    IF ( _n > 2, _n - 2 )
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 4b251e19-af5d-53c6-8668-59b4de0efe6e

	/// Obras do recorte com aba no mês (as linhas do tooltip) que não cabem na lista: vazio com até 10 obras (todas aparecem); com mais, as que passam das 9 mostradas (o N da linha 'e mais N obras, com desvio mais perto de zero').
	measure 'T4 · Tooltip mês do desembolso · obras fora da lista' =
			VAR _n = COUNTROWS ( FILTER ( VALUES ( dObra[Obra] ), [Obras com análise] > 0 ) )
			RETURN
			    IF ( _n > 10, _n - 9 )
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 7a54a3b9-0543-5e49-8f31-81219bd5d79a

	/// Obras do recorte com resultado no mês (as linhas do tooltip) que não cabem na lista: vazio com até 10 obras (todas aparecem); com mais, as que passam das 9 mostradas (o N da linha 'e mais N obras, com resultado mais perto de zero').
	measure 'T4 · Tooltip mês · obras fora da lista' =
			VAR _n = COUNTROWS ( FILTER ( VALUES ( dObra[Obra] ), NOT ISBLANK ( [Resultado aplicado] ) ) )
			RETURN
			    IF ( _n > 10, _n - 9 )
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 72d44fbf-16dc-5360-9d77-5d11a0239d43

	/// Meses com aba (análise) da obra nos 5 meses antes do de referência, dentro da janela; decide se o histórico das justificativas aparece no tooltip. Ex. ago/26 (CAJUEIRO): 5.
	measure 'T4 · Tooltip obra do desembolso · meses com aba nos 5 anteriores' =
			VAR _ref = [Mês de referência]
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@tem", [Obras com análise]
			    )
			RETURN
			    COUNTROWS ( FILTER ( _meses, [@ate] = 1 && [@tem] > 0 && dMes[Mes] >= EDATE ( _ref, -5 ) && dMes[Mes] < _ref ) ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 3b91da3f-419d-5114-b775-1cc802e34d3c

