	/// Dias impraticáveis por chuva (média por obra) a partir dos quais o mês conta como chuvoso nas leituras. Constante.
	measure 'T5 · Chuva · limite de mês chuvoso' =
			5
		formatString: 0.00
		displayFolder: T5 Canteiro\Leituras\Contas
		lineageTag: c8d5e400-5905-54f3-b288-0303eaae6c0f

	/// Dias impraticáveis por chuva (média por obra) no mês mais chuvoso da janela. Ex. set/26: 9,6.
	measure 'T5 · Leitura chuva · dias no mês mais chuvoso' =
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _lim = [T5 · Chuva · limite de mês chuvoso]
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			            "@ch", [Canteiro · dias de chuva],
			            "@ex", [Físico · executado no mês]
			        ),
			        NOT ISBLANK ( [@ch] ) && NOT ISBLANK ( [@ex] )
			    )
			VAR _chuv = FILTER ( _t, [@ch] >= _lim )
			VAR _out = FILTER ( _t, [@ch] < _lim )
			RETURN
			    MAXX ( _t, [@ch] )
		formatString: 0.00
		displayFolder: T5 Canteiro\Leituras\Contas
		lineageTag: 5e68fb01-b330-575a-b1c6-22791143bc60

	/// Média simples do executado no mês da carteira nos meses chuvosos da janela. Ex. set/26: 3,1%.
	measure 'T5 · Leitura chuva · executado médio nos meses chuvosos' =
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _lim = [T5 · Chuva · limite de mês chuvoso]
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			            "@ch", [Canteiro · dias de chuva],
			            "@ex", [Físico · executado no mês]
			        ),
			        NOT ISBLANK ( [@ch] ) && NOT ISBLANK ( [@ex] )
			    )
			VAR _chuv = FILTER ( _t, [@ch] >= _lim )
			VAR _out = FILTER ( _t, [@ch] < _lim )
			RETURN
			    AVERAGEX ( _chuv, [@ex] )
		formatString: 0.00%
		displayFolder: T5 Canteiro\Leituras\Contas
		lineageTag: eb004a61-2230-58fc-a35c-7f1b8d85be85

	/// Média simples do executado no mês da carteira nos meses da janela que não foram chuvosos. Ex. set/26: 4,1%.
	measure 'T5 · Leitura chuva · executado médio nos outros meses' =
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _lim = [T5 · Chuva · limite de mês chuvoso]
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			            "@ch", [Canteiro · dias de chuva],
			            "@ex", [Físico · executado no mês]
			        ),
			        NOT ISBLANK ( [@ch] ) && NOT ISBLANK ( [@ex] )
			    )
			VAR _chuv = FILTER ( _t, [@ch] >= _lim )
			VAR _out = FILTER ( _t, [@ch] < _lim )
			RETURN
			    AVERAGEX ( _out, [@ex] )
		formatString: 0.00%
		displayFolder: T5 Canteiro\Leituras\Contas
		lineageTag: e2a944fe-9d42-5b9f-a589-c2bee785dc43

	/// Executado no mês da carteira no mês mais chuvoso da janela. Ex. set/26: 2,8% (abr/26).
	measure 'T5 · Leitura chuva · executado no mês mais chuvoso' =
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _lim = [T5 · Chuva · limite de mês chuvoso]
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			            "@ch", [Canteiro · dias de chuva],
			            "@ex", [Físico · executado no mês]
			        ),
			        NOT ISBLANK ( [@ch] ) && NOT ISBLANK ( [@ex] )
			    )
			VAR _chuv = FILTER ( _t, [@ch] >= _lim )
			VAR _out = FILTER ( _t, [@ch] < _lim )
			RETURN
			    MAXX ( TOPN ( 1, _t, [@ch], DESC, dMes[Mes], DESC ), [@ex] )
		formatString: 0.00%
		displayFolder: T5 Canteiro\Leituras\Contas
		lineageTag: 7fdd882f-e687-5db6-8f92-8ca2063f4bc3

	/// O menor executado no mês da carteira na janela (com base e planilha). Ex. set/26: 2,8% (abr/26).
	measure 'T5 · Leitura chuva · menor executado' =
