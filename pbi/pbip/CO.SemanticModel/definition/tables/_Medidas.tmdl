	/// Meses da janela em que a carteira (soma ÷ soma) aprovou na 1.ª inspeção pelo menos o ponto cheio da nota. Ex. set/26, 12 meses: 1 (mar/26, 95,0%).
	measure 'T5 · Leitura qualidade · meses da carteira na meta' =
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _lim = [Nota · limite inspeção · ponto cheio]
			RETURN
			    COUNTROWS ( FILTER ( ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			        "@v", [Canteiro · aprovação na 1.ª inspeção]
			    ), NOT ISBLANK ( [@v] ) && [@v] >= _lim ) ) + 0
		formatString: 0
		displayFolder: T5 Canteiro\Leituras\Contas
		lineageTag: b2c09aa2-9fae-5b9b-80f1-09134bac6409

	/// Meses da janela em que a obra em destaque ficou abaixo do ponto cheio da 1.ª inspeção. Ex. set/26: 12 (REDINHA).
	measure 'T5 · Leitura qualidade · meses da obra em destaque abaixo da meta' =
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _obra = [T5 · Qualidade · obra em destaque · ref]
			VAR _lim = [Nota · limite inspeção · ponto cheio]
			RETURN
			    IF (
			        NOT ISBLANK ( _obra ),
			        CALCULATE (
			            COUNTROWS ( FILTER ( ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			        "@v", [Canteiro · aprovação na 1.ª inspeção]
			    ), NOT ISBLANK ( [@v] ) && [@v] < _lim ) ),
			            dObra[Obra] = _obra
			        ) + 0
			    )
		formatString: 0
		displayFolder: T5 Canteiro\Leituras\Contas
		lineageTag: 5e2bdf09-544a-591f-b79f-5922c6283109

	/// Obras com [Canteiro · aprovação na 1.ª inspeção] no mês de referência abaixo do ponto cheio da nota, da menor para a maior. Ex. set/26: REDINHA|POTENGI|JANGADA.
	measure 'T5 · Leitura qualidade · obras abaixo da meta (lista) · ref' =
			CONCATENATEX (
			    FILTER ( VALUES ( dObra[Obra] ), VAR _x = [Canteiro · aprovação na 1.ª inspeção · ref] RETURN NOT ISBLANK ( _x ) && _x < [Nota · limite inspeção · ponto cheio] ),
			    dObra[Obra], "|", [Canteiro · aprovação na 1.ª inspeção · ref], ASC, dObra[Obra], ASC
			)
		displayFolder: T5 Canteiro\Leituras\Contas
		lineageTag: dbfd19d9-2e7a-59f8-9fb3-13f1c5eb9a91

	/// Obras com [Canteiro · conformidade NR-18] no mês de referência abaixo do ponto cheio da nota, da menor para a maior. Ex. set/26: POTENGI|REDINHA|JANGADA.
	measure 'T5 · Leitura segurança · obras abaixo da meta (lista) · ref' =
			CONCATENATEX (
