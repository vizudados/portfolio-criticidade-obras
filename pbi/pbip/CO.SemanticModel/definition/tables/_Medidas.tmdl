	/// [Nota · status] lido de dRankingNota quando há uma obra e um mês no contexto e a obra tem dado no mês; senão, a própria [Nota · status]. Mesmo valor, mais rápido nas listas que iteram obras × meses.
	measure 'Nota · status · ranking' =
			VAR _o = SELECTEDVALUE ( dObra[Obra] )
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _m )
			RETURN
			    IF (
			        NOT ISBLANK ( _o ) && NOT ISBLANK ( _m ) && NOT ISEMPTY ( _linha ),
			        MAXX ( _linha, dRankingNota[Status] ),
			        [Nota · status]
			    )
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 7971c1e0-1993-5dc0-9fad-cff42755f20f

	/// [Nota · status] de uma obra num mês, lido de dRankingNota (a mesma medida, guardada no refresh). Uma obra e um mês no contexto; senão, vazio.
	measure 'Nota · status · um mês' =
			VAR _o = SELECTEDVALUE ( dObra[Obra] )
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _m )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && HASONEVALUE ( dMes[Mes] ), MAXX ( _linha, dRankingNota[Status] ) )
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 76e1d190-e67a-561f-b311-7401ae84059c

	/// 1 quando a trava da régua vale: IDC abaixo de 0,9 ou atraso acima de 3 meses (crítico com qualquer nota); 0 senão; vazio sem nota. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · trava' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _idc = [Nota · X custo]
			    VAR _atraso = [Nota · X prazo]
			    RETURN
			        IF (
			            [Nota · completa] = 1,
			            IF ( _idc < 0.9 || _atraso > 3, 1, 0 )
			        )
			)
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 623d85dd-9c24-5431-b800-fc6a4d6cb0c7

	/// Por que a trava vale: 'custo' (IDC abaixo do limite), 'prazo' (atraso acima do limite) ou 'custo|prazo'; vazio sem trava. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · trava · motivo' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _idc = [Nota · X custo]
			    VAR _atraso = [Nota · X prazo]
			    VAR _c = IF ( _idc < 0.9, "custo" )
			    VAR _p = IF ( _atraso > 3, "prazo" )
			    RETURN
			        IF ( [Nota · trava] = 1, _c & IF ( _c <> "" && _p <> "", "|" ) & _p )
			)
		displayFolder: Base\Nota
		lineageTag: 6e583889-7edc-5388-a083-073ae2512e2b

	/// [Nota · trava] de uma obra num mês, lido de dRankingNota (a mesma medida, guardada no refresh). Uma obra e um mês no contexto; senão, vazio.
	measure 'Nota · trava · um mês' =
			VAR _o = SELECTEDVALUE ( dObra[Obra] )
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _m )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && HASONEVALUE ( dMes[Mes] ), MAXX ( _linha, dRankingNota[Trava] ) )
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 401c0934-da20-57ff-aee7-dcd06c6d4bf4

	/// Taxa de frequência (NBR 14280) nos 12 meses até o mês, arredondada em 8 casas; vazio sem horas trabalhadas. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · X acidentes' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _x = [Canteiro · taxa de frequência (12 meses)]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), ROUND ( _x, 8 ) )
			)
		formatString: 0.0
		displayFolder: Base\Nota
		lineageTag: f7b062fb-e311-5c6a-ad20-33ab50ce6f7c

	/// Checagens da aba do mês que passam (de 3): a conta fecha (resultado apresentado = regra, ± R$ 1); há justificativa quando o caixa desvia mais de 10%; o previsto acumulado não caiu. Vazio sem aba. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · X análise crítica' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _conta = INT ( ABS ( SUM ( fAnaliseCritica[Resultado] ) - SUM ( fAnaliseCritica[ResultadoRegra] ) ) < 1 )
			    VAR _just = INT ( NOT ( [Justificativa · em branco] = 1 ) )
			    VAR _prev = SELECTEDVALUE ( fAnaliseCritica[PrevAcum] )
			    VAR _ant = SELECTEDVALUE ( fAnaliseCritica[PrevAcumAnterior] )
			    VAR _naoCaiu = INT ( ISBLANK ( _prev ) || ISBLANK ( _ant ) || _prev >= _ant - 0.000001 )
			    RETURN
			        IF ( NOT ISEMPTY ( fAnaliseCritica ), _conta + _just + _naoCaiu )
			)
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: ca70a71b-ce1c-5823-b143-11691ec220c0

	/// |desembolsado no mês ÷ previsto no mês − 1|, arredondado em 8 casas; vazio sem previsto (ou previsto 0) ou sem desembolsado no mês. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · X caixa' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _prev = [Desembolso · previsto no mês]
			    VAR _real = [Desembolso · realizado no mês]
			    RETURN
			        IF ( NOT ISBLANK ( _prev ) && _prev <> 0 && NOT ISBLANK ( _real ), ROUND ( ABS ( DIVIDE ( _real, _prev ) - 1 ), 8 ) )
			)
		formatString: 0.00%
		displayFolder: Base\Nota
		lineageTag: 241bbebd-b570-5364-ba1e-0e7d038c6ba6

	/// IDC da obra (valor agregado ÷ custo aplicado), arredondado em 8 casas; vazio sem aba ou com custo aplicado zero. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · X custo' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _x = [IDC]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), ROUND ( _x, 8 ) )
