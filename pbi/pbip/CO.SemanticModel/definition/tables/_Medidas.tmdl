	/// Meses da janela em que o executado do mês alcançou o previsto (executado ≥ previsto; só meses com previsto na planilha). Obra do contexto.
	measure 'T3 · Ritmo · meses que alcançaram o previsto' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
