	/// Lado do cronograma (−1, 0, 1) da sequência anterior à que termina na referência, dentro da janela; vazio quando não há.
	measure 'T3 · Físico · lado da sequência anterior' =
			VAR _ref = [Mês de referência]
			VAR _ini = [T3 · Físico · sinal · início da sequência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@d", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _antes = ADDCOLUMNS ( FILTER ( _meses, NOT ISBLANK ( [@d] ) && dMes[Mes] < _ini ), "@l", IF ( NOT ISBLANK ( [@d] ), SIGN ( ROUND ( [@d], 1 ) ) ) )
			VAR _ladoAntes = MAXX ( FILTER ( _antes, dMes[Mes] = EDATE ( _ini, -1 ) ), [@l] )
			VAR _quebra = MAXX ( FILTER ( _antes, [@l] <> _ladoAntes ), dMes[Mes] )
			RETURN
			    IF ( NOT ISBLANK ( _ladoAntes ), _ladoAntes )
		formatString: 0
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 78718c01-266f-55e4-a4a2-5bb4c7d2e57e

	/// Lado do cronograma pelo desvio físico acumulado arredondado a uma casa, como a tela mostra: −1 atrás, 0 no previsto (previsto igual ao executado na planilha), 1 à frente; vazio sem previsto (JANGADA). Obra do contexto.
	measure 'T3 · Físico · lado do cronograma' =
			VAR _d = [Físico · desvio acumulado p.p.]
			RETURN
			    IF ( NOT ISBLANK ( _d ), SIGN ( ROUND ( _d, 1 ) ) )
		formatString: 0
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 425883a1-b46f-5cd0-a8ae-266a4efd2255

	/// [T3 · Físico · lado do cronograma] no mês de referência.
	measure 'T3 · Físico · lado do cronograma · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [T3 · Físico · lado do cronograma], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: 0
