	/// Obras com acidente com afastamento nos 12 meses até o de referência, da maior para a menor taxa de frequência. Ex. set/26: REDINHA|POTENGI|JANGADA.
	measure 'T5 · Leitura segurança · obras com acidente em 12 meses (lista) · ref' =
			CONCATENATEX (
			    FILTER ( VALUES ( dObra[Obra] ), [Canteiro · acidentes 12 meses · ref] > 0 ),
