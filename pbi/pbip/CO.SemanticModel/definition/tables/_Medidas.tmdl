	/// NR18Conformes ÷ NR18Aplicaveis da base, arredondado em 8 casas; vazio sem NR18Aplicaveis ou com a parte maior que o todo. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · X NR-18' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _n = SUM ( fBaseObra[NR18Conformes] )
			    VAR _d = SUM ( fBaseObra[NR18Aplicaveis] )
			    RETURN
