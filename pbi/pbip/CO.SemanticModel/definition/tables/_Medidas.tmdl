	/// Faixa da frequência de acidentes em que o X caiu (rótulo gerado dos limites). Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · faixa atingida · acidentes' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _x = [Nota · X acidentes]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x <= 0, "TF = 0",
			            _x <= 7.5, "0 < TF ≤ 7,5",
			            "TF > 7,5"
			        ) )
			)
		displayFolder: Base\Nota
		lineageTag: 0c578267-2835-50d6-bb27-f17b902aed88

	/// Faixa da análise crítica em que o X caiu (rótulo gerado dos limites). Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · faixa atingida · análise crítica' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _x = [Nota · X análise crítica]
			    RETURN
			        IF ( NOT ISBLANK ( _x ), SWITCH (
			            TRUE (),
			            _x >= 3, "3 de 3",
			            _x >= 2, "2 de 3",
			            "0 ou 1 de 3"
			        ) )
			)
		displayFolder: Base\Nota
		lineageTag: 57148dbd-0ae0-5571-9631-8d2e0dce4173

	/// Faixa da previsão de caixa em que o X caiu (rótulo gerado dos limites). Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · faixa atingida · caixa' =
