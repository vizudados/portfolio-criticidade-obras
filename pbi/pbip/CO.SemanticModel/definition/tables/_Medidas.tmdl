	/// Desembolsado ÷ previsto − 1 da obra no mês anterior ao do contexto.
	measure 'T4 · Desembolso · desvio · mês anterior' =
			VAR _mes = EDATE ( MAX ( dMes[Mes] ), -1 )
			RETURN
			    CALCULATE ( [Desembolso · desvio no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: 0.00%
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 71df5705-9189-55df-aa0e-0e51ed9e82b7

	/// Obras do recorte que entraram na faixa crítica da previsão de caixa da nota (sem ponto: desvio fora do limite, para mais ou para menos) no mês do contexto, em relação ao mês anterior; ordem alfabética, separadas por '|'.
	measure 'T4 · Desembolso · entraram na faixa crítica (lista)' =
			VAR _obras =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( dObra[Obra] ), [Obras com análise] > 0 ),
			        "@s", [T4 · Desembolso · faixa do fluxo de caixa],
			        "@a", [T4 · Desembolso · status · mês anterior]
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@s] = 2 && NOT ISBLANK ( [@a] ) && [@a] < 2 ), dObra[Obra], "|", dObra[Obra], ASC )
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 004ed004-c061-5139-bf28-e065eb528733

	/// Obras do recorte que saíram da faixa crítica da previsão de caixa da nota (sem ponto: desvio fora do limite, para mais ou para menos) no mês do contexto, em relação ao mês anterior; ordem alfabética, separadas por '|'.
	measure 'T4 · Desembolso · saíram da faixa crítica (lista)' =
			VAR _obras =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( dObra[Obra] ), [Obras com análise] > 0 ),
			        "@s", [T4 · Desembolso · faixa do fluxo de caixa],
			        "@a", [T4 · Desembolso · status · mês anterior]
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@a] = 2 && NOT ISBLANK ( [@s] ) && [@s] < 2 ), dObra[Obra], "|", dObra[Obra], ASC )
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: b31641ff-c59c-5612-9a92-2591dffb7cee

	/// Obras do recorte na faixa crítica da previsão de caixa da nota (sem ponto) no mês do contexto e no anterior.
	measure 'T4 · Desembolso · seguem na faixa crítica' =
			VAR _obras =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( dObra[Obra] ), [Obras com análise] > 0 ),
			        "@s", [T4 · Desembolso · faixa do fluxo de caixa],
			        "@a", [T4 · Desembolso · status · mês anterior]
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, [@s] = 2 && [@a] = 2 ) ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: e683eef5-9ed1-5378-bb62-daaa3519c508

	/// Faixa da previsão de caixa da nota (0/1/2, 'T4 · Desembolso · faixa do fluxo de caixa') da obra na aba anterior ao mês do contexto.
	measure 'T4 · Desembolso · status · mês anterior' =
			VAR _mes = EDATE ( MAX ( dMes[Mes] ), -1 )
			RETURN
			    CALCULATE ( [T4 · Desembolso · faixa do fluxo de caixa], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: b925d434-7a6d-50f0-b4be-fdc3ba1b6ca8

	/// Obras do recorte com justificativa exigida e em branco no mês do contexto, do maior para o menor |desvio| do desembolso (empate: ordem alfabética), separadas por '|'. O rodapé do tooltip escreve quantas couberem numa linha.
	measure 'T4 · Justificativas em branco no mês (lista)' =
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( fAnaliseCritica[Obra] ),
			        "@b", [Justificativa · em branco],
			        "@d", ABS ( [Desembolso · desvio no mês] )
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@b] = 1 ), fAnaliseCritica[Obra], "|", [@d], DESC, fAnaliseCritica[Obra], ASC )
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: b14b27ae-3072-5c7e-9790-9deea386ee89

	/// Primeiro mês da sequência, na janela e terminando no de referência, em que a obra desembolsou abaixo do previsto; vazio fora dela.
	measure 'T4 · Obra · abaixo do previsto · início' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", [Desembolso · desvio no mês] )
			VAR _vRef = MAXX ( FILTER ( _meses, dMes[Mes] = _ref ), [@v] )
			VAR _vale = ADDCOLUMNS ( _meses, "@ok", IF ( NOT ISBLANK ( [@v] ) && [@v] < 0, 1, 0 ) )
			VAR _noRef = MAXX ( FILTER ( _vale, dMes[Mes] = _ref ), [@ok] ) = 1
			VAR _quebra = MAXX ( FILTER ( _vale, [@ok] = 0 ), dMes[Mes] )
			VAR _inicio = MINX ( FILTER ( _vale, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] )
			RETURN
			    IF ( _noRef, _inicio )
		formatString: dd/mm/yyyy
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 8bccd0d5-5da7-579e-9323-b5eca9976d7c

	/// Primeiro mês da sequência, na janela e terminando no de referência, em que o desembolso da obra está na faixa crítica da previsão de caixa da nota (sem ponto, para mais ou para menos); vazio fora dela.
	measure 'T4 · Obra · faixa crítica do desembolso · início' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", [T4 · Desembolso · faixa do fluxo de caixa] )
			VAR _vRef = MAXX ( FILTER ( _meses, dMes[Mes] = _ref ), [@v] )
			VAR _vale = ADDCOLUMNS ( _meses, "@ok", IF ( NOT ISBLANK ( [@v] ) && [@v] = 2, 1, 0 ) )
			VAR _noRef = MAXX ( FILTER ( _vale, dMes[Mes] = _ref ), [@ok] ) = 1
			VAR _quebra = MAXX ( FILTER ( _vale, [@ok] = 0 ), dMes[Mes] )
			VAR _inicio = MINX ( FILTER ( _vale, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] )
			RETURN
			    IF ( _noRef, _inicio )
		formatString: dd/mm/yyyy
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: a66a361a-777b-578b-b871-faf2a56e07c4

	/// Meses da janela, até o de referência, com a justificativa exigida e o campo da planilha vazio.
	measure 'T4 · Obra · justificativas em branco no período' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			RETURN
			    SUMX ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), [Justificativa · em branco] ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: f1197676-3b2b-5a8d-8d0f-3b4376551369

	/// Meses da janela, até o de referência, em que a obra passou de ±10% de desvio no desembolso (justificativa exigida).
	measure 'T4 · Obra · justificativas exigidas no período' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			RETURN
			    SUMX ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), [Justificativa · exigida] ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 5dea086d-133f-5001-b32d-7c23dd88577a

	/// Meses da janela, até o de referência, com a justificativa exigida e preenchida.
	measure 'T4 · Obra · justificativas preenchidas no período' =
			[T4 · Obra · justificativas exigidas no período] - [T4 · Obra · justificativas em branco no período]
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 9475378f-7069-52bb-9dbf-a2307867b8e2

	/// Quantos meses seguidos da janela, terminando no de referência, a obra deixou a justificativa exigida em branco.
	measure 'T4 · Obra · meses seguidos em branco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@b", [Justificativa · em branco] )
			VAR _quebra = MAXX ( FILTER ( _meses, [@b] <> 1 ), dMes[Mes] )
			RETURN
			    COUNTROWS ( FILTER ( _meses, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ) ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: 0ec70397-d6f3-595e-a55f-5da6a3ae023c

	/// Justificativas exigidas e em branco da obra nos meses da janela anteriores aos 6 mais recentes (a linha de resumo do tooltip da obra do desembolso); vazio ou zero quando a janela tem 6 meses ou menos.
	measure 'T4 · Obra · resumo das justificativas · em branco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _corte = EDATE ( _ref, -5 )
			VAR _meses =
			    FILTER (
			        ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] < _corte ), "@tem", [Obras com análise] ),
			        [@tem] > 0
			    )
			RETURN
			    SUMX ( _meses, [Justificativa · em branco] ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Tooltips\Contas
		lineageTag: a3ef00dc-616e-5780-ae6f-bc8538de97a9

	/// Justificativas exigidas (±10%) da obra nos meses da janela anteriores aos 6 mais recentes (a linha de resumo do tooltip da obra do desembolso); vazio ou zero quando a janela tem 6 meses ou menos.
