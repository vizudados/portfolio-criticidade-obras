	/// CSS da lista Avanço das obras (uma entrada por obra) e da legenda do pé.
	measure 'T3 · Avanço · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".htmlViewerEntry{display:block!important;margin:0!important;padding:0!important}.av{position:relative;height:42px;transition:background .15s}.av.foco{background:#F7F4EE;box-shadow:"
			    & "inset 3px 0 0 #0B0B0C}.av:hover,.htmlViewerEntry.hover .av{background:rgba(233,224,207,.4)}.av .nm{position:absolute;left:14px;top:9px;font-family:'Barlow U','Segoe UI',sans-serif;"
			    & "font-weight:600;font-size:18px;line-height:22px;white-space:nowrap}.av .tr{position:absolute;left:140px;top:8px;width:282px;height:12px;background:#EFEFEF}.av .fl{position:absolute"
			    & ";left:140px;top:8px;height:12px}.av .fl.s0{background:#A9CDB9}.av .fl.s1{background:#C9821F}.av .fl.s2{background:#C43737}.av .fl.sx{background:#3B3B3F}.av .pv{position:absolute;to"
			    & "p:4px;width:2px;height:20px;background:#0B0B0C}.av .tx{position:absolute;left:140px;top:23px;font-size:14px;line-height:19px;color:#3B3B3F;white-space:nowrap}.av .dr{position:absol"
			    & "ute;right:12px;top:11px;display:flex;align-items:center;gap:8px;white-space:nowrap}.av .dv{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;line-height:2"
			    & "0px}.av .sp{position:absolute;right:12px;top:12px;font-size:14px;line-height:19px;color:#6B6B70;white-space:nowrap}.lga{position:fixed;inset:0;font-size:14px;line-height:19px;white"
			    & "-space:nowrap}.lga p{display:flex;align-items:center;height:21px;color:#3B3B3F}.lga span{display:inline-flex;align-items:center;gap:6px;margin-right:16px}.lga .mk.mkx{background:#3"
			    & "B3B3F}"
		displayFolder: T3 Avanço físico\Avanço das obras
		lineageTag: 3deeedf8-37c0-5a05-a8ef-f0d969d3d495

	/// Subtítulo do Avanço das obras, Figma 387:4415 (F3: o número da direita é o atraso em meses).
	measure 'T3 · Avanço · HTML cabeçalho' =
			-- 4 · Marcação
			"<div class='u pc'><span class='sub'>executado × previsto acumulado · à direita, o atraso em meses</span></div>"
		displayFolder: T3 Avanço físico\Avanço das obras
		lineageTag: a0ac929c-7bb8-5618-95b8-8d4bb6d376ae

	/// Legenda do Avanço das obras (pé do painel): a barra é o executado na cor dos pontos do item prazo da nota, o traço é o previsto e o número é o atraso em meses; marcas da primeira e da última faixa do item (lidas do modelo), de quem perde parte dos pontos e de sem curva prevista.
	measure 'T3 · Avanço · HTML legenda' =
			-- 2 · Textos
			VAR _fx = SUBSTITUTE ( CALCULATE ( [Nota · item · faixas], dItemNota[Item] = "prazo" ), " · ", "|" )
			VAR _fxa = PATHITEM ( _fx, 1 )
			VAR _fxz = PATHITEM ( _fx, PATHLENGTH ( _fx ) )
			VAR _fx1 = SUBSTITUTE ( SUBSTITUTE ( _fxa, "<", "&lt;" ), ">", "&gt;" )
			VAR _fxN = SUBSTITUTE ( SUBSTITUTE ( _fxz, "<", "&lt;" ), ">", "&gt;" )
			VAR _fx1s = SUBSTITUTE ( SUBSTITUTE ( LEFT ( _fxa, SEARCH ( " →", _fxa, 1, LEN ( _fxa ) + 1 ) - 1 ), "<", "&lt;" ), ">", "&gt;" )
			VAR _fxNs = SUBSTITUTE ( SUBSTITUTE ( LEFT ( _fxz, SEARCH ( " →", _fxz, 1, LEN ( _fxz ) + 1 ) - 1 ), "<", "&lt;" ), ">", "&gt;" )
			VAR _lgMk = "<span><i class='mk mk0'></i>" & "⁅" & _fx1s & "⁆" & "</span><span><i class='mk mk1'></i>perde parte</span>"
			    & "<span><i class='mk mk2'></i>" & "⁅" & _fxNs & "⁆" & "</span><span><i class='mk mkx'></i>sem curva prevista</span>"
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u lga'><p>barra = executado na cor do item prazo · traço = previsto · número = atraso (meses)</p><p>"
			        & _lgMk & "</p></div>" & [Comum · JS contador]
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Avanço das obras
		lineageTag: 1742d2d7-2207-544f-9245-615d4c1425f3

	/// Uma linha por obra com aba no mês de referência (granularidade dObra[Obra], ordem T3 · Avanço · posição): nome, trilho com o executado acumulado na cor dos pontos do item prazo da nota (cheio sálvia, perde parte ocre, zera vermelho; grafite sem curva prevista), traço do previsto (quando a aba traz), 'executado × previsto', a marca e o atraso em meses (conta; vermelho quando zera o item); a obra em foco vem destacada (Figma 289:7425). A ordem é a da nota (pontos perdidos). Sem curva prevista: 'sem curva prevista' no lugar do atraso.
	measure 'T3 · Avanço · HTML linha' =
			-- 1 · Leituras
			VAR _pos = [T3 · Avanço · posição]
			VAR _obra = [Obra · nome]
			VAR _e = [Físico · executado acumulado · ref]
			VAR _p = [Físico · previsto acumulado · ref]
			VAR _a = [Prazo · atraso (meses) · ref]
			VAR _pt = [Nota · pontos prazo · ref]
			VAR _ps = [Nota · possíveis · prazo · ref]
			VAR _foco = [T3 · Avanço · é a obra em foco]
			-- 2 · Textos
			VAR _teN = FORMAT ( ABS ( _e ) * 100, "0.0", "pt-BR" )
			VAR _teS = IF ( ROUND ( _e * 100, 1 ) < 0, "−", "" )
			VAR _teTxt = IF ( ISBLANK ( _e ), "—", _teS & _teN & "%" )
			VAR _tpN = FORMAT ( ABS ( _p ) * 100, "0.0", "pt-BR" )
			VAR _tpS = IF ( ROUND ( _p * 100, 1 ) < 0, "−", "" )
			VAR _tpTxt = IF ( ISBLANK ( _p ), "—", _tpS & _tpN & "%" )
			VAR _aA = ROUND ( ABS ( _a ), 1 )
			VAR _taN = FORMAT ( _aA, "0.0", "pt-BR" )
			VAR _taS = IF ( ROUND ( _a, 1 ) < 0, "−", "" )
			VAR _taTxt = _taS & _taN & IF ( _aA <= 1, " mês", " meses" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _taKP = LEN ( _taN ) > 0
			VAR _taKN = IF ( _taKP, _taN )
			VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
			VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
			VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
			VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
			VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
			VAR _taKOd =
			    IF (
			        _taKOk,
			        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _taN
			    )
			VAR _taOd = IF ( ISBLANK ( _a ), _taTxt, _taS & _taKOd & IF ( _aA <= 1, " mês", " meses" ) )
			VAR _chave = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
			VAR _cls = IF ( ISBLANK ( _pt ), "x", IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) )
			-- 3 · Geometria
			VAR _larg = ROUND ( MIN ( _e, 1 ) * 282, 0 ) -- geometria
			VAR _xPrev = 140 + ROUND ( MIN ( _p, 1 ) * 282, 0 ) - 1 -- geometria
			VAR _atraso = ( _pos - 1 ) * 60 -- geometria
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _e ),
			        "<div class='u av" & IF ( _foco = 1, " foco", "" ) & "' data-rr='" & _chave & "'>"
			            & "<b class='nm'>" & _chave & "</b><i class='tr a-gx' style='animation-delay:" & _atraso & "ms'></i>"
			            & "<i class='fl s" & _cls & "' style='width:" & _larg & "px' data-rk='" & _chave & "' data-rd='"
			            & _atraso & "'></i>"
			            & IF ( NOT ISBLANK ( _p ), "<i class='pv a-pop' style='left:" & _xPrev & "px;animation-delay:" & ( _atraso + 600 ) & "ms'></i>" )
			            & "<span class='tx'>" & "⁅" & _teTxt & "⁆" & " × " & IF ( ISBLANK ( _p ), "sem previsto", "⁅" & _tpTxt & "⁆" ) & "</span>"
			            & IF (
			                ISBLANK ( _a ),
			                "<span class='sp'>sem curva prevista</span>",
			                "<div class='dr'><i class='mk a-pop mk" & _cls & "' style='animation-delay:" & ( _atraso + 700 ) & "ms'></i>"
			                    & "<b class='dv" & IF ( _cls = "2", " ng", "" ) & "'>" & _taOd & "</b></div>"
			            )
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Avanço das obras
		lineageTag: 6e7a2437-d70d-5369-81ef-2ab110247b19

	/// Executado acumulado da carteira no mês de referência só com as abas que trazem o previsto, ponderado pelo orçamento como o previsto e o desvio da carteira (sem a JANGADA): o 'executado × previsto' da leitura compara o mesmo grupo.
	measure 'T3 · Avanço · executado acumulado das obras com previsto' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE (
			        [Físico · executado acumulado],
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] = _mes,
			        FILTER (
			            ALL ( fAnaliseCritica[PrevAcum], fAnaliseCritica[ExecAcum] ),
			            NOT ISBLANK ( fAnaliseCritica[PrevAcum] ) && NOT ISBLANK ( fAnaliseCritica[ExecAcum] )
			        )
			    )
		formatString: 0.00%
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: 47f92be4-3bf6-546d-9ffb-73927280bc21

	/// % executado acumulado da [T3 · Avanço · obra mais no começo].
	measure 'T3 · Avanço · executado da obra mais no começo' =
			VAR _obra = [T3 · Avanço · obra mais no começo]
			RETURN
			    CALCULATE ( [Físico · executado acumulado · ref], dObra[Obra] = _obra )
		formatString: 0.00%
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: 4efebae1-d973-5761-bdd0-fb0c71c8cb32

	/// Menor atraso em meses entre as obras no mês de referência.
	measure 'T3 · Avanço · menor atraso' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref],
			            "@a", [Prazo · atraso (meses) · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			VAR _top = TOPN ( 1, FILTER ( _obras, NOT ISBLANK ( [@a] ) ), [@a], ASC, dObra[Obra], ASC )
			RETURN
			    MAXX ( _top, [@a] )
		formatString: 0.0
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: 7bf91e7d-0229-5211-821c-821a6aef4166

	/// Obra com o menor atraso em meses no mês de referência (a mais adiantada quando há atraso negativo).
	measure 'T3 · Avanço · obra de menor atraso' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref],
			            "@a", [Prazo · atraso (meses) · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			VAR _top = TOPN ( 1, FILTER ( _obras, NOT ISBLANK ( [@a] ) ), [@a], ASC, dObra[Obra], ASC )
			RETURN
			    MAXX ( _top, dObra[Obra] )
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: 764d609c-57da-5edb-bf1b-da41e4382593

	/// Obra com o menor % executado acumulado no mês de referência.
	measure 'T3 · Avanço · obra mais no começo' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    MAXX ( TOPN ( 1, _obras, [@e], ASC, dObra[Obra], ASC ), dObra[Obra] )
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: 8aa3218d-f61c-517f-9e48-f99a00e879cf

	/// Obras atrás do cronograma: atraso em meses (cronograma agregado) acima de zero na casa decimal que a tela mostra. Obras com aba no mês de referência.
	measure 'T3 · Avanço · obras atrás do cronograma' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref],
			            "@a", [Prazo · atraso (meses) · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, ROUND ( [@a], 1 ) > 0 ) ) + 0
		formatString: 0
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: 554c4639-2ab9-52cd-b038-25d45c227017

	/// Obras com o atraso em meses calculado (curva prevista e executado no mês de referência). Obras com aba no mês de referência.
	measure 'T3 · Avanço · obras com atraso calculado' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref],
			            "@a", [Prazo · atraso (meses) · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, NOT ISBLANK ( [@a] ) ) ) + 0
		formatString: 0
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: 5e135715-f4a3-56f5-a3c8-c13fd12d9a0b

	/// Obras cujo atraso físico passa do limite do item prazo da nota (perdem os pontos do item). Obras com aba no mês de referência.
	measure 'T3 · Avanço · obras fora do limite do físico' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref],
			            "@s", [T3 · Status desvio físico · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, [@s] = 2 ) ) + 0
		formatString: 0
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: e4f16d7c-8699-5722-b99a-edac30e8625c

	/// Obras cujo atraso em meses passa do ponto cheio do item prazo da nota, do maior atraso para o menor. Obras com aba no mês de referência, separadas por '|'.
	measure 'T3 · Avanço · obras fora do limite do físico (lista)' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref],
			            "@s", [T3 · Status desvio físico · ref],
			            "@a", [Prazo · atraso (meses) · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@s] = 2 ), dObra[Obra], "|", [@a], DESC, dObra[Obra], ASC )
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: 177df4db-2369-5699-acce-22b2871718d1

	/// Obras cuja aba do mês de referência não traz o previsto acumulado (JANGADA): ficam fora do desvio da carteira. Obras com aba no mês de referência, separadas por '|'.
	measure 'T3 · Avanço · obras sem previsto (lista)' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref],
			            "@pos", [T3 · Avanço · posição]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, ISBLANK ( [@d] ) ), dObra[Obra], "|", [@pos], ASC, dObra[Obra], ASC )
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: dbad70ca-1c43-57f7-b064-60e9e436a6e7

	/// Posição da obra na lista do avanço: a ordem da nota (mais pontos perdidos no mês de referência; empate pela menor nota, a pendente depois, e pelo nome), lida de [T1 · Obras · posição] sem recalcular. Uma obra no contexto; vazio sem aba no mês.
	measure 'T3 · Avanço · posição' =
			[T1 · Obras · posição]
		formatString: 0
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: d233dd0f-cf85-5a40-a635-2010ce9892f1

	/// 1 na linha da obra em foco (a escolhida no drawer ou a que mais perde pontos na nota, sem o filtro da própria linha); 0 nas outras.
	measure 'T3 · Avanço · é a obra em foco' =
			VAR _obra = SELECTEDVALUE ( dObra[Obra] )
			VAR _foco = CALCULATE ( [Nota · obra em foco], REMOVEFILTERS ( dObra[Obra] ) )
			RETURN
			    IF ( _obra = _foco, 1, 0 )
		formatString: 0
		displayFolder: T3 Avanço físico\Avanço das sete obras\Contas
		lineageTag: 15d7b3e9-cf06-58f7-9df2-ec59ef4e082a

	/// Cartão escuro do atraso da obra em foco em meses (cronograma agregado, Lipke), a resposta da pergunta da tela, com a marca e os pontos do item prazo da nota; o verso traz a regra e a primeira e a última faixa do item (lidas do modelo). Sem curva prevista: '—'. Só lê contas · foco.
	measure 'T3 · Cartão atraso · HTML' =
			-- 1 · Leituras
			VAR _atr = [Prazo · atraso (meses) · foco]
			VAR _ptf = [Nota · pontos prazo · foco]
			VAR _psf = [Nota · possíveis · prazo · foco]
			-- 2 · Textos
			VAR _taA = ROUND ( ABS ( _atr ), 1 )
			VAR _taN = FORMAT ( _taA, "0.0", "pt-BR" )
			VAR _taTxt = IF ( ISBLANK ( _atr ), "—", _taN )
			VAR _txtUn = IF ( _taA <= 1, "mês", "meses" )
			VAR _txtLado = IF ( ISBLANK ( _atr ), "", IF ( ROUND ( _atr, 1 ) < 0, _txtUn & " à frente", _txtUn ) )
			VAR _tkTxt = "⁅" & FORMAT ( _ptf, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _psf, "0.0#", "pt-BR" ) & "⁆"
			VAR _fx = SUBSTITUTE ( CALCULATE ( [Nota · item · faixas], dItemNota[Item] = "prazo" ), " · ", "|" )
			VAR _fxa = PATHITEM ( _fx, 1 )
			VAR _fxz = PATHITEM ( _fx, PATHLENGTH ( _fx ) )
			VAR _fx1 = SUBSTITUTE ( SUBSTITUTE ( _fxa, "<", "&lt;" ), ">", "&gt;" )
			VAR _fxN = SUBSTITUTE ( SUBSTITUTE ( _fxz, "<", "&lt;" ), ">", "&gt;" )
			VAR _fx1s = SUBSTITUTE ( SUBSTITUTE ( LEFT ( _fxa, SEARCH ( " →", _fxa, 1, LEN ( _fxa ) + 1 ) - 1 ), "<", "&lt;" ), ">", "&gt;" )
			VAR _fxNs = SUBSTITUTE ( SUBSTITUTE ( LEFT ( _fxz, SEARCH ( " →", _fxz, 1, LEN ( _fxz ) + 1 ) - 1 ), "<", "&lt;" ), ">", "&gt;" )
			VAR _txtCtx = IF ( ISBLANK ( _atr ), "sem curva prevista", IF ( IF ( ISBLANK ( _ptf ), "", IF ( _ptf >= _psf, "0", IF ( _ptf = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( _ptf ), "", IF ( _ptf >= _psf, "0", IF ( _ptf = 0, "2", "1" ) ) ) & "'></i>" ) & "item prazo da nota: " & _tkTxt )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _taKP = LEN ( _taN ) > 0
			VAR _taKN = IF ( _taKP, _taN )
			VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
			VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
			VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
			VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
			VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
			VAR _taKOd =
			    IF (
			        _taKOk,
			        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _taN
			    )
			VAR _taOd = IF ( ISBLANK ( _atr ), _taTxt, _taKOd )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc escuro' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Atraso · cronograma" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _taOd & "</span>" & "<span class='b5 lado2'>" & _txtLado & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & "Meses decorridos menos meses agregados: o executado de hoje é o previsto de quantos meses atrás." & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Planilha e cronograma</span></div>"
			            & "<div class='regua'><i class='mk mk0'></i><span>" & "⁅" & _fx1 & "⁆" & "</span><i class='mk mk2'></i><span>" & "⁅" & _fxN & "⁆" & "</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Cartões
		lineageTag: 395b537b-af20-59e9-851e-7d8f1dd604cf

	/// Cartão do executado acumulado da obra em foco, com o previsto acumulado da planilha e o desvio em p.p. no contexto (negativo em vermelho). Só lê contas · foco.
	measure 'T3 · Cartão executado · HTML' =
			-- 1 · Leituras
			VAR _e = [Físico · executado acumulado · foco]
			VAR _p = [Físico · previsto acumulado · foco]
			VAR _d = [Físico · desvio acumulado p.p. · foco]
			-- 2 · Textos
			VAR _teN = FORMAT ( ABS ( _e ) * 100, "0.0", "pt-BR" )
			VAR _teS = IF ( ROUND ( _e * 100, 1 ) < 0, "−", "" )
			VAR _teTxt = IF ( ISBLANK ( _e ), "—", _teS & _teN & "%" )
			VAR _tpN = FORMAT ( ABS ( _p ) * 100, "0.0", "pt-BR" )
			VAR _tpS = IF ( ROUND ( _p * 100, 1 ) < 0, "−", "" )
			VAR _tpTxt = IF ( ISBLANK ( _p ), "—", _tpS & _tpN & "%" )
			VAR _tdN = FORMAT ( ABS ( _d ), "0.0", "pt-BR" )
			VAR _tdS = SWITCH ( TRUE (), ROUND ( _d, 1 ) < 0, "−", ROUND ( _d, 1 ) > 0, "+", "" )
			VAR _tdTxt = IF ( ISBLANK ( _d ), "—", _tdS & _tdN & " p.p." )
			VAR _txtCtx = SWITCH ( TRUE (), ISBLANK ( _e ), "sem aba no mês", ISBLANK ( _p ), "sem previsto na planilha", "previsto " & "⁅" & _tpTxt & "⁆" & " · <span class='" & IF ( ROUND ( _d, 1 ) < 0, "ng", "" ) & "'>" & "⁅" & _tdTxt & "⁆" & "</span>" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _teKP = LEN ( _teN ) > 0
			VAR _teKN = IF ( _teKP, _teN )
			VAR _teKS = SUBSTITUTE ( SUBSTITUTE ( _teKN, ".", "" ), ",", "" )
			VAR _teKT = IFERROR ( VALUE ( _teKS ), -1 )
			VAR _teKOk = _teKP && _teKT >= 2 && FORMAT ( _teKT, REPT ( "0", LEN ( _teKS ) ) ) = _teKS
			VAR _teKD = IF ( CONTAINSSTRING ( _teKN, "," ), LEN ( _teKN ) - SEARCH ( ",", _teKN ), 0 )
			VAR _teKM = IF ( CONTAINSSTRING ( _teKN, "." ), "#,##0", "0" ) & IF ( _teKD > 0, "." & REPT ( "0", _teKD ) )
			VAR _teKOd =
			    IF (
			        _teKOk,
			        "<o-d><o-v>" & _teKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _teKN, FORMAT ( ROUND ( _teKT * [@odf] / 1000, 0 ) / POWER ( 10, _teKD ), _teKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _teN
			    )
			VAR _teOd = IF ( ISBLANK ( _e ), _teTxt, _teS & _teKOd & "%" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Executado acumulado" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _teOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & "Quanto da obra já foi feito até o mês, em % do orçamento; ao lado, o previsto da planilha e a diferença." & "</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>% executado e % previsto acumulados</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Cartões
		lineageTag: 60dd8832-02a7-55f9-b380-ce8458f82d84

	/// Cartão 'no mês' da obra em foco (frente e verso). Só lê contas · foco.
	measure 'T3 · Cartão no mês · HTML' =
			-- 1 · Leituras
			VAR _e = [Físico · executado no mês · foco]
			VAR _p = [Físico · previsto no mês · foco]
			VAR _mesC = [Mês de referência · curto]
			-- 2 · Textos
			VAR _teN = FORMAT ( ABS ( _e ) * 100, "0.00", "pt-BR" )
			VAR _teS = IF ( ROUND ( _e * 100, 2 ) < 0, "−", "" )
			VAR _teTxt = IF ( ISBLANK ( _e ), "—", _teS & _teN & "%" )
			VAR _tpN = FORMAT ( ABS ( _p ) * 100, "0.00", "pt-BR" )
			VAR _tpS = IF ( ROUND ( _p * 100, 2 ) < 0, "−", "" )
			VAR _tpTxt = IF ( ISBLANK ( _p ), "—", _tpS & _tpN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _teKP = LEN ( _teN ) > 0
			VAR _teKN = IF ( _teKP, _teN )
			VAR _teKS = SUBSTITUTE ( SUBSTITUTE ( _teKN, ".", "" ), ",", "" )
			VAR _teKT = IFERROR ( VALUE ( _teKS ), -1 )
			VAR _teKOk = _teKP && _teKT >= 2 && FORMAT ( _teKT, REPT ( "0", LEN ( _teKS ) ) ) = _teKS
			VAR _teKD = IF ( CONTAINSSTRING ( _teKN, "," ), LEN ( _teKN ) - SEARCH ( ",", _teKN ), 0 )
			VAR _teKM = IF ( CONTAINSSTRING ( _teKN, "." ), "#,##0", "0" ) & IF ( _teKD > 0, "." & REPT ( "0", _teKD ) )
			VAR _teKOd =
			    IF (
			        _teKOk,
			        "<o-d><o-v>" & _teKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _teKN, FORMAT ( ROUND ( _teKT * [@odf] / 1000, 0 ) / POWER ( 10, _teKD ), _teKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _teN
			    )
			VAR _teOd = IF ( ISBLANK ( _e ), _teTxt, _teS & _teKOd & "%" )
			VAR _tpKP = LEN ( _tpN ) > 0
			VAR _tpKN = IF ( _tpKP, _tpN )
			VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
			VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
			VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
			VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
			VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
			VAR _tpKOd =
			    IF (
			        _tpKOk,
			        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpN
			    )
			VAR _tpOd = IF ( ISBLANK ( _p ), _tpTxt, _tpS & _tpKOd & "%" )
			-- 4 · Marcação
			RETURN
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "No mês · " & _mesC & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _teOd & "</span>" & "<span class='b5 lado2'>" & "executado" & "</span>" & "</div>"
			            & "<p class='ctx'>" & IF ( ISBLANK ( _p ) && NOT ISBLANK ( _e ), "sem previsto na planilha", _tpOd & " previsto" ) & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & "Fatia da obra executada só neste mês, ao lado do que o cronograma previa para ele." & "</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Previsto e executado, mês</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
		displayFolder: T3 Avanço físico\Cartões
		lineageTag: ce3daada-dcdb-580f-ae78-3ad18a6e04e5

	/// Cartão do PPC do mês da obra em foco (plano semanal cumprido), com a meta (o ponto cheio do item PPC da nota) e os pontos do item; o verso traz a regra e a primeira e a última faixa (lidas do modelo). Sem a base: 'falta na base'. Só lê contas · foco.
	measure 'T3 · Cartão PPC · HTML' =
			-- 1 · Leituras
			VAR _ppc = [Canteiro · PPC · foco]
			VAR _pt = [Nota · pontos PPC · foco]
			VAR _ps = [Nota · possíveis · PPC · foco]
			VAR _meta = [Nota · limite PPC · ponto cheio]
			VAR _mesC = [Mês de referência · curto]
			-- 2 · Textos
			VAR _tcN = FORMAT ( ABS ( _ppc ) * 100, "0", "pt-BR" )
			VAR _tcS = IF ( ROUND ( _ppc * 100, 0 ) < 0, "−", "" )
			VAR _tcTxt = IF ( ISBLANK ( _ppc ), "—", _tcS & _tcN & "%" )
			VAR _tmN = FORMAT ( ABS ( _meta ) * 100, "0", "pt-BR" )
			VAR _tmS = IF ( ROUND ( _meta * 100, 0 ) < 0, "−", "" )
			VAR _tmTxt = IF ( ISBLANK ( _meta ), "—", _tmS & _tmN & "%" )
			VAR _tkTxt = "⁅" & FORMAT ( _pt, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _ps, "0.0#", "pt-BR" ) & "⁆"
			VAR _fx = SUBSTITUTE ( CALCULATE ( [Nota · item · faixas], dItemNota[Item] = "ppc" ), " · ", "|" )
			VAR _fxa = PATHITEM ( _fx, 1 )
			VAR _fxz = PATHITEM ( _fx, PATHLENGTH ( _fx ) )
			VAR _fx1 = SUBSTITUTE ( SUBSTITUTE ( _fxa, "<", "&lt;" ), ">", "&gt;" )
			VAR _fxN = SUBSTITUTE ( SUBSTITUTE ( _fxz, "<", "&lt;" ), ">", "&gt;" )
			VAR _fx1s = SUBSTITUTE ( SUBSTITUTE ( LEFT ( _fxa, SEARCH ( " →", _fxa, 1, LEN ( _fxa ) + 1 ) - 1 ), "<", "&lt;" ), ">", "&gt;" )
			VAR _fxNs = SUBSTITUTE ( SUBSTITUTE ( LEFT ( _fxz, SEARCH ( " →", _fxz, 1, LEN ( _fxz ) + 1 ) - 1 ), "<", "&lt;" ), ">", "&gt;" )
			VAR _txtCtx = IF ( ISBLANK ( _ppc ), "falta na base", IF ( IF ( ISBLANK ( _pt ), "", IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( _pt ), "", IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) ) & "'></i>" ) & "meta " & "⁅" & _tmTxt & "⁆" & " · na nota, " & _tkTxt )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tcKP = LEN ( _tcN ) > 0
			VAR _tcKN = IF ( _tcKP, _tcN )
			VAR _tcKS = SUBSTITUTE ( SUBSTITUTE ( _tcKN, ".", "" ), ",", "" )
			VAR _tcKT = IFERROR ( VALUE ( _tcKS ), -1 )
			VAR _tcKOk = _tcKP && _tcKT >= 2 && FORMAT ( _tcKT, REPT ( "0", LEN ( _tcKS ) ) ) = _tcKS
			VAR _tcKD = IF ( CONTAINSSTRING ( _tcKN, "," ), LEN ( _tcKN ) - SEARCH ( ",", _tcKN ), 0 )
			VAR _tcKM = IF ( CONTAINSSTRING ( _tcKN, "." ), "#,##0", "0" ) & IF ( _tcKD > 0, "." & REPT ( "0", _tcKD ) )
			VAR _tcKOd =
			    IF (
			        _tcKOk,
			        "<o-d><o-v>" & _tcKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcKN, FORMAT ( ROUND ( _tcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcKD ), _tcKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcN
			    )
			VAR _tcOd = IF ( ISBLANK ( _ppc ), _tcTxt, _tcS & _tcKOd & "%" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "PPC do mês · " & _mesC & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _tcOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & "Tarefas concluídas ÷ prometidas no plano semanal, na média do mês: o sinal que chega antes do atraso." & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Base complementar</span></div>"
			            & "<div class='regua'><i class='mk mk0'></i><span>" & "⁅" & _fx1 & "⁆" & "</span><i class='mk mk2'></i><span>" & "⁅" & _fxN & "⁆" & "</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Cartões
		lineageTag: 9c65d06a-0b19-5420-9aa9-0d117fd54c73

	/// Cartão do término projetado da obra em foco (Lipke, IEAC(t)), com a entrega contratual e a entrega com os 180 dias de tolerância (Lei 4.591/64, art. 43-A) no contexto; a marca diz onde o término projetado cai: até a entrega, nos 180 dias ou depois deles. Datas não contam. Só lê contas · foco.
	measure 'T3 · Cartão término · HTML' =
			-- 1 · Leituras
			VAR _proj = [Prazo · término projetado · foco]
			VAR _ent = [Prazo · entrega contratual · foco]
			VAR _tol = [Prazo · entrega com tolerância · foco]
			VAR _sit = [T3 · Término · situação · foco]
			VAR _alem = [T3 · Término · meses além da entrega · foco]
			-- 2 · Textos
			VAR _txtProj = IF ( ISBLANK ( _proj ), "—", FORMAT ( _proj, "mmm/yy", "pt-BR" ) )
			VAR _txtEnt = FORMAT ( _ent, "mmm/yy", "pt-BR" )
			VAR _txtTol = FORMAT ( _tol, "mmm/yy", "pt-BR" )
			VAR _txtCtx = SWITCH ( TRUE (), ISBLANK ( _ent ), "sem entrega no cadastro", ISBLANK ( _proj ), "sem curva prevista · entrega " & _txtEnt, "<i class='mk mk" & _sit & "'></i>entrega " & _txtEnt & " · limite " & _txtTol )
			-- 4 · Marcação
			RETURN
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Término projetado" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _txtProj & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & "Início + duração prevista ÷ IDP(t), o ritmo de prazo pelo cronograma agregado. Limite: a entrega + 180 dias." & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Cronograma, planilha e cadastro</span></div>"
			            & "<div class='regua'><i class='mk mk0'></i><span>até a entrega</span><i class='mk mk1'></i><span>nos 180 dias</span><i class='mk mk2'></i><span>depois deles</span></div>"
			        & "</div>"
			    & "</div>"
		displayFolder: T3 Avanço físico\Cartões
		lineageTag: 7bba6441-ed7d-5e63-b5aa-390a5ba40bcf

	/// CSS dos cartões da Tela 03: o do cartão com flip (Comum · CSS cartão) mais a marca da faixa no contexto.
	measure 'T3 · Cartão · CSS' =
			-- 4 · Marcação
			[Comum · CSS cartão]
			    & ".kc .ctx .mk{margin-right:6px;vertical-align:-1px}"
		displayFolder: T3 Avanço físico\Cartões
		lineageTag: 56ed91f9-14bb-5e09-9412-2477cb48a736

	/// CSS do gráfico da Curva S (eixos, linhas, área, pontos e rótulos finais).
	measure 'T3 · Curva S · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".cs{position:fixed;inset:0}.cs svg{position:absolute;left:0;top:0;overflow:visible}.cs .ey{position:absolute;left:0;width:44px;text-align:right;font-size:13px;line-height:16px;colo"
			    & "r:#6B6B70}.cs .ex{position:absolute;width:60px;text-align:center;font-size:13px;line-height:16px;color:#3B3B3F}.cs .ex.ref{font-weight:600;color:#0B0B0C}.cs .ex.sem{opacity:.5}.cs "
			    & ".vz{position:absolute;left:64px;top:110px;font-size:14px;line-height:19px;color:#3B3B3F}.cs .fp{position:absolute;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-"
			    & "size:14px;line-height:17px;color:#3B3B3F;white-space:nowrap}.cs .fe{position:absolute;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;c"
			    & "olor:#0B0B0C;white-space:nowrap}.cs .dv{position:absolute;height:17px;padding:0 4px;background:#FFFFFF;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;l"
			    & "ine-height:17px;white-space:nowrap}.cs .rv{transform-box:fill-box;transform-origin:left center;animation:t3Rv 1s cubic-bezier(.2,.7,.2,1) backwards}.cs .rv.e{animation-delay:.25s}@"
			    & "keyframes t3Rv{from{transform:scaleX(0)}}.cs .ar{animation:t3Fd .5s ease-out 1.1s backwards}.cs .pt{transform-box:fill-box;transform-origin:center;animation:cbPop .3s cubic-bezier("
			    & ".2,.7,.2,1) backwards}.cs .fp,.cs .fe,.cs .dv,.cs .ch{animation:t3Fd .3s ease-out 1.1s backwards}@keyframes t3Fd{from{opacity:0}}"
		displayFolder: T3 Avanço físico\Curva S
		lineageTag: 39d1f28c-7163-5a3f-9836-b76f5dfb4046

	/// CSS das colunas invisíveis da Curva S (uma por mês: alvo do tooltip).
	measure 'T3 · Curva S · CSS mês' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & "#htmlContent{display:flex!important;align-items:stretch;height:100vh}.htmlViewerEntry{display:block!important;flex:none;margin:0!important;padding:0!important;height:100vh}.hm{posi"
			    & "tion:relative;height:100vh;cursor:default}.hm i{position:absolute;top:28px;height:234px;width:1px;background:rgba(11,11,12,.3);opacity:0;transition:opacity .15s}.hm:hover i,.htmlVi"
			    & "ewerEntry.hover .hm i{opacity:1}"
		displayFolder: T3 Avanço físico\Curva S
		lineageTag: afcd6e40-f5b9-5a60-98d6-b40e7e6d98de

	/// Subtítulo da Curva S com os meses da série da obra em foco na janela (jan/26 a ago/26) e a legenda na linha do título (executado, previsto, executado abaixo do previsto), Figma 387:4403. Obra sem previsto na planilha (JANGADA): o subtítulo fala só do executado e a legenda diz 'sem previsto na planilha'.
	measure 'T3 · Curva S · HTML cabeçalho' =
			-- 1 · Leituras
			VAR _ini = [T3 · Série · primeiro mês da obra · foco]
			VAR _ref = [Mês de referência]
			VAR _p = [Físico · previsto acumulado · foco]
			VAR _e = [Físico · executado acumulado · foco]
			-- 2 · Textos
			VAR _txtIni = FORMAT ( _ini, "mmm/yy", "pt-BR" )
			VAR _txtRef = FORMAT ( _ref, "mmm/yy", "pt-BR" )
			VAR _txtMeses = IF ( ISBLANK ( _ini ) || _ini = _ref, _txtRef, _txtIni & " a " & _txtRef )
			VAR _semP = ISBLANK ( _p ) && NOT ISBLANK ( _e )
			VAR _txtSub = IF ( _semP, "executado acumulado, ", "previsto × executado acumulado, " ) & _txtMeses & " · % do orçamento"
			-- 4 · Marcação
			VAR _lgExec =
			    "<svg width='18' height='3'><path d='M0 1.5H18' stroke='#0B0B0C' stroke-width='3'/></svg><span>executado</span>"
			VAR _lgPrev =
			    "<svg width='18' height='2'><path d='M0 1H18' stroke='#3B3B3F' stroke-width='2' stroke-dasharray='5 4'/></svg>"
			        & "<span>previsto</span><i class='ar'></i><span>executado abaixo do previsto</span>"
			RETURN
			    "<div class='u pc'><span class='sub'>" & _txtSub & "</span><div class='lg'>" & _lgExec
			        & IF ( _semP, "<span class='sp'>· sem previsto na planilha</span>", _lgPrev )
			    & "</div></div>"
		displayFolder: T3 Avanço físico\Curva S
		lineageTag: 33fa4df6-085b-5dd6-a09c-e1536a96c76e

	/// Curva S da obra em foco (Figma 289:7413) na janela escolhida (1 a 12 meses): previsto acumulado (tracejado, só nos meses que o trazem) e executado acumulado (sólido) nos meses com aba (L044), x pela posição na janela; a área do executado abaixo do previsto (só quando todos os meses trazem o previsto), a grade em % do orçamento com escala pelo maior valor, todos os meses da janela no eixo (sem aba a 50%), os rótulos finais (contam) e a chave do desvio. Obra sem previsto na planilha: só o executado, sem área, rótulo do previsto nem chave. Sem granularidade: o tooltip do mês vem do visual de cima (T3 · Curva S · HTML mês).
	measure 'T3 · Curva S · HTML gráfico' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _n = [Série · meses até a referência]
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@pj", [Série · posição na janela],
			        "@na", [T3 · Série · mês na série · foco no mês],
			        "@p", [Físico · previsto acumulado · foco no mês],
			        "@e", [Físico · executado acumulado · foco no mês],
			        "@rot", [Mês · rótulo curto]
			    )
			VAR _janela = FILTER ( _meses, [@ate] = 1 ) /* lista */
			VAR _serie = FILTER ( _janela, [@na] = 1 ) /* lista */
			VAR _pRef = [Físico · previsto acumulado · foco]
			VAR _eRef = [Físico · executado acumulado · foco]
			VAR _dRef = [Físico · desvio acumulado p.p. · foco]
			-- 2 · Textos
			VAR _tprN = FORMAT ( ABS ( _pRef ) * 100, "0.0", "pt-BR" )
			VAR _tprS = IF ( ROUND ( _pRef * 100, 1 ) < 0, "−", "" )
			VAR _tprTxt = IF ( ISBLANK ( _pRef ), "—", _tprS & _tprN & "%" )
			VAR _terN = FORMAT ( ABS ( _eRef ) * 100, "0.0", "pt-BR" )
			VAR _terS = IF ( ROUND ( _eRef * 100, 1 ) < 0, "−", "" )
			VAR _terTxt = IF ( ISBLANK ( _eRef ), "—", _terS & _terN & "%" )
			VAR _tdrN = FORMAT ( ABS ( _dRef ), "0.0", "pt-BR" )
			VAR _tdrS = SWITCH ( TRUE (), ROUND ( _dRef, 1 ) < 0, "−", ROUND ( _dRef, 1 ) > 0, "+", "" )
			VAR _tdrTxt = IF ( ISBLANK ( _dRef ), "—", _tdrS & _tdrN & " p.p." )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tprKP = LEN ( _tprN ) > 0
			VAR _tprKN = IF ( _tprKP, _tprN )
			VAR _tprKS = SUBSTITUTE ( SUBSTITUTE ( _tprKN, ".", "" ), ",", "" )
			VAR _tprKT = IFERROR ( VALUE ( _tprKS ), -1 )
			VAR _tprKOk = _tprKP && _tprKT >= 2 && FORMAT ( _tprKT, REPT ( "0", LEN ( _tprKS ) ) ) = _tprKS
			VAR _tprKD = IF ( CONTAINSSTRING ( _tprKN, "," ), LEN ( _tprKN ) - SEARCH ( ",", _tprKN ), 0 )
			VAR _tprKM = IF ( CONTAINSSTRING ( _tprKN, "." ), "#,##0", "0" ) & IF ( _tprKD > 0, "." & REPT ( "0", _tprKD ) )
			VAR _tprKOd =
			    IF (
			        _tprKOk,
			        "<o-d><o-v>" & _tprKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tprKN, FORMAT ( ROUND ( _tprKT * [@odf] / 1000, 0 ) / POWER ( 10, _tprKD ), _tprKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tprN
			    )
			VAR _tprOd = IF ( ISBLANK ( _pRef ), _tprTxt, _tprS & _tprKOd & "%" )
			VAR _terKP = LEN ( _terN ) > 0
			VAR _terKN = IF ( _terKP, _terN )
			VAR _terKS = SUBSTITUTE ( SUBSTITUTE ( _terKN, ".", "" ), ",", "" )
			VAR _terKT = IFERROR ( VALUE ( _terKS ), -1 )
			VAR _terKOk = _terKP && _terKT >= 2 && FORMAT ( _terKT, REPT ( "0", LEN ( _terKS ) ) ) = _terKS
			VAR _terKD = IF ( CONTAINSSTRING ( _terKN, "," ), LEN ( _terKN ) - SEARCH ( ",", _terKN ), 0 )
			VAR _terKM = IF ( CONTAINSSTRING ( _terKN, "." ), "#,##0", "0" ) & IF ( _terKD > 0, "." & REPT ( "0", _terKD ) )
			VAR _terKOd =
			    IF (
			        _terKOk,
			        "<o-d><o-v>" & _terKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _terKN, FORMAT ( ROUND ( _terKT * [@odf] / 1000, 0 ) / POWER ( 10, _terKD ), _terKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _terN
			    )
			VAR _terOd = IF ( ISBLANK ( _eRef ), _terTxt, _terS & _terKOd & "%" )
			VAR _tdrKP = LEN ( _tdrN ) > 0
			VAR _tdrKN = IF ( _tdrKP, _tdrN )
			VAR _tdrKS = SUBSTITUTE ( SUBSTITUTE ( _tdrKN, ".", "" ), ",", "" )
			VAR _tdrKT = IFERROR ( VALUE ( _tdrKS ), -1 )
			VAR _tdrKOk = _tdrKP && _tdrKT >= 2 && FORMAT ( _tdrKT, REPT ( "0", LEN ( _tdrKS ) ) ) = _tdrKS
			VAR _tdrKD = IF ( CONTAINSSTRING ( _tdrKN, "," ), LEN ( _tdrKN ) - SEARCH ( ",", _tdrKN ), 0 )
			VAR _tdrKM = IF ( CONTAINSSTRING ( _tdrKN, "." ), "#,##0", "0" ) & IF ( _tdrKD > 0, "." & REPT ( "0", _tdrKD ) )
			VAR _tdrKOd =
			    IF (
			        _tdrKOk,
			        "<o-d><o-v>" & _tdrKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdrKN, FORMAT ( ROUND ( _tdrKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdrKD ), _tdrKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdrN
			    )
			VAR _tdrOd = IF ( ISBLANK ( _dRef ), _tdrTxt, _tdrS & _tdrKOd & " p.p." )
			-- 3 · Geometria
			VAR _passoX = IF ( _n > 1, DIVIDE ( 672, _n - 1 ), 0 ) /* geometria */
			VAR _maxV = MAXX ( _serie, MAX ( [@p], [@e] ) ) /* geometria */
			VAR _passoY = SWITCH ( TRUE (), _maxV <= 0.4, 0.1, _maxV <= 0.8, 0.2, 0.25 ) -- geometria
			VAR _teto = MAX ( _passoY, CEILING ( _maxV / _passoY, 1 ) * _passoY ) -- geometria
			VAR _escY = DIVIDE ( 234.00, _teto ) /* geometria */
			VAR _pts = ADDCOLUMNS ( _serie, "@x", ROUND ( IF ( _n > 1, 64 + ( [@pj] - 1 ) * _passoX, 736 ), 0 ), "@ye", ROUND ( 262 - [@e] * _escY, 0 ) ) /* geometria */
			VAR _ptsP = ADDCOLUMNS ( FILTER ( _pts, NOT ISBLANK ( [@p] ) ), "@yp", ROUND ( 262 - [@p] * _escY, 0 ) ) /* geometria */
			VAR _nObra = COUNTROWS ( _pts ) -- geometria
			VAR _nP = COUNTROWS ( _ptsP ) + 0 -- geometria
			VAR _cheia = _nP > 0 && _nP = _nObra -- geometria
			VAR _pU = MAXX ( _pts, [@pj] ) /* geometria */
			VAR _p1 = MINX ( _pts, [@pj] ) /* geometria */
			VAR _xU = ROUND ( IF ( _n > 1, 64 + ( _pU - 1 ) * _passoX, 736 ), 0 ) -- geometria
			VAR _x1 = ROUND ( IF ( _n > 1, 64 + ( _p1 - 1 ) * _passoX, 736 ), 0 ) -- geometria
			VAR _yP = IF ( NOT ISBLANK ( _pRef ), ROUND ( 262 - _pRef * _escY, 0 ) ) -- geometria
			VAR _yE = ROUND ( 262 - _eRef * _escY, 0 ) -- geometria
			VAR _temChave = NOT ISBLANK ( _pRef ) && NOT ISBLANK ( _eRef ) -- geometria
			VAR _gap = IF ( _temChave, ABS ( _yE - _yP ), 99 ) -- geometria
			VAR _meioY = IF ( _temChave, ROUND ( ( _yP + _yE ) / 2, 0 ), _yE ) -- geometria
			VAR _yLP = IF ( _gap < 18, IF ( _yP <= _yE, _meioY - 18, _meioY ), _yP - 9 ) -- geometria
			VAR _yLE = IF ( _gap < 18, IF ( _yP <= _yE, _meioY, _meioY - 18 ), _yE - 9 ) -- geometria
			VAR _xCh = _xU - 12 -- geometria
			VAR _nLinhas = ROUND ( _teto / _passoY, 0 ) -- geometria
			-- 4 · Marcação
			VAR _dPrev =
			    CONCATENATEX (
			        _ptsP,
			        VAR _k = [@pj]
			        VAR _segue = NOT ISEMPTY ( FILTER ( _ptsP, [@pj] = _k - 1 ) ) /* geometria */
			        RETURN
			            IF ( _segue, " L", " M" ) & [@x] & "," & [@yp],
			        "",
			        [@pj], ASC
			    )
			VAR _dExec = "M" & CONCATENATEX ( _pts, [@x] & "," & [@ye], " L", [@pj], ASC )
			VAR _dExecInv = CONCATENATEX ( _pts, [@x] & "," & [@ye], " L", [@pj], DESC )
			VAR _clipSob = _dPrev & " L" & _xU & ",262 L" & _x1 & ",262 Z"
			VAR _area = "M" & _x1 & ",0 L" & _xU & ",0 L" & _dExecInv & " Z"
			VAR _grade =
			    CONCATENATEX (
			        GENERATESERIES ( 0, _nLinhas ),
			        VAR _y = ROUND ( 262 - [Value] * _passoY * _escY, 0 ) /* geometria */
			        VAR _txt = "⁅" & FORMAT ( [Value] * _passoY * 100, "0", "pt-BR" ) & "⁆" & "%"
			        RETURN
			            "<i class='a-fd' style='position:absolute;left:52px;top:" & _y & "px;width:692px;height:1px;background:"
			                & IF ( [Value] = 0, "#E1E1E1", "#EFEFEF" ) & "'></i>"
			                & "<span class='ey' style='top:" & ( _y - 8 ) & "px'>" & _txt & "</span>",
			        "",
			        [Value], ASC
			    )
			VAR _pontos =
			    CONCATENATEX (
			        _pts,
			        VAR _atraso = ROUND ( 100 + DIVIDE ( [@x] - 64, 672 ) * 900, 0 ) /* geometria */
			        RETURN
			            "<circle class='pt' cx='" & [@x] & "' cy='" & [@ye] & "' r='4.5' fill='#0B0B0C' "
			                & "style='animation-delay:" & ( _atraso + 250 ) & "ms'/>",
			        "",
			        [@pj], ASC
			    )
			VAR _pontosP =
			    CONCATENATEX (
			        _ptsP,
			        VAR _atraso = ROUND ( 100 + DIVIDE ( [@x] - 64, 672 ) * 900, 0 ) /* geometria */
			        RETURN
			            "<circle class='pt' cx='" & [@x] & "' cy='" & [@yp] & "' r='3.75' fill='#FFFFFF' stroke='#3B3B3F' "
			                & "stroke-width='1.5' style='animation-delay:" & _atraso & "ms'/>",
			        "",
			        [@pj], ASC
			    )
			VAR _eixoX =
			    CONCATENATEX (
			        _janela,
			        VAR _x = ROUND ( IF ( _n > 1, 64 + ( [@pj] - 1 ) * _passoX, 736 ), 0 ) /* geometria */
			        VAR _atraso = ROUND ( DIVIDE ( _x - 64, 672 ) * 600, 0 ) /* geometria */
			        RETURN
			            "<span class='ex a-fd" & IF ( dMes[Mes] = _ref, " ref", IF ( [@na] = 1, "", " sem" ) ) & "' style='left:"
			                & ( _x - 30 ) & "px;top:272px;animation-delay:" & _atraso & "ms'>" & [@rot] & "</span>",
			        "",
			        [@pj], ASC
			    )
			VAR _svg =
			    "<svg width='900' height='302' viewBox='0 0 900 302' aria-hidden='true'><defs>"
			        & IF ( _cheia, "<clipPath id='t3cs'><path d='" & _clipSob & "'/></clipPath>" )
			        & "<clipPath id='t3rp'><rect class='rv' x='0' y='0' width='900' height='302'/></clipPath>"
			        & "<clipPath id='t3re'><rect class='rv e' x='0' y='0' width='900' height='302'/></clipPath></defs>"
			        & IF ( _cheia, "<path class='ar' d='" & _area & "' fill='#F7E3E3' clip-path='url(#t3cs)'/>" )
			        & IF ( _nP > 0, "<path d='" & _dPrev & "' fill='none' stroke='#3B3B3F' stroke-width='2' "
			            & "stroke-linecap='round' stroke-linejoin='round' stroke-dasharray='6 5' clip-path='url(#t3rp)'/>" )
			        & "<path d='" & _dExec & "' fill='none' stroke='#0B0B0C' stroke-width='2.6' stroke-linecap='round' "
			        & "stroke-linejoin='round' clip-path='url(#t3re)'/>"
			        & IF ( _temChave && _gap >= 2, "<path class='ch' d='M" & ( _xCh + 4 ) & "," & _yP & " H" & _xCh & " V" & _yE
			            & " H" & ( _xCh + 4 ) & "' fill='none' stroke='#0B0B0C' stroke-width='1.2' stroke-linecap='round' "
			            & "stroke-linejoin='round'/>" )
			        & _pontosP & _pontos
			    & "</svg>"
			VAR _saidaHtml =
			    IF (
			        _nObra > 0,
			        "<div class='u cs'>" & _grade & _svg & _eixoX
			            & IF ( _temChave, "<span class='fp' style='left:" & ( _xU + 16 ) & "px;top:" & _yLP & "px'>" & _tprOd
			                & " previsto</span>" )
			            & "<span class='fe' style='left:" & ( _xU + 16 ) & "px;top:" & _yLE & "px'>" & _terOd & " executado</span>"
			            & IF ( _temChave, "<span class='dv" & IF ( ROUND ( _dRef, 1 ) < 0, " ng", "" ) & "' style='right:" & ( 906 - _xCh ) & "px;top:" & MAX ( 0, MIN ( _yP, _yE ) - 22 )
			                & "px'>" & _tdrOd & "</span>" )
			        & "</div>" & [Comum · JS contador],
			        "<div class='u cs'><p class='vz'>Sem aba da obra na janela: a série começa na primeira aba da planilha.</p></div>"
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Curva S
		lineageTag: 56b5546a-9186-5496-aacd-4c208b7f22d8

	/// Uma coluna invisível por mês da série (granularidade dMes[Mes]) sobre a Curva S: é o alvo estável do mouse que abre o tooltip do mês (L012) e mostra a linha-guia no mês. x pela posição na janela; a coluna vai da metade do caminho desde o mês anterior com aba (ou da borda, no primeiro) até a metade do caminho para o seguinte (ou a borda, na referência), então os meses vazios da janela ficam com o mês seguinte; vazio fora da série.
	measure 'T3 · Curva S · HTML mês' =
			-- 1 · Leituras
			VAR _na = [T3 · Série · mês na série · foco no mês]
			VAR _pj = [Série · posição na janela]
			VAR _ant = [T3 · Série · posição da aba anterior · foco no mês]
			VAR _n = [Série · meses até a referência]
			-- 3 · Geometria
			VAR _passoX = IF ( _n > 1, DIVIDE ( 672, _n - 1 ), 0 ) /* geometria */
			VAR _x = ROUND ( IF ( _n > 1, 64 + ( _pj - 1 ) * _passoX, 736 ), 0 ) -- geometria
			VAR _b0 = IF ( _ant = 0, 0, ROUND ( 64 + ( _ant - 0.5 ) * _passoX, 0 ) ) -- geometria
			VAR _b1 = IF ( _pj = _n, 860, ROUND ( 64 + ( _pj - 0.5 ) * _passoX, 0 ) ) -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        _na = 1,
			        "<div class='u hm' style='width:" & ( _b1 - _b0 ) & "px'><i style='left:" & ( _x - _b0 ) & "px'></i></div>"
			    )
		displayFolder: T3 Avanço físico\Curva S
		lineageTag: 00b005ca-8a92-5210-a0a0-42cb870d96e1

	/// Aba da obra em foco no mês do eixo (MAIO26).
	measure 'T3 · Aba · foco no mês' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( fAnaliseCritica[Aba] ), dObra[Obra] = _obra )
		displayFolder: T3 Avanço físico\Foco no mês\Contas
		lineageTag: 2be57c72-ff55-5004-8a63-952256ef1c21

	/// [Físico · desvio acumulado p.p.] da obra em foco no mês do eixo (tooltips do mês).
	measure 'T3 · Desvio físico p.p. · foco no mês' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [Físico · desvio acumulado p.p.], dObra[Obra] = _obra )
		formatString: +0.00;-0.00;0.00
		displayFolder: T3 Avanço físico\Foco no mês\Contas
		lineageTag: 02dcf475-11fe-59da-b57a-a55e0af1744c

	/// [Físico · desvio acumulado p.p.] no mês anterior ao do contexto (vazio sem aba nesse mês).
	measure 'T3 · Desvio físico p.p. · mês anterior' =
			VAR _m = EDATE ( MAX ( dMes[Mes] ), -1 )
			RETURN
			    CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
		formatString: +0.00;-0.00;0.00
		displayFolder: T3 Avanço físico\Foco no mês\Contas
		lineageTag: 9eb045fd-0ccf-5683-8b2e-39e661ba1f03

