			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Segurança por obra
		lineageTag: e5c8cdd4-645e-554b-a8e3-0eb3334b8aa5

	/// Uma linha por obra com base no mês de referência (granularidade dObra[Obra], ordem T5 · Segurança · ordem): nome, barra da taxa de frequência de 12 meses (cor dos pontos do item acidentes; zero acidente só com a trilha) com o traço da média do setor, o valor e a conformidade NR-18 do mês com a marca dos pontos do item NR-18. A barra corre do zero.
	measure 'T5 · Segurança · HTML linha' =
			-- 1 · Leituras
			VAR _obra = [Obra · nome]
			VAR _tf = [Canteiro · taxa de frequência (12 meses) · ref]
			VAR _ac = [Canteiro · acidentes 12 meses · ref]
			VAR _nr = [Canteiro · conformidade NR-18 · ref]
			VAR _pta = [Nota · pontos acidentes · ref]
			VAR _psa = [Nota · possíveis · acidentes · ref]
			VAR _ptn = [Nota · pontos NR-18 · ref]
			VAR _psn = [Nota · possíveis · NR-18 · ref]
			VAR _set = [Nota · limite acidentes · setor]
			VAR _topo = [T5 · Segurança · topo da escala]
			VAR _pos = [T5 · Segurança · ordem]
			-- 2 · Textos
			VAR _chave = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
			VAR _ttN = IF ( _tf = INT ( _tf ), FORMAT ( _tf, "0", "pt-BR" ), FORMAT ( _tf, "0.0", "pt-BR" ) )
			VAR _ttTxt = IF ( ISBLANK ( _tf ), "—", _ttN )
			VAR _tnN = FORMAT ( ABS ( _nr ) * 100, "0.0", "pt-BR" )
			VAR _tnS = IF ( ROUND ( _nr * 100, 1 ) < 0, "−", "" )
			VAR _tnTxt = IF ( ISBLANK ( _nr ), "—", _tnS & _tnN & "%" )
			VAR _clsA = IF ( ISBLANK ( _pta ), "", IF ( _pta >= _psa, "0", IF ( _pta = 0, "2", "1" ) ) )
			VAR _clsN = IF ( ISBLANK ( _ptn ), "", IF ( _ptn >= _psn, "0", IF ( _ptn = 0, "2", "1" ) ) )
			-- 3 · Geometria
			VAR _u = DIVIDE ( 140, _topo ) -- geometria
			VAR _w = IF ( _tf > 0, MAX ( 3, MIN ( 140, ROUND ( _tf * _u, 0 ) ) ), 0 ) -- geometria
			VAR _xS = ROUND ( _set * _u, 0 ) - 1 -- geometria
			VAR _corre = "' data-rp='width' data-r0-width='0px' data-rd='100'"
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _pos ),
			        "<div class='u sg'><b class='nm'>" & _chave & "</b>"
			            & "<span class='tr a-fd'>" & IF ( _w > 0, "<i class='br s" & _clsA & "' style='width:" & _w & "px' "
			                & "data-rk='" & _chave & "|tf" & _corre & "></i>" )
			            & "<i class='st a-pop' style='animation-delay:600ms;left:" & _xS & "px'></i></span>"
			            & "<span class='v'>" & IF ( ISBLANK ( _tf ), "—", "⁅" & _ttTxt & "⁆" ) & "</span>"
			            & "<span class='nr'>" & IF ( _clsN = "", "", "<i class='mk a-pop mk" & _clsN & "' "
			                & "style='animation-delay:400ms'></i>" ) & IF ( ISBLANK ( _nr ), "—", "⁅" & _tnTxt & "⁆" ) & "</span>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Segurança por obra
		lineageTag: 71257068-511c-5443-9092-9222169ba4b7

	/// Ordem das linhas de Segurança por obra (crescente): a maior taxa de frequência de 12 meses primeiro e, no empate (zero acidente), a menor conformidade NR-18 do mês. Vazio sem base no mês de referência (a linha some). Ex. set/26: REDINHA, POTENGI, JANGADA, TIROL, PONTA NEGRA, DUNAS, CAJUEIRO.
	measure 'T5 · Segurança · ordem' =
			VAR _tf = [Canteiro · taxa de frequência (12 meses) · ref]
			VAR _nr = [Canteiro · conformidade NR-18 · ref]
			RETURN
			    IF ( NOT ISBLANK ( _tf ) || NOT ISBLANK ( _nr ), - _tf * 100 + _nr )
		formatString: 0.00
		displayFolder: T5 Canteiro\Segurança por obra\Contas
		lineageTag: 01a969a1-4df9-51d0-af66-10f0233f3a76

	/// Topo da escala das barras da taxa de frequência: o dobro da média do setor ou o maior valor das obras do visual arredondado para cima de 5 em 5 (a linha do setor fica na metade ou antes). Ex. set/26: 15.
	measure 'T5 · Segurança · topo da escala' =
			VAR _lim = [Nota · limite acidentes · setor]
			VAR _mx = MAXX ( ALLSELECTED ( dObra[Obra] ), [Canteiro · taxa de frequência (12 meses) · ref] )
			RETURN
			    MAX ( 2 * _lim, CEILING ( _mx, 5 ) )
		formatString: 0.00
		displayFolder: T5 Canteiro\Segurança por obra\Contas
		lineageTag: 1cbf89f2-ce3d-57f0-8bc1-ae6651f2218c

	/// CSS das linhas de Suprimentos por obra.
	measure 'T5 · Suprimentos · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".htmlViewerEntry{display:block!important;margin:0!important;padding:0!important}.sp{position:relative;height:35px;border-bottom:1px solid #E1E1E1;background:#FFFFFF;transition:back"
			    & "ground .15s}.sp:hover,.htmlViewerEntry.hover .sp{background:#F7F4EE}.sp .nm{position:absolute;left:14px;top:7px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-si"
			    & "ze:15px;line-height:20px;white-space:nowrap}.sp .tr{position:absolute;left:116px;top:17px;width:134px;height:2px;background:#E1E1E1}.sp .mt{position:absolute;top:-8px;width:2px;hei"
			    & "ght:18px;background:#0B0B0C}.sp .pt{position:absolute;top:-5px;width:12px;height:12px;border-radius:50%;box-sizing:border-box}.sp .pt.s0{background:#A9CDB9;border:1px solid #6E9F85"
			    & "}.sp .pt.s1{background:#C9821F}.sp .pt.s2{background:#C43737}.sp .pd{position:absolute;left:258px;top:8px;font-size:13px;line-height:18px;color:#3B3B3F;white-space:nowrap}.sp .v{po"
			    & "sition:absolute;right:14px;top:7px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:15px;line-height:20px;white-space:nowrap}"
		displayFolder: T5 Canteiro\Suprimentos por obra
		lineageTag: 162f74e1-3785-5838-80f3-4fbeef5d24d9

	/// Cabeçalho de Suprimentos por obra: o mês, a meta (o ponto cheio do item entregas) e os nomes das colunas.
	measure 'T5 · Suprimentos · HTML cabeçalho' =
			-- 1 · Leituras
			VAR _mesC = [Mês de referência · curto]
			VAR _lim = [Nota · limite entregas · ponto cheio]
			-- 2 · Textos
			VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
			VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
			VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u obc'><span class='sub'>" & _mesC & " · no prazo e completos · traço = meta " & "⁅" & _tlTxt & "⁆"
			        & "</span><span class='vs' style='left:14px'>obra</span><span class='vs' style='left:116px'>no prazo</span>"
			        & "<span class='vs' style='left:258px'>pedidos</span><span class='vs' style='right:14px'>%</span></div>"
			        & [Comum · JS contador]
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Suprimentos por obra
		lineageTag: aafcd558-9e2a-53ca-8842-4fac163e1135

	/// Uma linha por obra com pedido previsto no mês de referência (granularidade dObra[Obra], ordem T5 · Entregas · ordem: a menor taxa primeiro): nome, trilha das entregas no prazo e completas (da base da escala a 100%) com o traço da meta (o ponto cheio do item entregas) e o ponto da obra na cor dos pontos do item, os pedidos no prazo de previstos e a taxa.
	measure 'T5 · Suprimentos · HTML linha' =
			-- 1 · Leituras
			VAR _obra = [Obra · nome]
			VAR _x = [Canteiro · entregas no prazo · ref]
			VAR _np = [Canteiro · pedidos no prazo · ref]
			VAR _pp = [Canteiro · pedidos previstos · ref]
			VAR _pt = [Nota · pontos entregas · ref]
			VAR _ps = [Nota · possíveis · entregas · ref]
			VAR _lim = [Nota · limite entregas · ponto cheio]
			VAR _base = [T5 · Entregas · base da escala]
			-- 2 · Textos
			VAR _chave = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
			VAR _txN = FORMAT ( ABS ( _x ) * 100, "0.0", "pt-BR" )
			VAR _txS = IF ( ROUND ( _x * 100, 1 ) < 0, "−", "" )
			VAR _txTxt = IF ( ISBLANK ( _x ), "—", _txS & _txN & "%" )
			VAR _cls = IF ( ISBLANK ( _pt ), "", IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) )
			VAR _txtPd = "⁅" & FORMAT ( _np, "0", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _pp, "0", "pt-BR" ) & "⁆"
			-- 3 · Geometria
			VAR _u = DIVIDE ( 134, 1 - _base ) -- geometria
			VAR _xP = MAX ( 0, MIN ( 134, ROUND ( ( _x - _base ) * _u, 0 ) ) ) - 6 -- geometria
			VAR _xM = ROUND ( ( _lim - _base ) * _u, 0 ) - 1 -- geometria
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _x ),
			        "<div class='u sp'><b class='nm'>" & _chave & "</b>"
			            & "<span class='tr a-fd'><i class='mt a-pop' style='animation-delay:500ms;left:" & _xM & "px'></i>"
			            & "<i class='pt a-pop s" & _cls & "' style='left:" & _xP & "px' data-rk='" & _chave & "|sp' "
			            & "data-rp='left' data-r0-left='-6px' data-rd='100'></i></span>"
			            & "<span class='pd'>" & _txtPd & "</span><span class='v'>" & "⁅" & _txTxt & "⁆" & "</span>"
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Suprimentos por obra
		lineageTag: ac7603c1-c0d7-5278-aba0-539b0bf8fdf3

	/// Começo da trilha das entregas (o fim é 100%): 60%, ou menos quando alguma obra do visual fica abaixo disso (arredondado para baixo de 10 em 10 pontos, com 5 de folga). Ex. set/26: 60%.
	measure 'T5 · Entregas · base da escala' =
			VAR _mn =
			    MINX (
			        FILTER ( ALLSELECTED ( dObra[Obra] ), NOT ISBLANK ( [Canteiro · entregas no prazo · ref] ) ),
			        [Canteiro · entregas no prazo · ref]
			    )
			RETURN
			    MIN ( 0.6, FLOOR ( _mn - 0.05, 0.1 ) )
		formatString: 0.00%
		displayFolder: T5 Canteiro\Suprimentos por obra\Contas
		lineageTag: a29c678b-b9b1-532b-987d-55dab03360f1

	/// Ordem das linhas de Suprimentos por obra (crescente): a menor taxa de entregas no prazo e completas do mês primeiro. Vazio sem pedido previsto (a linha some). Ex. set/26: POTENGI 76,9%, REDINHA 85,2%, JANGADA 86,4%.
	measure 'T5 · Entregas · ordem' =
			[Canteiro · entregas no prazo · ref]
		formatString: 0.00%
		displayFolder: T5 Canteiro\Suprimentos por obra\Contas
		lineageTag: 1ff88876-6d00-55b5-9dda-f1ee5b59170a

	/// Tooltip de página do mês (coluna de Chuva e ritmo): uma obra por linha, da mais chuvosa para a menos, com os dias impraticáveis por chuva (barra creme, escala pelo maior do mês, no mínimo 10) e o executado no mês da obra; no pé, a carteira (dias por obra, em média, e executado ponderado pelo orçamento).
	measure 'T5 · Tooltip mês · HTML' =
			-- 1 · Leituras
			VAR _mesC = UPPER ( [Mês · rótulo curto] )
			VAR _mesL = [Mês · longo]
			VAR _chC = [Canteiro · dias de chuva]
			VAR _exC = [Físico · executado no mês]
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@ch", [Canteiro · dias de chuva],
			        "@ex", [Físico · executado no mês]
			    )
			VAR _comBase = FILTER ( _obras, NOT ISBLANK ( [@ch] ) || NOT ISBLANK ( [@ex] ) ) /* lista */
			-- 2 · Textos
			VAR _tcN = IF ( _chC = INT ( _chC ), FORMAT ( _chC, "0", "pt-BR" ), FORMAT ( _chC, "0.0", "pt-BR" ) )
			VAR _tcTxt = IF ( ISBLANK ( _chC ), "—", _tcN )
			VAR _teN = FORMAT ( ABS ( _exC ) * 100, "0.0", "pt-BR" )
			VAR _teS = IF ( ROUND ( _exC * 100, 1 ) < 0, "−", "" )
			VAR _teTxt = IF ( ISBLANK ( _exC ), "—", _teS & _teN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tcKP = LEN ( _tcN ) > 0
			VAR _tcKN = IF ( _tcKP, _tcN )
			VAR _tcKS = SUBSTITUTE ( SUBSTITUTE ( _tcKN, ".", "" ), ",", "" )
			VAR _tcKT = IFERROR ( VALUE ( _tcKS ), -1 )
			VAR _tcKOk = _tcKP && _tcKT >= 2 && FORMAT ( _tcKT, REPT ( "0", LEN ( _tcKS ) ) ) = _tcKS
			VAR _tcKD = IF ( CONTAINSSTRING ( _tcKN, "," ), LEN ( _tcKN ) - SEARCH ( ",", _tcKN ), 0 )
			VAR _tcKM = IF ( CONTAINSSTRING ( _tcKN, "." ), "#,##0", "0" ) & IF ( _tcKD > 0, "." & REPT ( "0", _tcKD ) )
			VAR _tcKOd =
			    IF (
			        _tcKOk,
			        "<o-d><o-v>" & _tcKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcKN, FORMAT ( ROUND ( _tcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcKD ), _tcKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcN
			    )
			VAR _tcOd = IF ( ISBLANK ( _chC ), _tcTxt, _tcKOd )
			VAR _teKP = LEN ( _teN ) > 0
			VAR _teKN = IF ( _teKP, _teN )
			VAR _teKS = SUBSTITUTE ( SUBSTITUTE ( _teKN, ".", "" ), ",", "" )
			VAR _teKT = IFERROR ( VALUE ( _teKS ), -1 )
			VAR _teKOk = _teKP && _teKT >= 2 && FORMAT ( _teKT, REPT ( "0", LEN ( _teKS ) ) ) = _teKS
			VAR _teKD = IF ( CONTAINSSTRING ( _teKN, "," ), LEN ( _teKN ) - SEARCH ( ",", _teKN ), 0 )
			VAR _teKM = IF ( CONTAINSSTRING ( _teKN, "." ), "#,##0", "0" ) & IF ( _teKD > 0, "." & REPT ( "0", _teKD ) )
			VAR _teKOd =
			    IF (
			        _teKOk,
			        "<o-d><o-v>" & _teKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _teKN, FORMAT ( ROUND ( _teKT * [@odf] / 1000, 0 ) / POWER ( 10, _teKD ), _teKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _teN
			    )
			VAR _teOd = IF ( ISBLANK ( _exC ), _teTxt, _teS & _teKOd & "%" )
			-- 3 · Geometria
			VAR _max = MAX ( 10, MAXX ( _comBase, [@ch] ) ) /* geometria */
			VAR _nLs = COUNTROWS ( _comBase ) /* lista */
			-- 4 · Marcação
			VAR _htmlLinhas =
			    CONCATENATEX (
			        _comBase,
			        VAR _ch = [@ch]
			        VAR _ex = [@ex]
			        VAR _w = IF ( _ch > 0, MAX ( 2, ROUND ( DIVIDE ( _ch, _max ) * 200, 0 ) ), 0 ) -- geometria
			        VAR _txtCh = IF ( ISBLANK ( _ch ), "—", "⁅" & FORMAT ( _ch, "0", "pt-BR" ) & "⁆" & IF ( _ch = 1, " dia", " dias" ) )
			        VAR _txtEx = IF ( ISBLANK ( _ex ), "—", "⁅" & FORMAT ( _ex * 100, "0.0", "pt-BR" ) & "⁆" & "%" )
			        VAR _rd = ( RANKX ( _comBase, [@ch], _ch, DESC, Dense ) - 1 ) * 60 -- geometria
			        RETURN
			            "<div class='cr'><span class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dObra[Obra], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</span>"
			                & IF ( _w > 0, "<i class='bc' style='width:" & _w & "px' data-rk='ch|" & dObra[Obra] & "' data-rd='" & _rd & "'></i>" ) /* geometria */
			                & "<span class='dc' style='left:" & ( 150 + _w + 8 ) & "px'>" & _txtCh & "</span>"
			                & "<span class='ex'>" & _txtEx & "</span></div>",
			        "",
			        [@ch], DESC,
			        dObra[Obra], ASC
			    )
			VAR _saidaHtml =
			    IF (
			        NOT ISEMPTY ( _comBase ),
			        "<div class='u tt'><div class='cab'><p class='vs'>CHUVA E RITMO · " & _mesC & "</p>"
			            & "<div class='lin1'><div class='tit'><b>" & _mesL & "</b></div></div></div>"
			            & "<div class='corpo lim'><div class='bh'><span class='vs'>DIAS IMPRATICÁVEIS POR CHUVA, POR OBRA</span>"
			            & "<span class='vs'>EXECUTADO</span></div><div class='lsc" & " ls " & SWITCH ( TRUE (), _nLs <= 3, "e1", _nLs <= 6, "e2", _nLs <= 9, "e3", _nLs <= 12, "e4", "e5" ) & "' style='--n:" & _nLs & "'>" & _htmlLinhas & "</div></div>"
			            & "<div class='pe'><div class='dd'><span class='vs'>CARTEIRA</span><b>" & _tcOd & "</b>"
			            & "<span class='dt'>dias por obra, em média · </span><b>" & _teOd & "</b><span class='dt'>executado, "
			            & "pelo orçamento</span></div></div>"
			        & "</div>" & [Comum · JS contador tooltip] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Tooltips
		lineageTag: b4e7cec3-830f-5b32-916b-2279c0cb410a

	/// CSS do tooltip de página da T5: o dos tooltips da T4 (tooltips_t4.CSS_T4) mais as linhas de chuva e executado por obra.
	measure 'T5 · Tooltip · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".tt{position:fixed;inset:0;display:flex;flex-direction:column;background:#FFFFFF;border:1px solid #0B0B0C;border-radius:0;overflow:hidden;color:#0B0B0C}.tt .vs{display:block}.tt .c"
			    & "ab{flex:none;background:#0B0B0C;padding:14px 20px 13px}.tt .cab>.vs{color:#E9E0CF}.tt .cab .lin1{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;colu"
			    & "mn-gap:24px;row-gap:6px;margin-top:4px}.tt .cab .tit{display:flex;align-items:baseline;gap:8px;white-space:nowrap}.tt .cab .tit b{font-family:'Barlow U','Segoe UI',sans-serif;font-"
			    & "weight:600;font-size:21px;line-height:26px;color:#FFFFFF}.tt .cab .tit em{font-style:normal;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:12px;line-height:"
			    & "15px;letter-spacing:1.2px;text-transform:uppercase;color:#E9E0CF}.tt .cab .dir{color:#E9E0CF;white-space:nowrap}.tt .corpo{flex:1 1 auto;min-height:0;overflow:hidden;position:relat"
			    & "ive;margin:16px 20px 0}.tt .bh{display:flex;justify-content:space-between;margin-bottom:9px}.tt .rg{height:1px;background:#E1E1E1;margin:10px 0 10px}.tt .pe{flex:none;margin:8px 20"
			    & "px 14px;padding-top:12px;border-top:1px solid #E1E1E1}.tt .dd{display:flex;align-items:baseline;gap:10px;white-space:nowrap;height:20px}.tt .dd b{font-family:'Barlow U','Segoe UI',"
			    & "sans-serif;font-weight:600;font-size:16px;line-height:20px}.tt .dd .dt{margin-left:-4px;font-size:14px;line-height:19px;color:#3B3B3F;overflow:hidden;text-overflow:ellipsis}.tt .ro"
			    & "d{margin-top:8px;font-size:14px;line-height:19px}.tt .pe .rod:first-child{margin-top:0}.tt .lc{position:relative;height:28px;white-space:nowrap}.tt .lc .mk{position:absolute;left:0"
			    & ";top:9px}.tt .lc .nm{position:absolute;left:19px;top:4px;display:flex;align-items:center;gap:7px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;line-he"
			    & "ight:20px}.tt .lc .bz{position:absolute;top:8px;height:12px;background:#0B0B0C}.tt .lc .bz.ng{background:#C43737}.tt .lc .bz.s0{background:#A9CDB9;box-shadow:inset 0 0 0 1px #6E9F8"
			    & "5}.tt .lc .bz.s1{background:#C9821F}.tt .lc .bz.s2{background:#C43737}.tt .lc .v{position:absolute;right:100px;top:4px;text-align:right;font-family:'Barlow U','Segoe UI',sans-serif"
			    & ";font-weight:600;font-size:16px;line-height:20px}.tt .lc .p{position:absolute;right:0;top:3px;text-align:right;font-size:15px;line-height:21px;color:#3B3B3F}.tt .lc .pv{position:ab"
			    & "solute;right:278px;top:4px;text-align:right;font-size:14px;line-height:19px;color:#3B3B3F}.tt .lc .px{position:absolute;left:246px;top:4px;font-size:14px;line-height:19px;color:#3B"
			    & "3B3F}.tt .lc .ds{position:absolute;left:258px;top:4px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;line-height:20px}.tt .lc .p.dv{top:4px;font-family"
			    & ":'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;line-height:20px;color:#0B0B0C}.tt i.vz{display:block;font-style:normal;color:#3B3B3F;font-size:14px;line-height:19"
			    & "px}.tt i.vz.mais{line-height:28px;padding-left:19px}.tt .sr{position:relative;display:flex;margin-top:9px}.tt .sr .c{position:relative;flex:1 1 0;min-width:0}.tt .sr .c .bar{positi"
			    & "on:absolute}.tt .sr .c .bar.s2{background:#C43737}.tt .sr .c .bar.s1{background:#C9821F}.tt .sr .c .bar.s0{background:#A9CDB9;box-shadow:inset 0 0 0 1px #6E9F85}.tt .sr .c .val{pos"
			    & "ition:absolute;z-index:2;text-align:center;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;white-space:nowrap;color:#0B0B0C}.tt .sr .c "
			    & ".val.ext{color:#3B3B3F}.tt .sr .c .ms{position:absolute;left:0;right:0;text-align:center;font-size:13px;line-height:16px;color:#3B3B3F;white-space:nowrap}.tt .sr .c .ms.ref{font-we"
			    & "ight:600;color:#0B0B0C}.tt .sr .c .ms.sem{opacity:.45}.tt .jl{display:grid;grid-template-columns:72px 1fr;align-items:center;height:29px;white-space:nowrap}.tt .jl .m{font-size:15p"
