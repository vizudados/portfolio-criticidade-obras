		lineageTag: 5e33d9ed-5b1a-530a-8ec6-cae0934a5b93

	/// Valor do degrau da linha sobre o orçamento da obra em foco, no mês de referência (3,60% no pago e não aplicado da REDINHA em jun/26).
	measure 'Cascata · degrau · % do orçamento · foco' =
			DIVIDE ( [Cascata · degrau · valor · foco], [Orçamento · foco] )
