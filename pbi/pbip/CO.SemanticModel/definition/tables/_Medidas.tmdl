	/// [Item · % do orçamento] no mês de referência.
	measure 'Item · % do orçamento · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [Item · % do orçamento], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		formatString: 0.00%
