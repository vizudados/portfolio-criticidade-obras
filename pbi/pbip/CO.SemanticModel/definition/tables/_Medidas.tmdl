	/// Onde o término projetado cai, na obra e no mês do contexto: 0 até a entrega contratual, 1 depois dela mas dentro dos 180 dias de tolerância, 2 depois da tolerância; vazio sem término projetado. Uma obra.
	measure 'T3 · Término · situação' =
			VAR _p = [Prazo · término projetado]
			VAR _e = [Prazo · entrega contratual]
			VAR _t = [Prazo · entrega com tolerância]
			RETURN
			    IF (
			        NOT ISBLANK ( _p ) && NOT ISBLANK ( _e ),
			        SWITCH ( TRUE (), _p <= _e, 0, _p <= _t, 1, 2 )
			    )
		formatString: 0
		displayFolder: T3 Avanço físico\Prazo\Contas
		lineageTag: 78cfe548-47b7-57d3-9b3e-8e50e7d5b450

	/// [T3 · Término · situação · ref] da obra em foco.
	measure 'T3 · Término · situação · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Término · situação · ref], dObra[Obra] = _obra )
