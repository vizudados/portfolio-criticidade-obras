	/// Quantas obras entraram em crítico no mês do contexto ou abriram nele: a soma das duas contagens acima, numa só varredura das obras (a série da piora lê esta conta mês a mês).
	measure 'T1 · Leitura · obras que entraram ou abriram em crítico' =
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _ant = EDATE ( _m, -1 )
			VAR _recorte = VALUES ( dObra[Obra] )
			VAR _obras =
			    ADDCOLUMNS (
			        FILTER ( dRankingNota, dRankingNota[Mes] = _m && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte ),
			        "@s", dRankingNota[Status],
			        "@a",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                MAXX ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] = _ant && dRankingNota[TemAC] = 1 ), dRankingNota[Status] ),
			        "@ja",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                IF ( ISEMPTY ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] < _m && dRankingNota[TemAC] = 1 && dRankingNota[Pendente] == 0 ) ), 0, 1 )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, [@s] == 2 && NOT ISBLANK ( [@a] ) && [@a] < 2 ) ) + COUNTROWS ( FILTER ( _obras, [@s] == 2 && [@ja] = 0 ) ) + 0
		formatString: 0
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: fc271db5-e5f7-531f-a19f-640775dd162a

	/// Quantas obras saíram de crítico na nota no mês do contexto (mesma regra da lista).
	measure 'T1 · Leitura · obras que saíram de crítico' =
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _ant = EDATE ( _m, -1 )
			VAR _recorte = VALUES ( dObra[Obra] )
			VAR _obras =
			    ADDCOLUMNS (
			        FILTER ( dRankingNota, dRankingNota[Mes] = _m && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte ),
			        "@s", dRankingNota[Status],
			        "@a",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                MAXX ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] = _ant && dRankingNota[TemAC] = 1 ), dRankingNota[Status] ),
			        "@ja",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                IF ( ISEMPTY ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] < _m && dRankingNota[TemAC] = 1 && dRankingNota[Pendente] == 0 ) ), 0, 1 )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, [@a] == 2 && NOT ISBLANK ( [@s] ) && [@s] < 2 ) ) + 0
		formatString: 0
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 54fa5fc3-a7ce-5084-8249-00e15014095e

	/// Obras críticas na nota no mês anterior que têm nota completa abaixo de crítico no mês do contexto; da que mais perde pontos para a que menos perde, separadas por '|'. Bases de teste, jun/26: DUNAS.
	measure 'T1 · Leitura · obras que saíram de crítico (lista)' =
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _ant = EDATE ( _m, -1 )
			VAR _recorte = VALUES ( dObra[Obra] )
			VAR _obras =
			    ADDCOLUMNS (
			        FILTER ( dRankingNota, dRankingNota[Mes] = _m && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte ),
			        "@s", dRankingNota[Status],
			        "@a",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                MAXX ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] = _ant && dRankingNota[TemAC] = 1 ), dRankingNota[Status] ),
			        "@ja",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                IF ( ISEMPTY ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] < _m && dRankingNota[TemAC] = 1 && dRankingNota[Pendente] == 0 ) ), 0, 1 ),
			        "@p", dRankingNota[Perdidos],
			        "@n", dRankingNota[NotaOrdem]
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@a] == 2 && NOT ISBLANK ( [@s] ) && [@s] < 2 ), dRankingNota[Obra], "|", [@p], DESC, [@n], ASC, dRankingNota[Obra], ASC )
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 70109461-7ef0-57a6-874d-e556491cd8cf

	/// Maior número de obras críticas na nota num mês da janela (do primeiro mês da janela ao de referência).
	measure 'T1 · Leitura · pico de obras críticas' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			        "@c", [Nota · carteira · obras críticas] + 0
			    )
			RETURN
			    MAXX ( _meses, [@c] )
		formatString: 0
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 230fa0b7-838b-53db-a65e-afdac96c3762

	/// Estado da nota das obras que somam mais pontos perdidos no mês de referência: '2' crítico, '1' atenção, '0' estável, 'm' pendente; vazio sem perda.
	measure 'T1 · Leitura · status que mais perde' =
			VAR _mes = [Mês de referência]
			VAR _obras =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ),
			            "@s", IF ( [Nota · pendente · um mês] == 1, "m", [Nota · status · um mês] & "" ),
			            "@p", [Nota · pontos perdidos · um mês]
			        ),
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] = _mes
			    )
			VAR _por =
			    ADDCOLUMNS (
			        DATATABLE ( "Estado", STRING, { { "2" }, { "1" }, { "0" }, { "m" } } ),
			        "@soma", VAR _e = [Estado] RETURN SUMX ( FILTER ( _obras, [@s] = _e ), [@p] )
			    )
			VAR _top = TOPN ( 1, FILTER ( _por, [@soma] > 0 ), [@soma], DESC, [Estado], ASC )
			RETURN
			    MAXX ( _top, [Estado] )
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: e9584ec9-a6a0-5f82-b259-7dec533a1a53

	/// CSS do subtítulo da lista de obras.
	measure 'T1 · Obras · CSS cabeçalho' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".oc{position:fixed;inset:0}.oc .sub{left:0;top:0;font-size:15px;line-height:20px;color:#3B3B3F}"
		displayFolder: T1 Visão geral\Obras pela nota
		lineageTag: e54f394e-34fc-5384-a8fb-376a618d76a5

	/// CSS da lista de obras pela Nota da obra (uma entrada por obra).
	measure 'T1 · Obras · CSS lista' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".htmlViewerEntry{display:block!important;margin:0!important;padding:0!important}.ln{position:relative;height:76px;border-bottom:1px solid #E1E1E1;transition:background .15s}.ln.cri"
			    & "t{background:#F7E3E3}.ln:not(.crit):hover,.htmlViewerEntry.hover .ln:not(.crit){background:#F7F4EE}.ln .ix{left:14px;top:16px;color:#6B6B70}.ln .nm{position:absolute;left:48px;top:"
			    & "10px;display:flex;align-items:baseline;gap:8px;white-space:nowrap}.ln .nm b{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:21px;line-height:26px}.ln .nm em{"
			    & "font-style:normal;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:12px;line-height:15px;letter-spacing:1.2px;color:#6B6B70}.ln .nm .selo{margin-left:3px}.ln "
			    & ".sub{left:48px;top:40px;font-size:14px;line-height:19px;color:#3B3B3F}.ln .chips{position:absolute;left:356px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;"
			    & "gap:6px}.ln .cota{position:absolute;left:500px;top:33px;width:200px;height:10px;background:#EFEFEF}.ln .cota i{position:absolute;left:0;top:0;bottom:0}.ln .cota i.s2{background:#C4"
