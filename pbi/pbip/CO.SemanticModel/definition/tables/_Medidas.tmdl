	/// Quantas obras tiveram a primeira nota completa já crítica no mês do contexto (mesma regra da lista, fora de 'entraram').
	measure 'T1 · Leitura · obras que abriram em crítico' =
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _ant = EDATE ( _m, -1 )
			VAR _recorte = VALUES ( dObra[Obra] )
			VAR _obras =
			    ADDCOLUMNS (
			        FILTER ( dRankingNota, dRankingNota[Mes] = _m && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte ),
			        "@s", dRankingNota[Status],
			        "@a",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                MAXX ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] = _ant && dRankingNota[TemAC] = 1 ), dRankingNota[Status] ),
			        "@ja",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                IF ( ISEMPTY ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] < _m && dRankingNota[TemAC] = 1 && dRankingNota[Pendente] == 0 ) ), 0, 1 )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, [@s] == 2 && [@ja] = 0 ) ) + 0
		formatString: 0
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: c5beec7f-7547-5acd-9f10-0fbdf6bd3394

	/// Obras críticas na nota no mês do contexto cuja primeira nota completa é a deste mês (antes, só meses pendentes ou sem planilha). Não contam como entrada; crítico → pendente → crítico não abre. Bases de teste, mai/26: DUNAS.
	measure 'T1 · Leitura · obras que abriram em crítico (lista)' =
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _ant = EDATE ( _m, -1 )
			VAR _recorte = VALUES ( dObra[Obra] )
			VAR _obras =
			    ADDCOLUMNS (
			        FILTER ( dRankingNota, dRankingNota[Mes] = _m && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte ),
			        "@s", dRankingNota[Status],
			        "@a",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                MAXX ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] = _ant && dRankingNota[TemAC] = 1 ), dRankingNota[Status] ),
			        "@ja",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                IF ( ISEMPTY ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] < _m && dRankingNota[TemAC] = 1 && dRankingNota[Pendente] == 0 ) ), 0, 1 ),
			        "@p", dRankingNota[Perdidos],
			        "@n", dRankingNota[NotaOrdem]
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@s] == 2 && [@ja] = 0 ), dRankingNota[Obra], "|", [@p], DESC, [@n], ASC, dRankingNota[Obra], ASC )
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 6e713311-68e8-5932-9a2f-d35e7d8d4288

	/// Quantas obras entraram em crítico na nota no mês do contexto (mesma regra da lista: só entre notas completas).
	measure 'T1 · Leitura · obras que entraram em crítico' =
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _ant = EDATE ( _m, -1 )
			VAR _recorte = VALUES ( dObra[Obra] )
			VAR _obras =
			    ADDCOLUMNS (
			        FILTER ( dRankingNota, dRankingNota[Mes] = _m && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte ),
			        "@s", dRankingNota[Status],
			        "@a",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                MAXX ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] = _ant && dRankingNota[TemAC] = 1 ), dRankingNota[Status] ),
			        "@ja",
			            VAR _o = dRankingNota[Obra]
			            RETURN
			                IF ( ISEMPTY ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] < _m && dRankingNota[TemAC] = 1 && dRankingNota[Pendente] == 0 ) ), 0, 1 )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, [@s] == 2 && NOT ISBLANK ( [@a] ) && [@a] < 2 ) ) + 0
		formatString: 0
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: fd9cc938-6cc7-5df0-b22d-35ea7c90d0d3

	/// Obras críticas na nota no mês do contexto que tinham nota completa abaixo de crítico no mês anterior; da que mais perde pontos para a que menos perde, separadas por '|'.
