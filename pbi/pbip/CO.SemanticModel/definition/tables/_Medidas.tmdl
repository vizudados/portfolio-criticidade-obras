	/// 1 quando a janela das séries escolhida no drawer (dJanela) não é a padrão de 12 meses; 0 com 12 meses ou sem escolha. O contador de filtros do funil soma esta conta.
	measure 'Recorte · janela escolhida' =
			VAR _janela = [Série · janela (meses)]
			RETURN
			    IF ( _janela <> 12, 1, 0 )
