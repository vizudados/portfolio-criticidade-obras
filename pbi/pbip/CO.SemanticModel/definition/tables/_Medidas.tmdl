	/// [Nota · carteira · obras pendentes] no primeiro mês da janela das séries (recorte de obras do drawer).
	measure 'T1 · Leitura · obras pendentes no primeiro mês' =
			VAR _ini = [Série · primeiro mês]
			RETURN
			    CALCULATE ( [Nota · carteira · obras pendentes], REMOVEFILTERS ( dMes ), dMes[Mes] = _ini )
		formatString: 0
