	/// Onde o degrau da linha termina na cascata da obra em foco (o maior dos dois extremos da barra).
	measure 'Cascata · degrau · topo · foco' =
			VAR _deg = SELECTEDVALUE ( dDegrau[Degrau] )
			VAR _va = [Crédito do orçamento · foco] + 0
			VAR _ca = [Custo aplicado · foco] + 0
			VAR _ra = [Resultado aplicado · foco] + 0
			VAR _ar = [A realizar · foco] + 0
			VAR _r = [Resultado da obra · foco] + 0
			RETURN
			    SWITCH (
			        _deg,
			        "ValorAgregado", MAX ( 0, _va ),
			        "CustoAplicado", MAX ( _va, _va - _ca ),
			        "ResultadoAplicado", MAX ( 0, _ra ),
			        "ARealizar", MAX ( _ra, _ra + _ar ),
			        "Resultado", MAX ( 0, _r )
			    )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T2 Análise crítica\Como o resultado se forma\Contas
		lineageTag: e1bff0a3-d283-5d4e-8750-093f19f8b79d

	/// Valor do degrau da linha (dDegrau) da obra em foco no mês de referência, sem o sinal da conta (os resultados com o próprio sinal).
	measure 'Cascata · degrau · valor · foco' =
