	/// [Ativos não consumidos] no primeiro mês da janela das séries (recorte de obras do drawer).
	measure 'T1 · Leitura · ativos no primeiro mês' =
			VAR _ini = [Série · primeiro mês]
			RETURN
			    CALCULATE ( [Ativos não consumidos], REMOVEFILTERS ( dMes ), dMes[Mes] = _ini )
		formatString: "R$" #,0.00;-"R$" #,0.00
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 206d83ac-cf7e-5db2-8012-c30105b89a32

	/// [Físico · desvio acumulado p.p.] no primeiro mês da janela das séries (recorte de obras do drawer).
	measure 'T1 · Leitura · desvio físico no primeiro mês' =
			VAR _ini = [Série · primeiro mês]
			RETURN
			    CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _ini )
		formatString: +0.00;-0.00;0.00
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: c6034a76-d537-5ee6-ba54-c2a964eb0ea8

	/// Dimensão da nota em que mais obras perderam pontos no mês de referência (empate: mais pontos perdidos, depois a ordem da dimensão); vazio sem perda.
	measure 'T1 · Leitura · dimensão mais espalhada' =
			VAR _dims =
			    ADDCOLUMNS (
			        ALL ( dItemNota[Dimensao], dItemNota[OrdemDimensao] ),
			        "@o", [Nota · item · obras que perderam pontos · ref] + 0,
			        "@p", [Nota · item · perdidos · ref] + 0
			    )
			VAR _top = TOPN ( 1, FILTER ( _dims, [@o] > 0 ), [@o], DESC, [@p], DESC, dItemNota[OrdemDimensao], ASC )
			RETURN
			    MAXX ( _top, dItemNota[Dimensao] )
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 31983fc2-f46d-5265-afd1-fb26e15974d0

	/// Quantas obras perderam pontos na dimensão mais espalhada (mês de referência).
	measure 'T1 · Leitura · dimensão mais espalhada · obras' =
			VAR _d = [T1 · Leitura · dimensão mais espalhada]
			RETURN
			    CALCULATE ( [Nota · item · obras que perderam pontos · ref], dItemNota[Dimensao] = _d ) + 0
		formatString: 0
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: ef50901c-8f61-5f5c-9957-0dee32424304

	/// A primeira das dimensões que mais perdem pontos na carteira no mês de referência; vazio sem perda.
	measure 'T1 · Leitura · dimensão que mais perde' =
			PATHITEM ( [T1 · Leitura · dimensões que mais perdem (lista)] & "", 1 )
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: c7c4de5b-a62a-518a-b830-1ff4c7b25b7c

	/// Dimensões da nota empatadas no topo dos pontos perdidos pela carteira no mês de referência (empate: a ordem da dimensão), separadas por '|'; vazio sem perda.
	measure 'T1 · Leitura · dimensões que mais perdem (lista)' =
			VAR _dims = ADDCOLUMNS ( ALL ( dItemNota[Dimensao], dItemNota[OrdemDimensao] ), "@p", ROUND ( [Nota · item · perdidos · ref], 8 ) )
			VAR _max = MAXX ( FILTER ( _dims, [@p] > 0 ), [@p] )
			RETURN
			    CONCATENATEX ( FILTER ( _dims, [@p] > 0 && [@p] = _max ), dItemNota[Dimensao], "|", dItemNota[OrdemDimensao], ASC )
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 758b1d7b-ac5e-5d71-9932-8d2c9b2e0940

	/// Código (dItemNota) do item em que mais obras perderam pontos no mês de referência (empate: mais pontos perdidos, depois a ordem da nota); vazio quando nenhum item perdeu pontos.
	measure 'T1 · Leitura · item mais espalhado' =
			VAR _itens =
			    ADDCOLUMNS (
			        ALL ( dItemNota ),
			        "@o", [Nota · item · obras que perderam pontos · ref] + 0,
			        "@p", [Nota · item · perdidos · ref] + 0
			    )
			VAR _top = TOPN ( 1, FILTER ( _itens, [@o] > 0 ), [@o], DESC, [@p], DESC, dItemNota[Ordem], ASC )
			RETURN
			    MAXX ( _top, dItemNota[Item] )
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: c1afd659-1f39-5ee6-9c77-2df5a9360df8

	/// Quantas obras perderam pontos no item mais espalhado (mês de referência).
	measure 'T1 · Leitura · item mais espalhado · obras' =
			VAR _cod = [T1 · Leitura · item mais espalhado]
			RETURN
			    CALCULATE ( [Nota · item · obras que perderam pontos · ref], dItemNota[Item] = _cod ) + 0
		formatString: 0
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 69e8749a-897d-5762-9a82-7af4740bbaa1

	/// Código (dItemNota) do item em que a carteira mais perde pontos no mês de referência (empate: o de maior máximo, depois a ordem da nota); vazio quando nenhum item perdeu pontos.
	measure 'T1 · Leitura · item que mais perde' =
			VAR _itens = ADDCOLUMNS ( ALL ( dItemNota ), "@p", [Nota · item · perdidos · ref] )
			VAR _top = TOPN ( 1, FILTER ( _itens, [@p] > 0 ), [@p], DESC, dItemNota[Maximo], DESC, dItemNota[Ordem], ASC )
			RETURN
			    MAXX ( _top, dItemNota[Item] )
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 16da374f-fa88-5436-9e76-fe5d610cdb73

	/// Códigos (dItemNota) de todos os itens empatados no topo dos pontos perdidos pela carteira no mês de referência (empate: maior máximo, depois a ordem da nota), separados por '|'; vazio sem perda. A frase cita todos (auditoria da Fase 2, minor 2).
	measure 'T1 · Leitura · itens que mais perdem (lista)' =
			VAR _itens = ADDCOLUMNS ( ALL ( dItemNota ), "@p", ROUND ( [Nota · item · perdidos · ref], 8 ) )
			VAR _max = MAXX ( FILTER ( _itens, [@p] > 0 ), [@p] )
			RETURN
			    CONCATENATEX ( FILTER ( _itens, [@p] > 0 && [@p] = _max ), dItemNota[Item], "|", dItemNota[Maximo], DESC,
			        dItemNota[Ordem], ASC )
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: de4bcb3c-3e32-5fae-9e28-34f5c9bda01e

	/// Itens da nota sem dado no mês de referência, somados pelas obras da carteira (as que têm aba da Análise Crítica no mês, como em Nota · carteira · …). O valor fora da faixa válida não falta (auditoria da Fase 3, rodada 2, m3).
	measure 'T1 · Leitura · itens sem dado na carteira' =
			VAR _mes = [Mês de referência]
			RETURN
			    SUMX (
			        CALCULATETABLE ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes ),
			        [Nota · itens faltando · ref] - [Nota · itens fora da faixa · ref]
			    ) + 0
		formatString: 0
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: ac15561f-b953-5230-8c8e-88f9ea052153

	/// Primeiro mês da janela em que as obras críticas na nota chegaram ao pico (vazio quando nenhuma obra foi crítica).
	measure 'T1 · Leitura · mês do pico de obras críticas' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _pico = [T1 · Leitura · pico de obras críticas]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ),
			        "@c", [Nota · carteira · obras críticas] + 0
			    )
			RETURN
			    IF ( _pico > 0, MINX ( FILTER ( _meses, [@c] = _pico ), dMes[Mes] ) )
		formatString: dd/mm/yyyy
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: e79b23d1-9886-55d3-b1d8-ad4be2fbd176

	/// Primeiro mês depois do primeiro da janela em que alguma obra entrou ou abriu em crítico na nota (vazio sem nenhum). Bases de teste, ago/26 com 12 meses: mai/26.
	measure 'T1 · Leitura · mês em que a piora começou' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] > _ini && dMes[Mes] <= _ref ),
			        "@n", [T1 · Leitura · obras que entraram ou abriram em crítico]
			    )
			RETURN
			    MINX ( FILTER ( _meses, [@n] > 0 ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 40da713a-8ffa-52f2-b29a-3ebd07d07fe5

	/// Segundo mês depois do primeiro da janela em que alguma obra entrou ou abriu em crítico na nota (vazio sem ele).
	measure 'T1 · Leitura · mês em que a piora se firmou' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] > _ini && dMes[Mes] <= _ref ),
			        "@n", [T1 · Leitura · obras que entraram ou abriram em crítico]
			    )
			VAR _e1 = MINX ( FILTER ( _meses, [@n] > 0 ), dMes[Mes] )
			RETURN
			    IF ( NOT ISBLANK ( _e1 ), MINX ( FILTER ( _meses, [@n] > 0 && dMes[Mes] > _e1 ), dMes[Mes] ) )
		formatString: dd/mm/yyyy
		displayFolder: T1 Visão geral\Leituras\Contas
		lineageTag: 000f0ee1-3ca9-5da6-afa9-02582b9b98cb

	/// [Nota · carteira · obras críticas] no primeiro mês da janela das séries (recorte de obras do drawer).
	measure 'T1 · Leitura · obras críticas no primeiro mês' =
			VAR _ini = [Série · primeiro mês]
			RETURN
			    CALCULATE ( [Nota · carteira · obras críticas], REMOVEFILTERS ( dMes ), dMes[Mes] = _ini )
