	/// CSS do tooltip da dimensão da nota (F4: a lista de obras ocupa o corpo, com escala pela contagem de linhas, e tudo entra em cascata).
	measure 'T1 · Tooltip indicador · CSS' =
			-- 4 · Marcação
			[T1 · CSS tooltip]
			    & ".tt .fx{font-size:13px;line-height:18px;color:#3B3B3F;margin:0 0 10px;white-space:normal}.tt .fx .f{white-space:nowrap}.tt .fx b{font-weight:600;color:#0B0B0C}.tt .fx+.bh{margin-to"
			    & "p:2px}.tt .tab.i .lin>span{height:27px;line-height:27px}.tt .tab.i .lin>.p{display:flex;justify-content:flex-end;align-items:center}.tt .lin .n .selo{margin-left:2px}.tt .e1{--k:1."
			    & "35;--hm:96px}.tt .e2{--k:1.2;--hm:64px}.tt .e3{--k:1.08;--hm:52px}.tt .e4{--k:.95;--hm:40px}.tt .e5{--k:.87;--hm:32px}.tt .corpo{display:flex;flex-direction:column}.tt .ls{flex:1 1"
			    & " auto;min-height:0;max-height:calc(var(--n,9) * var(--hm,36px))}.tt .ls{grid-auto-rows:minmax(0,1fr);align-content:stretch}.tt .ls .lin .n{font-size:max(13px,calc(15px * var(--k,1)"
			    & "))}.tt .ls .lin .v{font-size:max(13px,calc(16px * var(--k,1)))}.tt .ls .lin .p{font-size:max(13px,calc(16px * var(--k,1)))}.tt .ls .chi{height:auto;min-height:22px;padding:calc(2px"
			    & " * var(--k,1)) 8px;font-size:max(13px,calc(13px * var(--k,1)))}.tt .ls .mk{width:calc(11px * var(--k,1));height:calc(11px * var(--k,1))}.tt .tab.ls .lin>span{height:auto;line-heigh"
			    & "t:1.3}.tt .tab.ls .lin>.d{line-height:1.15}.tt .tab.i.ls .lin>span{height:auto}/*contador*/@keyframes tqE0{from{opacity:.35}}@keyframes tqP0{from{opacity:0;transform:scale(.5)}}@ke"
			    & "yframes tqE1{0%,16.667%{opacity:.35}}@keyframes tqP1{0%,16.667%{opacity:0;transform:scale(.5)}}@keyframes tqE2{0%,28.571%{opacity:.35}}@keyframes tqP2{0%,28.571%{opacity:0;transfor"
			    & "m:scale(.5)}}@keyframes tqE3{0%,37.5%{opacity:.35}}@keyframes tqP3{0%,37.5%{opacity:0;transform:scale(.5)}}@keyframes tqE4{0%,44.444%{opacity:.35}}@keyframes tqP4{0%,44.444%{opacit"
			    & "y:0;transform:scale(.5)}}@keyframes tqE5{0%,50%{opacity:.35}}@keyframes tqP5{0%,50%{opacity:0;transform:scale(.5)}}@keyframes tqE6{0%,54.545%{opacity:.35}}@keyframes tqP6{0%,54.545"
			    & "%{opacity:0;transform:scale(.5)}}@keyframes tqE7{0%,58.333%{opacity:.35}}@keyframes tqP7{0%,58.333%{opacity:0;transform:scale(.5)}}@keyframes tqE8{0%,61.538%{opacity:.35}}@keyframe"
			    & "s tqP8{0%,61.538%{opacity:0;transform:scale(.5)}}@keyframes tqE9{0%,64.286%{opacity:.35}}@keyframes tqP9{0%,64.286%{opacity:0;transform:scale(.5)}}@keyframes tqE10{0%,66.667%{opaci"
			    & "ty:.35}}@keyframes tqP10{0%,66.667%{opacity:0;transform:scale(.5)}}@keyframes tqE11{0%,68.75%{opacity:.35}}@keyframes tqP11{0%,68.75%{opacity:0;transform:scale(.5)}}@keyframes tqE1"
			    & "2{0%,70.588%{opacity:.35}}@keyframes tqP12{0%,70.588%{opacity:0;transform:scale(.5)}}@keyframes tqE13{0%,72.222%{opacity:.35}}@keyframes tqP13{0%,72.222%{opacity:0;transform:scale("
			    & ".5)}}@keyframes tqE14{0%,73.684%{opacity:.35}}@keyframes tqP14{0%,73.684%{opacity:0;transform:scale(.5)}}@keyframes tqE15{0%,75%{opacity:.35}}@keyframes tqP15{0%,75%{opacity:0;tran"
			    & "sform:scale(.5)}}@keyframes tqE16{0%,76.19%{opacity:.35}}@keyframes tqP16{0%,76.19%{opacity:0;transform:scale(.5)}}:is(.mk,.chi,.chip,.chp,circle,.pend){transform-box:fill-box;tran"
			    & "sform-origin:center}.tt .cab{animation:tqE0 0.2s ease-out}.tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP0 0.3s ease-out}.tt .corpo>.bh,.tt .corpo>.vs,.tt .corpo>.rg,."
			    & "tt .ser .ms,.tt .fx{animation:tqE1 0.24s ease-out}.tt .corpo>.bh :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.vs :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.rg :is(.mk,."
			    & "chi,.chip,.chp,circle,.pend),.tt .ser .ms :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .fx :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP1 0.34s ease-out}.tt .ls>:nth-child(1)>*{"
			    & "animation:tqE2 0.28s ease-out}.tt .ls>:nth-child(1)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP2 0.38s ease-out}.tt .ls>:nth-child(2)>*{animation:tqE3 0.32s ease-out}.tt "
			    & ".ls>:nth-child(2)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP3 0.42s ease-out}.tt .ls>:nth-child(3)>*{animation:tqE4 0.36s ease-out}.tt .ls>:nth-child(3)>* :is(.mk,.chi,."
			    & "chip,.chp,circle,.pend){animation:tqP4 0.46s ease-out}.tt .ls>:nth-child(4)>*{animation:tqE5 0.4s ease-out}.tt .ls>:nth-child(4)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:t"
			    & "qP5 0.5s ease-out}.tt .ls>:nth-child(5)>*{animation:tqE6 0.44s ease-out}.tt .ls>:nth-child(5)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP6 0.54s ease-out}.tt .ls>:nth-chi"
			    & "ld(6)>*{animation:tqE7 0.48s ease-out}.tt .ls>:nth-child(6)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP7 0.58s ease-out}.tt .ls>:nth-child(7)>*{animation:tqE8 0.52s ease-"
			    & "out}.tt .ls>:nth-child(7)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP8 0.62s ease-out}.tt .ls>:nth-child(8)>*{animation:tqE9 0.56s ease-out}.tt .ls>:nth-child(8)>* :is(.m"
			    & "k,.chi,.chip,.chp,circle,.pend){animation:tqP9 0.66s ease-out}.tt .ls>:nth-child(9)>*{animation:tqE10 0.6s ease-out}.tt .ls>:nth-child(9)>* :is(.mk,.chi,.chip,.chp,circle,.pend){an"
			    & "imation:tqP10 0.7s ease-out}.tt .ls>:nth-child(10)>*{animation:tqE11 0.64s ease-out}.tt .ls>:nth-child(10)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP11 0.74s ease-out}.t"
			    & "t .ls>:nth-child(11)>*{animation:tqE12 0.68s ease-out}.tt .ls>:nth-child(11)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP12 0.78s ease-out}.tt .ls>:nth-child(12)>*{animati"
			    & "on:tqE13 0.72s ease-out}.tt .ls>:nth-child(12)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP13 0.82s ease-out}.tt .ls>:nth-child(13)>*{animation:tqE14 0.76s ease-out}.tt .l"
			    & "s>:nth-child(13)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP14 0.86s ease-out}.tt .ls>:nth-child(14)>*{animation:tqE15 0.8s ease-out}.tt .ls>:nth-child(14)>* :is(.mk,.chi"
			    & ",.chip,.chp,circle,.pend){animation:tqP15 0.9s ease-out}.tt .pe{animation:tqE16 0.84s ease-out}.tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP16 0.94s ease-out}.tqv .tt"
			    & " .cab,.tqv .tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .corpo>.bh,.tqv .tt .corpo>.vs,.tqv .tt .corpo>.rg,.tqv .tt .ser .ms,.tqv .tt .fx,.tqv .tt .corpo>.bh :is(.mk,.ch"
			    & "i,.chip,.chp,circle,.pend),.tqv .tt .corpo>.vs :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .corpo>.rg :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ser .ms :is(.mk,.chi,.chip,"
			    & ".chp,circle,.pend),.tqv .tt .fx :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(1)>*,.tqv .tt .ls>:nth-child(1)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:"
			    & "nth-child(2)>*,.tqv .tt .ls>:nth-child(2)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(3)>*,.tqv .tt .ls>:nth-child(3)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.t"
			    & "qv .tt .ls>:nth-child(4)>*,.tqv .tt .ls>:nth-child(4)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(5)>*,.tqv .tt .ls>:nth-child(5)>* :is(.mk,.chi,.chip,.chp,circ"
			    & "le,.pend),.tqv .tt .ls>:nth-child(6)>*,.tqv .tt .ls>:nth-child(6)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(7)>*,.tqv .tt .ls>:nth-child(7)>* :is(.mk,.chi,.ch"
			    & "ip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(8)>*,.tqv .tt .ls>:nth-child(8)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(9)>*,.tqv .tt .ls>:nth-child(9)>* :is("
			    & ".mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(10)>*,.tqv .tt .ls>:nth-child(10)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(11)>*,.tqv .tt .ls>:nth-"
			    & "child(11)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(12)>*,.tqv .tt .ls>:nth-child(12)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(13)>*,.t"
			    & "qv .tt .ls>:nth-child(13)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(14)>*,.tqv .tt .ls>:nth-child(14)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .pe,.tq"
			    & "v .tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:none}@media (prefers-reduced-motion:reduce){.tt .cab,.tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.bh,.tt .co"
			    & "rpo>.vs,.tt .corpo>.rg,.tt .ser .ms,.tt .fx,.tt .corpo>.bh :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.vs :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.rg :is(.mk,.chi,.c"
			    & "hip,.chp,circle,.pend),.tt .ser .ms :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .fx :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(1)>*,.tt .ls>:nth-child(1)>* :is(.mk,.chi"
			    & ",.chip,.chp,circle,.pend),.tt .ls>:nth-child(2)>*,.tt .ls>:nth-child(2)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(3)>*,.tt .ls>:nth-child(3)>* :is(.mk,.chi,.chip,."
			    & "chp,circle,.pend),.tt .ls>:nth-child(4)>*,.tt .ls>:nth-child(4)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(5)>*,.tt .ls>:nth-child(5)>* :is(.mk,.chi,.chip,.chp,circ"
			    & "le,.pend),.tt .ls>:nth-child(6)>*,.tt .ls>:nth-child(6)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(7)>*,.tt .ls>:nth-child(7)>* :is(.mk,.chi,.chip,.chp,circle,.pend"
			    & "),.tt .ls>:nth-child(8)>*,.tt .ls>:nth-child(8)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(9)>*,.tt .ls>:nth-child(9)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .l"
			    & "s>:nth-child(10)>*,.tt .ls>:nth-child(10)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(11)>*,.tt .ls>:nth-child(11)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:n"
			    & "th-child(12)>*,.tt .ls>:nth-child(12)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(13)>*,.tt .ls>:nth-child(13)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-c"
			    & "hild(14)>*,.tt .ls>:nth-child(14)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .pe,.tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:none!important}}/*fim-contador*/ "
		displayFolder: T1 Visão geral\Tooltips
		lineageTag: 590025e6-7dde-53a3-a911-49520a0cd5b1

	/// Tooltip de página da dimensão da nota (linha de 'Onde a carteira perde pontos', eixo dItemNota[Dimensao]): quanto a dimensão vale, as faixas de cada item dela (Nota · item · faixas), obra por obra da que mais perde à que menos perde, com o status da obra, o X de cada item e os pontos da dimensão de possíveis ('falta na base' sem dado), e no pé 'como ler' (no caixa, as justificativas exigidas e preenchidas na planilha). Até 8 obras, todas aparecem; de 9 em diante, as 7 primeiras e 'e mais N obras'. O pé fica preso à base do cartão.
	measure 'T1 · Tooltip indicador · HTML' =
			-- 1 · Leituras
			VAR _dim = SELECTEDVALUE ( dItemNota[Dimensao] )
			VAR _maxD = [Nota · item · máximo]
			VAR _fonte = [Nota · item · fonte]
			VAR _mesCM = [Mês de referência · curto maiúsculo]
			VAR _exig = [Carteira · justificativas exigidas · ref] + 0
			VAR _branco = [Carteira · justificativas em branco · ref] + 0
			VAR _pre = [Carteira · justificativas preenchidas · ref] + 0
			VAR _listaBranco = [Recorte · justificativas em branco (lista) · ref]
			VAR _foraRod = [Recorte · justificativas em branco fora da lista curta · ref]
			VAR _mais = [T1 · Tooltip indicador · obras fora da lista]
			VAR _itens =
			    ADDCOLUMNS (
			        VALUES ( dItemNota[Item] ),
			        "@ord", [Nota · item · ordem],
			        "@rot", [Nota · item · nome],
			        "@fx", [Nota · item · faixas]
			    )
			VAR _nItens = COUNTROWS ( _itens ) /* lista */
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@aba", [Obras com análise · ref],
			        "@pos", [T1 · Obras · posição],
			        "@st", [Nota · status · ranking · ref],
			        "@pend", [Nota · pendente · ranking · ref],
			        "@pts", [Nota · item · pontos · ref],
			        "@poss", [Nota · item · possíveis · ref],
			        "@perd", [Nota · item · perdidos · ref],
			        "@selo", [Obra · selo]
			    )
			VAR _comAba = FILTER ( _obras, [@aba] = 1 ) /* lista */
			/* passou de 8 obras: as 7 primeiras (a ordem da lista) e a linha 'e mais N obras' */
			VAR _mostra =
			    TOPN (
			        IF ( _mais > 0, 7, 8 ),
			        _comAba,
			        INT ( ISBLANK ( [@pts] ) ), ASC,
			        [@perd], DESC,
			        [@pos], ASC
			    ) /* lista */
			-- 2 · Textos
			VAR _txtFalta = IF ( _fonte = "Análise Crítica", "sem dado na planilha", "falta na base" )
			VAR _txtDir = "VALE ATÉ " & "⁅" & FORMAT ( _maxD, "0.0#", "pt-BR" ) & "⁆" & IF ( _maxD < 2, " PONTO", " PONTOS" )
			VAR _htmlFx =
			    CONCATENATEX (
			        _itens,
			        VAR _fxEsc = SUBSTITUTE ( SUBSTITUTE ( [@fx], "<", "&lt;" ), ">", "&gt;" )
			        RETURN
			            "<p class='fx'>" & IF ( _nItens > 1, "<b>" & [@rot] & ":</b> ", "" ) & "<span class='f'>"
			                & SUBSTITUTE ( _fxEsc, " · ", "</span> · <span class='f'>" ) & "</span></p>",
			        "",
			        [@ord], ASC
			    )
			VAR _htmlLinhas =
			    CONCATENATEX (
			        _mostra,
			        VAR _pts = [@pts]
			        VAR _possI = [@poss]
			        VAR _vals =
			            CONCATENATEX (
			                VALUES ( dItemNota[Item] ),
			                VAR _c = dItemNota[Item]
			                VAR _x = [Nota · item · X · ref]
			                VAR _vA = ABS ( _x )
			                VAR _vTxt =
			                    SWITCH (
			                        TRUE (),
			                        ISBLANK ( _x ), "—",
			                        _c = "custo", "IDC " & FORMAT ( _x, "0.00", "pt-BR" ),
			                        _c = "prazo", IF ( ROUND ( _x, 1 ) > 0, "atraso ", IF ( ROUND ( _x, 1 ) < 0, "adiantada ", "em dia" ) )
			                            & IF ( ROUND ( _x, 1 ) = 0, "", FORMAT ( _vA, "0.0", "pt-BR" ) & IF ( ROUND ( _vA, 1 ) <= 1, " mês", " meses" ) ),
			                        _c = "acidentes", "TF " & FORMAT ( _x, "0.0", "pt-BR" ),
			                        _c = "analise", FORMAT ( _x, "0" ) & " de 3",
			                        FORMAT ( TRUNC ( _vA * 100, 1 ), "0.0", "pt-BR" ) & "%"
			                    )
			                VAR _vNg = IF ( ( _c = "custo" && _x < 1 ) || ( _c = "prazo" && ROUND ( _x, 1 ) > 0 ), " ng", "" )
			                RETURN
			                    "<span class='" & TRIM ( _vNg ) & "'>" & "⁅" & _vTxt & "⁆" & "</span>",
			                " · ",
			                [Nota · item · ordem], ASC
			            )
			        VAR _kTxt = IF ( ISBLANK ( _pts ), "falta na base", FORMAT ( _pts, "0.0#", "pt-BR" ) & " de " & FORMAT ( _possI, "0.0#", "pt-BR" ) )
			        VAR _kCls = SWITCH ( TRUE (), ISBLANK ( _pts ), "f", _pts >= _possI, "c", _pts = 0, "z", "p" )
			        VAR _kHtml = "<span class='chi chi-" & _kCls & "'>" & _kTxt & "</span>"
			        VAR _clsK = SWITCH ( TRUE (), ISBLANK ( _pts ), "f", _pts >= _possI, "c", _pts = 0, "z", "p" )
			        VAR _chip = "<span class='chi chi-" & _clsK & "'>" & IF ( ISBLANK ( _pts ), _txtFalta, "⁅" & _kTxt & "⁆" ) & "</span>"
			        VAR _mk = IF ( IF ( [@pend] = 1, "m", IF ( ISBLANK ( [@st] ), "", [@st] & "" ) ) = "", "", "<i class='mk mk" & IF ( [@pend] = 1, "m", IF ( ISBLANK ( [@st] ), "", [@st] & "" ) ) & "'></i>" )
			        VAR _seloH = "<span class='selo " & IF ( [@selo] = "REAL", "selo-r", "selo-i" ) & "'>" & [@selo] & "</span>"
			        RETURN
			            "<div class='lin'><span class='n'>" & _mk & dObra[Obra] & _seloH & "</span>"
			                & "<span class='v'>" & _vals & "</span><span class='d'></span>"
			                & "<span class='p'>" & _chip & "</span></div>",
			        "",
			        INT ( ISBLANK ( [@pts] ) ), ASC,
			        [@perd], DESC,
			        [@pos], ASC
			    )
			VAR _htmlMais = IF ( _mais > 0, "<i class='vz'>e mais " & "⁅" & FORMAT ( _mais, "0" ) & "⁆" & " obras</i>" )
			VAR _nLin = COUNTROWS ( _mostra ) + IF ( _mais > 0, 1, 0 ) /* lista */
			/* rodapé do caixa (520 px): 'P de E preenchidas · ' (~9 px por algarismo + 120) e o trecho dos nomes, com 2 px de folga; o ±10% (regra da Análise Crítica) fica no versalete da direita */
			VAR _pxRod = ROUND ( ( 398 - 9 * LEN ( _pre & _exig ) ) * 13 / 15, 0 ) -- geometria
			/* nomes em branco numa linha só, sem cortar nome: todos; senão os 2 primeiros e 'e mais M'; senão nenhum (justificativas_rodape.py) */
			VAR _nbN = IF ( ISBLANK ( _listaBranco ) || _listaBranco = "", 0, PATHLENGTH ( _listaBranco ) )
			VAR _nbPos = IF ( _nbN >= 2, FIND ( "§", SUBSTITUTE ( _listaBranco, "|", "§", _nbN - 1 ) ) )
			VAR _nbTodos =
			    IF (
			        _nbN <= 1,
			        _listaBranco,
			        SUBSTITUTE ( LEFT ( _listaBranco, _nbPos - 1 ), "|", ", " ) & " e " & MID ( _listaBranco, _nbPos + 1, 999 )
			    )
			VAR _nbCorte = FIND ( "§", SUBSTITUTE ( _listaBranco & "|", "|", "§", 2 ), 1, LEN ( _listaBranco ) + 1 )
			VAR _nbPrimeiros = LEFT ( _listaBranco, _nbCorte - 1 )
			VAR _nbResto = IF ( _foraRod = _pre, IF ( _foraRod = 1, " e outra", " e outras" ), " e mais " & _foraRod )
			VAR _nbSemTodos = SUBSTITUTE ( _listaBranco, "|", "" )
			VAR _nbSemPrimeiros = SUBSTITUTE ( _nbPrimeiros, "|", "" )
			VAR _nbPxNomesTodosCar = GENERATESERIES ( 1, LEN ( _nbSemTodos ) + 0 )
			VAR _nbPxNomesTodos =
			    SUMX ( _nbPxNomesTodosCar, /* lista */ -- geometria
			        SWITCH (
			            MID ( _nbSemTodos, [Value], 1 ),
			            " ", 3.6, "A", 8.4, "B", 7.5, "C", 7.8, "D", 9.2, "E", 6.6, "F", 6.4, "G", 9.0, "H", 9.3, "I", 3.5,
			            "J", 4.2, "K", 7.6, "L", 6.2, "M", 11.7, "N", 9.8, "O", 9.8, "P", 7.3, "Q", 9.8, "R", 7.8, "S", 7.0,
			            "T", 7.1, "U", 9.0, "V", 8.1, "W", 12.2, "X", 7.7, "Y", 7.2, "Z", 7.5, "Á", 8.4, "Ã", 8.4, "Â", 8.4,
			            "À", 8.4, "É", 6.6, "Ê", 6.6, "Í", 3.5, "Ó", 9.8, "Õ", 9.8, "Ô", 9.8, "Ú", 9.0, "Ç", 7.8,
			            8
			        )
			    )
			VAR _nbPxNomesPrimeirosCar = GENERATESERIES ( 1, LEN ( _nbSemPrimeiros ) + 0 )
			VAR _nbPxNomesPrimeiros =
			    SUMX ( _nbPxNomesPrimeirosCar, /* lista */ -- geometria
			        SWITCH (
			            MID ( _nbSemPrimeiros, [Value], 1 ),
			            " ", 3.6, "A", 8.4, "B", 7.5, "C", 7.8, "D", 9.2, "E", 6.6, "F", 6.4, "G", 9.0, "H", 9.3, "I", 3.5,
			            "J", 4.2, "K", 7.6, "L", 6.2, "M", 11.7, "N", 9.8, "O", 9.8, "P", 7.3, "Q", 9.8, "R", 7.8, "S", 7.0,
			            "T", 7.1, "U", 9.0, "V", 8.1, "W", 12.2, "X", 7.7, "Y", 7.2, "Z", 7.5, "Á", 8.4, "Ã", 8.4, "Â", 8.4,
			            "À", 8.4, "É", 6.6, "Ê", 6.6, "Í", 3.5, "Ó", 9.8, "Õ", 9.8, "Ô", 9.8, "Ú", 9.0, "Ç", 7.8,
			            8
			        )
			    )
			VAR _nbPxTodos = ROUND ( _nbPxNomesTodos + 7 * MAX ( _nbN - 2, 0 ) + IF ( _nbN >= 2, 14, 0 ), 0 ) -- geometria
			VAR _nbPxResto =
			    SWITCH (
			        TRUE (),
			        _foraRod <> _pre, 51 + 7 * ( LEN ( _foraRod & "" ) - 1 ), -- geometria
			        _foraRod = 1, 41,
			        50
			    )
			VAR _nbPxPrimeiros = ROUND ( _nbPxNomesPrimeiros + 7 * 1 + _nbPxResto, 0 ) -- geometria
			VAR _nbPxCabe = ROUND ( _pxRod, 0 ) - 68 -- geometria
			VAR _nbTxt =
			    SWITCH (
			        TRUE (),
			        _branco = 0, "nenhuma em branco",
			        _nbPxTodos <= _nbPxCabe, "em branco: " & _nbTodos,
			        _nbN > 2 && _nbPxPrimeiros <= _nbPxCabe,
			            "em branco: " & SUBSTITUTE ( _nbPrimeiros, "|", ", " ) & _nbResto,
			        _pre = 0, "todas em branco",
			        _branco = _pre, "as outras em branco",
			        _branco & " em branco"
			    )
			VAR _txtRod =
			    SWITCH (
			        TRUE (),
			        _dim <> "Caixa", SWITCH ( _dim, "Custo", "IDC = valor agregado ÷ custo do que já virou obra", "Prazo", "atraso pelo cronograma; PPC = tarefas da semana cumpridas", "Qualidade", "serviços aprovados na primeira inspeção ÷ verificados", "Segurança", "acidentes por milhão de horas em 12 meses; checklist NR-18", "Suprimentos", "pedidos no prazo e completos ÷ previstos no mês", "Gestão", "conta fecha, justificativa quando exigida, previsto não caiu" ),
			        _exig = 0, "nenhuma exigida: todo desembolso ficou dentro da tolerância",
			        _branco = 0, IF ( _exig = 1, "a única exigida está preenchida", "todas as " & _exig & " preenchidas" ),
			        "⁅" & _pre & "⁆" & " de " & _exig & IF ( _exig = 1, " preenchida · ", " preenchidas · " ) & _nbTxt
			    )
			VAR _htmlRotRod =
			    IF (
			        _dim = "Caixa",
			        "<div class='bh'><span class='vs'>JUSTIFICATIVA NA PLANILHA</span><span class='vs'>EXIGIDA ACIMA DE ±10%</span>"
			            & "</div>",
			        "<span class='vs'>COMO LER</span>"
			    )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _dim ),
			        "<div class='u tt'><div class='cab'><p class='vs'>ONDE A CARTEIRA PERDE PONTOS · " & _mesCM & "</p>"
			            & "<div class='tit'><b>" & _dim & "</b></div>"
			            & "<p class='vs dir'>" & _txtDir & "</p></div>"
			            & "<div class='corpo'>" & _htmlFx
			            & "<div class='bh'><span class='vs'>OBRA POR OBRA</span><span class='vs'>PONTOS</span></div>"
			            & "<div class='tab i" & " ls " & SWITCH ( TRUE (), _nLin <= 3, "e1", _nLin <= 6, "e2", _nLin <= 9, "e3", _nLin <= 12, "e4", "e5" ) & "' style='--n:" & _nLin & "'>" & _htmlLinhas & _htmlMais & "</div></div>"
			            & "<div class='pe'><div class='rg'></div>" & _htmlRotRod
			            & "<p class='rod'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtRod, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>"
			        & "</div></div>" & [Comum · JS contador tooltip]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Tooltips
		lineageTag: ea37ec56-f4a1-53e0-ba00-d7450609c7b4

	/// CSS do tooltip do mês (F4: 760 de largura, linhas com escala, cascata de entrada).
	measure 'T1 · Tooltip mês · CSS' =
			-- 4 · Marcação
			[T1 · CSS tooltip]
			    & ".tt .col4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));column-gap:14px}.tt .col4 .chip{margin-bottom:12px;width:max-content}.tt .col4 .ob{display:flex;justify-content"
			    & ":space-between;align-items:center;gap:6px;height:25px;white-space:nowrap}.tt .col4 .ob span:first-child{font-size:15px;font-weight:600;overflow:hidden;text-overflow:ellipsis}.tt .c"
			    & "ol4 .ob b{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px}.tt .col4 .ob b.pd{font-size:14px;color:#3B3B3F}.tt .e1{--k:1.35;--hm:96px}.tt .e2{--k:1.2;--h"
			    & "m:64px}.tt .e3{--k:1.08;--hm:52px}.tt .e4{--k:.95;--hm:40px}.tt .e5{--k:.87;--hm:32px}.tt .corpo{display:flex;flex-direction:column}.tt .ls{flex:1 1 auto;min-height:0;max-height:ca"
			    & "lc(var(--n,9) * var(--hm,36px))}.tt .ls{grid-auto-rows:minmax(0,1fr);align-content:stretch}.tt .ls .chi{height:auto;min-height:22px;padding:calc(2px * var(--k,1)) 8px;font-size:max"
			    & "(13px,calc(13px * var(--k,1)))}.tt .ls .mk{width:calc(11px * var(--k,1));height:calc(11px * var(--k,1))}.tt .col4.ls{display:grid;max-height:calc(var(--n,9) * var(--hm,36px) + 34px"
			    & ")}.tt .col4.ls>div{display:grid;grid-template-rows:auto repeat(var(--n,9),minmax(0,1fr));min-height:0}.tt .col4.ls .ob{height:auto;min-height:0}.tt .col4.ls .ob span:first-child{fo"
			    & "nt-size:min(16px,max(13px,calc(15px * var(--k,1))))}.tt .col4.ls .ob b{font-size:max(13px,calc(16px * var(--k,1)))}.tt .col4.ls .ob b.pd{font-size:max(13px,calc(14px * var(--k,1)))"
			    & "}/*contador*/@keyframes tqE0{from{opacity:.35}}@keyframes tqP0{from{opacity:0;transform:scale(.5)}}@keyframes tqE2{0%,28.571%{opacity:.35}}@keyframes tqP2{0%,28.571%{opacity:0;tran"
			    & "sform:scale(.5)}}@keyframes tqE3{0%,37.5%{opacity:.35}}@keyframes tqP3{0%,37.5%{opacity:0;transform:scale(.5)}}@keyframes tqE4{0%,44.444%{opacity:.35}}@keyframes tqP4{0%,44.444%{op"
			    & "acity:0;transform:scale(.5)}}@keyframes tqE5{0%,50%{opacity:.35}}@keyframes tqP5{0%,50%{opacity:0;transform:scale(.5)}}@keyframes tqE6{0%,54.545%{opacity:.35}}@keyframes tqP6{0%,54"
			    & ".545%{opacity:0;transform:scale(.5)}}@keyframes tqE7{0%,58.333%{opacity:.35}}@keyframes tqP7{0%,58.333%{opacity:0;transform:scale(.5)}}@keyframes tqE8{0%,61.538%{opacity:.35}}@keyf"
			    & "rames tqP8{0%,61.538%{opacity:0;transform:scale(.5)}}@keyframes tqE9{0%,64.286%{opacity:.35}}@keyframes tqP9{0%,64.286%{opacity:0;transform:scale(.5)}}@keyframes tqE10{0%,66.667%{o"
			    & "pacity:.35}}@keyframes tqP10{0%,66.667%{opacity:0;transform:scale(.5)}}@keyframes tqE11{0%,68.75%{opacity:.35}}@keyframes tqP11{0%,68.75%{opacity:0;transform:scale(.5)}}@keyframes "
			    & "tqE12{0%,70.588%{opacity:.35}}@keyframes tqP12{0%,70.588%{opacity:0;transform:scale(.5)}}@keyframes tqE13{0%,72.222%{opacity:.35}}@keyframes tqP13{0%,72.222%{opacity:0;transform:sc"
			    & "ale(.5)}}@keyframes tqE14{0%,73.684%{opacity:.35}}@keyframes tqP14{0%,73.684%{opacity:0;transform:scale(.5)}}@keyframes tqE15{0%,75%{opacity:.35}}@keyframes tqP15{0%,75%{opacity:0;"
			    & "transform:scale(.5)}}@keyframes tqE16{0%,76.19%{opacity:.35}}@keyframes tqP16{0%,76.19%{opacity:0;transform:scale(.5)}}:is(.mk,.chi,.chip,.chp,circle,.pend){transform-box:fill-box;"
			    & "transform-origin:center}.tt .cab{animation:tqE0 0.2s ease-out}.tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP0 0.3s ease-out}.tt .col4>div>:nth-child(1){animation:tqE2"
			    & " 0.28s ease-out}.tt .col4>div>:nth-child(1) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP2 0.38s ease-out}.tt .col4>div>:nth-child(2){animation:tqE3 0.32s ease-out}.tt .col4>"
			    & "div>:nth-child(2) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP3 0.42s ease-out}.tt .col4>div>:nth-child(3){animation:tqE4 0.36s ease-out}.tt .col4>div>:nth-child(3) :is(.mk,"
			    & ".chi,.chip,.chp,circle,.pend){animation:tqP4 0.46s ease-out}.tt .col4>div>:nth-child(4){animation:tqE5 0.4s ease-out}.tt .col4>div>:nth-child(4) :is(.mk,.chi,.chip,.chp,circle,.pen"
			    & "d){animation:tqP5 0.5s ease-out}.tt .col4>div>:nth-child(5){animation:tqE6 0.44s ease-out}.tt .col4>div>:nth-child(5) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP6 0.54s eas"
			    & "e-out}.tt .col4>div>:nth-child(6){animation:tqE7 0.48s ease-out}.tt .col4>div>:nth-child(6) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP7 0.58s ease-out}.tt .col4>div>:nth-c"
			    & "hild(7){animation:tqE8 0.52s ease-out}.tt .col4>div>:nth-child(7) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP8 0.62s ease-out}.tt .col4>div>:nth-child(8){animation:tqE9 0.5"
			    & "6s ease-out}.tt .col4>div>:nth-child(8) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP9 0.66s ease-out}.tt .col4>div>:nth-child(9){animation:tqE10 0.6s ease-out}.tt .col4>div>"
			    & ":nth-child(9) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP10 0.7s ease-out}.tt .col4>div>:nth-child(10){animation:tqE11 0.64s ease-out}.tt .col4>div>:nth-child(10) :is(.mk,."
			    & "chi,.chip,.chp,circle,.pend){animation:tqP11 0.74s ease-out}.tt .col4>div>:nth-child(11){animation:tqE12 0.68s ease-out}.tt .col4>div>:nth-child(11) :is(.mk,.chi,.chip,.chp,circle,"
			    & ".pend){animation:tqP12 0.78s ease-out}.tt .col4>div>:nth-child(12){animation:tqE13 0.72s ease-out}.tt .col4>div>:nth-child(12) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP13"
			    & " 0.82s ease-out}.tt .col4>div>:nth-child(13){animation:tqE14 0.76s ease-out}.tt .col4>div>:nth-child(13) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP14 0.86s ease-out}.tt .c"
			    & "ol4>div>:nth-child(14){animation:tqE15 0.8s ease-out}.tt .col4>div>:nth-child(14) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP15 0.9s ease-out}.tt .pe{animation:tqE16 0.84s "
			    & "ease-out}.tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP16 0.94s ease-out}.tqv .tt .cab,.tqv .tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-chil"
			    & "d(1),.tqv .tt .col4>div>:nth-child(1) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(2),.tqv .tt .col4>div>:nth-child(2) :is(.mk,.chi,.chip,.chp,circle,.pend),"
			    & ".tqv .tt .col4>div>:nth-child(3),.tqv .tt .col4>div>:nth-child(3) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(4),.tqv .tt .col4>div>:nth-child(4) :is(.mk,.c"
			    & "hi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(5),.tqv .tt .col4>div>:nth-child(5) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(6),.tqv .tt .col4>"
			    & "div>:nth-child(6) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(7),.tqv .tt .col4>div>:nth-child(7) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:"
			    & "nth-child(8),.tqv .tt .col4>div>:nth-child(8) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(9),.tqv .tt .col4>div>:nth-child(9) :is(.mk,.chi,.chip,.chp,circle"
			    & ",.pend),.tqv .tt .col4>div>:nth-child(10),.tqv .tt .col4>div>:nth-child(10) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(11),.tqv .tt .col4>div>:nth-child(11"
			    & ") :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(12),.tqv .tt .col4>div>:nth-child(12) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(13),"
			    & ".tqv .tt .col4>div>:nth-child(13) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(14),.tqv .tt .col4>div>:nth-child(14) :is(.mk,.chi,.chip,.chp,circle,.pend),.t"
			    & "qv .tt .pe,.tqv .tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:none}@media (prefers-reduced-motion:reduce){.tt .cab,.tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col"
			    & "4>div>:nth-child(1),.tt .col4>div>:nth-child(1) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(2),.tt .col4>div>:nth-child(2) :is(.mk,.chi,.chip,.chp,circle,.pend),"
			    & ".tt .col4>div>:nth-child(3),.tt .col4>div>:nth-child(3) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(4),.tt .col4>div>:nth-child(4) :is(.mk,.chi,.chip,.chp,circle"
			    & ",.pend),.tt .col4>div>:nth-child(5),.tt .col4>div>:nth-child(5) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(6),.tt .col4>div>:nth-child(6) :is(.mk,.chi,.chip,.ch"
			    & "p,circle,.pend),.tt .col4>div>:nth-child(7),.tt .col4>div>:nth-child(7) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(8),.tt .col4>div>:nth-child(8) :is(.mk,.chi,."
			    & "chip,.chp,circle,.pend),.tt .col4>div>:nth-child(9),.tt .col4>div>:nth-child(9) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(10),.tt .col4>div>:nth-child(10) :is("
			    & ".mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(11),.tt .col4>div>:nth-child(11) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(12),.tt .col4>div>:nth-ch"
			    & "ild(12) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(13),.tt .col4>div>:nth-child(13) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(14),.tt .col4"
			    & ">div>:nth-child(14) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .pe,.tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:none!important}}/*fim-contador*/ "
		displayFolder: T1 Visão geral\Tooltips
		lineageTag: 3d615e90-af0d-5052-8f41-9a125b86b0af

	/// Tooltip de página do mês (coluna de Como os meses evoluíram): as obras em cada estado da nota (crítico, atenção, estável com a nota; pendente com os pontos obtidos dos possíveis) e quem entrou, saiu ou abriu em crítico desde o mês anterior, pela regra nova (só entre notas completas; ir de pendente a crítico é abrir). Primeiro mês do histórico: a carteira no mês. Até 9 obras num estado, todas aparecem; de 10 em diante, as 8 primeiras e 'e mais N obras'. O pé fica preso à base do cartão.
	measure 'T1 · Tooltip mês · HTML' =
			-- 1 · Leituras
			VAR _mesC = UPPER ( [Mês · rótulo curto] )
			VAR _mesL = [Mês · longo]
			VAR _mesAnt = [Mês anterior · nome]
			VAR _n = [Obras com análise] + 0
			VAR _primeiro = [Mês · é o primeiro do histórico] = 1
			VAR _res = [Resultado da obra]
			VAR _pct = [Resultado %]
			VAR _desv = [Desembolso · desvio no mês]
			VAR _maisC = [T1 · Tooltip mês · obras fora da lista · crítico]
			VAR _maisA = [T1 · Tooltip mês · obras fora da lista · atenção]
			VAR _maisE = [T1 · Tooltip mês · obras fora da lista · estável]
			VAR _maisP = [T1 · Tooltip mês · obras fora da lista · pendente]
			VAR _nE = [T1 · Leitura · obras que entraram em crítico] + 0
			VAR _nS = [T1 · Leitura · obras que saíram de crítico] + 0
			VAR _nAb = [T1 · Leitura · obras que abriram em crítico] + 0
			VAR _listaE = [T1 · Leitura · obras que entraram em crítico (lista)]
			VAR _listaS = [T1 · Leitura · obras que saíram de crítico (lista)]
			VAR _listaAb = [T1 · Leitura · obras que abriram em crítico (lista)]
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@aba", [Obras com análise],
			        "@st", [Nota · status · um mês],
			        "@pend", [Nota · pendente · um mês],
			        "@nota", [Nota · nota final · um mês],
			        "@obt", [Nota · pontos obtidos · um mês],
			        "@poss", [Nota · pontos possíveis · um mês],
			        "@perd", [Nota · pontos perdidos · um mês],
			        "@notaAnt", [T1 · Obra · nota no mês anterior]
			    )
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _trA = ABS ( _res )
			VAR _trNu = SWITCH ( TRUE (), _trA >= 99950000, FORMAT ( _trA / 1000000, "0.0", "pt-BR" ), _trA >= 999500, FORMAT ( _trA / 1000000, "0.00", "pt-BR" ), _trA >= 999.5, FORMAT ( _trA / 1000, "0", "pt-BR" ), FORMAT ( _trA, "#,0", "pt-BR" ) )
			VAR _trUn = SWITCH ( TRUE (), _trA >= 999500, " mi", _trA >= 999.5, " mil", "" )
			VAR _trN = _trNu & _trUn
			VAR _trZero = _trN = "0"
			VAR _trS = IF ( _trZero, "", IF ( _res < 0, "−", "" ) )
			VAR _trTxt = IF ( ISBLANK ( _res ), "—", _trS & "R$ " & _trN )
			VAR _tpN = FORMAT ( ABS ( _pct ) * 100, "0.00", "pt-BR" )
			VAR _tpS = SWITCH ( TRUE (), ROUND ( _pct * 100, 2 ) < 0, "−", ROUND ( _pct * 100, 2 ) > 0, "+", "" )
			VAR _tpTxt = IF ( ISBLANK ( _pct ), "—", _tpS & _tpN & "%" )
			VAR _tdvN = FORMAT ( ABS ( _desv ) * 100, "0", "pt-BR" )
			VAR _tdvS = SWITCH ( TRUE (), ROUND ( _desv * 100, 0 ) < 0, "−", ROUND ( _desv * 100, 0 ) > 0, "+", "" )
			VAR _tdvTxt = IF ( ISBLANK ( _desv ), "—", _tdvS & _tdvN & "%" )
			VAR _htmlCol =
			    CONCATENATEX (
			        { 2, 1, 0, -1 },
			        VAR _s = [Value]
			        VAR _lista = FILTER ( _obras, [@aba] = 1 && IF ( _s = -1, [@pend] = 1, NOT ISBLANK ( [@st] ) && [@st] = _s ) ) /* lista */
			        VAR _mais = SWITCH ( _s, 2, _maisC, 1, _maisA, 0, _maisE, _maisP )
			        /* passou de 9 obras no estado: as 8 primeiras e a linha 'e mais N obras' */
			        VAR _mostra = TOPN ( IF ( _mais > 0, 8, 9 ), _lista, [@perd], DESC, dObra[Obra], ASC ) /* lista */
			        VAR _cls = IF ( _s = -1, "m", _s & "" )
			        VAR _rot = SWITCH ( _s, 2, "crítico", 1, "atenção", 0, "estável", "pendente" )
			        VAR _itens =
			            CONCATENATEX (
			                _mostra,
			                VAR _txtV = IF ( _s = -1, FORMAT ( [@obt], "0.0#", "pt-BR" ) & "/" & FORMAT ( [@poss], "0.0#", "pt-BR" ), FORMAT ( [@nota], "0.0#", "pt-BR" ) )
			                RETURN
			                    "<div class='ob'><span>" & dObra[Obra] & "</span><b" & IF ( _s = -1, " class='pd'", "" ) & ">" & "⁅" & _txtV & "⁆" & "</b></div>",
			                "",
			                [@perd], DESC,
			                dObra[Obra], ASC
			            )
			        VAR _htmlMais = IF ( _mais > 0, "<i class='vz mais'>e mais " & "⁅" & FORMAT ( _mais, "0" ) & "⁆" & " obras</i>" )
			        RETURN
			            "<div><span class='chip chip" & _cls & "'><i></i>" & _rot & "</span>"
			                & IF ( _itens = "", "<i class='vz'>nenhuma</i>", _itens & _htmlMais ) & "</div>",
			        "",
			        [Value], DESC
			    )
			VAR _nCol =
			    MAXX (
			        { 2, 1, 0, -1 },
			        VAR _s = [Value]
			        VAR _q = COUNTROWS ( FILTER ( _obras, [@aba] = 1 && IF ( _s = -1, [@pend] = 1, NOT ISBLANK ( [@st] ) && [@st] = _s ) ) ) + 0 /* lista */
			        RETURN IF ( _q > 9, 8 + 1, MAX ( 1, _q ) )
			    ) /* geometria */
			VAR _mudaram = FILTER ( _obras, PATHCONTAINS ( _listaE, dObra[Obra] ) || PATHCONTAINS ( _listaS, dObra[Obra] ) ) /* lista */
			VAR _frases =
			    CONCATENATEX (
			        _mudaram,
			        dObra[Obra] & IF ( [@st] == 2, " entrou em crítico", " saiu de crítico" ) & " (nota " & "⁅" & FORMAT ( [@notaAnt], "0.0#", "pt-BR" ) & "⁆" & " → " & "⁅" & FORMAT ( [@nota], "0.0#", "pt-BR" ) & "⁆" & ")",
			        " · ",
			        [@st], DESC,
			        dObra[Obra], ASC
			    )
			VAR _abN = IF ( ISBLANK ( _listaAb ) || _listaAb = "", 0, PATHLENGTH ( _listaAb ) )
			VAR _abPos = IF ( _abN >= 2, FIND ( "§", SUBSTITUTE ( _listaAb, "|", "§", _abN - 1 ) ) )
			VAR _abTxt = SWITCH ( TRUE (), _abN = 0, "", _abN = 1, _listaAb, SUBSTITUTE ( LEFT ( _listaAb, _abPos - 1 ), "|", ", " ) & " e " & MID ( _listaAb, _abPos + 1, 999 ) )
			VAR _txtAb = IF ( _nAb = 0, "", _abTxt & IF ( _nAb = 1, " abriu em crítico", " abriram em crítico" ) )
			VAR _nTot = _nE + _nS + _nAb
			VAR _pE = IF ( _nE > 0, IF ( _nE = 1, "entrou em crítico: ", "entraram em crítico: " ) & SUBSTITUTE ( _listaE, "|", ", " ) )
			VAR _pS = IF ( _nS > 0, IF ( _nS = 1, "saiu de crítico: ", "saíram de crítico: " ) & SUBSTITUTE ( _listaS, "|", ", " ) )
			VAR _pA = IF ( _nAb > 0, IF ( _nAb = 1, "abriu em crítico: ", "abriram em crítico: " ) & SUBSTITUTE ( _listaAb, "|", ", " ) )
			VAR _txtCompacto = _pE & IF ( _pE <> "" && _pS & _pA <> "", " · " ) & _pS & IF ( _pS <> "" && _pA <> "", " · " ) & _pA
			VAR _txtDesde =
			    SWITCH (
			        TRUE (),
			        _nTot = 0, "nenhuma obra entrou ou saiu de crítico",
			        _nTot > 2, _txtCompacto,
			        _nE + _nS = 0, _txtAb,
			        _nAb > 0, _frases & " · " & _txtAb,
			        _nE = 0, _frases & " · nenhuma obra entrou",
			        _nS = 0, _frases & " · nenhuma saiu",
			        _frases
			    )
			VAR _txtSob = "OBRAS POR STATUS DA NOTA · " & _mesC & IF ( _primeiro, " · PRIMEIRO MÊS DO HISTÓRICO", "" )
			VAR _txtCart = "resultado " & IF ( _res < 0, "<span class='ng'>" & "⁅" & _trTxt & "⁆" & "</span>", "⁅" & _trTxt & "⁆" ) & " (" & IF ( ROUND ( _pct * 100, 2 ) < 0, "<span class='ng'>" & "⁅" & _tpTxt & "⁆" & "</span>", "⁅" & _tpTxt & "⁆" ) & ") · desembolso " & "⁅" & _tdvTxt & "⁆" & " sobre o previsto"
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        _n > 0,
			        "<div class='u tt'><div class='cab'><p class='vs'>" & _txtSob & "</p>"
			            & "<div class='tit'><b>" & _mesL & "</b></div></div>"
			            & "<div class='corpo'><div class='col4" & " ls " & SWITCH ( TRUE (), _nCol <= 3, "e1", _nCol <= 6, "e2", _nCol <= 9, "e3", _nCol <= 12, "e4", "e5" ) & "' style='--n:" & _nCol & "'>" & _htmlCol & "</div></div>"
			            & "<div class='pe'><div class='rg'></div>"
			            & IF (
			                _primeiro,
			                "<span class='vs'>CARTEIRA NO MÊS</span><p class='rod r2'>" & _txtCart & "</p>",
			                "<span class='vs'>DESDE " & UPPER ( _mesAnt ) & "</span><p class='rod r2'>" & _txtDesde & "</p>"
			            )
			        & "</div></div>" & [Comum · JS contador tooltip]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Tooltips
		lineageTag: 537fd610-84e9-5b9d-b6b3-bfd23e9969eb

	/// CSS do tooltip de obra (F4: lista dos itens com escala e cascata de entrada).
	measure 'T1 · Tooltip obra · CSS' =
			-- 4 · Marcação
			[T1 · CSS tooltip]
			    & ".tt .ser{position:relative;height:82px}.tt .ser .c{position:absolute;top:0;text-align:center;height:82px}.tt .ser .c .val{position:absolute;left:-14px;right:-14px;font-family:'Barl"
			    & "ow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;white-space:nowrap}.tt .ser .c .bar{position:absolute;bottom:21px;box-sizing:border-box}.tt .ser .c .bar"
			    & ".s2{background:#C43737}.tt .ser .c .bar.s1{background:#C9821F}.tt .ser .c .bar.s0{background:#A9CDB9}.tt .ser .c .bar.sm{background:#FFFFFF;border:1px dashed #3B3B3F}.tt .ser .c .m"
			    & "s{position:absolute;left:-10px;right:-10px;bottom:0;font-size:13px;line-height:16px;color:#6B6B70;white-space:nowrap}.tt .ser .c .ms.ref{font-weight:600;color:#0B0B0C}.tt .ser .c ."
			    & "ms.sem{opacity:.4}.tt .ser .c .val.ext{color:#6B6B70}.tt .ser .c.ini .val{left:0;right:auto;text-align:left}.tt .ser .c.fim .val{left:auto;right:0;text-align:right}.tt .ser .c.ini "
			    & ".ms,.tt .ser .c.fim .ms{left:0;right:0}.tt .rg.s{margin:6px 0 11px}.tt .vs+.ser{margin-top:4px}.tt .tab .lin>.p{display:flex;justify-content:flex-end;align-items:center}.tt .e1{--k"
			    & ":1.35;--hm:96px}.tt .e2{--k:1.2;--hm:64px}.tt .e3{--k:1.08;--hm:52px}.tt .e4{--k:.95;--hm:40px}.tt .e5{--k:.87;--hm:32px}.tt .corpo{display:flex;flex-direction:column}.tt .ls{flex:"
			    & "1 1 auto;min-height:0;max-height:calc(var(--n,9) * var(--hm,36px))}.tt .ls{grid-auto-rows:minmax(0,1fr);align-content:stretch}.tt .ls .lin .n{font-size:min(15px,max(13px,calc(15px "
			    & "* var(--k,1))))}.tt .ls .lin .v{font-size:min(16px,max(13px,calc(16px * var(--k,1))))}.tt .ls .lin .p{font-size:min(16px,max(13px,calc(16px * var(--k,1))))}.tt .ls .chi{height:auto"
			    & ";min-height:22px;padding:calc(2px * var(--k,1)) 8px;font-size:max(13px,calc(13px * var(--k,1)))}.tt .ls .mk{width:calc(11px * var(--k,1));height:calc(11px * var(--k,1))}.tt .tab.ls"
			    & " .lin>span{height:auto;line-height:1.3}.tt .tab.ls .lin>.d{line-height:1.15}.tt .tab.ls{column-gap:12px;grid-auto-rows:minmax(min-content,1fr)}.tt .corpo>:not(.ls){flex-shrink:0}/*"
			    & "contador*/@keyframes tqE0{from{opacity:.35}}@keyframes tqP0{from{opacity:0;transform:scale(.5)}}@keyframes tqE1{0%,16.667%{opacity:.35}}@keyframes tqP1{0%,16.667%{opacity:0;transfo"
			    & "rm:scale(.5)}}@keyframes tqE2{0%,28.571%{opacity:.35}}@keyframes tqP2{0%,28.571%{opacity:0;transform:scale(.5)}}@keyframes tqE3{0%,37.5%{opacity:.35}}@keyframes tqP3{0%,37.5%{opaci"
			    & "ty:0;transform:scale(.5)}}@keyframes tqE4{0%,44.444%{opacity:.35}}@keyframes tqP4{0%,44.444%{opacity:0;transform:scale(.5)}}@keyframes tqE5{0%,50%{opacity:.35}}@keyframes tqP5{0%,5"
			    & "0%{opacity:0;transform:scale(.5)}}@keyframes tqE6{0%,54.545%{opacity:.35}}@keyframes tqP6{0%,54.545%{opacity:0;transform:scale(.5)}}@keyframes tqE7{0%,58.333%{opacity:.35}}@keyfram"
			    & "es tqP7{0%,58.333%{opacity:0;transform:scale(.5)}}@keyframes tqE8{0%,61.538%{opacity:.35}}@keyframes tqP8{0%,61.538%{opacity:0;transform:scale(.5)}}@keyframes tqE9{0%,64.286%{opaci"
			    & "ty:.35}}@keyframes tqP9{0%,64.286%{opacity:0;transform:scale(.5)}}@keyframes tqE10{0%,66.667%{opacity:.35}}@keyframes tqP10{0%,66.667%{opacity:0;transform:scale(.5)}}@keyframes tqE"
			    & "11{0%,68.75%{opacity:.35}}@keyframes tqP11{0%,68.75%{opacity:0;transform:scale(.5)}}@keyframes tqE12{0%,70.588%{opacity:.35}}@keyframes tqP12{0%,70.588%{opacity:0;transform:scale(."
			    & "5)}}@keyframes tqE13{0%,72.222%{opacity:.35}}@keyframes tqP13{0%,72.222%{opacity:0;transform:scale(.5)}}@keyframes tqE14{0%,73.684%{opacity:.35}}@keyframes tqP14{0%,73.684%{opacity"
			    & ":0;transform:scale(.5)}}@keyframes tqE15{0%,75%{opacity:.35}}@keyframes tqP15{0%,75%{opacity:0;transform:scale(.5)}}@keyframes tqE16{0%,76.19%{opacity:.35}}@keyframes tqP16{0%,76.1"
			    & "9%{opacity:0;transform:scale(.5)}}:is(.mk,.chi,.chip,.chp,circle,.pend){transform-box:fill-box;transform-origin:center}.tt .cab{animation:tqE0 0.2s ease-out}.tt .cab :is(.mk,.chi,."
			    & "chip,.chp,circle,.pend){animation:tqP0 0.3s ease-out}.tt .corpo>.bh,.tt .corpo>.vs,.tt .corpo>.rg,.tt .ser .ms,.tt .fx{animation:tqE1 0.24s ease-out}.tt .corpo>.bh :is(.mk,.chi,.ch"
			    & "ip,.chp,circle,.pend),.tt .corpo>.vs :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.rg :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ser .ms :is(.mk,.chi,.chip,.chp,circle,.pend),."
			    & "tt .fx :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP1 0.34s ease-out}.tt .ls>:nth-child(1)>*{animation:tqE2 0.28s ease-out}.tt .ls>:nth-child(1)>* :is(.mk,.chi,.chip,.chp,cir"
			    & "cle,.pend){animation:tqP2 0.38s ease-out}.tt .ls>:nth-child(2)>*{animation:tqE3 0.32s ease-out}.tt .ls>:nth-child(2)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP3 0.42s ea"
			    & "se-out}.tt .ls>:nth-child(3)>*{animation:tqE4 0.36s ease-out}.tt .ls>:nth-child(3)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP4 0.46s ease-out}.tt .ls>:nth-child(4)>*{ani"
			    & "mation:tqE5 0.4s ease-out}.tt .ls>:nth-child(4)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP5 0.5s ease-out}.tt .ls>:nth-child(5)>*{animation:tqE6 0.44s ease-out}.tt .ls>:"
			    & "nth-child(5)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP6 0.54s ease-out}.tt .ls>:nth-child(6)>*{animation:tqE7 0.48s ease-out}.tt .ls>:nth-child(6)>* :is(.mk,.chi,.chip,"
			    & ".chp,circle,.pend){animation:tqP7 0.58s ease-out}.tt .ls>:nth-child(7)>*{animation:tqE8 0.52s ease-out}.tt .ls>:nth-child(7)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP8 "
			    & "0.62s ease-out}.tt .ls>:nth-child(8)>*{animation:tqE9 0.56s ease-out}.tt .ls>:nth-child(8)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP9 0.66s ease-out}.tt .ls>:nth-child("
			    & "9)>*{animation:tqE10 0.6s ease-out}.tt .ls>:nth-child(9)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP10 0.7s ease-out}.tt .ls>:nth-child(10)>*{animation:tqE11 0.64s ease-o"
			    & "ut}.tt .ls>:nth-child(10)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP11 0.74s ease-out}.tt .ls>:nth-child(11)>*{animation:tqE12 0.68s ease-out}.tt .ls>:nth-child(11)>* :i"
			    & "s(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP12 0.78s ease-out}.tt .ls>:nth-child(12)>*{animation:tqE13 0.72s ease-out}.tt .ls>:nth-child(12)>* :is(.mk,.chi,.chip,.chp,circle,."
			    & "pend){animation:tqP13 0.82s ease-out}.tt .ls>:nth-child(13)>*{animation:tqE14 0.76s ease-out}.tt .ls>:nth-child(13)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP14 0.86s ea"
			    & "se-out}.tt .ls>:nth-child(14)>*{animation:tqE15 0.8s ease-out}.tt .ls>:nth-child(14)>* :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP15 0.9s ease-out}.tt .pe{animation:tqE16 0"
			    & ".84s ease-out}.tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP16 0.94s ease-out}.tqv .tt .cab,.tqv .tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .corpo>.bh,.tq"
			    & "v .tt .corpo>.vs,.tqv .tt .corpo>.rg,.tqv .tt .ser .ms,.tqv .tt .fx,.tqv .tt .corpo>.bh :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .corpo>.vs :is(.mk,.chi,.chip,.chp,circle,.pe"
			    & "nd),.tqv .tt .corpo>.rg :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ser .ms :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .fx :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .l"
			    & "s>:nth-child(1)>*,.tqv .tt .ls>:nth-child(1)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(2)>*,.tqv .tt .ls>:nth-child(2)>* :is(.mk,.chi,.chip,.chp,circle,.pend)"
			    & ",.tqv .tt .ls>:nth-child(3)>*,.tqv .tt .ls>:nth-child(3)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(4)>*,.tqv .tt .ls>:nth-child(4)>* :is(.mk,.chi,.chip,.chp,c"
			    & "ircle,.pend),.tqv .tt .ls>:nth-child(5)>*,.tqv .tt .ls>:nth-child(5)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(6)>*,.tqv .tt .ls>:nth-child(6)>* :is(.mk,.chi,"
			    & ".chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(7)>*,.tqv .tt .ls>:nth-child(7)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(8)>*,.tqv .tt .ls>:nth-child(8)>* :"
			    & "is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(9)>*,.tqv .tt .ls>:nth-child(9)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(10)>*,.tqv .tt .ls>:nth"
			    & "-child(10)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(11)>*,.tqv .tt .ls>:nth-child(11)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(12)>*,."
			    & "tqv .tt .ls>:nth-child(12)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:nth-child(13)>*,.tqv .tt .ls>:nth-child(13)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .ls>:n"
			    & "th-child(14)>*,.tqv .tt .ls>:nth-child(14)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .pe,.tqv .tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:none}@media (prefers-re"
			    & "duced-motion:reduce){.tt .cab,.tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.bh,.tt .corpo>.vs,.tt .corpo>.rg,.tt .ser .ms,.tt .fx,.tt .corpo>.bh :is(.mk,.chi,.chip,.ch"
			    & "p,circle,.pend),.tt .corpo>.vs :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.rg :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ser .ms :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .fx"
			    & " :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(1)>*,.tt .ls>:nth-child(1)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(2)>*,.tt .ls>:nth-child(2)>* :is(.mk"
			    & ",.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(3)>*,.tt .ls>:nth-child(3)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(4)>*,.tt .ls>:nth-child(4)>* :is(.mk,.chi,.c"
			    & "hip,.chp,circle,.pend),.tt .ls>:nth-child(5)>*,.tt .ls>:nth-child(5)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(6)>*,.tt .ls>:nth-child(6)>* :is(.mk,.chi,.chip,.chp"
			    & ",circle,.pend),.tt .ls>:nth-child(7)>*,.tt .ls>:nth-child(7)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(8)>*,.tt .ls>:nth-child(8)>* :is(.mk,.chi,.chip,.chp,circle,"
			    & ".pend),.tt .ls>:nth-child(9)>*,.tt .ls>:nth-child(9)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(10)>*,.tt .ls>:nth-child(10)>* :is(.mk,.chi,.chip,.chp,circle,.pend)"
			    & ",.tt .ls>:nth-child(11)>*,.tt .ls>:nth-child(11)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(12)>*,.tt .ls>:nth-child(12)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt"
			    & " .ls>:nth-child(13)>*,.tt .ls>:nth-child(13)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .ls>:nth-child(14)>*,.tt .ls>:nth-child(14)>* :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .pe"
			    & ",.tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:none!important}}/*fim-contador*/ "
		displayFolder: T1 Visão geral\Tooltips
		lineageTag: d57e11ea-930b-5389-9c6f-36a97017e7ce

	/// Tooltip de página da obra (linha da lista de obras): no cabeçalho a nota e o status da nota (ou 'pendente · X de Y') e o gestor, se houver; os 9 itens da nota com o valor, a faixa atingida e os pontos de possíveis ('falta na base' quando não há dado); a nota mês a mês na janela (pendente tracejado até os pontos obtidos; rótulo no mês de referência, na maior e na menor nota); no pé, o que mudou desde o mês anterior, só entre notas completas, ou quantos itens faltam para a nota sair.
	measure 'T1 · Tooltip obra · HTML' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _mesCM = [Mês de referência · curto maiúsculo]
			VAR _mesAnt = [Mês anterior à referência · nome]
			VAR _obra = [Obra · nome]
			VAR _cod = [Obra · código]
			VAR _selo = [Obra · selo]
			VAR _gestor = [Nota · gestor · ref]
			VAR _st = [Nota · status · ranking · ref]
			VAR _pend = [Nota · pendente · ranking · ref]
			VAR _nota = [Nota · nota final · ranking · ref]
			VAR _obt = [Nota · pontos obtidos · ranking · ref]
			VAR _poss = [Nota · pontos possíveis · ranking · ref]
			VAR _falta = [Nota · itens faltando · ref] + 0
			VAR _fora = [Nota · itens fora da faixa · ref] + 0
			VAR _fal = _falta - _fora
			VAR _max = [Nota · nota · máximo]
			VAR _stAnt = [T1 · Obra · status no mês anterior · ref]
			VAR _notaAnt = [T1 · Obra · nota no mês anterior · ref]
			VAR _pendAnt = [T1 · Obra · pendente no mês anterior · ref]
			VAR _itens =
			    ADDCOLUMNS (
			        VALUES ( dItemNota[Item] ),
			        "@ord", [Nota · item · ordem],
			        "@rot", [Nota · item · nome médio],
			        "@fonte", [Nota · item · fonte],
			        "@fora", [Nota · item · fora da faixa · ref],
			        "@x", [Nota · item · X · ref],
			        "@fx", [Nota · item · faixa atingida · ref],
			        "@pts", [Nota · item · pontos · ref],
			        "@poss", [Nota · item · possíveis · ref]
			    )
			VAR _nIt = COUNTROWS ( _itens ) /* lista */
			VAR _n = [Série · meses até a referência]
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@ord", [Mês · ordem],
			        "@pos", [Série · posição na janela],
			        "@rotAno", [Mês · rótulo curto],
			        "@nota", [Nota · nota final · um mês],
			        "@st", [Nota · status · um mês],
			        "@pend", [Nota · pendente · um mês],
			        "@obt", [Nota · pontos obtidos · um mês],
			        "@poss", [Nota · pontos possíveis · um mês],
			        "@rot", [Mês · abreviado]
			    )
			-- 2 · Textos
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _txtSob = "NOTA DA OBRA · " & _mesCM & IF ( _gestor = "" || ISBLANK ( _gestor ), "", " · GESTOR: " & UPPER ( _gestor ) )
			VAR _txtDir =
			    IF (
			        _pend = 1,
			        "PENDENTE · " & "⁅" & FORMAT ( _obt, "0.0#", "pt-BR" ) & "⁆" & " DE " & FORMAT ( _poss, "0.0#", "pt-BR" ),
			        "NOTA " & "⁅" & FORMAT ( _nota, "0.0#", "pt-BR" ) & "⁆" & " · " & UPPER ( SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) )
			    )
			VAR _htmlLinhas =
			    CONCATENATEX (
			        _itens,
			        VAR _c = dItemNota[Item]
			        VAR _x = [@x]
			        VAR _fx = [@fx]
			        VAR _pts = [@pts]
			        VAR _possI = [@poss]
			        VAR _vA = ABS ( _x )
			        VAR _vTxt =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _x ), "—",
			                _c = "custo", "IDC " & FORMAT ( _x, "0.00", "pt-BR" ),
			                _c = "prazo", IF ( ROUND ( _x, 1 ) > 0, "atraso ", IF ( ROUND ( _x, 1 ) < 0, "adiantada ", "em dia" ) )
			                    & IF ( ROUND ( _x, 1 ) = 0, "", FORMAT ( _vA, "0.0", "pt-BR" ) & IF ( ROUND ( _vA, 1 ) <= 1, " mês", " meses" ) ),
			                _c = "acidentes", "TF " & FORMAT ( _x, "0.0", "pt-BR" ),
			                _c = "analise", FORMAT ( _x, "0" ) & " de 3",
			                FORMAT ( TRUNC ( _vA * 100, 1 ), "0.0", "pt-BR" ) & "%"
			            )
			        VAR _vNg = IF ( ( _c = "custo" && _x < 1 ) || ( _c = "prazo" && ROUND ( _x, 1 ) > 0 ), " ng", "" )
			        VAR _kTxt = IF ( ISBLANK ( _pts ), "falta na base", FORMAT ( _pts, "0.0#", "pt-BR" ) & " de " & FORMAT ( _possI, "0.0#", "pt-BR" ) )
			        VAR _kCls = SWITCH ( TRUE (), ISBLANK ( _pts ), "f", _pts >= _possI, "c", _pts = 0, "z", "p" )
			        VAR _kHtml = "<span class='chi chi-" & _kCls & "'>" & _kTxt & "</span>"
			        VAR _txtFalta = IF ( [@fora] = 1, "fora da faixa", IF ( [@fonte] = "Análise Crítica", "sem dado na planilha", "falta na base" ) )
			        VAR _clsK = SWITCH ( TRUE (), ISBLANK ( _pts ), "f", _pts >= _possI, "c", _pts = 0, "z", "p" )
			        VAR _chip = "<span class='chi chi-" & _clsK & "'>" & IF ( ISBLANK ( _pts ), _txtFalta, "⁅" & _kTxt & "⁆" ) & "</span>"
			        VAR _det = IF ( ISBLANK ( _pts ), "", _fx )
			        RETURN
			            "<div class='lin'><span class='n'>" & [@rot] & "</span><span class='v" & _vNg & "'>" & "⁅" & _vTxt & "⁆"
			                & "</span><span class='d'>" & _det & "</span><span class='p'>" & _chip & "</span></div>",
			        "",
			        [@ord], ASC
			    )
			VAR _serie = FILTER ( _meses, [@ate] = 1 ) /* lista */
			VAR _comNota = FILTER ( _serie, NOT ISBLANK ( [@nota] ) ) /* lista */
			VAR _vMax = MAXX ( _comNota, [@nota] ) /* geometria */
			VAR _vMin = MINX ( _comNota, [@nota] ) /* geometria */
			VAR _mesMax = MINX ( FILTER ( _comNota, [@nota] = _vMax ), dMes[Mes] ) /* geometria */
			VAR _mesMin = MINX ( FILTER ( _comNota, [@nota] = _vMin ), dMes[Mes] ) /* geometria */
			VAR _rotMax = _vMax <> _nota
			VAR _rotMin = _vMin <> _nota && _vMin <> _vMax
			VAR _slot = MIN ( 65, DIVIDE ( 518, _n ) ) -- geometria
			VAR _larg = MIN ( 32, ROUND ( _slot - 12, 0 ) ) -- geometria
			VAR _w = ROUND ( _slot, 0 ) -- geometria
			VAR _xb = ROUND ( ( _slot - _larg ) / 2, 0 ) -- geometria
			VAR _passo = ROUND ( DIVIDE ( 420, _n ), 0 ) -- geometria
			VAR _escala = DIVIDE ( 40, _max ) -- geometria
			VAR _htmlSerie =
			    CONCATENATEX (
			        _serie,
			        VAR _pd = [@pend] = 1
			        VAR _v = IF ( _pd, [@obt], [@nota] )
			        VAR _tem = NOT ISBLANK ( [@pend] ) && NOT ISBLANK ( _v )
			        VAR _h = IF ( _tem, MAX ( ROUND ( _v * _escala, 0 ), 2 ), 0 ) /* geometria */
			        VAR _x = ROUND ( ( [@pos] - 1 ) * _slot, 0 ) /* geometria */
			        VAR _atraso = ( [@pos] - 1 ) * _passo /* geometria */
			        VAR _cls = IF ( _pd, "sm", "s" & [@st] )
			        VAR _txtV = IF ( _pd, FORMAT ( [@obt], "0.0#", "pt-BR" ) & " de " & FORMAT ( [@poss], "0.0#", "pt-BR" ), FORMAT ( [@nota], "0.0#", "pt-BR" ) )
			        VAR _ehRef = dMes[Mes] = _ref
			        VAR _ehExt = NOT _pd && ( ( _rotMax && dMes[Mes] = _mesMax ) || ( _rotMin && dMes[Mes] = _mesMin ) )
			        VAR _rotMes = IF ( [@rot] = "jan" && [@pos] > 1, [@rotAno], [@rot] )
			        VAR _rot =
			            SWITCH (
			                TRUE (),
			                _tem && _ehRef, "<span class='val fim' style='bottom:" & ( 24 + _h ) & "px;animation-delay:"
			                    & ( _atraso + 700 ) & "ms'>" & "⁅" & _txtV & "⁆" & "</span>",
			                _tem && _ehExt, "<span class='val ext' style='bottom:" & ( 24 + _h ) & "px'>" & "⁅" & _txtV & "⁆" & "</span>",
			                ""
			            )
			        RETURN
			            "<div class='c" & IF ( [@pos] = 1, " ini", IF ( [@pos] = _n, " fim" ) ) & "' style='left:" & _x & "px;width:" & _w & "px'>" & _rot
			                & IF ( _tem, "<i class='bar " & _cls & "' style='left:" & _xb & "px;width:" & _larg
			                    & "px;height:" & _h & "px' data-rk='m" & [@ord] & "' data-rp='height' data-rd='" & _atraso
			                    & "'></i>" )
			                & "<span class='ms" & IF ( _ehRef, " ref", IF ( _tem, "", " sem" ) ) & "'>" & _rotMes & "</span></div>",
			        "",
			        dMes[Mes], ASC
			    )
			VAR _txtNota = "⁅" & FORMAT ( _nota, "0.0#", "pt-BR" ) & "⁆"
			VAR _txtNotaAnt = "⁅" & FORMAT ( _notaAnt, "0.0#", "pt-BR" ) & "⁆"
			VAR _txtFalta =
			    SWITCH (
			        TRUE (),
			        _fal > 0 && _fora > 0, "falta dado em " & _fal & IF ( _fal = 1, " item", " itens" ) & " e " & _fora & " está"
			            & IF ( _fora > 1, "ão", "" ) & " fora da faixa",
			        _fal > 0, IF ( _fal = 1, "falta dado em 1 item", "falta dado em " & _fal & " itens" ),
			        IF ( _fora = 1, "1 item está fora da faixa", _fora & " itens estão fora da faixa" )
			    )
			VAR _txtSai =
			    SWITCH (
			        TRUE (),
			        _fal = 0, IF ( _fora = 1, "; a nota sai quando ele for corrigido", "; a nota sai quando forem corrigidos" ),
			        _fora > 0, "; sem nota por enquanto",
			        _falta = 1, "; a nota sai quando ele tiver dado",
			        "; a nota sai quando todos tiverem dado"
			    )
			VAR _txtMud =
			    SWITCH (
			        TRUE (),
			        _pend = 1, _txtFalta & _txtSai,
			        _pendAnt = 1, "em " & _mesAnt & " a obra estava pendente: sem nota para comparar",
			        ISBLANK ( _notaAnt ), "",
			        _stAnt = _st, "seguiu em " & SWITCH ( _st, 2, "crítico", 1, "atenção", "estável" ) & IF ( _txtNotaAnt = _txtNota, ", com a mesma nota", ": nota de " & _txtNotaAnt & " para " & _txtNota ),
			        _st = 2, "entrou em crítico: nota de " & _txtNotaAnt & " para " & _txtNota,
			        _stAnt = 2, "saiu de crítico para " & SWITCH ( _st, 2, "crítico", 1, "atenção", "estável" ) & ": nota de " & _txtNotaAnt & " para " & _txtNota,
			        "passou de " & SWITCH ( _stAnt, 2, "crítico", 1, "atenção", "estável" ) & " para " & SWITCH ( _st, 2, "crítico", 1, "atenção", "estável" ) & ": nota de " & _txtNotaAnt & " para " & _txtNota
			    )
			VAR _tituloMud = IF ( _pend = 1, "POR QUE ESTÁ PENDENTE", "DESDE " & UPPER ( _mesAnt ) )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _pend ),
			        "<div class='u tt'><div class='cab'><p class='vs'>" & _txtSob & "</p>"
			            & "<div class='tit'><b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</b><em>" & _cod & "</em>" & "<span class='selo " & IF ( _selo = "REAL", "selo-r", "selo-i" ) & "'>" & _selo & "</span>" & "</div>"
			            & "<p class='vs dir'>" & _txtDir & "</p></div>"
			            & "<div class='corpo'><div class='bh'><span class='vs'>ITENS DA NOTA</span>"
			            & "<span class='vs'>PONTOS</span></div><div class='tab" & " ls " & SWITCH ( TRUE (), _nIt <= 3, "e1", _nIt <= 6, "e2", _nIt <= 9, "e3", _nIt <= 12, "e4", "e5" ) & "' style='--n:" & _nIt & "'>" & _htmlLinhas & "</div>"
			            & "<div class='rg s'></div><span class='vs'>NOTA, MÊS A MÊS</span>"
			            & "<div class='ser'>" & _htmlSerie & "</div></div>"
			            & IF ( _txtMud <> "", "<div class='pe'><div class='rg'></div><span class='vs'>" & _tituloMud & "</span>"
			                & "<p class='rod'>" & _txtMud & "</p></div>" )
			        & "</div>" & [Comum · JS contador tooltip] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Tooltips
		lineageTag: 2e97826a-ec30-5cb3-96bb-23c96c7f6a2e

	/// Obra do recorte com o maior desvio do desembolso (absoluto) no mês de referência.
	measure 'Desembolso · obra de maior desvio · ref' =
			VAR _mes = [Mês de referência]
			VAR _obras =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( fAnaliseCritica[Obra] ), "@d", ABS ( [Desembolso · desvio no mês] ) ),
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] = _mes
			    )
			RETURN
			    MAXX ( TOPN ( 1, FILTER ( _obras, NOT ISBLANK ( [@d] ) ), [@d], DESC ), fAnaliseCritica[Obra] )
		displayFolder: T1 Visão geral\Tooltips\Contas
		lineageTag: 4cbb2c6a-ef13-5de9-acad-1dbd086d3cfd

	/// Obras do recorte com justificativa exigida e em branco no mês de referência, do maior para o menor |desvio| do desembolso (empate: ordem alfabética), separadas por '|'. O rodapé do tooltip do item fluxo de caixa escreve quantas couberem numa linha (justificativas_rodape.py); a leitura do desembolso por obra (T4) lista todas.
	measure 'Recorte · justificativas em branco (lista) · ref' =
			VAR _mes = [Mês de referência]
			VAR _obras =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( fAnaliseCritica[Obra] ),
			            "@b", [Justificativa · em branco],
			            "@d", ABS ( [Desembolso · desvio no mês] )
			        ),
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] = _mes
			    )
			RETURN
			    CONCATENATEX ( FILTER ( _obras, [@b] = 1 ), fAnaliseCritica[Obra], "|", [@d], DESC, fAnaliseCritica[Obra], ASC )
		displayFolder: T1 Visão geral\Tooltips\Contas
		lineageTag: 9dd4c9d0-cd88-5935-872a-329d29af6e34

	/// Justificativas exigidas e em branco no mês de referência além das 2 primeiras obras da lista (Recorte · justificativas em branco (lista) · ref): o M de 'em branco: A, B e mais M' no rodapé do tooltip do item fluxo de caixa (T1) e no cartão Justificativas do mês (T4); vazio com até 2 em branco.
	measure 'Recorte · justificativas em branco fora da lista curta · ref' =
			VAR _n = [Carteira · justificativas em branco · ref] + 0
			RETURN
			    IF ( _n > 2, _n - 2 )
		formatString: 0
		displayFolder: T1 Visão geral\Tooltips\Contas
		lineageTag: 7b9bea5a-0b01-51d5-b1fd-5c24dc1e6a7a

	/// [Nota · nota final] da obra no mês anterior ao do contexto (vazio sem aba nem base no mês anterior; vazio também quando o mês anterior está pendente). Uma obra no contexto. Lê [Nota · nota final · um mês].
	measure 'T1 · Obra · nota no mês anterior' =
			VAR _mes = EDATE ( MAX ( dMes[Mes] ), -1 )
			RETURN
