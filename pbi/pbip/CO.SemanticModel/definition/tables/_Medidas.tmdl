			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, [@tipo] = "final" ) ) + 0
