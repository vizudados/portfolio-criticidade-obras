		lineageTag: a763580c-d49b-5b27-a40f-d55c098363f0

	/// Mês da janela com o maior PPC da obra em foco (empate: o mais recente); vazio sem base.
	measure 'T3 · PPC · mês do maior · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", VAR _v = [Canteiro · PPC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@v] ) )
			VAR _x = MAXX ( _com, [@v] )
			RETURN
			    MAXX ( FILTER ( _com, [@v] = _x ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\PPC mês a mês\Contas
		lineageTag: 1862864d-3cd9-5652-b65b-724d81a70fe7

	/// Mês da janela com o menor PPC da obra em foco (empate: o mais recente); vazio sem base.
	measure 'T3 · PPC · mês do menor · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", VAR _v = [Canteiro · PPC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@v] ) )
			VAR _x = MINX ( _com, [@v] )
			RETURN
			    MAXX ( FILTER ( _com, [@v] = _x ), dMes[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\PPC mês a mês\Contas
		lineageTag: fb42a609-ce38-5d07-8917-cd53bd6ef5cb

	/// Meses entre a entrega contratual e o término projetado da obra em foco no mês de referência (negativo: antes da entrega).
	measure 'T3 · Término · meses além da entrega · foco' =
			VAR _p = [Prazo · término projetado · foco]
			VAR _e = [Prazo · entrega contratual · foco]
			RETURN
			    IF ( NOT ISBLANK ( _p ) && NOT ISBLANK ( _e ), DATEDIFF ( _e, _p, MONTH ) )
		formatString: 0
		displayFolder: T3 Avanço físico\Prazo\Contas
