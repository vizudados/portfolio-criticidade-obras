	/// Pior status do físico na nota na série da obra do contexto, na janela (0 = sempre dentro do limite; 2 = passou dele em algum mês).
	measure 'T3 · Físico · maior status na série' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@s", VAR _m = dMes[Mes] RETURN CALCULATE ( [T3 · Status desvio físico], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			RETURN
			    MAXX ( _meses, [@s] )
		formatString: 0
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: 8432e6c6-2b27-51b4-9c89-2f631b311afa

	/// [T3 · Físico · maior status na série] da obra em foco.
	measure 'T3 · Físico · maior status na série · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Físico · maior status na série], dObra[Obra] = _obra )
		formatString: 0
		displayFolder: T3 Avanço físico\Série\Contas
