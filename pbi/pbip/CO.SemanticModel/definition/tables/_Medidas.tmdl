	/// 1 quando o degrau da linha entra na cascata da obra em foco (todos, sempre que há degrau na linha).
	measure 'Cascata · degrau · aparece · foco' =
			IF ( NOT ISBLANK ( SELECTEDVALUE ( dDegrau[Degrau] ) ), 1 )
		formatString: 0
