	/// Obras do recorte com item da nota de valor fora da faixa válida no mês de referência, separadas por '|', em ordem de nome; vazio sem nenhuma.
	measure 'T1 · Obras · com item fora da faixa (lista) · ref' =
			CONCATENATEX (
			    FILTER ( VALUES ( dObra[Obra] ), [Nota · itens fora da faixa · ref] > 0 ),
			    dObra[Obra],
			    "|",
			    dObra[Obra], ASC
			)
		displayFolder: T1 Visão geral\Obras pela nota\Contas
		lineageTag: 77575049-9c54-5410-b4cb-337e04943ad2

	/// Código (dItemNota) do 1º item da nota em que a obra mais perde pontos no mês do contexto: mais pontos perdidos primeiro; empate pelo maior máximo e depois pela ordem da nota. Só itens com perda; vazio quando a obra perde pontos em menos de 1 item(ns). Uma obra no contexto.
	measure 'T1 · Obras · item que mais perde 1' =
			VAR _itens =
			    ADDCOLUMNS (
			        ALL ( dItemNota ),
			        "@p", [Nota · item · perdidos]
			    )
			VAR _perde = FILTER ( _itens, [@p] > 0 )
			VAR _top = TOPN ( 1, _perde, [@p], DESC, dItemNota[Maximo], DESC, dItemNota[Ordem], ASC )
			VAR _escolhido = TOPN ( 1, _top, [@p], ASC, dItemNota[Maximo], ASC, dItemNota[Ordem], DESC )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && COUNTROWS ( _top ) = 1, MAXX ( _escolhido, dItemNota[Item] ) )
		displayFolder: T1 Visão geral\Obras pela nota\Contas
		lineageTag: 7a185a46-f287-5c8d-88e6-701f36e10d72

	/// [T1 · Obras · item que mais perde 1] no mês de referência (seletor do drawer; sem escolha, o último mês).
	measure 'T1 · Obras · item que mais perde 1 · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [T1 · Obras · item que mais perde 1], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		displayFolder: T1 Visão geral\Obras pela nota\Contas
		lineageTag: 04079019-7531-5910-998d-5b67a3ab591f

	/// Código (dItemNota) do 2º item da nota em que a obra mais perde pontos no mês do contexto: mais pontos perdidos primeiro; empate pelo maior máximo e depois pela ordem da nota. Só itens com perda; vazio quando a obra perde pontos em menos de 2 item(ns). Uma obra no contexto.
	measure 'T1 · Obras · item que mais perde 2' =
			VAR _itens =
			    ADDCOLUMNS (
			        ALL ( dItemNota ),
			        "@p", [Nota · item · perdidos]
			    )
			VAR _perde = FILTER ( _itens, [@p] > 0 )
			VAR _top = TOPN ( 2, _perde, [@p], DESC, dItemNota[Maximo], DESC, dItemNota[Ordem], ASC )
			VAR _escolhido = TOPN ( 1, _top, [@p], ASC, dItemNota[Maximo], ASC, dItemNota[Ordem], DESC )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && COUNTROWS ( _top ) = 2, MAXX ( _escolhido, dItemNota[Item] ) )
		displayFolder: T1 Visão geral\Obras pela nota\Contas
		lineageTag: ff00c831-baa8-52f1-8c80-98258d7cb249

	/// [T1 · Obras · item que mais perde 2] no mês de referência (seletor do drawer; sem escolha, o último mês).
	measure 'T1 · Obras · item que mais perde 2 · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [T1 · Obras · item que mais perde 2], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		displayFolder: T1 Visão geral\Obras pela nota\Contas
		lineageTag: 234ed447-697f-5c2c-bfc7-f4cf6563f3a8

	/// Códigos (dItemNota) dos itens que a frase 'perde mais …' cita para a obra do contexto, separados por '|', do que mais perde ao que menos perde (empate: maior máximo, depois a ordem da nota). Empate no topo: todos os empatados. Topo único: ele e o segundo, se o segundo for único; com o segundo empatado, só o topo. Só itens com perda; vazio sem perda. Uma obra no contexto.
	measure 'T1 · Obras · itens que mais perdem (lista)' =
			VAR _itens = ADDCOLUMNS ( ALL ( dItemNota ), "@p", ROUND ( [Nota · item · perdidos], 8 ) )
			VAR _perde = FILTER ( _itens, [@p] > 0 )
			VAR _p1 = MAXX ( _perde, [@p] )
			VAR _nTopo = COUNTROWS ( FILTER ( _perde, [@p] = _p1 ) )
			VAR _p2 = MAXX ( FILTER ( _perde, [@p] < _p1 ), [@p] )
			VAR _n2 = COUNTROWS ( FILTER ( _perde, [@p] = _p2 ) )
			VAR _cita = FILTER ( _perde, [@p] = _p1 || ( _nTopo = 1 && _n2 = 1 && [@p] = _p2 ) )
			RETURN
			    IF (
			        HASONEVALUE ( dObra[Obra] ),
			        CONCATENATEX ( _cita, dItemNota[Item], "|", [@p], DESC, dItemNota[Maximo], DESC, dItemNota[Ordem], ASC )
			    )
		displayFolder: T1 Visão geral\Obras pela nota\Contas
		lineageTag: a567c265-2d47-55ce-8ffa-0e6bae4f6b49

	/// [T1 · Obras · itens que mais perdem (lista)] no mês de referência (seletor do drawer; sem escolha, o último mês).
	measure 'T1 · Obras · itens que mais perdem (lista) · ref' =
			VAR _mes = [Mês de referência]
			RETURN
			    CALCULATE ( [T1 · Obras · itens que mais perdem (lista)], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
		displayFolder: T1 Visão geral\Obras pela nota\Contas
		lineageTag: b59e193f-5fda-54bf-bfaf-16b692aa8650

	/// Posição da obra no ranking do mês de referência pela nota: mais pontos perdidos primeiro; empate pela menor nota (pendente, sem nota, depois das que têm nota) e depois pelo nome. Entre as obras com aba no mês e no recorte. Lê o ranking guardado em dRankingNota (as mesmas medidas Nota, calculadas no refresh). Uma obra no contexto.
	measure 'T1 · Obras · posição' =
			VAR _obra = SELECTEDVALUE ( dObra[Obra] )
			VAR _mes = [Mês de referência]
			VAR _recorte = CALCULATETABLE ( VALUES ( dObra[Obra] ), ALLSELECTED ( dObra ) )
			VAR _obras = FILTER ( dRankingNota, dRankingNota[Mes] = _mes && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte )
			VAR _eu = FILTER ( _obras, dRankingNota[Obra] = _obra )
			VAR _perd = MAXX ( _eu, dRankingNota[Perdidos] )
			VAR _nota = MAXX ( _eu, dRankingNota[NotaOrdem] )
			VAR _antes =
			    COUNTROWS (
			        FILTER (
			            _obras,
			            dRankingNota[Perdidos] > _perd
			                || (
			                    dRankingNota[Perdidos] = _perd
			                        && ( dRankingNota[NotaOrdem] < _nota || ( dRankingNota[NotaOrdem] = _nota && dRankingNota[Obra] < _obra ) )
			                )
			        )
			    )
			RETURN
			    IF ( NOT ISEMPTY ( _eu ), _antes + 1 )
		formatString: 0
		displayFolder: T1 Visão geral\Obras pela nota\Contas
		lineageTag: fea57507-e538-593d-9761-f38d87e4cddb

	/// CSS da lista 'Onde a carteira perde pontos' (uma entrada por dimensão da nota).
	measure 'T1 · Pesa · CSS lista' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".htmlViewerEntry{display:block!important;margin:0!important;padding:0!important}.pl{position:relative;height:48px;transition:background .15s}.pl:hover,.htmlViewerEntry.hover .pl{ba"
			    & "ckground:rgba(247,244,238,.9)}.pl .rt{position:absolute;left:0;top:0;display:flex;align-items:baseline;gap:10px;white-space:nowrap}.pl .rt span{font-size:15px;line-height:21px;font"
			    & "-weight:600}.pl .rt em{font-style:normal;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:12px;line-height:15px;letter-spacing:1.2px;color:#6B6B70}.pl .pt{rig"
			    & "ht:0;top:0;font-size:16px;line-height:20px}.pl .pt.vz{color:#6B6B70}.pl .tr{position:absolute;left:0;top:27px;width:464px;height:8px;background:#EFEFEF}.pl .tr.f{top:31px;height:0;"
			    & "background:transparent;border-top:1px dashed #9A9A9E}.pl .tr i{position:absolute;top:0;bottom:0}.pl .tr i.c{background:#C43737}.pl .tr i.a{background:#C9821F}.pl .tr i.e{background"
			    & ":#A9CDB9}.pl .tr i.p{background:#FFFFFF;border:1px dashed #3B3B3F;box-sizing:border-box}"
		displayFolder: T1 Visão geral\Onde a carteira perde pontos
		lineageTag: 6c8eac0d-3aeb-5537-a49a-2c3901909bf1

	/// Uma linha por dimensão da nota (granularidade dItemNota[Dimensao], ordem T1 · Pesa · posição): nome, quantas obras perderam pontos, em quantas falta dado e, com dois itens, o item que mais perde; pontos perdidos somados e a barra na escala da dimensão que mais perde, separada pelo status da obra (crítico, atenção, estável, pendente). Dimensão sem dado em nenhuma obra: trilho tracejado e 'falta na base' (ou 'sem dado na planilha', na Análise Crítica).
	measure 'T1 · Pesa · HTML linha' =
			-- 1 · Leituras
			VAR _pos = [T1 · Pesa · posição]
			VAR _rot = [Nota · item · dimensão]
			VAR _fonte = [Nota · item · fonte]
			VAR _itTop = [T1 · Pesa · item que mais perde] & ""
			VAR _itRot = IF ( _itTop = "", "", CALCULATE ( [Nota · item · nome curto], dItemNota[Item] = _itTop ) )
			VAR _perd = [Nota · item · perdidos · ref]
			VAR _poss = [Nota · item · possíveis · ref]
			VAR _nOb = [Nota · item · obras que perderam pontos · ref] + 0
			VAR _nSem = [T1 · Pesa · obras sem dado] + 0
			VAR _pC = [T1 · Pesa · perdidos das obras críticas] + 0
			VAR _pA = [T1 · Pesa · perdidos das obras em atenção] + 0
			VAR _pE = [T1 · Pesa · perdidos das obras estáveis] + 0
			VAR _pP = [T1 · Pesa · perdidos das obras pendentes] + 0
			VAR _max = [T1 · Pesa · maior perda]
			-- 3 · Geometria
			VAR _k = IF ( _max > 0, 464 / _max, 0 ) -- geometria
			VAR _xA = ROUND ( _pC * _k, 0 ) -- geometria
			VAR _xE = ROUND ( ( _pC + _pA ) * _k, 0 ) -- geometria
			VAR _xP = ROUND ( ( _pC + _pA + _pE ) * _k, 0 ) -- geometria
			VAR _xF = ROUND ( ( _pC + _pA + _pE + _pP ) * _k, 0 ) -- geometria
			VAR _atraso = ( _pos - 1 ) * 60 -- geometria
			-- 2 · Textos
			VAR _semDado = ISBLANK ( _poss )
			VAR _txtFalta = IF ( _fonte = "Análise Crítica", "sem dado na planilha", "falta na base" )
			VAR _txtOb = IF ( _nOb = 0, "nenhuma obra", IF ( _nOb = 1, "1 obra", "⁅" & _nOb & "⁆" & " obras" ) )
			VAR _txtSem = IF ( _fonte = "Análise Crítica", "sem dado em ", "falta em " ) & "⁅" & _nSem & "⁆"
			VAR _txtEm = IF ( _semDado, _txtFalta, _txtOb & IF ( _nSem > 0, " · " & _txtSem, "" ) & IF ( _itRot = "", "", " · mais em " & _itRot ) )
			VAR _txtPts = IF ( _semDado, "—", FORMAT ( _perd, "0.0#", "pt-BR" ) & " pts" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _nuPts = IF ( _semDado, "", FORMAT ( _perd, "0.0#", "pt-BR" ) )
			VAR _pKP = LEN ( _nuPts ) > 0
			VAR _pKN = IF ( _pKP, _nuPts )
			VAR _pKS = SUBSTITUTE ( SUBSTITUTE ( _pKN, ".", "" ), ",", "" )
			VAR _pKT = IFERROR ( VALUE ( _pKS ), -1 )
			VAR _pKOk = _pKP && _pKT >= 2 && FORMAT ( _pKT, REPT ( "0", LEN ( _pKS ) ) ) = _pKS
			VAR _pKD = IF ( CONTAINSSTRING ( _pKN, "," ), LEN ( _pKN ) - SEARCH ( ",", _pKN ), 0 )
			VAR _pKM = IF ( CONTAINSSTRING ( _pKN, "." ), "#,##0", "0" ) & IF ( _pKD > 0, "." & REPT ( "0", _pKD ) )
			VAR _pKOd =
			    IF (
			        _pKOk,
			        "<o-d><o-v>" & _pKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _pKN, FORMAT ( ROUND ( _pKT * [@odf] / 1000, 0 ) / POWER ( 10, _pKD ), _pKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _nuPts
			    )
			VAR _odPts = IF ( _semDado, _txtPts, _pKOd & " pts" )
			-- 4 · Marcação
			VAR _seg = "' data-rd='" & _atraso & "'></i>"
			VAR _htmlTr =
			    IF (
			        _semDado,
			        "<div class='tr f a-gx' style='animation-delay:" & _atraso & "ms'></div>",
			        "<div class='tr a-fd' style='animation-delay:" & _atraso & "ms'>"
			            & IF ( _xA > 0, "<i class='c' style='left:0;width:" & _xA & "px' data-rk='" & _rot & "|c" & _seg )
			            & IF ( _xE > _xA, "<i class='a' style='left:" & _xA & "px;width:" & ( _xE - _xA ) & "px' data-rk='" & _rot & "|a" & _seg )
			            & IF ( _xP > _xE, "<i class='e' style='left:" & _xE & "px;width:" & ( _xP - _xE ) & "px' data-rk='" & _rot & "|e" & _seg )
			            & IF ( _xF > _xP, "<i class='p' style='left:" & _xP & "px;width:" & ( _xF - _xP ) & "px' data-rk='" & _rot & "|p" & _seg )
			        & "</div>"
			    )
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _pos ),
			        "<div class='u pl' data-rr='" & _rot & "'>"
			            & "<div class='rt'><span>" & _rot & "</span><em>" & UPPER ( _txtEm ) & "</em></div>"
			            & "<p class='ab b6 pt" & IF ( _semDado, " vz", "" ) & "'>" & _odPts & "</p>"
			            & _htmlTr
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Onde a carteira perde pontos
		lineageTag: b6723c1e-ed26-551d-86b6-465f162a1985

	/// Subtítulo do painel 'Onde a carteira perde pontos' (quantas obras somam).
	measure 'T1 · Pesa · HTML subtítulo' =
			-- 1 · Leituras
			VAR _n = [Obras com análise · ref]
			-- 2 · Textos
			VAR _txt = IF ( _n = 1, "pontos que a obra perde, por dimensão da nota", "pontos perdidos somados das " & "⁅" & _n & "⁆" & " obras, por dimensão" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u' style='position:fixed;inset:0'><p class='ab' style='left:0;top:0;font-size:15px;line-height:20px;color:#3B3B3F'>" & _txt & "</p></div>" & [Comum · JS contador]
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Onde a carteira perde pontos
		lineageTag: a6cfeb97-fa18-5957-9876-35ca176254ec

	/// Código (dItemNota) do item da dimensão da linha que mais perde pontos somados no mês de referência (empate: a ordem do item); vazio sem perda ou com um item só na dimensão.
	measure 'T1 · Pesa · item que mais perde' =
			VAR _itens = ADDCOLUMNS ( VALUES ( dItemNota[Item] ), "@p", [Nota · item · perdidos · ref] + 0 )
			VAR _top = TOPN ( 1, FILTER ( _itens, [@p] > 0 ), [@p], DESC, [Nota · item · ordem], ASC )
			RETURN
			    IF ( HASONEVALUE ( dItemNota[Dimensao] ) && COUNTROWS ( _itens ) > 1, MAXX ( _top, dItemNota[Item] ) )
		displayFolder: T1 Visão geral\Onde a carteira perde pontos\Contas
		lineageTag: 595636a1-cd1f-520f-8a0f-27d688cd68eb

	/// Maior soma de pontos perdidos entre as dimensões da nota no mês de referência (escala das barras do painel).
	measure 'T1 · Pesa · maior perda' =
			MAXX ( ALL ( dItemNota[Dimensao], dItemNota[OrdemDimensao] ), [Nota · item · perdidos · ref] )
		formatString: 0.00
		displayFolder: T1 Visão geral\Onde a carteira perde pontos\Contas
		lineageTag: 4fc7ae5b-5c72-5046-a422-6aadb1a6316d

	/// Obras com aba no mês de referência em que falta dado em algum item da dimensão da linha (falta na base ou sem dado na planilha; o valor fora da faixa válida também conta, porque o item fica sem pontos).
	measure 'T1 · Pesa · obras sem dado' =
			VAR _mes = [Mês de referência]
			VAR _obras = CALCULATETABLE ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
			VAR _max = [Nota · item · máximo]
			RETURN
			    IF (
			        HASONEVALUE ( dItemNota[Dimensao] ),
			        COUNTROWS ( FILTER ( _obras, NOT ( [Nota · item · possíveis · ref] >= _max ) ) ) + 0
			    )
		formatString: 0
		displayFolder: T1 Visão geral\Onde a carteira perde pontos\Contas
		lineageTag: ccdb5568-f6cc-53c3-b714-12fee00df97d

	/// Pontos que as obras críticas no mês de referência perderam na dimensão da linha (dItemNota[Dimensao]). Somadas as quatro, dá [Nota · item · perdidos · ref].
	measure 'T1 · Pesa · perdidos das obras críticas' =
			VAR _mes = [Mês de referência]
			VAR _obras = CALCULATETABLE ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
			RETURN
			    IF (
			        HASONEVALUE ( dItemNota[Dimensao] ),
			        SUMX ( _obras, IF ( [Nota · status · ranking · ref] == 2, [Nota · item · perdidos · ref] ) )
			    )
		formatString: 0.00
		displayFolder: T1 Visão geral\Onde a carteira perde pontos\Contas
		lineageTag: 3d646704-aebd-56c9-9392-7192c56a12ec

	/// Pontos que as obras em atenção no mês de referência perderam na dimensão da linha (dItemNota[Dimensao]). Somadas as quatro, dá [Nota · item · perdidos · ref].
	measure 'T1 · Pesa · perdidos das obras em atenção' =
			VAR _mes = [Mês de referência]
			VAR _obras = CALCULATETABLE ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
			RETURN
			    IF (
			        HASONEVALUE ( dItemNota[Dimensao] ),
			        SUMX ( _obras, IF ( [Nota · status · ranking · ref] == 1, [Nota · item · perdidos · ref] ) )
			    )
		formatString: 0.00
		displayFolder: T1 Visão geral\Onde a carteira perde pontos\Contas
		lineageTag: de1c4636-6fb9-5a24-88b3-f71a17948f3a

	/// Pontos que as obras estáveis no mês de referência perderam na dimensão da linha (dItemNota[Dimensao]). Somadas as quatro, dá [Nota · item · perdidos · ref].
	measure 'T1 · Pesa · perdidos das obras estáveis' =
			VAR _mes = [Mês de referência]
			VAR _obras = CALCULATETABLE ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
			RETURN
			    IF (
			        HASONEVALUE ( dItemNota[Dimensao] ),
			        SUMX ( _obras, IF ( [Nota · status · ranking · ref] == 0, [Nota · item · perdidos · ref] ) )
			    )
		formatString: 0.00
		displayFolder: T1 Visão geral\Onde a carteira perde pontos\Contas
		lineageTag: 7694114d-87f7-56ab-9062-9330c75861da

	/// Pontos que as obras pendentes no mês de referência perderam na dimensão da linha (dItemNota[Dimensao]). Somadas as quatro, dá [Nota · item · perdidos · ref].
	measure 'T1 · Pesa · perdidos das obras pendentes' =
			VAR _mes = [Mês de referência]
			VAR _obras = CALCULATETABLE ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
			RETURN
			    IF (
			        HASONEVALUE ( dItemNota[Dimensao] ),
			        SUMX ( _obras, IF ( [Nota · pendente · ranking · ref] == 1, [Nota · item · perdidos · ref] ) )
			    )
		formatString: 0.00
		displayFolder: T1 Visão geral\Onde a carteira perde pontos\Contas
		lineageTag: 7b15f200-28b4-556b-a025-bb5ff532de87

	/// Ordem da dimensão no painel 'Onde a carteira perde pontos' (eixo dItemNota[Dimensao], mês de referência): mais pontos perdidos somados primeiro; empate: a dimensão com dado antes da que falta em todas as obras, depois a ordem da dimensão na régua.
	measure 'T1 · Pesa · posição' =
			VAR _p = [Nota · item · perdidos · ref] + 0
			VAR _t = INT ( NOT ISBLANK ( [Nota · item · possíveis · ref] ) )
			VAR _ord = SELECTEDVALUE ( dItemNota[OrdemDimensao] )
			VAR _todos =
			    ADDCOLUMNS (
			        ALL ( dItemNota[Dimensao], dItemNota[OrdemDimensao] ),
			        "@p", [Nota · item · perdidos · ref] + 0,
			        "@t", INT ( NOT ISBLANK ( [Nota · item · possíveis · ref] ) )
			    )
			VAR _antes =
			    COUNTROWS (
			        FILTER (
			            _todos,
			            [@p] > _p
			                || ( [@p] = _p && [@t] > _t )
			                || ( [@p] = _p && [@t] = _t && dItemNota[OrdemDimensao] < _ord )
			        )
			    )
			RETURN
			    IF ( HASONEVALUE ( dItemNota[Dimensao] ), _antes + 1 )
		formatString: 0
		displayFolder: T1 Visão geral\Onde a carteira perde pontos\Contas
		lineageTag: 8216bca6-fefb-52f3-a3bc-0aa36ab1e3a7

	/// CSS da faixa-síntese (leitura do mês).
	measure 'T1 · Síntese · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".si{position:fixed;inset:0}.si .vs{left:24px;top:16px;color:rgba(233,224,207,.7)}.si .tx{position:absolute;left:24px;top:37px;width:956px;font-size:15px;line-height:21px;color:#F7F"
			    & "4EE}.si .tx.t3{top:34px;font-size:14px;line-height:19px}"
		displayFolder: T1 Visão geral\Síntese
		lineageTag: 5e021202-055e-58f5-84b3-a6ce6e65e21b

	/// Leitura do mês na faixa preta, pela nota: as obras críticas (até 3, com a nota e, se for o caso, a trava) e quantas estão em atenção, estáveis e pendentes; depois a obra que mais perde pontos no mês e os dois itens em que mais perde (pontos de possíveis). Com todas pendentes, diz que falta item na base e quem mais perde nos itens que já dá para calcular.
	measure 'T1 · Síntese · HTML' =
			-- 1 · Leituras
			VAR _mesC = [Mês de referência · curto]
			VAR _mesCM = [Mês de referência · curto maiúsculo]
			VAR _c = [Nota · carteira · obras críticas · ref] + 0
			VAR _a = [Nota · carteira · obras em atenção · ref] + 0
			VAR _e = [Nota · carteira · obras estáveis · ref] + 0
			VAR _p = [Nota · carteira · obras pendentes · ref] + 0
			VAR _listaCrit = [Nota · recorte · obras críticas (lista)]
			VAR _ranking = [Nota · recorte · obras por pontos perdidos (lista)]
			VAR _o1 = PATHITEM ( _ranking, 1 )
			VAR _perd1 = CALCULATE ( [Nota · pontos perdidos · ranking · ref], dObra[Obra] = _o1 )
			VAR _pend1 = CALCULATE ( [Nota · pendente · ranking · ref], dObra[Obra] = _o1 )
			VAR _poss1 = CALCULATE ( [Nota · pontos possíveis · ranking · ref], dObra[Obra] = _o1 )
			VAR _c1 = PATHITEM ( _listaCrit, 1 )
			VAR _c1Nota = CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _c1 )
			VAR _c1Trv = CALCULATE ( [Nota · trava · motivo · ref], dObra[Obra] = _c1 ) & ""
			VAR _c1Fr = IF ( _c1 = "", "", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c1, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " (" & IF ( 1 = 1, "nota ", "" ) & "⁅" & FORMAT ( _c1Nota, "0.0#", "pt-BR" ) & "⁆" & IF ( _c1Trv = "", "", ", trava de " & SUBSTITUTE ( _c1Trv, "|", " e " ) ) & ")" )
			VAR _c2 = PATHITEM ( _listaCrit, 2 )
			VAR _c2Nota = CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _c2 )
			VAR _c2Trv = CALCULATE ( [Nota · trava · motivo · ref], dObra[Obra] = _c2 ) & ""
			VAR _c2Fr = IF ( _c2 = "", "", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c2, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " (" & IF ( 2 = 1, "nota ", "" ) & "⁅" & FORMAT ( _c2Nota, "0.0#", "pt-BR" ) & "⁆" & IF ( _c2Trv = "", "", ", trava de " & SUBSTITUTE ( _c2Trv, "|", " e " ) ) & ")" )
			VAR _c3 = PATHITEM ( _listaCrit, 3 )
			VAR _c3Nota = CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _c3 )
			VAR _c3Trv = CALCULATE ( [Nota · trava · motivo · ref], dObra[Obra] = _c3 ) & ""
			VAR _c3Fr = IF ( _c3 = "", "", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c3, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " (" & IF ( 3 = 1, "nota ", "" ) & "⁅" & FORMAT ( _c3Nota, "0.0#", "pt-BR" ) & "⁆" & IF ( _c3Trv = "", "", ", trava de " & SUBSTITUTE ( _c3Trv, "|", " e " ) ) & ")" )
			VAR _iL = CALCULATE ( [T1 · Obras · itens que mais perdem (lista) · ref], dObra[Obra] = _o1 ) & ""
			VAR _ofB = [T1 · Obras · com item faltando na base (lista) · ref] & ""
			VAR _ofP = [T1 · Obras · com item faltando na planilha (lista) · ref] & ""
			VAR _ofF = [T1 · Obras · com item fora da faixa (lista) · ref] & ""
			VAR _ofNB = IF ( _ofB = "", 0, PATHLENGTH ( _ofB ) )
			VAR _ofNP = IF ( _ofP = "", 0, PATHLENGTH ( _ofP ) )
			VAR _ofNF = IF ( _ofF = "", 0, PATHLENGTH ( _ofF ) )
			VAR _ofP1 = PATHITEM ( _ofP, 1 ) & ""
			VAR _ofF1 = PATHITEM ( _ofF, 1 ) & ""
			VAR _onde =
			    SWITCH (
			        TRUE (),
			        _ofNB > 0 && _ofNP > 0 && _ofB = _ofP, "na base complementar e na planilha",
			        _ofNB > 0 && _ofNP = 1, "na base complementar (na " & _ofP1
			            & IF ( PATHCONTAINS ( _ofB, _ofP1 ), ", também na planilha)", ", só na planilha)" ),
			        _ofNB > 0 && _ofNP > 1, "na base complementar (na planilha, em " & _ofNP & " obras)",
			        _ofNP > 0, "na planilha",
			        "na base complementar"
			    )
			VAR _ondeFora = SWITCH ( TRUE (), _ofNF = 0, "", _ofNF = 1, "; na " & _ofF1 & ", há valor fora da faixa", "; em " & _ofNF & " obras, há valor fora da faixa" )
			VAR _ondeSoFora = _ofNB + _ofNP = 0 && _ofNF > 0
			VAR _iN = IF ( _iL = "", 0, PATHLENGTH ( _iL ) )
			VAR _i1Cod = PATHITEM ( _iL, 1 ) & ""
			VAR _i1Frase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i1Cod )
			VAR _i1Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Item] = _i1Cod, dObra[Obra] = _o1 )
			VAR _i1Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Item] = _i1Cod, dObra[Obra] = _o1 )
			VAR _i1Fr = IF ( _i1Cod = "", "", SWITCH ( TRUE (), LEFT ( _i1Frase, 3 ) = "os ", "nos " & MID ( _i1Frase, 4, 99 ), LEFT ( _i1Frase, 3 ) = "as ", "nas " & MID ( _i1Frase, 4, 99 ), LEFT ( _i1Frase, 2 ) = "o ", "no " & MID ( _i1Frase, 3, 99 ), LEFT ( _i1Frase, 2 ) = "a ", "na " & MID ( _i1Frase, 3, 99 ), "em " & _i1Frase ) & " (" & "⁅" & FORMAT ( _i1Pts, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _i1Poss, "0.0#", "pt-BR" ) & "⁆" & ")" )
			VAR _i2Cod = PATHITEM ( _iL, 2 ) & ""
			VAR _i2Frase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i2Cod )
			VAR _i2Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Item] = _i2Cod, dObra[Obra] = _o1 )
			VAR _i2Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Item] = _i2Cod, dObra[Obra] = _o1 )
			VAR _i2Fr = IF ( _i2Cod = "", "", SWITCH ( TRUE (), LEFT ( _i2Frase, 3 ) = "os ", "nos " & MID ( _i2Frase, 4, 99 ), LEFT ( _i2Frase, 3 ) = "as ", "nas " & MID ( _i2Frase, 4, 99 ), LEFT ( _i2Frase, 2 ) = "o ", "no " & MID ( _i2Frase, 3, 99 ), LEFT ( _i2Frase, 2 ) = "a ", "na " & MID ( _i2Frase, 3, 99 ), "em " & _i2Frase ) & " (" & "⁅" & FORMAT ( _i2Pts, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _i2Poss, "0.0#", "pt-BR" ) & "⁆" & ")" )
			-- 2 · Textos
			VAR _frasesCrit = IF ( _c1Fr <> "", IF ( 1 = 1, "", IF ( 1 = MIN ( _c, 3 ), " e ", ", " ) ) & _c1Fr, "" ) & IF ( _c2Fr <> "", IF ( 2 = 1, "", IF ( 2 = MIN ( _c, 3 ), " e ", ", " ) ) & _c2Fr, "" ) & IF ( _c3Fr <> "", IF ( 3 = 1, "", IF ( 3 = MIN ( _c, 3 ), " e ", ", " ) ) & _c3Fr, "" ) & IF ( _c > 3, " e mais " & "⁅" & ( _c - 3 ) & "⁆", "" )
			VAR _tA = IF ( _a > 0, "⁅" & _a & "⁆" & " em atenção" )
			VAR _tE = IF ( _e > 0, "⁅" & _e & "⁆" & IF ( _e = 1, " estável", " estáveis" ) )
			VAR _tP = IF ( _p > 0, "⁅" & _p & "⁆" & IF ( _p = 1, " pendente", " pendentes" ) )
			VAR _nOutros = INT ( _a > 0 ) + INT ( _e > 0 ) + INT ( _p > 0 )
			VAR _txtOutros =
			    SWITCH (
			        _nOutros,
			        0, "",
			        1, _tA & _tE & _tP,
			        2, IF ( _a > 0, _tA & " e " & _tE & _tP, _tE & " e " & _tP ),
			        _tA & ", " & _tE & " e " & _tP
			    )
			VAR _txtAbre =
			    SWITCH (
			        TRUE (),
			        _c + _a + _e + _p = 0, "Nenhuma obra com planilha em " & _mesC & ".",
			        _c + _a + _e = 0, IF ( _p = 1, "A obra está pendente em ", "As " & "⁅" & _p & "⁆" & " obras estão pendentes em " )
			            & _mesC & ", sem nota: " & IF ( _ondeSoFora, "há valor fora da faixa na base complementar", "falta item " & _onde & _ondeFora ) & ".",
			        _c = 0, "Nenhuma obra crítica em " & _mesC & ": " & _txtOutros & ".",
			        IF ( _c = 1, "1 obra crítica em ", "⁅" & _c & "⁆" & " obras críticas em " ) & _mesC & ": " & _frasesCrit
			            & IF ( _txtOutros = "", ".", "; " & _txtOutros & "." )
			    )
			VAR _txtPerde =
			    SWITCH (
			        TRUE (),
			        _o1 = "", "",
			        NOT ( _perd1 > 0 ), " Nenhuma obra perdeu pontos nos itens com dado.",
			        IF ( _c + _a + _e = 0, " No que já dá para calcular, quem mais perde é a ", " Quem mais perde pontos é a " )
			            & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _o1, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " (" & "⁅" & FORMAT ( _perd1, "0.0#", "pt-BR" ) & "⁆" & IF ( _pend1 = 1, " dos " & "⁅" & FORMAT ( _poss1, "0.0#", "pt-BR" ) & "⁆" & " possíveis", "" ) & ")"
			            & ", mais " & SWITCH ( _iN, 1, _i1Fr, 2, _i1Fr & " e " & _i2Fr, "em " & "⁅" & _iN & "⁆" & " itens empatados" ) & "."
			    )
			VAR _txtSin = _txtAbre & _txtPerde
			VAR _nSin = LEN ( SUBSTITUTE ( SUBSTITUTE ( _txtSin, "⁅", "" ), "⁆", "" ) )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u si escuro'><p class='ab vs'>LEITURA DE " & _mesCM & "</p>"
			        & "<p class='tx" & IF ( _nSin > 245, " t3", "" ) & "'>" & _txtSin & "</p>"
			    & "</div>" & [Comum · JS contador]
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T1 Visão geral\Síntese
		lineageTag: dafdaa3c-5541-5c9b-9c14-6e0a9ce29268

	/// CSS dos tooltips de página v2 da Tela 01 (cartão offwhite de cantos retos, cabeçalho preto de 72 com a meta em flex-wrap, corpo em fluxo e pé preso à base). Candidato a substituir o [Comum · CSS tooltip] (v1, usado pelas outras telas) quando a camada comum passar para a v2.
	measure 'T1 · CSS tooltip' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".tt{position:fixed;inset:0;display:flex;flex-direction:column;background:#FFFFFF;border:1px solid #0B0B0C;border-radius:0;overflow:hidden}.tt .cab{flex:none;display:flex;flex-wrap:"
			    & "wrap;align-items:baseline;column-gap:24px;row-gap:6px;padding:14px 20px 13px;background:#0B0B0C}.tt .cab>.vs:first-child{flex:0 0 100%;margin-bottom:-2px;color:rgba(233,224,207,.7)"
			    & "}.tt .cab .tit{display:flex;align-items:baseline;gap:8px;white-space:nowrap;min-width:0}.tt .cab .tit b{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:21px;"
			    & "line-height:26px;color:#F7F4EE}.tt .cab .tit em{font-style:normal;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:12px;line-height:15px;letter-spacing:1.2px;"
			    & "color:rgba(233,224,207,.6)}.tt .cab .tit .selo-i{border-color:rgba(233,224,207,.6);color:rgba(233,224,207,.85)}.tt .cab .tit .selo-r{background:#E9E0CF;color:#0B0B0C}.tt .cab .vs.d"
			    & "ir{margin-left:auto;line-height:16px;white-space:nowrap;color:rgba(233,224,207,.85)}.tt .corpo{flex:1;min-height:0;position:relative;margin:16px 20px 0;overflow:hidden}.tt .pe{flex"
			    & ":none;margin:0 20px 16px}.tt .pe .rg{margin:0 0 11px}.tt .bh{display:flex;justify-content:space-between;margin-bottom:8px}.tt .pe .bh{margin-bottom:0}.tt .rg{height:1px;background:"
			    & "#E1E1E1;margin:12px 0}.tt .tx{font-size:15px;line-height:21px;color:#0B0B0C}.tt .vs{display:block}.tt .tab{display:grid;grid-template-columns:max-content max-content 1fr max-conten"
			    & "t;column-gap:16px;align-items:center;white-space:nowrap}.tt .lin{display:grid;align-items:center;height:28px;white-space:nowrap}.tt .tab .lin{display:contents}.tt .tab .lin>span{di"
			    & "splay:block;height:28px;line-height:28px;min-width:0}.tt .tab .lin>.n{display:flex;align-items:center;gap:6px}.tt .lin .n{font-size:15px;font-weight:600}.tt .lin .n .mk{flex:none}."
			    & "tt .lin .v{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px}.tt .lin .d{font-size:14px;color:#3B3B3F;overflow:hidden;text-overflow:ellipsis}.tt .tab .lin"
			    & ">.d{display:flex;align-items:center;white-space:normal;line-height:14px}.tt .lin .p{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;text-align:right}.tt"
			    & " .lin .p em{font-style:normal;color:#6B6B70;margin-left:4px}.tt .lin .p.z{color:#6B6B70}.tt .lin.est .v{color:#3B3B3F}.tt i.vz{display:block;font-style:normal;color:#6B6B70;font-si"
			    & "ze:14px;line-height:25px}.tt .tab i.vz{grid-column:1/-1;padding-left:17px;line-height:27px}.tt .rod{margin-top:4px;font-size:15px;line-height:21px;white-space:nowrap;overflow:hidde"
			    & "n;text-overflow:ellipsis}.tt .rod.r2{white-space:normal;min-height:42px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}@keyframes ttFim{from{opacity:0}}.tt .f"
			    & "im{animation:ttFim .2s ease-out backwards}@media (prefers-reduced-motion:reduce){.tt .fim{animation:none}}"
