	/// Subtítulo da Linha do tempo das obras, Figma 387:4421 (a legenda da faixa fica no pé do gráfico; F3: a marca do término projetado e a faixa dos 180 dias de tolerância).
	measure 'T3 · Linha do tempo · HTML cabeçalho' =
			-- 4 · Marcação
			"<div class='u pc'><span class='sub'>início → término previsto · preenchido = executado · ◆ = término projetado · hachura = 180 dias após a entrega</span></div>"
		displayFolder: T3 Avanço físico\Linha do tempo das obras
		lineageTag: f53fe708-9052-527c-b3f1-207799f6155a

	/// Grade da Linha do tempo das obras (Figma 289:7417): anos do primeiro ao último da carteira (o último inclui o término projetado e os 180 dias de tolerância), a linha e o selo do mês de referência e, no pé, a legenda: a cor do executado pelos pontos do item prazo da nota (primeira e última faixa lidas do modelo), a marca do término projetado e a faixa dos 180 dias depois da entrega. Fica por baixo das linhas das obras.
	measure 'T3 · Linha do tempo · HTML grade' =
			-- 1 · Leituras
			VAR _pi = [T3 · Linha do tempo · primeiro início]
			VAR _ut = [T3 · Linha do tempo · último término]
			VAR _ref = [Mês de referência]
			VAR _refCM = [Mês de referência · curto maiúsculo]
			-- 2 · Textos
			VAR _fx = SUBSTITUTE ( CALCULATE ( [Nota · item · faixas], dItemNota[Item] = "prazo" ), " · ", "|" )
			VAR _fxa = PATHITEM ( _fx, 1 )
			VAR _fxz = PATHITEM ( _fx, PATHLENGTH ( _fx ) )
			VAR _fx1 = SUBSTITUTE ( SUBSTITUTE ( _fxa, "<", "&lt;" ), ">", "&gt;" )
			VAR _fxN = SUBSTITUTE ( SUBSTITUTE ( _fxz, "<", "&lt;" ), ">", "&gt;" )
			VAR _fx1s = SUBSTITUTE ( SUBSTITUTE ( LEFT ( _fxa, SEARCH ( " →", _fxa, 1, LEN ( _fxa ) + 1 ) - 1 ), "<", "&lt;" ), ">", "&gt;" )
			VAR _fxNs = SUBSTITUTE ( SUBSTITUTE ( LEFT ( _fxz, SEARCH ( " →", _fxz, 1, LEN ( _fxz ) + 1 ) - 1 ), "<", "&lt;" ), ">", "&gt;" )
			-- 3 · Geometria
			VAR _y0 = YEAR ( _pi ) + IF ( MONTH ( _pi ) = 1, 0, 1 ) -- geometria
			VAR _y1 = YEAR ( _ut ) + 1 -- geometria
			VAR _pxm = DIVIDE ( 723.60, ( _y1 - _y0 ) * 12 ) /* geometria */
			VAR _jan0 = DATE ( _y0, 1, 1 ) -- geometria
			VAR _xRef = ROUND ( 152.24 + ( DATEDIFF ( _jan0, _ref, MONTH ) + 0.5 ) * _pxm, 0 ) -- geometria
			-- 4 · Marcação
			VAR _anos =
			    CONCATENATEX (
			        GENERATESERIES ( _y0, _y1 ),
			        VAR _x = ROUND ( 152.24 + ( [Value] - _y0 ) * 12 * _pxm, 0 ) /* geometria */
			        RETURN
			            "<i class='gl a-fd' style='left:" & _x & "px'></i>"
			                & IF ( ABS ( _x - _xRef ) < 52, "", "<span class='an a-fd' style='left:" & ( _x - 20 ) & "px'>" & [Value] & "</span>" ),
			        "",
			        [Value], ASC
			    )
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _pi ),
			        "<div class='u lg'>" & _anos
			            & "<i class='gl ref a-gy' style='left:" & _xRef & "px;animation-delay:300ms'></i>"
			            & "<span class='bd a-fd' style='left:" & _xRef & "px;animation-delay:500ms'>" & _refCM & "</span>"
			            & "<p class='le'>executado:<span><i class='mk mk0'></i>" & "⁅" & _fx1s & "⁆" & "</span><span><i class='mk mk1'></i>"
			            & "perde parte</span><span><i class='mk mk2'></i>" & "⁅" & _fxNs & "⁆" & "</span><span><i class='mk mkx'></i>sem curva"
			            & "</span><span><i class='tp'></i>término projetado</span><span><i class='tl'></i>tolerância de 180 "
			            & "dias</span></p>"
			        & "</div>" & [Comum · JS contador]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Linha do tempo das obras
		lineageTag: 3c128e27-d5bb-5ce1-9427-5516eff6f433

	/// Uma linha por obra em andamento e a iniciar (granularidade dObra[Obra], ordem T3 · Linha do tempo · posição): nome, a faixa hachurada dos 180 dias depois da entrega contratual (por baixo), barra do início ao término previsto, preenchimento do executado (cor pelos pontos do item prazo da nota: cheio sálvia, perde parte ocre, zera vermelho; grafite sem curva prevista), traço do previsto (só quando a aba traz o previsto) e o losango do término projetado na cor de onde cai (até a entrega sálvia, nos 180 dias ocre, depois vermelho); as a iniciar só com o contorno tracejado. A barra corre do início ao término, o executado corre em seguida e o losango aparece no fim.
	measure 'T3 · Linha do tempo · HTML obra' =
			-- 1 · Leituras
			VAR _pos = [T3 · Linha do tempo · posição]
			VAR _sit = [T3 · Obra · situação]
			VAR _obra = [Obra · nome]
			VAR _ini = [Obra · início]
			VAR _fim = [Obra · término previsto]
			VAR _pi = [T3 · Linha do tempo · primeiro início]
			VAR _ut = [T3 · Linha do tempo · último término]
			VAR _e = [Físico · executado acumulado · ref]
			VAR _p = [Físico · previsto acumulado · ref]
			VAR _pt = [Nota · pontos prazo · ref]
			VAR _ps = [Nota · possíveis · prazo · ref]
			VAR _proj = [Prazo · término projetado · ref]
			VAR _ent = [Prazo · entrega contratual]
			VAR _sitT = [T3 · Término · situação · ref]
			VAR _nAnd = [Obras com análise · ref]
			VAR _nL = [T3 · Linha do tempo · linhas]
			-- 2 · Textos
			VAR _chave = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
			VAR _aIniciar = _sit = "A iniciar"
			VAR _clsFl = "s" & IF ( ISBLANK ( _pt ), "x", IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) )
			-- 3 · Geometria
			VAR _y0 = YEAR ( _pi ) + IF ( MONTH ( _pi ) = 1, 0, 1 ) -- geometria
			VAR _y1 = YEAR ( _ut ) + 1 -- geometria
			VAR _pxm = DIVIDE ( 723.60, ( _y1 - _y0 ) * 12 ) /* geometria */
			VAR _jan0 = DATE ( _y0, 1, 1 ) -- geometria
			VAR _x = ROUND ( 152.24 + DATEDIFF ( _jan0, _ini, MONTH ) * _pxm, 0 ) -- geometria
			VAR _w = ROUND ( ( DATEDIFF ( _ini, _fim, MONTH ) + 1 ) * _pxm, 0 ) -- geometria
			VAR _wf = ROUND ( _w * MIN ( _e, 1 ), 0 ) -- geometria
			VAR _xp = _x + ROUND ( _w * MIN ( _p, 1 ), 0 ) - 1 -- geometria
			VAR _xEnt = ROUND ( 152.24 + ( DATEDIFF ( _jan0, _ent, MONTH ) + 1 ) * _pxm, 0 ) -- geometria
			VAR _wTol = ROUND ( 6 * _pxm, 0 ) -- geometria
			VAR _xProj = ROUND ( 152.24 + ( DATEDIFF ( _jan0, _proj, MONTH ) + 1 ) * _pxm, 0 ) -- geometria
			VAR _ordem = IF ( _pos >= 100, _nAnd + _pos - 99, _pos ) -- geometria
			VAR _atraso = ( _ordem - 1 ) * 60 -- geometria
			/* F4: a linha k ocupa de INT((k−1)·A/n) a INT(k·A/n), até o teto por linha; --k em centésimos da linha de antes */
			VAR _hU = MIN ( 46, DIVIDE ( 230, MAX ( 1, _nL ) ) ) -- geometria
			VAR _h = INT ( _ordem * _hU ) - INT ( ( _ordem - 1 ) * _hU ) -- geometria
			VAR _k = ROUND ( _hU / 23 * 100, 0 ) -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _pos ) && NOT ISBLANK ( _ini ) && NOT ISBLANK ( _fim ),
			        "<div class='u lt" & IF ( _aIniciar, " ai", "" ) & "' style='height:" & _h & "px;--k:" & _k & "'>"
			            & "<b class='nm'>" & _chave & "</b>"
			            & IF ( ISBLANK ( _ent ), "", "<i class='tl a-gx' style='left:" & _xEnt & "px;width:" & _wTol
			                & "px;animation-delay:" & ( _atraso + 300 ) & "ms'></i>" )
			            & "<i class='tk' style='left:" & _x & "px;width:" & _w & "px' data-rk='t|" & _chave & "' data-rd='"
			            & _atraso & "'></i>"
			            & IF (
			                NOT _aIniciar && NOT ISBLANK ( _e ),
			                "<i class='fl " & _clsFl & "' style='left:" & _x & "px;width:" & _wf & "px' data-rk='f|" & _chave
			                    & "' data-rd='" & ( _atraso + 500 ) & "'></i>"
			                    & IF ( NOT ISBLANK ( _p ), "<i class='pv a-pop' style='left:" & _xp & "px;animation-delay:" & ( _atraso + 1000 ) & "ms'></i>" )
			            )
			            & IF ( _aIniciar || ISBLANK ( _proj ), "", "<i class='tp a-pop t" & _sitT & "' style='left:" & ( _xProj - 6 ) & "px;animation-delay:" & ( _atraso + 1200 ) & "ms'></i>" )
			        & "</div>" & [Comum · JS corrida]
			    )
		displayFolder: T3 Avanço físico\Linha do tempo das obras
		lineageTag: d1c8bba6-ad83-5663-a335-03ea06f83216

	/// Versão da cronograma dos campos do cadastro, em mês e ano curtos (abr/26), a partir de dObra[VersaoCrono] (MM/AAAA da planilha de versão mais recente). Vazio sem cronograma.
	measure 'T3 · cronograma · versão' =
			VAR _v = FIRSTNONBLANK ( dObra[VersaoCrono], 1 )
			RETURN
			    IF (
			        ISBLANK ( _v ),
			        BLANK (),
			        MID (
			            "janfevmarabrmaijunjulagosetoutnovdez",
			            ( VALUE ( LEFT ( _v, 2 ) ) - 1 ) * 3 + 1,
			            3
			        ) & "/" & RIGHT ( _v, 2 )
			    )
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: 4cce1345-19eb-5c72-8cc6-733654245297

	/// Anos de término das [T3 · Linha do tempo · obras com atraso cedo (lista)], sem repetir, separados por '|'.
	measure 'T3 · Linha do tempo · anos de término com atraso cedo (lista)' =
			VAR _ref = [Mês de referência]
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			VAR _anos = DISTINCT ( SELECTCOLUMNS ( FILTER ( _obras, [@d] < 0 && [@fim] >= EDATE ( _ref, 24 ) ), "@a", YEAR ( [@fim] ) ) )
			RETURN
			    CONCATENATEX ( _anos, [@a], "|", [@a], ASC )
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: 5045b64b-dfe5-5e74-b9d3-ae05b21e8d41

	/// Quantas obras a Linha do tempo desenha no recorte do visual (posição, início e término preenchidos): a altura de cada linha sai daí (F4, a lista ocupa o painel inteiro).
	measure 'T3 · Linha do tempo · linhas' =
			VAR _obras =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@pos", [T3 · Linha do tempo · posição],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto]
			        ),
			        ALLSELECTED ( dObra[Obra] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _obras, NOT ISBLANK ( [@pos] ) && NOT ISBLANK ( [@ini] ) && NOT ISBLANK ( [@fim] ) ) ) + 0
		formatString: 0
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: 91eaecea-a1d7-5b9b-97cb-90fd7715cee0

	/// Maior orçamento entre as obras em andamento (aba do mês de referência).
	measure 'T3 · Linha do tempo · maior orçamento' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
			            "@ini", [Obra · início],
			            "@fim", [Obra · término previsto],
			            "@orc", [Orçamento · ref],
			            "@tipo", [Tipo de orçamento · ref]
			        ),
			        NOT ISBLANK ( [@e] )
			    )
			VAR _top = TOPN ( 1, FILTER ( _obras, TRUE () ), [@orc], DESC, dObra[Obra], ASC )
			RETURN
			    MAXX ( _top, [@orc] )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: d67e4da4-81a2-5f3c-9995-d8f9d3f48439

