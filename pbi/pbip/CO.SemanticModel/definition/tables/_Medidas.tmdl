	/// Obras do recorte que tiveram justificativa exigida na janela e não preencheram nenhuma, da que mais deixou em branco para a que menos, separadas por '|'.
	measure 'T4 · Leitura desembolso · obras sem nenhuma justificativa (lista)' =
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@e", [T4 · Obra · justificativas exigidas no período],
