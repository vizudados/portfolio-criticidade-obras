	/// Das obras com aplicado negativo no mês de referência, quantas fecharam abaixo do mês anterior ('pesam cada vez mais').
	measure 'T4 · Leitura mês · negativas que caíram' =
			VAR _mes = [Mês de referência]
			VAR _obras = CALCULATETABLE (
