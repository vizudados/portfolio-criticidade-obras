	/// Aprovação na 1.ª inspeção da obra em destaque no mês de referência. Ex. set/26: 89,6% (REDINHA).
	measure 'T5 · Leitura qualidade · aprovação da obra em destaque · ref' =
			VAR _obra = [T5 · Qualidade · obra em destaque · ref]
