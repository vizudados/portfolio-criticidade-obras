	/// Status do físico pelo item prazo da Nota da obra, na obra e no mês do contexto: 0 quando o atraso em meses fica dentro da faixa cheia (ganha todos os pontos), 2 quando perde pontos; vazio sem curva prevista ou sem aba. Compara os pontos do item com o máximo dele ([T3 · Prazo · máximo na nota]), sem limite escrito. Uma obra no contexto.
	measure 'T3 · Status desvio físico' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),
			    VAR _pts = [Nota · pontos prazo]
			    RETURN
			        IF ( NOT ISBLANK ( _pts ), IF ( _pts < [T3 · Prazo · máximo na nota], 2, 0 ) )
			)
		formatString: 0
		displayFolder: T3 Avanço físico\Foco no mês\Contas
		lineageTag: 2e3b84c2-48a2-52a0-b3e8-ff2a72fdf283

