	/// Justificativas da planilha nos meses em que o desembolso passou do previsto (série da obra do contexto, na janela), agrupadas pelo texto, da mais repetida à menos: texto § meses, separadas por '|'.
	measure 'T3 · Justificativas · grupos (lista)' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@d", VAR _m = dMes[Mes] RETURN CALCULATE ( [Desembolso · desvio no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@j", VAR _m = dMes[Mes] RETURN CALCULATE ( TRIM ( [Justificativa do desembolso] ), REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			VAR _acima = FILTER ( _meses, [@d] > 0 && [@j] <> "" )
			VAR _textos = DISTINCT ( SELECTCOLUMNS ( _acima, "@t", [@j] ) )
			VAR _cont = ADDCOLUMNS ( _textos, "@n", VAR _t = [@t] RETURN COUNTROWS ( FILTER ( _acima, [@j] = _t ) ) )
			RETURN
			    CONCATENATEX ( _cont, SUBSTITUTE ( SUBSTITUTE ( [@t], "|", "/" ), "§", "" ) & "§" & [@n], "|", [@n], DESC, [@t], ASC )
		displayFolder: T3 Avanço físico\Leituras\Contas
		lineageTag: d285c651-2131-515b-bd1a-bedcbca58ca9

	/// [T3 · Justificativas · grupos (lista)] da obra em foco.
	measure 'T3 · Justificativas · grupos (lista) · foco' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    CALCULATE ( [T3 · Justificativas · grupos (lista)], dObra[Obra] = _obra )
		displayFolder: T3 Avanço físico\Leituras\Contas
		lineageTag: 986e472c-d7f3-5a81-99ad-d2d14baf3d37

	/// Meses da série da obra do contexto, na janela, em que o desembolso passou do previsto.
	measure 'T3 · Justificativas · meses acima do previsto' =
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _meses =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
			        "@d", VAR _m = dMes[Mes] RETURN CALCULATE ( [Desembolso · desvio no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _m ),
			        "@j", VAR _m = dMes[Mes] RETURN CALCULATE ( TRIM ( [Justificativa do desembolso] ), REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _meses, [@d] > 0 ) ) + 0
		formatString: 0
		displayFolder: T3 Avanço físico\Leituras\Contas
		lineageTag: 3fbac739-dbab-55b6-9f9c-e7358bc52f1d

