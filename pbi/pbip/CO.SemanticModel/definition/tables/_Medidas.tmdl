	/// 1 quando o mês do eixo está na janela (do primeiro mês da janela à referência) e a obra do contexto tem aba nele; vazio fora da série (L044).
	measure 'T3 · Série · mês na série' =
			VAR _mes = MAX ( dMes[Mes] )
			VAR _tem = NOT ISBLANK ( [Físico · executado acumulado] )
			RETURN
			    IF ( _mes >= [Série · primeiro mês] && _mes <= [Mês de referência] && _tem, 1 )
		formatString: 0
		displayFolder: T3 Avanço físico\Série\Contas
		lineageTag: d6fae5e2-c4b8-55d2-a667-067de1179138

