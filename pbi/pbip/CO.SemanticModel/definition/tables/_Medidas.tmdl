	/// Primeiro mês com aba da obra do contexto em todo o histórico até a referência (não depende da janela): é o 'PRIMEIRA ABA DA OBRA' do tooltip.
	measure 'T3 · Obra · primeira aba' =
			VAR _ref = [Mês de referência]
			RETURN
			    CALCULATE ( MIN ( fAnaliseCritica[Mes] ), REMOVEFILTERS ( dMes ), dMes[Mes] <= _ref )
