	/// Meses decorridos − meses agregados, arredondado em 8 casas: quantos meses a obra está atrás do cronograma (negativo: adiantada). Uma obra com aba.
	measure 'Prazo · atraso (meses)' =
			VAR _d = [Prazo · meses decorridos]
			VAR _a = [Prazo · meses agregados]
			RETURN
			    IF ( NOT ISBLANK ( _d ) && NOT ISBLANK ( _a ), ROUND ( _d - _a, 8 ) )
		formatString: 0.0
		displayFolder: Base\Prazo
		lineageTag: ae1aacc1-8822-5ebe-b5a0-3c8f01c5f0a9

	/// Atraso em meses das obras do recorte com aba, ponderado pelo orçamento (na obra, o atraso dela).
	measure 'Prazo · atraso médio (meses)' =
			VAR _t =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ),
			        "@a", [Prazo · atraso (meses)],
			        "@o", [Orçamento]
			    )
			VAR _v = FILTER ( _t, NOT ISBLANK ( [@a] ) )
			RETURN
			    IF ( NOT ISEMPTY ( _v ), DIVIDE ( SUMX ( _v, [@a] * [@o] ), SUMX ( _v, [@o] ) ) )
		formatString: 0.0
		displayFolder: Base\Prazo
		lineageTag: 9f376a28-318a-5110-b853-36c23824293e

	/// Entrega contratual + 180 dias (6 meses) de tolerância (art. 43-A da Lei 4.591/64). Uma obra.
	measure 'Prazo · entrega com tolerância' =
			VAR _e = SELECTEDVALUE ( dObra[EntregaContratual] )
			RETURN
			    IF ( NOT ISBLANK ( _e ), EDATE ( _e, 6 ) )
		formatString: mmm/yy
		displayFolder: Base\Prazo
		lineageTag: 7d348953-31bb-5a0a-b8c6-5ef60f3e3cca

	/// Entrega contratual da obra (cadastro). Uma obra.
	measure 'Prazo · entrega contratual' =
			SELECTEDVALUE ( dObra[EntregaContratual] )
		formatString: mmm/yy
		displayFolder: Base\Prazo
		lineageTag: b49eb9fb-d420-5e2d-95e4-4fd13853caef

	/// Meses entre o término projetado e a entrega com tolerância (negativo: o término projetado passa da tolerância).
	measure 'Prazo · folga até a tolerância (meses)' =
			VAR _t = [Prazo · término projetado]
			VAR _l = [Prazo · entrega com tolerância]
			RETURN
			    IF ( NOT ISBLANK ( _t ) && NOT ISBLANK ( _l ), DATEDIFF ( _t, _l, MONTH ) )
		formatString: 0
		displayFolder: Base\Prazo
		lineageTag: 6df2b6d8-cd9c-52a8-83e4-06e47ba3e2dd

	/// Índice de desempenho de prazo pelo cronograma agregado: meses agregados ÷ meses decorridos (Lipke, SPI(t)).
	measure 'Prazo · IDP(t)' =
			DIVIDE ( [Prazo · meses agregados], [Prazo · meses decorridos] )
		formatString: 0.00
		displayFolder: Base\Prazo
		lineageTag: 869cf868-2489-5753-a835-bd57eec37f3f

	/// Cronograma agregado (Earned Schedule, Lipke): o ponto da curva prevista da obra (fCurvaPrevista) em que o previsto acumulado iguala o executado acumulado de hoje, interpolado entre os meses. Uma obra com aba.
	measure 'Prazo · meses agregados' =
			VAR _obra = SELECTEDVALUE ( dObra[Obra] )
			VAR _e = [Físico · executado acumulado]
			VAR _curva = FILTER ( ALL ( fCurvaPrevista ), fCurvaPrevista[Obra] = _obra )
			VAR _k = MAXX ( FILTER ( _curva, fCurvaPrevista[PrevAcum] <= _e ), fCurvaPrevista[Indice] )
			VAR _pk = MAXX ( FILTER ( _curva, fCurvaPrevista[Indice] = _k ), fCurvaPrevista[PrevAcum] )
			VAR _pk1 = MAXX ( FILTER ( _curva, fCurvaPrevista[Indice] = _k + 1 ), fCurvaPrevista[PrevAcum] )
			RETURN
			    IF (
			        HASONEVALUE ( dObra[Obra] ) && NOT ISBLANK ( _e ) && NOT ISEMPTY ( fAnaliseCritica ) && NOT ISBLANK ( _k ),
			        IF ( ISBLANK ( _pk1 ) || _pk1 <= _pk, _k, _k + DIVIDE ( _e - _pk, _pk1 - _pk ) )
			    )
		formatString: 0.00
		displayFolder: Base\Prazo
		lineageTag: 30a5d461-3226-5eb2-807c-37545d287128

	/// Meses desde o início da obra até o mês do contexto, contando os dois (1 no mês de início). Uma obra com aba.
	measure 'Prazo · meses decorridos' =
			VAR _ini = SELECTEDVALUE ( dObra[Inicio] )
			VAR _mes = MAX ( dMes[Mes] )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && NOT ISBLANK ( _ini ) && NOT ISEMPTY ( fAnaliseCritica ), DATEDIFF ( _ini, _mes, MONTH ) + 1 )
		formatString: 0
		displayFolder: Base\Prazo
		lineageTag: 44c854cc-ec4d-5ea8-8fdd-24ea074085e0

	/// Término projetado (Lipke, IEAC(t)): o início mais a duração prevista ÷ IDP(t), em meses inteiros. Uma obra.
	measure 'Prazo · término projetado' =
			VAR _ini = SELECTEDVALUE ( dObra[Inicio] )
			VAR _fim = SELECTEDVALUE ( dObra[TerminoPrevisto] )
			VAR _idp = [Prazo · IDP(t)]
			VAR _dur = DATEDIFF ( _ini, _fim, MONTH ) + 1
			RETURN
			    IF ( NOT ISBLANK ( _idp ) && _idp > 0 && NOT ISBLANK ( _fim ), EOMONTH ( EDATE ( _ini, ROUNDUP ( _dur / _idp, 0 ) - 1 ), -1 ) + 1 )
		formatString: mmm/yy
		displayFolder: Base\Prazo
		lineageTag: 5d272405-2a7d-5c4a-8059-f72404ca1c49

	/// Obras críticas na nota no mês de referência, da que mais perde pontos para a que menos perde, separadas por '|'.
	measure 'Nota · recorte · obras críticas (lista)' =
			VAR _mes = [Mês de referência]
			VAR _recorte = VALUES ( dObra[Obra] )
			VAR _obras = FILTER ( dRankingNota, dRankingNota[Mes] = _mes && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte )
			RETURN
			    CONCATENATEX (
			        FILTER ( _obras, dRankingNota[Status] == 2 ),
			        dRankingNota[Obra], "|",
			        dRankingNota[Perdidos], DESC, dRankingNota[NotaOrdem], ASC, dRankingNota[Obra], ASC
			    )
		displayFolder: Base\Recorte
		lineageTag: a4057bd8-9c75-5eb1-8fdc-1e35d2ba668b

