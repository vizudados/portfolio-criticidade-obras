			    & "<span class='bt pl' style='left:108px;top:294px;width:64px;height:56px'>Pular</span>"
			    & "<span class='bt s' style='left:182px;top:300px;width:92px'>← Voltar</span>"
			    & "<span class='bt p' style='left:284px;top:300px;width:124px'>Seguir →</span>"
