	/// Custo do que já virou obra (CA): desembolsado corrigido + contas a pagar + dívida da obra − pago e não aplicado − receita de personalizações.
	measure 'Custo aplicado' =
			[Desembolsado acumulado] + [Contas a pagar] + [Dívida da obra] - [Pago e não aplicado] - [Receita de personalizações]
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
