			                _odQ,
			                IF ( [@odk] = 24, _txKN, FORMAT ( ROUND ( _txKT * [@odf] / 1000, 0 ) / POWER ( 10, _txKD ), _txKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _txN
			    )
			VAR _txOd = IF ( ISBLANK ( _x ), _txTxt, _txS & _txKOd & "%" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Canteiro conforme NR-18" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _txOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Base complementar · checklist NR-18</span></div>"
			            & "<div class='regua'><i class='mk mk0'></i><span>" & _fx1 & "</span><i class='mk mk2'></i><span>" & _fxN & "</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
