	/// Tooltip de página da obra do Avanço das obras: o mês de referência (previsto e executado, com a posição na janela 'em n meses' ou 'acima/abaixo do previsto'), a série do atraso em meses mês a mês na janela (F3; barras a partir de uma linha-base invisível, cor dos pontos do item prazo da nota no mês, x pela posição na janela, rótulo em todos os meses quando cabe, senão só referência, máximo e mínimo; as barras correm do primeiro ao último mês) e o que mudou desde o mês anterior (com a tendência do atraso ou o lado do cronograma; o status do físico é o da nota, no ponto cheio ou não). Obra sem curva prevista: o executado acumulado mês a mês no lugar do atraso e a nota 'sem curva prevista' no rodapé.
	measure 'T3 · Tooltip avanço · HTML' =
			-- 1 · Leituras
			VAR _obra = [Obra · nome]
			VAR _cod = [Obra · código]
			VAR _selo = [Obra · selo]
			VAR _ini = [Obra · início]
			VAR _fim = [Obra · término previsto]
			VAR _aba = [Aba · ref]
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _nJan = [Série · meses até a referência]
			VAR _mesCM = [Mês de referência · curto maiúsculo]
			VAR _mesAntN = [Mês anterior à referência · nome]
			VAR _pm = [Físico · previsto no mês · ref]
			VAR _em = [Físico · executado no mês · ref]
			VAR _e = [Físico · executado acumulado · ref]
			VAR _s = [T3 · Status desvio físico · ref]
			VAR _sAnt = [T3 · Status desvio físico · mês anterior · ref]
			VAR _dest = [T3 · Mês · destaque no ritmo · ref]
			VAR _abx = [T3 · Ritmo · abaixo do previsto em toda a série]
			VAR _n = [T3 · Série · meses da obra]
			VAR _pm1 = [T3 · Série · primeiro mês da obra]
			VAR _seg = [T3 · Físico · meses seguidos na faixa · ref]
			VAR _td = [T3 · Físico · tendência da distância]
			VAR _tdd = [T3 · Físico · tendência da distância desde]
			VAR _sg = [T3 · Físico · sinal · início da sequência]
			VAR _ld = [T3 · Físico · lado do cronograma · ref]
			VAR _a = [Prazo · atraso (meses) · ref]
			VAR _mMaxD = [T3 · Série · mês do maior atraso]
			VAR _mMinD = [T3 · Série · mês do menor atraso]
			VAR _mMaxE = [T3 · Série · mês do maior executado acumulado]
			VAR _mMinE = [T3 · Série · mês do menor executado acumulado]
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@pj", [Série · posição na janela],
			        "@d", [Prazo · atraso (meses)],
			        "@e", [Físico · executado acumulado],
			        "@pt", [Nota · pontos prazo],
			        "@ps", [Nota · possíveis · prazo],
			        "@ab", [Mês · abreviado]
			    )
			-- 2 · Textos
			VAR _tpmN = FORMAT ( ABS ( _pm ) * 100, "0.00", "pt-BR" )
			VAR _tpmS = IF ( ROUND ( _pm * 100, 2 ) < 0, "−", "" )
			VAR _tpmTxt = IF ( ISBLANK ( _pm ), "—", _tpmS & _tpmN & "%" )
			VAR _temN = FORMAT ( ABS ( _em ) * 100, "0.00", "pt-BR" )
			VAR _temS = IF ( ROUND ( _em * 100, 2 ) < 0, "−", "" )
			VAR _temTxt = IF ( ISBLANK ( _em ), "—", _temS & _temN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tpmKP = LEN ( _tpmN ) > 0
			VAR _tpmKN = IF ( _tpmKP, _tpmN )
			VAR _tpmKS = SUBSTITUTE ( SUBSTITUTE ( _tpmKN, ".", "" ), ",", "" )
			VAR _tpmKT = IFERROR ( VALUE ( _tpmKS ), -1 )
			VAR _tpmKOk = _tpmKP && _tpmKT >= 2 && FORMAT ( _tpmKT, REPT ( "0", LEN ( _tpmKS ) ) ) = _tpmKS
			VAR _tpmKD = IF ( CONTAINSSTRING ( _tpmKN, "," ), LEN ( _tpmKN ) - SEARCH ( ",", _tpmKN ), 0 )
			VAR _tpmKM = IF ( CONTAINSSTRING ( _tpmKN, "." ), "#,##0", "0" ) & IF ( _tpmKD > 0, "." & REPT ( "0", _tpmKD ) )
			VAR _tpmKOd =
			    IF (
			        _tpmKOk,
			        "<o-d><o-v>" & _tpmKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpmKN, FORMAT ( ROUND ( _tpmKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpmKD ), _tpmKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpmN
			    )
			VAR _tpmOd = IF ( ISBLANK ( _pm ), _tpmTxt, _tpmS & _tpmKOd & "%" )
			VAR _temKP = LEN ( _temN ) > 0
			VAR _temKN = IF ( _temKP, _temN )
			VAR _temKS = SUBSTITUTE ( SUBSTITUTE ( _temKN, ".", "" ), ",", "" )
			VAR _temKT = IFERROR ( VALUE ( _temKS ), -1 )
			VAR _temKOk = _temKP && _temKT >= 2 && FORMAT ( _temKT, REPT ( "0", LEN ( _temKS ) ) ) = _temKS
			VAR _temKD = IF ( CONTAINSSTRING ( _temKN, "," ), LEN ( _temKN ) - SEARCH ( ",", _temKN ), 0 )
			VAR _temKM = IF ( CONTAINSSTRING ( _temKN, "." ), "#,##0", "0" ) & IF ( _temKD > 0, "." & REPT ( "0", _temKD ) )
			VAR _temKOd =
			    IF (
			        _temKOk,
			        "<o-d><o-v>" & _temKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _temKN, FORMAT ( ROUND ( _temKT * [@odf] / 1000, 0 ) / POWER ( 10, _temKD ), _temKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _temN
			    )
			VAR _temOd = IF ( ISBLANK ( _em ), _temTxt, _temS & _temKOd & "%" )
			VAR _semP = ISBLANK ( _a )
			VAR _txtSob = "AVANÇO FÍSICO · " & _mesCM & IF ( ISBLANK ( _aba ), "", " · ABA " & _aba )
			VAR _txtDir = IF ( ISBLANK ( _ini ), "", "INÍCIO " & UPPER ( FORMAT ( _ini, "mmm/yy", "pt-BR" ) ) )
			    & IF ( ISBLANK ( _fim ), "", " · TÉRMINO " & UPPER ( FORMAT ( _fim, "mmm/yy", "pt-BR" ) ) )
			VAR _txtDet =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _pm ), IF ( _semP, "sem previsto na planilha", "sem previsto do mês na planilha" ),
			        _dest = "exec_min", "o mês mais fraco " & "em " & SWITCH ( _n, 0, "zero", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses",
			        _dest = "exec_max", "o melhor mês " & "em " & SWITCH ( _n, 0, "zero", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses",
			        _dest = "prev_max", "o maior previsto " & "em " & SWITCH ( _n, 0, "zero", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses",
			        _dest = "prev_min", "o menor previsto " & "em " & SWITCH ( _n, 0, "zero", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses",
			        _em > _pm, "acima do previsto",
			        _abx = 1, "abaixo do previsto desde " & FORMAT ( _pm1, "mmm/yy", "pt-BR" ),
			        ""
			    )
			VAR _txtTend =
			    SWITCH (
			        _ld,
			        -1, "; o atraso " & SWITCH ( _td, "cresce", "cresce", "cai", "vem caindo", "oscila" ) & " desde "
			            & IF ( _tdd = _jan || YEAR ( _tdd ) <> YEAR ( _ref ), FORMAT ( _tdd, "mmm/yy", "pt-BR" ), FORMAT ( _tdd, "mmmm", "pt-BR" ) ),
			        0, IF ( _sg = _pm1 && _n > 1, "; no previsto nos " & SWITCH ( _n, 0, "zero", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses", "; no previsto desde " & IF ( _sg = _jan || YEAR ( _sg ) <> YEAR ( _ref ), FORMAT ( _sg, "mmm/yy", "pt-BR" ), FORMAT ( _sg, "mmmm", "pt-BR" ) ) ),
			        1, IF ( _sg = _pm1 && _n > 1, "; à frente nos " & SWITCH ( _n, 0, "zero", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses", "; à frente desde " & IF ( _sg = _jan || YEAR ( _sg ) <> YEAR ( _ref ), FORMAT ( _sg, "mmm/yy", "pt-BR" ), FORMAT ( _sg, "mmmm", "pt-BR" ) ) ),
			        ""
			    )
			VAR _txtMudou =
			    SWITCH (
			        TRUE (),
			        _s <> _sAnt, UPPER ( LEFT ( IF ( _s = 2, "passou do limite da nota", "voltou para dentro do limite" ), 1 ) ) & MID ( IF ( _s = 2, "passou do limite da nota", "voltou para dentro do limite" ), 2, 99 ) & _txtTend & ".",
			        _seg >= _n, "Nada mudou: " & SWITCH ( _s, 2, "fora do limite", "dentro do limite" ) & " nos " & SWITCH ( _n, 0, "zero", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses" & _txtTend & ".",
			        "Nada mudou: " & SWITCH ( _s, 2, "fora do limite", "dentro do limite" ) & " desde " & IF ( EDATE ( _ref, 1 - _seg ) = _jan || YEAR ( EDATE ( _ref, 1 - _seg ) ) <> YEAR ( _ref ), FORMAT ( EDATE ( _ref, 1 - _seg ), "mmm/yy", "pt-BR" ), FORMAT ( EDATE ( _ref, 1 - _seg ), "mmmm", "pt-BR" ) ) & _txtTend & "."
			    )
			VAR _rotMudou = "O QUE MUDOU DESDE " & UPPER ( _mesAntN )
			VAR _rotGrafico = IF ( _semP, "EXECUTADO ACUMULADO, MÊS A MÊS · %", "ATRASO, MÊS A MÊS · MESES" )
			VAR _htmlRodape =
			    IF (
			        _semP,
			        "<div class='rod'><div class='r3'></div><span class='vs'>" & "SEM CURVA PREVISTA" & "</span><p class='l1'>" & "Sem a curva prevista da cronograma, o atraso em meses não sai." & "</p></div>",
			        IF ( NOT ISBLANK ( _sAnt ), "<div class='rod'><div class='r3'></div><span class='vs'>" & _rotMudou & "</span><p class='l1'>" & _txtMudou & "</p></div>" )
			    )
			VAR _cruza = YEAR ( _jan ) <> YEAR ( _ref )
			-- 3 · Geometria
			VAR _serie = FILTER ( _meses, [@ate] = 1 ) /* lista */
			VAR _com = FILTER ( _serie, NOT ISBLANK ( IF ( _semP, [@e], [@d] ) ) ) /* lista */
			VAR _temPos = _semP || COUNTROWS ( FILTER ( _com, [@d] > 0 ) ) > 0 /* geometria */
			VAR _temNeg = NOT _semP && COUNTROWS ( FILTER ( _com, [@d] < 0 ) ) > 0 /* geometria */
			VAR _modo = IF ( _temPos && _temNeg, "misto", IF ( _temPos, "positivo", "negativo" ) ) -- geometria
			VAR _base = SWITCH ( _modo, "misto", 57, "positivo", 57, 22 ) -- geometria
			VAR _yMes = SWITCH ( _modo, "misto", 96, "positivo", 63, 0 ) -- geometria
			VAR _alt = SWITCH ( _modo, "misto", 112, "positivo", 79, 83 ) -- geometria
			VAR _tetoNeg = IF ( _modo = "misto", 16, 40 ) -- geometria
			VAR _maxE = MAXX ( _com, [@e] ) /* geometria */
			VAR _slot = INT ( DIVIDE ( 560, _nJan ) ) /* geometria */
			VAR _bw = MIN ( 40, _slot - 14 ) -- geometria
			VAR _cabe = _slot >= 40 -- geometria
			VAR _mMax = IF ( _semP, _mMaxE, _mMaxD ) -- geometria
			VAR _mMin = IF ( _semP, _mMinE, _mMinD ) -- geometria
			VAR _dMaxRef = ABS ( DATEDIFF ( MIN ( _mMax, _ref ), MAX ( _mMax, _ref ), MONTH ) ) -- geometria
			VAR _dMinRef = ABS ( DATEDIFF ( MIN ( _mMin, _ref ), MAX ( _mMin, _ref ), MONTH ) ) -- geometria
			VAR _dMinMax = ABS ( DATEDIFF ( MIN ( _mMin, _mMax ), MAX ( _mMin, _mMax ), MONTH ) ) -- geometria
			VAR _htmlSerie =
			    CONCATENATEX (
			        _serie,
			        VAR _v = IF ( _semP, [@e], [@d] )
			        VAR _tem = NOT ISBLANK ( _v )
			        VAR _x = ( [@pj] - 1 ) * _slot + 1 /* geometria */
			        -- zero sobe nos modos misto e positivo e pende no negativo (o rótulo não cai sobre os meses do alto)
			        VAR _sobe = _v > 0 || ( _v = 0 && _modo <> "negativo" ) -- geometria
			        VAR _hD = MAX ( 1, ROUND ( MIN ( ABS ( _v ) * 11, IF ( _sobe, 40, _tetoNeg ) ), 0 ) ) /* geometria */
			        VAR _hE = MAX ( 1, ROUND ( DIVIDE ( _v, _maxE ) * 40, 0 ) ) /* geometria */
			        VAR _zero = _tem && NOT _semP && ROUND ( _v, 1 ) = 0 -- geometria
			        VAR _h = IF ( _tem, IF ( _zero, 2, IF ( _semP, _hE, _hD ) ), 0 ) -- geometria
			        VAR _ehRef = dMes[Mes] = _ref
			        VAR _cls = IF ( ISBLANK ( [@pt] ), "", IF ( [@pt] >= [@ps], "0", IF ( [@pt] = 0, "2", "1" ) ) )
			        VAR _mostra =
			            _tem
			                && ( _cabe || _ehRef || ( dMes[Mes] = _mMax && _dMaxRef > 1 )
			                    || ( dMes[Mes] = _mMin && _dMinRef > 1 && NOT ( _dMaxRef > 1 && _dMinMax <= 1 ) ) ) -- geometria
			        VAR _atraso = ( [@pj] - 1 ) * 120 /* geometria */
			        VAR _txtV =
			            IF (
			                _semP,
			                FORMAT ( _v * 100, "0.0", "pt-BR" ),
			                IF ( ROUND ( _v, 1 ) < 0, "−", "" ) & FORMAT ( ABS ( _v ), "0.0", "pt-BR" )
			            )
			        VAR _yRot = IF ( _sobe, _base - _h - 19, _base + 1 + _h + 2 ) /* geometria */
			        VAR _mesTxt = IF ( _cruza && MONTH ( dMes[Mes] ) = 1, FORMAT ( dMes[Mes], "mmm/yy", "pt-BR" ), [@ab] )
			        VAR _barra =
			            IF (
			                _tem,
			                "<i class='b " & IF ( _zero, "z", IF ( _semP, "se", "s" & _cls ) ) & "' style='left:" & ( _x + INT ( ( _slot - _bw ) / 2 ) )
			                    & "px;width:" & _bw & "px;"
			                    & IF ( _sobe, "top:auto;bottom:" & ( _alt - _base ), "top:" & ( _base + 1 ) ) & "px;height:" & _h
			                    & "px' data-rk='m" & [@pj] & "' data-rp='height' data-rd='" & _atraso & "'></i>"
			            )
			        VAR _rot =
			            IF (
			                _mostra,
			                "<span class='vl " & IF ( _ehRef, "ref fim", "ini" ) & IF ( NOT _semP && _cls = "2", " ng", "" ) & "' style='left:" & ( _x - 6 ) & "px;width:"
			                    & ( _slot + 12 ) & "px;top:" & _yRot & "px"
			                    & IF ( _ehRef, ";animation-delay:" & ( _atraso + 700 ) & "ms", "" ) & "'>" & "⁅" & _txtV & "⁆" & "</span>"
			            )
			        RETURN
			            _barra & _rot
			                & "<span class='ms" & IF ( _ehRef, " ref", IF ( _tem, "", " sem" ) ) & "' style='left:" & ( _x - 6 )
			                & "px;width:" & ( _slot + 12 ) & "px;top:" & _yMes & "px'>" & _mesTxt & "</span>",
			        "",
			        dMes[Mes], ASC
			    )
			-- 4 · Marcação
			VAR _htmlMes =
			    "<div class='li'>"
			        & IF ( ISBLANK ( _pm ), "", "<span class='n'>Previsto</span><span class='v'>" & _tpmOd & "</span>" )
			        & "<span class='n'>Executado</span><span class='v'>" & _temOd & "</span>"
			        & IF ( _txtDet = "", "", "<span class='d'>" & _txtDet & "</span>" )
			    & "</div>"
			VAR _saidaHtml =
			    IF (
			        NOT ISBLANK ( _e ),
			        "<div class='u tt'>" & "<div class='cab'><p class='vs sob'>" & _txtSob & "</p><div class='tl'><div class='tit'>" & "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</b><em>" & _cod & "</em>" & IF ( _selo = "", "", "<span class='selo " & IF ( _selo = "REAL", "selo-r", "selo-i" ) & "'>" & _selo & "</span>" ) & "</div><p class='vs dir'>" & _txtDir & "</p></div></div>"
			            & "<div class='corpo'><span class='vs'>NO MÊS · " & _mesCM & "</span>" & _htmlMes
			            & "<div class='r3'></div><span class='vs'>" & _rotGrafico & "</span>"
			            & "<div class='mc' style='height:" & _alt & "px'>" & _htmlSerie & "</div></div>"
			            & _htmlRodape
			        & "</div>" & [Comum · JS contador tooltip] & [Comum · JS corrida]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Tooltips
		lineageTag: 8146bd49-d2fb-5e47-ab25-d07d346066cb

	/// Tooltip de página do mês da Curva S (obra em foco; o mês sob o mouse): acumulado previsto e executado com o desvio e o status do físico na nota (dentro ou fora do limite), o mês (previsto e executado, com a posição na janela: 'o mês mais fraco em oito meses'), crédito × desembolsado até o mês e o que mudou desde o mês anterior. Estados: completo, primeiro mês do histórico ou primeira aba da obra (sem o 'desde' quando não há mês anterior), mês sem previsto na planilha (a coluna do previsto vira a nota, o desvio some e o 'desde' fala do executado).
	measure 'T3 · Tooltip curva · HTML' =
			-- 1 · Leituras
			VAR _na = [T3 · Série · mês na série · foco no mês]
			VAR _obra = [Nota · obra em foco]
			VAR _aba = [T3 · Aba · foco no mês]
			VAR _mes = [Mês · data]
			VAR _mesL = [Mês · longo]
			VAR _mesN = [Mês · nome]
			VAR _mesAntN = [Mês anterior · nome]
			VAR _primeiroHist = [Mês · é o primeiro do histórico]
			VAR _primeiraAba = [T3 · Obra · primeira aba · foco]
			VAR _n = [T3 · Série · meses da obra · foco]
			VAR _ini = [T3 · Foco · início]
			VAR _fim = [T3 · Foco · término previsto]
			VAR _pa = [Físico · previsto acumulado · foco no mês]
			VAR _ea = [Físico · executado acumulado · foco no mês]
			VAR _d = [T3 · Desvio físico p.p. · foco no mês]
			VAR _s = [T3 · Status desvio físico · foco no mês]
			VAR _pm = [Físico · previsto no mês · foco no mês]
			VAR _em = [Físico · executado no mês · foco no mês]
			VAR _dest = [T3 · Mês · destaque no ritmo · foco no mês]
			VAR _cred = [Crédito do orçamento · foco no mês]
			VAR _des = [Desembolsado acumulado · foco no mês]
			VAR _dAnt = [T3 · Desvio físico p.p. · mês anterior · foco no mês]
			VAR _sAnt = [T3 · Status desvio físico · mês anterior · foco no mês]
			VAR _eaAnt = [T3 · Executado acumulado · mês anterior · foco no mês]
			VAR _seg = [T3 · Físico · meses seguidos na faixa · foco no mês]
			-- 2 · Textos
			VAR _tpaN = FORMAT ( ABS ( _pa ) * 100, "0.0", "pt-BR" )
			VAR _tpaS = IF ( ROUND ( _pa * 100, 1 ) < 0, "−", "" )
			VAR _tpaTxt = IF ( ISBLANK ( _pa ), "—", _tpaS & _tpaN & "%" )
			VAR _teaN = FORMAT ( ABS ( _ea ) * 100, "0.0", "pt-BR" )
			VAR _teaS = IF ( ROUND ( _ea * 100, 1 ) < 0, "−", "" )
			VAR _teaTxt = IF ( ISBLANK ( _ea ), "—", _teaS & _teaN & "%" )
			VAR _tdN = FORMAT ( ABS ( _d ), "0.0", "pt-BR" )
			VAR _tdS = SWITCH ( TRUE (), ROUND ( _d, 1 ) < 0, "−", ROUND ( _d, 1 ) > 0, "+", "" )
			VAR _tdTxt = IF ( ISBLANK ( _d ), "—", _tdS & _tdN & " p.p." )
			VAR _tpmN = FORMAT ( ABS ( _pm ) * 100, "0.00", "pt-BR" )
			VAR _tpmS = IF ( ROUND ( _pm * 100, 2 ) < 0, "−", "" )
			VAR _tpmTxt = IF ( ISBLANK ( _pm ), "—", _tpmS & _tpmN & "%" )
			VAR _temN = FORMAT ( ABS ( _em ) * 100, "0.00", "pt-BR" )
			VAR _temS = IF ( ROUND ( _em * 100, 2 ) < 0, "−", "" )
			VAR _temTxt = IF ( ISBLANK ( _em ), "—", _temS & _temN & "%" )
			VAR _tcrA = ABS ( _cred )
			VAR _tcrNu = SWITCH ( TRUE (), _tcrA >= 99950000, FORMAT ( _tcrA / 1000000, "0.0", "pt-BR" ), _tcrA >= 999500, FORMAT ( _tcrA / 1000000, "0.00", "pt-BR" ), _tcrA >= 999.5, FORMAT ( _tcrA / 1000, "0", "pt-BR" ), FORMAT ( _tcrA, "#,0", "pt-BR" ) )
			VAR _tcrUn = SWITCH ( TRUE (), _tcrA >= 999500, " mi", _tcrA >= 999.5, " mil", "" )
			VAR _tcrN = _tcrNu & _tcrUn
			VAR _tcrZero = _tcrN = "0"
			VAR _tcrS = IF ( _tcrZero, "", IF ( _cred < 0, "−", "" ) )
			VAR _tcrTxt = IF ( ISBLANK ( _cred ), "—", _tcrS & "R$ " & _tcrN )
			VAR _tdsA = ABS ( _des )
			VAR _tdsNu = SWITCH ( TRUE (), _tdsA >= 99950000, FORMAT ( _tdsA / 1000000, "0.0", "pt-BR" ), _tdsA >= 999500, FORMAT ( _tdsA / 1000000, "0.00", "pt-BR" ), _tdsA >= 999.5, FORMAT ( _tdsA / 1000, "0", "pt-BR" ), FORMAT ( _tdsA, "#,0", "pt-BR" ) )
			VAR _tdsUn = SWITCH ( TRUE (), _tdsA >= 999500, " mi", _tdsA >= 999.5, " mil", "" )
			VAR _tdsN = _tdsNu & _tdsUn
			VAR _tdsZero = _tdsN = "0"
			VAR _tdsS = IF ( _tdsZero, "", IF ( _des < 0, "−", "" ) )
			VAR _tdsTxt = IF ( ISBLANK ( _des ), "—", _tdsS & "R$ " & _tdsN )
			VAR _tdaN = FORMAT ( ABS ( _dAnt ), "0.0", "pt-BR" )
			VAR _tdaS = SWITCH ( TRUE (), ROUND ( _dAnt, 1 ) < 0, "−", ROUND ( _dAnt, 1 ) > 0, "+", "" )
			VAR _tdaTxt = IF ( ISBLANK ( _dAnt ), "—", _tdaS & _tdaN & " p.p." )
			VAR _tea2N = FORMAT ( ABS ( _eaAnt ) * 100, "0.0", "pt-BR" )
			VAR _tea2S = IF ( ROUND ( _eaAnt * 100, 1 ) < 0, "−", "" )
			VAR _tea2Txt = IF ( ISBLANK ( _eaAnt ), "—", _tea2S & _tea2N & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tpaKP = LEN ( _tpaN ) > 0
			VAR _tpaKN = IF ( _tpaKP, _tpaN )
			VAR _tpaKS = SUBSTITUTE ( SUBSTITUTE ( _tpaKN, ".", "" ), ",", "" )
			VAR _tpaKT = IFERROR ( VALUE ( _tpaKS ), -1 )
			VAR _tpaKOk = _tpaKP && _tpaKT >= 2 && FORMAT ( _tpaKT, REPT ( "0", LEN ( _tpaKS ) ) ) = _tpaKS
			VAR _tpaKD = IF ( CONTAINSSTRING ( _tpaKN, "," ), LEN ( _tpaKN ) - SEARCH ( ",", _tpaKN ), 0 )
			VAR _tpaKM = IF ( CONTAINSSTRING ( _tpaKN, "." ), "#,##0", "0" ) & IF ( _tpaKD > 0, "." & REPT ( "0", _tpaKD ) )
			VAR _tpaKOd =
			    IF (
			        _tpaKOk,
			        "<o-d><o-v>" & _tpaKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpaKN, FORMAT ( ROUND ( _tpaKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpaKD ), _tpaKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpaN
			    )
			VAR _tpaOd = IF ( ISBLANK ( _pa ), _tpaTxt, _tpaS & _tpaKOd & "%" )
			VAR _teaKP = LEN ( _teaN ) > 0
			VAR _teaKN = IF ( _teaKP, _teaN )
			VAR _teaKS = SUBSTITUTE ( SUBSTITUTE ( _teaKN, ".", "" ), ",", "" )
			VAR _teaKT = IFERROR ( VALUE ( _teaKS ), -1 )
			VAR _teaKOk = _teaKP && _teaKT >= 2 && FORMAT ( _teaKT, REPT ( "0", LEN ( _teaKS ) ) ) = _teaKS
			VAR _teaKD = IF ( CONTAINSSTRING ( _teaKN, "," ), LEN ( _teaKN ) - SEARCH ( ",", _teaKN ), 0 )
			VAR _teaKM = IF ( CONTAINSSTRING ( _teaKN, "." ), "#,##0", "0" ) & IF ( _teaKD > 0, "." & REPT ( "0", _teaKD ) )
			VAR _teaKOd =
			    IF (
			        _teaKOk,
			        "<o-d><o-v>" & _teaKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _teaKN, FORMAT ( ROUND ( _teaKT * [@odf] / 1000, 0 ) / POWER ( 10, _teaKD ), _teaKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _teaN
			    )
			VAR _teaOd = IF ( ISBLANK ( _ea ), _teaTxt, _teaS & _teaKOd & "%" )
			VAR _tdKP = LEN ( _tdN ) > 0
			VAR _tdKN = IF ( _tdKP, _tdN )
			VAR _tdKS = SUBSTITUTE ( SUBSTITUTE ( _tdKN, ".", "" ), ",", "" )
			VAR _tdKT = IFERROR ( VALUE ( _tdKS ), -1 )
			VAR _tdKOk = _tdKP && _tdKT >= 2 && FORMAT ( _tdKT, REPT ( "0", LEN ( _tdKS ) ) ) = _tdKS
			VAR _tdKD = IF ( CONTAINSSTRING ( _tdKN, "," ), LEN ( _tdKN ) - SEARCH ( ",", _tdKN ), 0 )
			VAR _tdKM = IF ( CONTAINSSTRING ( _tdKN, "." ), "#,##0", "0" ) & IF ( _tdKD > 0, "." & REPT ( "0", _tdKD ) )
			VAR _tdKOd =
			    IF (
			        _tdKOk,
			        "<o-d><o-v>" & _tdKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdKN, FORMAT ( ROUND ( _tdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdKD ), _tdKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdN
			    )
			VAR _tdOd = IF ( ISBLANK ( _d ), _tdTxt, _tdS & _tdKOd & " p.p." )
			VAR _tpmKP = LEN ( _tpmN ) > 0
			VAR _tpmKN = IF ( _tpmKP, _tpmN )
			VAR _tpmKS = SUBSTITUTE ( SUBSTITUTE ( _tpmKN, ".", "" ), ",", "" )
			VAR _tpmKT = IFERROR ( VALUE ( _tpmKS ), -1 )
			VAR _tpmKOk = _tpmKP && _tpmKT >= 2 && FORMAT ( _tpmKT, REPT ( "0", LEN ( _tpmKS ) ) ) = _tpmKS
			VAR _tpmKD = IF ( CONTAINSSTRING ( _tpmKN, "," ), LEN ( _tpmKN ) - SEARCH ( ",", _tpmKN ), 0 )
			VAR _tpmKM = IF ( CONTAINSSTRING ( _tpmKN, "." ), "#,##0", "0" ) & IF ( _tpmKD > 0, "." & REPT ( "0", _tpmKD ) )
			VAR _tpmKOd =
			    IF (
			        _tpmKOk,
			        "<o-d><o-v>" & _tpmKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpmKN, FORMAT ( ROUND ( _tpmKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpmKD ), _tpmKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpmN
			    )
			VAR _tpmOd = IF ( ISBLANK ( _pm ), _tpmTxt, _tpmS & _tpmKOd & "%" )
			VAR _temKP = LEN ( _temN ) > 0
			VAR _temKN = IF ( _temKP, _temN )
			VAR _temKS = SUBSTITUTE ( SUBSTITUTE ( _temKN, ".", "" ), ",", "" )
			VAR _temKT = IFERROR ( VALUE ( _temKS ), -1 )
			VAR _temKOk = _temKP && _temKT >= 2 && FORMAT ( _temKT, REPT ( "0", LEN ( _temKS ) ) ) = _temKS
			VAR _temKD = IF ( CONTAINSSTRING ( _temKN, "," ), LEN ( _temKN ) - SEARCH ( ",", _temKN ), 0 )
			VAR _temKM = IF ( CONTAINSSTRING ( _temKN, "." ), "#,##0", "0" ) & IF ( _temKD > 0, "." & REPT ( "0", _temKD ) )
			VAR _temKOd =
			    IF (
			        _temKOk,
			        "<o-d><o-v>" & _temKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _temKN, FORMAT ( ROUND ( _temKT * [@odf] / 1000, 0 ) / POWER ( 10, _temKD ), _temKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _temN
			    )
			VAR _temOd = IF ( ISBLANK ( _em ), _temTxt, _temS & _temKOd & "%" )
			VAR _tcrKP = LEN ( _tcrNu ) > 0
			VAR _tcrKN = IF ( _tcrKP, _tcrNu )
			VAR _tcrKS = SUBSTITUTE ( SUBSTITUTE ( _tcrKN, ".", "" ), ",", "" )
			VAR _tcrKT = IFERROR ( VALUE ( _tcrKS ), -1 )
			VAR _tcrKOk = _tcrKP && _tcrKT >= 2 && FORMAT ( _tcrKT, REPT ( "0", LEN ( _tcrKS ) ) ) = _tcrKS
			VAR _tcrKD = IF ( CONTAINSSTRING ( _tcrKN, "," ), LEN ( _tcrKN ) - SEARCH ( ",", _tcrKN ), 0 )
			VAR _tcrKM = IF ( CONTAINSSTRING ( _tcrKN, "." ), "#,##0", "0" ) & IF ( _tcrKD > 0, "." & REPT ( "0", _tcrKD ) )
			VAR _tcrKOd =
			    IF (
			        _tcrKOk,
			        "<o-d><o-v>" & _tcrKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcrKN, FORMAT ( ROUND ( _tcrKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcrKD ), _tcrKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcrNu
			    )
			VAR _tcrOd = IF ( ISBLANK ( _cred ), _tcrTxt, _tcrS & "R$ " & _tcrKOd & _tcrUn )
			VAR _tdsKP = LEN ( _tdsNu ) > 0
			VAR _tdsKN = IF ( _tdsKP, _tdsNu )
			VAR _tdsKS = SUBSTITUTE ( SUBSTITUTE ( _tdsKN, ".", "" ), ",", "" )
			VAR _tdsKT = IFERROR ( VALUE ( _tdsKS ), -1 )
			VAR _tdsKOk = _tdsKP && _tdsKT >= 2 && FORMAT ( _tdsKT, REPT ( "0", LEN ( _tdsKS ) ) ) = _tdsKS
			VAR _tdsKD = IF ( CONTAINSSTRING ( _tdsKN, "," ), LEN ( _tdsKN ) - SEARCH ( ",", _tdsKN ), 0 )
			VAR _tdsKM = IF ( CONTAINSSTRING ( _tdsKN, "." ), "#,##0", "0" ) & IF ( _tdsKD > 0, "." & REPT ( "0", _tdsKD ) )
			VAR _tdsKOd =
			    IF (
			        _tdsKOk,
			        "<o-d><o-v>" & _tdsKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdsKN, FORMAT ( ROUND ( _tdsKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdsKD ), _tdsKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdsNu
			    )
			VAR _tdsOd = IF ( ISBLANK ( _des ), _tdsTxt, _tdsS & "R$ " & _tdsKOd & _tdsUn )
			VAR _semP = ISBLANK ( _pa )
			VAR _txtSob = "CURVA S · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( _obra ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & IF ( ISBLANK ( _aba ), "", " · ABA " & _aba )
			    & SWITCH ( TRUE (), _primeiroHist = 1, " · PRIMEIRO MÊS DO HISTÓRICO", _mes = _primeiraAba, " · PRIMEIRA ABA DA OBRA", "" )
			VAR _txtDir = IF ( ISBLANK ( _ini ), "", "INÍCIO " & UPPER ( FORMAT ( _ini, "mmm/yy", "pt-BR" ) ) )
			    & IF ( ISBLANK ( _fim ), "", " · TÉRMINO " & UPPER ( FORMAT ( _fim, "mmm/yy", "pt-BR" ) ) )
			VAR _txtDest =
			    SWITCH (
			        _dest,
			        "exec_min", "o mês mais fraco ",
			        "exec_max", "o melhor mês ",
			        "prev_max", "o maior previsto ",
			        "prev_min", "o menor previsto "
			    ) & "em " & SWITCH ( _n, 0, "zero", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses"
			VAR _htmlDest = IF ( ISBLANK ( _dest ), "", "<span class='d'>" & _txtDest & "</span>" )
			VAR _txtDesde =
			    IF (
			        _semP,
			        "Era " & "⁅" & _tea2Txt & "⁆" & " executado em " & _mesAntN & "; sem previsto, não há desvio a comparar.",
			        "Era " & "⁅" & _tdaTxt & "⁆" & " em " & _mesAntN
			            & IF (
			                _s = _sAnt,
			                "; " & SWITCH ( _seg, 1, "primeiro", 2, "segundo", 3, "terceiro", 4, "quarto", 5, "quinto", 6, "sexto", 7, "sétimo", 8, "oitavo", 9, "nono", 10, "décimo", FORMAT ( _seg, "0" ) & ".º" ) & " mês seguido " & SWITCH ( _s, 2, "fora do limite", "dentro do limite" ) & ".",
			                "; " & IF ( _s = 2, "passou do limite da nota", "voltou para dentro do limite" ) & "."
			            )
			    )
			VAR _temDesde = IF ( _semP, NOT ISBLANK ( _eaAnt ), NOT ISBLANK ( _dAnt ) )
			VAR _htmlCol =
			    IF (
			        _semP,
			        "<div class='c3'>" & "<div><span class='vs'>" & "PREVISTO ACUMULADO" & "</span><b class='sp'>sem previsto na planilha</b></div>" & "<div><span class='vs'>" & "EXECUTADO ACUMULADO" & "</span><b>" & _teaOd & "</b></div>" & "</div>",
			        "<div class='c3'>" & "<div><span class='vs'>" & "PREVISTO ACUMULADO" & "</span><b>" & _tpaOd & "</b></div>" & "<div><span class='vs'>" & "EXECUTADO ACUMULADO" & "</span><b>" & _teaOd & "</b></div>" & "<div><span class='vs'>" & "DESVIO · " & SWITCH ( _s, 2, "FORA DO LIMITE", 0, "NO LIMITE", "" ) & "</span><b>" & "<i class='mk mk" & _s & "'></i><span class='" & IF ( ROUND ( _d, 1 ) < 0, "ng", "" ) & "'>" & _tdOd & "</span>" & "</b></div>" & "</div>"
			    )
			VAR _htmlMes =
			    IF (
			        ISBLANK ( _pm ),
			        "<div class='li'><span class='n'>Executado</span><span class='v'>" & _temOd & "</span>" & _htmlDest & "</div>",
			        "<div class='li'><span class='n'>Previsto</span><span class='v'>" & _tpmOd & "</span>"
			            & "<span class='n'>Executado</span><span class='v'>" & _temOd & "</span>" & _htmlDest & "</div>"
			    )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        _na = 1,
			        "<div class='u tt'>" & "<div class='cab'><p class='vs sob'>" & _txtSob & "</p><div class='tl'><div class='tit'>" & "<b>" & _mesL & "</b>" & "</div><p class='vs dir'>" & _txtDir & "</p></div></div>"
			            & "<div class='corpo'>" & _htmlCol
			            & "<div class='r3'></div><span class='vs'>NO MÊS</span>" & _htmlMes
			            & "<div class='r3'></div><span class='vs'>CRÉDITO × DESEMBOLSO ATÉ " & UPPER ( _mesN ) & "</span>"
			            & "<div class='li'>" & "<span class='n'>Crédito do executado</span><span class='v'>" & _tcrOd & "</span>" & "<span class='n'>Desembolsado</span><span class='v'>" & _tdsOd & "</span>" & "</div>"
			            & "</div>" & IF ( _temDesde, "<div class='rod'><div class='r3'></div><span class='vs'>" & "DESDE " & UPPER ( _mesAntN ) & "</span><p class='l1'>" & _txtDesde & "</p></div>" )
			        & "</div>" & [Comum · JS contador tooltip]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Tooltips
		lineageTag: 84c03d3e-b920-5733-8543-e4bee5e64764

	/// Tooltip de página da obra da Linha do tempo: ficha de prazo (início, término e orçamento com o tipo), o prazo no mês de referência (F3: atraso em meses, término projetado e onde ele cai diante da entrega contratual e dos 180 dias de tolerância), físico × financeiro até o mês de referência (com o status do físico na nota) e o status da obra na nota desde quando, com a nota (ou 'pendente · X de Y') e, no pé, os itens em que a obra mais perde pontos; obra sem previsto na planilha só com o executado e a nota; obra a iniciar só com o cadastro da cronograma.
	measure 'T3 · Tooltip linha · HTML' =
			-- 1 · Leituras
			VAR _sit = [T3 · Obra · situação]
			VAR _obra = [Obra · nome]
			VAR _cod = [Obra · código]
			VAR _selo = [Obra · selo]
			VAR _spe = [T3 · Obra · SPE]
			VAR _m2 = [T3 · Obra · m² NBR]
			VAR _ini = [Obra · início]
			VAR _fim = [Obra · término previsto]
			VAR _aba = [Aba · ref]
			VAR _mesCM = [Mês de referência · curto maiúsculo]
			VAR _orc = [Orçamento · ref]
			VAR _tipo = [Tipo de orçamento · ref]
			VAR _orcG = [T3 · Obra · orçamento cronograma]
			VAR _tipoG = [T3 · Obra · tipo de orçamento cronograma]
			VAR _e = [Físico · executado acumulado · ref]
			VAR _p = [Físico · previsto acumulado · ref]
			VAR _d = [Físico · desvio acumulado p.p. · ref]
			VAR _sF = [T3 · Status desvio físico · ref]
			VAR _cred = [Crédito do orçamento · ref]
			VAR _des = [Desembolsado acumulado · ref]
			VAR _st = [Nota · status · ranking · ref]
			VAR _pend = [Nota · pendente · ranking · ref]
			VAR _nota = [Nota · nota final · ranking · ref]
			VAR _obt = [Nota · pontos obtidos · ranking · ref]
			VAR _poss = [Nota · pontos possíveis · ranking · ref]
			VAR _stIni = [T3 · Status · início da sequência]
			VAR _itens = [T3 · Tooltip linha · itens que perdem pontos (lista)]
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _atr = [Prazo · atraso (meses) · ref]
			VAR _ptA = [Nota · pontos prazo · ref]
			VAR _psA = [Nota · possíveis · prazo · ref]
			VAR _proj = [Prazo · término projetado · ref]
			VAR _ent = [Prazo · entrega contratual]
			VAR _tol = [Prazo · entrega com tolerância]
			VAR _sitT = [T3 · Término · situação · ref]
			-- 2 · Textos
			VAR _andamento = NOT ISBLANK ( _e )
			VAR _orcUso = IF ( _andamento, _orc, _orcG )
			VAR _toA = ABS ( _orcUso )
			VAR _toNu = SWITCH ( TRUE (), _toA >= 99950000, FORMAT ( _toA / 1000000, "0.0", "pt-BR" ), _toA >= 999500, FORMAT ( _toA / 1000000, "0.00", "pt-BR" ), _toA >= 999.5, FORMAT ( _toA / 1000, "0", "pt-BR" ), FORMAT ( _toA, "#,0", "pt-BR" ) )
			VAR _toUn = SWITCH ( TRUE (), _toA >= 999500, " mi", _toA >= 999.5, " mil", "" )
			VAR _toN = _toNu & _toUn
			VAR _toZero = _toN = "0"
			VAR _toS = IF ( _toZero, "", IF ( _orcUso < 0, "−", "" ) )
			VAR _toTxt = IF ( ISBLANK ( _orcUso ), "—", _toS & "R$ " & _toN )
			VAR _teN = FORMAT ( ABS ( _e ) * 100, "0.0", "pt-BR" )
			VAR _teS = IF ( ROUND ( _e * 100, 1 ) < 0, "−", "" )
			VAR _teTxt = IF ( ISBLANK ( _e ), "—", _teS & _teN & "%" )
			VAR _tpN = FORMAT ( ABS ( _p ) * 100, "0.0", "pt-BR" )
			VAR _tpS = IF ( ROUND ( _p * 100, 1 ) < 0, "−", "" )
			VAR _tpTxt = IF ( ISBLANK ( _p ), "—", _tpS & _tpN & "%" )
			VAR _tdvN = FORMAT ( ABS ( _d ), "0.0", "pt-BR" )
			VAR _tdvS = SWITCH ( TRUE (), ROUND ( _d, 1 ) < 0, "−", ROUND ( _d, 1 ) > 0, "+", "" )
			VAR _tdvTxt = IF ( ISBLANK ( _d ), "—", _tdvS & _tdvN & " p.p." )
			VAR _tcrA = ABS ( _cred )
			VAR _tcrNu = SWITCH ( TRUE (), _tcrA >= 99950000, FORMAT ( _tcrA / 1000000, "0.0", "pt-BR" ), _tcrA >= 999500, FORMAT ( _tcrA / 1000000, "0.00", "pt-BR" ), _tcrA >= 999.5, FORMAT ( _tcrA / 1000, "0", "pt-BR" ), FORMAT ( _tcrA, "#,0", "pt-BR" ) )
			VAR _tcrUn = SWITCH ( TRUE (), _tcrA >= 999500, " mi", _tcrA >= 999.5, " mil", "" )
			VAR _tcrN = _tcrNu & _tcrUn
			VAR _tcrZero = _tcrN = "0"
			VAR _tcrS = IF ( _tcrZero, "", IF ( _cred < 0, "−", "" ) )
			VAR _tcrTxt = IF ( ISBLANK ( _cred ), "—", _tcrS & "R$ " & _tcrN )
			VAR _tdsA = ABS ( _des )
			VAR _tdsNu = SWITCH ( TRUE (), _tdsA >= 99950000, FORMAT ( _tdsA / 1000000, "0.0", "pt-BR" ), _tdsA >= 999500, FORMAT ( _tdsA / 1000000, "0.00", "pt-BR" ), _tdsA >= 999.5, FORMAT ( _tdsA / 1000, "0", "pt-BR" ), FORMAT ( _tdsA, "#,0", "pt-BR" ) )
			VAR _tdsUn = SWITCH ( TRUE (), _tdsA >= 999500, " mi", _tdsA >= 999.5, " mil", "" )
			VAR _tdsN = _tdsNu & _tdsUn
			VAR _tdsZero = _tdsN = "0"
			VAR _tdsS = IF ( _tdsZero, "", IF ( _des < 0, "−", "" ) )
			VAR _tdsTxt = IF ( ISBLANK ( _des ), "—", _tdsS & "R$ " & _tdsN )
			VAR _ntN = FORMAT ( _nota, "0.0#", "pt-BR" )
			VAR _ntOb = FORMAT ( _obt, "0.0#", "pt-BR" )
			VAR _ntPo = FORMAT ( _poss, "0.0#", "pt-BR" )
			VAR _ntTxt = SWITCH ( TRUE (), _pend = 1, "pendente · " & _ntOb & " de " & _ntPo, ISBLANK ( _nota ), "—", "nota " & _ntN )
			VAR _taA = ROUND ( ABS ( _atr ), 1 )
			VAR _taN = FORMAT ( _taA, "0.0", "pt-BR" )
			VAR _taS = IF ( ROUND ( _atr, 1 ) < 0, "−", "" )
			VAR _taUn = IF ( _taA <= 1, " mês", " meses" )
			VAR _taTxt = IF ( ISBLANK ( _atr ), "—", _taS & _taN & _taUn )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _toKP = LEN ( _toNu ) > 0
			VAR _toKN = IF ( _toKP, _toNu )
			VAR _toKS = SUBSTITUTE ( SUBSTITUTE ( _toKN, ".", "" ), ",", "" )
			VAR _toKT = IFERROR ( VALUE ( _toKS ), -1 )
			VAR _toKOk = _toKP && _toKT >= 2 && FORMAT ( _toKT, REPT ( "0", LEN ( _toKS ) ) ) = _toKS
			VAR _toKD = IF ( CONTAINSSTRING ( _toKN, "," ), LEN ( _toKN ) - SEARCH ( ",", _toKN ), 0 )
			VAR _toKM = IF ( CONTAINSSTRING ( _toKN, "." ), "#,##0", "0" ) & IF ( _toKD > 0, "." & REPT ( "0", _toKD ) )
			VAR _toKOd =
			    IF (
			        _toKOk,
			        "<o-d><o-v>" & _toKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _toKN, FORMAT ( ROUND ( _toKT * [@odf] / 1000, 0 ) / POWER ( 10, _toKD ), _toKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _toNu
			    )
			VAR _toOd = IF ( ISBLANK ( _orcUso ), _toTxt, _toS & "R$ " & _toKOd & _toUn )
			VAR _teKP = LEN ( _teN ) > 0
			VAR _teKN = IF ( _teKP, _teN )
			VAR _teKS = SUBSTITUTE ( SUBSTITUTE ( _teKN, ".", "" ), ",", "" )
			VAR _teKT = IFERROR ( VALUE ( _teKS ), -1 )
			VAR _teKOk = _teKP && _teKT >= 2 && FORMAT ( _teKT, REPT ( "0", LEN ( _teKS ) ) ) = _teKS
			VAR _teKD = IF ( CONTAINSSTRING ( _teKN, "," ), LEN ( _teKN ) - SEARCH ( ",", _teKN ), 0 )
			VAR _teKM = IF ( CONTAINSSTRING ( _teKN, "." ), "#,##0", "0" ) & IF ( _teKD > 0, "." & REPT ( "0", _teKD ) )
			VAR _teKOd =
			    IF (
			        _teKOk,
			        "<o-d><o-v>" & _teKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _teKN, FORMAT ( ROUND ( _teKT * [@odf] / 1000, 0 ) / POWER ( 10, _teKD ), _teKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _teN
			    )
			VAR _teOd = IF ( ISBLANK ( _e ), _teTxt, _teS & _teKOd & "%" )
			VAR _tpKP = LEN ( _tpN ) > 0
			VAR _tpKN = IF ( _tpKP, _tpN )
			VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
			VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
			VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
			VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
			VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
			VAR _tpKOd =
			    IF (
			        _tpKOk,
			        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpN
			    )
			VAR _tpOd = IF ( ISBLANK ( _p ), _tpTxt, _tpS & _tpKOd & "%" )
			VAR _tdvKP = LEN ( _tdvN ) > 0
			VAR _tdvKN = IF ( _tdvKP, _tdvN )
			VAR _tdvKS = SUBSTITUTE ( SUBSTITUTE ( _tdvKN, ".", "" ), ",", "" )
			VAR _tdvKT = IFERROR ( VALUE ( _tdvKS ), -1 )
			VAR _tdvKOk = _tdvKP && _tdvKT >= 2 && FORMAT ( _tdvKT, REPT ( "0", LEN ( _tdvKS ) ) ) = _tdvKS
			VAR _tdvKD = IF ( CONTAINSSTRING ( _tdvKN, "," ), LEN ( _tdvKN ) - SEARCH ( ",", _tdvKN ), 0 )
			VAR _tdvKM = IF ( CONTAINSSTRING ( _tdvKN, "." ), "#,##0", "0" ) & IF ( _tdvKD > 0, "." & REPT ( "0", _tdvKD ) )
			VAR _tdvKOd =
			    IF (
			        _tdvKOk,
			        "<o-d><o-v>" & _tdvKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdvKN, FORMAT ( ROUND ( _tdvKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdvKD ), _tdvKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdvN
			    )
			VAR _tdvOd = IF ( ISBLANK ( _d ), _tdvTxt, _tdvS & _tdvKOd & " p.p." )
			VAR _tcrKP = LEN ( _tcrNu ) > 0
			VAR _tcrKN = IF ( _tcrKP, _tcrNu )
			VAR _tcrKS = SUBSTITUTE ( SUBSTITUTE ( _tcrKN, ".", "" ), ",", "" )
			VAR _tcrKT = IFERROR ( VALUE ( _tcrKS ), -1 )
			VAR _tcrKOk = _tcrKP && _tcrKT >= 2 && FORMAT ( _tcrKT, REPT ( "0", LEN ( _tcrKS ) ) ) = _tcrKS
			VAR _tcrKD = IF ( CONTAINSSTRING ( _tcrKN, "," ), LEN ( _tcrKN ) - SEARCH ( ",", _tcrKN ), 0 )
			VAR _tcrKM = IF ( CONTAINSSTRING ( _tcrKN, "." ), "#,##0", "0" ) & IF ( _tcrKD > 0, "." & REPT ( "0", _tcrKD ) )
			VAR _tcrKOd =
			    IF (
			        _tcrKOk,
			        "<o-d><o-v>" & _tcrKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcrKN, FORMAT ( ROUND ( _tcrKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcrKD ), _tcrKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcrNu
			    )
			VAR _tcrOd = IF ( ISBLANK ( _cred ), _tcrTxt, _tcrS & "R$ " & _tcrKOd & _tcrUn )
			VAR _tdsKP = LEN ( _tdsNu ) > 0
			VAR _tdsKN = IF ( _tdsKP, _tdsNu )
			VAR _tdsKS = SUBSTITUTE ( SUBSTITUTE ( _tdsKN, ".", "" ), ",", "" )
			VAR _tdsKT = IFERROR ( VALUE ( _tdsKS ), -1 )
			VAR _tdsKOk = _tdsKP && _tdsKT >= 2 && FORMAT ( _tdsKT, REPT ( "0", LEN ( _tdsKS ) ) ) = _tdsKS
			VAR _tdsKD = IF ( CONTAINSSTRING ( _tdsKN, "," ), LEN ( _tdsKN ) - SEARCH ( ",", _tdsKN ), 0 )
			VAR _tdsKM = IF ( CONTAINSSTRING ( _tdsKN, "." ), "#,##0", "0" ) & IF ( _tdsKD > 0, "." & REPT ( "0", _tdsKD ) )
			VAR _tdsKOd =
			    IF (
			        _tdsKOk,
			        "<o-d><o-v>" & _tdsKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdsKN, FORMAT ( ROUND ( _tdsKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdsKD ), _tdsKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdsNu
			    )
			VAR _tdsOd = IF ( ISBLANK ( _des ), _tdsTxt, _tdsS & "R$ " & _tdsKOd & _tdsUn )
			VAR _taKP = LEN ( _taN ) > 0
			VAR _taKN = IF ( _taKP, _taN )
			VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
			VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
			VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
			VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
			VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
			VAR _taKOd =
			    IF (
			        _taKOk,
			        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _taN
			    )
			VAR _taOd = IF ( ISBLANK ( _atr ), _taTxt, _taS & _taKOd & _taUn )
			VAR _txtOnde = SWITCH ( _sitT, 0, "até a entrega", 1, "nos 180 dias", 2, "depois dos 180 dias", "" )
			VAR _htmlPrazo =
			    IF (
			        ISBLANK ( _atr ),
			        "<div class='li'><span class='n'>Atraso</span><span class='d'>sem curva prevista</span></div>",
			        "<div class='li'><span class='n'>Atraso</span><span class='v'>" & IF ( IF ( ISBLANK ( _ptA ), "", IF ( _ptA >= _psA, "0", IF ( _ptA = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( _ptA ), "", IF ( _ptA >= _psA, "0", IF ( _ptA = 0, "2", "1" ) ) ) & "'></i>" ) & _taOd & "</span><span class='n'>Término projetado</span><span class='v'><i class='mk mk" & _sitT & "'></i>"
			            & FORMAT ( _proj, "mmm/yy", "pt-BR" ) & "</span><span class='d'>" & _txtOnde & ": entrega " & FORMAT ( _ent, "mmm/yy", "pt-BR" ) & ", com 180 dias " & FORMAT ( _tol, "mmm/yy", "pt-BR" ) & "</span></div>"
			    )
			VAR _tipoUso = UPPER ( IF ( _andamento, _tipo, _tipoG ) )
			VAR _txtSob =
			    IF (
			        _andamento,
			        "LINHA DO TEMPO · OBRA EM ANDAMENTO" & IF ( ISBLANK ( _aba ), "", " · ABA " & _aba ),
			        IF ( _sit = "A iniciar", "LINHA DO TEMPO · OBRA A INICIAR · cronograma " & UPPER ( [T3 · cronograma · versão] ), "LINHA DO TEMPO · OBRA SEM ABA EM " & _mesCM )
			    )
			VAR _posC = SEARCH ( " CONSTRU", _spe, 1, 0 )
			VAR _txtSpe = IF ( ISBLANK ( _spe ) || _spe = "—", "", IF ( _posC > 0, LEFT ( _spe, _posC - 1 ), _spe ) & " SPE · " )
			VAR _txtDir = IF ( _andamento, _txtSpe, "" ) & IF ( ISBLANK ( _m2 ), "", "⁅" & FORMAT ( _m2, "#,0", "pt-BR" ) & "⁆" & " M² NBR" )
			VAR _seloUso = IF ( _selo = "" || ISBLANK ( _selo ), IF ( _sit = "A iniciar", "cronograma", "" ), _selo )
			VAR _txtCod = IF ( ISBLANK ( _cod ) || _cod = "—", "", _cod )
			VAR _txtIni = IF ( ISBLANK ( _ini ), "—", FORMAT ( _ini, "mmm/yy", "pt-BR" ) )
			VAR _txtFim = IF ( ISBLANK ( _fim ), "—", FORMAT ( _fim, "mmm/yy", "pt-BR" ) )
			VAR _txtStatus =
			    SWITCH ( TRUE (), _pend = 1, "pendente", _st = 2, "crítica", _st = 1, "em atenção", "estável" )
			        & IF ( _stIni = _ref, " em " & FORMAT ( _stIni, "mmmm", "pt-BR" ), " desde " & IF ( _stIni = _jan || YEAR ( _stIni ) <> YEAR ( _ref ), FORMAT ( _stIni, "mmm/yy", "pt-BR" ), FORMAT ( _stIni, "mmmm", "pt-BR" ) ) )
			VAR _nIt = IF ( _itens = "" || ISBLANK ( _itens ), 0, PATHLENGTH ( _itens ) )
			VAR _txtLinha =
			    SWITCH (
			        _nIt,
			        0, "",
			        1, "Só perde pontos em " & PATHITEM ( _itens, 1 ) & ".",
			        "Onde mais perde pontos: " & PATHITEM ( _itens, 1 ) & " e " & PATHITEM ( _itens, 2 ) & "."
			    )
			VAR _htmlStatus =
			    "<div class='st'>" & IF ( IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) = "", "", "<span class='chip chip" & IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) & "'><i></i>" & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & "</span>" ) & "<span class='v'>"
			        & IF ( _pend = 1, "⁅" & _ntOb & "⁆" & " de " & _ntPo, "⁅" & _ntN & "⁆" ) & "</span><span class='pt'>"
			        & IF ( _pend = 1, "pontos até agora", "Nota da obra" ) & "</span><span class='d'>" & _txtStatus & "</span></div>"
			VAR _htmlFisico =
			    IF (
			        ISBLANK ( _p ),
			        "<div class='li'><span class='n'>Executado</span><span class='v'>" & _teOd & "</span><span class='d'>sem previsto na planilha"
			            & "</span></div>",
			        "<div class='li'><span class='n'>Executado</span><span class='v'>" & _teOd & "</span>"
			            & "<span class='n'>Previsto</span><span class='v'>" & _tpOd & "</span>"
			            & "<span class='v'><i class='mk mk" & _sF & "'></i><span class='" & IF ( ROUND ( _d, 1 ) < 0, "ng", "" ) & "'>" & _tdvOd & "</span></span><span class='d'>" & SWITCH ( _sF, 2, "fora do limite", "dentro do limite" ) & "</span></div>"
			    )
			VAR _htmlCorpo =
			    IF (
			        _andamento,
			        "<div class='r3'></div><span class='vs'>PRAZO EM " & _mesCM & "</span>" & _htmlPrazo
			            & "<div class='r3'></div><span class='vs'>FÍSICO × FINANCEIRO ATÉ " & _mesCM & "</span>" & _htmlFisico
			            & "<div class='li'>" & "<span class='n'>Crédito do executado</span><span class='v'>" & _tcrOd & "</span>" & "<span class='n'>Desembolsado</span><span class='v'>" & _tdsOd & "</span>" & "</div>"
			            & "<div class='r3'></div><span class='vs'>STATUS DA OBRA EM " & _mesCM & "</span>" & _htmlStatus,
			        ""
			    )
			VAR _htmlRod =
			    IF (
			        _andamento,
			        IF ( _txtLinha = "", "", "<div class='rod sr'><p class='l1'>" & _txtLinha & "</p></div>" ),
			        "<div class='rod'><div class='r3'></div><span class='vs'>" & "AINDA SEM PLANILHA ANÁLISE CRÍTICA" & "</span><p class='l1'>" & "Previsto, executado e status chegam com a primeira aba da obra." & "</p></div>"
			    )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        /* sem obra única no contexto (cálculo fora do visual, filtro com várias): vazio, sem chegar nos textos */
			        HASONEVALUE ( dObra[Obra] ) && _sit IN { "Em andamento", "A iniciar" },
			        "<div class='u tt'>" & "<div class='cab'><p class='vs sob'>" & _txtSob & "</p><div class='tl'><div class='tit'>" & "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</b><em>" & _txtCod & "</em>" & IF ( _seloUso = "", "", "<span class='selo " & IF ( _seloUso = "REAL", "selo-r", "selo-i" ) & "'>" & _seloUso & "</span>" ) & "</div><p class='vs dir'>" & _txtDir & "</p></div></div>"
			            & "<div class='corpo'>" & "<div class='c3'>" & "<div><span class='vs'>" & IF ( _andamento, "INÍCIO", "INÍCIO PREVISTO" ) & "</span><b>" & _txtIni & "</b></div>" & "<div><span class='vs'>" & "TÉRMINO PREVISTO" & "</span><b>" & _txtFim & "</b></div>" & "<div><span class='vs'>" & "ORÇAMENTO" & IF ( _tipoUso = "", "", " · " & _tipoUso ) & "</span><b>" & _toOd & "</b></div>" & "</div>"
			            & _htmlCorpo & "</div>" & _htmlRod
			        & "</div>" & [Comum · JS contador tooltip]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Tooltips
		lineageTag: 5940dd2f-f164-54c6-bb3a-919166e0adce

	/// Tooltip de página do mês do PPC mês a mês (obra em foco): o PPC do mês com a marca dos pontos, os pontos do item PPC na nota e o atraso em meses ao fim do mês; o ritmo do mês (previsto × executado, em % do orçamento) e o acumulado numa linha; no pé, o PPC do mês anterior. Sem PPC na base: 'falta na base' no lugar do número.
	measure 'T3 · Tooltip PPC · HTML' =
			-- 1 · Leituras
			VAR _noRecorte = [Série · mês até a referência]
			VAR _obra = [Nota · obra em foco]
			VAR _aba = [T3 · Aba · foco no mês]
			VAR _mesL = [Mês · longo]
			VAR _mesN = [Mês · nome]
			VAR _mesAntN = [Mês anterior · nome]
			VAR _ppc = [Canteiro · PPC · foco no mês]
			VAR _pt = [Nota · pontos PPC · foco no mês]
			VAR _ps = [Nota · possíveis · PPC · foco no mês]
			VAR _meta = [Nota · limite PPC · ponto cheio]
			VAR _atr = [Prazo · atraso (meses) · foco no mês]
			VAR _ptA = [Nota · pontos prazo · foco no mês]
			VAR _psA = [Nota · possíveis · prazo · foco no mês]
			VAR _pm = [Físico · previsto no mês · foco no mês]
			VAR _em = [Físico · executado no mês · foco no mês]
			VAR _pa = [Físico · previsto acumulado · foco no mês]
			VAR _ea = [Físico · executado acumulado · foco no mês]
			VAR _ppcAnt = [T3 · PPC · mês anterior · foco no mês]
			-- 2 · Textos
			VAR _tcN = FORMAT ( ABS ( _ppc ) * 100, "0", "pt-BR" )
			VAR _tcS = IF ( ROUND ( _ppc * 100, 0 ) < 0, "−", "" )
			VAR _tcTxt = IF ( ISBLANK ( _ppc ), "—", _tcS & _tcN & "%" )
			VAR _tmN = FORMAT ( ABS ( _meta ) * 100, "0", "pt-BR" )
			VAR _tmS = IF ( ROUND ( _meta * 100, 0 ) < 0, "−", "" )
			VAR _tmTxt = IF ( ISBLANK ( _meta ), "—", _tmS & _tmN & "%" )
			VAR _tpmN = FORMAT ( ABS ( _pm ) * 100, "0.00", "pt-BR" )
			VAR _tpmS = IF ( ROUND ( _pm * 100, 2 ) < 0, "−", "" )
			VAR _tpmTxt = IF ( ISBLANK ( _pm ), "—", _tpmS & _tpmN & "%" )
			VAR _temN = FORMAT ( ABS ( _em ) * 100, "0.00", "pt-BR" )
			VAR _temS = IF ( ROUND ( _em * 100, 2 ) < 0, "−", "" )
			VAR _temTxt = IF ( ISBLANK ( _em ), "—", _temS & _temN & "%" )
			VAR _tpaN = FORMAT ( ABS ( _pa ) * 100, "0.0", "pt-BR" )
			VAR _tpaS = IF ( ROUND ( _pa * 100, 1 ) < 0, "−", "" )
			VAR _tpaTxt = IF ( ISBLANK ( _pa ), "—", _tpaS & _tpaN & "%" )
			VAR _teaN = FORMAT ( ABS ( _ea ) * 100, "0.0", "pt-BR" )
			VAR _teaS = IF ( ROUND ( _ea * 100, 1 ) < 0, "−", "" )
			VAR _teaTxt = IF ( ISBLANK ( _ea ), "—", _teaS & _teaN & "%" )
			VAR _tcaN = FORMAT ( ABS ( _ppcAnt ) * 100, "0", "pt-BR" )
			VAR _tcaS = IF ( ROUND ( _ppcAnt * 100, 0 ) < 0, "−", "" )
			VAR _tcaTxt = IF ( ISBLANK ( _ppcAnt ), "—", _tcaS & _tcaN & "%" )
			VAR _taA = ROUND ( ABS ( _atr ), 1 )
			VAR _taN = FORMAT ( _taA, "0.0", "pt-BR" )
			VAR _taS = IF ( ROUND ( _atr, 1 ) < 0, "−", "" )
			VAR _taUn = IF ( _taA <= 1, " mês", " meses" )
			VAR _taTxt = IF ( ISBLANK ( _atr ), "—", _taS & _taN & _taUn )
			VAR _tkTxt = IF ( ISBLANK ( _pt ), "falta na base", FORMAT ( _pt, "0.0#", "pt-BR" ) & " de " & FORMAT ( _ps, "0.0#", "pt-BR" ) )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tcKP = LEN ( _tcN ) > 0
			VAR _tcKN = IF ( _tcKP, _tcN )
			VAR _tcKS = SUBSTITUTE ( SUBSTITUTE ( _tcKN, ".", "" ), ",", "" )
			VAR _tcKT = IFERROR ( VALUE ( _tcKS ), -1 )
			VAR _tcKOk = _tcKP && _tcKT >= 2 && FORMAT ( _tcKT, REPT ( "0", LEN ( _tcKS ) ) ) = _tcKS
			VAR _tcKD = IF ( CONTAINSSTRING ( _tcKN, "," ), LEN ( _tcKN ) - SEARCH ( ",", _tcKN ), 0 )
			VAR _tcKM = IF ( CONTAINSSTRING ( _tcKN, "." ), "#,##0", "0" ) & IF ( _tcKD > 0, "." & REPT ( "0", _tcKD ) )
			VAR _tcKOd =
			    IF (
			        _tcKOk,
			        "<o-d><o-v>" & _tcKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcKN, FORMAT ( ROUND ( _tcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcKD ), _tcKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcN
			    )
			VAR _tcOd = IF ( ISBLANK ( _ppc ), _tcTxt, _tcS & _tcKOd & "%" )
			VAR _tpmKP = LEN ( _tpmN ) > 0
			VAR _tpmKN = IF ( _tpmKP, _tpmN )
			VAR _tpmKS = SUBSTITUTE ( SUBSTITUTE ( _tpmKN, ".", "" ), ",", "" )
			VAR _tpmKT = IFERROR ( VALUE ( _tpmKS ), -1 )
			VAR _tpmKOk = _tpmKP && _tpmKT >= 2 && FORMAT ( _tpmKT, REPT ( "0", LEN ( _tpmKS ) ) ) = _tpmKS
			VAR _tpmKD = IF ( CONTAINSSTRING ( _tpmKN, "," ), LEN ( _tpmKN ) - SEARCH ( ",", _tpmKN ), 0 )
			VAR _tpmKM = IF ( CONTAINSSTRING ( _tpmKN, "." ), "#,##0", "0" ) & IF ( _tpmKD > 0, "." & REPT ( "0", _tpmKD ) )
			VAR _tpmKOd =
			    IF (
			        _tpmKOk,
			        "<o-d><o-v>" & _tpmKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tpmKN, FORMAT ( ROUND ( _tpmKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpmKD ), _tpmKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tpmN
			    )
			VAR _tpmOd = IF ( ISBLANK ( _pm ), _tpmTxt, _tpmS & _tpmKOd & "%" )
			VAR _temKP = LEN ( _temN ) > 0
			VAR _temKN = IF ( _temKP, _temN )
			VAR _temKS = SUBSTITUTE ( SUBSTITUTE ( _temKN, ".", "" ), ",", "" )
			VAR _temKT = IFERROR ( VALUE ( _temKS ), -1 )
			VAR _temKOk = _temKP && _temKT >= 2 && FORMAT ( _temKT, REPT ( "0", LEN ( _temKS ) ) ) = _temKS
			VAR _temKD = IF ( CONTAINSSTRING ( _temKN, "," ), LEN ( _temKN ) - SEARCH ( ",", _temKN ), 0 )
			VAR _temKM = IF ( CONTAINSSTRING ( _temKN, "." ), "#,##0", "0" ) & IF ( _temKD > 0, "." & REPT ( "0", _temKD ) )
			VAR _temKOd =
			    IF (
			        _temKOk,
			        "<o-d><o-v>" & _temKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _temKN, FORMAT ( ROUND ( _temKT * [@odf] / 1000, 0 ) / POWER ( 10, _temKD ), _temKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _temN
			    )
			VAR _temOd = IF ( ISBLANK ( _em ), _temTxt, _temS & _temKOd & "%" )
			VAR _taKP = LEN ( _taN ) > 0
			VAR _taKN = IF ( _taKP, _taN )
			VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
			VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
			VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
			VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
			VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
			VAR _taKOd =
			    IF (
			        _taKOk,
			        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _taN
			    )
			VAR _taOd = IF ( ISBLANK ( _atr ), _taTxt, _taS & _taKOd & _taUn )
			VAR _txtSob = "PPC MÊS A MÊS · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( _obra ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & IF ( ISBLANK ( _aba ), "", " · ABA " & _aba )
			VAR _txtDir = "META " & _tmTxt
			VAR _htmlPpc = IF ( ISBLANK ( _ppc ), "<b class='sp'>falta na base</b>", "<b>" & IF ( IF ( ISBLANK ( _pt ), "", IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( _pt ), "", IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) ) & "'></i>" ) & _tcOd & "</b>" )
			VAR _htmlAtr = IF ( ISBLANK ( _atr ), "<b class='sp'>sem curva prevista</b>", "<b>" & IF ( IF ( ISBLANK ( _ptA ), "", IF ( _ptA >= _psA, "0", IF ( _ptA = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( _ptA ), "", IF ( _ptA >= _psA, "0", IF ( _ptA = 0, "2", "1" ) ) ) & "'></i>" ) & "<span class='" & IF ( _ptA = 0, "ng", "" ) & "'>" & _taOd & "</span></b>" )
			VAR _htmlCol =
			    "<div class='c3'><div><span class='vs'>PPC DO MÊS</span>" & _htmlPpc & "</div>"
			        & "<div><span class='vs'>NA NOTA · ITEM PPC</span><b>" & "⁅" & _tkTxt & "⁆" & "</b></div>"
			        & "<div><span class='vs'>ATRASO AO FIM DO MÊS</span>" & _htmlAtr & "</div></div>"
			VAR _htmlRitmo =
			    "<div class='li'>"
			        & IF ( ISBLANK ( _pm ), "", "<span class='n'>Previsto</span><span class='v'>" & _tpmOd & "</span>" )
			        & "<span class='n'>Executado</span><span class='v'>" & _temOd & "</span>"
			        & IF ( ISBLANK ( _pm ), "<span class='d'>sem previsto na planilha</span>", "" )
			    & "</div>"
			VAR _txtAcum =
			    IF (
			        ISBLANK ( _pa ),
			        "Acumulado ao fim de " & _mesN & ": " & "⁅" & _teaTxt & "⁆" & " executado; {SEM_P}.",
			        "Acumulado ao fim de " & _mesN & ": " & "⁅" & _tpaTxt & "⁆" & " previsto × " & "⁅" & _teaTxt & "⁆" & " executado."
			    )
			VAR _verbo = IF ( ROUND ( _ppc, 2 ) > ROUND ( _ppcAnt, 2 ), "subiu", IF ( ROUND ( _ppc, 2 ) < ROUND ( _ppcAnt, 2 ), "caiu", "repetiu" ) )
			VAR _txtDesde = "Era " & "⁅" & _tcaTxt & "⁆" & " em " & _mesAntN & ": o PPC " & _verbo & IF ( _ppc >= _meta, " e está na meta.", " e está abaixo da meta." )
			VAR _temAnt = NOT ISBLANK ( _ppcAnt ) && NOT ISBLANK ( _ppc )
			VAR _rotDesde = "DESDE " & UPPER ( _mesAntN )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        _noRecorte = 1,
			        "<div class='u tt'>" & "<div class='cab'><p class='vs sob'>" & _txtSob & "</p><div class='tl'><div class='tit'>" & "<b>" & _mesL & "</b>" & "</div><p class='vs dir'>" & _txtDir & "</p></div></div>"
			            & "<div class='corpo'>" & _htmlCol
			            & "<div class='r3'></div><span class='vs'>RITMO DO MÊS · % DO ORÇAMENTO</span>" & _htmlRitmo
			            & "<p class='l1'>" & _txtAcum & "</p>"
			            & "</div>" & IF ( _temAnt, "<div class='rod'><div class='r3'></div><span class='vs'>" & _rotDesde & "</span><p class='l1'>" & _txtDesde & "</p></div>" )
			        & "</div>" & [Comum · JS contador tooltip]
			    )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Tooltips
		lineageTag: 647a7853-12b7-56a6-8c16-1ea64816b217

	/// CSS dos tooltips de página da Tela 03 (v2): cartão branco de cantos retos, cabeçalho preto de 72 px com a meta em flex-wrap, três colunas de valor (ou a nota 'sem previsto na planilha'), linhas de rótulo e valor, status com chip, mini gráfico do avanço (atraso em meses na cor dos pontos do item prazo ou, sem curva prevista, executado acumulado) e rodapé de uma linha preso ao pé.
	measure 'T3 · Tooltip · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".tt{position:fixed;inset:0;display:flex;flex-direction:column;background:#FFFFFF;border:1px solid #0B0B0C;overflow:hidden}.tt .cab{flex:none;background:#0B0B0C;padding:14px 20px 12"
			    & "px}.tt .cab .vs{color:#E9E0CF}.tt .cab .tl{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;column-gap:24px;row-gap:6px;margin-top:5px}.tt .cab .tit{dis"
			    & "play:flex;align-items:center;gap:10px;white-space:nowrap;min-height:26px}.tt .cab .tit b{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:21px;line-height:26p"
			    & "x;color:#FFFFFF}.tt .cab .tit em{font-style:normal;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#"
			    & "E9E0CF}.tt .cab .tit .selo-i{border:1px dashed #E9E0CF;color:#E9E0CF}.tt .cab .tit .selo-r{background:#E9E0CF;color:#0B0B0C}.tt .cab .dir{white-space:nowrap}.tt .corpo{flex:none;pa"
			    & "dding:16px 20px 0}.tt .rod{margin-top:auto;padding:0 20px 16px}.tt .rod.sr{padding-top:0}.tt .vs{display:block}.tt .c3{display:grid;grid-template-columns:minmax(155px,auto) minmax("
			    & "155px,auto) 1fr;column-gap:18px}.tt .c3 .vs{white-space:nowrap}.tt .c3 b{display:block;margin-top:6px;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:21px;li"
			    & "ne-height:26px;white-space:nowrap}.tt .c3 b.sp{font-family:'Segoe UI',sans-serif;font-weight:400;font-size:15px;line-height:20px;color:#3B3B3F;margin-top:9px}.tt .c3 b .mk{margin-r"
			    & "ight:6px;vertical-align:2px}.tt .r3{height:1px;background:#E1E1E1;margin:12px 0}.tt .rod .r3{margin-top:0}.tt .li{display:flex;align-items:baseline;white-space:nowrap;margin-top:6p"
			    & "x;line-height:21px}.tt .li .n{font-size:15px;font-weight:600;margin-right:6px}.tt .li .v{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;margin-right:22"
			    & "px}.tt .li .v .mk,.tt .st .v .mk{margin-right:6px;vertical-align:0}.tt .li{flex-wrap:wrap}.tt .li .d{font-size:15px;color:#3B3B3F}.tt .l1{font-size:15px;line-height:21px;margin-top"
			    & ":6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tt .corpo .c3+.l1{margin-top:8px}.tt .st{display:flex;align-items:center;white-space:nowrap;margin-top:6px;height:25"
			    & "px}.tt .st .chip{margin-right:12px}.tt .st .v{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px;margin-right:6px}.tt .st .pt{font-size:15px;color:#3B3B3F;"
			    & "margin-right:22px}.tt .st .d{font-size:15px;color:#3B3B3F}.tt .mc{position:relative;margin-top:8px}.tt .mc .ms{position:absolute;text-align:center;font-size:13px;line-height:16px;w"
			    & "hite-space:nowrap;color:#3B3B3F}.tt .mc .ms.ref{font-weight:600;color:#0B0B0C}.tt .mc .ms.sem{opacity:.45;color:#6B6B70}.tt .mc .b{position:absolute}.tt .mc .b.s0{background:#A9CDB"
			    & "9}.tt .mc .b.s1{background:#C9821F}.tt .mc .b.s2{background:#C43737}.tt .mc .b.se{background:#0B0B0C}.tt .mc .b.z{background:#E1E1E1}.tt .mc .vl{position:absolute;text-align:center"
			    & ";font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;white-space:nowrap;color:#3B3B3F}.tt .mc .vl.ref{color:#0B0B0C}@keyframes ttFim{from{o"
			    & "pacity:0}}.tt .fim{animation:ttFim .2s ease-out backwards}@media (prefers-reduced-motion:reduce){.tt .fim{animation:none}}.tt .corpo{flex:1 1 auto;min-height:0;display:flex;flex-di"
