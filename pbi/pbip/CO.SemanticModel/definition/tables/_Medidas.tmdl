	/// Itens da nota em que a obra do item perdeu pontos no mês de referência, do que mais perdeu ao que menos (empate pela ordem do item), pelo nome médio e separados por '|'. Itens sem dado não entram. Ex. de teste ago/26: REDINHA → Médio Prazo|Fluxo de caixa|… .
	measure 'T3 · Tooltip linha · itens que perdem pontos (lista)' =
			VAR _itens =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dItemNota[Item] ),
			            "@p", [Nota · item · perdidos · ref],
			            "@o", [Nota · item · ordem],
			            "@nm", [Nota · item · nome médio]
			        ),
			        [@p] > 0
			    )
			RETURN
			    CONCATENATEX ( _itens, [@nm], "|", [@p], DESC, [@o], ASC )
		displayFolder: T3 Avanço físico\Linha do tempo das obras\Contas
		lineageTag: 40df1f1f-7981-50b5-9edc-d2a489ea8c46

	/// Início da obra em foco (cadastro).
	measure 'T3 · Foco · início' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    LOOKUPVALUE ( dObra[Inicio], dObra[Obra], _obra )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Obra em foco\Contas
		lineageTag: d2a1b123-d7fa-5797-977a-c588ab65b616

	/// Término previsto da obra em foco (cadastro).
	measure 'T3 · Foco · término previsto' =
			VAR _obra = [Nota · obra em foco]
			RETURN
			    LOOKUPVALUE ( dObra[TerminoPrevisto], dObra[Obra], _obra )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\Obra em foco\Contas
		lineageTag: d8d1f5cb-80a3-5bfe-be19-8065331e5854

	/// CSS do cabeçalho dos painéis da Tela 03 (subtítulo e legenda).
	measure 'T3 · Painel · CSS cabeçalho' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & ".pc{position:fixed;inset:0;white-space:nowrap}.pc .sub{position:absolute;left:0;top:32px;font-size:15px;line-height:20px;color:#3B3B3F}.pc .lg{position:absolute;right:0;top:4px;hei"
			    & "ght:20px;display:flex;align-items:center;font-size:14px;line-height:19px;color:#3B3B3F}.pc .lg svg,.pc .lg i{display:block;flex:none;margin-right:6px}.pc .lg span{margin-right:18px"
			    & "}.pc .lg span:last-child{margin-right:0}.pc .lg .ar{width:14px;height:12px;background:#F7E3E3}.pc .lg .sw{width:12px;height:12px}.pc .lg .sp{color:#6B6B70;margin-left:-12px}"
		displayFolder: T3 Avanço físico\Painéis
		lineageTag: 6a1885dc-b714-5e11-be25-e847aa008ecd

	/// CSS do PPC mês a mês (uma entrada por mês da janela; colunas iguais).
	measure 'T3 · PPC · CSS' =
			-- 4 · Marcação
			[Comum · CSS base]
			    & "#htmlContent{display:flex!important;align-items:flex-start;width:100vw;height:100vh;margin:0!important;padding:0!important;box-sizing:border-box!important}.htmlViewerEntry{display:"
			    & "block!important;flex:1 1 0;min-width:0;margin:0!important;padding:0!important}.pm{position:relative;height:222px;transition:background .15s}.pm:hover,.htmlViewerEntry.hover .pm{bac"
			    & "kground:rgba(233,224,207,.35)}.pm .l0{position:absolute;left:0;right:0;top:190px;height:1px;background:#E1E1E1}.pm .lm{position:absolute;left:0;right:0;height:0;border-top:1px dash"
			    & "ed #0B0B0C}.pm .b{position:absolute;bottom:32px;left:calc(50% - 11px);width:22px}.pm .b.q0{background:#A9CDB9}.pm .b.q1{background:#C9821F}.pm .b.q2{background:#C43737}.pm .v{posit"
			    & "ion:absolute;left:-30px;right:-30px;text-align:center;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;white-space:nowrap;font-variant-n"
			    & "umeric:tabular-nums;color:#0B0B0C;text-shadow:1px 0 0 #FFF,-1px 0 0 #FFF,0 1px 0 #FFF,0 -1px 0 #FFF,1px 1px 0 #FFF,-1px -1px 0 #FFF,1px -1px 0 #FFF,-1px 1px 0 #FFF,0 0 3px #FFF}.pm"
			    & " .v.ng{color:#C43737}.pm .ms{position:absolute;left:-12px;right:-12px;top:198px;text-align:center;font-size:13px;line-height:16px;white-space:nowrap;color:#3B3B3F}.pm .ms.ref{font-"
			    & "weight:600;color:#0B0B0C}.pm .ms.sem{opacity:.35}.pm .vz{position:absolute;left:4px;top:60px;font-size:14px;line-height:19px;color:#3B3B3F;white-space:nowrap}"
		displayFolder: T3 Avanço físico\PPC mês a mês
		lineageTag: 8e74faee-6a96-56b4-8335-c197b1dc29fe

	/// Subtítulo do PPC mês a mês com a meta e a janela em uso (média do mês · tracejado na meta, 80% · jan–set/26) e, na linha do título, a legenda das cores pelos pontos do item PPC da nota. A meta vem de [Nota · limite PPC · ponto cheio].
	measure 'T3 · PPC · HTML cabeçalho' =
			-- 1 · Leituras
			VAR _ini = [Série · primeiro mês]
			VAR _ref = [Mês de referência]
			VAR _n = [Série · meses até a referência]
			VAR _meta = [Nota · limite PPC · ponto cheio]
			-- 2 · Textos
			VAR _txtRef = FORMAT ( _ref, "mmm/yy", "pt-BR" )
			VAR _txtIni = IF ( YEAR ( _ini ) = YEAR ( _ref ), FORMAT ( _ini, "mmm", "pt-BR" ), FORMAT ( _ini, "mmm/yy", "pt-BR" ) )
			VAR _txtJanela = IF ( _n <= 1, _txtRef, _txtIni & "–" & _txtRef )
			VAR _txtSub = "média do mês · tracejado na meta, " & "⁅" & FORMAT ( _meta, "0%", "pt-BR" ) & "⁆" & " · " & _txtJanela
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u pc'><span class='sub'>" & _txtSub & "</span><div class='lg'>"
			        & "<i class='sw' style='background:#A9CDB9'></i><span>na meta</span><i class='sw' style='background:#C9821F'>"
			        & "</i><span>perde parte</span><i class='sw' style='background:#C43737'></i><span>zera</span></div></div>"
			        & [Comum · JS contador]
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\PPC mês a mês
		lineageTag: d9536c72-8976-5444-a3eb-bd64cf449209

	/// PPC da obra em foco mês a mês: uma entrada por mês da janela (granularidade dMes, colunas iguais), a barra de 0 ao PPC (escala fixa, 100% = 150 px) na cor dos pontos do item PPC da nota no mês (cheio sálvia, parcial ocre, zero vermelho), a linha tracejada da meta atravessando as colunas, o valor no mês de referência, no maior e no menor (em todos até oito meses) e o mês no eixo (com mais de oito meses, só a sigla; o ano no primeiro mês e em janeiro). Mês sem base: só o mês, apagado. As barras correm do primeiro ao último mês; o mouse abre o tooltip do mês.
	measure 'T3 · PPC · HTML coluna' =
			-- 1 · Leituras
			VAR _noRecorte = [Série · mês até a referência]
			VAR _n = [Série · meses até a referência]
			VAR _pos = [Série · posição na janela]
			VAR _mesAno = [Mês · rótulo curto]
			VAR _mesAbrev = [Mês · abreviado]
			VAR _ehRef = [Série · é o mês de referência]
			VAR _ppc = [Canteiro · PPC · foco no mês]
			VAR _pt = [Nota · pontos PPC · foco no mês]
			VAR _ps = [Nota · possíveis · PPC · foco no mês]
			VAR _extremo = [T3 · PPC · mês com rótulo]
			VAR _meta = [Nota · limite PPC · ponto cheio]
			VAR _nCom = [T3 · PPC · meses com PPC · foco]
			-- 3 · Geometria
			VAR _yMeta = 190 - ROUND ( _meta * 150, 0 ) -- geometria
			VAR _h = MAX ( 2, ROUND ( MIN ( _ppc, 1 ) * 150, 0 ) ) -- geometria
			VAR _yRot = 190 - _h - 20 -- geometria
			VAR _atraso = ( _pos - 1 ) * ROUND ( DIVIDE ( 420, _n ), 0 ) -- geometria
			-- 2 · Textos
			VAR _cls = IF ( ISBLANK ( _pt ), "", "q" & IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) )
			VAR _rotula = NOT ISBLANK ( _ppc ) && ( _ehRef = 1 || _extremo = 1 || _n <= 8 )
			VAR _txtV = FORMAT ( _ppc, "0%", "pt-BR" )
			VAR _comAno = _n <= 8 || _pos = 1 || _mesAbrev = "jan"
			VAR _rotMes = IF ( _comAno, _mesAno, _mesAbrev )
			-- 4 · Marcação
			VAR _saidaHtml =
			    IF (
			        _noRecorte = 1,
			        "<div class='u pm'><i class='l0 a-fd'></i>"
			            & IF ( _nCom > 0, "<i class='lm a-gx' style='top:" & _yMeta & "px;animation-delay:" & _atraso & "ms'></i>" )
			            & IF ( ISBLANK ( _ppc ), "", "<i class='b " & _cls & "' style='height:" & _h
			                & "px' data-rk='m" & _pos & "' data-rp='height' data-rd='" & _atraso & "'></i>" )
			            & IF ( _rotula, "<span class='v" & IF ( _cls = "q2", " ng", "" ) & "' style='top:" & _yRot & "px'>" & "⁅" & _txtV & "⁆" & "</span>" )
			            & "<span class='ms a-fd" & IF ( _ehRef = 1, " ref", IF ( ISBLANK ( _ppc ), " sem", "" ) ) & "' style='animation-delay:" & _atraso & "ms'>" & _rotMes & "</span>"
			            & IF ( _nCom = 0 && _pos = 1, "<p class='vz'>Sem PPC da obra na base complementar da janela.</p>" )
			        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
			    )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\PPC mês a mês
		lineageTag: fe92699e-3498-5d46-8d62-b93445247302

	/// Primeiro mês da sequência atual de PPC abaixo da meta que chega ao mês de referência (vazio quando o PPC de referência está na meta).
	measure 'T3 · PPC · abaixo da meta desde · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", VAR _v = [Canteiro · PPC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@v] ) )
			VAR _meta = [Nota · limite PPC · ponto cheio]
			VAR _ultimoOk = MAXX ( FILTER ( _com, [@v] >= _meta ), dMes[Mes] )
			VAR _abaixo = FILTER ( _com, [@v] < _meta && ( ISBLANK ( _ultimoOk ) || dMes[Mes] > _ultimoOk ) )
			RETURN
			    IF ( MAXX ( FILTER ( _com, dMes[Mes] = _ref ), [@v] ) < _meta, MINX ( _abaixo, dMes[Mes] ) )
		formatString: dd/mm/yyyy
		displayFolder: T3 Avanço físico\PPC mês a mês\Contas
		lineageTag: dda060b3-9135-55c0-8c1f-650721d521ce

	/// O maior PPC da obra em foco nos meses da janela; vazio sem base.
	measure 'T3 · PPC · maior na janela · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", VAR _v = [Canteiro · PPC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@v] ) )
			RETURN
			    MAXX ( _com, [@v] )
		formatString: 0.00%
		displayFolder: T3 Avanço físico\PPC mês a mês\Contas
		lineageTag: a3143fa0-151e-5f17-a522-7943b0e651bf

	/// O menor PPC da obra em foco nos meses da janela; vazio sem base.
	measure 'T3 · PPC · menor na janela · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", VAR _v = [Canteiro · PPC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@v] ) )
			RETURN
			    MINX ( _com, [@v] )
		formatString: 0.00%
		displayFolder: T3 Avanço físico\PPC mês a mês\Contas
		lineageTag: d1d7ae18-ea0e-516b-ab28-15b73c0f43bd

	/// Meses da janela com o PPC da obra em foco na base complementar.
	measure 'T3 · PPC · meses com PPC · foco' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", VAR _v = [Canteiro · PPC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
			VAR _com = FILTER ( _meses, NOT ISBLANK ( [@v] ) )
			RETURN
			    COUNTROWS ( _com ) + 0
		formatString: 0
		displayFolder: T3 Avanço físico\PPC mês a mês\Contas
