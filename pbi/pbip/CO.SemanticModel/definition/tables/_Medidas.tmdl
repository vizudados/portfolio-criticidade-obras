	/// Leitura do "?" do Avanço das obras, sobre o próprio painel (L065, Figma 317:5214, 461 × 468, condensada): quantas obras estão atrás do cronograma (atraso em meses acima de zero) e quais perdem pontos no item prazo da nota, o atraso médio da carteira (ponderado pelo orçamento), três destaques que contam (o executado compara o mesmo grupo do previsto; a obra de menor atraso) e a trajetória do físico de cada obra na janela, na ordem da nota — atrás, no previsto ou à frente, e quando cruzou o limite (as linhas entram de cima para baixo; Figma 352:8054). Lê a carteira (não muda com a obra em foco). Só lê contas.
	measure 'T3 · Leitura avanço · HTML' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _mesL = [Mês de referência · longo]
			VAR _mesN = [Mês de referência · nome]
			VAR _nObras = [Obras com análise · ref] + 0
			VAR _nComP = [T3 · Avanço · obras com atraso calculado] + 0
			VAR _atras = [T3 · Avanço · obras atrás do cronograma] + 0
			VAR _fora = [T3 · Avanço · obras fora do limite do físico] + 0
			VAR _lFora = [T3 · Avanço · obras fora do limite do físico (lista)]
			VAR _aCart = [Prazo · atraso médio (meses) · ref]
			VAR _eCart = [T3 · Avanço · executado acumulado das obras com previsto]
			VAR _pCart = [Físico · previsto acumulado · ref]
			VAR _lSem = [T3 · Avanço · obras sem previsto (lista)]
			VAR _adiant = [T3 · Avanço · obra de menor atraso]
			VAR _minA = [T3 · Avanço · menor atraso]
			VAR _comeco = [T3 · Avanço · obra mais no começo]
			VAR _comecoE = [T3 · Avanço · executado da obra mais no começo]
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@pos", [T3 · Avanço · posição],
			        "@d", [Físico · desvio acumulado p.p. · ref],
			        "@s", [T3 · Status desvio físico · ref],
			        "@ld", [T3 · Físico · lado do cronograma · ref],
			        "@sg", [T3 · Físico · sinal · início da sequência],
			        "@sga", [T3 · Físico · sinal · início da sequência anterior],
			        "@lda", [T3 · Físico · lado da sequência anterior],
			        "@mud", [T3 · Físico · mudanças de faixa (lista)],
			        "@ms", [T3 · Físico · maior status na série],
			        "@pm1", [T3 · Série · primeiro mês da obra],
			        "@n", [T3 · Série · meses da obra],
			        "@fim", [Obra · término previsto]
			    )
			-- 2 · Textos
			VAR _aCartA = ROUND ( ABS ( _aCart ), 1 )
			VAR _minAA = ROUND ( ABS ( _minA ), 1 )
			VAR _tecN = FORMAT ( ABS ( _eCart ) * 100, "0.0", "pt-BR" )
			VAR _tecS = IF ( ROUND ( _eCart * 100, 1 ) < 0, "−", "" )
			VAR _tecTxt = IF ( ISBLANK ( _eCart ), "—", _tecS & _tecN & "%" )
			VAR _tpcN = FORMAT ( ABS ( _pCart ) * 100, "0.0", "pt-BR" )
			VAR _tpcS = IF ( ROUND ( _pCart * 100, 1 ) < 0, "−", "" )
			VAR _tpcTxt = IF ( ISBLANK ( _pCart ), "—", _tpcS & _tpcN & "%" )
			VAR _tcoN = FORMAT ( ABS ( _comecoE ) * 100, "0.0", "pt-BR" )
			VAR _tcoS = IF ( ROUND ( _comecoE * 100, 1 ) < 0, "−", "" )
			VAR _tcoTxt = IF ( ISBLANK ( _comecoE ), "—", _tcoS & _tcoN & "%" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tacN = FORMAT ( _aCartA, "0.0", "pt-BR" )
			VAR _tacTxt = IF ( ISBLANK ( _aCart ), "—", _tacN )
			VAR _tmaN = FORMAT ( _minAA, "0.0", "pt-BR" )
			VAR _tmaTxt = IF ( ISBLANK ( _minA ), "—", _tmaN )
			VAR _tacKP = LEN ( _tacN ) > 0
			VAR _tacKN = IF ( _tacKP, _tacN )
			VAR _tacKS = SUBSTITUTE ( SUBSTITUTE ( _tacKN, ".", "" ), ",", "" )
			VAR _tacKT = IFERROR ( VALUE ( _tacKS ), -1 )
			VAR _tacKOk = _tacKP && _tacKT >= 2 && FORMAT ( _tacKT, REPT ( "0", LEN ( _tacKS ) ) ) = _tacKS
			VAR _tacKD = IF ( CONTAINSSTRING ( _tacKN, "," ), LEN ( _tacKN ) - SEARCH ( ",", _tacKN ), 0 )
			VAR _tacKM = IF ( CONTAINSSTRING ( _tacKN, "." ), "#,##0", "0" ) & IF ( _tacKD > 0, "." & REPT ( "0", _tacKD ) )
			VAR _tacKOd =
			    IF (
			        _tacKOk,
			        "<o-d><o-v>" & _tacKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tacKN, FORMAT ( ROUND ( _tacKT * [@odf] / 1000, 0 ) / POWER ( 10, _tacKD ), _tacKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tacN
			    )
			VAR _tacOd = IF ( ISBLANK ( _aCart ), _tacTxt, _tacKOd )
			VAR _tmaKP = LEN ( _tmaN ) > 0
			VAR _tmaKN = IF ( _tmaKP, _tmaN )
			VAR _tmaKS = SUBSTITUTE ( SUBSTITUTE ( _tmaKN, ".", "" ), ",", "" )
			VAR _tmaKT = IFERROR ( VALUE ( _tmaKS ), -1 )
			VAR _tmaKOk = _tmaKP && _tmaKT >= 2 && FORMAT ( _tmaKT, REPT ( "0", LEN ( _tmaKS ) ) ) = _tmaKS
			VAR _tmaKD = IF ( CONTAINSSTRING ( _tmaKN, "," ), LEN ( _tmaKN ) - SEARCH ( ",", _tmaKN ), 0 )
			VAR _tmaKM = IF ( CONTAINSSTRING ( _tmaKN, "." ), "#,##0", "0" ) & IF ( _tmaKD > 0, "." & REPT ( "0", _tmaKD ) )
			VAR _tmaKOd =
			    IF (
			        _tmaKOk,
			        "<o-d><o-v>" & _tmaKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tmaKN, FORMAT ( ROUND ( _tmaKT * [@odf] / 1000, 0 ) / POWER ( 10, _tmaKD ), _tmaKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tmaN
			    )
			VAR _tmaOd = IF ( ISBLANK ( _minA ), _tmaTxt, _tmaKOd )
			VAR _tecKP = LEN ( _tecN ) > 0
			VAR _tecKN = IF ( _tecKP, _tecN )
			VAR _tecKS = SUBSTITUTE ( SUBSTITUTE ( _tecKN, ".", "" ), ",", "" )
			VAR _tecKT = IFERROR ( VALUE ( _tecKS ), -1 )
			VAR _tecKOk = _tecKP && _tecKT >= 2 && FORMAT ( _tecKT, REPT ( "0", LEN ( _tecKS ) ) ) = _tecKS
			VAR _tecKD = IF ( CONTAINSSTRING ( _tecKN, "," ), LEN ( _tecKN ) - SEARCH ( ",", _tecKN ), 0 )
			VAR _tecKM = IF ( CONTAINSSTRING ( _tecKN, "." ), "#,##0", "0" ) & IF ( _tecKD > 0, "." & REPT ( "0", _tecKD ) )
			VAR _tecKOd =
			    IF (
			        _tecKOk,
			        "<o-d><o-v>" & _tecKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tecKN, FORMAT ( ROUND ( _tecKT * [@odf] / 1000, 0 ) / POWER ( 10, _tecKD ), _tecKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tecN
			    )
			VAR _tecOd = IF ( ISBLANK ( _eCart ), _tecTxt, _tecS & _tecKOd & "%" )
			VAR _tcoKP = LEN ( _tcoN ) > 0
			VAR _tcoKN = IF ( _tcoKP, _tcoN )
			VAR _tcoKS = SUBSTITUTE ( SUBSTITUTE ( _tcoKN, ".", "" ), ",", "" )
			VAR _tcoKT = IFERROR ( VALUE ( _tcoKS ), -1 )
			VAR _tcoKOk = _tcoKP && _tcoKT >= 2 && FORMAT ( _tcoKT, REPT ( "0", LEN ( _tcoKS ) ) ) = _tcoKS
			VAR _tcoKD = IF ( CONTAINSSTRING ( _tcoKN, "," ), LEN ( _tcoKN ) - SEARCH ( ",", _tcoKN ), 0 )
			VAR _tcoKM = IF ( CONTAINSSTRING ( _tcoKN, "." ), "#,##0", "0" ) & IF ( _tcoKD > 0, "." & REPT ( "0", _tcoKD ) )
			VAR _tcoKOd =
			    IF (
			        _tcoKOk,
			        "<o-d><o-v>" & _tcoKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcoKN, FORMAT ( ROUND ( _tcoKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcoKD ), _tcoKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcoN
			    )
			VAR _tcoOd = IF ( ISBLANK ( _comecoE ), _tcoTxt, _tcoS & _tcoKOd & "%" )
			VAR _txtSob = "LEITURA · AVANÇO DAS OBRAS · " & UPPER ( _mesL )
			VAR _parcial = _nComP < _nObras
			VAR _txtGrupo = SWITCH ( _nComP, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nComP, "0" ) ) & IF ( _parcial, " obras com curva prevista", " obras" )
			VAR _txtAtras =
			    SWITCH (
			        TRUE (),
			        _atras = 0, "Nenhuma das " & _txtGrupo & " está atrás do cronograma",
			        _atras = 1 && _nComP = 1, "A única obra está atrás do cronograma",
			        _atras = 1, "Uma das " & _txtGrupo & " está atrás do cronograma",
			        _atras = _nComP, "As " & _txtGrupo & " estão atrás do cronograma",
			        UPPER ( LEFT ( SWITCH ( _atras, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _atras, "0" ) ), 1 ) ) & MID ( SWITCH ( _atras, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _atras, "0" ) ), 2, 1000 ) & " das " & _txtGrupo & " estão atrás do cronograma"
			    )
			VAR _lfoN = _fora
			VAR _lfoPos = IF ( _lfoN >= 2, FIND ( "§", SUBSTITUTE ( _lFora, "|", "§", _lfoN - 1 ) ) )
			VAR _lfoTxt = SWITCH ( TRUE (), _lfoN = 0, "", _lfoN = 1, _lFora, SUBSTITUTE ( LEFT ( _lFora, _lfoPos - 1 ), "|", ", " ) & " e " & MID ( _lFora, _lfoPos + 1, 999 ) )
			VAR _txtFora =
			    SWITCH (
			        TRUE (),
			        _fora = 0, ", nenhuma perdendo pontos no prazo da nota",
			        _fora = 1, ", a " & _lfoTxt & " perdendo pontos no prazo da nota",
			        _fora = 2, ", " & _lfoTxt & " perdendo pontos no prazo da nota",
			        ", " & SWITCH ( _fora, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _fora, "0" ) ) & " perdendo pontos no prazo da nota"
			    )
			VAR _achado =
			    _txtAtras & _txtFora & "; o atraso médio da carteira é de " & _tacOd
			        & IF ( _aCartA <= 1, " mês", " meses" ) & IF ( ROUND ( _aCart, 1 ) < 0, " à frente.", "." )
			VAR _lsN = IF ( ISBLANK ( _lSem ) || _lSem = "", 0, PATHLENGTH ( _lSem ) )
			VAR _lsPos = IF ( _lsN >= 2, FIND ( "§", SUBSTITUTE ( _lSem, "|", "§", _lsN - 1 ) ) )
			VAR _lsTxt = SWITCH ( TRUE (), _lsN = 0, "", _lsN = 1, _lSem, SUBSTITUTE ( LEFT ( _lSem, _lsPos - 1 ), "|", ", " ) & " e " & MID ( _lSem, _lsPos + 1, 999 ) )
			VAR _rotD1 = "executado × " & "⁅" & _tpcTxt & "⁆" & " previsto" & IF ( _lsN = 1, ", sem a " & _lSem, IF ( _lsN > 1, ", só obras com previsto", "" ) )
			VAR _rotD2 = IF ( ROUND ( _minA, 1 ) < 0, "meses à frente: " & _adiant & ", a mais adiantada", IF ( _minAA <= 1, "mês de atraso: ", "meses de atraso: " ) & _adiant & ", a menos atrasada" )
			VAR _rotD3 = _comeco & ", a obra mais no começo"
			VAR _txtJanela = UPPER ( FORMAT ( _jan, "mmm/yy", "pt-BR" ) & " A " & FORMAT ( _ref, "mmm/yy", "pt-BR" ) )
			VAR _lista = FILTER ( _obras, NOT ISBLANK ( [@pos] ) ) /* lista */
			VAR _htmlTraj =
			    CONCATENATEX (
			        _lista,
			        VAR _d = [@d]
			        VAR _ld = [@ld]
			        VAR _sg = [@sg]
			        VAR _sga = [@sga]
			        VAR _mud = [@mud]
			        VAR _semP = ISBLANK ( _d )
			        VAR _nMud = IF ( ISBLANK ( _mud ) || _mud = "", 0, PATHLENGTH ( _mud ) )
			        VAR _sempreEst = _ld = -1 && [@ms] = 0
			        VAR _txtSinal =
			            SWITCH (
			                TRUE (),
			                _semP, "sem previsto na planilha",
			                _sempreEst, "atrás, sempre dentro do limite",
			                NOT ISBLANK ( _sga ),
			                    SWITCH ( [@lda], -1, "atrás", 0, "no previsto", 1, "à frente" ) & " " & IF ( EDATE ( _sg, -1 ) = _sga, "em " & FORMAT ( _sga, "mmm", "pt-BR" ), "de " & FORMAT ( _sga, "mmm", "pt-BR" ) & " a " & FORMAT ( EDATE ( _sg, -1 ), "mmm", "pt-BR" ) ) & "; " & SWITCH ( _ld, -1, "atrás", 0, "no previsto", 1, "à frente" ) & " desde " & FORMAT ( _sg, "mmm", "pt-BR" ),
			                _ld = -1, "atrás desde " & IF ( _sg = [@pm1] && [@pm1] > _jan, "a 1.ª aba, " & FORMAT ( _sg, "mmm", "pt-BR" ), FORMAT ( _sg, "mmm", "pt-BR" ) ),
			                _sg = [@pm1] && [@n] > 1, SWITCH ( _ld, -1, "atrás", 0, "no previsto", 1, "à frente" ) & " nos " & SWITCH ( [@n], 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( [@n], "0" ) ) & " meses",
			                SWITCH ( _ld, -1, "atrás", 0, "no previsto", 1, "à frente" ) & " desde " & FORMAT ( _sg, "mmm", "pt-BR" )
			            )
			        VAR _txtFaixa =
			            IF (
			                _semP || _sempreEst || _nMud = 0,
			                "",
			                "; " & CONCATENATEX (
			                    GENERATESERIES ( 1, _nMud ),
			                    VAR _it = SUBSTITUTE ( PATHITEM ( _mud, [Value] ), "§", "|" )
			                    VAR _para = PATHITEM ( _it, 4, INTEGER )
			                    VAR _nf = PATHITEM ( _it, 5, INTEGER )
			                    RETURN
			                        IF ( _para = 2, "fora do limite", "dentro do limite" ) & IF ( [Value] = _nMud && _nf > 1, " desde ", " em " ) & PATHITEM ( _it, 2 ),
			                    ", ",
			                    [Value], ASC
			                )
			            )
			        VAR _txtFim = IF ( [@fim] = _ref, "; termina em " & FORMAT ( _ref, "mmm", "pt-BR" ), "" )
			        VAR _mk = IF ( _semP, "sm", "mk mk" & [@s] )
			        RETURN
			            "<div class='tj" & IF ( _semP, " sp", "" ) & "' style='animation-delay:" & ( 400 + ( [@pos] - 1 ) * 80 )
			                & "ms'><i class='a-pop " & _mk & "' style='animation-delay:" & ( 500 + ( [@pos] - 1 ) * 80 ) & "ms'></i>"
			                & "<b>" & dObra[Obra] & "</b><span>" & _txtSinal & _txtFaixa & _txtFim
			                & "</span></div>",
			        "",
			        [@pos], ASC
			    )
			-- 4 · Marcação
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _achado & "</h2>"
			        & "<div class='dst sobre-creme'>" & "<div><b>" & _tecOd & "</b><span>" & _rotD1 & "</span></div>" & "<div><b>" & _tmaOd & "</b><span>" & _rotD2 & "</span></div>" & "<div><b>" & _tcoOd & "</b><span>" & _rotD3 & "</span></div>" & "</div>"
			        & "<div class='sec'><span class='vs'>" & "DETALHE · TRAJETÓRIA · " & _txtJanela & "</span>" & _htmlTraj & "</div>"
			VAR _saidaHtml =
			    IF ( _nObras > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura do Avanço das obras" & "'><div class='pn pn-p av'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Leituras
		lineageTag: 5678127e-6f80-5a55-bfb6-bcf0b94c44d7

	/// Leitura do "?" da Curva S, sobre o próprio painel (L065, Figma 317:5115, 1028 × 402, duas colunas): achado com o desvio e a tendência da distância, explicação (ritmo executado × previsto, o que o cronograma pede, a trajetória do físico na nota na janela: dentro ou fora do limite), três destaques que contam, como ler; à direita o que explica (justificativas da planilha) e o detalhe do desvio mês a mês na janela, com o limite da nota (as barras correm; x pela posição na janela). Obra sem previsto na planilha (Figma 352:7993): achado com o executado e a falta do previsto, sem desvio nem faixa, e o detalhe vira o executado do mês, mês a mês. Só lê contas.
	measure 'T3 · Leitura curva · HTML' =
			-- 1 · Leituras
			VAR _obra = [Nota · obra em foco]
			VAR _mesL = [Mês de referência · longo]
			VAR _mesN = [Mês de referência · nome]
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _nJan = [Série · meses até a referência]
			VAR _d = [Físico · desvio acumulado p.p. · foco]
			VAR _e = [Físico · executado acumulado · foco]
			VAR _s = [T3 · Status desvio físico · foco]
			VAR _lim = [Nota · limite prazo · ponto cheio]
			VAR _maxFF = [T3 · Prazo · máximo na nota]
			VAR _trv = [Nota · limite prazo · trava]
			VAR _notaMax = [Nota · nota · máximo]
			VAR _td = [T3 · Físico · tendência da distância · foco]
			VAR _tdd0 = [T3 · Físico · tendência da distância desde · foco]
			VAR _iniLado = [T3 · Físico · sinal · início da sequência · foco]
			VAR _tdd = IF ( NOT ISBLANK ( _iniLado ) && _iniLado > _tdd0, _iniLado, _tdd0 )
			VAR _abx = [T3 · Ritmo · executa abaixo desde · foco]
			VAR _acm = [T3 · Ritmo · executa acima desde · foco]
			VAR _pm1 = [T3 · Série · primeiro mês da obra · foco]
			VAR _n = [T3 · Série · meses da obra · foco]
			VAR _tp = [T3 · Ritmo · tendência do previsto · foco]
			VAR _te = [T3 · Ritmo · tendência do executado · foco]
			VAR _alc = [T3 · Ritmo · meses que alcançaram o previsto · foco]
			VAR _mMax = [T3 · Série · mês de maior executado · foco]
			VAR _eMax = [T3 · Série · executado no mês de maior executado · foco]
			VAR _mud = [T3 · Físico · mudanças de faixa (lista) · foco]
			VAR _ms = [T3 · Físico · maior status na série · foco]
			VAR _d1 = [T3 · Curva S · desvio no primeiro mês · foco]
			VAR _s1 = [T3 · Curva S · status no primeiro mês · foco]
			VAR _eMin = [T3 · Série · executado no mês de menor executado · foco]
			VAR _mMin = [T3 · Série · mês de menor executado · foco]
			VAR _des = [Desembolsado acumulado · foco]
			VAR _cred = [Crédito do orçamento · foco]
			VAR _jus = [T3 · Justificativas · grupos (lista) · foco]
			VAR _nAcima = [T3 · Justificativas · meses acima do previsto · foco]
			VAR _ddRef = [Desembolso · desvio no mês · foco]
			VAR _meses =
			    ADDCOLUMNS (
			        VALUES ( dMes[Mes] ),
			        "@ate", [Série · mês até a referência],
			        "@pj", [Série · posição na janela],
			        "@d", [T3 · Desvio físico p.p. · foco no mês],
			        "@s", [T3 · Status desvio físico · foco no mês],
			        "@em", [Físico · executado no mês · foco no mês],
			        "@rot", [Mês · abreviado]
			    )
			-- 2 · Textos
			VAR _semP = ISBLANK ( _d )
			VAR _dA = ABS ( _d )
			VAR _tdN = FORMAT ( ABS ( _d ), "0.0", "pt-BR" )
			VAR _tdS = SWITCH ( TRUE (), ROUND ( _d, 1 ) < 0, "−", ROUND ( _d, 1 ) > 0, "+", "" )
			VAR _tdTxt = IF ( ISBLANK ( _d ), "—", _tdS & _tdN & " p.p." )
			VAR _td1N = FORMAT ( ABS ( _d1 ), "0.0", "pt-BR" )
			VAR _td1S = SWITCH ( TRUE (), ROUND ( _d1, 1 ) < 0, "−", ROUND ( _d1, 1 ) > 0, "+", "" )
			VAR _td1Txt = IF ( ISBLANK ( _d1 ), "—", _td1S & _td1N & " p.p." )
			VAR _temN = FORMAT ( ABS ( _eMin ) * 100, "0.00", "pt-BR" )
			VAR _temS = IF ( ROUND ( _eMin * 100, 2 ) < 0, "−", "" )
			VAR _temTxt = IF ( ISBLANK ( _eMin ), "—", _temS & _temN & "%" )
			VAR _texN = FORMAT ( ABS ( _eMax ) * 100, "0.00", "pt-BR" )
			VAR _texS = IF ( ROUND ( _eMax * 100, 2 ) < 0, "−", "" )
			VAR _texTxt = IF ( ISBLANK ( _eMax ), "—", _texS & _texN & "%" )
			VAR _teaN = FORMAT ( ABS ( _e ) * 100, "0.0", "pt-BR" )
			VAR _teaS = IF ( ROUND ( _e * 100, 1 ) < 0, "−", "" )
			VAR _teaTxt = IF ( ISBLANK ( _e ), "—", _teaS & _teaN & "%" )
			VAR _tdsA = ABS ( _des )
			VAR _tdsNu = SWITCH ( TRUE (), _tdsA >= 99950000, FORMAT ( _tdsA / 1000000, "0.0", "pt-BR" ), _tdsA >= 999500, FORMAT ( _tdsA / 1000000, "0.00", "pt-BR" ), _tdsA >= 999.5, FORMAT ( _tdsA / 1000, "0", "pt-BR" ), FORMAT ( _tdsA, "#,0", "pt-BR" ) )
			VAR _tdsUn = SWITCH ( TRUE (), _tdsA >= 999500, " mi", _tdsA >= 999.5, " mil", "" )
			VAR _tdsN = _tdsNu & _tdsUn
			VAR _tdsZero = _tdsN = "0"
			VAR _tdsS = IF ( _tdsZero, "", IF ( _des < 0, "−", "" ) )
			VAR _tdsTxt = IF ( ISBLANK ( _des ), "—", _tdsS & "R$ " & _tdsN )
			VAR _tcrA = ABS ( _cred )
			VAR _tcrNu = SWITCH ( TRUE (), _tcrA >= 99950000, FORMAT ( _tcrA / 1000000, "0.0", "pt-BR" ), _tcrA >= 999500, FORMAT ( _tcrA / 1000000, "0.00", "pt-BR" ), _tcrA >= 999.5, FORMAT ( _tcrA / 1000, "0", "pt-BR" ), FORMAT ( _tcrA, "#,0", "pt-BR" ) )
			VAR _tcrUn = SWITCH ( TRUE (), _tcrA >= 999500, " mi", _tcrA >= 999.5, " mil", "" )
			VAR _tcrN = _tcrNu & _tcrUn
			VAR _tcrZero = _tcrN = "0"
			VAR _tcrS = IF ( _tcrZero, "", IF ( _cred < 0, "−", "" ) )
			VAR _tcrTxt = IF ( ISBLANK ( _cred ), "—", _tcrS & "R$ " & _tcrN )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _txtSob = "LEITURA · CURVA S · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( _obra ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " · " & UPPER ( _mesL )
			VAR _tl = FORMAT ( _lim, IF ( _lim = INT ( _lim ), "0", "0.0" ), "pt-BR" ) & IF ( _lim <= 1, " mês", " meses" )
			VAR _tMax = FORMAT ( _maxFF, "0.0#", "pt-BR" )
			VAR _ttv = FORMAT ( _trv, "0", "pt-BR" ) & IF ( _trv <= 1, " mês", " meses" )
			VAR _tNota = FORMAT ( _notaMax, "0", "pt-BR" )
			VAR _txtTend =
			    SWITCH (
			        TRUE (),
			        _d >= 0, ".",
			        _td = "cresce", ", e o atraso cresce desde " & IF ( _tdd = _jan || YEAR ( _tdd ) <> YEAR ( _ref ), FORMAT ( _tdd, "mmm/yy", "pt-BR" ), FORMAT ( _tdd, "mmmm", "pt-BR" ) ) & ".",
			        _td = "cai", ", e o atraso vem caindo desde " & IF ( _tdd = _jan || YEAR ( _tdd ) <> YEAR ( _ref ), FORMAT ( _tdd, "mmm/yy", "pt-BR" ), FORMAT ( _tdd, "mmmm", "pt-BR" ) ) & ".",
			        _td = "oscila", ", e o atraso oscila desde " & IF ( _tdd = _jan || YEAR ( _tdd ) <> YEAR ( _ref ), FORMAT ( _tdd, "mmm/yy", "pt-BR" ), FORMAT ( _tdd, "mmmm", "pt-BR" ) ) & ".",
			        "."
			    )
			VAR _lado = IF ( _d < 0, " p.p. atrás do cronograma", " p.p. à frente do cronograma" )
			-- o número-chave do achado conta (contador): o núcleo é o |desvio| com uma casa, sem sinal
			VAR _tkN = FORMAT ( _dA, "0.0", "pt-BR" )
			VAR _tkTxt = IF ( ISBLANK ( _dA ), "—", _tkN )
			VAR _tkKP = LEN ( _tkN ) > 0
			VAR _tkKN = IF ( _tkKP, _tkN )
			VAR _tkKS = SUBSTITUTE ( SUBSTITUTE ( _tkKN, ".", "" ), ",", "" )
			VAR _tkKT = IFERROR ( VALUE ( _tkKS ), -1 )
			VAR _tkKOk = _tkKP && _tkKT >= 2 && FORMAT ( _tkKT, REPT ( "0", LEN ( _tkKS ) ) ) = _tkKS
			VAR _tkKD = IF ( CONTAINSSTRING ( _tkKN, "," ), LEN ( _tkKN ) - SEARCH ( ",", _tkKN ), 0 )
			VAR _tkKM = IF ( CONTAINSSTRING ( _tkKN, "." ), "#,##0", "0" ) & IF ( _tkKD > 0, "." & REPT ( "0", _tkKD ) )
			VAR _tkKOd =
			    IF (
			        _tkKOk,
			        "<o-d><o-v>" & _tkKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tkKN, FORMAT ( ROUND ( _tkKT * [@odf] / 1000, 0 ) / POWER ( 10, _tkKD ), _tkKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tkN
			    )
			VAR _tkOd = IF ( ISBLANK ( _dA ), _tkTxt, _tkKOd )
			VAR _tdKP = LEN ( _tdN ) > 0
			VAR _tdKN = IF ( _tdKP, _tdN )
			VAR _tdKS = SUBSTITUTE ( SUBSTITUTE ( _tdKN, ".", "" ), ",", "" )
			VAR _tdKT = IFERROR ( VALUE ( _tdKS ), -1 )
			VAR _tdKOk = _tdKP && _tdKT >= 2 && FORMAT ( _tdKT, REPT ( "0", LEN ( _tdKS ) ) ) = _tdKS
			VAR _tdKD = IF ( CONTAINSSTRING ( _tdKN, "," ), LEN ( _tdKN ) - SEARCH ( ",", _tdKN ), 0 )
			VAR _tdKM = IF ( CONTAINSSTRING ( _tdKN, "." ), "#,##0", "0" ) & IF ( _tdKD > 0, "." & REPT ( "0", _tdKD ) )
			VAR _tdKOd =
			    IF (
			        _tdKOk,
			        "<o-d><o-v>" & _tdKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdKN, FORMAT ( ROUND ( _tdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdKD ), _tdKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdN
			    )
			VAR _tdOd = IF ( ISBLANK ( _d ), _tdTxt, _tdS & _tdKOd & " p.p." )
			VAR _teaKP = LEN ( _teaN ) > 0
			VAR _teaKN = IF ( _teaKP, _teaN )
			VAR _teaKS = SUBSTITUTE ( SUBSTITUTE ( _teaKN, ".", "" ), ",", "" )
			VAR _teaKT = IFERROR ( VALUE ( _teaKS ), -1 )
			VAR _teaKOk = _teaKP && _teaKT >= 2 && FORMAT ( _teaKT, REPT ( "0", LEN ( _teaKS ) ) ) = _teaKS
			VAR _teaKD = IF ( CONTAINSSTRING ( _teaKN, "," ), LEN ( _teaKN ) - SEARCH ( ",", _teaKN ), 0 )
			VAR _teaKM = IF ( CONTAINSSTRING ( _teaKN, "." ), "#,##0", "0" ) & IF ( _teaKD > 0, "." & REPT ( "0", _teaKD ) )
			VAR _teaKOd =
			    IF (
			        _teaKOk,
			        "<o-d><o-v>" & _teaKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _teaKN, FORMAT ( ROUND ( _teaKT * [@odf] / 1000, 0 ) / POWER ( 10, _teaKD ), _teaKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _teaN
			    )
			VAR _teaOd = IF ( ISBLANK ( _e ), _teaTxt, _teaS & _teaKOd & "%" )
			VAR _achado =
			    SWITCH (
			        TRUE (),
			        _semP, "A " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " fecha " & _mesN & " com " & _teaOd
			            & " executado, mas a planilha não traz o previsto: não há cronograma para medir atraso.",
			        ROUND ( _d, 1 ) = 0, "A " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " fecha " & _mesN & " no ritmo do cronograma (" & _tdOd & ").",
			        "A " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " fecha " & _mesN & " " & _tkOd & _lado & _txtTend
			    )
			VAR _txtE1 =
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _abx ),
			            "A obra executa menos do que o previsto desde "
			                & IF ( _abx = _pm1 && _pm1 > _jan, "a primeira aba, em " & FORMAT ( _pm1, "mmmm", "pt-BR" ), IF ( _abx = _jan || YEAR ( _abx ) <> YEAR ( _ref ), FORMAT ( _abx, "mmm/yy", "pt-BR" ), FORMAT ( _abx, "mmmm", "pt-BR" ) ) ) & ".",
			        NOT ISBLANK ( _acm ),
			            "A obra executa o previsto ou mais desde "
			                & IF ( _acm = _pm1 && _pm1 > _jan, "a primeira aba, em " & FORMAT ( _pm1, "mmmm", "pt-BR" ), IF ( _acm = _jan || YEAR ( _acm ) <> YEAR ( _ref ), FORMAT ( _acm, "mmm/yy", "pt-BR" ), FORMAT ( _acm, "mmmm", "pt-BR" ) ) ) & ".",
			        ""
			    )
			VAR _txtRitmo = SWITCH ( _tp, "acelera", "acelera a cada mês", "desacelera", "desacelera a cada mês", "constante", "é constante", "varia de mês a mês" )
			VAR _txtE2 =
			    " O cronograma pede um ritmo que " & _txtRitmo
			        & IF (
			            _alc = 0,
			            " e a execução não acompanhou: nem no melhor mês, " & FORMAT ( _mMax, "mmmm", "pt-BR" ) & ", ela alcançou o previsto.",
			            "; a execução alcançou o previsto em " & SWITCH ( _alc, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _alc, "0" ) ) & " dos " & SWITCH ( _n, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses."
			        )
			VAR _nMud = IF ( ISBLANK ( _mud ) || _mud = "", 0, PATHLENGTH ( _mud ) )
			VAR _frases =
			    CONCATENATEX (
			        GENERATESERIES ( 1, MAX ( _nMud, 1 ) ),
			        VAR _it = SUBSTITUTE ( PATHITEM ( _mud, [Value] ), "§", "|" )
			        VAR _nm = PATHITEM ( _it, 1 )
			        VAR _de = PATHITEM ( _it, 3, INTEGER )
			        VAR _para = PATHITEM ( _it, 4, INTEGER )
			        VAR _nf = PATHITEM ( _it, 5, INTEGER )
			        VAR _sep = IF ( [Value] = 1, "", IF ( [Value] = _nMud, " e ", ", " ) )
			        RETURN
			            _sep & IF ( _para = 2, "passou do limite da nota em " & _nm, "em " & _nm & " voltou para dentro do limite" )
			                & IF ( [Value] < _nMud && _nf >= 2, ", ficou " & SWITCH ( _nf, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nf, "0" ) ) & " meses " & IF ( _para = 2, "fora do limite", "dentro do limite" ), "" ),
			        "",
			        [Value], ASC
			    )
			VAR _txtE3 =
			    IF (
			        _nMud = 0,
			        IF ( _ms = 2, " O atraso ficou acima do limite da nota " & IF ( _n = 1, "no único mês", "em todos os " & SWITCH ( _n, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses" ), " O atraso nunca passou do limite da nota " & IF ( _n = 1, "no único mês", "nos " & SWITCH ( _n, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " meses" ) ) & ".",
			        " O físico " & _frases & "."
			    )
			VAR _txtExecMes = SWITCH ( _te, "cresce", "cresce", "cai", "cai", "constante", "se repete", "oscila" )
			VAR _explica =
			    IF (
			        _semP,
			        "As abas trazem o previsto em branco: a curva mostra só o executado, sem área de atraso, e o desvio e o "
			            & "ponto do físico ficam vazios — não valem zero.",
			        _txtE1 & _txtE2 & _txtE3
			    )
			VAR _rotD1 = "desvio em " & FORMAT ( _pm1, "mmmm", "pt-BR" ) & ", "
			    & IF ( _s1 = 2, "já fora do limite", IF ( _s = 2, "ainda dentro do limite", "dentro do limite" ) )
			VAR _rotMin = "executado no mês mais fraco, " & FORMAT ( _mMin, "mmmm", "pt-BR" )
			VAR _rotMax = "executado no melhor mês, " & FORMAT ( _mMax, "mmmm", "pt-BR" )
			VAR _rotD3 = "pagos até " & _mesN & "; " & "⁅" & _tcrTxt & "⁆" & " de obra executada"
			VAR _td1KP = LEN ( _td1N ) > 0
			VAR _td1KN = IF ( _td1KP, _td1N )
			VAR _td1KS = SUBSTITUTE ( SUBSTITUTE ( _td1KN, ".", "" ), ",", "" )
			VAR _td1KT = IFERROR ( VALUE ( _td1KS ), -1 )
			VAR _td1KOk = _td1KP && _td1KT >= 2 && FORMAT ( _td1KT, REPT ( "0", LEN ( _td1KS ) ) ) = _td1KS
			VAR _td1KD = IF ( CONTAINSSTRING ( _td1KN, "," ), LEN ( _td1KN ) - SEARCH ( ",", _td1KN ), 0 )
			VAR _td1KM = IF ( CONTAINSSTRING ( _td1KN, "." ), "#,##0", "0" ) & IF ( _td1KD > 0, "." & REPT ( "0", _td1KD ) )
			VAR _td1KOd =
			    IF (
			        _td1KOk,
			        "<o-d><o-v>" & _td1KN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _td1KN, FORMAT ( ROUND ( _td1KT * [@odf] / 1000, 0 ) / POWER ( 10, _td1KD ), _td1KM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _td1N
			    )
			VAR _td1Od = IF ( ISBLANK ( _d1 ), _td1Txt, _td1S & _td1KOd & " p.p." )
			VAR _temKP = LEN ( _temN ) > 0
			VAR _temKN = IF ( _temKP, _temN )
			VAR _temKS = SUBSTITUTE ( SUBSTITUTE ( _temKN, ".", "" ), ",", "" )
			VAR _temKT = IFERROR ( VALUE ( _temKS ), -1 )
			VAR _temKOk = _temKP && _temKT >= 2 && FORMAT ( _temKT, REPT ( "0", LEN ( _temKS ) ) ) = _temKS
			VAR _temKD = IF ( CONTAINSSTRING ( _temKN, "," ), LEN ( _temKN ) - SEARCH ( ",", _temKN ), 0 )
			VAR _temKM = IF ( CONTAINSSTRING ( _temKN, "." ), "#,##0", "0" ) & IF ( _temKD > 0, "." & REPT ( "0", _temKD ) )
			VAR _temKOd =
			    IF (
			        _temKOk,
			        "<o-d><o-v>" & _temKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _temKN, FORMAT ( ROUND ( _temKT * [@odf] / 1000, 0 ) / POWER ( 10, _temKD ), _temKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _temN
			    )
			VAR _temOd = IF ( ISBLANK ( _eMin ), _temTxt, _temS & _temKOd & "%" )
			VAR _texKP = LEN ( _texN ) > 0
			VAR _texKN = IF ( _texKP, _texN )
			VAR _texKS = SUBSTITUTE ( SUBSTITUTE ( _texKN, ".", "" ), ",", "" )
			VAR _texKT = IFERROR ( VALUE ( _texKS ), -1 )
			VAR _texKOk = _texKP && _texKT >= 2 && FORMAT ( _texKT, REPT ( "0", LEN ( _texKS ) ) ) = _texKS
			VAR _texKD = IF ( CONTAINSSTRING ( _texKN, "," ), LEN ( _texKN ) - SEARCH ( ",", _texKN ), 0 )
			VAR _texKM = IF ( CONTAINSSTRING ( _texKN, "." ), "#,##0", "0" ) & IF ( _texKD > 0, "." & REPT ( "0", _texKD ) )
			VAR _texKOd =
			    IF (
			        _texKOk,
			        "<o-d><o-v>" & _texKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _texKN, FORMAT ( ROUND ( _texKT * [@odf] / 1000, 0 ) / POWER ( 10, _texKD ), _texKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _texN
			    )
			VAR _texOd = IF ( ISBLANK ( _eMax ), _texTxt, _texS & _texKOd & "%" )
			VAR _tdsKP = LEN ( _tdsNu ) > 0
			VAR _tdsKN = IF ( _tdsKP, _tdsNu )
			VAR _tdsKS = SUBSTITUTE ( SUBSTITUTE ( _tdsKN, ".", "" ), ",", "" )
			VAR _tdsKT = IFERROR ( VALUE ( _tdsKS ), -1 )
			VAR _tdsKOk = _tdsKP && _tdsKT >= 2 && FORMAT ( _tdsKT, REPT ( "0", LEN ( _tdsKS ) ) ) = _tdsKS
			VAR _tdsKD = IF ( CONTAINSSTRING ( _tdsKN, "," ), LEN ( _tdsKN ) - SEARCH ( ",", _tdsKN ), 0 )
			VAR _tdsKM = IF ( CONTAINSSTRING ( _tdsKN, "." ), "#,##0", "0" ) & IF ( _tdsKD > 0, "." & REPT ( "0", _tdsKD ) )
			VAR _tdsKOd =
			    IF (
			        _tdsKOk,
			        "<o-d><o-v>" & _tdsKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tdsKN, FORMAT ( ROUND ( _tdsKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdsKD ), _tdsKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tdsNu
			    )
			VAR _tdsOd = IF ( ISBLANK ( _des ), _tdsTxt, _tdsS & "R$ " & _tdsKOd & _tdsUn )
			VAR _g1 = SUBSTITUTE ( PATHITEM ( _jus, 1 ), "§", "|" )
			VAR _g2 = SUBSTITUTE ( PATHITEM ( _jus, 2 ), "§", "|" )
			VAR _t1 = PATHITEM ( _g1, 1 )
			VAR _t2 = PATHITEM ( _g2, 1 )
			VAR _n1 = PATHITEM ( _g1, 2, INTEGER )
			VAR _n2 = PATHITEM ( _g2, 2, INTEGER )
			VAR _t1s = IF ( RIGHT ( _t1, 1 ) = ".", LEFT ( _t1, LEN ( _t1 ) - 1 ), _t1 )
			VAR _t1m = IF ( EXACT ( UPPER ( _t1s ), _t1s ), _t1s, LOWER ( LEFT ( _t1s, 1 ) ) & MID ( _t1s, 2, LEN ( _t1s ) ) )
			VAR _t1e = SEARCH ( " ", _t1m, 56, 0 )
			VAR _t1L = IF ( LEN ( _t1m ) <= 72, _t1m, LEFT ( _t1m, IF ( _t1e > 0 && _t1e <= 71, _t1e - 1, 70 ) ) & "…" )
			VAR _txtOqe =
			    SWITCH (
			        TRUE (),
			        _nAcima = 0, "O desembolso acompanhou o previsto em todos os meses; o atraso não veio de falta de dinheiro.",
			        ISBLANK ( _jus ) || _jus = "", "A planilha não traz justificativa para o desembolso acima do previsto em nenhum mês.",
			        _d < 0 && _ddRef > 0,
			            "Pela planilha, o gasto acima do previsto foi justificado em " & IF ( _n1 = 1, "um mês", SWITCH ( _n1, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n1, "0" ) ) & " meses" ) & " como " & _t1L
			            & IF ( RIGHT ( _t1L, 1 ) = "…", " ", ". " ) & "A obra paga para recuperar o prazo.",
			        ISBLANK ( _t2 ) || _t2 = "",
			            "Pela planilha, o gasto acima do previsto foi justificado em " & IF ( _n1 = 1, "um mês", SWITCH ( _n1, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n1, "0" ) ) & " meses" ) & " como " & _t1L & IF ( RIGHT ( _t1L, 1 ) = "…", "", "." ),
			        "Pela planilha, o gasto acima do previsto foi justificado em " & IF ( _n1 = 1, "um mês", SWITCH ( _n1, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n1, "0" ) ) & " meses" ) & " como " & _t1L
			            & IF ( RIGHT ( _t1L, 1 ) = "…", " ", "; " ) & "em " & IF ( _n2 = 1, "outro mês", SWITCH ( _n2, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n2, "0" ) ) & " meses" ) & ", por outro motivo."
			    )
			-- 3 · Geometria
			VAR _serie = FILTER ( _meses, [@ate] = 1 ) /* lista */
			VAR _com = FILTER ( _serie, NOT ISBLANK ( [@d] ) ) /* lista */
			VAR _colW = INT ( DIVIDE ( 220, _nJan ) ) /* geometria */
			VAR _bw = MIN ( 18, _colW - 8 ) -- geometria
			VAR _maxPos = MAXX ( _com, MAX ( [@d], 0 ) ) /* geometria */
			VAR _maxNeg = MAXX ( _com, MAX ( - [@d], 0 ) ) /* geometria */
			VAR _negSpan = MAX ( _maxNeg, 1 ) /* geometria */
			VAR _k = MIN ( 10, DIVIDE ( 40, _maxPos + _negSpan ) ) /* geometria */
			VAR _base = 8 + ROUND ( _maxPos * _k, 0 ) /* geometria */
			VAR _yMes = 8 + 40 + 6 /* geometria */
			VAR _alt = _yMes + 16 /* geometria */
			VAR _colE = INT ( DIVIDE ( 320, _nJan ) ) /* geometria */
			VAR _bwE = MIN ( 20, _colE - 10 ) -- geometria
			VAR _maxEm = MAXX ( _serie, [@em] ) /* geometria */
			VAR _barras =
			    CONCATENATEX (
			        _serie,
			        VAR _v = [@d]
			        VAR _x = ( [@pj] - 1 ) * _colW /* geometria */
			        VAR _zero = NOT ISBLANK ( _v ) && ROUND ( _v, 1 ) = 0 -- geometria
			        VAR _h = IF ( ISBLANK ( _v ), 0, IF ( _zero, 2, MAX ( 1, ROUND ( ABS ( _v ) * _k, 0 ) ) ) ) /* geometria */
			        VAR _atraso = 300 + ( [@pj] - 1 ) * 120 /* geometria */
			        RETURN
			            "<span class='ms a-fd' style='left:" & _x & "px;width:" & _colW & "px;top:" & _yMes & "px;animation-delay:" & _atraso & "ms'>" & [@rot] & "</span>"
			                & IF (
			                    NOT ISBLANK ( _v ),
			                    "<i class='b " & IF ( _zero, "z", "s" & [@s] ) & "' style='left:" & ( _x + INT ( ( _colW - _bw ) / 2 ) )
			                        & "px;width:" & _bw & "px;" & IF ( _v >= 0, "top:auto;bottom:" & ( _alt - _base ), "top:" & _base )
			                        & "px;height:" & _h & "px' data-rk='c" & [@pj] & "' data-rp='height' data-rd='" & _atraso & "'></i>"
			                ),
			        "",
			        [@pj], ASC
			    )
			VAR _barrasE =
			    CONCATENATEX (
			        _serie,
			        VAR _x = ( [@pj] - 1 ) * _colE /* geometria */
			        VAR _h = IF ( ISBLANK ( [@em] ), 0, MAX ( 1, ROUND ( DIVIDE ( [@em], _maxEm ) * 30, 0 ) ) ) /* geometria */
			        VAR _atraso = 300 + ( [@pj] - 1 ) * 120 /* geometria */
			        RETURN
			            "<span class='ms a-fd' style='left:" & _x & "px;width:" & _colE & "px;top:40px;animation-delay:" & _atraso & "ms'>" & [@rot] & "</span>"
			                & IF (
			                    NOT ISBLANK ( [@em] ) && _h > 0,
			                    "<i class='b e' style='left:" & ( _x + INT ( ( _colE - _bwE ) / 2 ) ) & "px;width:" & _bwE
			                        & "px;top:auto;bottom:22px;height:" & _h & "px' data-rk='c" & [@pj] & "' data-rp='height' data-rd='"
			                        & _atraso & "'></i>"
			                ),
			        "",
			        [@pj], ASC
			    )
			-- 4 · Marcação
			VAR _htmlDet =
			    IF (
			        _semP,
			        "<div class='bp' style='height:56px'>" & _barrasE & "<i class='ax a-gx' style='top:34px;width:320px'></i></div>",
			        "<div class='bp' style='height:" & _alt & "px'>" & _barras
			            & "</div>"
			    )
			VAR _rotDet = IF ( _semP, "DETALHE · EXECUTADO NO MÊS · %", "DETALHE · DESVIO MÊS A MÊS · P.P." )
			VAR _htmlDst =
			    IF (
			        _semP,
			        "<div class='dst sobre-creme'>" & "<div><b>" & _temOd & "</b><span>" & _rotMin & "</span></div>" & "<div><b>" & _texOd & "</b><span>" & _rotMax & "</span></div>" & "<div><b>" & _tdsOd & "</b><span>" & _rotD3 & "</span></div>" & "</div>",
			        "<div class='dst sobre-creme'>" & "<div><b>" & IF ( ROUND ( _d1, 1 ) < 0, "<span class='ng'>" & _td1Od & "</span>", _td1Od ) & "</b><span>" & _rotD1 & "</span></div>" & "<div><b>" & _temOd & "</b><span>" & _rotMin & "</span></div>" & "<div><b>" & _tdsOd & "</b><span>" & _rotD3 & "</span></div>" & "</div>"
			    )
			VAR _esq =
			    "<div class='esq'><span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _achado & "</h2>"
			        & "<p class='exp'>" & _explica & "</p>" & _htmlDst
			    & "</div>"
			VAR _dir =
			    "<div class='dir'>" & "<div class='sec'><span class='vs'>" & "O QUE EXPLICA" & "</span>" & "<p class='oqe oq5'>" & _txtOqe & "</p>" & "</div>"
			        & "<div class='sec'><span class='vs'>" & _rotDet & "</span>" & _htmlDet & "</div>"
			        & "<div class='sec'><span class='vs'>" & "COMO LER" & "</span>" & IF ( _semP, "<p class='cl'>Sólido = executado acumulado, em % do orçamento. Sem previsto na planilha não há tracejado nem área de atraso; o desvio e o ponto do físico na nota ficam vazios.</p>", "<p class='cl'>Tracejado = previsto; sólido = executado; a área entre eles é o atraso. Na nota vale o atraso em meses: até " & "⁅" & _tl & "⁆" & ", " & "⁅" & _tMax & "⁆" & " pontos; os pontos caem até zero com mais de " & "⁅" & _ttv & "⁆" & ", e a obra fica crítica.</p>" ) & "</div>"
			    & "</div>"
			VAR _corpo = "<div class='cols'>" & _esq & _dir & "</div>"
			VAR _saidaHtml =
			    IF ( NOT ISBLANK ( _e ), "<div class='u lv' role='dialog' aria-label='" & "Leitura da Curva S" & "'><div class='pn pn-g'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Leituras
		lineageTag: 8cf96783-6467-55b6-ac81-d6b0b7f82599

	/// Leitura do "?" da Linha do tempo das obras, sobre o próprio painel (L065, Figma 317:5261, 1028 × 340, duas colunas): quantas obras em andamento e a entrar e quem termina, a fase do canteiro (as mais novas, as perto do fim com atraso, as que atrasam cedo), onde cai o término projetado (F3: quem passa da entrega contratual e quem passa dos 180 dias de tolerância), três destaques (o orçamento conta; datas não), o que explica (orçamento das a iniciar e o tipo de orçamento pela fase) e a tabela das obras a iniciar. Lê a carteira. Só lê contas.
	measure 'T3 · Leitura linha · HTML' =
			-- 1 · Leituras
			VAR _ref = [Mês de referência]
			VAR _mesL = [Mês de referência · longo]
			VAR _mesN = [Mês de referência · nome]
			VAR _nAnd = [Obras com análise · ref] + 0
			VAR _nAI = [T3 · Linha do tempo · obras a iniciar] + 0
			VAR _tipoAI = [T3 · Linha do tempo · tipo das obras a iniciar]
			VAR _uiAI = [T3 · Linha do tempo · último início a iniciar]
			VAR _antiga = [T3 · Linha do tempo · obra mais antiga]
			VAR _iniAntiga = [T3 · Linha do tempo · primeiro início em andamento]
			VAR _dist = [T3 · Linha do tempo · obra de término mais distante]
			VAR _fimDist = [T3 · Linha do tempo · término mais distante em andamento]
			VAR _mOrc = [T3 · Linha do tempo · obra de maior orçamento]
			VAR _vOrc = [T3 · Linha do tempo · maior orçamento]
			VAR _termina = [T3 · Linha do tempo · obra que termina no mês]
			VAR _prox = [T3 · Linha do tempo · próxima a terminar]
			VAR _fimProx = [T3 · Linha do tempo · término da próxima a terminar]
			VAR _lCom = [T3 · Linha do tempo · obras no começo (lista)]
			VAR _lPerto = [T3 · Linha do tempo · obras perto do fim com atraso (lista)]
			VAR _fimPerto = [T3 · Linha do tempo · término da primeira perto do fim]
			VAR _lCedo = [T3 · Linha do tempo · obras com atraso cedo (lista)]
			VAR _anosCedo = [T3 · Linha do tempo · anos de término com atraso cedo (lista)]
			VAR _tExecutivo = [T3 · Linha do tempo · obras com orçamento executivo (lista)]
			VAR _tPreliminar = [T3 · Linha do tempo · obras com orçamento preliminar (lista)]
			VAR _tLegal = [T3 · Linha do tempo · obras com orçamento legal (lista)]
			VAR _tAlvo = [T3 · Linha do tempo · obras com orçamento alvo (lista)]
			VAR _tFinal = [T3 · Linha do tempo · obras com orçamento final (lista)]
			VAR _aiLista = [T3 · Linha do tempo · obras a iniciar (lista)]
			VAR _lDepois = [T3 · Linha do tempo · obras depois da entrega (lista)]
			VAR _lAlem = [T3 · Linha do tempo · obras além da tolerância (lista)]
			-- 2 · Textos
			VAR _nAL = IF ( _aiLista = "", 0, PATHLENGTH ( _aiLista ) )
			VAR _aIniciar = ADDCOLUMNS ( GENERATESERIES ( 1, _nAL ), "@obra", PATHITEM ( _aiLista, [Value] ) )
			VAR _lista =
			    GENERATE (
			        _aIniciar,
			        VAR _ob = [@obra]
			        RETURN
			            ROW (
			                "@ini", CALCULATE ( [Obra · início], dObra[Obra] = _ob ),
			                "@fim", CALCULATE ( [Obra · término previsto], dObra[Obra] = _ob ),
			                "@orc", CALCULATE ( [T3 · Obra · orçamento cronograma], dObra[Obra] = _ob )
			            )
			    )
			VAR _tvoA = ABS ( _vOrc )
			VAR _tvoNu = SWITCH ( TRUE (), _tvoA >= 99950000, FORMAT ( _tvoA / 1000000, "0.0", "pt-BR" ), _tvoA >= 999500, FORMAT ( _tvoA / 1000000, "0.00", "pt-BR" ), _tvoA >= 999.5, FORMAT ( _tvoA / 1000, "0", "pt-BR" ), FORMAT ( _tvoA, "#,0", "pt-BR" ) )
			VAR _tvoUn = SWITCH ( TRUE (), _tvoA >= 999500, " mi", _tvoA >= 999.5, " mil", "" )
			VAR _tvoN = _tvoNu & _tvoUn
			VAR _tvoZero = _tvoN = "0"
			VAR _tvoS = IF ( _tvoZero, "", IF ( _vOrc < 0, "−", "" ) )
			VAR _tvoTxt = IF ( ISBLANK ( _vOrc ), "—", _tvoS & "R$ " & _tvoN )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tvoKP = LEN ( _tvoNu ) > 0
			VAR _tvoKN = IF ( _tvoKP, _tvoNu )
			VAR _tvoKS = SUBSTITUTE ( SUBSTITUTE ( _tvoKN, ".", "" ), ",", "" )
			VAR _tvoKT = IFERROR ( VALUE ( _tvoKS ), -1 )
			VAR _tvoKOk = _tvoKP && _tvoKT >= 2 && FORMAT ( _tvoKT, REPT ( "0", LEN ( _tvoKS ) ) ) = _tvoKS
			VAR _tvoKD = IF ( CONTAINSSTRING ( _tvoKN, "," ), LEN ( _tvoKN ) - SEARCH ( ",", _tvoKN ), 0 )
			VAR _tvoKM = IF ( CONTAINSSTRING ( _tvoKN, "." ), "#,##0", "0" ) & IF ( _tvoKD > 0, "." & REPT ( "0", _tvoKD ) )
			VAR _tvoKOd =
			    IF (
			        _tvoKOk,
			        "<o-d><o-v>" & _tvoKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tvoKN, FORMAT ( ROUND ( _tvoKT * [@odf] / 1000, 0 ) / POWER ( 10, _tvoKD ), _tvoKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tvoNu
			    )
			VAR _tvoOd = IF ( ISBLANK ( _vOrc ), _tvoTxt, _tvoS & "R$ " & _tvoKOd & _tvoUn )
			VAR _txtSob = "LEITURA · LINHA DO TEMPO DAS OBRAS · " & UPPER ( _mesL )
			VAR _txtEntrar =
			    IF (
			        _nAI = 0,
			        " e nenhuma a entrar",
			        " e " & SWITCH ( _nAI, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAI, "0" ) ) & " a entrar " & IF ( YEAR ( _uiAI ) = YEAR ( _ref ), "ainda em " & YEAR ( _ref ), "até " & FORMAT ( _uiAI, "mmm/yy", "pt-BR" ) )
			    )
			VAR _txtTermina =
			    IF (
			        _termina <> "" && NOT ISBLANK ( _termina ),
			        "; a " & _termina & IF ( _termina = _antiga, ", a mais antiga,", "" ) & " termina agora em " & _mesN & ".",
			        IF ( ISBLANK ( _prox ), ".", "; a próxima a terminar é a " & _prox & ", em " & FORMAT ( _fimProx, "mmm/yy", "pt-BR" ) & "." )
			    )
			VAR _achado = UPPER ( LEFT ( SWITCH ( _nAnd, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAnd, "0" ) ), 1 ) ) & MID ( SWITCH ( _nAnd, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAnd, "0" ) ), 2, 1000 ) & IF ( _nAnd = 1, " obra em andamento", " obras em andamento" ) & _txtEntrar & _txtTermina
			VAR _lcN = IF ( ISBLANK ( _lCom ) || _lCom = "", 0, PATHLENGTH ( _lCom ) )
			VAR _lcPos = IF ( _lcN >= 2, FIND ( "§", SUBSTITUTE ( _lCom, "|", "§", _lcN - 1 ) ) )
			VAR _lcTxt = SWITCH ( TRUE (), _lcN = 0, "", _lcN = 1, _lCom, SUBSTITUTE ( LEFT ( _lCom, _lcPos - 1 ), "|", ", " ) & " e " & MID ( _lCom, _lcPos + 1, 999 ) )
			VAR _lpN = IF ( ISBLANK ( _lPerto ) || _lPerto = "", 0, PATHLENGTH ( _lPerto ) )
			VAR _lpPos = IF ( _lpN >= 2, FIND ( "§", SUBSTITUTE ( _lPerto, "|", "§", _lpN - 1 ) ) )
			VAR _lpTxt = SWITCH ( TRUE (), _lpN = 0, "", _lpN = 1, _lPerto, SUBSTITUTE ( LEFT ( _lPerto, _lpPos - 1 ), "|", ", " ) & " e " & MID ( _lPerto, _lpPos + 1, 999 ) )
			VAR _lcdN = IF ( ISBLANK ( _lCedo ) || _lCedo = "", 0, PATHLENGTH ( _lCedo ) )
			VAR _lcdPos = IF ( _lcdN >= 2, FIND ( "§", SUBSTITUTE ( _lCedo, "|", "§", _lcdN - 1 ) ) )
			VAR _lcdTxt = SWITCH ( TRUE (), _lcdN = 0, "", _lcdN = 1, _lCedo, SUBSTITUTE ( LEFT ( _lCedo, _lcdPos - 1 ), "|", ", " ) & " e " & MID ( _lCedo, _lcdPos + 1, 999 ) )
			VAR _laN = IF ( ISBLANK ( _anosCedo ) || _anosCedo = "", 0, PATHLENGTH ( _anosCedo ) )
			VAR _laPos = IF ( _laN >= 2, FIND ( "§", SUBSTITUTE ( _anosCedo, "|", "§", _laN - 1 ) ) )
			VAR _laTxt = SWITCH ( TRUE (), _laN = 0, "", _laN = 1, _anosCedo, SUBSTITUTE ( LEFT ( _anosCedo, _laPos - 1 ), "|", ", " ) & " e " & MID ( _anosCedo, _laPos + 1, 999 ) )
			VAR _txtNovas =
			    IF (
			        _lcN = 0,
			        "",
			        " e as mais novas mal começaram — " & IF ( _nAI > 0, SUBSTITUTE ( _lCom, "|", ", " ) & " e, em seguida, as " & SWITCH ( _nAI, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAI, "0" ) ) & " da cronograma", _lcTxt )
			    )
			VAR _txtE1 =
			    IF (
			        _termina <> "" && NOT ISBLANK ( _termina ),
			        "O canteiro está em transição: " & IF ( _termina = _antiga, "a obra mais antiga", "a " & _termina )
			            & " chega ao fim no mês de referência" & _txtNovas & ".",
			        "O canteiro segue em obra" & _txtNovas & "."
			    )
			VAR _mFim = MONTH ( _fimPerto )
			VAR _txtQuando = IF ( _mFim <= 4, "no começo de ", IF ( _mFim <= 8, "no meio de ", "no fim de " ) ) & YEAR ( _fimPerto )
			VAR _txtPerto =
			    SWITCH (
			        _lpN,
			        0, "",
			        1, " A " & _lpTxt & " se aproxima do término, " & _txtQuando & ", com atraso",
			        " " & _lpTxt & " se aproximam do término com atraso"
			    )
			VAR _txtCedo =
			    SWITCH (
			        _lcdN,
			        0, "",
			        1, "a " & _lcdTxt & " só termina em " & _laTxt & " e já acumula atraso cedo",
			        _lcdTxt & " só terminam em " & _laTxt & " e já acumulam atraso cedo"
			    )
			VAR _txtE2 =
			    SWITCH (
			        TRUE (),
			        _txtPerto <> "" && _txtCedo <> "", _txtPerto & "; " & _txtCedo & ".",
			        _txtPerto <> "", _txtPerto & ".",
			        _txtCedo <> "", " " & UPPER ( LEFT ( _txtCedo, 1 ) ) & MID ( _txtCedo, 2, 1000 ) & ".",
			        ""
			    )
			VAR _ldN = IF ( ISBLANK ( _lDepois ) || _lDepois = "", 0, PATHLENGTH ( _lDepois ) )
			VAR _ldPos = IF ( _ldN >= 2, FIND ( "§", SUBSTITUTE ( _lDepois, "|", "§", _ldN - 1 ) ) )
			VAR _ldTxt = SWITCH ( TRUE (), _ldN = 0, "", _ldN = 1, _lDepois, SUBSTITUTE ( LEFT ( _lDepois, _ldPos - 1 ), "|", ", " ) & " e " & MID ( _lDepois, _ldPos + 1, 999 ) )
			VAR _lalN = IF ( ISBLANK ( _lAlem ) || _lAlem = "", 0, PATHLENGTH ( _lAlem ) )
			VAR _lalPos = IF ( _lalN >= 2, FIND ( "§", SUBSTITUTE ( _lAlem, "|", "§", _lalN - 1 ) ) )
			VAR _lalTxt = SWITCH ( TRUE (), _lalN = 0, "", _lalN = 1, _lAlem, SUBSTITUTE ( LEFT ( _lAlem, _lalPos - 1 ), "|", ", " ) & " e " & MID ( _lAlem, _lalPos + 1, 999 ) )
			VAR _txtProj =
			    SWITCH (
			        TRUE (),
			        _ldN = 0 && _lalN = 0, " Pelo ritmo de hoje, todas terminam até a entrega contratual.",
			        _lalN = 0, " Pelo ritmo de hoje, " & IF ( _ldN = 1, "a " & _ldTxt & " termina", _ldTxt & " terminam" )
			            & " depois da entrega contratual, ainda nos 180 dias de tolerância.",
			        " Pelo ritmo de hoje, " & IF ( _lalN = 1, "a " & _lalTxt & " passa", _lalTxt & " passam" )
			            & " dos 180 dias de tolerância depois da entrega" & SWITCH ( _ldN, 0, ".", 1, "; a " & _ldTxt & " fica nos 180 dias.", "; " & _ldTxt & " ficam nos 180 dias." )
			    )
			VAR _rotD1 = "início da " & _antiga & ", a mais antiga"
			VAR _rotD2 = _dist & ", o término mais distante"
			VAR _rotD3 = _mOrc & ", o maior orçamento das " & SWITCH ( _nAnd, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAnd, "0" ) )
			VAR _txtAI = IF ( _nAI = 0, "", "As obras a iniciar entram com o orçamento " & IF ( ISBLANK ( _tipoAI ), "", _tipoAI & " " ) & "da cronograma e só ganham previsto, executado e desembolso na primeira aba da Análise Crítica — por isso aparecem tracejadas, sem avanço. " )
			VAR _lxN = [T3 · Linha do tempo · obras com orçamento executivo (quantidade)]
			VAR _lxPos = IF ( _lxN >= 2, FIND ( "§", SUBSTITUTE ( _tExecutivo, "|", "§", _lxN - 1 ) ) )
			VAR _lxTxt = SWITCH ( TRUE (), _lxN = 0, "", _lxN = 1, _tExecutivo, SUBSTITUTE ( LEFT ( _tExecutivo, _lxPos - 1 ), "|", ", " ) & " e " & MID ( _tExecutivo, _lxPos + 1, 999 ) )
			VAR _lprN = [T3 · Linha do tempo · obras com orçamento preliminar (quantidade)]
			VAR _lprPos = IF ( _lprN >= 2, FIND ( "§", SUBSTITUTE ( _tPreliminar, "|", "§", _lprN - 1 ) ) )
			VAR _lprTxt = SWITCH ( TRUE (), _lprN = 0, "", _lprN = 1, _tPreliminar, SUBSTITUTE ( LEFT ( _tPreliminar, _lprPos - 1 ), "|", ", " ) & " e " & MID ( _tPreliminar, _lprPos + 1, 999 ) )
			VAR _lgN = [T3 · Linha do tempo · obras com orçamento legal (quantidade)]
			VAR _lgPos = IF ( _lgN >= 2, FIND ( "§", SUBSTITUTE ( _tLegal, "|", "§", _lgN - 1 ) ) )
			VAR _lgTxt = SWITCH ( TRUE (), _lgN = 0, "", _lgN = 1, _tLegal, SUBSTITUTE ( LEFT ( _tLegal, _lgPos - 1 ), "|", ", " ) & " e " & MID ( _tLegal, _lgPos + 1, 999 ) )
			VAR _la2N = [T3 · Linha do tempo · obras com orçamento alvo (quantidade)]
			VAR _la2Pos = IF ( _la2N >= 2, FIND ( "§", SUBSTITUTE ( _tAlvo, "|", "§", _la2N - 1 ) ) )
			VAR _la2Txt = SWITCH ( TRUE (), _la2N = 0, "", _la2N = 1, _tAlvo, SUBSTITUTE ( LEFT ( _tAlvo, _la2Pos - 1 ), "|", ", " ) & " e " & MID ( _tAlvo, _la2Pos + 1, 999 ) )
			VAR _lfiN = [T3 · Linha do tempo · obras com orçamento final (quantidade)]
			VAR _lfiPos = IF ( _lfiN >= 2, FIND ( "§", SUBSTITUTE ( _tFinal, "|", "§", _lfiN - 1 ) ) )
			VAR _lfiTxt = SWITCH ( TRUE (), _lfiN = 0, "", _lfiN = 1, _tFinal, SUBSTITUTE ( LEFT ( _tFinal, _lfiPos - 1 ), "|", ", " ) & " e " & MID ( _tFinal, _lfiPos + 1, 999 ) )
			VAR _legalNova = IF ( _lgN = 1 && CONTAINSSTRING ( "|" & _lCom & "|", "|" & _tLegal & "|" ), 1, 0 )
			VAR _tabGrupos =
			    {
			        ( 1, "executivo", _lxN, IF ( _lxN = 1, "na mais madura (", "nas mais maduras (" ) & _lxTxt & ")",
			            [T3 · Linha do tempo · orçamento executivo · na maioria] ),
			        ( 2, "preliminar", _lprN, "em " & _lprTxt, [T3 · Linha do tempo · orçamento preliminar · na maioria] ),
			        ( 3, "legal", _lgN, IF ( _lgN = 1, "na " & _lgTxt & IF ( _legalNova = 1, ", que acabou de começar", "" ), "em " & _lgTxt ), [T3 · Linha do tempo · orçamento legal · na maioria] ),
			        ( 4, "alvo", _la2N, "em " & _la2Txt, [T3 · Linha do tempo · orçamento alvo · na maioria] ),
			        ( 5, "final", _lfiN, "em " & _lfiTxt, [T3 · Linha do tempo · orçamento final · na maioria] )
			    }
			VAR _grupos =
			    CONCATENATEX (
			        FILTER ( _tabGrupos, [Value3] > 0 ), /* geometria */
			        [Value2] & " " & IF ( [Value5] = 1, "na maioria", [Value4] ),
			        ", ",
			        [Value1], ASC
			    )
			VAR _txtTipos = "Entre as " & SWITCH ( _nAnd, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAnd, "0" ) ) & " em andamento, o tipo de orçamento acompanha a fase: " & _grupos & "."
			VAR _htmlAI =
			    CONCATENATEX (
			        _lista,
			        VAR _o = [@orc]
			        VAR _oA = ABS ( _o )
			        VAR _oNu = IF ( _oA >= 99950000, FORMAT ( _oA / 1000000, "0.0", "pt-BR" ), FORMAT ( _oA / 1000000, "0.00", "pt-BR" ) )
			        VAR _oTxt = IF ( ISBLANK ( _o ), "—", "⁅" & "R$ " & _oNu & " mi" & "⁆" )
			        VAR _atraso = 400 + ( [Value] - 1 ) * 80 -- geometria (a lista já vem pelo início previsto)
			        RETURN
			            "<div class='ai a-fd' style='animation-delay:" & _atraso & "ms'><i class='aim a-pop' style='animation-delay:" & ( _atraso + 100 ) & "ms'></i><b>" & [@obra] & "</b>"
			                & "<span class='pr'>" & FORMAT ( [@ini], "mmm/yy", "pt-BR" ) & " → " & FORMAT ( [@fim], "mmm/yy", "pt-BR" ) & "</span><span class='or'>" & _oTxt & "</span></div>",
			        "",
			        [@ini], ASC,
			        [@obra], ASC
			    )
			VAR _htmlDet =
			    IF (
			        _nAI = 0,
			        "<p class='oqe'>Nenhuma obra a iniciar na cronograma de " & [T3 · cronograma · versão] & ".</p>",
			        _htmlAI
			    )
			VAR _rotDet = "DETALHE · AS " & UPPER ( SWITCH ( _nAI, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAI, "0" ) ) ) & " A INICIAR · cronograma " & UPPER ( [T3 · cronograma · versão] )
			-- 4 · Marcação
			VAR _esq =
			    "<div class='esq'><span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _achado & "</h2>"
			        & "<p class='exp'>" & _txtE1 & _txtE2 & _txtProj & "</p>"
			        & "<div class='dst sobre-creme'>" & "<div><b>" & IF ( ISBLANK ( _iniAntiga ), "—", FORMAT ( _iniAntiga, "mmm/yy", "pt-BR" ) ) & "</b><span>" & _rotD1 & "</span></div>" & "<div><b>" & IF ( ISBLANK ( _fimDist ), "—", FORMAT ( _fimDist, "mmm/yy", "pt-BR" ) ) & "</b><span>" & _rotD2 & "</span></div>" & "<div><b>" & _tvoOd & "</b><span>" & _rotD3 & "</span></div>" & "</div>"
			    & "</div>"
			VAR _dir =
			    "<div class='dir'>" & "<div class='sec'><span class='vs'>" & "O QUE EXPLICA" & "</span>" & "<p class='oqe'>" & TRIM ( _txtAI ) & "</p>" & "</div>"
			        & "<div class='sec'><span class='vs'>" & _rotDet & "</span>" & _htmlDet & "</div>"
			    & "</div>"
			VAR _corpo = "<div class='cols'>" & _esq & _dir & "</div>"
			VAR _saidaHtml =
			    IF ( _nAnd > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura da Linha do tempo das obras" & "'><div class='pn pn-g ln'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Leituras
		lineageTag: 5c1c244b-5db4-5f3a-83ba-fe0740b036cc

	/// Leitura do "?" do PPC mês a mês, sobre o próprio painel (L065, mesma geometria da antiga leitura do Ritmo): achado com o PPC do mês de referência diante da meta e os pontos do item, explicação (quantos meses da janela chegaram à meta, desde quando está abaixo, o atraso em meses de hoje) e três destaques: o melhor e o mais fraco mês da janela e a média das obras no mês. Sem PPC na base: achado que diz a falta. Só lê contas.
	measure 'T3 · Leitura PPC · HTML' =
			-- 1 · Leituras
			VAR _obra = [Nota · obra em foco]
			VAR _mesL = [Mês de referência · longo]
			VAR _mesN = [Mês de referência · nome]
			VAR _ref = [Mês de referência]
			VAR _jan = [Série · primeiro mês]
			VAR _ppc = [Canteiro · PPC · foco]
			VAR _pt = [Nota · pontos PPC · foco]
			VAR _ps = [Nota · possíveis · PPC · foco]
			VAR _meta = [Nota · limite PPC · ponto cheio]
			VAR _nCom = [T3 · PPC · meses com PPC · foco]
			VAR _nMeta = [T3 · PPC · meses na meta · foco]
			VAR _desde = [T3 · PPC · abaixo da meta desde · foco]
			VAR _vMax = [T3 · PPC · maior na janela · foco]
			VAR _mMax = [T3 · PPC · mês do maior · foco]
			VAR _vMin = [T3 · PPC · menor na janela · foco]
			VAR _mMin = [T3 · PPC · mês do menor · foco]
			VAR _media = [T3 · PPC · média das obras · ref]
			VAR _atr = [Prazo · atraso (meses) · foco]
			-- 2 · Textos
			VAR _tcN = FORMAT ( ABS ( _ppc ) * 100, "0", "pt-BR" )
			VAR _tcS = IF ( ROUND ( _ppc * 100, 0 ) < 0, "−", "" )
			VAR _tcTxt = IF ( ISBLANK ( _ppc ), "—", _tcS & _tcN & "%" )
			VAR _tmN = FORMAT ( ABS ( _meta ) * 100, "0", "pt-BR" )
			VAR _tmS = IF ( ROUND ( _meta * 100, 0 ) < 0, "−", "" )
			VAR _tmTxt = IF ( ISBLANK ( _meta ), "—", _tmS & _tmN & "%" )
			VAR _tmxN = FORMAT ( ABS ( _vMax ) * 100, "0", "pt-BR" )
			VAR _tmxS = IF ( ROUND ( _vMax * 100, 0 ) < 0, "−", "" )
			VAR _tmxTxt = IF ( ISBLANK ( _vMax ), "—", _tmxS & _tmxN & "%" )
			VAR _tmiN = FORMAT ( ABS ( _vMin ) * 100, "0", "pt-BR" )
			VAR _tmiS = IF ( ROUND ( _vMin * 100, 0 ) < 0, "−", "" )
			VAR _tmiTxt = IF ( ISBLANK ( _vMin ), "—", _tmiS & _tmiN & "%" )
			VAR _tmdN = FORMAT ( ABS ( _media ) * 100, "0", "pt-BR" )
			VAR _tmdS = IF ( ROUND ( _media * 100, 0 ) < 0, "−", "" )
			VAR _tmdTxt = IF ( ISBLANK ( _media ), "—", _tmdS & _tmdN & "%" )
			VAR _tkTxt = "⁅" & FORMAT ( _pt, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _ps, "0.0#", "pt-BR" ) & "⁆"
			VAR _atA = ROUND ( ABS ( _atr ), 1 )
			VAR _txtAtr = "⁅" & FORMAT ( _atA, "0.0", "pt-BR" ) & "⁆" & IF ( _atA <= 1, " mês", " meses" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tcKP = LEN ( _tcN ) > 0
			VAR _tcKN = IF ( _tcKP, _tcN )
			VAR _tcKS = SUBSTITUTE ( SUBSTITUTE ( _tcKN, ".", "" ), ",", "" )
			VAR _tcKT = IFERROR ( VALUE ( _tcKS ), -1 )
			VAR _tcKOk = _tcKP && _tcKT >= 2 && FORMAT ( _tcKT, REPT ( "0", LEN ( _tcKS ) ) ) = _tcKS
			VAR _tcKD = IF ( CONTAINSSTRING ( _tcKN, "," ), LEN ( _tcKN ) - SEARCH ( ",", _tcKN ), 0 )
			VAR _tcKM = IF ( CONTAINSSTRING ( _tcKN, "." ), "#,##0", "0" ) & IF ( _tcKD > 0, "." & REPT ( "0", _tcKD ) )
			VAR _tcKOd =
			    IF (
			        _tcKOk,
			        "<o-d><o-v>" & _tcKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tcKN, FORMAT ( ROUND ( _tcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcKD ), _tcKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tcN
			    )
			VAR _tcOd = IF ( ISBLANK ( _ppc ), _tcTxt, _tcS & _tcKOd & "%" )
			VAR _tmxKP = LEN ( _tmxN ) > 0
			VAR _tmxKN = IF ( _tmxKP, _tmxN )
			VAR _tmxKS = SUBSTITUTE ( SUBSTITUTE ( _tmxKN, ".", "" ), ",", "" )
			VAR _tmxKT = IFERROR ( VALUE ( _tmxKS ), -1 )
			VAR _tmxKOk = _tmxKP && _tmxKT >= 2 && FORMAT ( _tmxKT, REPT ( "0", LEN ( _tmxKS ) ) ) = _tmxKS
			VAR _tmxKD = IF ( CONTAINSSTRING ( _tmxKN, "," ), LEN ( _tmxKN ) - SEARCH ( ",", _tmxKN ), 0 )
			VAR _tmxKM = IF ( CONTAINSSTRING ( _tmxKN, "." ), "#,##0", "0" ) & IF ( _tmxKD > 0, "." & REPT ( "0", _tmxKD ) )
			VAR _tmxKOd =
			    IF (
			        _tmxKOk,
			        "<o-d><o-v>" & _tmxKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tmxKN, FORMAT ( ROUND ( _tmxKT * [@odf] / 1000, 0 ) / POWER ( 10, _tmxKD ), _tmxKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tmxN
			    )
			VAR _tmxOd = IF ( ISBLANK ( _vMax ), _tmxTxt, _tmxS & _tmxKOd & "%" )
			VAR _tmiKP = LEN ( _tmiN ) > 0
			VAR _tmiKN = IF ( _tmiKP, _tmiN )
			VAR _tmiKS = SUBSTITUTE ( SUBSTITUTE ( _tmiKN, ".", "" ), ",", "" )
			VAR _tmiKT = IFERROR ( VALUE ( _tmiKS ), -1 )
			VAR _tmiKOk = _tmiKP && _tmiKT >= 2 && FORMAT ( _tmiKT, REPT ( "0", LEN ( _tmiKS ) ) ) = _tmiKS
			VAR _tmiKD = IF ( CONTAINSSTRING ( _tmiKN, "," ), LEN ( _tmiKN ) - SEARCH ( ",", _tmiKN ), 0 )
			VAR _tmiKM = IF ( CONTAINSSTRING ( _tmiKN, "." ), "#,##0", "0" ) & IF ( _tmiKD > 0, "." & REPT ( "0", _tmiKD ) )
			VAR _tmiKOd =
			    IF (
			        _tmiKOk,
			        "<o-d><o-v>" & _tmiKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tmiKN, FORMAT ( ROUND ( _tmiKT * [@odf] / 1000, 0 ) / POWER ( 10, _tmiKD ), _tmiKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tmiN
			    )
			VAR _tmiOd = IF ( ISBLANK ( _vMin ), _tmiTxt, _tmiS & _tmiKOd & "%" )
			VAR _tmdKP = LEN ( _tmdN ) > 0
			VAR _tmdKN = IF ( _tmdKP, _tmdN )
			VAR _tmdKS = SUBSTITUTE ( SUBSTITUTE ( _tmdKN, ".", "" ), ",", "" )
			VAR _tmdKT = IFERROR ( VALUE ( _tmdKS ), -1 )
			VAR _tmdKOk = _tmdKP && _tmdKT >= 2 && FORMAT ( _tmdKT, REPT ( "0", LEN ( _tmdKS ) ) ) = _tmdKS
			VAR _tmdKD = IF ( CONTAINSSTRING ( _tmdKN, "," ), LEN ( _tmdKN ) - SEARCH ( ",", _tmdKN ), 0 )
			VAR _tmdKM = IF ( CONTAINSSTRING ( _tmdKN, "." ), "#,##0", "0" ) & IF ( _tmdKD > 0, "." & REPT ( "0", _tmdKD ) )
			VAR _tmdKOd =
			    IF (
			        _tmdKOk,
			        "<o-d><o-v>" & _tmdKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tmdKN, FORMAT ( ROUND ( _tmdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tmdKD ), _tmdKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tmdN
			    )
			VAR _tmdOd = IF ( ISBLANK ( _media ), _tmdTxt, _tmdS & _tmdKOd & "%" )
			VAR _txtSob = "LEITURA · PPC MÊS A MÊS · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( _obra ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " · " & UPPER ( _mesL )
			VAR _naMeta = ROUND ( _ppc, 2 ) >= _meta
			VAR _achado =
			    "Em " & _mesN & " a " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " cumpriu " & _tcOd & " do plano semanal"
			        & IF ( _naMeta, ", na meta de " & "⁅" & _tmTxt & "⁆" & ": o ponto cheio do PPC na nota.",
			            ", abaixo da meta de " & "⁅" & _tmTxt & "⁆" & "; na nota, o PPC vale " & _tkTxt & "." )
			VAR _txtMeses =
			    SWITCH (
			        TRUE (),
			        _nCom <= 1, "",
			        _nMeta = _nCom, "Todos os " & SWITCH ( _nCom, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nCom, "0" ) ) & " meses da janela chegaram à meta",
			        _nMeta = 0, "Nenhum dos " & SWITCH ( _nCom, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nCom, "0" ) ) & " meses da janela chegou à meta",
			        UPPER ( LEFT ( SWITCH ( _nMeta, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nMeta, "0" ) ), 1 ) ) & MID ( SWITCH ( _nMeta, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nMeta, "0" ) ), 2, 1000 ) & " dos " & SWITCH ( _nCom, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nCom, "0" ) ) & IF ( _nMeta = 1, " meses da janela chegou à meta", " meses da janela chegaram à meta" )
			    )
			VAR _txtDesde = IF ( ISBLANK ( _desde ) || _desde = _ref, "", "; está abaixo dela desde " & IF ( _desde = _jan || YEAR ( _desde ) <> YEAR ( _ref ), FORMAT ( _desde, "mmm/yy", "pt-BR" ), FORMAT ( _desde, "mmmm", "pt-BR" ) ) )
			VAR _txtAtraso =
			    IF (
			        ISBLANK ( _atr ),
			        "",
			        " O PPC mede a semana; quando cai por vários meses, o atraso em meses vem depois. Hoje a obra está "
			            & IF ( ROUND ( _atr, 1 ) < 0, _txtAtr & " à frente do cronograma.", "com " & _txtAtr & " de atraso." )
			    )
			VAR _explica = IF ( _txtMeses = "", "", _txtMeses & _txtDesde & "." ) & _txtAtraso
			VAR _rotD1 = "o melhor mês, " & FORMAT ( _mMax, "mmmm", "pt-BR" )
			VAR _rotD2 = "o mês mais fraco, " & FORMAT ( _mMin, "mmmm", "pt-BR" )
			VAR _rotD3 = "a média das obras em " & _mesN
			-- 4 · Marcação
			VAR _corpo =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _achado & "</h2>"
			        & IF ( TRIM ( _explica ) = "", "", "<p class='exp'>" & TRIM ( _explica ) & "</p>" )
			        & "<div class='dst sobre-creme'>" & "<div><b>" & _tmxOd & "</b><span>" & _rotD1 & "</span></div>" & "<div><b>" & _tmiOd & "</b><span>" & _rotD2 & "</span></div>" & "<div><b>" & _tmdOd & "</b><span>" & _rotD3 & "</span></div>" & "</div>"
			VAR _semBase =
			    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>A base complementar de " & _mesN
			        & " não traz o PPC da " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & ": o item fica pendente na nota.</h2>"
			VAR _saidaHtml =
			    "<div class='u lv' role='dialog' aria-label='" & "Leitura do PPC mês a mês" & "'><div class='pn pn-p'>" & IF ( ISBLANK ( _ppc ), _semBase, _corpo ) & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T3 Avanço físico\Leituras
		lineageTag: c3e23136-c4ef-5176-9281-9e124f1137b4

	/// CSS das leituras do "?" da Tela 03 (v2: sobre o painel, superfície offwhite reta com contorno e sombra; completa em duas colunas, condensada, detalhe do desvio, tabela das obras a iniciar, trajetória) e do guia da página (1120, duas colunas, centrado).
