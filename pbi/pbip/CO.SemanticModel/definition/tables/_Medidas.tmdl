	/// Possíveis − pontos dos itens do contexto (item da linha ou dimensão).
	measure 'Nota · item · perdidos' =
			VAR _p = [Nota · item · possíveis]
			RETURN
			    IF ( NOT ISBLANK ( _p ), ROUND ( _p - [Nota · item · pontos], 8 ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 4e27d61d-fdc4-5604-9725-4f325323f4be

	/// Pontos dos itens do contexto (um item da linha ou os itens de uma dimensão), somados pelas obras do recorte. Lidos de dItemRankingNota (as medidas da regra de cada item, guardadas no refresh).
	measure 'Nota · item · pontos' =
			VAR _p =
			    SUMX (
			        FILTER (
			        dItemRankingNota,
			        dItemRankingNota[Item] IN VALUES ( dItemNota[Item] )
			            && dItemRankingNota[Obra] IN VALUES ( dObra[Obra] )
			            && dItemRankingNota[Mes] IN VALUES ( dMes[Mes] )
			    ),
			        dItemRankingNota[Pontos]
			    )
			RETURN
			    IF ( NOT ISBLANK ( _p ), ROUND ( _p, 8 ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 54d87cae-2180-5fad-9841-529f85586481

	/// Máximo dos itens do contexto nas obras com dado, somado. Lidos de dItemRankingNota (as medidas da regra de cada item, guardadas no refresh).
	measure 'Nota · item · possíveis' =
			VAR _p =
			    SUMX (
			        FILTER (
			        dItemRankingNota,
			        dItemRankingNota[Item] IN VALUES ( dItemNota[Item] )
			            && dItemRankingNota[Obra] IN VALUES ( dObra[Obra] )
			            && dItemRankingNota[Mes] IN VALUES ( dMes[Mes] )
			    ),
			        dItemRankingNota[Possiveis]
			    )
			RETURN
			    IF ( NOT ISBLANK ( _p ), ROUND ( _p, 8 ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 15ce50dc-b040-5c96-9846-e2d50ebf2d2c

	/// Unidade do X do item da linha: indice, meses, pct, taxa ou checagens.
	measure 'Nota · item · unidade' =
			SELECTEDVALUE ( dItemNota[Unidade] )
		displayFolder: Base\Nota
		lineageTag: d2085511-2934-5e36-9310-cf48caa69b6e

	/// X do item da linha: IDC (custo), meses (prazo), fração (PPC, caixa, inspeção, NR-18, entregas), taxa (acidentes) ou checagens (análise crítica). Uma obra.
	measure 'Nota · item · X' =
			SWITCH (
			    SELECTEDVALUE ( dItemNota[Item] ),
			    "custo", [Nota · X custo],
			    "prazo", [Nota · X prazo],
			    "ppc", [Nota · X PPC],
			    "caixa", [Nota · X caixa],
			    "inspecao", [Nota · X inspeção],
			    "acidentes", [Nota · X acidentes],
			    "nr18", [Nota · X NR-18],
			    "entregas", [Nota · X entregas],
			    "analise", [Nota · X análise crítica]
			)
		formatString: 0.0000
		displayFolder: Base\Nota
		lineageTag: e0a82bd9-aecc-53bb-8913-0169f3e16fd9

	/// Itens da nota sem dado (9 no total). Soma pelas obras presentes no contexto.
	measure 'Nota · itens faltando' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    IF (
			        [Nota · obra presente] = 1,
			        9
			            - (
			                INT ( NOT ISBLANK ( [Nota · pontos custo] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos prazo] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos PPC] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos caixa] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos inspeção] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos acidentes] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos NR-18] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos entregas] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos análise crítica] ) )
			            )
			    )
			)
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 2465ba5f-1856-52b8-8568-8eef963e6dbf

	/// Itens da fonte 'Base complementar' sem dado (5 itens: PPC, 1.ª inspeção, Acidentes, NR-18, Entregas). Soma pelas obras presentes no contexto.
	measure 'Nota · itens faltando na base' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    IF (
			        [Nota · obra presente] = 1,
			        5
			            - (
			                INT ( NOT ISBLANK ( [Nota · pontos PPC] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos inspeção] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos acidentes] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos NR-18] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos entregas] ) )
			            )
			    )
			)
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 2c57b8a3-43e6-50c2-956e-adcea7b58d99

	/// Itens da fonte 'Análise Crítica' sem dado (4 itens: Custo, Atraso, Caixa, Análise crítica). Soma pelas obras presentes no contexto.
	measure 'Nota · itens faltando na planilha' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    IF (
			        [Nota · obra presente] = 1,
			        4
			            - (
			                INT ( NOT ISBLANK ( [Nota · pontos custo] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos prazo] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos caixa] ) )
			                + INT ( NOT ISBLANK ( [Nota · pontos análise crítica] ) )
			            )
			    )
			)
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: e466ccb5-6e8b-59c0-b4d8-a8672931a0da

	/// Códigos (dItemNota) dos itens da Análise Crítica sem dado para a obra do contexto, na ordem da régua, separados por '|'; vazio sem falta ou sem obra. Uma obra no contexto.
	measure 'Nota · itens faltando na planilha (lista)' =
			VAR _falta =
			    {
			        ( "custo", INT ( ISBLANK ( [Nota · pontos custo] ) ) ),
			        ( "prazo", INT ( ISBLANK ( [Nota · pontos prazo] ) ) ),
			        ( "caixa", INT ( ISBLANK ( [Nota · pontos caixa] ) ) ),
			        ( "analise", INT ( ISBLANK ( [Nota · pontos análise crítica] ) ) )
			    }
			RETURN
			    IF (
			        HASONEVALUE ( dObra[Obra] ) && [Nota · obra presente] = 1,
			        CONCATENATEX ( FILTER ( _falta, [Value2] = 1 ), [Value1], "|" )
			    )
		displayFolder: Base\Nota
		lineageTag: 082e7656-d614-59e7-b6a9-46ef5dba95fd

	/// Itens com valor na base, mas fora da faixa válida (PPC fora de 0 a 100%; aprovados, conformes ou entregues maior que o total): ficam sem pontos e já contam em 'itens faltando na base'. Soma pelas obras presentes.
	measure 'Nota · itens fora da faixa' =
			SUMX (
			    VALUES ( dObra[Obra] ),
			    IF (
			        [Nota · obra presente] = 1,
			        INT ( NOT ISBLANK ( MAX ( fBaseObra[PPC] ) ) && ISBLANK ( [Nota · X PPC] ) )
			            + INT ( NOT ISBLANK ( SUM ( fBaseObra[AprovadosPrimeira] ) ) && SUM ( fBaseObra[ServicosVerificados] ) > 0 && ISBLANK ( [Nota · X inspeção] ) )
			            + INT ( NOT ISBLANK ( SUM ( fBaseObra[NR18Conformes] ) ) && SUM ( fBaseObra[NR18Aplicaveis] ) > 0 && ISBLANK ( [Nota · X NR-18] ) )
			            + INT ( NOT ISBLANK ( SUM ( fBaseObra[PedidosNoPrazo] ) ) && SUM ( fBaseObra[PedidosPrevistos] ) > 0 && ISBLANK ( [Nota · X entregas] ) )
			    )
			)
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: 5c601d74-bf08-5034-a2cc-2ef90f476c3e

