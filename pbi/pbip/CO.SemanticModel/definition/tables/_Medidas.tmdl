	/// Justificativas exigidas e preenchidas na janela, somadas pelas obras com aba no período (a grade do desembolso). Com 0, a frase diz 'nenhum excesso exigido trouxe justificativa no período'. Ex. ago/26: 6.
	measure 'T4 · Leitura desembolso · justificativas preenchidas no período' =
			VAR _obras =
			    ADDCOLUMNS (
			        VALUES ( dObra[Obra] ),
			        "@hist", [T4 · Meses com aba],
			        "@pre", [T4 · Obra · justificativas preenchidas no período]
			    )
			VAR _naGrade = FILTER ( _obras, [@hist] > 0 )
			RETURN
			    SUMX ( _naGrade, [@pre] ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: 56687798-2040-5a5b-9b5d-576dc4fd818a

	/// Meses da janela, até o de referência, em que o desembolso da carteira passou do previsto.
	measure 'T4 · Leitura desembolso · meses acima do previsto' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@d", [T4 · Desembolso · desvio no mês · com previsto] )
			RETURN
			    COUNTROWS ( FILTER ( _meses, NOT ISBLANK ( [@d] ) && [@d] > 0 ) ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: d7585144-d4a8-55bb-af74-c2da1a187474

	/// Mês do maior desvio do desembolso na janela.
	measure 'T4 · Leitura desembolso · mês do pico' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _pares =
			    CALCULATETABLE (
			        ADDCOLUMNS ( SUMMARIZE ( fAnaliseCritica, fAnaliseCritica[Obra], fAnaliseCritica[Mes] ), "@d", [Desembolso · desvio no mês] ),
			        REMOVEFILTERS ( dMes ),
			        dMes[Mes] >= _ini && dMes[Mes] <= _ref
			    )
			VAR _top = TOPN ( 1, FILTER ( _pares, NOT ISBLANK ( [@d] ) ), [@d], DESC, fAnaliseCritica[Mes], ASC, fAnaliseCritica[Obra], ASC )
			RETURN
			    MAXX ( _top, fAnaliseCritica[Mes] )
		formatString: dd/mm/yyyy
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: e4a25986-bb5c-57f6-9990-9d945d5eaeec

	/// Obra do recorte com o maior desembolso acima do previsto, em reais, no mês de referência.
	measure 'T4 · Leitura desembolso · obra de maior excesso' =
