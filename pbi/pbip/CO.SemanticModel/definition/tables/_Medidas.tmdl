	/// Escala da cascata da obra em foco: o topo mais alto entre os degraus que aparecem (zero entra sempre).
	measure 'Cascata · escala · máximo · foco' =
			VAR _deg =
			    ADDCOLUMNS (
			        ALL ( dDegrau ),
			        "@a", [Cascata · degrau · aparece · foco],
			        "@t", [Cascata · degrau · topo · foco],
			        "@b", [Cascata · degrau · base · foco]
			    )
			RETURN
			    MAXX ( FILTER ( _deg, [@a] = 1 ), [@t] )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T2 Análise crítica\Como o resultado se forma\Contas
		lineageTag: 5241baee-60ae-5f7d-8b89-570b66006c19

	/// Escala da cascata da obra em foco: a base mais baixa entre os degraus que aparecem (zero entra sempre).
	measure 'Cascata · escala · mínimo · foco' =
			VAR _deg =
			    ADDCOLUMNS (
			        ALL ( dDegrau ),
			        "@a", [Cascata · degrau · aparece · foco],
			        "@t", [Cascata · degrau · topo · foco],
			        "@b", [Cascata · degrau · base · foco]
			    )
			RETURN
			    MINX ( FILTER ( _deg, [@a] = 1 ), [@b] )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T2 Análise crítica\Como o resultado se forma\Contas
		lineageTag: 911b1310-dc0e-55a5-bfa0-8c4a0fa5d387

	/// Degrau 'pago e não aplicado' da cascata: itens 02 a 07 do quadradinho (saldo de contrato, adiantamentos, estoque, equipamentos e receita de personalizações) — tudo o que soma no resultado sem ter virado obra pelo crédito.
