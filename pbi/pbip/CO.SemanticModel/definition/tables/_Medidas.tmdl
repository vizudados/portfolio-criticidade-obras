	/// Nota da obra (0 a 10): a soma dos pontos, só com todos os itens com dado (senão, vazio e a obra fica pendente). Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · nota final' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    IF (
			        [Nota · completa] = 1,
			        ROUND ( [Nota · pontos obtidos], 8 )
			    )
			)
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 9d629b78-4575-51a6-ab3e-c50ffcee9d24

	/// [Nota · nota final] de uma obra num mês, lido de dRankingNota (a mesma medida, guardada no refresh). Uma obra e um mês no contexto; senão, vazio.
	measure 'Nota · nota final · um mês' =
			VAR _o = SELECTEDVALUE ( dObra[Obra] )
			VAR _m = SELECTEDVALUE ( dMes[Mes] )
			VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _m )
			RETURN
			    IF ( HASONEVALUE ( dObra[Obra] ) && HASONEVALUE ( dMes[Mes] ), VAR _n = MAXX ( _linha, dRankingNota[NotaOrdem] ) RETURN IF ( _n <> 99, _n ) )
		formatString: 0.00
		displayFolder: Base\Nota
		lineageTag: 33d384e1-4c7f-5763-bc1b-3049a367e27e

	/// Nota máxima: a soma dos máximos dos itens (10). Constante.
	measure 'Nota · nota · máximo' =
			10
		formatString: 0.0
