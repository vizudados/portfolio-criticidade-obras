	/// Primeiro mês da sequência, na janela e terminando no de referência, em que o que falta realizar da carteira (só as obras com aba nos dois meses) andou no mesmo sentido do último mês ('a distância entre a barra e o traço cresce desde março').
	measure 'T4 · Leitura mês · a realizar · sequência · início' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] > _ini && dMes[Mes] <= _ref ), "@v", [T4 · A realizar · variação no mês] )
			VAR _sentidos = ADDCOLUMNS ( _meses, "@s", IF ( ISBLANK ( [@v] ), BLANK (), SIGN ( ROUND ( [@v], 0 ) ) ) )
			VAR _sinal = MAXX ( FILTER ( _sentidos, dMes[Mes] = _ref ), [@s] )
			VAR _quebra = MAXX ( FILTER ( _sentidos, ISBLANK ( [@s] ) || [@s] <> _sinal ), dMes[Mes] )
			VAR _inicio = MINX ( FILTER ( _sentidos, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] )
			RETURN
			    IF ( NOT ISBLANK ( _sinal ) && _sinal <> 0, _inicio )
		formatString: dd/mm/yyyy
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: b88ada51-d360-5cc2-89c7-8165e24332b3

	/// Meses da janela, até o de referência, em que a variação do resultado aplicado da carteira (só as obras com aba no mês e na anterior) ficou negativa.
	measure 'T4 · Leitura mês · meses com queda' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] > _ini && dMes[Mes] <= _ref ), "@v", [T4 · Resultado aplicado · variação no mês] )
			RETURN
			    COUNTROWS ( FILTER ( _meses, NOT ISBLANK ( [@v] ) && [@v] < 0 ) ) + 0
		formatString: 0
		displayFolder: T4 Resultado no tempo\Leituras\Contas
		lineageTag: 7051ea82-8b37-5747-abda-8565be523f93

	/// Meses da janela, depois do primeiro dela e até o de referência, em que a carteira tem obra com aba no mês e na anterior (a variação existe; 5 em jun/26).
	measure 'T4 · Leitura mês · meses comparáveis' =
			VAR _ref = [Mês de referência]
			VAR _ini = [Série · primeiro mês]
			VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] > _ini && dMes[Mes] <= _ref ), "@v", [T4 · Resultado aplicado · variação no mês] )
			RETURN
			    COUNTROWS ( FILTER ( _meses, NOT ISBLANK ( [@v] ) ) ) + 0
