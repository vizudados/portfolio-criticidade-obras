	/// A obra com a menor taxa de entregas no prazo e completas no mês de referência (no empate, a primeira em ordem alfabética). Ex. set/26: POTENGI.
	measure 'T5 · Leitura suprimentos · pior obra · ref' =
			VAR _t =
			    FILTER ( ADDCOLUMNS ( VALUES ( dObra[Obra] ), "@v", [Canteiro · entregas no prazo · ref] ), NOT ISBLANK ( [@v] ) )
			VAR _mn = MINX ( _t, [@v] )
			RETURN
			    CONCATENATEX ( TOPN ( 1, FILTER ( _t, [@v] = _mn ), dObra[Obra], ASC ), dObra[Obra] )
		displayFolder: T5 Canteiro\Leituras\Contas
