	/// Onde o degrau da linha começa na cascata da obra em foco (o menor dos dois extremos da barra; os resultados partem de zero). Serve para posicionar a barra.
	measure 'Cascata · degrau · base · foco' =
			VAR _deg = SELECTEDVALUE ( dDegrau[Degrau] )
			VAR _va = [Crédito do orçamento · foco] + 0
			VAR _ca = [Custo aplicado · foco] + 0
			VAR _ra = [Resultado aplicado · foco] + 0
			VAR _ar = [A realizar · foco] + 0
			VAR _r = [Resultado da obra · foco] + 0
			RETURN
			    SWITCH (
			        _deg,
			        "ValorAgregado", MIN ( 0, _va ),
			        "CustoAplicado", MIN ( _va, _va - _ca ),
			        "ResultadoAplicado", MIN ( 0, _ra ),
			        "ARealizar", MIN ( _ra, _ra + _ar ),
			        "Resultado", MIN ( 0, _r )
			    )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: T2 Análise crítica\Como o resultado se forma\Contas
		lineageTag: 893982fd-3f53-53a4-9367-5068fc694bcb

