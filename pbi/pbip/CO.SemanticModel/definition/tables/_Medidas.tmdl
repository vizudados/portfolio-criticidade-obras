	/// Término previsto mais distante entre as obras em andamento.
	measure 'T3 · Linha do tempo · término mais distante em andamento' =
			VAR _obras =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dObra[Obra] ),
			            "@e", [Físico · executado acumulado · ref],
			            "@d", [Físico · desvio acumulado p.p. · ref],
