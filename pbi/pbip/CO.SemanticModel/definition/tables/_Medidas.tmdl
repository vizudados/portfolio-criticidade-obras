	/// Cartão escuro 'Sem acidente com afastamento' (a resposta de 'o canteiro está seguro?'): meses seguidos sem acidente com afastamento no recorte, com o último mês com acidente e as obras dele (ou 'nenhum desde' o começo do histórico). A base é mensal: conta meses, não dias. Só lê contas.
	measure 'T5 · Cartão acidentes · HTML' =
			-- 1 · Leituras
			VAR _n = [T5 · Acidentes · meses sem acidente]
			VAR _ult = [T5 · Acidentes · último mês]
			VAR _ini = [T5 · Acidentes · início do histórico]
			VAR _lst = [T5 · Acidentes · obras do último (lista)]
			-- 2 · Textos
			VAR _tnN = FORMAT ( _n, "#,0", "pt-BR" )
			VAR _tnTxt = IF ( ISBLANK ( _n ), "—", _tnN )
			VAR _txtLado = IF ( ISBLANK ( _n ), "", IF ( _n = 1, "mês", "meses" ) )
			VAR _txtObras = SUBSTITUTE ( _lst, "|", ", " )
			VAR _txtCtx = SWITCH ( TRUE (), ISBLANK ( _ini ), "falta na base", ISBLANK ( _ult ), "nenhum desde " & FORMAT ( _ini, "mmm/yy", "pt-BR" ), "o último em " & FORMAT ( _ult, "mmm/yy", "pt-BR" ) & " · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtObras, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) )
			VAR _txtRegra = "Meses seguidos sem acidente com afastamento em nenhuma obra, depois do último mês com acidente. A base é mensal: não traz o dia."
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _tnKP = LEN ( _tnN ) > 0
			VAR _tnKN = IF ( _tnKP, _tnN )
			VAR _tnKS = SUBSTITUTE ( SUBSTITUTE ( _tnKN, ".", "" ), ",", "" )
			VAR _tnKT = IFERROR ( VALUE ( _tnKS ), -1 )
			VAR _tnKOk = _tnKP && _tnKT >= 2 && FORMAT ( _tnKT, REPT ( "0", LEN ( _tnKS ) ) ) = _tnKS
			VAR _tnKD = IF ( CONTAINSSTRING ( _tnKN, "," ), LEN ( _tnKN ) - SEARCH ( ",", _tnKN ), 0 )
			VAR _tnKM = IF ( CONTAINSSTRING ( _tnKN, "." ), "#,##0", "0" ) & IF ( _tnKD > 0, "." & REPT ( "0", _tnKD ) )
			VAR _tnKOd =
			    IF (
			        _tnKOk,
			        "<o-d><o-v>" & _tnKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _tnKN, FORMAT ( ROUND ( _tnKT * [@odf] / 1000, 0 ) / POWER ( 10, _tnKD ), _tnKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _tnN
			    )
			VAR _tnOd = IF ( ISBLANK ( _n ), _tnTxt, _tnKOd )
			-- 4 · Marcação
			RETURN
			    "<div class='u kc escuro' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Sem acidente com afastamento" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _tnOd & "</span>" & "<span class='b5 lado2'>" & _txtLado & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Base complementar · NBR 14280</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
		displayFolder: T5 Canteiro\Cartões
		lineageTag: e97e0ceb-e1a3-5fe7-a2a4-271f1a0c7411

	/// Cartão das entregas no prazo e completas da carteira no mês (soma ÷ soma), com a meta (o ponto cheio do item da nota) e quantas obras ficam abaixo dela; o verso traz a regra e a primeira e a última faixa. Só lê contas.
	measure 'T5 · Cartão entregas · HTML' =
			-- 1 · Leituras
			VAR _x = [Canteiro · entregas no prazo · ref]
			VAR _lim = [Nota · limite entregas · ponto cheio]
			VAR _abx = [T5 · Entregas · obras abaixo da meta · ref]
			-- 2 · Textos
			VAR _txN = FORMAT ( ABS ( _x ) * 100, "0.0", "pt-BR" )
			VAR _txS = IF ( ROUND ( _x * 100, 1 ) < 0, "−", "" )
			VAR _txTxt = IF ( ISBLANK ( _x ), "—", _txS & _txN & "%" )
			VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
			VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
			VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
			VAR _toTxt = IF ( _abx = 0, "nenhuma obra abaixo", IF ( _abx = 1, "1 obra abaixo", "⁅" & _abx & "⁆" & " obras abaixo" ) )
			VAR _txtCtx = IF ( ISBLANK ( _x ), "falta na base", "meta " & "⁅" & _tlTxt & "⁆" & " · " & _toTxt )
			VAR _txtRegra = "Pedidos entregues no prazo e completos ÷ pedidos com entrega prevista no mês, com as obras somadas. Na nota, por obra:"
			VAR _fx = SUBSTITUTE ( CALCULATE ( [Nota · item · faixas], dItemNota[Item] = "entregas" ), " · ", "|" )
			VAR _fxa = PATHITEM ( _fx, 1 )
			VAR _fxz = PATHITEM ( _fx, PATHLENGTH ( _fx ) )
			VAR _fx1 = SUBSTITUTE ( SUBSTITUTE ( _fxa, "<", "&lt;" ), ">", "&gt;" )
			VAR _fxN = SUBSTITUTE ( SUBSTITUTE ( _fxz, "<", "&lt;" ), ">", "&gt;" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _txKP = LEN ( _txN ) > 0
			VAR _txKN = IF ( _txKP, _txN )
			VAR _txKS = SUBSTITUTE ( SUBSTITUTE ( _txKN, ".", "" ), ",", "" )
			VAR _txKT = IFERROR ( VALUE ( _txKS ), -1 )
			VAR _txKOk = _txKP && _txKT >= 2 && FORMAT ( _txKT, REPT ( "0", LEN ( _txKS ) ) ) = _txKS
			VAR _txKD = IF ( CONTAINSSTRING ( _txKN, "," ), LEN ( _txKN ) - SEARCH ( ",", _txKN ), 0 )
			VAR _txKM = IF ( CONTAINSSTRING ( _txKN, "." ), "#,##0", "0" ) & IF ( _txKD > 0, "." & REPT ( "0", _txKD ) )
			VAR _txKOd =
			    IF (
			        _txKOk,
			        "<o-d><o-v>" & _txKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _txKN, FORMAT ( ROUND ( _txKT * [@odf] / 1000, 0 ) / POWER ( 10, _txKD ), _txKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _txN
			    )
			VAR _txOd = IF ( ISBLANK ( _x ), _txTxt, _txS & _txKOd & "%" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Entregas no prazo e completas" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _txOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Base complementar · pedidos</span></div>"
			            & "<div class='regua'><i class='mk mk0'></i><span>" & _fx1 & "</span><i class='mk mk2'></i><span>" & _fxN & "</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Cartões
		lineageTag: cdc6916a-da23-596b-b080-c62962b5ced0

	/// Cartão da taxa de frequência de 12 meses da carteira (acidentes com afastamento por milhão de horas-homem), com os acidentes no período, a média do setor e quantas obras passam dela; o verso traz a regra e a primeira e a última faixa do item acidentes (lidas do modelo). Só lê contas.
	measure 'T5 · Cartão frequência · HTML' =
			-- 1 · Leituras
			VAR _tf = [Canteiro · taxa de frequência (12 meses) · ref]
			VAR _set = [Nota · limite acidentes · setor]
			VAR _ac = [Canteiro · acidentes 12 meses · ref]
			VAR _acima = [T5 · Segurança · obras acima do setor · ref]
			-- 2 · Textos
			VAR _ttN = IF ( _tf = INT ( _tf ), FORMAT ( _tf, "0", "pt-BR" ), FORMAT ( _tf, "0.0", "pt-BR" ) )
			VAR _ttTxt = IF ( ISBLANK ( _tf ), "—", _ttN )
			VAR _tsN = IF ( _set = INT ( _set ), FORMAT ( _set, "0", "pt-BR" ), FORMAT ( _set, "0.0", "pt-BR" ) )
			VAR _tsTxt = IF ( ISBLANK ( _set ), "—", _tsN )
			VAR _a = _ac + 0
			VAR _txtAc = IF ( _a = 1, "1 acidente", "⁅" & _a & "⁆" & " acidentes" )
			VAR _txtAcima = IF ( _acima = 0, "nenhuma obra acima", IF ( _acima = 1, "1 obra acima", "⁅" & _acima & "⁆" & " obras acima" ) )
			VAR _txtCtx = IF ( ISBLANK ( _tf ), "falta na base", _txtAc & " · setor " & "⁅" & _tsTxt & "⁆" & " · " & _txtAcima )
			VAR _txtRegra = "Acidentes com afastamento × 1.000.000 ÷ horas-homem trabalhadas nos 12 meses até o mês, com as obras somadas (NBR 14280). Na nota, por obra:"
			VAR _fx = SUBSTITUTE ( CALCULATE ( [Nota · item · faixas], dItemNota[Item] = "acidentes" ), " · ", "|" )
			VAR _fxa = PATHITEM ( _fx, 1 )
			VAR _fxz = PATHITEM ( _fx, PATHLENGTH ( _fx ) )
			VAR _fx1 = SUBSTITUTE ( SUBSTITUTE ( _fxa, "<", "&lt;" ), ">", "&gt;" )
			VAR _fxN = SUBSTITUTE ( SUBSTITUTE ( _fxz, "<", "&lt;" ), ">", "&gt;" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _ttKP = LEN ( _ttN ) > 0
			VAR _ttKN = IF ( _ttKP, _ttN )
			VAR _ttKS = SUBSTITUTE ( SUBSTITUTE ( _ttKN, ".", "" ), ",", "" )
			VAR _ttKT = IFERROR ( VALUE ( _ttKS ), -1 )
			VAR _ttKOk = _ttKP && _ttKT >= 2 && FORMAT ( _ttKT, REPT ( "0", LEN ( _ttKS ) ) ) = _ttKS
			VAR _ttKD = IF ( CONTAINSSTRING ( _ttKN, "," ), LEN ( _ttKN ) - SEARCH ( ",", _ttKN ), 0 )
			VAR _ttKM = IF ( CONTAINSSTRING ( _ttKN, "." ), "#,##0", "0" ) & IF ( _ttKD > 0, "." & REPT ( "0", _ttKD ) )
			VAR _ttKOd =
			    IF (
			        _ttKOk,
			        "<o-d><o-v>" & _ttKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _ttKN, FORMAT ( ROUND ( _ttKT * [@odf] / 1000, 0 ) / POWER ( 10, _ttKD ), _ttKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _ttN
			    )
			VAR _ttOd = IF ( ISBLANK ( _tf ), _ttTxt, _ttKOd )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Frequência de acidentes · 12 meses" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _ttOd & "</span>" & "<span class='b5 lado2'>" & "por milhão de HHT" & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Base complementar · NBR 14280</span></div>"
			            & "<div class='regua'><i class='mk mk0'></i><span>" & _fx1 & "</span><i class='mk mk2'></i><span>" & _fxN & "</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Cartões
		lineageTag: 6cd58905-4a69-5b35-b7f9-044afa5e79a6

	/// Cartão da aprovação na 1.ª inspeção da carteira no mês (soma ÷ soma), com a meta (o ponto cheio do item da nota) e quantas obras ficam abaixo dela; o verso traz a regra e a primeira e a última faixa. Só lê contas.
	measure 'T5 · Cartão inspeção · HTML' =
			-- 1 · Leituras
			VAR _x = [Canteiro · aprovação na 1.ª inspeção · ref]
			VAR _lim = [Nota · limite inspeção · ponto cheio]
			VAR _abx = [T5 · Inspeção · obras abaixo da meta · ref]
			-- 2 · Textos
			VAR _txN = FORMAT ( ABS ( _x ) * 100, "0.0", "pt-BR" )
			VAR _txS = IF ( ROUND ( _x * 100, 1 ) < 0, "−", "" )
			VAR _txTxt = IF ( ISBLANK ( _x ), "—", _txS & _txN & "%" )
			VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
			VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
			VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
			VAR _toTxt = IF ( _abx = 0, "nenhuma obra abaixo", IF ( _abx = 1, "1 obra abaixo", "⁅" & _abx & "⁆" & " obras abaixo" ) )
			VAR _txtCtx = IF ( ISBLANK ( _x ), "falta na base", "meta " & "⁅" & _tlTxt & "⁆" & " · " & _toTxt )
			VAR _txtRegra = "Serviços aprovados na primeira verificação (FVS) ÷ serviços verificados no mês, com as obras somadas. Na nota, por obra:"
			VAR _fx = SUBSTITUTE ( CALCULATE ( [Nota · item · faixas], dItemNota[Item] = "inspecao" ), " · ", "|" )
			VAR _fxa = PATHITEM ( _fx, 1 )
			VAR _fxz = PATHITEM ( _fx, PATHLENGTH ( _fx ) )
			VAR _fx1 = SUBSTITUTE ( SUBSTITUTE ( _fxa, "<", "&lt;" ), ">", "&gt;" )
			VAR _fxN = SUBSTITUTE ( SUBSTITUTE ( _fxz, "<", "&lt;" ), ">", "&gt;" )
			/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
			VAR _odQ =
			    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
			VAR _txKP = LEN ( _txN ) > 0
			VAR _txKN = IF ( _txKP, _txN )
			VAR _txKS = SUBSTITUTE ( SUBSTITUTE ( _txKN, ".", "" ), ",", "" )
			VAR _txKT = IFERROR ( VALUE ( _txKS ), -1 )
			VAR _txKOk = _txKP && _txKT >= 2 && FORMAT ( _txKT, REPT ( "0", LEN ( _txKS ) ) ) = _txKS
			VAR _txKD = IF ( CONTAINSSTRING ( _txKN, "," ), LEN ( _txKN ) - SEARCH ( ",", _txKN ), 0 )
			VAR _txKM = IF ( CONTAINSSTRING ( _txKN, "." ), "#,##0", "0" ) & IF ( _txKD > 0, "." & REPT ( "0", _txKD ) )
			VAR _txKOd =
			    IF (
			        _txKOk,
			        "<o-d><o-v>" & _txKN & "</o-v><o-t aria-hidden='true'>"
			            & CONCATENATEX (
			                _odQ,
			                IF ( [@odk] = 24, _txKN, FORMAT ( ROUND ( _txKT * [@odf] / 1000, 0 ) / POWER ( 10, _txKD ), _txKM, "pt-BR" ) ),
			                UNICHAR ( 10 ),
			                [@odk], ASC
			            )
			            & "</o-t></o-d>",
			        _txN
			    )
			VAR _txOd = IF ( ISBLANK ( _x ), _txTxt, _txS & _txKOd & "%" )
			-- 4 · Marcação
			VAR _saidaHtml =
			    "<div class='u kc' tabindex='0'>"
			        & "<div class='lado frente'>"
			            & "<p class='ab vs eb'>" & "Aprovação na 1.ª inspeção" & "</p>"
			            & "<div class='linha1'><span class='b6 hero'>" & _txOd & "</span>" & "</div>"
			            & "<p class='ctx'>" & _txtCtx & "</p>"
			        & "</div>"
			        & "<div class='lado verso sobre-creme'>"
			            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
			            & "<p class='regra'>" & _txtRegra & "</p>"
			            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Base complementar · FVS</span></div>"
			            & "<div class='regua'><i class='mk mk0'></i><span>" & _fx1 & "</span><i class='mk mk2'></i><span>" & _fxN & "</span></div>"
			        & "</div>"
			    & "</div>" & [Comum · JS contador]
			VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
			/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
			VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
			VAR _mcHtml =
			    IF (
			        _mcK = 0,
			        _saidaHtml,
			        CONCATENATEX (
			            GENERATESERIES ( 1, _mcK ),
			            VAR _mcj = [Value]
			            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
			            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
			            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
			            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
			            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
			            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
			            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
			            VAR _mcc = LEN ( _mcsg )
			            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
			            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
			            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
			            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
			            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
			            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
			            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
			            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
			            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
			            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
			            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
			            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
			            RETURN
			                _mcantes
			                    & IF (
			                        _mcOk,
			                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
			                            & CONCATENATEX (
			                                _odQ,
			                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
			                                UNICHAR ( 10 ),
			                                [@odk], ASC
			                            )
			                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
			                        _mcpre & _mcnum & _mcsuf
			                    )
			                    & _mcdepois,
			            "",
			            [Value], ASC
			        )
			    )
			RETURN
			    _mcHtml
		displayFolder: T5 Canteiro\Cartões
		lineageTag: 647497ba-8316-5649-8a5a-d353a9c2c04f

	/// Cartão da conformidade NR-18 da carteira no mês (soma ÷ soma), com a meta (o ponto cheio do item NR-18 da nota) e quantas obras ficam abaixo dela; o verso traz a regra e a primeira e a última faixa. Só lê contas.
	measure 'T5 · Cartão NR-18 · HTML' =
			-- 1 · Leituras
			VAR _x = [Canteiro · conformidade NR-18 · ref]
			VAR _lim = [Nota · limite NR-18 · ponto cheio]
			VAR _abx = [T5 · NR-18 · obras abaixo da meta · ref]
			-- 2 · Textos
			VAR _txN = FORMAT ( ABS ( _x ) * 100, "0.0", "pt-BR" )
			VAR _txS = IF ( ROUND ( _x * 100, 1 ) < 0, "−", "" )
			VAR _txTxt = IF ( ISBLANK ( _x ), "—", _txS & _txN & "%" )
			VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
			VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
			VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
			VAR _toTxt = IF ( _abx = 0, "nenhuma obra abaixo", IF ( _abx = 1, "1 obra abaixo", "⁅" & _abx & "⁆" & " obras abaixo" ) )
			VAR _txtCtx = IF ( ISBLANK ( _x ), "falta na base", "meta " & "⁅" & _tlTxt & "⁆" & " · " & _toTxt )
			VAR _txtRegra = "Itens conformes ÷ itens aplicáveis do checklist NR-18 do mês, com as obras somadas. Na nota, por obra:"
			VAR _fx = SUBSTITUTE ( CALCULATE ( [Nota · item · faixas], dItemNota[Item] = "nr18" ), " · ", "|" )
			VAR _fxa = PATHITEM ( _fx, 1 )
