	/// Status pela nota: ≥ 8 → 0, ≥ 6 → 1, abaixo → 2 (0 estável · 1 atenção · 2 crítico); com a trava, crítico. Vazio quando pendente. Só com uma obra no contexto (com várias, vazio).
	measure 'Nota · status' =
			IF (
			    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
			    VAR _n = [Nota · nota final]
			    RETURN
			        IF ( NOT ISBLANK ( _n ), IF ( [Nota · trava] = 1, 2, SWITCH (
			            TRUE (),
			            _n >= 8, 0,
			            _n >= 6, 1,
			            2
			        ) ) )
			)
		formatString: 0
		displayFolder: Base\Nota
		lineageTag: c39d7992-a242-5ded-890d-6b49c140f23a

