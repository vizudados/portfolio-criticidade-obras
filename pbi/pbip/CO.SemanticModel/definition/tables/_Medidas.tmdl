			    & "}.lv .gj .h .de{text-align:right;white-space:nowrap}.lv .gj .h{margin-bottom:6px}.lv .gj .r{height:21px}.lv .gj .r b{font-weight:400;font-size:14px;line-height:19px;white-space:now"
			    & "rap}.lv .gj .r i{display:block;width:12px;height:12px;justify-self:center;animation:ttFim .2s ease-out backwards}.lv .gj i.p{background:#A9CDB9;box-shadow:inset 0 0 0 1px #6E9F85}."
			    & "lv .gj i.b{background:#FFFFFF;border:1.25px dashed #C43737}.lv .gj i.n{background:#EFEFEF}.lv .gj i.v{visibility:hidden}.lv .gj .r em{font-style:normal;text-align:right;font-size:1"
			    & "4px;line-height:19px;white-space:nowrap}.lv .gj .lg{display:flex;gap:14px;margin-top:4px;font-size:14px;line-height:19px;color:#3B3B3F}.lv .gj .lg span{display:inline-flex;align-it"
