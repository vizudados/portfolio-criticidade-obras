/// Curva prevista (linha de base) de cada obra, mês a mês, da aba FLUXO-FINACEIRO da cronograma (stgCrono): o previsto acumulado em fração do orçamento e o índice do mês (1 = mês de início), com uma linha 0 (o mês antes do início, previsto 0). Base do atraso em meses (cronograma agregado, Earned Schedule): as medidas leem a curva da obra pelo nome, sem relação. Obra pelo cadastro (nome_crono → obra); fora do cadastro, o nome da cronograma.
table fCurvaPrevista
	lineageTag: 05af325f-8c37-57e7-b188-643adc5d812b
	isHidden

	/// Obra (do cadastro, pelo nome na cronograma).
	column Obra
		dataType: string
		lineageTag: f1da7f9a-1d7b-5a88-83b8-404d68fcad5e
		summarizeBy: none
		sourceColumn: Obra

		annotation SummarizationSetBy = Automatic

	/// Mês da curva.
	column Mes
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: ab8baa48-a3af-5d9c-a9d9-01f4e620e84c
		summarizeBy: none
		sourceColumn: Mes

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Meses desde o início, contando o mês de início como 1 (0 = mês anterior).
	column Indice
		dataType: int64
		formatString: 0
		lineageTag: 820e41d7-fe04-572e-8824-f0b2b9be6da9
		summarizeBy: none
		sourceColumn: Indice

		annotation SummarizationSetBy = Automatic

	/// Custo previsto no mês.
	column Custo
		dataType: double
		formatString: #,0.00
		lineageTag: 284258bd-c485-5a18-b2a8-5a550314c759
		summarizeBy: none
		sourceColumn: Custo

		annotation SummarizationSetBy = Automatic

	/// Previsto acumulado até o mês ÷ soma da curva.
	column PrevAcum
		dataType: double
		formatString: 0.0000%
		lineageTag: d9677154-3013-51a6-8035-3dae78161cf0
		summarizeBy: none
		sourceColumn: PrevAcum

		annotation SummarizationSetBy = Automatic

	partition fCurvaPrevista = m
		mode: import
		source =
				let
				    Nomes = Table.SelectRows(Table.SelectColumns(stgCadastro, {"Obra", "NomeCrono"}), each [NomeCrono] <> null),
				    ObraDe = (crono as text) as text =>
				        let achada = Table.SelectRows(Nomes, each [NomeCrono] = crono) in if Table.IsEmpty(achada) then crono else achada{0}[Obra],
				    ComCurva = Table.SelectRows(stgCrono, each [ObraCrono] <> null and not List.IsEmpty([Curva])),
				    PorObra = List.Transform(Table.ToRecords(ComCurva), (r) =>
				        let
				            Ordenada = List.Sort(r[Curva], (a, b) => Value.Compare(a[Mes], b[Mes])),
				            Total = List.Sum(List.Transform(Ordenada, each [Custo])),
				            Acum = List.Accumulate(Ordenada, {}, (s, x) => s & {(if List.IsEmpty(s) then 0 else List.Last(s)) + x[Custo]}),
				            Obra = ObraDe(r[ObraCrono]),
				            Linhas = List.Transform(List.Positions(Ordenada), (i) =>
				                [Obra = Obra, Mes = Ordenada{i}[Mes], Indice = i + 1, Custo = Ordenada{i}[Custo],
				                 PrevAcum = if Total = 0 then null else Acum{i} / Total]),
				            Zero = [Obra = Obra, Mes = Date.AddMonths(Ordenada{0}[Mes], -1), Indice = 0, Custo = 0, PrevAcum = 0]
				        in
				            {Zero} & Linhas),
				    Tabela = Table.FromRecords(List.Combine(PorObra), type table [Obra = text, Mes = date, Indice = Int64.Type,
				        Custo = number, PrevAcum = number])
				in
				    Tabela

	annotation PBI_ResultType = Table

