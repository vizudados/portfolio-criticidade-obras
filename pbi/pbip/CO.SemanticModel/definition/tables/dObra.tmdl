		lineageTag: 4aa7d6b5-c02a-5e59-9f6b-94a0b1302d4d
		summarizeBy: none
		sourceColumn: SPE

		annotation SummarizationSetBy = Automatic

	/// Em andamento, A iniciar ou Concluída (cronograma: realizado acumulado ÷ orçamento).
	column Situacao
		dataType: string
		lineageTag: 60ef6269-d39a-5a5c-b56c-2573aad4211c
		summarizeBy: none
		sourceColumn: Situacao
		sortByColumn: OrdemSituacao

		annotation SummarizationSetBy = Automatic

	/// 1 em andamento · 2 a iniciar · 3 concluída · 9 sem situação na cronograma.
	column OrdemSituacao
