		isHidden
		formatString: 0
		lineageTag: 986cb3b8-3f71-50b3-ab66-ecbc0e6fb3b4
		summarizeBy: none
		sourceColumn: OrdemSituacao

		annotation SummarizationSetBy = Automatic

	/// Tipo do orçamento na cronograma (versão em VersaoCrono).
	column TipoOrcamentoCrono
		dataType: string
		lineageTag: 8a87c9f5-fec4-575c-a00b-33aa1e0b89d0
		summarizeBy: none
		sourceColumn: TipoOrcamentoCrono

