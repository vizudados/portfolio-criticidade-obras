		isHidden
		formatString: #,0
		lineageTag: b71ef047-5dfc-52d3-841c-34bc6bad9666
		summarizeBy: none
		sourceColumn: M2

		annotation SummarizationSetBy = Automatic

	/// Início da obra (mês), da cronograma.
	column Inicio
