/// Obras: as do cadastro (em andamento, a iniciar e concluídas), as que estão na cronograma sem estar no cadastro (entram assim mesmo, sem código nem SPE) e qualquer obra que tenha planilha Análise Crítica lida em stgAbas. Situação, orçamento, tipo, m², início e término vêm da cronograma (stgCrono), pelo nome da obra na cronograma (NomeCrono do cadastro); código e SPE vêm do cadastro. Fonte diz se o dado da obra é real (planilha da obra) ou ilustrativo (planilha de exemplo, com FICTICIO no nome); obra sem análise crítica é cronograma. Selo só aparece quando há planilha de exemplo na leitura: aí a real leva REAL e a de exemplo ILUSTR.; com todas reais, nenhuma leva selo.
table dObra
	lineageTag: 8036ad13-a579-52a7-a1bc-562d438dd16b

	/// Nome da obra (do cadastro; obra só da cronograma leva o nome da cronograma).
	column Obra
		dataType: string
		isKey
		lineageTag: a4f056fb-1c67-5648-a90c-78f188640599
		summarizeBy: none
		sourceColumn: Obra

		annotation SummarizationSetBy = Automatic

	/// Código do empreendimento no Fluxo de Caixa (cadastro).
	column Codigo
		dataType: string
		lineageTag: 086ac95a-9155-5b37-92c0-5f0cffdecdd9
		summarizeBy: none
		sourceColumn: Codigo

		annotation SummarizationSetBy = Automatic

