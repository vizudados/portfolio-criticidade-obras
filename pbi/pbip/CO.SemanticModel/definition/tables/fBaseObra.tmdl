/// Bases complementares (modelo BC 2.0): uma linha por obra × mês com algum campo preenchido (a aba que vale em stgAbasBase), de pInicioHistorico em diante, só com o VALOR CRU que foi digitado na base. Faixas, pontos e nota ficam na DAX (dicionário NOTA nas contas do painel). Texto onde se espera número chega vazio (o aviso vai para fConferencia); número fora da faixa válida chega como foi digitado e a DAX o trata como sem dado. Acidentes12m, HHT12m e DiasPerdidos12m somam os 12 meses até o da linha (inclusive os anteriores ao histórico), para as taxas de frequência e de gravidade da NBR 14280. Obra × mês sem base (ou com a aba vazia) não tem linha.
table fBaseObra
	lineageTag: 9e09cf39-6725-51fd-9f5c-310fac751962

	/// Obra (pelo nome do arquivo da base).
	column Obra
		dataType: string
		lineageTag: 0034c960-d9f4-5585-9b6f-33fae709e716
		summarizeBy: none
		sourceColumn: Obra

		annotation SummarizationSetBy = Automatic

	/// Mês de referência (pelo nome da aba).
	column Mes
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 7d5bf2e0-053c-5b22-8987-3e4afffbab42
