/*
@pasta: T5 Canteiro\Cartões\Contas
@formato: 0
@descricao: Obras com algum acidente com afastamento nos 12 meses até o de referência. Ex. set/26: 3 (JANGADA, POTENGI e REDINHA).
@oraculo: dados/_gabarito (base_complementar.csv, fato_analise_critica.csv) · set/26: 3
@gerado: pbi/scripts/contas_t5.py
*/
COUNTROWS ( FILTER ( VALUES ( dObra[Obra] ), [Canteiro · acidentes 12 meses · ref] > 0 ) ) + 0
