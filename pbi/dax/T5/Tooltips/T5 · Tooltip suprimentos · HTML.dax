/*
@pasta: T5 Canteiro\Tooltips
@formato: texto
@descricao: Tooltip de página da obra de Suprimentos por obra (linha sob o mouse): a obra mês a mês na janela, com os pedidos entregues no prazo e completos de previstos e a taxa (marca pelos pontos do item entregas no mês; vermelha abaixo da meta); no pé, o total da janela e a meta com os pontos do item na nota do mês de referência. A linha já mostra o mês de referência: aqui ele é só a última linha da série.
@gerado: pbi/scripts/tooltips_t5.py
*/
-- 1 · Leituras
VAR _obra = [Obra · nome]
VAR _selo = [Obra · selo]
VAR _ini = [Série · primeiro mês]
VAR _ref = [Mês de referência]
VAR _lim = [Nota · limite entregas · ponto cheio]
VAR _npJ = [T5 · Entregas · pedidos no prazo na janela]
VAR _ppJ = [T5 · Entregas · pedidos previstos na janela]
VAR _xJ = [T5 · Entregas · taxa na janela]
VAR _ptR = [Nota · pontos entregas · ref]
VAR _psR = [Nota · possíveis · entregas · ref]
VAR _meses =
    ADDCOLUMNS (
        VALUES ( dMes[Mes] ),
        "@ate", [Série · mês até a referência],
        "@rot", [Mês · rótulo curto],
        "@x", [Canteiro · entregas no prazo],
        "@np", [Canteiro · pedidos no prazo],
        "@pp", [Canteiro · pedidos previstos],
        "@pt", [Nota · pontos entregas],
        "@ps", [Nota · possíveis · entregas]
    )
VAR _com = FILTER ( _meses, [@ate] = 1 && NOT ISBLANK ( [@x] ) ) /* lista */
VAR _nLs = COUNTROWS ( _com ) /* lista */
-- 2 · Textos
VAR _txtPer = UPPER ( FORMAT ( _ini, "mmm/yy", "pt-BR" ) ) & IF ( _ini = _ref, "", "–" & UPPER ( FORMAT ( _ref, "mmm/yy", "pt-BR" ) ) )
VAR _txtRef = FORMAT ( _ref, "mmm/yy", "pt-BR" )
VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
VAR _txtJan =
    IF (
        ISBLANK ( _xJ ),
        "Sem pedido previsto na janela.",
        "⁅" & FORMAT ( _npJ, "#,0", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _ppJ, "#,0", "pt-BR" ) & "⁆" & " pedidos no prazo e completos (" & "⁅" & FORMAT ( _xJ * 100, "0.0", "pt-BR" ) & "⁆" & "%)."
    )
VAR _txtMeta =
    "Meta " & "⁅" & _tlTxt & "⁆" & " · na nota de " & _txtRef & ": entregas " & IF ( ISBLANK ( _ptR ), "sem dado", "⁅" & FORMAT ( _ptR, "0.##", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _psR, "0.##", "pt-BR" ) & "⁆" ) & "."
-- 4 · Marcação
VAR _htmlLinhas =
    CONCATENATEX (
        _com,
        VAR _x = [@x]
        VAR _cls = IF ( ISBLANK ( [@pt] ), "", IF ( [@pt] >= [@ps], "0", IF ( [@pt] = 0, "2", "1" ) ) )
        RETURN
            "<div class='q5 qp'><span class='n" & IF ( dMes[Mes] = _ref, " ref", "" ) & "'>" & [@rot] & "</span>"
                & "<span class='d'>" & "⁅" & FORMAT ( [@np], "#,0", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( [@pp], "#,0", "pt-BR" ) & "⁆" & IF ( [@pp] = 1, " pedido", " pedidos" ) & "</span>"
                & IF ( _cls = "", "<i></i>", "<i class='mk mk" & _cls & "'></i>" ) & "<span class='v" & IF ( _x < _lim, " ng", "" ) & "'>" & "⁅" & FORMAT ( _x * 100, "0.0", "pt-BR" ) & "⁆" & "%</span></div>",
        "",
        dMes[Mes], ASC
    )
VAR _saidaHtml =
    IF (
        NOT ISEMPTY ( _com ) && HASONEVALUE ( dObra[Obra] ),
        "<div class='u tt'><div class='cab'><p class='vs'>" & "SUPRIMENTOS POR OBRA · " & _txtPer & "</p>"
            & "<div class='lin1'><div class='tit'>" & "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</b>" & IF ( _selo = "" || ISBLANK ( _selo ), "", "<span class='selo " & IF ( _selo = "REAL", "selo-r", "selo-i" ) & "'>" & _selo & "</span>" ) & "</div></div></div>"
            & "<div class='corpo'><div class='bh'><span class='vs'>PEDIDOS NO PRAZO E COMPLETOS, MÊS A MÊS</span>"
            & "<span class='vs'>TAXA</span></div><div class='lsq" & " ls " & SWITCH ( TRUE (), _nLs <= 3, "e1", _nLs <= 6, "e2", _nLs <= 9, "e3", _nLs <= 12, "e4", "e5" ) & "' style='--n:" & _nLs & "'>" & _htmlLinhas & "</div></div>"
            & "<div class='pe'><p class='rod'><b>Na janela:</b> " & _txtJan & "</p>"
            & "<p class='rod'>" & _txtMeta & "</p></div>"
        & "</div>" & [Comum · JS contador tooltip]
    )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
