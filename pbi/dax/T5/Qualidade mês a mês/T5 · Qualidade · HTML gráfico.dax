/*
@pasta: T5 Canteiro\Qualidade mês a mês
@formato: texto
@descricao: Aprovação na 1.ª inspeção mês a mês na janela (1 a 12 meses), sem granularidade: uma linha fina por obra do recorte (cinza), a obra com a menor aprovação no mês de referência em grafite e a carteira (soma ÷ soma) em preto com os pontos; a meta (o ponto cheio do item 1.ª inspeção) tracejada. Eixo de 100% até a base da escala (T5 · Qualidade · base da escala), grade de 5 em 5 pontos; rótulos finais da carteira e da obra em destaque (afastados quando se encostam). As linhas se desenham da esquerda para a direita.
@gerado: pbi/scripts/desenho_t5.py
*/
-- 1 · Leituras
VAR _ref = [Mês de referência]
VAR _n = [Série · meses até a referência]
VAR _base = [T5 · Qualidade · base da escala]
VAR _lim = [Nota · limite inspeção · ponto cheio]
VAR _dest = [T5 · Qualidade · obra em destaque · ref]
VAR _cRef = [Canteiro · aprovação na 1.ª inspeção · ref]
VAR _dRef = [T5 · Leitura qualidade · aprovação da obra em destaque · ref]
VAR _meses =
    ADDCOLUMNS (
        VALUES ( dMes[Mes] ),
        "@ate", [Série · mês até a referência],
        "@pj", [Série · posição na janela],
        "@v", [Canteiro · aprovação na 1.ª inspeção],
        "@rot", [Mês · rótulo curto]
    )
VAR _janela = FILTER ( _meses, [@ate] = 1 ) /* lista */
VAR _cart = FILTER ( _janela, NOT ISBLANK ( [@v] ) ) /* lista */
VAR _obras =
    ADDCOLUMNS (
        CROSSJOIN ( VALUES ( dObra[Obra] ), VALUES ( dMes[Mes] ) ),
        "@ate", [Série · mês até a referência],
        "@pj", [Série · posição na janela],
        "@v", [Canteiro · aprovação na 1.ª inspeção]
    )
VAR _pts = FILTER ( _obras, [@ate] = 1 && NOT ISBLANK ( [@v] ) ) /* lista */
-- 2 · Textos
VAR _tcN = FORMAT ( ABS ( _cRef ) * 100, "0.0", "pt-BR" )
VAR _tcS = IF ( ROUND ( _cRef * 100, 1 ) < 0, "−", "" )
VAR _tcTxt = IF ( ISBLANK ( _cRef ), "—", _tcS & _tcN & "%" )
VAR _tdN = FORMAT ( ABS ( _dRef ) * 100, "0.0", "pt-BR" )
VAR _tdS = IF ( ROUND ( _dRef * 100, 1 ) < 0, "−", "" )
VAR _tdTxt = IF ( ISBLANK ( _dRef ), "—", _tdS & _tdN & "%" )
VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
-- 3 · Geometria
VAR _passoX = IF ( _n > 1, DIVIDE ( 836, _n - 1 ), 0 ) /* geometria */
VAR _escY = DIVIDE ( 248, 1 - _base ) /* geometria */
VAR _xU = 900 -- geometria
VAR _yC = IF ( NOT ISBLANK ( _cRef ), ROUND ( 262 - ( _cRef - _base ) * _escY, 0 ) ) -- geometria
VAR _yD = IF ( NOT ISBLANK ( _dRef ), ROUND ( 262 - ( _dRef - _base ) * _escY, 0 ) ) -- geometria
VAR _yM = ROUND ( 262 - ( _lim - _base ) * _escY, 0 ) -- geometria
VAR _temD = NOT ISBLANK ( _dRef ) && _dest <> "" -- geometria
VAR _gap = IF ( _temD, ABS ( _yC - _yD ), 99 ) -- geometria
VAR _meio = IF ( _temD, ROUND ( ( _yC + _yD ) / 2, 0 ), _yC ) -- geometria
VAR _yLC = IF ( _gap < 20, IF ( _yC <= _yD, _meio - 20, _meio ), _yC - 9 ) -- geometria
VAR _yLD = IF ( _gap < 20, IF ( _yC <= _yD, _meio, _meio - 20 ), _yD - 9 ) -- geometria
VAR _nLinhas = ROUND ( ( 1 - _base ) / 0.05, 0 ) -- geometria
-- 4 · Marcação
VAR _linhas =
    CONCATENATEX (
        VALUES ( dObra[Obra] ),
        VAR _o = dObra[Obra]
        VAR _p = FILTER ( _pts, dObra[Obra] = _o ) /* lista */
        VAR _d = CONCATENATEX ( _p, ROUND ( IF ( _n > 1, 64 + ( [@pj] - 1 ) * _passoX, 900 ), 0 ) & "," & ROUND ( 262 - ( [@v] - _base ) * _escY, 0 ), " L", [@pj], ASC )
        RETURN
            IF ( NOT ISEMPTY ( _p ), "<path class='" & IF ( _o = _dest, "ld", "lo" ) & "' pathLength='1000' d='M" & _d & "'/>" ),
        "",
        IF ( dObra[Obra] = _dest, 1, 0 ), ASC, dObra[Obra], ASC
    )
VAR _dCart = "M" & CONCATENATEX ( _cart, ROUND ( IF ( _n > 1, 64 + ( [@pj] - 1 ) * _passoX, 900 ), 0 ) & "," & ROUND ( 262 - ( [@v] - _base ) * _escY, 0 ), " L", [@pj], ASC )
VAR _pontos =
    CONCATENATEX (
        _cart,
        "<circle class='a-pop' cx='" & ROUND ( IF ( _n > 1, 64 + ( [@pj] - 1 ) * _passoX, 900 ), 0 ) & "' cy='" & ROUND ( 262 - ( [@v] - _base ) * _escY, 0 ) & "' r='3.5' style='animation-delay:" & ( 300 + ROUND ( ( [@pj] - 1 ) * 1000 / MAX ( 1, _n - 1 ), 0 ) ) & "ms'/>",
        "",
        [@pj], ASC
    )
VAR _grade =
    CONCATENATEX (
        GENERATESERIES ( 0, _nLinhas ),
        VAR _y = ROUND ( 262 - [Value] * 0.05 * _escY, 0 ) /* geometria */
        RETURN
            "<i class='gr a-fd' style='top:" & _y & "px'></i><span class='ey a-fd' style='top:" & ( _y - 8 ) & "px'>"
                & "⁅" & FORMAT ( ( _base + [Value] * 0.05 ) * 100, "0", "pt-BR" ) & "⁆" & "%</span>",
        "",
        [Value], ASC
    )
VAR _eixoX =
    CONCATENATEX (
        _janela,
        VAR _x = ROUND ( IF ( _n > 1, 64 + ( [@pj] - 1 ) * _passoX, 900 ), 0 ) /* geometria */
        RETURN
            "<span class='ex a-fd" & IF ( dMes[Mes] = _ref, " ref", "" ) & "' style='animation-delay:" & ROUND ( ( [@pj] - 1 ) * 1000 / MAX ( 1, _n - 1 ), 0 ) & "ms;left:" & ( _x - 30 )
                & "px;top:278px'>" & [@rot] & "</span>",
        "",
        [@pj], ASC
    )
VAR _svg =
    "<svg width='1068' height='278' viewBox='0 0 1068 278' aria-hidden='true'>"
        & "<path class='mt a-gx' d='M52," & _yM & " H912'/>" & _linhas
        & IF ( NOT ISEMPTY ( _cart ), "<path class='lc' pathLength='1000' d='" & _dCart & "'/>" & _pontos )
    & "</svg>"
VAR _saidaHtml =
    IF (
        NOT ISEMPTY ( _pts ),
        "<div class='u ql'>" & _grade & _svg & _eixoX
            & IF ( NOT ISBLANK ( _cRef ), "<span class='fl c a-fd' style='animation-delay:1.3s;left:" & ( _xU + 14 ) & "px;top:" & _yLC
                & "px'><b>" & "⁅" & _tcTxt & "⁆" & "</b>carteira</span>" )
            & IF ( _temD, "<span class='fl a-fd' style='animation-delay:1.2s;left:" & ( _xU + 14 ) & "px;top:" & _yLD & "px'><b>" & "⁅" & _tdTxt & "⁆"
                & "</b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _dest, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</span>" )
        & "</div>" & [Comum · JS contador],
        "<div class='u ql'><p class='vz'>Sem base complementar das obras na janela.</p></div>"
    )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
