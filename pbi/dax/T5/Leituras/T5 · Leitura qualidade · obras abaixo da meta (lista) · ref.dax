/*
@pasta: T5 Canteiro\Leituras\Contas
@formato: texto
@descricao: Obras com [Canteiro · aprovação na 1.ª inspeção] no mês de referência abaixo do ponto cheio da nota, da menor para a maior. Ex. set/26: REDINHA|POTENGI|JANGADA.
@oraculo: dados/_gabarito (base_complementar.csv, fato_analise_critica.csv) · set/26
@gerado: pbi/scripts/contas_t5.py
*/
CONCATENATEX (
    FILTER ( VALUES ( dObra[Obra] ), VAR _x = [Canteiro · aprovação na 1.ª inspeção · ref] RETURN NOT ISBLANK ( _x ) && _x < [Nota · limite inspeção · ponto cheio] ),
    dObra[Obra], "|", [Canteiro · aprovação na 1.ª inspeção · ref], ASC, dObra[Obra], ASC
)
