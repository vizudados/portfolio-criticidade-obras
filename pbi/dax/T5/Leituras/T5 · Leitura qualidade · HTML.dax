/*
@pasta: T5 Canteiro\Leituras
@formato: texto
@descricao: Leitura do "?" de Qualidade, mês a mês, sobre o próprio painel (1068 × 380, completa em duas colunas): a aprovação da carteira no mês contra a meta (achado), as obras abaixo da meta e há quantos meses a menor está abaixo (explicação), dois destaques (a menor obra e os meses da carteira na meta) e, à direita, a aprovação de cada obra no mês e o que o indicador mede. Só lê contas.
@gerado: pbi/scripts/leituras_t5.py
*/
-- 1 · Leituras
VAR _mesN = [Mês de referência · nome]
VAR _mesC = [Mês de referência · curto maiúsculo]
VAR _c = [Canteiro · aprovação na 1.ª inspeção · ref]
VAR _lim = [Nota · limite inspeção · ponto cheio]
VAR _lAbx = [T5 · Leitura qualidade · obras abaixo da meta (lista) · ref]
VAR _dest = [T5 · Qualidade · obra em destaque · ref]
VAR _vDest = [T5 · Leitura qualidade · aprovação da obra em destaque · ref]
VAR _mDest = [T5 · Leitura qualidade · meses da obra em destaque abaixo da meta] + 0
VAR _nMeta = [T5 · Leitura qualidade · meses da carteira na meta] + 0
VAR _nMeses = [T5 · Leitura qualidade · meses com base] + 0
VAR _obras =
    ADDCOLUMNS (
        VALUES ( dObra[Obra] ),
        "@v", [Canteiro · aprovação na 1.ª inspeção · ref],
        "@pt", [Nota · pontos inspeção · ref],
        "@ps", [Nota · possíveis · inspeção · ref]
    )
VAR _det = FILTER ( _obras, NOT ISBLANK ( [@v] ) ) /* lista */
-- 2 · Textos
VAR _tcN = FORMAT ( ABS ( _c ) * 100, "0.0", "pt-BR" )
VAR _tcS = IF ( ROUND ( _c * 100, 1 ) < 0, "−", "" )
VAR _tcTxt = IF ( ISBLANK ( _c ), "—", _tcS & _tcN & "%" )
VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
VAR _tdN = FORMAT ( ABS ( _vDest ) * 100, "0.0", "pt-BR" )
VAR _tdS = IF ( ROUND ( _vDest * 100, 1 ) < 0, "−", "" )
VAR _tdTxt = IF ( ISBLANK ( _vDest ), "—", _tdS & _tdN & "%" )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _tdKP = LEN ( _tdN ) > 0
VAR _tdKN = IF ( _tdKP, _tdN )
VAR _tdKS = SUBSTITUTE ( SUBSTITUTE ( _tdKN, ".", "" ), ",", "" )
VAR _tdKT = IFERROR ( VALUE ( _tdKS ), -1 )
VAR _tdKOk = _tdKP && _tdKT >= 2 && FORMAT ( _tdKT, REPT ( "0", LEN ( _tdKS ) ) ) = _tdKS
VAR _tdKD = IF ( CONTAINSSTRING ( _tdKN, "," ), LEN ( _tdKN ) - SEARCH ( ",", _tdKN ), 0 )
VAR _tdKM = IF ( CONTAINSSTRING ( _tdKN, "." ), "#,##0", "0" ) & IF ( _tdKD > 0, "." & REPT ( "0", _tdKD ) )
VAR _tdKOd =
    IF (
        _tdKOk,
        "<o-d><o-v>" & _tdKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tdKN, FORMAT ( ROUND ( _tdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdKD ), _tdKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tdN
    )
VAR _tdOd = IF ( ISBLANK ( _vDest ), _tdTxt, _tdS & _tdKOd & "%" )
VAR _txtSob = "LEITURA · QUALIDADE, MÊS A MÊS · " & _mesC
VAR _achado =
    "A carteira aprovou " & "⁅" & _tcTxt & "⁆" & " dos serviços na primeira inspeção em " & _mesN
        & IF ( _c >= _lim, ", na meta de ", ", abaixo da meta de " ) & "⁅" & _tlTxt & "⁆" & "."
VAR _laN = IF ( ISBLANK ( _lAbx ) || _lAbx = "", 0, PATHLENGTH ( _lAbx ) )
VAR _laPos = IF ( _laN >= 2, FIND ( "§", SUBSTITUTE ( _lAbx, "|", "§", _laN - 1 ) ) )
VAR _laTxt = SWITCH ( TRUE (), _laN = 0, "", _laN = 1, _lAbx, SUBSTITUTE ( LEFT ( _lAbx, _laPos - 1 ), "|", ", " ) & " e " & MID ( _lAbx, _laPos + 1, 999 ) )
VAR _txtAbx =
    SWITCH (
        TRUE (),
        _laN = 0, "Nenhuma obra ficou abaixo da meta no mês.",
        _laN = 1, "Só " & _laTxt & " ficou abaixo da meta no mês.",
        UPPER ( LEFT ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ), 1 ) ) & MID ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ), 2, LEN ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ) ) ) & " obras ficaram abaixo da meta: " & _laTxt & "."
    )
VAR _txtDest =
    IF (
        _laN = 0 || ISBLANK ( _dest ),
        "",
        " A menor do mês, " & _dest & ", ficou " & IF ( _mDest = _nMeses, "abaixo em todos os " & "⁅" & _nMeses & "⁆" & " meses da janela.", "abaixo em " & "⁅" & _mDest & "⁆" & " dos " & "⁅" & _nMeses & "⁆" & " meses da janela." )
    )
VAR _explica = _txtAbx & _txtDest
VAR _txtD1 = IF ( ISBLANK ( _dest ), "", _dest & ", a menor do mês" )
VAR _txtD2 = IF ( _nMeta = 1, "mês da carteira na meta", "meses da carteira na meta" ) & " na janela"
VAR _txtOqe =
    "Serviço reprovado na primeira inspeção (FVS) volta para ser refeito: é retrabalho, que pesa no custo e no "
        & "prazo. Na nota, o ponto cheio do item começa em " & "⁅" & _tlTxt & "⁆" & "."
-- 4 · Marcação
VAR _htmlDet =
    CONCATENATEX (
        _det,
        VAR _cls = IF ( ISBLANK ( [@pt] ), "", IF ( [@pt] >= [@ps], "0", IF ( [@pt] = 0, "2", "1" ) ) )
        VAR _d = 300 + ( RANKX ( _det, [@v], , ASC, Dense ) - 1 ) * 60 -- geometria
        RETURN
            "<div class='r a-fd' style='animation-delay:" & _d & "ms'><b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dObra[Obra], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</b><span>" & IF ( _cls = "", "", "<i class='mk a-pop mk" & _cls & "' style='animation-delay:" & ( _d + 100 ) & "ms'></i>" ) & "⁅" & FORMAT ( [@v] * 100, "0.0", "pt-BR" ) & "⁆" & "%</span></div>",
        "",
        [@v], ASC, dObra[Obra], ASC
    )
VAR _esq =
    "<div class='esq'><span class='vs sob'>" & _txtSob & "</span>"
        & "<h2 class='ach'>" & _achado & "</h2>"
        & "<p class='exp'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _explica, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>"
        & "<div class='dst sobre-creme'>"
        & IF ( ISBLANK ( _dest ), "", "<div><b>" & _tdOd & "</b><span>" & _txtD1 & "</span></div>" )
        & "<div><b>" & "⁅" & _nMeta & "⁆" & " de " & "⁅" & _nMeses & "⁆" & "</b><span>" & _txtD2 & "</span></div>"
        & "</div>"
        & "<div class='sec'><span class='vs'>Como ler</span>" & "<p class='cl'>Cada linha fina é uma obra; a preta é a carteira (aprovados ÷ verificados, com as obras somadas) e a grafite, a obra com a menor aprovação no mês. O tracejado é a meta.</p>" & "</div>"
    & "</div>"
VAR _dir =
    "<div class='dir'><span class='vs'>Detalhe</span>"
        & "<p class='sub'>aprovação na 1.ª inspeção em " & _mesN & ", da menor para a maior</p>"
        & "<div class='dl'>" & _htmlDet & "</div>"
        & "<div class='sec'><span class='vs'>O que explica</span>" & "<p class='oqe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtOqe, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" & "</div>"
    & "</div>"
VAR _corpo = "<div class='cols'>" & _esq & "<i class='div'></i>" & _dir & "</div>"
VAR _saidaHtml =
    IF ( NOT ISBLANK ( _c ), "<div class='u lv' role='dialog' aria-label='" & "Leitura de Qualidade, mês a mês" & "'><div class='pn pn-2c'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
