/*
@pasta: T5 Canteiro\Leituras
@formato: texto
@descricao: Leitura do "?" de Segurança por obra, sobre o próprio painel (400 × 380, condensada): quantas obras tiveram acidente com afastamento em 12 meses e quais passam da média do setor (achado), as obras abaixo da meta no checklist NR-18 do mês (explicação) e dois destaques (a taxa de frequência da carteira e a conformidade NR-18 da carteira). Só lê contas.
@gerado: pbi/scripts/leituras_t5.py
*/
-- 1 · Leituras
VAR _mesN = [Mês de referência · nome]
VAR _mesC = [Mês de referência · curto maiúsculo]
VAR _n = [T5 · Obras com base · ref]
VAR _nAc = [T5 · Segurança · obras com acidente em 12 meses · ref]
VAR _lAcima = [T5 · Leitura segurança · obras acima do setor (lista) · ref]
VAR _lNr = [T5 · Leitura segurança · obras abaixo da meta (lista) · ref]
VAR _tf = [Canteiro · taxa de frequência (12 meses) · ref]
VAR _nr = [Canteiro · conformidade NR-18 · ref]
VAR _limNr = [Nota · limite NR-18 · ponto cheio]
-- 2 · Textos
VAR _ttfN = IF ( _tf = INT ( _tf ), FORMAT ( _tf, "0", "pt-BR" ), FORMAT ( _tf, "0.0", "pt-BR" ) )
VAR _ttfTxt = IF ( ISBLANK ( _tf ), "—", _ttfN )
VAR _tnrN = FORMAT ( ABS ( _nr ) * 100, "0.0", "pt-BR" )
VAR _tnrS = IF ( ROUND ( _nr * 100, 1 ) < 0, "−", "" )
VAR _tnrTxt = IF ( ISBLANK ( _nr ), "—", _tnrS & _tnrN & "%" )
VAR _tlN = FORMAT ( ABS ( _limNr ) * 100, "0", "pt-BR" )
VAR _tlS = IF ( ROUND ( _limNr * 100, 0 ) < 0, "−", "" )
VAR _tlTxt = IF ( ISBLANK ( _limNr ), "—", _tlS & _tlN & "%" )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _ttfKP = LEN ( _ttfN ) > 0
VAR _ttfKN = IF ( _ttfKP, _ttfN )
VAR _ttfKS = SUBSTITUTE ( SUBSTITUTE ( _ttfKN, ".", "" ), ",", "" )
VAR _ttfKT = IFERROR ( VALUE ( _ttfKS ), -1 )
VAR _ttfKOk = _ttfKP && _ttfKT >= 2 && FORMAT ( _ttfKT, REPT ( "0", LEN ( _ttfKS ) ) ) = _ttfKS
VAR _ttfKD = IF ( CONTAINSSTRING ( _ttfKN, "," ), LEN ( _ttfKN ) - SEARCH ( ",", _ttfKN ), 0 )
VAR _ttfKM = IF ( CONTAINSSTRING ( _ttfKN, "." ), "#,##0", "0" ) & IF ( _ttfKD > 0, "." & REPT ( "0", _ttfKD ) )
VAR _ttfKOd =
    IF (
        _ttfKOk,
        "<o-d><o-v>" & _ttfKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _ttfKN, FORMAT ( ROUND ( _ttfKT * [@odf] / 1000, 0 ) / POWER ( 10, _ttfKD ), _ttfKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _ttfN
    )
VAR _ttfOd = IF ( ISBLANK ( _tf ), _ttfTxt, _ttfKOd )
VAR _tnrKP = LEN ( _tnrN ) > 0
VAR _tnrKN = IF ( _tnrKP, _tnrN )
VAR _tnrKS = SUBSTITUTE ( SUBSTITUTE ( _tnrKN, ".", "" ), ",", "" )
VAR _tnrKT = IFERROR ( VALUE ( _tnrKS ), -1 )
VAR _tnrKOk = _tnrKP && _tnrKT >= 2 && FORMAT ( _tnrKT, REPT ( "0", LEN ( _tnrKS ) ) ) = _tnrKS
VAR _tnrKD = IF ( CONTAINSSTRING ( _tnrKN, "," ), LEN ( _tnrKN ) - SEARCH ( ",", _tnrKN ), 0 )
VAR _tnrKM = IF ( CONTAINSSTRING ( _tnrKN, "." ), "#,##0", "0" ) & IF ( _tnrKD > 0, "." & REPT ( "0", _tnrKD ) )
VAR _tnrKOd =
    IF (
        _tnrKOk,
        "<o-d><o-v>" & _tnrKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tnrKN, FORMAT ( ROUND ( _tnrKT * [@odf] / 1000, 0 ) / POWER ( 10, _tnrKD ), _tnrKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tnrN
    )
VAR _tnrOd = IF ( ISBLANK ( _nr ), _tnrTxt, _tnrS & _tnrKOd & "%" )
VAR _laN = IF ( ISBLANK ( _lAcima ) || _lAcima = "", 0, PATHLENGTH ( _lAcima ) )
VAR _laPos = IF ( _laN >= 2, FIND ( "§", SUBSTITUTE ( _lAcima, "|", "§", _laN - 1 ) ) )
VAR _laTxt = SWITCH ( TRUE (), _laN = 0, "", _laN = 1, _lAcima, SUBSTITUTE ( LEFT ( _lAcima, _laPos - 1 ), "|", ", " ) & " e " & MID ( _lAcima, _laPos + 1, 999 ) )
VAR _lnN = IF ( ISBLANK ( _lNr ) || _lNr = "", 0, PATHLENGTH ( _lNr ) )
VAR _lnPos = IF ( _lnN >= 2, FIND ( "§", SUBSTITUTE ( _lNr, "|", "§", _lnN - 1 ) ) )
VAR _lnTxt = SWITCH ( TRUE (), _lnN = 0, "", _lnN = 1, _lNr, SUBSTITUTE ( LEFT ( _lNr, _lnPos - 1 ), "|", ", " ) & " e " & MID ( _lNr, _lnPos + 1, 999 ) )
VAR _txtSob = "LEITURA · SEGURANÇA · " & _mesC
VAR _txtAc =
    SWITCH (
        TRUE (),
        _nAc = 0, "Nenhuma das " & SWITCH ( _n, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " obras teve acidente com afastamento em 12 meses",
        _nAc = 1, "Uma das " & SWITCH ( _n, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " obras teve acidente com afastamento em 12 meses",
        UPPER ( LEFT ( SWITCH ( _nAc, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAc, "0" ) ), 1 ) ) & MID ( SWITCH ( _nAc, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAc, "0" ) ), 2, LEN ( SWITCH ( _nAc, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nAc, "0" ) ) ) ) & " das " & SWITCH ( _n, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " obras tiveram acidente com afastamento em 12 meses"
    )
VAR _achado =
    _txtAc & SWITCH (
        TRUE (),
        _nAc = 0, ".",
        _laN = 0, IF ( _nAc = 1, ", dentro da média do setor.", ", todas dentro da média do setor." ),
        "; " & _laTxt & IF ( _laN = 1, " passa", " passam" ) & " da média do setor."
    )
VAR _explica =
    IF (
        _lnN = 0,
        "No checklist NR-18 de " & _mesN & ", todas as obras ficaram com " & "⁅" & _tlTxt & "⁆" & " ou mais.",
        "No checklist NR-18 de " & _mesN & ", " & _lnTxt & IF ( _lnN = 1, " ficou", " ficaram" ) & " abaixo de " & "⁅" & _tlTxt & "⁆" & "."
    )
-- 4 · Marcação
VAR _corpo =
    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _achado & "</h2>"
        & "<p class='exp'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _explica, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>"
        & "<div class='dst sobre-creme'>"
        & "<div><b>" & _ttfOd & "</b><span>" & "acidentes por milhão de HHT na carteira" & "</span></div>"
        & "<div><b>" & _tnrOd & "</b><span>" & "da NR-18 conforme na carteira" & "</span></div>"
        & "</div>"
VAR _saidaHtml =
    IF ( _n > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura de Segurança por obra" & "'><div class='pn pn-t4p pn-t5p'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
