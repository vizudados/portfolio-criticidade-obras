/*
@pasta: T5 Canteiro\Leituras
@formato: texto
@descricao: Leitura do "?" de Suprimentos por obra, sobre o próprio painel (400 × 347, condensada): quantas obras receberam menos que a meta de pedidos no prazo e completos e quais (achado), os pedidos da carteira (explicação) e dois destaques (a taxa da carteira e a da pior obra). Só lê contas.
@gerado: pbi/scripts/leituras_t5.py
*/
-- 1 · Leituras
VAR _mesN = [Mês de referência · nome]
VAR _mesC = [Mês de referência · curto maiúsculo]
VAR _n = [T5 · Obras com base · ref]
VAR _lAbx = [T5 · Leitura suprimentos · obras abaixo da meta (lista) · ref]
VAR _np = [Canteiro · pedidos no prazo · ref] + 0
VAR _pp = [Canteiro · pedidos previstos · ref] + 0
VAR _x = [Canteiro · entregas no prazo · ref]
VAR _pior = [T5 · Leitura suprimentos · pior obra · ref]
VAR _xPior = [T5 · Leitura suprimentos · pior entrega · ref]
VAR _lim = [Nota · limite entregas · ponto cheio]
-- 2 · Textos
VAR _txN = FORMAT ( ABS ( _x ) * 100, "0.0", "pt-BR" )
VAR _txS = IF ( ROUND ( _x * 100, 1 ) < 0, "−", "" )
VAR _txTxt = IF ( ISBLANK ( _x ), "—", _txS & _txN & "%" )
VAR _tpN = FORMAT ( ABS ( _xPior ) * 100, "0.0", "pt-BR" )
VAR _tpS = IF ( ROUND ( _xPior * 100, 1 ) < 0, "−", "" )
VAR _tpTxt = IF ( ISBLANK ( _xPior ), "—", _tpS & _tpN & "%" )
VAR _tlN = FORMAT ( ABS ( _lim ) * 100, "0", "pt-BR" )
VAR _tlS = IF ( ROUND ( _lim * 100, 0 ) < 0, "−", "" )
VAR _tlTxt = IF ( ISBLANK ( _lim ), "—", _tlS & _tlN & "%" )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _txKP = LEN ( _txN ) > 0
VAR _txKN = IF ( _txKP, _txN )
VAR _txKS = SUBSTITUTE ( SUBSTITUTE ( _txKN, ".", "" ), ",", "" )
VAR _txKT = IFERROR ( VALUE ( _txKS ), -1 )
VAR _txKOk = _txKP && _txKT >= 2 && FORMAT ( _txKT, REPT ( "0", LEN ( _txKS ) ) ) = _txKS
VAR _txKD = IF ( CONTAINSSTRING ( _txKN, "," ), LEN ( _txKN ) - SEARCH ( ",", _txKN ), 0 )
VAR _txKM = IF ( CONTAINSSTRING ( _txKN, "." ), "#,##0", "0" ) & IF ( _txKD > 0, "." & REPT ( "0", _txKD ) )
VAR _txKOd =
    IF (
        _txKOk,
        "<o-d><o-v>" & _txKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _txKN, FORMAT ( ROUND ( _txKT * [@odf] / 1000, 0 ) / POWER ( 10, _txKD ), _txKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _txN
    )
VAR _txOd = IF ( ISBLANK ( _x ), _txTxt, _txS & _txKOd & "%" )
VAR _tpKP = LEN ( _tpN ) > 0
VAR _tpKN = IF ( _tpKP, _tpN )
VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
VAR _tpKOd =
    IF (
        _tpKOk,
        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tpN
    )
VAR _tpOd = IF ( ISBLANK ( _xPior ), _tpTxt, _tpS & _tpKOd & "%" )
VAR _laN = IF ( ISBLANK ( _lAbx ) || _lAbx = "", 0, PATHLENGTH ( _lAbx ) )
VAR _laPos = IF ( _laN >= 2, FIND ( "§", SUBSTITUTE ( _lAbx, "|", "§", _laN - 1 ) ) )
VAR _laTxt = SWITCH ( TRUE (), _laN = 0, "", _laN = 1, _lAbx, SUBSTITUTE ( LEFT ( _lAbx, _laPos - 1 ), "|", ", " ) & " e " & MID ( _lAbx, _laPos + 1, 999 ) )
VAR _txtSob = "LEITURA · SUPRIMENTOS · " & _mesC
VAR _achado =
    SWITCH (
        TRUE (),
        _laN = 0, "Todas as " & SWITCH ( _n, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _n, "0" ) ) & " obras receberam pelo menos " & "⁅" & _tlTxt & "⁆" & " dos pedidos no prazo e "
            & "completos em " & _mesN & ".",
        _laN = 1, "Só " & _laTxt & " recebeu menos de " & "⁅" & _tlTxt & "⁆" & " dos pedidos no prazo e completos em " & _mesN & ".",
        UPPER ( LEFT ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ), 1 ) ) & MID ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ), 2, LEN ( SWITCH ( _laN, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _laN, "0" ) ) ) ) & " obras receberam menos de " & "⁅" & _tlTxt & "⁆" & " dos pedidos no prazo e completos: " & _laTxt & "."
    )
VAR _explica = "Na carteira, " & "⁅" & _np & "⁆" & " de " & "⁅" & _pp & "⁆" & IF ( _pp = 1, " pedido chegou", " pedidos chegaram" ) & " no prazo e completos."
VAR _txtD2 = IF ( ISBLANK ( _pior ), "", "na " & _pior & ", a menor do mês" )
-- 4 · Marcação
VAR _corpo =
    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _achado, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</h2>"
        & "<p class='exp'>" & _explica & "</p>"
        & "<div class='dst sobre-creme'>"
        & "<div><b>" & _txOd & "</b><span>" & "da carteira no prazo e completos" & "</span></div>"
        & IF ( ISBLANK ( _pior ), "", "<div><b>" & _tpOd & "</b><span>" & _txtD2 & "</span></div>" )
        & "</div>"
VAR _saidaHtml =
    IF ( _pp > 0, "<div class='u lv' role='dialog' aria-label='" & "Leitura de Suprimentos por obra" & "'><div class='pn pn-t4p pn-t5p'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
