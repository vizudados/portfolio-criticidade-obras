/*
@pasta: T1 Visão geral\Cartões
@formato: texto
@descricao: Cartão 'obras em andamento' (frente e verso): obras com aba no mês, orçamento somado e as obras por status da nota (crítico, atenção, estável, pendente). O verso explica a Nota da obra, a trava e a régua dos status, lidas das medidas Nota · status · faixa … e Nota · limite … · trava. Só lê contas · ref.
@gerado: pbi/scripts/desenho_t1.py
*/
-- 1 · Leituras
VAR _n = [Obras com análise · ref]
VAR _orc = [Orçamento · ref]
VAR _crit = [Nota · carteira · obras críticas · ref]
VAR _aten = [Nota · carteira · obras em atenção · ref]
VAR _est = [Nota · carteira · obras estáveis · ref]
VAR _pend = [Nota · carteira · obras pendentes · ref]
VAR _max = [Nota · nota · máximo]
VAR _fxC = [Nota · status · faixa crítico]
VAR _fxA = [Nota · status · faixa atenção]
VAR _fxE = [Nota · status · faixa estável]
VAR _trvC = [Nota · limite custo · trava]
VAR _trvP = [Nota · limite prazo · trava]
-- 2 · Textos
VAR _tnN = FORMAT ( _n, "#,0", "pt-BR" )
VAR _tnTxt = IF ( ISBLANK ( _n ), "0", _tnN )
VAR _toA = ABS ( _orc )
VAR _toNu = SWITCH ( TRUE (), _toA >= 99950000, FORMAT ( _toA / 1000000, "0.0", "pt-BR" ), _toA >= 999500, FORMAT ( _toA / 1000000, "0.00", "pt-BR" ), _toA >= 999.5, FORMAT ( _toA / 1000, "0", "pt-BR" ), FORMAT ( _toA, "#,0", "pt-BR" ) )
VAR _toUn = SWITCH ( TRUE (), _toA >= 999500, " mi", _toA >= 999.5, " mil", "" )
VAR _toN = _toNu & _toUn
VAR _toZero = _toN = "0"
VAR _toS = IF ( _toZero, "", IF ( _orc < 0, "−", "" ) )
VAR _toTxt = IF ( ISBLANK ( _orc ), "—", _toS & "R$ " & _toN )
VAR _c = _crit + 0
VAR _a = _aten + 0
VAR _e = _est + 0
VAR _p = _pend + 0
VAR _quatro = _c > 0 && _a > 0 && _e > 0 && _p > 0
VAR _wC = IF ( _c > 0, "⁅" & _c & "⁆" & IF ( _c = 1, " crítica", " críticas" ) )
VAR _wA = IF ( _a > 0, "⁅" & _a & "⁆" & " atenção" )
VAR _wE = IF ( _e > 0, "⁅" & _e & "⁆" & IF ( _e = 1, " estável", " estáveis" ) )
VAR _wP = IF ( _p > 0, "⁅" & _p & "⁆" & IF ( _p = 1, " pendente", " pendentes" ) )
VAR _palavras = _wC & IF ( _wC <> "" && _wA & _wE & _wP <> "", " · " ) & _wA & IF ( _wA <> "" && _wE & _wP <> "", " · " ) & _wE & IF ( _wE <> "" && _wP <> "", " · " ) & _wP
VAR _marcas = "<i class='mk mk2 a-pop' style='animation-delay:300ms'></i>" & "⁅" & _c & "⁆" & "<i class='mk mk1 a-pop' style='margin-left:14px;animation-delay:350ms'></i>" & "⁅" & _a & "⁆" & "<i class='mk mk0 a-pop' style='margin-left:14px;animation-delay:400ms'></i>" & "⁅" & _e & "⁆" & "<i class='mk mkm a-pop' style='margin-left:14px;animation-delay:450ms'></i>" & "⁅" & _p & "⁆"
VAR _txtCtx = SWITCH ( TRUE (), _c + _a + _e + _p = 0, "nenhuma obra no mês", _quatro, _marcas, _palavras )
VAR _txtMax = FORMAT ( _max, "0", "pt-BR" )
VAR _txtTrvC = FORMAT ( _trvC, "0.00", "pt-BR" )
VAR _txtTrvP = FORMAT ( _trvP, "0", "pt-BR" )
VAR _txtRegra = "De 0 a " & _txtMax & ". IDC &lt; " & _txtTrvC & " ou atraso &gt; " & _txtTrvP & " meses: crítica. Sem item: pendente."
VAR _htmlRegua = "<i class='mk mk2'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxC, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mk1'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxA, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mk0'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxE, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mkm'></i><span>pendente</span>"
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _tnKP = LEN ( _tnN ) > 0
VAR _tnKN = IF ( _tnKP, _tnN )
VAR _tnKS = SUBSTITUTE ( SUBSTITUTE ( _tnKN, ".", "" ), ",", "" )
VAR _tnKT = IFERROR ( VALUE ( _tnKS ), -1 )
VAR _tnKOk = _tnKP && _tnKT >= 2 && FORMAT ( _tnKT, REPT ( "0", LEN ( _tnKS ) ) ) = _tnKS
VAR _tnKD = IF ( CONTAINSSTRING ( _tnKN, "," ), LEN ( _tnKN ) - SEARCH ( ",", _tnKN ), 0 )
VAR _tnKM = IF ( CONTAINSSTRING ( _tnKN, "." ), "#,##0", "0" ) & IF ( _tnKD > 0, "." & REPT ( "0", _tnKD ) )
VAR _tnKOd =
    IF (
        _tnKOk,
        "<o-d><o-v>" & _tnKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tnKN, FORMAT ( ROUND ( _tnKT * [@odf] / 1000, 0 ) / POWER ( 10, _tnKD ), _tnKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tnN
    )
VAR _tnOd = IF ( ISBLANK ( _n ), _tnTxt, _tnKOd )
VAR _toKP = LEN ( _toNu ) > 0
VAR _toKN = IF ( _toKP, _toNu )
VAR _toKS = SUBSTITUTE ( SUBSTITUTE ( _toKN, ".", "" ), ",", "" )
VAR _toKT = IFERROR ( VALUE ( _toKS ), -1 )
VAR _toKOk = _toKP && _toKT >= 2 && FORMAT ( _toKT, REPT ( "0", LEN ( _toKS ) ) ) = _toKS
VAR _toKD = IF ( CONTAINSSTRING ( _toKN, "," ), LEN ( _toKN ) - SEARCH ( ",", _toKN ), 0 )
VAR _toKM = IF ( CONTAINSSTRING ( _toKN, "." ), "#,##0", "0" ) & IF ( _toKD > 0, "." & REPT ( "0", _toKD ) )
VAR _toKOd =
    IF (
        _toKOk,
        "<o-d><o-v>" & _toKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _toKN, FORMAT ( ROUND ( _toKT * [@odf] / 1000, 0 ) / POWER ( 10, _toKD ), _toKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _toNu
    )
VAR _toOd = IF ( ISBLANK ( _orc ), _toTxt, _toS & "R$ " & _toKOd & _toUn )
-- 4 · Marcação
VAR _saidaHtml =
    "<div class='u kc' tabindex='0'>"
        & "<div class='lado frente'>"
            & "<p class='ab vs eb'>Obras em andamento</p>"
            & "<div class='linha1'><span class='b6 hero'>" & _tnOd & "</span>" & "<span class='b5 lado2'>" & _toOd & "</span>" & "</div>"
            & "<p class='ctx'>" & _txtCtx & "</p>"
        & "</div>"
        & "<div class='lado verso sobre-creme'>"
            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
            & "<p class='regra'>" & _txtRegra & "</p>"
            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Análise Crítica + base</span></div>"
            & "<div class='regua'>" & _htmlRegua & "</div>"
        & "</div>"
    & "</div>" & [Comum · JS contador]
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
