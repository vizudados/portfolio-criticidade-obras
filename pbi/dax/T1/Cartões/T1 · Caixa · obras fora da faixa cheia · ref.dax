/*
@pasta: T1 Visão geral\Cartões\Contas
@formato: 0
@descricao: Obras com aba no mês de referência que não levaram o ponto cheio da previsão de caixa (desvio do desembolso fora da primeira faixa, para mais ou para menos).
@oraculo: dados/_gabarito/nota_previa.csv (pts_caixa < 1)
@gerado: pbi/scripts/contas_t1.py
*/
VAR _mes = [Mês de referência]
VAR _obras = CALCULATETABLE ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
RETURN
    COUNTROWS (
        FILTER (
            _obras,
            CALCULATE ( [Nota · pontos caixa] < [Nota · possíveis · caixa], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
        )
    ) + 0
