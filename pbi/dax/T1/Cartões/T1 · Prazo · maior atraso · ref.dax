/*
@pasta: T1 Visão geral\Cartões\Contas
@formato: 0.0
@descricao: Maior atraso em meses entre as obras do recorte no mês de referência; vazio sem atraso.
@oraculo: dados/_gabarito/nota_previa.csv (x_atraso)
@gerado: pbi/scripts/contas_t1.py
*/
VAR _mes = [Mês de referência]
VAR _obras =
    CALCULATETABLE (
        ADDCOLUMNS ( FILTER ( VALUES ( dObra[Obra] ), NOT ISEMPTY ( RELATEDTABLE ( fAnaliseCritica ) ) ), "@a", [Prazo · atraso (meses)] ),
        REMOVEFILTERS ( dMes ),
        dMes[Mes] = _mes
    )
VAR _top = TOPN ( 1, FILTER ( _obras, [@a] > 0 ), [@a], DESC, dObra[Obra], ASC )
RETURN
    MAXX ( _top, [@a] )
