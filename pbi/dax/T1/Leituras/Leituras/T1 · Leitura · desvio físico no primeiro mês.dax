@formato: +0.00;-0.00;0.00
@descricao: [Físico · desvio acumulado p.p.] no primeiro mês da janela das séries (recorte de obras do drawer).
@oraculo: carteira.serie[0]
@gerado: pbi/scripts/leituras_t1.py
*/
VAR _ini = [Série · primeiro mês]
RETURN
    CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _ini )
