/*
@pasta: T1 Visão geral\Leituras\Contas
@formato: 0
@descricao: Quantas obras perderam pontos no item mais espalhado (mês de referência).
@oraculo: oráculo da régua antiga · ago/26: 4
@gerado: pbi/scripts/leituras_t1.py
*/
VAR _cod = [T1 · Leitura · item mais espalhado]
RETURN
    CALCULATE ( [Nota · item · obras que perderam pontos · ref], dItemNota[Item] = _cod ) + 0
