    & "sec>.vs{display:block;margin-bottom:6px;color:#6B6B70}.pn-obras{padding:28px}.pn-obras .cols{display:grid;grid-template-columns:560px 1px 1fr;column-gap:24px;height:100%}.pn-obras "
