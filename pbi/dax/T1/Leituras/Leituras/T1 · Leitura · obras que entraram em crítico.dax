/*
@pasta: T1 Visão geral\Leituras\Contas
@formato: 0
@descricao: Quantas obras entraram em crítico na nota no mês do contexto (mesma regra da lista: só entre notas completas).
@oraculo: oráculo da régua antiga (status mês a mês)
@gerado: pbi/scripts/leituras_t1.py
*/
VAR _m = SELECTEDVALUE ( dMes[Mes] )
VAR _ant = EDATE ( _m, -1 )
VAR _recorte = VALUES ( dObra[Obra] )
VAR _obras =
    ADDCOLUMNS (
        FILTER ( dRankingNota, dRankingNota[Mes] = _m && dRankingNota[TemAC] = 1 && dRankingNota[Obra] IN _recorte ),
        "@s", dRankingNota[Status],
        "@a",
            VAR _o = dRankingNota[Obra]
            RETURN
                MAXX ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] = _ant && dRankingNota[TemAC] = 1 ), dRankingNota[Status] ),
        "@ja",
            VAR _o = dRankingNota[Obra]
            RETURN
                IF ( ISEMPTY ( FILTER ( ALL ( dRankingNota ), dRankingNota[Obra] = _o && dRankingNota[Mes] < _m && dRankingNota[TemAC] = 1 && dRankingNota[Pendente] == 0 ) ), 0, 1 )
    )
RETURN
    COUNTROWS ( FILTER ( _obras, [@s] == 2 && NOT ISBLANK ( [@a] ) && [@a] < 2 ) ) + 0
