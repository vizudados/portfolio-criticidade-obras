/*
@pasta: T1 Visão geral\Tooltips
@formato: texto
@descricao: CSS do tooltip do mês (F4: 760 de largura, linhas com escala, cascata de entrada).
@gerado: pbi/scripts/tooltips_t1.py
*/
-- 4 · Marcação
[T1 · CSS tooltip]
    & ".tt .col4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));column-gap:14px}.tt .col4 .chip{margin-bottom:12px;width:max-content}.tt .col4 .ob{display:flex;justify-content"
    & ":space-between;align-items:center;gap:6px;height:25px;white-space:nowrap}.tt .col4 .ob span:first-child{font-size:15px;font-weight:600;overflow:hidden;text-overflow:ellipsis}.tt .c"
    & "ol4 .ob b{font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:16px}.tt .col4 .ob b.pd{font-size:14px;color:#3B3B3F}.tt .e1{--k:1.35;--hm:96px}.tt .e2{--k:1.2;--h"
    & "m:64px}.tt .e3{--k:1.08;--hm:52px}.tt .e4{--k:.95;--hm:40px}.tt .e5{--k:.87;--hm:32px}.tt .corpo{display:flex;flex-direction:column}.tt .ls{flex:1 1 auto;min-height:0;max-height:ca"
    & "lc(var(--n,9) * var(--hm,36px))}.tt .ls{grid-auto-rows:minmax(0,1fr);align-content:stretch}.tt .ls .chi{height:auto;min-height:22px;padding:calc(2px * var(--k,1)) 8px;font-size:max"
    & "(13px,calc(13px * var(--k,1)))}.tt .ls .mk{width:calc(11px * var(--k,1));height:calc(11px * var(--k,1))}.tt .col4.ls{display:grid;max-height:calc(var(--n,9) * var(--hm,36px) + 34px"
    & ")}.tt .col4.ls>div{display:grid;grid-template-rows:auto repeat(var(--n,9),minmax(0,1fr));min-height:0}.tt .col4.ls .ob{height:auto;min-height:0}.tt .col4.ls .ob span:first-child{fo"
    & "nt-size:min(16px,max(13px,calc(15px * var(--k,1))))}.tt .col4.ls .ob b{font-size:max(13px,calc(16px * var(--k,1)))}.tt .col4.ls .ob b.pd{font-size:max(13px,calc(14px * var(--k,1)))"
    & "}/*contador*/@keyframes tqE0{from{opacity:.35}}@keyframes tqP0{from{opacity:0;transform:scale(.5)}}@keyframes tqE2{0%,28.571%{opacity:.35}}@keyframes tqP2{0%,28.571%{opacity:0;tran"
    & "sform:scale(.5)}}@keyframes tqE3{0%,37.5%{opacity:.35}}@keyframes tqP3{0%,37.5%{opacity:0;transform:scale(.5)}}@keyframes tqE4{0%,44.444%{opacity:.35}}@keyframes tqP4{0%,44.444%{op"
    & "acity:0;transform:scale(.5)}}@keyframes tqE5{0%,50%{opacity:.35}}@keyframes tqP5{0%,50%{opacity:0;transform:scale(.5)}}@keyframes tqE6{0%,54.545%{opacity:.35}}@keyframes tqP6{0%,54"
    & ".545%{opacity:0;transform:scale(.5)}}@keyframes tqE7{0%,58.333%{opacity:.35}}@keyframes tqP7{0%,58.333%{opacity:0;transform:scale(.5)}}@keyframes tqE8{0%,61.538%{opacity:.35}}@keyf"
    & "rames tqP8{0%,61.538%{opacity:0;transform:scale(.5)}}@keyframes tqE9{0%,64.286%{opacity:.35}}@keyframes tqP9{0%,64.286%{opacity:0;transform:scale(.5)}}@keyframes tqE10{0%,66.667%{o"
    & "pacity:.35}}@keyframes tqP10{0%,66.667%{opacity:0;transform:scale(.5)}}@keyframes tqE11{0%,68.75%{opacity:.35}}@keyframes tqP11{0%,68.75%{opacity:0;transform:scale(.5)}}@keyframes "
    & "tqE12{0%,70.588%{opacity:.35}}@keyframes tqP12{0%,70.588%{opacity:0;transform:scale(.5)}}@keyframes tqE13{0%,72.222%{opacity:.35}}@keyframes tqP13{0%,72.222%{opacity:0;transform:sc"
    & "ale(.5)}}@keyframes tqE14{0%,73.684%{opacity:.35}}@keyframes tqP14{0%,73.684%{opacity:0;transform:scale(.5)}}@keyframes tqE15{0%,75%{opacity:.35}}@keyframes tqP15{0%,75%{opacity:0;"
    & "transform:scale(.5)}}@keyframes tqE16{0%,76.19%{opacity:.35}}@keyframes tqP16{0%,76.19%{opacity:0;transform:scale(.5)}}:is(.mk,.chi,.chip,.chp,circle,.pend){transform-box:fill-box;"
    & "transform-origin:center}.tt .cab{animation:tqE0 0.2s ease-out}.tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP0 0.3s ease-out}.tt .col4>div>:nth-child(1){animation:tqE2"
    & " 0.28s ease-out}.tt .col4>div>:nth-child(1) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP2 0.38s ease-out}.tt .col4>div>:nth-child(2){animation:tqE3 0.32s ease-out}.tt .col4>"
    & "div>:nth-child(2) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP3 0.42s ease-out}.tt .col4>div>:nth-child(3){animation:tqE4 0.36s ease-out}.tt .col4>div>:nth-child(3) :is(.mk,"
    & ".chi,.chip,.chp,circle,.pend){animation:tqP4 0.46s ease-out}.tt .col4>div>:nth-child(4){animation:tqE5 0.4s ease-out}.tt .col4>div>:nth-child(4) :is(.mk,.chi,.chip,.chp,circle,.pen"
    & "d){animation:tqP5 0.5s ease-out}.tt .col4>div>:nth-child(5){animation:tqE6 0.44s ease-out}.tt .col4>div>:nth-child(5) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP6 0.54s eas"
    & "e-out}.tt .col4>div>:nth-child(6){animation:tqE7 0.48s ease-out}.tt .col4>div>:nth-child(6) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP7 0.58s ease-out}.tt .col4>div>:nth-c"
    & "hild(7){animation:tqE8 0.52s ease-out}.tt .col4>div>:nth-child(7) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP8 0.62s ease-out}.tt .col4>div>:nth-child(8){animation:tqE9 0.5"
    & "6s ease-out}.tt .col4>div>:nth-child(8) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP9 0.66s ease-out}.tt .col4>div>:nth-child(9){animation:tqE10 0.6s ease-out}.tt .col4>div>"
    & ":nth-child(9) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP10 0.7s ease-out}.tt .col4>div>:nth-child(10){animation:tqE11 0.64s ease-out}.tt .col4>div>:nth-child(10) :is(.mk,."
    & "chi,.chip,.chp,circle,.pend){animation:tqP11 0.74s ease-out}.tt .col4>div>:nth-child(11){animation:tqE12 0.68s ease-out}.tt .col4>div>:nth-child(11) :is(.mk,.chi,.chip,.chp,circle,"
    & ".pend){animation:tqP12 0.78s ease-out}.tt .col4>div>:nth-child(12){animation:tqE13 0.72s ease-out}.tt .col4>div>:nth-child(12) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP13"
    & " 0.82s ease-out}.tt .col4>div>:nth-child(13){animation:tqE14 0.76s ease-out}.tt .col4>div>:nth-child(13) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP14 0.86s ease-out}.tt .c"
    & "ol4>div>:nth-child(14){animation:tqE15 0.8s ease-out}.tt .col4>div>:nth-child(14) :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP15 0.9s ease-out}.tt .pe{animation:tqE16 0.84s "
    & "ease-out}.tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP16 0.94s ease-out}.tqv .tt .cab,.tqv .tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-chil"
    & "d(1),.tqv .tt .col4>div>:nth-child(1) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(2),.tqv .tt .col4>div>:nth-child(2) :is(.mk,.chi,.chip,.chp,circle,.pend),"
    & ".tqv .tt .col4>div>:nth-child(3),.tqv .tt .col4>div>:nth-child(3) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(4),.tqv .tt .col4>div>:nth-child(4) :is(.mk,.c"
    & "hi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(5),.tqv .tt .col4>div>:nth-child(5) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(6),.tqv .tt .col4>"
    & "div>:nth-child(6) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(7),.tqv .tt .col4>div>:nth-child(7) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:"
    & "nth-child(8),.tqv .tt .col4>div>:nth-child(8) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(9),.tqv .tt .col4>div>:nth-child(9) :is(.mk,.chi,.chip,.chp,circle"
    & ",.pend),.tqv .tt .col4>div>:nth-child(10),.tqv .tt .col4>div>:nth-child(10) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(11),.tqv .tt .col4>div>:nth-child(11"
    & ") :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(12),.tqv .tt .col4>div>:nth-child(12) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(13),"
    & ".tqv .tt .col4>div>:nth-child(13) :is(.mk,.chi,.chip,.chp,circle,.pend),.tqv .tt .col4>div>:nth-child(14),.tqv .tt .col4>div>:nth-child(14) :is(.mk,.chi,.chip,.chp,circle,.pend),.t"
    & "qv .tt .pe,.tqv .tt .pe :is(.mk,.chi,.chip,.chp,circle,.pend){animation:none}@media (prefers-reduced-motion:reduce){.tt .cab,.tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col"
    & "4>div>:nth-child(1),.tt .col4>div>:nth-child(1) :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .col4>div>:nth-child(2),.tt .col4>div>:nth-child(2) :is(.mk,.chi,.chip,.chp,circle,.pend),"
