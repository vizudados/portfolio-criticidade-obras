/*
@pasta: T1 Visão geral\Tooltips\Contas
@formato: 0.00
@descricao: [Nota · nota final] da obra no mês anterior ao do contexto (vazio sem aba nem base no mês anterior; vazio também quando o mês anterior está pendente). Uma obra no contexto. Lê [Nota · nota final · um mês].
@oraculo: oráculo da régua antiga (mês anterior)
@gerado: pbi/scripts/tooltips_t1.py
*/
VAR _mes = EDATE ( MAX ( dMes[Mes] ), -1 )
RETURN
    CALCULATE ( [Nota · nota final · um mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
