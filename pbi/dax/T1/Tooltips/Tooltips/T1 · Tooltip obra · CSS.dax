/*
@pasta: T1 Visão geral\Tooltips
@formato: texto
@descricao: CSS do tooltip de obra (F4: lista dos itens com escala e cascata de entrada).
@gerado: pbi/scripts/tooltips_t1.py
*/
-- 4 · Marcação
[T1 · CSS tooltip]
    & ".tt .ser{position:relative;height:82px}.tt .ser .c{position:absolute;top:0;text-align:center;height:82px}.tt .ser .c .val{position:absolute;left:-14px;right:-14px;font-family:'Barl"
    & "ow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;white-space:nowrap}.tt .ser .c .bar{position:absolute;bottom:21px;box-sizing:border-box}.tt .ser .c .bar"
    & ".s2{background:#C43737}.tt .ser .c .bar.s1{background:#C9821F}.tt .ser .c .bar.s0{background:#A9CDB9}.tt .ser .c .bar.sm{background:#FFFFFF;border:1px dashed #3B3B3F}.tt .ser .c .m"
    & "s{position:absolute;left:-10px;right:-10px;bottom:0;font-size:13px;line-height:16px;color:#6B6B70;white-space:nowrap}.tt .ser .c .ms.ref{font-weight:600;color:#0B0B0C}.tt .ser .c ."
    & "ms.sem{opacity:.4}.tt .ser .c .val.ext{color:#6B6B70}.tt .ser .c.ini .val{left:0;right:auto;text-align:left}.tt .ser .c.fim .val{left:auto;right:0;text-align:right}.tt .ser .c.ini "
    & ".ms,.tt .ser .c.fim .ms{left:0;right:0}.tt .rg.s{margin:6px 0 11px}.tt .vs+.ser{margin-top:4px}.tt .tab .lin>.p{display:flex;justify-content:flex-end;align-items:center}.tt .e1{--k"
    & ":1.35;--hm:96px}.tt .e2{--k:1.2;--hm:64px}.tt .e3{--k:1.08;--hm:52px}.tt .e4{--k:.95;--hm:40px}.tt .e5{--k:.87;--hm:32px}.tt .corpo{display:flex;flex-direction:column}.tt .ls{flex:"
    & "1 1 auto;min-height:0;max-height:calc(var(--n,9) * var(--hm,36px))}.tt .ls{grid-auto-rows:minmax(0,1fr);align-content:stretch}.tt .ls .lin .n{font-size:max(13px,calc(15px * var(--k"
    & ",1)))}.tt .ls .lin .v{font-size:max(13px,calc(16px * var(--k,1)))}.tt .ls .lin .p{font-size:max(13px,calc(16px * var(--k,1)))}.tt .ls .chi{height:auto;min-height:22px;padding:calc("
    & "2px * var(--k,1)) 8px;font-size:max(13px,calc(13px * var(--k,1)))}.tt .ls .mk{width:calc(11px * var(--k,1));height:calc(11px * var(--k,1))}.tt .tab.ls .lin>span{height:auto;line-he"
    & "ight:1.3}.tt .tab.ls .lin>.d{line-height:1.15}/*contador*/@keyframes tqE0{from{opacity:.35}}@keyframes tqP0{from{opacity:0;transform:scale(.5)}}@keyframes tqE1{0%,16.667%{opacity:."
    & "35}}@keyframes tqP1{0%,16.667%{opacity:0;transform:scale(.5)}}@keyframes tqE2{0%,28.571%{opacity:.35}}@keyframes tqP2{0%,28.571%{opacity:0;transform:scale(.5)}}@keyframes tqE3{0%,3"
    & "7.5%{opacity:.35}}@keyframes tqP3{0%,37.5%{opacity:0;transform:scale(.5)}}@keyframes tqE4{0%,44.444%{opacity:.35}}@keyframes tqP4{0%,44.444%{opacity:0;transform:scale(.5)}}@keyfram"
    & "es tqE5{0%,50%{opacity:.35}}@keyframes tqP5{0%,50%{opacity:0;transform:scale(.5)}}@keyframes tqE6{0%,54.545%{opacity:.35}}@keyframes tqP6{0%,54.545%{opacity:0;transform:scale(.5)}}"
    & "@keyframes tqE7{0%,58.333%{opacity:.35}}@keyframes tqP7{0%,58.333%{opacity:0;transform:scale(.5)}}@keyframes tqE8{0%,61.538%{opacity:.35}}@keyframes tqP8{0%,61.538%{opacity:0;trans"
    & "form:scale(.5)}}@keyframes tqE9{0%,64.286%{opacity:.35}}@keyframes tqP9{0%,64.286%{opacity:0;transform:scale(.5)}}@keyframes tqE10{0%,66.667%{opacity:.35}}@keyframes tqP10{0%,66.66"
    & "7%{opacity:0;transform:scale(.5)}}@keyframes tqE11{0%,68.75%{opacity:.35}}@keyframes tqP11{0%,68.75%{opacity:0;transform:scale(.5)}}@keyframes tqE12{0%,70.588%{opacity:.35}}@keyfra"
    & "mes tqP12{0%,70.588%{opacity:0;transform:scale(.5)}}@keyframes tqE13{0%,72.222%{opacity:.35}}@keyframes tqP13{0%,72.222%{opacity:0;transform:scale(.5)}}@keyframes tqE14{0%,73.684%{"
    & "opacity:.35}}@keyframes tqP14{0%,73.684%{opacity:0;transform:scale(.5)}}@keyframes tqE15{0%,75%{opacity:.35}}@keyframes tqP15{0%,75%{opacity:0;transform:scale(.5)}}@keyframes tqE16"
    & "{0%,76.19%{opacity:.35}}@keyframes tqP16{0%,76.19%{opacity:0;transform:scale(.5)}}:is(.mk,.chi,.chip,.chp,circle,.pend){transform-box:fill-box;transform-origin:center}.tt .cab{anim"
    & "ation:tqE0 0.2s ease-out}.tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP0 0.3s ease-out}.tt .corpo>.bh,.tt .corpo>.vs,.tt .corpo>.rg,.tt .ser .ms,.tt .fx{animation:tqE"
    & "1 0.24s ease-out}.tt .corpo>.bh :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.vs :is(.mk,.chi,.chip,.chp,circle,.pend),.tt .corpo>.rg :is(.mk,.chi,.chip,.chp,circle,.pend),.tt "
