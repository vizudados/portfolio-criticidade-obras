    & "sform-origin:center}.tt .cab{animation:tqE0 0.2s ease-out}.tt .cab :is(.mk,.chi,.chip,.chp,circle,.pend){animation:tqP0 0.3s ease-out}.tt .corpo>.bh,.tt .corpo>.vs,.tt .corpo>.rg,."
