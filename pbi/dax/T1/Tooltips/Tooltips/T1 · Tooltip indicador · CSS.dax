    & "%{opacity:0;transform:scale(.5)}}@keyframes tqE7{0%,58.333%{opacity:.35}}@keyframes tqP7{0%,58.333%{opacity:0;transform:scale(.5)}}@keyframes tqE8{0%,61.538%{opacity:.35}}@keyframe"
    & "s tqP8{0%,61.538%{opacity:0;transform:scale(.5)}}@keyframes tqE9{0%,64.286%{opacity:.35}}@keyframes tqP9{0%,64.286%{opacity:0;transform:scale(.5)}}@keyframes tqE10{0%,66.667%{opaci"
    & "ty:.35}}@keyframes tqP10{0%,66.667%{opacity:0;transform:scale(.5)}}@keyframes tqE11{0%,68.75%{opacity:.35}}@keyframes tqP11{0%,68.75%{opacity:0;transform:scale(.5)}}@keyframes tqE1"
