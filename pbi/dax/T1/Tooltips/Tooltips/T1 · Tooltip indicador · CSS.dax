/*
@pasta: T1 Visão geral\Tooltips
@formato: texto
@descricao: CSS do tooltip da dimensão da nota (F4: a lista de obras ocupa o corpo, com escala pela contagem de linhas, e tudo entra em cascata).
@gerado: pbi/scripts/tooltips_t1.py
*/
-- 4 · Marcação
[T1 · CSS tooltip]
    & ".tt .fx{font-size:13px;line-height:18px;color:#3B3B3F;margin:0 0 10px;white-space:normal}.tt .fx .f{white-space:nowrap}.tt .fx b{font-weight:600;color:#0B0B0C}.tt .fx+.bh{margin-to"
    & "p:2px}.tt .tab.i .lin>span{height:27px;line-height:27px}.tt .tab.i .lin>.p{display:flex;justify-content:flex-end;align-items:center}.tt .lin .n .selo{margin-left:2px}.tt .e1{--k:1."
    & "35;--hm:96px}.tt .e2{--k:1.2;--hm:64px}.tt .e3{--k:1.08;--hm:52px}.tt .e4{--k:.95;--hm:40px}.tt .e5{--k:.87;--hm:32px}.tt .corpo{display:flex;flex-direction:column}.tt .ls{flex:1 1"
    & " auto;min-height:0;max-height:calc(var(--n,9) * var(--hm,36px))}.tt .ls{grid-auto-rows:minmax(0,1fr);align-content:stretch}.tt .ls .lin .n{font-size:max(13px,calc(15px * var(--k,1)"
    & "))}.tt .ls .lin .v{font-size:max(13px,calc(16px * var(--k,1)))}.tt .ls .lin .p{font-size:max(13px,calc(16px * var(--k,1)))}.tt .ls .chi{height:auto;min-height:22px;padding:calc(2px"
    & " * var(--k,1)) 8px;font-size:max(13px,calc(13px * var(--k,1)))}.tt .ls .mk{width:calc(11px * var(--k,1));height:calc(11px * var(--k,1))}.tt .tab.ls .lin>span{height:auto;line-heigh"
    & "t:1.3}.tt .tab.ls .lin>.d{line-height:1.15}.tt .tab.i.ls .lin>span{height:auto}/*contador*/@keyframes tqE0{from{opacity:.35}}@keyframes tqP0{from{opacity:0;transform:scale(.5)}}@ke"
    & "yframes tqE1{0%,16.667%{opacity:.35}}@keyframes tqP1{0%,16.667%{opacity:0;transform:scale(.5)}}@keyframes tqE2{0%,28.571%{opacity:.35}}@keyframes tqP2{0%,28.571%{opacity:0;transfor"
    & "m:scale(.5)}}@keyframes tqE3{0%,37.5%{opacity:.35}}@keyframes tqP3{0%,37.5%{opacity:0;transform:scale(.5)}}@keyframes tqE4{0%,44.444%{opacity:.35}}@keyframes tqP4{0%,44.444%{opacit"
