/*
@pasta: T1 Visão geral\Obras pela nota\Contas
@formato: texto
@descricao: Obras do recorte com item da nota faltando na planilha no mês de referência, separadas por '|', em ordem de nome; vazio sem falta.
@oraculo: bases reais, ago/26: na base as 6 obras; na planilha só a JANGADA
@gerado: pbi/scripts/contas_t1.py
*/
CONCATENATEX (
    FILTER ( VALUES ( dObra[Obra] ), [Nota · itens faltando na planilha · ref] > 0 ),
    dObra[Obra],
    "|",
    dObra[Obra], ASC
)
