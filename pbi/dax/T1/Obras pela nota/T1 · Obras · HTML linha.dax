/*
@pasta: T1 Visão geral\Obras pela nota
@formato: texto
@descricao: Uma linha por obra (granularidade dObra[Obra], ordem por T1 · Obras · posição): posição, nome, código, selo, orçamento · executado · IDC, chip do status da nota (ou pendente), barra da nota de 0 ao máximo na cor do status com as marcas dos limites de atenção e de estável (pendente: pontos obtidos em cinza e o que já dá para calcular em tracejado, 'X de Y'), e os sete quadradinhos das dimensões da nota, na ordem da régua, preenchidos pela fração dos pontos obtidos (cheio, parcial, zero, sem dado). Fundo vermelho-claro na obra crítica. Vazio para obra sem aba no mês.
@gerado: pbi/scripts/desenho_t1.py
*/
-- 1 · Leituras
VAR _pos = [T1 · Obras · posição]
VAR _obra = [Obra · nome]
VAR _cod = [Obra · código]
VAR _selo = [Obra · selo]
VAR _orc = [Orçamento · ref]
VAR _exec = [Físico · executado acumulado · ref]
VAR _idc = [IDC · ref]
VAR _st = [Nota · status · ranking · ref]
VAR _pend = [Nota · pendente · ranking · ref]
VAR _nota = [Nota · nota final · ranking · ref]
VAR _obt = [Nota · pontos obtidos · ranking · ref]
VAR _poss = [Nota · pontos possíveis · ranking · ref]
VAR _max = [Nota · nota · máximo]
VAR _limA = [Nota · status · nota mínima atenção]
VAR _limE = [Nota · status · nota mínima estável]
VAR _d1Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Dimensao] = "Custo" )
VAR _d1Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Dimensao] = "Custo" )
VAR _d1Max = CALCULATE ( [Nota · item · máximo], dItemNota[Dimensao] = "Custo" )
VAR _d1Cls = SWITCH ( TRUE (), NOT ( _d1Poss >= _d1Max ), "qf", _d1Pts >= _d1Poss, "q0", _d1Pts = 0, "q2", "q1" )
VAR _d1H = IF ( _d1Poss > 0, ROUND ( DIVIDE ( _d1Pts, _d1Poss ) * 22, 0 ), 0 ) -- geometria
VAR _d1At = ( _pos - 1 ) * 60 + 340 -- geometria
VAR _d1Html = "<span><i class='a-pop " & _d1Cls & "' style='animation-delay:" & _d1At & "ms'><u class='a-gy' style='height:" & _d1H & "px;animation-delay:" & ( _d1At + 150 ) & "ms'></u></i><em" & IF ( _d1Cls = "q2", " class='z'", "" ) & ">CUS</em></span>"
VAR _d2Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Dimensao] = "Prazo" )
VAR _d2Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Dimensao] = "Prazo" )
VAR _d2Max = CALCULATE ( [Nota · item · máximo], dItemNota[Dimensao] = "Prazo" )
VAR _d2Cls = SWITCH ( TRUE (), NOT ( _d2Poss >= _d2Max ), "qf", _d2Pts >= _d2Poss, "q0", _d2Pts = 0, "q2", "q1" )
VAR _d2H = IF ( _d2Poss > 0, ROUND ( DIVIDE ( _d2Pts, _d2Poss ) * 22, 0 ), 0 ) -- geometria
VAR _d2At = ( _pos - 1 ) * 60 + 380 -- geometria
VAR _d2Html = "<span><i class='a-pop " & _d2Cls & "' style='animation-delay:" & _d2At & "ms'><u class='a-gy' style='height:" & _d2H & "px;animation-delay:" & ( _d2At + 150 ) & "ms'></u></i><em" & IF ( _d2Cls = "q2", " class='z'", "" ) & ">PRA</em></span>"
VAR _d3Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Dimensao] = "Caixa" )
VAR _d3Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Dimensao] = "Caixa" )
VAR _d3Max = CALCULATE ( [Nota · item · máximo], dItemNota[Dimensao] = "Caixa" )
VAR _d3Cls = SWITCH ( TRUE (), NOT ( _d3Poss >= _d3Max ), "qf", _d3Pts >= _d3Poss, "q0", _d3Pts = 0, "q2", "q1" )
VAR _d3H = IF ( _d3Poss > 0, ROUND ( DIVIDE ( _d3Pts, _d3Poss ) * 22, 0 ), 0 ) -- geometria
VAR _d3At = ( _pos - 1 ) * 60 + 420 -- geometria
VAR _d3Html = "<span><i class='a-pop " & _d3Cls & "' style='animation-delay:" & _d3At & "ms'><u class='a-gy' style='height:" & _d3H & "px;animation-delay:" & ( _d3At + 150 ) & "ms'></u></i><em" & IF ( _d3Cls = "q2", " class='z'", "" ) & ">CAI</em></span>"
VAR _d4Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Dimensao] = "Qualidade" )
VAR _d4Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Dimensao] = "Qualidade" )
VAR _d4Max = CALCULATE ( [Nota · item · máximo], dItemNota[Dimensao] = "Qualidade" )
VAR _d4Cls = SWITCH ( TRUE (), NOT ( _d4Poss >= _d4Max ), "qf", _d4Pts >= _d4Poss, "q0", _d4Pts = 0, "q2", "q1" )
VAR _d4H = IF ( _d4Poss > 0, ROUND ( DIVIDE ( _d4Pts, _d4Poss ) * 22, 0 ), 0 ) -- geometria
VAR _d4At = ( _pos - 1 ) * 60 + 460 -- geometria
VAR _d4Html = "<span><i class='a-pop " & _d4Cls & "' style='animation-delay:" & _d4At & "ms'><u class='a-gy' style='height:" & _d4H & "px;animation-delay:" & ( _d4At + 150 ) & "ms'></u></i><em" & IF ( _d4Cls = "q2", " class='z'", "" ) & ">QUA</em></span>"
VAR _d5Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Dimensao] = "Segurança" )
VAR _d5Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Dimensao] = "Segurança" )
VAR _d5Max = CALCULATE ( [Nota · item · máximo], dItemNota[Dimensao] = "Segurança" )
VAR _d5Cls = SWITCH ( TRUE (), NOT ( _d5Poss >= _d5Max ), "qf", _d5Pts >= _d5Poss, "q0", _d5Pts = 0, "q2", "q1" )
VAR _d5H = IF ( _d5Poss > 0, ROUND ( DIVIDE ( _d5Pts, _d5Poss ) * 22, 0 ), 0 ) -- geometria
VAR _d5At = ( _pos - 1 ) * 60 + 500 -- geometria
VAR _d5Html = "<span><i class='a-pop " & _d5Cls & "' style='animation-delay:" & _d5At & "ms'><u class='a-gy' style='height:" & _d5H & "px;animation-delay:" & ( _d5At + 150 ) & "ms'></u></i><em" & IF ( _d5Cls = "q2", " class='z'", "" ) & ">SEG</em></span>"
VAR _d6Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Dimensao] = "Suprimentos" )
VAR _d6Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Dimensao] = "Suprimentos" )
VAR _d6Max = CALCULATE ( [Nota · item · máximo], dItemNota[Dimensao] = "Suprimentos" )
VAR _d6Cls = SWITCH ( TRUE (), NOT ( _d6Poss >= _d6Max ), "qf", _d6Pts >= _d6Poss, "q0", _d6Pts = 0, "q2", "q1" )
VAR _d6H = IF ( _d6Poss > 0, ROUND ( DIVIDE ( _d6Pts, _d6Poss ) * 22, 0 ), 0 ) -- geometria
VAR _d6At = ( _pos - 1 ) * 60 + 540 -- geometria
VAR _d6Html = "<span><i class='a-pop " & _d6Cls & "' style='animation-delay:" & _d6At & "ms'><u class='a-gy' style='height:" & _d6H & "px;animation-delay:" & ( _d6At + 150 ) & "ms'></u></i><em" & IF ( _d6Cls = "q2", " class='z'", "" ) & ">SUP</em></span>"
VAR _d7Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Dimensao] = "Gestão" )
VAR _d7Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Dimensao] = "Gestão" )
VAR _d7Max = CALCULATE ( [Nota · item · máximo], dItemNota[Dimensao] = "Gestão" )
VAR _d7Cls = SWITCH ( TRUE (), NOT ( _d7Poss >= _d7Max ), "qf", _d7Pts >= _d7Poss, "q0", _d7Pts = 0, "q2", "q1" )
VAR _d7H = IF ( _d7Poss > 0, ROUND ( DIVIDE ( _d7Pts, _d7Poss ) * 22, 0 ), 0 ) -- geometria
VAR _d7At = ( _pos - 1 ) * 60 + 580 -- geometria
VAR _d7Html = "<span><i class='a-pop " & _d7Cls & "' style='animation-delay:" & _d7At & "ms'><u class='a-gy' style='height:" & _d7H & "px;animation-delay:" & ( _d7At + 150 ) & "ms'></u></i><em" & IF ( _d7Cls = "q2", " class='z'", "" ) & ">GES</em></span>"
-- 3 · Geometria
VAR _largNota = MAX ( 2, ROUND ( MIN ( _nota, _max ) / _max * 200, 0 ) ) -- geometria
VAR _largObt = MAX ( 2, ROUND ( MIN ( _obt, _max ) / _max * 200, 0 ) ) -- geometria
VAR _largPoss = ROUND ( MIN ( _poss, _max ) / _max * 200, 0 ) -- geometria
VAR _xA = ROUND ( _limA / _max * 200, 0 ) -- geometria
VAR _xE = ROUND ( _limE / _max * 200, 0 ) -- geometria
VAR _atraso = ( _pos - 1 ) * 60 -- geometria
-- 2 · Textos
VAR _toA = ABS ( _orc )
VAR _toNu = SWITCH ( TRUE (), _toA >= 99950000, FORMAT ( _toA / 1000000, "0.0", "pt-BR" ), _toA >= 999500, FORMAT ( _toA / 1000000, "0.00", "pt-BR" ), _toA >= 999.5, FORMAT ( _toA / 1000, "0", "pt-BR" ), FORMAT ( _toA, "#,0", "pt-BR" ) )
VAR _toUn = SWITCH ( TRUE (), _toA >= 999500, " mi", _toA >= 999.5, " mil", "" )
VAR _toN = _toNu & _toUn
VAR _toZero = _toN = "0"
VAR _toS = IF ( _toZero, "", IF ( _orc < 0, "−", "" ) )
VAR _toTxt = IF ( ISBLANK ( _orc ), "—", _toS & "R$ " & _toN )
VAR _teN = FORMAT ( ABS ( _exec ) * 100, "0.0", "pt-BR" )
VAR _teS = IF ( ROUND ( _exec * 100, 1 ) < 0, "−", "" )
VAR _teTxt = IF ( ISBLANK ( _exec ), "—", _teS & _teN & "%" )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _txtNota = IF ( _pend = 1, FORMAT ( _obt, "0.0#", "pt-BR" ), FORMAT ( _nota, "0.0#", "pt-BR" ) )
VAR _nKP = LEN ( _txtNota ) > 0
VAR _nKN = IF ( _nKP, _txtNota )
VAR _nKS = SUBSTITUTE ( SUBSTITUTE ( _nKN, ".", "" ), ",", "" )
VAR _nKT = IFERROR ( VALUE ( _nKS ), -1 )
VAR _nKOk = _nKP && _nKT >= 2 && FORMAT ( _nKT, REPT ( "0", LEN ( _nKS ) ) ) = _nKS
VAR _nKD = IF ( CONTAINSSTRING ( _nKN, "," ), LEN ( _nKN ) - SEARCH ( ",", _nKN ), 0 )
VAR _nKM = IF ( CONTAINSSTRING ( _nKN, "." ), "#,##0", "0" ) & IF ( _nKD > 0, "." & REPT ( "0", _nKD ) )
VAR _nKOd =
    IF (
        _nKOk,
        "<o-d><o-v>" & _nKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _nKN, FORMAT ( ROUND ( _nKT * [@odf] / 1000, 0 ) / POWER ( 10, _nKD ), _nKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _txtNota
    )
VAR _txtDe = "de " & "⁅" & FORMAT ( _poss, "0.0#", "pt-BR" ) & "⁆"
VAR _chave = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
VAR _txtPos = FORMAT ( _pos, "00" )
VAR _txtSub = "⁅" & _toTxt & "⁆" & " · " & "⁅" & _teTxt & "⁆" & " exec." & IF ( ISBLANK ( _idc ), "", " · IDC " & "⁅" & FORMAT ( _idc, "0.00", "pt-BR" ) & "⁆" )
VAR _clsSelo = IF ( _selo = "REAL", "selo selo-r", "selo selo-i" )
VAR _htmlChip = IF ( IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) = "", "", "<span class='chip chip" & IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) & "'><i></i>" & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & "</span>" )
VAR _htmlDim = "<div class='dm'>" & _d1Html & _d2Html & _d3Html & _d4Html & _d5Html & _d6Html & _d7Html & "</div>"
VAR _htmlBarra =
    IF (
        _pend = 1,
        "<u class='a-gx' style='width:" & _largPoss & "px;animation-delay:" & _atraso & "ms'></u>"
            & "<i class='sm' style='width:" & _largObt & "px' data-rk='"
            & _chave & "' data-rd='" & _atraso & "'></i>",
        "<i class='s" & _st & "' style='width:" & _largNota & "px' data-rk='" & _chave & "' data-rd='" & _atraso
            & "'></i>"
    )
VAR _htmlNota =
    IF (
        _pend = 1,
        "<p class='ab b6 pt pd'>" & _nKOd & "</p><p class='ab de'>" & _txtDe & "</p>",
        "<p class='ab b6 pt'>" & _nKOd & "</p>"
    )
-- 4 · Marcação
VAR _saidaHtml =
    IF (
        NOT ISBLANK ( _pos ) && NOT ISBLANK ( _pend ),
        "<div class='u ln" & IF ( _st == 2, " crit", "" ) & "' data-rr='" & _chave & "'>"
            & "<p class='ab vs ix'>" & _txtPos & "</p>"
            & "<div class='nm'><b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</b><em>" & _cod & "</em>"
            & "<span class='" & _clsSelo & "'>" & _selo & "</span></div>"
            & "<p class='ab sub'>" & _txtSub & "</p>"
            & "<div class='chips a-pop' style='animation-delay:" & ( _atraso + 200 ) & "ms'>" & _htmlChip & "</div>"
            & "<div class='cota'>" & _htmlBarra
            & "<b class='a-fd' style='left:" & _xA & "px;animation-delay:" & ( _atraso + 500 ) & "ms'></b>"
            & "<b class='a-fd' style='left:" & _xE & "px;animation-delay:" & ( _atraso + 500 ) & "ms'></b></div>"
            & _htmlNota
            & _htmlDim
        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
    )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
