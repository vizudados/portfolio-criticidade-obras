/*
@pasta: T1 Visão geral\Síntese
@formato: texto
@descricao: Leitura do mês na faixa preta, pela nota: as obras críticas (até 3, com a nota e, se for o caso, a trava) e quantas estão em atenção, estáveis e pendentes; depois a obra que mais perde pontos no mês e os dois itens em que mais perde (pontos de possíveis). Com todas pendentes, diz que falta item na base e quem mais perde nos itens que já dá para calcular.
@gerado: pbi/scripts/desenho_t1.py
*/
-- 1 · Leituras
VAR _mesC = [Mês de referência · curto]
VAR _mesCM = [Mês de referência · curto maiúsculo]
VAR _c = [Nota · carteira · obras críticas · ref] + 0
VAR _a = [Nota · carteira · obras em atenção · ref] + 0
VAR _e = [Nota · carteira · obras estáveis · ref] + 0
VAR _p = [Nota · carteira · obras pendentes · ref] + 0
VAR _listaCrit = [Nota · recorte · obras críticas (lista)]
VAR _ranking = [Nota · recorte · obras por pontos perdidos (lista)]
VAR _o1 = PATHITEM ( _ranking, 1 )
VAR _perd1 = CALCULATE ( [Nota · pontos perdidos · ranking · ref], dObra[Obra] = _o1 )
VAR _pend1 = CALCULATE ( [Nota · pendente · ranking · ref], dObra[Obra] = _o1 )
VAR _poss1 = CALCULATE ( [Nota · pontos possíveis · ranking · ref], dObra[Obra] = _o1 )
VAR _c1 = PATHITEM ( _listaCrit, 1 )
VAR _c1Nota = CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _c1 )
VAR _c1Trv = CALCULATE ( [Nota · trava · motivo · ref], dObra[Obra] = _c1 ) & ""
VAR _c1Fr = IF ( _c1 = "", "", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c1, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " (" & IF ( 1 = 1, "nota ", "" ) & "⁅" & FORMAT ( _c1Nota, "0.0#", "pt-BR" ) & "⁆" & IF ( _c1Trv = "", "", ", trava de " & SUBSTITUTE ( _c1Trv, "|", " e " ) ) & ")" )
VAR _c2 = PATHITEM ( _listaCrit, 2 )
VAR _c2Nota = CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _c2 )
VAR _c2Trv = CALCULATE ( [Nota · trava · motivo · ref], dObra[Obra] = _c2 ) & ""
VAR _c2Fr = IF ( _c2 = "", "", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c2, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " (" & IF ( 2 = 1, "nota ", "" ) & "⁅" & FORMAT ( _c2Nota, "0.0#", "pt-BR" ) & "⁆" & IF ( _c2Trv = "", "", ", trava de " & SUBSTITUTE ( _c2Trv, "|", " e " ) ) & ")" )
VAR _c3 = PATHITEM ( _listaCrit, 3 )
VAR _c3Nota = CALCULATE ( [Nota · nota final · ranking · ref], dObra[Obra] = _c3 )
VAR _c3Trv = CALCULATE ( [Nota · trava · motivo · ref], dObra[Obra] = _c3 ) & ""
VAR _c3Fr = IF ( _c3 = "", "", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c3, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " (" & IF ( 3 = 1, "nota ", "" ) & "⁅" & FORMAT ( _c3Nota, "0.0#", "pt-BR" ) & "⁆" & IF ( _c3Trv = "", "", ", trava de " & SUBSTITUTE ( _c3Trv, "|", " e " ) ) & ")" )
VAR _iL = CALCULATE ( [T1 · Obras · itens que mais perdem (lista) · ref], dObra[Obra] = _o1 ) & ""
VAR _ofB = [T1 · Obras · com item faltando na base (lista) · ref] & ""
VAR _ofP = [T1 · Obras · com item faltando na planilha (lista) · ref] & ""
VAR _ofF = [T1 · Obras · com item fora da faixa (lista) · ref] & ""
VAR _ofNB = IF ( _ofB = "", 0, PATHLENGTH ( _ofB ) )
VAR _ofNP = IF ( _ofP = "", 0, PATHLENGTH ( _ofP ) )
VAR _ofNF = IF ( _ofF = "", 0, PATHLENGTH ( _ofF ) )
VAR _ofP1 = PATHITEM ( _ofP, 1 ) & ""
VAR _ofF1 = PATHITEM ( _ofF, 1 ) & ""
VAR _onde =
    SWITCH (
        TRUE (),
        _ofNB > 0 && _ofNP > 0 && _ofB = _ofP, "na base complementar e na planilha",
        _ofNB > 0 && _ofNP = 1, "na base complementar (na " & _ofP1
            & IF ( PATHCONTAINS ( _ofB, _ofP1 ), ", também na planilha)", ", só na planilha)" ),
        _ofNB > 0 && _ofNP > 1, "na base complementar (na planilha, em " & _ofNP & " obras)",
        _ofNP > 0, "na planilha",
        "na base complementar"
    )
VAR _ondeFora = SWITCH ( TRUE (), _ofNF = 0, "", _ofNF = 1, "; na " & _ofF1 & ", há valor fora da faixa", "; em " & _ofNF & " obras, há valor fora da faixa" )
VAR _ondeSoFora = _ofNB + _ofNP = 0 && _ofNF > 0
VAR _iN = IF ( _iL = "", 0, PATHLENGTH ( _iL ) )
VAR _i1Cod = PATHITEM ( _iL, 1 ) & ""
VAR _i1Frase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i1Cod )
VAR _i1Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Item] = _i1Cod, dObra[Obra] = _o1 )
VAR _i1Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Item] = _i1Cod, dObra[Obra] = _o1 )
VAR _i1Fr = IF ( _i1Cod = "", "", SWITCH ( TRUE (), LEFT ( _i1Frase, 3 ) = "os ", "nos " & MID ( _i1Frase, 4, 99 ), LEFT ( _i1Frase, 3 ) = "as ", "nas " & MID ( _i1Frase, 4, 99 ), LEFT ( _i1Frase, 2 ) = "o ", "no " & MID ( _i1Frase, 3, 99 ), LEFT ( _i1Frase, 2 ) = "a ", "na " & MID ( _i1Frase, 3, 99 ), "em " & _i1Frase ) & " (" & "⁅" & FORMAT ( _i1Pts, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _i1Poss, "0.0#", "pt-BR" ) & "⁆" & ")" )
VAR _i2Cod = PATHITEM ( _iL, 2 ) & ""
VAR _i2Frase = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _i2Cod )
VAR _i2Pts = CALCULATE ( [Nota · item · pontos · ref], dItemNota[Item] = _i2Cod, dObra[Obra] = _o1 )
VAR _i2Poss = CALCULATE ( [Nota · item · possíveis · ref], dItemNota[Item] = _i2Cod, dObra[Obra] = _o1 )
VAR _i2Fr = IF ( _i2Cod = "", "", SWITCH ( TRUE (), LEFT ( _i2Frase, 3 ) = "os ", "nos " & MID ( _i2Frase, 4, 99 ), LEFT ( _i2Frase, 3 ) = "as ", "nas " & MID ( _i2Frase, 4, 99 ), LEFT ( _i2Frase, 2 ) = "o ", "no " & MID ( _i2Frase, 3, 99 ), LEFT ( _i2Frase, 2 ) = "a ", "na " & MID ( _i2Frase, 3, 99 ), "em " & _i2Frase ) & " (" & "⁅" & FORMAT ( _i2Pts, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _i2Poss, "0.0#", "pt-BR" ) & "⁆" & ")" )
-- 2 · Textos
VAR _frasesCrit = IF ( _c1Fr <> "", IF ( 1 = 1, "", IF ( 1 = MIN ( _c, 3 ), " e ", ", " ) ) & _c1Fr, "" ) & IF ( _c2Fr <> "", IF ( 2 = 1, "", IF ( 2 = MIN ( _c, 3 ), " e ", ", " ) ) & _c2Fr, "" ) & IF ( _c3Fr <> "", IF ( 3 = 1, "", IF ( 3 = MIN ( _c, 3 ), " e ", ", " ) ) & _c3Fr, "" ) & IF ( _c > 3, " e mais " & "⁅" & ( _c - 3 ) & "⁆", "" )
VAR _tA = IF ( _a > 0, "⁅" & _a & "⁆" & " em atenção" )
VAR _tE = IF ( _e > 0, "⁅" & _e & "⁆" & IF ( _e = 1, " estável", " estáveis" ) )
VAR _tP = IF ( _p > 0, "⁅" & _p & "⁆" & IF ( _p = 1, " pendente", " pendentes" ) )
VAR _nOutros = INT ( _a > 0 ) + INT ( _e > 0 ) + INT ( _p > 0 )
VAR _txtOutros =
    SWITCH (
        _nOutros,
        0, "",
        1, _tA & _tE & _tP,
        2, IF ( _a > 0, _tA & " e " & _tE & _tP, _tE & " e " & _tP ),
        _tA & ", " & _tE & " e " & _tP
    )
VAR _txtAbre =
    SWITCH (
        TRUE (),
        _c + _a + _e + _p = 0, "Nenhuma obra com planilha em " & _mesC & ".",
        _c + _a + _e = 0, IF ( _p = 1, "A obra está pendente em ", "As " & "⁅" & _p & "⁆" & " obras estão pendentes em " )
            & _mesC & ", sem nota: " & IF ( _ondeSoFora, "há valor fora da faixa na base complementar", "falta item " & _onde & _ondeFora ) & ".",
        _c = 0, "Nenhuma obra crítica em " & _mesC & ": " & _txtOutros & ".",
        IF ( _c = 1, "1 obra crítica em ", "⁅" & _c & "⁆" & " obras críticas em " ) & _mesC & ": " & _frasesCrit
            & IF ( _txtOutros = "", ".", "; " & _txtOutros & "." )
    )
VAR _txtPerde =
    SWITCH (
        TRUE (),
        _o1 = "", "",
        NOT ( _perd1 > 0 ), " Nenhuma obra perdeu pontos nos itens com dado.",
        IF ( _c + _a + _e = 0, " No que já dá para calcular, quem mais perde é a ", " Quem mais perde pontos é a " )
            & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _o1, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " (" & "⁅" & FORMAT ( _perd1, "0.0#", "pt-BR" ) & "⁆" & IF ( _pend1 = 1, " dos " & "⁅" & FORMAT ( _poss1, "0.0#", "pt-BR" ) & "⁆" & " possíveis", "" ) & ")"
            & ", mais " & SWITCH ( _iN, 1, _i1Fr, 2, _i1Fr & " e " & _i2Fr, "em " & "⁅" & _iN & "⁆" & " itens empatados" ) & "."
    )
VAR _txtSin = _txtAbre & _txtPerde
VAR _nSin = LEN ( SUBSTITUTE ( SUBSTITUTE ( _txtSin, "⁅", "" ), "⁆", "" ) )
-- 4 · Marcação
VAR _saidaHtml =
    "<div class='u si escuro'><p class='ab vs'>LEITURA DE " & _mesCM & "</p>"
        & "<p class='tx" & IF ( _nSin > 245, " t3", "" ) & "'>" & _txtSin & "</p>"
    & "</div>" & [Comum · JS contador]
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
