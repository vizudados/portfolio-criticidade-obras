/*
@pasta: T1 Visão geral\Onde a carteira perde pontos
@formato: texto
@descricao: Uma linha por dimensão da nota (granularidade dItemNota[Dimensao], ordem T1 · Pesa · posição): nome, quantas obras perderam pontos, em quantas falta dado e, com dois itens, o item que mais perde; pontos perdidos somados e a barra na escala da dimensão que mais perde, separada pelo status da obra (crítico, atenção, estável, pendente). Dimensão sem dado em nenhuma obra: trilho tracejado e 'falta na base' (ou 'sem dado na planilha', na Análise Crítica).
@gerado: pbi/scripts/desenho_t1.py
*/
-- 1 · Leituras
VAR _pos = [T1 · Pesa · posição]
VAR _rot = [Nota · item · dimensão]
VAR _fonte = [Nota · item · fonte]
VAR _itTop = [T1 · Pesa · item que mais perde] & ""
VAR _itRot = IF ( _itTop = "", "", CALCULATE ( [Nota · item · nome curto], dItemNota[Item] = _itTop ) )
VAR _perd = [Nota · item · perdidos · ref]
VAR _poss = [Nota · item · possíveis · ref]
VAR _nOb = [Nota · item · obras que perderam pontos · ref] + 0
VAR _nSem = [T1 · Pesa · obras sem dado] + 0
VAR _pC = [T1 · Pesa · perdidos das obras críticas] + 0
VAR _pA = [T1 · Pesa · perdidos das obras em atenção] + 0
VAR _pE = [T1 · Pesa · perdidos das obras estáveis] + 0
VAR _pP = [T1 · Pesa · perdidos das obras pendentes] + 0
VAR _max = [T1 · Pesa · maior perda]
-- 3 · Geometria
VAR _k = IF ( _max > 0, 464 / _max, 0 ) -- geometria
VAR _xA = ROUND ( _pC * _k, 0 ) -- geometria
VAR _xE = ROUND ( ( _pC + _pA ) * _k, 0 ) -- geometria
VAR _xP = ROUND ( ( _pC + _pA + _pE ) * _k, 0 ) -- geometria
VAR _xF = ROUND ( ( _pC + _pA + _pE + _pP ) * _k, 0 ) -- geometria
VAR _atraso = ( _pos - 1 ) * 60 -- geometria
-- 2 · Textos
VAR _semDado = ISBLANK ( _poss )
VAR _txtFalta = IF ( _fonte = "Análise Crítica", "sem dado na planilha", "falta na base" )
VAR _txtOb = IF ( _nOb = 0, "nenhuma obra", IF ( _nOb = 1, "1 obra", "⁅" & _nOb & "⁆" & " obras" ) )
VAR _txtSem = IF ( _fonte = "Análise Crítica", "sem dado em ", "falta em " ) & "⁅" & _nSem & "⁆"
VAR _txtEm = IF ( _semDado, _txtFalta, _txtOb & IF ( _nSem > 0, " · " & _txtSem, "" ) & IF ( _itRot = "", "", " · mais em " & _itRot ) )
VAR _txtPts = IF ( _semDado, "—", FORMAT ( _perd, "0.0#", "pt-BR" ) & " pts" )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _nuPts = IF ( _semDado, "", FORMAT ( _perd, "0.0#", "pt-BR" ) )
VAR _pKP = LEN ( _nuPts ) > 0
VAR _pKN = IF ( _pKP, _nuPts )
VAR _pKS = SUBSTITUTE ( SUBSTITUTE ( _pKN, ".", "" ), ",", "" )
VAR _pKT = IFERROR ( VALUE ( _pKS ), -1 )
VAR _pKOk = _pKP && _pKT >= 2 && FORMAT ( _pKT, REPT ( "0", LEN ( _pKS ) ) ) = _pKS
VAR _pKD = IF ( CONTAINSSTRING ( _pKN, "," ), LEN ( _pKN ) - SEARCH ( ",", _pKN ), 0 )
VAR _pKM = IF ( CONTAINSSTRING ( _pKN, "." ), "#,##0", "0" ) & IF ( _pKD > 0, "." & REPT ( "0", _pKD ) )
VAR _pKOd =
    IF (
        _pKOk,
        "<o-d><o-v>" & _pKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _pKN, FORMAT ( ROUND ( _pKT * [@odf] / 1000, 0 ) / POWER ( 10, _pKD ), _pKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _nuPts
    )
VAR _odPts = IF ( _semDado, _txtPts, _pKOd & " pts" )
-- 4 · Marcação
VAR _seg = "' data-rd='" & _atraso & "'></i>"
VAR _htmlTr =
    IF (
        _semDado,
        "<div class='tr f a-gx' style='animation-delay:" & _atraso & "ms'></div>",
        "<div class='tr a-fd' style='animation-delay:" & _atraso & "ms'>"
            & IF ( _xA > 0, "<i class='c' style='left:0;width:" & _xA & "px' data-rk='" & _rot & "|c" & _seg )
            & IF ( _xE > _xA, "<i class='a' style='left:" & _xA & "px;width:" & ( _xE - _xA ) & "px' data-rk='" & _rot & "|a" & _seg )
            & IF ( _xP > _xE, "<i class='e' style='left:" & _xE & "px;width:" & ( _xP - _xE ) & "px' data-rk='" & _rot & "|e" & _seg )
            & IF ( _xF > _xP, "<i class='p' style='left:" & _xP & "px;width:" & ( _xF - _xP ) & "px' data-rk='" & _rot & "|p" & _seg )
        & "</div>"
    )
VAR _saidaHtml =
    IF (
        NOT ISBLANK ( _pos ),
        "<div class='u pl' data-rr='" & _rot & "'>"
            & "<div class='rt'><span>" & _rot & "</span><em>" & UPPER ( _txtEm ) & "</em></div>"
            & "<p class='ab b6 pt" & IF ( _semDado, " vz", "" ) & "'>" & _odPts & "</p>"
            & _htmlTr
        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
    )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
