/*
@pasta: T3 Avanço físico\Cartões
@formato: texto
@descricao: Cartão 'no mês' da obra em foco (frente e verso). Só lê contas · foco.
@gerado: pbi/scripts/desenho_t3.py
*/
-- 1 · Leituras
VAR _e = [Físico · executado no mês · foco]
VAR _p = [Físico · previsto no mês · foco]
VAR _mesC = [Mês de referência · curto]
-- 2 · Textos
VAR _teN = FORMAT ( ABS ( _e ) * 100, "0.00", "pt-BR" )
VAR _teS = IF ( ROUND ( _e * 100, 2 ) < 0, "−", "" )
VAR _teTxt = IF ( ISBLANK ( _e ), "—", _teS & _teN & "%" )
VAR _tpN = FORMAT ( ABS ( _p ) * 100, "0.00", "pt-BR" )
VAR _tpS = IF ( ROUND ( _p * 100, 2 ) < 0, "−", "" )
VAR _tpTxt = IF ( ISBLANK ( _p ), "—", _tpS & _tpN & "%" )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _teKP = LEN ( _teN ) > 0
VAR _teKN = IF ( _teKP, _teN )
VAR _teKS = SUBSTITUTE ( SUBSTITUTE ( _teKN, ".", "" ), ",", "" )
VAR _teKT = IFERROR ( VALUE ( _teKS ), -1 )
VAR _teKOk = _teKP && _teKT >= 2 && FORMAT ( _teKT, REPT ( "0", LEN ( _teKS ) ) ) = _teKS
VAR _teKD = IF ( CONTAINSSTRING ( _teKN, "," ), LEN ( _teKN ) - SEARCH ( ",", _teKN ), 0 )
VAR _teKM = IF ( CONTAINSSTRING ( _teKN, "." ), "#,##0", "0" ) & IF ( _teKD > 0, "." & REPT ( "0", _teKD ) )
VAR _teKOd =
    IF (
        _teKOk,
        "<o-d><o-v>" & _teKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _teKN, FORMAT ( ROUND ( _teKT * [@odf] / 1000, 0 ) / POWER ( 10, _teKD ), _teKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _teN
    )
VAR _teOd = IF ( ISBLANK ( _e ), _teTxt, _teS & _teKOd & "%" )
VAR _tpKP = LEN ( _tpN ) > 0
VAR _tpKN = IF ( _tpKP, _tpN )
VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
VAR _tpKOd =
    IF (
        _tpKOk,
        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tpN
    )
VAR _tpOd = IF ( ISBLANK ( _p ), _tpTxt, _tpS & _tpKOd & "%" )
-- 4 · Marcação
RETURN
    "<div class='u kc' tabindex='0'>"
        & "<div class='lado frente'>"
            & "<p class='ab vs eb'>" & "No mês · " & _mesC & "</p>"
            & "<div class='linha1'><span class='b6 hero'>" & _teOd & "</span>" & "<span class='b5 lado2'>" & "executado" & "</span>" & "</div>"
            & "<p class='ctx'>" & IF ( ISBLANK ( _p ) && NOT ISBLANK ( _e ), "sem previsto na planilha", _tpOd & " previsto" ) & "</p>"
        & "</div>"
        & "<div class='lado verso sobre-creme'>"
            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
            & "<p class='regra'>" & "Fatia da obra executada só neste mês, ao lado do que o cronograma previa para ele." & "</p>"
            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Previsto e executado, mês</span></div>"
        & "</div>"
    & "</div>" & [Comum · JS contador]
