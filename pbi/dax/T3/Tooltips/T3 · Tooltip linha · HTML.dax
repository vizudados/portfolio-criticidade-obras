/*
@pasta: T3 Avanço físico\Tooltips
@formato: texto
@descricao: Tooltip de página da obra da Linha do tempo: ficha de prazo (início, término e orçamento com o tipo), o prazo no mês de referência (F3: atraso em meses, término projetado e onde ele cai diante da entrega contratual e dos 180 dias de tolerância), físico × financeiro até o mês de referência (com o status do físico na nota) e o status da obra na nota desde quando, com a nota (ou 'pendente · X de Y') e, no pé, os itens em que a obra mais perde pontos; obra sem previsto na planilha só com o executado e a nota; obra a iniciar só com o cadastro da cronograma.
@gerado: pbi/scripts/tooltips_t3.py
*/
-- 1 · Leituras
VAR _sit = [T3 · Obra · situação]
VAR _obra = [Obra · nome]
VAR _cod = [Obra · código]
VAR _selo = [Obra · selo]
VAR _spe = [T3 · Obra · SPE]
VAR _m2 = [T3 · Obra · m² NBR]
VAR _ini = [Obra · início]
VAR _fim = [Obra · término previsto]
VAR _aba = [Aba · ref]
VAR _mesCM = [Mês de referência · curto maiúsculo]
VAR _orc = [Orçamento · ref]
VAR _tipo = [Tipo de orçamento · ref]
VAR _orcG = [T3 · Obra · orçamento cronograma]
VAR _tipoG = [T3 · Obra · tipo de orçamento cronograma]
VAR _e = [Físico · executado acumulado · ref]
VAR _p = [Físico · previsto acumulado · ref]
VAR _d = [Físico · desvio acumulado p.p. · ref]
VAR _sF = [T3 · Status desvio físico · ref]
VAR _cred = [Crédito do orçamento · ref]
VAR _des = [Desembolsado acumulado · ref]
VAR _st = [Nota · status · ranking · ref]
VAR _pend = [Nota · pendente · ranking · ref]
VAR _nota = [Nota · nota final · ranking · ref]
VAR _obt = [Nota · pontos obtidos · ranking · ref]
VAR _poss = [Nota · pontos possíveis · ranking · ref]
VAR _stIni = [T3 · Status · início da sequência]
VAR _itens = [T3 · Tooltip linha · itens que perdem pontos (lista)]
VAR _ref = [Mês de referência]
VAR _jan = [Série · primeiro mês]
VAR _atr = [Prazo · atraso (meses) · ref]
VAR _ptA = [Nota · pontos prazo · ref]
VAR _psA = [Nota · possíveis · prazo · ref]
VAR _proj = [Prazo · término projetado · ref]
VAR _ent = [Prazo · entrega contratual]
VAR _tol = [Prazo · entrega com tolerância]
VAR _sitT = [T3 · Término · situação · ref]
-- 2 · Textos
VAR _andamento = NOT ISBLANK ( _e )
VAR _orcUso = IF ( _andamento, _orc, _orcG )
VAR _toA = ABS ( _orcUso )
VAR _toNu = SWITCH ( TRUE (), _toA >= 99950000, FORMAT ( _toA / 1000000, "0.0", "pt-BR" ), _toA >= 999500, FORMAT ( _toA / 1000000, "0.00", "pt-BR" ), _toA >= 999.5, FORMAT ( _toA / 1000, "0", "pt-BR" ), FORMAT ( _toA, "#,0", "pt-BR" ) )
VAR _toUn = SWITCH ( TRUE (), _toA >= 999500, " mi", _toA >= 999.5, " mil", "" )
VAR _toN = _toNu & _toUn
VAR _toZero = _toN = "0"
VAR _toS = IF ( _toZero, "", IF ( _orcUso < 0, "−", "" ) )
VAR _toTxt = IF ( ISBLANK ( _orcUso ), "—", _toS & "R$ " & _toN )
VAR _teN = FORMAT ( ABS ( _e ) * 100, "0.0", "pt-BR" )
VAR _teS = IF ( ROUND ( _e * 100, 1 ) < 0, "−", "" )
VAR _teTxt = IF ( ISBLANK ( _e ), "—", _teS & _teN & "%" )
VAR _tpN = FORMAT ( ABS ( _p ) * 100, "0.0", "pt-BR" )
VAR _tpS = IF ( ROUND ( _p * 100, 1 ) < 0, "−", "" )
VAR _tpTxt = IF ( ISBLANK ( _p ), "—", _tpS & _tpN & "%" )
VAR _tdvN = FORMAT ( ABS ( _d ), "0.0", "pt-BR" )
VAR _tdvS = SWITCH ( TRUE (), ROUND ( _d, 1 ) < 0, "−", ROUND ( _d, 1 ) > 0, "+", "" )
VAR _tdvTxt = IF ( ISBLANK ( _d ), "—", _tdvS & _tdvN & " p.p." )
VAR _tcrA = ABS ( _cred )
VAR _tcrNu = SWITCH ( TRUE (), _tcrA >= 99950000, FORMAT ( _tcrA / 1000000, "0.0", "pt-BR" ), _tcrA >= 999500, FORMAT ( _tcrA / 1000000, "0.00", "pt-BR" ), _tcrA >= 999.5, FORMAT ( _tcrA / 1000, "0", "pt-BR" ), FORMAT ( _tcrA, "#,0", "pt-BR" ) )
VAR _tcrUn = SWITCH ( TRUE (), _tcrA >= 999500, " mi", _tcrA >= 999.5, " mil", "" )
VAR _tcrN = _tcrNu & _tcrUn
VAR _tcrZero = _tcrN = "0"
VAR _tcrS = IF ( _tcrZero, "", IF ( _cred < 0, "−", "" ) )
VAR _tcrTxt = IF ( ISBLANK ( _cred ), "—", _tcrS & "R$ " & _tcrN )
VAR _tdsA = ABS ( _des )
VAR _tdsNu = SWITCH ( TRUE (), _tdsA >= 99950000, FORMAT ( _tdsA / 1000000, "0.0", "pt-BR" ), _tdsA >= 999500, FORMAT ( _tdsA / 1000000, "0.00", "pt-BR" ), _tdsA >= 999.5, FORMAT ( _tdsA / 1000, "0", "pt-BR" ), FORMAT ( _tdsA, "#,0", "pt-BR" ) )
VAR _tdsUn = SWITCH ( TRUE (), _tdsA >= 999500, " mi", _tdsA >= 999.5, " mil", "" )
VAR _tdsN = _tdsNu & _tdsUn
VAR _tdsZero = _tdsN = "0"
VAR _tdsS = IF ( _tdsZero, "", IF ( _des < 0, "−", "" ) )
VAR _tdsTxt = IF ( ISBLANK ( _des ), "—", _tdsS & "R$ " & _tdsN )
VAR _ntN = FORMAT ( _nota, "0.0#", "pt-BR" )
VAR _ntOb = FORMAT ( _obt, "0.0#", "pt-BR" )
VAR _ntPo = FORMAT ( _poss, "0.0#", "pt-BR" )
VAR _ntTxt = SWITCH ( TRUE (), _pend = 1, "pendente · " & _ntOb & " de " & _ntPo, ISBLANK ( _nota ), "—", "nota " & _ntN )
VAR _taA = ROUND ( ABS ( _atr ), 1 )
VAR _taN = FORMAT ( _taA, "0.0", "pt-BR" )
VAR _taS = IF ( ROUND ( _atr, 1 ) < 0, "−", "" )
VAR _taUn = IF ( _taA <= 1, " mês", " meses" )
VAR _taTxt = IF ( ISBLANK ( _atr ), "—", _taS & _taN & _taUn )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _toKP = LEN ( _toNu ) > 0
VAR _toKN = IF ( _toKP, _toNu )
VAR _toKS = SUBSTITUTE ( SUBSTITUTE ( _toKN, ".", "" ), ",", "" )
VAR _toKT = IFERROR ( VALUE ( _toKS ), -1 )
VAR _toKOk = _toKP && _toKT >= 2 && FORMAT ( _toKT, REPT ( "0", LEN ( _toKS ) ) ) = _toKS
VAR _toKD = IF ( CONTAINSSTRING ( _toKN, "," ), LEN ( _toKN ) - SEARCH ( ",", _toKN ), 0 )
VAR _toKM = IF ( CONTAINSSTRING ( _toKN, "." ), "#,##0", "0" ) & IF ( _toKD > 0, "." & REPT ( "0", _toKD ) )
VAR _toKOd =
    IF (
        _toKOk,
        "<o-d><o-v>" & _toKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _toKN, FORMAT ( ROUND ( _toKT * [@odf] / 1000, 0 ) / POWER ( 10, _toKD ), _toKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _toNu
    )
VAR _toOd = IF ( ISBLANK ( _orcUso ), _toTxt, _toS & "R$ " & _toKOd & _toUn )
VAR _teKP = LEN ( _teN ) > 0
VAR _teKN = IF ( _teKP, _teN )
VAR _teKS = SUBSTITUTE ( SUBSTITUTE ( _teKN, ".", "" ), ",", "" )
VAR _teKT = IFERROR ( VALUE ( _teKS ), -1 )
VAR _teKOk = _teKP && _teKT >= 2 && FORMAT ( _teKT, REPT ( "0", LEN ( _teKS ) ) ) = _teKS
VAR _teKD = IF ( CONTAINSSTRING ( _teKN, "," ), LEN ( _teKN ) - SEARCH ( ",", _teKN ), 0 )
VAR _teKM = IF ( CONTAINSSTRING ( _teKN, "." ), "#,##0", "0" ) & IF ( _teKD > 0, "." & REPT ( "0", _teKD ) )
VAR _teKOd =
    IF (
        _teKOk,
        "<o-d><o-v>" & _teKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _teKN, FORMAT ( ROUND ( _teKT * [@odf] / 1000, 0 ) / POWER ( 10, _teKD ), _teKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _teN
    )
VAR _teOd = IF ( ISBLANK ( _e ), _teTxt, _teS & _teKOd & "%" )
VAR _tpKP = LEN ( _tpN ) > 0
VAR _tpKN = IF ( _tpKP, _tpN )
VAR _tpKS = SUBSTITUTE ( SUBSTITUTE ( _tpKN, ".", "" ), ",", "" )
VAR _tpKT = IFERROR ( VALUE ( _tpKS ), -1 )
VAR _tpKOk = _tpKP && _tpKT >= 2 && FORMAT ( _tpKT, REPT ( "0", LEN ( _tpKS ) ) ) = _tpKS
VAR _tpKD = IF ( CONTAINSSTRING ( _tpKN, "," ), LEN ( _tpKN ) - SEARCH ( ",", _tpKN ), 0 )
VAR _tpKM = IF ( CONTAINSSTRING ( _tpKN, "." ), "#,##0", "0" ) & IF ( _tpKD > 0, "." & REPT ( "0", _tpKD ) )
VAR _tpKOd =
    IF (
        _tpKOk,
        "<o-d><o-v>" & _tpKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tpKN, FORMAT ( ROUND ( _tpKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpKD ), _tpKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tpN
    )
VAR _tpOd = IF ( ISBLANK ( _p ), _tpTxt, _tpS & _tpKOd & "%" )
VAR _tdvKP = LEN ( _tdvN ) > 0
VAR _tdvKN = IF ( _tdvKP, _tdvN )
VAR _tdvKS = SUBSTITUTE ( SUBSTITUTE ( _tdvKN, ".", "" ), ",", "" )
VAR _tdvKT = IFERROR ( VALUE ( _tdvKS ), -1 )
VAR _tdvKOk = _tdvKP && _tdvKT >= 2 && FORMAT ( _tdvKT, REPT ( "0", LEN ( _tdvKS ) ) ) = _tdvKS
VAR _tdvKD = IF ( CONTAINSSTRING ( _tdvKN, "," ), LEN ( _tdvKN ) - SEARCH ( ",", _tdvKN ), 0 )
VAR _tdvKM = IF ( CONTAINSSTRING ( _tdvKN, "." ), "#,##0", "0" ) & IF ( _tdvKD > 0, "." & REPT ( "0", _tdvKD ) )
VAR _tdvKOd =
    IF (
        _tdvKOk,
        "<o-d><o-v>" & _tdvKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tdvKN, FORMAT ( ROUND ( _tdvKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdvKD ), _tdvKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tdvN
    )
VAR _tdvOd = IF ( ISBLANK ( _d ), _tdvTxt, _tdvS & _tdvKOd & " p.p." )
VAR _tcrKP = LEN ( _tcrNu ) > 0
VAR _tcrKN = IF ( _tcrKP, _tcrNu )
VAR _tcrKS = SUBSTITUTE ( SUBSTITUTE ( _tcrKN, ".", "" ), ",", "" )
VAR _tcrKT = IFERROR ( VALUE ( _tcrKS ), -1 )
VAR _tcrKOk = _tcrKP && _tcrKT >= 2 && FORMAT ( _tcrKT, REPT ( "0", LEN ( _tcrKS ) ) ) = _tcrKS
VAR _tcrKD = IF ( CONTAINSSTRING ( _tcrKN, "," ), LEN ( _tcrKN ) - SEARCH ( ",", _tcrKN ), 0 )
VAR _tcrKM = IF ( CONTAINSSTRING ( _tcrKN, "." ), "#,##0", "0" ) & IF ( _tcrKD > 0, "." & REPT ( "0", _tcrKD ) )
VAR _tcrKOd =
    IF (
        _tcrKOk,
        "<o-d><o-v>" & _tcrKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tcrKN, FORMAT ( ROUND ( _tcrKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcrKD ), _tcrKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tcrNu
    )
VAR _tcrOd = IF ( ISBLANK ( _cred ), _tcrTxt, _tcrS & "R$ " & _tcrKOd & _tcrUn )
VAR _tdsKP = LEN ( _tdsNu ) > 0
VAR _tdsKN = IF ( _tdsKP, _tdsNu )
VAR _tdsKS = SUBSTITUTE ( SUBSTITUTE ( _tdsKN, ".", "" ), ",", "" )
VAR _tdsKT = IFERROR ( VALUE ( _tdsKS ), -1 )
VAR _tdsKOk = _tdsKP && _tdsKT >= 2 && FORMAT ( _tdsKT, REPT ( "0", LEN ( _tdsKS ) ) ) = _tdsKS
VAR _tdsKD = IF ( CONTAINSSTRING ( _tdsKN, "," ), LEN ( _tdsKN ) - SEARCH ( ",", _tdsKN ), 0 )
VAR _tdsKM = IF ( CONTAINSSTRING ( _tdsKN, "." ), "#,##0", "0" ) & IF ( _tdsKD > 0, "." & REPT ( "0", _tdsKD ) )
VAR _tdsKOd =
    IF (
        _tdsKOk,
        "<o-d><o-v>" & _tdsKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tdsKN, FORMAT ( ROUND ( _tdsKT * [@odf] / 1000, 0 ) / POWER ( 10, _tdsKD ), _tdsKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tdsNu
    )
VAR _tdsOd = IF ( ISBLANK ( _des ), _tdsTxt, _tdsS & "R$ " & _tdsKOd & _tdsUn )
VAR _taKP = LEN ( _taN ) > 0
VAR _taKN = IF ( _taKP, _taN )
VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
VAR _taKOd =
    IF (
        _taKOk,
        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _taN
    )
VAR _taOd = IF ( ISBLANK ( _atr ), _taTxt, _taS & _taKOd & _taUn )
VAR _txtOnde = SWITCH ( _sitT, 0, "até a entrega", 1, "nos 180 dias", 2, "depois dos 180 dias", "" )
VAR _htmlPrazo =
    IF (
        ISBLANK ( _atr ),
        "<div class='li'><span class='n'>Atraso</span><span class='d'>sem curva prevista</span></div>",
        "<div class='li'><span class='n'>Atraso</span><span class='v'>" & IF ( IF ( ISBLANK ( _ptA ), "", IF ( _ptA >= _psA, "0", IF ( _ptA = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( _ptA ), "", IF ( _ptA >= _psA, "0", IF ( _ptA = 0, "2", "1" ) ) ) & "'></i>" ) & _taOd & "</span><span class='n'>Término projetado</span><span class='v'><i class='mk mk" & _sitT & "'></i>"
            & FORMAT ( _proj, "mmm/yy", "pt-BR" ) & "</span><span class='d'>" & _txtOnde & ": entrega " & FORMAT ( _ent, "mmm/yy", "pt-BR" ) & ", com 180 dias " & FORMAT ( _tol, "mmm/yy", "pt-BR" ) & "</span></div>"
    )
VAR _tipoUso = UPPER ( IF ( _andamento, _tipo, _tipoG ) )
VAR _txtSob =
    IF (
        _andamento,
        "LINHA DO TEMPO · OBRA EM ANDAMENTO" & IF ( ISBLANK ( _aba ), "", " · ABA " & _aba ),
        IF ( _sit = "A iniciar", "LINHA DO TEMPO · OBRA A INICIAR · cronograma " & UPPER ( [T3 · cronograma · versão] ), "LINHA DO TEMPO · OBRA SEM ABA EM " & _mesCM )
    )
VAR _posC = SEARCH ( " CONSTRU", _spe, 1, 0 )
VAR _txtSpe = IF ( ISBLANK ( _spe ) || _spe = "—", "", IF ( _posC > 0, LEFT ( _spe, _posC - 1 ), _spe ) & " SPE · " )
VAR _txtDir = IF ( _andamento, _txtSpe, "" ) & IF ( ISBLANK ( _m2 ), "", "⁅" & FORMAT ( _m2, "#,0", "pt-BR" ) & "⁆" & " M² NBR" )
VAR _seloUso = IF ( _selo = "" || ISBLANK ( _selo ), IF ( _sit = "A iniciar", "cronograma", "" ), _selo )
VAR _txtCod = IF ( ISBLANK ( _cod ) || _cod = "—", "", _cod )
VAR _txtIni = IF ( ISBLANK ( _ini ), "—", FORMAT ( _ini, "mmm/yy", "pt-BR" ) )
VAR _txtFim = IF ( ISBLANK ( _fim ), "—", FORMAT ( _fim, "mmm/yy", "pt-BR" ) )
VAR _txtStatus =
    SWITCH ( TRUE (), _pend = 1, "pendente", _st = 2, "crítica", _st = 1, "em atenção", "estável" )
        & IF ( _stIni = _ref, " em " & FORMAT ( _stIni, "mmmm", "pt-BR" ), " desde " & IF ( _stIni = _jan || YEAR ( _stIni ) <> YEAR ( _ref ), FORMAT ( _stIni, "mmm/yy", "pt-BR" ), FORMAT ( _stIni, "mmmm", "pt-BR" ) ) )
VAR _nIt = IF ( _itens = "" || ISBLANK ( _itens ), 0, PATHLENGTH ( _itens ) )
VAR _txtLinha =
    SWITCH (
        _nIt,
        0, "",
        1, "Só perde pontos em " & PATHITEM ( _itens, 1 ) & ".",
        "Onde mais perde pontos: " & PATHITEM ( _itens, 1 ) & " e " & PATHITEM ( _itens, 2 ) & "."
    )
VAR _htmlStatus =
    "<div class='st'>" & IF ( IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) = "", "", "<span class='chip chip" & IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) & "'><i></i>" & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & "</span>" ) & "<span class='v'>"
        & IF ( _pend = 1, "⁅" & _ntOb & "⁆" & " de " & _ntPo, "⁅" & _ntN & "⁆" ) & "</span><span class='pt'>"
        & IF ( _pend = 1, "pontos até agora", "Nota da obra" ) & "</span><span class='d'>" & _txtStatus & "</span></div>"
VAR _htmlFisico =
    IF (
        ISBLANK ( _p ),
        "<div class='li'><span class='n'>Executado</span><span class='v'>" & _teOd & "</span><span class='d'>sem previsto na planilha"
            & "</span></div>",
        "<div class='li'><span class='n'>Executado</span><span class='v'>" & _teOd & "</span>"
            & "<span class='n'>Previsto</span><span class='v'>" & _tpOd & "</span>"
            & "<span class='v'><i class='mk mk" & _sF & "'></i><span class='" & IF ( ROUND ( _d, 1 ) < 0, "ng", "" ) & "'>" & _tdvOd & "</span></span><span class='d'>" & SWITCH ( _sF, 2, "fora do limite", "dentro do limite" ) & "</span></div>"
    )
VAR _htmlCorpo =
    IF (
        _andamento,
        "<div class='r3'></div><span class='vs'>PRAZO EM " & _mesCM & "</span>" & _htmlPrazo
            & "<div class='r3'></div><span class='vs'>FÍSICO × FINANCEIRO ATÉ " & _mesCM & "</span>" & _htmlFisico
            & "<div class='li'>" & "<span class='n'>Crédito do executado</span><span class='v'>" & _tcrOd & "</span>" & "<span class='n'>Desembolsado</span><span class='v'>" & _tdsOd & "</span>" & "</div>"
            & "<div class='r3'></div><span class='vs'>STATUS DA OBRA EM " & _mesCM & "</span>" & _htmlStatus,
        ""
    )
VAR _htmlRod =
    IF (
        _andamento,
        IF ( _txtLinha = "", "", "<div class='rod sr'><p class='l1'>" & _txtLinha & "</p></div>" ),
        "<div class='rod'><div class='r3'></div><span class='vs'>" & "AINDA SEM PLANILHA ANÁLISE CRÍTICA" & "</span><p class='l1'>" & "Previsto, executado e status chegam com a primeira aba da obra." & "</p></div>"
    )
-- 4 · Marcação
VAR _saidaHtml =
    IF (
        /* sem obra única no contexto (cálculo fora do visual, filtro com várias): vazio, sem chegar nos textos */
        HASONEVALUE ( dObra[Obra] ) && _sit IN { "Em andamento", "A iniciar" },
        "<div class='u tt'>" & "<div class='cab'><p class='vs sob'>" & _txtSob & "</p><div class='tl'><div class='tit'>" & "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</b><em>" & _txtCod & "</em>" & IF ( _seloUso = "", "", "<span class='selo " & IF ( _seloUso = "REAL", "selo-r", "selo-i" ) & "'>" & _seloUso & "</span>" ) & "</div><p class='vs dir'>" & _txtDir & "</p></div></div>"
            & "<div class='corpo'>" & "<div class='c3'>" & "<div><span class='vs'>" & IF ( _andamento, "INÍCIO", "INÍCIO PREVISTO" ) & "</span><b>" & _txtIni & "</b></div>" & "<div><span class='vs'>" & "TÉRMINO PREVISTO" & "</span><b>" & _txtFim & "</b></div>" & "<div><span class='vs'>" & "ORÇAMENTO" & IF ( _tipoUso = "", "", " · " & _tipoUso ) & "</span><b>" & _toOd & "</b></div>" & "</div>"
            & _htmlCorpo & "</div>" & _htmlRod
        & "</div>" & [Comum · JS contador tooltip]
    )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
