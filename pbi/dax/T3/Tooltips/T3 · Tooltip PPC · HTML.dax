/*
@pasta: T3 Avanço físico\Tooltips
@formato: texto
@descricao: Tooltip de página do mês do PPC mês a mês (obra em foco): o PPC do mês com a marca dos pontos, os pontos do item PPC na nota e o atraso em meses ao fim do mês; o ritmo do mês (previsto × executado, em % do orçamento) e o acumulado numa linha; no pé, o PPC do mês anterior. Sem PPC na base: 'falta na base' no lugar do número.
@gerado: pbi/scripts/tooltips_t3.py
*/
-- 1 · Leituras
VAR _noRecorte = [Série · mês até a referência]
VAR _obra = [Nota · obra em foco]
VAR _aba = [T3 · Aba · foco no mês]
VAR _mesL = [Mês · longo]
VAR _mesN = [Mês · nome]
VAR _mesAntN = [Mês anterior · nome]
VAR _ppc = [Canteiro · PPC · foco no mês]
VAR _pt = [Nota · pontos PPC · foco no mês]
VAR _ps = [Nota · possíveis · PPC · foco no mês]
VAR _meta = [Nota · limite PPC · ponto cheio]
VAR _atr = [Prazo · atraso (meses) · foco no mês]
VAR _ptA = [Nota · pontos prazo · foco no mês]
VAR _psA = [Nota · possíveis · prazo · foco no mês]
VAR _pm = [Físico · previsto no mês · foco no mês]
VAR _em = [Físico · executado no mês · foco no mês]
VAR _pa = [Físico · previsto acumulado · foco no mês]
VAR _ea = [Físico · executado acumulado · foco no mês]
VAR _ppcAnt = [T3 · PPC · mês anterior · foco no mês]
-- 2 · Textos
VAR _tcN = FORMAT ( ABS ( _ppc ) * 100, "0", "pt-BR" )
VAR _tcS = IF ( ROUND ( _ppc * 100, 0 ) < 0, "−", "" )
VAR _tcTxt = IF ( ISBLANK ( _ppc ), "—", _tcS & _tcN & "%" )
VAR _tmN = FORMAT ( ABS ( _meta ) * 100, "0", "pt-BR" )
VAR _tmS = IF ( ROUND ( _meta * 100, 0 ) < 0, "−", "" )
VAR _tmTxt = IF ( ISBLANK ( _meta ), "—", _tmS & _tmN & "%" )
VAR _tpmN = FORMAT ( ABS ( _pm ) * 100, "0.00", "pt-BR" )
VAR _tpmS = IF ( ROUND ( _pm * 100, 2 ) < 0, "−", "" )
VAR _tpmTxt = IF ( ISBLANK ( _pm ), "—", _tpmS & _tpmN & "%" )
VAR _temN = FORMAT ( ABS ( _em ) * 100, "0.00", "pt-BR" )
VAR _temS = IF ( ROUND ( _em * 100, 2 ) < 0, "−", "" )
VAR _temTxt = IF ( ISBLANK ( _em ), "—", _temS & _temN & "%" )
VAR _tpaN = FORMAT ( ABS ( _pa ) * 100, "0.0", "pt-BR" )
VAR _tpaS = IF ( ROUND ( _pa * 100, 1 ) < 0, "−", "" )
VAR _tpaTxt = IF ( ISBLANK ( _pa ), "—", _tpaS & _tpaN & "%" )
VAR _teaN = FORMAT ( ABS ( _ea ) * 100, "0.0", "pt-BR" )
VAR _teaS = IF ( ROUND ( _ea * 100, 1 ) < 0, "−", "" )
VAR _teaTxt = IF ( ISBLANK ( _ea ), "—", _teaS & _teaN & "%" )
VAR _tcaN = FORMAT ( ABS ( _ppcAnt ) * 100, "0", "pt-BR" )
VAR _tcaS = IF ( ROUND ( _ppcAnt * 100, 0 ) < 0, "−", "" )
VAR _tcaTxt = IF ( ISBLANK ( _ppcAnt ), "—", _tcaS & _tcaN & "%" )
VAR _taA = ROUND ( ABS ( _atr ), 1 )
VAR _taN = FORMAT ( _taA, "0.0", "pt-BR" )
VAR _taS = IF ( ROUND ( _atr, 1 ) < 0, "−", "" )
VAR _taUn = IF ( _taA <= 1, " mês", " meses" )
VAR _taTxt = IF ( ISBLANK ( _atr ), "—", _taS & _taN & _taUn )
VAR _tkTxt = IF ( ISBLANK ( _pt ), "falta na base", FORMAT ( _pt, "0.0#", "pt-BR" ) & " de " & FORMAT ( _ps, "0.0#", "pt-BR" ) )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _tcKP = LEN ( _tcN ) > 0
VAR _tcKN = IF ( _tcKP, _tcN )
VAR _tcKS = SUBSTITUTE ( SUBSTITUTE ( _tcKN, ".", "" ), ",", "" )
VAR _tcKT = IFERROR ( VALUE ( _tcKS ), -1 )
VAR _tcKOk = _tcKP && _tcKT >= 2 && FORMAT ( _tcKT, REPT ( "0", LEN ( _tcKS ) ) ) = _tcKS
VAR _tcKD = IF ( CONTAINSSTRING ( _tcKN, "," ), LEN ( _tcKN ) - SEARCH ( ",", _tcKN ), 0 )
VAR _tcKM = IF ( CONTAINSSTRING ( _tcKN, "." ), "#,##0", "0" ) & IF ( _tcKD > 0, "." & REPT ( "0", _tcKD ) )
VAR _tcKOd =
    IF (
        _tcKOk,
        "<o-d><o-v>" & _tcKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tcKN, FORMAT ( ROUND ( _tcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcKD ), _tcKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tcN
    )
VAR _tcOd = IF ( ISBLANK ( _ppc ), _tcTxt, _tcS & _tcKOd & "%" )
VAR _tpmKP = LEN ( _tpmN ) > 0
VAR _tpmKN = IF ( _tpmKP, _tpmN )
VAR _tpmKS = SUBSTITUTE ( SUBSTITUTE ( _tpmKN, ".", "" ), ",", "" )
VAR _tpmKT = IFERROR ( VALUE ( _tpmKS ), -1 )
VAR _tpmKOk = _tpmKP && _tpmKT >= 2 && FORMAT ( _tpmKT, REPT ( "0", LEN ( _tpmKS ) ) ) = _tpmKS
VAR _tpmKD = IF ( CONTAINSSTRING ( _tpmKN, "," ), LEN ( _tpmKN ) - SEARCH ( ",", _tpmKN ), 0 )
VAR _tpmKM = IF ( CONTAINSSTRING ( _tpmKN, "." ), "#,##0", "0" ) & IF ( _tpmKD > 0, "." & REPT ( "0", _tpmKD ) )
VAR _tpmKOd =
    IF (
        _tpmKOk,
        "<o-d><o-v>" & _tpmKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tpmKN, FORMAT ( ROUND ( _tpmKT * [@odf] / 1000, 0 ) / POWER ( 10, _tpmKD ), _tpmKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tpmN
    )
VAR _tpmOd = IF ( ISBLANK ( _pm ), _tpmTxt, _tpmS & _tpmKOd & "%" )
VAR _temKP = LEN ( _temN ) > 0
VAR _temKN = IF ( _temKP, _temN )
VAR _temKS = SUBSTITUTE ( SUBSTITUTE ( _temKN, ".", "" ), ",", "" )
VAR _temKT = IFERROR ( VALUE ( _temKS ), -1 )
VAR _temKOk = _temKP && _temKT >= 2 && FORMAT ( _temKT, REPT ( "0", LEN ( _temKS ) ) ) = _temKS
VAR _temKD = IF ( CONTAINSSTRING ( _temKN, "," ), LEN ( _temKN ) - SEARCH ( ",", _temKN ), 0 )
VAR _temKM = IF ( CONTAINSSTRING ( _temKN, "." ), "#,##0", "0" ) & IF ( _temKD > 0, "." & REPT ( "0", _temKD ) )
VAR _temKOd =
    IF (
        _temKOk,
        "<o-d><o-v>" & _temKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _temKN, FORMAT ( ROUND ( _temKT * [@odf] / 1000, 0 ) / POWER ( 10, _temKD ), _temKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _temN
    )
VAR _temOd = IF ( ISBLANK ( _em ), _temTxt, _temS & _temKOd & "%" )
VAR _taKP = LEN ( _taN ) > 0
VAR _taKN = IF ( _taKP, _taN )
VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
VAR _taKOd =
    IF (
        _taKOk,
        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _taN
    )
VAR _taOd = IF ( ISBLANK ( _atr ), _taTxt, _taS & _taKOd & _taUn )
VAR _txtSob = "PPC MÊS A MÊS · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( _obra ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & IF ( ISBLANK ( _aba ), "", " · ABA " & _aba )
VAR _txtDir = "META " & _tmTxt
VAR _htmlPpc = IF ( ISBLANK ( _ppc ), "<b class='sp'>falta na base</b>", "<b>" & IF ( IF ( ISBLANK ( _pt ), "", IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( _pt ), "", IF ( _pt >= _ps, "0", IF ( _pt = 0, "2", "1" ) ) ) & "'></i>" ) & _tcOd & "</b>" )
VAR _htmlAtr = IF ( ISBLANK ( _atr ), "<b class='sp'>sem curva prevista</b>", "<b>" & IF ( IF ( ISBLANK ( _ptA ), "", IF ( _ptA >= _psA, "0", IF ( _ptA = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( _ptA ), "", IF ( _ptA >= _psA, "0", IF ( _ptA = 0, "2", "1" ) ) ) & "'></i>" ) & "<span class='" & IF ( _ptA = 0, "ng", "" ) & "'>" & _taOd & "</span></b>" )
VAR _htmlCol =
    "<div class='c3'><div><span class='vs'>PPC DO MÊS</span>" & _htmlPpc & "</div>"
        & "<div><span class='vs'>NA NOTA · ITEM PPC</span><b>" & "⁅" & _tkTxt & "⁆" & "</b></div>"
        & "<div><span class='vs'>ATRASO AO FIM DO MÊS</span>" & _htmlAtr & "</div></div>"
VAR _htmlRitmo =
    "<div class='li'>"
        & IF ( ISBLANK ( _pm ), "", "<span class='n'>Previsto</span><span class='v'>" & _tpmOd & "</span>" )
        & "<span class='n'>Executado</span><span class='v'>" & _temOd & "</span>"
        & IF ( ISBLANK ( _pm ), "<span class='d'>sem previsto na planilha</span>", "" )
    & "</div>"
VAR _txtAcum =
    IF (
        ISBLANK ( _pa ),
        "Acumulado ao fim de " & _mesN & ": " & "⁅" & _teaTxt & "⁆" & " executado; {SEM_P}.",
        "Acumulado ao fim de " & _mesN & ": " & "⁅" & _tpaTxt & "⁆" & " previsto × " & "⁅" & _teaTxt & "⁆" & " executado."
    )
VAR _verbo = IF ( ROUND ( _ppc, 2 ) > ROUND ( _ppcAnt, 2 ), "subiu", IF ( ROUND ( _ppc, 2 ) < ROUND ( _ppcAnt, 2 ), "caiu", "repetiu" ) )
VAR _txtDesde = "Era " & "⁅" & _tcaTxt & "⁆" & " em " & _mesAntN & ": o PPC " & _verbo & IF ( _ppc >= _meta, " e está na meta.", " e está abaixo da meta." )
VAR _temAnt = NOT ISBLANK ( _ppcAnt ) && NOT ISBLANK ( _ppc )
VAR _rotDesde = "DESDE " & UPPER ( _mesAntN )
-- 4 · Marcação
VAR _saidaHtml =
    IF (
        _noRecorte = 1,
        "<div class='u tt'>" & "<div class='cab'><p class='vs sob'>" & _txtSob & "</p><div class='tl'><div class='tit'>" & "<b>" & _mesL & "</b>" & "</div><p class='vs dir'>" & _txtDir & "</p></div></div>"
            & "<div class='corpo'>" & _htmlCol
            & "<div class='r3'></div><span class='vs'>RITMO DO MÊS · % DO ORÇAMENTO</span>" & _htmlRitmo
            & "<p class='l1'>" & _txtAcum & "</p>"
            & "</div>" & IF ( _temAnt, "<div class='rod'><div class='r3'></div><span class='vs'>" & _rotDesde & "</span><p class='l1'>" & _txtDesde & "</p></div>" )
        & "</div>" & [Comum · JS contador tooltip]
    )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
