/*
@pasta: T3 Avanço físico\Foco no mês\Contas
@formato: texto
@descricao: Aba da obra em foco no mês do eixo (MAIO26).
@oraculo: obras[].serie[].aba
@gerado: pbi/scripts/contas_t3.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    CALCULATE ( SELECTEDVALUE ( fAnaliseCritica[Aba] ), dObra[Obra] = _obra )
