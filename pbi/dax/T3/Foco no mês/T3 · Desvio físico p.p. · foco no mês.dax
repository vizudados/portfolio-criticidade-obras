/*
@pasta: T3 Avanço físico\Foco no mês\Contas
@formato: +0.00;-0.00;0.00
@descricao: [Físico · desvio acumulado p.p.] da obra em foco no mês do eixo (tooltips do mês).
@oraculo: obras[].serie[].indicadores.desvio_fisico_pp
@gerado: pbi/scripts/contas_t3.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    CALCULATE ( [Físico · desvio acumulado p.p.], dObra[Obra] = _obra )
