/*
@pasta: T3 Avanço físico\Obra em foco\Contas
@formato: dd/mm/yyyy
@descricao: Término previsto da obra em foco (cadastro).
@oraculo: obras[].termino_previsto
@gerado: pbi/scripts/contas_t3.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    LOOKUPVALUE ( dObra[TerminoPrevisto], dObra[Obra], _obra )
