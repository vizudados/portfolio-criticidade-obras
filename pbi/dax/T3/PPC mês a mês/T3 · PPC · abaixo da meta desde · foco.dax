/*
@pasta: T3 Avanço físico\PPC mês a mês\Contas
@formato: dd/mm/yyyy
@descricao: Primeiro mês da sequência atual de PPC abaixo da meta que chega ao mês de referência (vazio quando o PPC de referência está na meta).
@oraculo: dados/_gabarito/nota_previa.csv (x_ppc)
@gerado: pbi/scripts/contas_t3.py
*/
VAR _ref = [Mês de referência]
VAR _ini = [Série · primeiro mês]
VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@v", VAR _v = [Canteiro · PPC · foco no mês] RETURN IF ( NOT ISBLANK ( _v ), ROUND ( _v, 2 ) ) )
VAR _com = FILTER ( _meses, NOT ISBLANK ( [@v] ) )
VAR _meta = [Nota · limite PPC · ponto cheio]
VAR _ultimoOk = MAXX ( FILTER ( _com, [@v] >= _meta ), dMes[Mes] )
VAR _abaixo = FILTER ( _com, [@v] < _meta && ( ISBLANK ( _ultimoOk ) || dMes[Mes] > _ultimoOk ) )
RETURN
    IF ( MAXX ( FILTER ( _com, dMes[Mes] = _ref ), [@v] ) < _meta, MINX ( _abaixo, dMes[Mes] ) )
