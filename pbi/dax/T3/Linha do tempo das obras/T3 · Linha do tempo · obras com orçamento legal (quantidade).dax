/*
@pasta: T3 Avanço físico\Linha do tempo das obras\Contas
@formato: 0
@descricao: Quantas obras têm orçamento do tipo legal na aba do mês de referência (as da lista de legal). Ex. ago/26: 0. Obras com aba no mês de referência.
@oraculo: contagem de obras[].tipo_orcamento
@gerado: pbi/scripts/contas_t3.py
*/
VAR _obras =
    FILTER (
        ADDCOLUMNS (
            VALUES ( dObra[Obra] ),
            "@e", [Físico · executado acumulado · ref],
            "@d", [Físico · desvio acumulado p.p. · ref],
            "@ini", [Obra · início],
            "@fim", [Obra · término previsto],
            "@orc", [Orçamento · ref],
            "@tipo", [Tipo de orçamento · ref]
        ),
        NOT ISBLANK ( [@e] )
    )
RETURN
    COUNTROWS ( FILTER ( _obras, [@tipo] = "legal" ) ) + 0
