/*
@pasta: T3 Avanço físico\Linha do tempo das obras\Contas
@formato: 0
@descricao: Obras a iniciar no cadastro (cronograma).
@oraculo: len(proximas) = 4
@gerado: pbi/scripts/contas_t3.py
*/
VAR _aIniciar =
    CALCULATETABLE (
        ADDCOLUMNS (
            VALUES ( dObra[Obra] ),
            "@ini", [Obra · início],
            "@tipo", [T3 · Obra · tipo de orçamento cronograma]
        ),
        REMOVEFILTERS ( dObra[Obra] ),
        dObra[Situacao] = "A iniciar"
    )
RETURN
    COUNTROWS ( _aIniciar ) + 0
