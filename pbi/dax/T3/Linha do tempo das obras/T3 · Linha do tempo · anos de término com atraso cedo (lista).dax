/*
@pasta: T3 Avanço físico\Linha do tempo das obras\Contas
@formato: texto
@descricao: Anos de término das [T3 · Linha do tempo · obras com atraso cedo (lista)], sem repetir, separados por '|'.
@oraculo: 2028|2029
@gerado: pbi/scripts/contas_t3.py
*/
VAR _ref = [Mês de referência]
VAR _obras =
    FILTER (
        ADDCOLUMNS (
            VALUES ( dObra[Obra] ),
            "@e", [Físico · executado acumulado · ref],
            "@d", [Físico · desvio acumulado p.p. · ref],
            "@ini", [Obra · início],
            "@fim", [Obra · término previsto],
            "@orc", [Orçamento · ref],
            "@tipo", [Tipo de orçamento · ref]
        ),
        NOT ISBLANK ( [@e] )
    )
VAR _anos = DISTINCT ( SELECTCOLUMNS ( FILTER ( _obras, [@d] < 0 && [@fim] >= EDATE ( _ref, 24 ) ), "@a", YEAR ( [@fim] ) ) )
RETURN
    CONCATENATEX ( _anos, [@a], "|", [@a], ASC )
