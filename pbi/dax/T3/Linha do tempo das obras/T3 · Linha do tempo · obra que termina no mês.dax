/*
@pasta: T3 Avanço físico\Linha do tempo das obras\Contas
@formato: texto
@descricao: Obra em andamento cujo término previsto é o mês de referência (a de início mais antigo, se houver mais de uma).
@oraculo: obras[] com termino_previsto = mes_ref → PONTA NEGRA
@gerado: pbi/scripts/contas_t3.py
*/
VAR _ref = [Mês de referência]
VAR _obras =
    FILTER (
        ADDCOLUMNS (
            VALUES ( dObra[Obra] ),
            "@e", [Físico · executado acumulado · ref],
            "@d", [Físico · desvio acumulado p.p. · ref],
            "@ini", [Obra · início],
            "@fim", [Obra · término previsto],
            "@orc", [Orçamento · ref],
            "@tipo", [Tipo de orçamento · ref]
        ),
        NOT ISBLANK ( [@e] )
    )
RETURN
    MAXX ( TOPN ( 1, FILTER ( _obras, [@fim] = _ref ), [@ini], ASC, dObra[Obra], ASC ), dObra[Obra] )
