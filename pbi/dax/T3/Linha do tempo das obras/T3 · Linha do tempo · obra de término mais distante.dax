/*
@pasta: T3 Avanço físico\Linha do tempo das obras\Contas
@formato: texto
@descricao: Obra em andamento com o término previsto mais distante.
@oraculo: TIROL (jan/29)
@gerado: pbi/scripts/contas_t3.py
*/
VAR _obras =
    FILTER (
        ADDCOLUMNS (
            VALUES ( dObra[Obra] ),
            "@e", [Físico · executado acumulado · ref],
            "@d", [Físico · desvio acumulado p.p. · ref],
            "@ini", [Obra · início],
            "@fim", [Obra · término previsto],
            "@orc", [Orçamento · ref],
            "@tipo", [Tipo de orçamento · ref]
        ),
        NOT ISBLANK ( [@e] )
    )
VAR _top = TOPN ( 1, FILTER ( _obras, TRUE () ), [@fim], DESC, dObra[Obra], ASC )
RETURN
    MAXX ( _top, dObra[Obra] )
