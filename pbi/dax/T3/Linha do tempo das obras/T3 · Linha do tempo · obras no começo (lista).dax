/*
@pasta: T3 Avanço físico\Linha do tempo das obras\Contas
@formato: texto
@descricao: Obras mais novas que mal começaram: menos de 25% executado e início nos 12 meses antes do mês de referência, pelo início. Obras com aba no mês de referência, separadas por '|'.
@oraculo: JANGADA|TIROL
@gerado: pbi/scripts/contas_t3.py
*/
VAR _obras =
    FILTER (
        ADDCOLUMNS (
            VALUES ( dObra[Obra] ),
            "@e", [Físico · executado acumulado · ref],
            "@d", [Físico · desvio acumulado p.p. · ref],
            "@ini", [Obra · início],
            "@fim", [Obra · término previsto],
            "@orc", [Orçamento · ref],
            "@tipo", [Tipo de orçamento · ref]
        ),
        NOT ISBLANK ( [@e] )
    )
RETURN
    CONCATENATEX ( FILTER ( _obras, [@e] < 0.25 && [@ini] >= EDATE ( [Mês de referência], -12 ) ), dObra[Obra], "|", [@ini], ASC, dObra[Obra], ASC )
