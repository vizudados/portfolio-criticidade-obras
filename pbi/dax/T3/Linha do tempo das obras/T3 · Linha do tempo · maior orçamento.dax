/*
@pasta: T3 Avanço físico\Linha do tempo das obras\Contas
@formato: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
@descricao: Maior orçamento entre as obras em andamento (aba do mês de referência).
@oraculo: DUNAS 26.104.300
@gerado: pbi/scripts/contas_t3.py
*/
VAR _obras =
    FILTER (
        ADDCOLUMNS (
            VALUES ( dObra[Obra] ),
            "@e", [Físico · executado acumulado · ref],
            "@d", [Físico · desvio acumulado p.p. · ref],
            "@ini", [Obra · início],
            "@fim", [Obra · término previsto],
            "@orc", [Orçamento · ref],
            "@tipo", [Tipo de orçamento · ref]
        ),
        NOT ISBLANK ( [@e] )
    )
VAR _top = TOPN ( 1, FILTER ( _obras, TRUE () ), [@orc], DESC, dObra[Obra], ASC )
RETURN
    MAXX ( _top, [@orc] )
