[Comum · CSS base]
    & ".cs{position:fixed;inset:0}.cs svg{position:absolute;left:0;top:0;overflow:visible}.cs .ey{position:absolute;left:0;width:44px;text-align:right;font-size:13px;line-height:16px;colo"
    & "r:#6B6B70}.cs .ex{position:absolute;width:60px;text-align:center;font-size:13px;line-height:16px;color:#3B3B3F}.cs .ex.ref{font-weight:600;color:#0B0B0C}.cs .ex.sem{opacity:.5}.cs "
    & ".vz{position:absolute;left:64px;top:110px;font-size:14px;line-height:19px;color:#3B3B3F}.cs .fp{position:absolute;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-"
    & "size:14px;line-height:17px;color:#3B3B3F;white-space:nowrap}.cs .fe{position:absolute;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;line-height:17px;c"
    & "olor:#0B0B0C;white-space:nowrap}.cs .dv{position:absolute;height:17px;padding:0 4px;background:#FFFFFF;font-family:'Barlow U','Segoe UI',sans-serif;font-weight:600;font-size:14px;l"
    & "ine-height:17px;white-space:nowrap}.cs .rv{transform-box:fill-box;transform-origin:left center;animation:t3Rv 1s cubic-bezier(.2,.7,.2,1) backwards}.cs .rv.e{animation-delay:.25s}@"
    & "keyframes t3Rv{from{transform:scaleX(0)}}.cs .ar{animation:t3Fd .5s ease-out 1.1s backwards}.cs .pt{transform-box:fill-box;transform-origin:center;animation:cbPop .3s cubic-bezier("
    & ".2,.7,.2,1) backwards}.cs .fp,.cs .fe,.cs .dv,.cs .ch{animation:t3Fd .3s ease-out 1.1s backwards}@keyframes t3Fd{from{opacity:0}}"
