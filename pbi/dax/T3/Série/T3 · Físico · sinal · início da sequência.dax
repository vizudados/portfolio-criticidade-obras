/*
@pasta: T3 Avanço físico\Série\Contas
@formato: dd/mm/yyyy
@descricao: Primeiro mês da sequência, terminada na referência e dentro da janela, em que a obra ficou do mesmo lado do cronograma (atrás, no previsto ou à frente: [T3 · Físico · lado do cronograma]). 'Atrás desde fevereiro'.
@oraculo: sinal de obras[].serie[].indicadores.desvio_fisico_pp
@gerado: pbi/scripts/contas_t3.py
*/
VAR _ref = [Mês de referência]
VAR _jan = [Série · primeiro mês]
VAR _meses =
    ADDCOLUMNS (
        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
        "@d", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · desvio acumulado p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
    )
VAR _serie = ADDCOLUMNS ( FILTER ( _meses, NOT ISBLANK ( [@d] ) ), "@l", IF ( NOT ISBLANK ( [@d] ), SIGN ( ROUND ( [@d], 1 ) ) ) )
VAR _ladoRef = MAXX ( FILTER ( _serie, dMes[Mes] = _ref ), [@l] )
VAR _quebra = MAXX ( FILTER ( _serie, [@l] <> _ladoRef ), dMes[Mes] )
RETURN
    IF ( NOT ISBLANK ( _ladoRef ), MINX ( FILTER ( _serie, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] ) )
