/*
@pasta: T3 Avanço físico\Série\Contas
@formato: dd/mm/yyyy
@descricao: Primeiro mês da sequência, terminada na referência e dentro da janela, em que a obra ficou no status da nota de hoje ('crítica desde abril'); o mês pendente conta como um estado à parte, então passar de pendente a crítico abre uma sequência nova. Uma obra no contexto.
@oraculo: oráculo da nota (status e pendente, sequência)
@gerado: pbi/scripts/contas_t3.py
*/
VAR _ref = [Mês de referência]
VAR _hoje = CALCULATE ( IF ( [Nota · pendente · um mês] = 1, -1, [Nota · status · um mês] ), REMOVEFILTERS ( dMes ), dMes[Mes] = _ref )
VAR _jan = [Série · primeiro mês]
VAR _meses =
    ADDCOLUMNS (
        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
        "@s", VAR _m = dMes[Mes] RETURN CALCULATE ( IF ( [Nota · pendente · um mês] = 1, -1, [Nota · status · um mês] ), REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
    )
VAR _com = FILTER ( _meses, NOT ISBLANK ( [@s] ) )
VAR _quebra = MAXX ( FILTER ( _com, [@s] <> _hoje ), dMes[Mes] )
VAR _inicio = MINX ( FILTER ( _com, ISBLANK ( _quebra ) || dMes[Mes] > _quebra ), dMes[Mes] )
RETURN
    IF ( NOT ISBLANK ( _hoje ), _inicio )
