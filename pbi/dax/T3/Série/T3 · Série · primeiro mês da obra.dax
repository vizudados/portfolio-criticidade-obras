/*
@pasta: T3 Avanço físico\Série\Contas
@formato: dd/mm/yyyy
@descricao: Primeiro mês com aba da obra do contexto na janela (jan/26; jun/26 na TIROL; o primeiro mês da janela quando a obra já tinha aba antes dela).
@oraculo: obras[].serie[0].mes
@gerado: pbi/scripts/contas_t3.py
*/
VAR _ref = [Mês de referência]
VAR _jan = [Série · primeiro mês]
VAR _meses =
    ADDCOLUMNS (
        FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _jan && dMes[Mes] <= _ref ),
        "@e", VAR _m = dMes[Mes] RETURN CALCULATE ( [Físico · executado acumulado], REMOVEFILTERS ( dMes ), dMes[Mes] = _m )
    )
RETURN
    MINX ( FILTER ( _meses, NOT ISBLANK ( [@e] ) ), dMes[Mes] )
