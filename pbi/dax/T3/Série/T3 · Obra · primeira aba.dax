/*
@pasta: T3 Avanço físico\Série\Contas
@formato: dd/mm/yyyy
@descricao: Primeiro mês com aba da obra do contexto em todo o histórico até a referência (não depende da janela): é o 'PRIMEIRA ABA DA OBRA' do tooltip.
@oraculo: obras[].serie[0].mes
@gerado: pbi/scripts/contas_t3.py
*/
VAR _ref = [Mês de referência]
RETURN
    CALCULATE ( MIN ( fAnaliseCritica[Mes] ), REMOVEFILTERS ( dMes ), dMes[Mes] <= _ref )
