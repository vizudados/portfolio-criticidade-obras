/*
@pasta: T3 Avanço físico\Leituras
@formato: texto
@descricao: Leitura do "?" do PPC mês a mês, sobre o próprio painel (L065, mesma geometria da antiga leitura do Ritmo): achado com o PPC do mês de referência diante da meta e os pontos do item, explicação (quantos meses da janela chegaram à meta, desde quando está abaixo, o atraso em meses de hoje) e três destaques: o melhor e o mais fraco mês da janela e a média das obras no mês. Sem PPC na base: achado que diz a falta. Só lê contas.
@gerado: pbi/scripts/leituras_t3.py
*/
-- 1 · Leituras
VAR _obra = [Nota · obra em foco]
VAR _mesL = [Mês de referência · longo]
VAR _mesN = [Mês de referência · nome]
VAR _ref = [Mês de referência]
VAR _jan = [Série · primeiro mês]
VAR _ppc = [Canteiro · PPC · foco]
VAR _pt = [Nota · pontos PPC · foco]
VAR _ps = [Nota · possíveis · PPC · foco]
VAR _meta = [Nota · limite PPC · ponto cheio]
VAR _nCom = [T3 · PPC · meses com PPC · foco]
VAR _nMeta = [T3 · PPC · meses na meta · foco]
VAR _desde = [T3 · PPC · abaixo da meta desde · foco]
VAR _vMax = [T3 · PPC · maior na janela · foco]
VAR _mMax = [T3 · PPC · mês do maior · foco]
VAR _vMin = [T3 · PPC · menor na janela · foco]
VAR _mMin = [T3 · PPC · mês do menor · foco]
VAR _media = [T3 · PPC · média das obras · ref]
VAR _atr = [Prazo · atraso (meses) · foco]
-- 2 · Textos
VAR _tcN = FORMAT ( ABS ( _ppc ) * 100, "0", "pt-BR" )
VAR _tcS = IF ( ROUND ( _ppc * 100, 0 ) < 0, "−", "" )
VAR _tcTxt = IF ( ISBLANK ( _ppc ), "—", _tcS & _tcN & "%" )
VAR _tmN = FORMAT ( ABS ( _meta ) * 100, "0", "pt-BR" )
VAR _tmS = IF ( ROUND ( _meta * 100, 0 ) < 0, "−", "" )
VAR _tmTxt = IF ( ISBLANK ( _meta ), "—", _tmS & _tmN & "%" )
VAR _tmxN = FORMAT ( ABS ( _vMax ) * 100, "0", "pt-BR" )
VAR _tmxS = IF ( ROUND ( _vMax * 100, 0 ) < 0, "−", "" )
VAR _tmxTxt = IF ( ISBLANK ( _vMax ), "—", _tmxS & _tmxN & "%" )
VAR _tmiN = FORMAT ( ABS ( _vMin ) * 100, "0", "pt-BR" )
VAR _tmiS = IF ( ROUND ( _vMin * 100, 0 ) < 0, "−", "" )
VAR _tmiTxt = IF ( ISBLANK ( _vMin ), "—", _tmiS & _tmiN & "%" )
VAR _tmdN = FORMAT ( ABS ( _media ) * 100, "0", "pt-BR" )
VAR _tmdS = IF ( ROUND ( _media * 100, 0 ) < 0, "−", "" )
VAR _tmdTxt = IF ( ISBLANK ( _media ), "—", _tmdS & _tmdN & "%" )
VAR _tkTxt = "⁅" & FORMAT ( _pt, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _ps, "0.0#", "pt-BR" ) & "⁆"
VAR _atA = ROUND ( ABS ( _atr ), 1 )
VAR _txtAtr = "⁅" & FORMAT ( _atA, "0.0", "pt-BR" ) & "⁆" & IF ( _atA <= 1, " mês", " meses" )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _tcKP = LEN ( _tcN ) > 0
VAR _tcKN = IF ( _tcKP, _tcN )
VAR _tcKS = SUBSTITUTE ( SUBSTITUTE ( _tcKN, ".", "" ), ",", "" )
VAR _tcKT = IFERROR ( VALUE ( _tcKS ), -1 )
VAR _tcKOk = _tcKP && _tcKT >= 2 && FORMAT ( _tcKT, REPT ( "0", LEN ( _tcKS ) ) ) = _tcKS
VAR _tcKD = IF ( CONTAINSSTRING ( _tcKN, "," ), LEN ( _tcKN ) - SEARCH ( ",", _tcKN ), 0 )
VAR _tcKM = IF ( CONTAINSSTRING ( _tcKN, "." ), "#,##0", "0" ) & IF ( _tcKD > 0, "." & REPT ( "0", _tcKD ) )
VAR _tcKOd =
    IF (
        _tcKOk,
        "<o-d><o-v>" & _tcKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tcKN, FORMAT ( ROUND ( _tcKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcKD ), _tcKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tcN
    )
VAR _tcOd = IF ( ISBLANK ( _ppc ), _tcTxt, _tcS & _tcKOd & "%" )
VAR _tmxKP = LEN ( _tmxN ) > 0
VAR _tmxKN = IF ( _tmxKP, _tmxN )
VAR _tmxKS = SUBSTITUTE ( SUBSTITUTE ( _tmxKN, ".", "" ), ",", "" )
VAR _tmxKT = IFERROR ( VALUE ( _tmxKS ), -1 )
VAR _tmxKOk = _tmxKP && _tmxKT >= 2 && FORMAT ( _tmxKT, REPT ( "0", LEN ( _tmxKS ) ) ) = _tmxKS
VAR _tmxKD = IF ( CONTAINSSTRING ( _tmxKN, "," ), LEN ( _tmxKN ) - SEARCH ( ",", _tmxKN ), 0 )
VAR _tmxKM = IF ( CONTAINSSTRING ( _tmxKN, "." ), "#,##0", "0" ) & IF ( _tmxKD > 0, "." & REPT ( "0", _tmxKD ) )
VAR _tmxKOd =
    IF (
        _tmxKOk,
        "<o-d><o-v>" & _tmxKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tmxKN, FORMAT ( ROUND ( _tmxKT * [@odf] / 1000, 0 ) / POWER ( 10, _tmxKD ), _tmxKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tmxN
    )
VAR _tmxOd = IF ( ISBLANK ( _vMax ), _tmxTxt, _tmxS & _tmxKOd & "%" )
VAR _tmiKP = LEN ( _tmiN ) > 0
VAR _tmiKN = IF ( _tmiKP, _tmiN )
VAR _tmiKS = SUBSTITUTE ( SUBSTITUTE ( _tmiKN, ".", "" ), ",", "" )
VAR _tmiKT = IFERROR ( VALUE ( _tmiKS ), -1 )
VAR _tmiKOk = _tmiKP && _tmiKT >= 2 && FORMAT ( _tmiKT, REPT ( "0", LEN ( _tmiKS ) ) ) = _tmiKS
VAR _tmiKD = IF ( CONTAINSSTRING ( _tmiKN, "," ), LEN ( _tmiKN ) - SEARCH ( ",", _tmiKN ), 0 )
VAR _tmiKM = IF ( CONTAINSSTRING ( _tmiKN, "." ), "#,##0", "0" ) & IF ( _tmiKD > 0, "." & REPT ( "0", _tmiKD ) )
VAR _tmiKOd =
    IF (
        _tmiKOk,
        "<o-d><o-v>" & _tmiKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tmiKN, FORMAT ( ROUND ( _tmiKT * [@odf] / 1000, 0 ) / POWER ( 10, _tmiKD ), _tmiKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tmiN
    )
VAR _tmiOd = IF ( ISBLANK ( _vMin ), _tmiTxt, _tmiS & _tmiKOd & "%" )
VAR _tmdKP = LEN ( _tmdN ) > 0
VAR _tmdKN = IF ( _tmdKP, _tmdN )
VAR _tmdKS = SUBSTITUTE ( SUBSTITUTE ( _tmdKN, ".", "" ), ",", "" )
VAR _tmdKT = IFERROR ( VALUE ( _tmdKS ), -1 )
VAR _tmdKOk = _tmdKP && _tmdKT >= 2 && FORMAT ( _tmdKT, REPT ( "0", LEN ( _tmdKS ) ) ) = _tmdKS
VAR _tmdKD = IF ( CONTAINSSTRING ( _tmdKN, "," ), LEN ( _tmdKN ) - SEARCH ( ",", _tmdKN ), 0 )
VAR _tmdKM = IF ( CONTAINSSTRING ( _tmdKN, "." ), "#,##0", "0" ) & IF ( _tmdKD > 0, "." & REPT ( "0", _tmdKD ) )
VAR _tmdKOd =
    IF (
        _tmdKOk,
        "<o-d><o-v>" & _tmdKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tmdKN, FORMAT ( ROUND ( _tmdKT * [@odf] / 1000, 0 ) / POWER ( 10, _tmdKD ), _tmdKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tmdN
    )
VAR _tmdOd = IF ( ISBLANK ( _media ), _tmdTxt, _tmdS & _tmdKOd & "%" )
VAR _txtSob = "LEITURA · PPC MÊS A MÊS · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( _obra ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " · " & UPPER ( _mesL )
VAR _naMeta = ROUND ( _ppc, 2 ) >= _meta
VAR _achado =
    "Em " & _mesN & " a " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & " cumpriu " & _tcOd & " do plano semanal"
        & IF ( _naMeta, ", na meta de " & "⁅" & _tmTxt & "⁆" & ": o ponto cheio do PPC na nota.",
            ", abaixo da meta de " & "⁅" & _tmTxt & "⁆" & "; na nota, o PPC vale " & _tkTxt & "." )
VAR _txtMeses =
    SWITCH (
        TRUE (),
        _nCom <= 1, "",
        _nMeta = _nCom, "Todos os " & SWITCH ( _nCom, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nCom, "0" ) ) & " meses da janela chegaram à meta",
        _nMeta = 0, "Nenhum dos " & SWITCH ( _nCom, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nCom, "0" ) ) & " meses da janela chegou à meta",
        UPPER ( LEFT ( SWITCH ( _nMeta, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nMeta, "0" ) ), 1 ) ) & MID ( SWITCH ( _nMeta, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nMeta, "0" ) ), 2, 1000 ) & " dos " & SWITCH ( _nCom, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nCom, "0" ) ) & IF ( _nMeta = 1, " meses da janela chegou à meta", " meses da janela chegaram à meta" )
    )
VAR _txtDesde = IF ( ISBLANK ( _desde ) || _desde = _ref, "", "; está abaixo dela desde " & IF ( _desde = _jan || YEAR ( _desde ) <> YEAR ( _ref ), FORMAT ( _desde, "mmm/yy", "pt-BR" ), FORMAT ( _desde, "mmmm", "pt-BR" ) ) )
VAR _txtAtraso =
    IF (
        ISBLANK ( _atr ),
        "",
        " O PPC mede a semana; quando cai por vários meses, o atraso em meses vem depois. Hoje a obra está "
            & IF ( ROUND ( _atr, 1 ) < 0, _txtAtr & " à frente do cronograma.", "com " & _txtAtr & " de atraso." )
    )
VAR _explica = IF ( _txtMeses = "", "", _txtMeses & _txtDesde & "." ) & _txtAtraso
VAR _rotD1 = "o melhor mês, " & FORMAT ( _mMax, "mmmm", "pt-BR" )
VAR _rotD2 = "o mês mais fraco, " & FORMAT ( _mMin, "mmmm", "pt-BR" )
VAR _rotD3 = "a média das obras em " & _mesN
-- 4 · Marcação
VAR _corpo =
    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _achado & "</h2>"
        & IF ( TRIM ( _explica ) = "", "", "<p class='exp'>" & TRIM ( _explica ) & "</p>" )
        & "<div class='dst sobre-creme'>" & "<div><b>" & _tmxOd & "</b><span>" & _rotD1 & "</span></div>" & "<div><b>" & _tmiOd & "</b><span>" & _rotD2 & "</span></div>" & "<div><b>" & _tmdOd & "</b><span>" & _rotD3 & "</span></div>" & "</div>"
VAR _semBase =
    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>A base complementar de " & _mesN
        & " não traz o PPC da " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obra, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & ": o item fica pendente na nota.</h2>"
VAR _saidaHtml =
    "<div class='u lv' role='dialog' aria-label='" & "Leitura do PPC mês a mês" & "'><div class='pn pn-p'>" & IF ( ISBLANK ( _ppc ), _semBase, _corpo ) & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip]
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
