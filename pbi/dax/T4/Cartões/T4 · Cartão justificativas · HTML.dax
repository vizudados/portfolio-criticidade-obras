/*
@pasta: T4 Resultado no tempo\Cartões
@formato: texto
@descricao: Cartão 'Justificativas do mês': preenchidas entre as exigidas (desvio do desembolso acima de ±10%) e, numa linha só, quais obras deixaram em branco (do maior para o menor |desvio|, sem cortar nome: todas, as 2 primeiras e 'e mais M', ou nenhuma, com 'todas em branco' / 'N em branco'). Só lê contas · ref.
@gerado: pbi/scripts/desenho_t4.py
*/
-- 1 · Leituras
VAR _ex = [Carteira · justificativas exigidas · ref]
VAR _pre = [Carteira · justificativas preenchidas · ref]
VAR _br = [Carteira · justificativas em branco · ref]
VAR _lista = [Recorte · justificativas em branco (lista) · ref]
VAR _fora = [Recorte · justificativas em branco fora da lista curta · ref]
-- 2 · Textos
VAR _e = _ex + 0
VAR _p = _pre + 0
VAR _b = _br + 0
VAR _tjN = FORMAT ( _p, "#,0", "pt-BR" )
VAR _tjTxt = IF ( ISBLANK ( _p ), "0", _tjN )
VAR _txtLado = IF ( _e = 0, "exigidas", "de " & "⁅" & _e & "⁆" & IF ( _e = 1, " exigida", " exigidas" ) )
VAR _pxCtx = 241 -- geometria
/* nomes em branco numa linha só, sem cortar nome: todos; senão os 2 primeiros e 'e mais M'; senão nenhum (justificativas_rodape.py) */
VAR _nbN = IF ( ISBLANK ( _lista ) || _lista = "", 0, PATHLENGTH ( _lista ) )
VAR _nbPos = IF ( _nbN >= 2, FIND ( "§", SUBSTITUTE ( _lista, "|", "§", _nbN - 1 ) ) )
VAR _nbTodos =
    IF (
        _nbN <= 1,
        _lista,
        SUBSTITUTE ( LEFT ( _lista, _nbPos - 1 ), "|", ", " ) & " e " & MID ( _lista, _nbPos + 1, 999 )
    )
VAR _nbCorte = FIND ( "§", SUBSTITUTE ( _lista & "|", "|", "§", 2 ), 1, LEN ( _lista ) + 1 )
VAR _nbPrimeiros = LEFT ( _lista, _nbCorte - 1 )
VAR _nbResto = IF ( _fora = _p, IF ( _fora = 1, " e outra", " e outras" ), " e mais " & _fora )
VAR _nbSemTodos = SUBSTITUTE ( _lista, "|", "" )
VAR _nbSemPrimeiros = SUBSTITUTE ( _nbPrimeiros, "|", "" )
VAR _nbPxNomesTodosCar = GENERATESERIES ( 1, LEN ( _nbSemTodos ) + 0 )
VAR _nbPxNomesTodos =
    SUMX ( _nbPxNomesTodosCar, /* lista */ -- geometria
        SWITCH (
            MID ( _nbSemTodos, [Value], 1 ),
            " ", 3.6, "A", 8.4, "B", 7.5, "C", 7.8, "D", 9.2, "E", 6.6, "F", 6.4, "G", 9.0, "H", 9.3, "I", 3.5,
            "J", 4.2, "K", 7.6, "L", 6.2, "M", 11.7, "N", 9.8, "O", 9.8, "P", 7.3, "Q", 9.8, "R", 7.8, "S", 7.0,
            "T", 7.1, "U", 9.0, "V", 8.1, "W", 12.2, "X", 7.7, "Y", 7.2, "Z", 7.5, "Á", 8.4, "Ã", 8.4, "Â", 8.4,
            "À", 8.4, "É", 6.6, "Ê", 6.6, "Í", 3.5, "Ó", 9.8, "Õ", 9.8, "Ô", 9.8, "Ú", 9.0, "Ç", 7.8,
            8
        )
    )
VAR _nbPxNomesPrimeirosCar = GENERATESERIES ( 1, LEN ( _nbSemPrimeiros ) + 0 )
VAR _nbPxNomesPrimeiros =
    SUMX ( _nbPxNomesPrimeirosCar, /* lista */ -- geometria
        SWITCH (
            MID ( _nbSemPrimeiros, [Value], 1 ),
            " ", 3.6, "A", 8.4, "B", 7.5, "C", 7.8, "D", 9.2, "E", 6.6, "F", 6.4, "G", 9.0, "H", 9.3, "I", 3.5,
            "J", 4.2, "K", 7.6, "L", 6.2, "M", 11.7, "N", 9.8, "O", 9.8, "P", 7.3, "Q", 9.8, "R", 7.8, "S", 7.0,
            "T", 7.1, "U", 9.0, "V", 8.1, "W", 12.2, "X", 7.7, "Y", 7.2, "Z", 7.5, "Á", 8.4, "Ã", 8.4, "Â", 8.4,
            "À", 8.4, "É", 6.6, "Ê", 6.6, "Í", 3.5, "Ó", 9.8, "Õ", 9.8, "Ô", 9.8, "Ú", 9.0, "Ç", 7.8,
            8
        )
    )
VAR _nbPxTodos = ROUND ( _nbPxNomesTodos + 7 * MAX ( _nbN - 2, 0 ) + IF ( _nbN >= 2, 14, 0 ), 0 ) -- geometria
VAR _nbPxResto =
    SWITCH (
        TRUE (),
        _fora <> _p, 51 + 7 * ( LEN ( _fora & "" ) - 1 ), -- geometria
        _fora = 1, 41,
        50
    )
VAR _nbPxPrimeiros = ROUND ( _nbPxNomesPrimeiros + 7 * 1 + _nbPxResto, 0 ) -- geometria
VAR _nbPxCabe = ROUND ( _pxCtx, 0 ) - 68 -- geometria
VAR _nbTxt =
    SWITCH (
        TRUE (),
        _b = 0, "nenhuma em branco",
        _nbPxTodos <= _nbPxCabe, "em branco: " & _nbTodos,
        _nbN > 2 && _nbPxPrimeiros <= _nbPxCabe,
            "em branco: " & SUBSTITUTE ( _nbPrimeiros, "|", ", " ) & _nbResto,
        _p = 0, "todas em branco",
        _b = _p, "as outras em branco",
        _b & " em branco"
    )
VAR _txtCtx =
    SWITCH (
        TRUE (),
        _e = 0, "nenhuma exigida: tudo dentro de ±10%",
        _b = 0, "todas as exigidas preenchidas",
        "⁅" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nbTxt, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "⁆"
    )
VAR _txtRegra = "Obras acima de ±10% no mês (exigida) e quantas preencheram o campo; nomes do maior ao menor desvio."
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _tjKP = LEN ( _tjN ) > 0
VAR _tjKN = IF ( _tjKP, _tjN )
VAR _tjKS = SUBSTITUTE ( SUBSTITUTE ( _tjKN, ".", "" ), ",", "" )
VAR _tjKT = IFERROR ( VALUE ( _tjKS ), -1 )
VAR _tjKOk = _tjKP && _tjKT >= 2 && FORMAT ( _tjKT, REPT ( "0", LEN ( _tjKS ) ) ) = _tjKS
VAR _tjKD = IF ( CONTAINSSTRING ( _tjKN, "," ), LEN ( _tjKN ) - SEARCH ( ",", _tjKN ), 0 )
VAR _tjKM = IF ( CONTAINSSTRING ( _tjKN, "." ), "#,##0", "0" ) & IF ( _tjKD > 0, "." & REPT ( "0", _tjKD ) )
VAR _tjKOd =
    IF (
        _tjKOk,
        "<o-d><o-v>" & _tjKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tjKN, FORMAT ( ROUND ( _tjKT * [@odf] / 1000, 0 ) / POWER ( 10, _tjKD ), _tjKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tjN
    )
VAR _tjOd = IF ( ISBLANK ( _p ), _tjTxt, _tjKOd )
-- 4 · Marcação
VAR _saidaHtml =
    "<div class='u kc' tabindex='0'>"
        & "<div class='lado frente'>"
            & "<p class='ab vs eb'>" & "Justificativas do mês" & "</p>"
            & "<div class='linha1'><span class='b6 hero" & "" & "'>" & _tjOd & "</span>" & "<span class='b5 lado2" & "" & "'>" & _txtLado & "</span>" & "</div>"
            & "<p class='ctx'>" & _txtCtx & "</p>"
        & "</div>"
        & "<div class='lado verso sobre-creme'>"
            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
            & "<p class='regra'>" & _txtRegra & "</p>"
            & "<div class='ond' style='top:106px'><span class='vs'>DE ONDE VEM</span><span>Justificativa, cada aba</span></div>"
        & "</div>"
    & "</div>" & [Comum · JS contador]
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
