/*
@pasta: T4 Resultado no tempo\Desembolso da carteira\Contas
@formato: 0.00%
@descricao: [T4 · Desembolso · desvio no mês · com previsto] no mês de referência (seletor do drawer; sem escolha, o último mês).
@oraculo: ago/26 real: 0%
@gerado: pbi/scripts/contas_t4.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [T4 · Desembolso · desvio no mês · com previsto], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
