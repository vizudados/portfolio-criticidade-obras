/*
@pasta: T4 Resultado no tempo\Leituras\Contas
@formato: 0
@descricao: Meses da janela, até o de referência, em que a variação do resultado aplicado da carteira (só as obras com aba no mês e na anterior) ficou negativa.
@oraculo: carteira.serie[m].resultado < serie[m−1] mistura obras (mockup: 5 de 5 em jun/26); com as mesmas obras, jun/26: 3 de 5
@gerado: pbi/scripts/contas_t4.py
*/
VAR _ref = [Mês de referência]
VAR _ini = [Série · primeiro mês]
VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] > _ini && dMes[Mes] <= _ref ), "@v", [T4 · Resultado aplicado · variação no mês] )
RETURN
    COUNTROWS ( FILTER ( _meses, NOT ISBLANK ( [@v] ) && [@v] < 0 ) ) + 0
