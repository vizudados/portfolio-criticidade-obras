/*
@pasta: T4 Resultado no tempo\Leituras\Contas
@formato: 0.00%
@descricao: [Resultado aplicado %] no primeiro mês com aba do recorte, até o de referência.
@oraculo: resultado aplicado % da carteira no primeiro mês da janela
@gerado: pbi/scripts/contas_t4.py
*/
VAR _ini = [T4 · Primeiro mês com aba]
RETURN
    CALCULATE ( [Resultado aplicado %], REMOVEFILTERS ( dMes ), dMes[Mes] = _ini )
