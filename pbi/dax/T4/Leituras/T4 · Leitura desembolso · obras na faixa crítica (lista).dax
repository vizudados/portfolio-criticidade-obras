/*
@pasta: T4 Resultado no tempo\Leituras\Contas
@formato: texto
@descricao: Obras do recorte na faixa crítica da previsão de caixa da nota (sem ponto: o desembolso fugiu do previsto para mais ou para menos) no mês de referência, da mais para a menos crítica ([T1 · Obras · posição]), separadas por '|'.
@oraculo: ago/26 (teste): JANGADA|POTENGI (−31% e −21%)
@gerado: pbi/scripts/contas_t4.py
*/
VAR _mes = [Mês de referência]
VAR _obras = CALCULATETABLE (
        ADDCOLUMNS (
            FILTER ( VALUES ( dObra[Obra] ), [Obras com análise] > 0 ),
            "@s", [T4 · Desembolso · faixa do fluxo de caixa],
            "@pos", [T1 · Obras · posição]
        ),
        REMOVEFILTERS ( dMes ),
        dMes[Mes] = _mes
    )
RETURN
    CONCATENATEX ( FILTER ( _obras, [@s] = 2 ), dObra[Obra], "|", [@pos], ASC )
