/*
@pasta: T4 Resultado no tempo\Leituras\Contas
@formato: texto
@descricao: Obras do recorte com resultado aplicado negativo no mês de referência, da mais para a menos crítica ([T1 · Obras · posição]: mais pontos perdidos na nota primeiro), separadas por '|'.
@oraculo: ago/26 (teste): REDINHA|DUNAS|JANGADA (a ordem da posição)
@gerado: pbi/scripts/contas_t4.py
*/
VAR _mes = [Mês de referência]
VAR _obras = CALCULATETABLE (
        ADDCOLUMNS (
            FILTER ( VALUES ( dObra[Obra] ), [Obras com análise] > 0 ),
            "@r", [Resultado aplicado],
            "@pos", [T1 · Obras · posição]
        ),
        REMOVEFILTERS ( dMes ),
        dMes[Mes] = _mes
    )
RETURN
    CONCATENATEX ( FILTER ( _obras, [@r] < 0 ), dObra[Obra], "|", [@pos], ASC )
