/*
@pasta: T4 Resultado no tempo\Tooltips\Contas
@formato: dd/mm/yyyy
@descricao: Último mês com aba da obra nos meses da janela anteriores aos 6 mais recentes (a linha de resumo do tooltip da obra do desembolso); vazio ou zero quando a janela tem 6 meses ou menos.
@oraculo: fev/26
@gerado: pbi/scripts/contas_t4.py
*/
VAR _ref = [Mês de referência]
VAR _ini = [Série · primeiro mês]
VAR _corte = EDATE ( _ref, -5 )
VAR _meses =
    FILTER (
        ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] < _corte ), "@tem", [Obras com análise] ),
        [@tem] > 0
    )
RETURN
    MAXX ( _meses, dMes[Mes] )
