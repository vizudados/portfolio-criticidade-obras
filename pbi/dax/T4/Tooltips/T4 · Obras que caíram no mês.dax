/*
@pasta: T4 Resultado no tempo\Tooltips\Contas
@formato: 0
@descricao: Obras do recorte com resultado aplicado (R$) menor que o do mês anterior, no mês do contexto.
@oraculo: sinal do resultado aplicado − o do mês anterior (contagem no mês)
@gerado: pbi/scripts/contas_t4.py
*/
VAR _obras = ADDCOLUMNS ( VALUES ( fAnaliseCritica[Obra] ), "@v", [T4 · Resultado aplicado · variação no mês] )
RETURN
    COUNTROWS ( FILTER ( _obras, [@v] < 0 ) ) + 0
