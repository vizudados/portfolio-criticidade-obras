/*
@pasta: T4 Resultado no tempo\Tooltips
@formato: texto
@descricao: Tooltip de página do mês (coluna de Resultado da carteira, mês a mês): o resultado aplicado de cada obra no mês, do maior ao menor (marca do status da obra na nota, tracejada quando pendente; barra divergente de zero comum, R$ e % do orçamento), o que ainda vai se realizar (a distância até o traço da planilha) contra o mês anterior e, fora do primeiro mês, quantas obras caíram ou subiram no aplicado (F3). Até 10 obras, todas aparecem; de 11 em diante, as 9 de maior peso e 'e mais N obras'.
@gerado: pbi/scripts/tooltips_t4.py
*/
-- 1 · Leituras
VAR _mesC = UPPER ( [Mês · rótulo curto] )
VAR _mesL = [Mês · longo]
VAR _mesAnt = [Mês anterior · nome]
VAR _n = [Obras com análise] + 0
VAR _primeiro = [Mês · é o primeiro do histórico] = 1
VAR _ativ = [A realizar]
VAR _ativAnt = [T4 · A realizar · mês anterior]
VAR _nC = [T4 · Obras que caíram no mês]
VAR _nS = [T4 · Obras que subiram no mês]
VAR _m = [T4 · Obras comparáveis no mês]
VAR _listaS = [T4 · Obras que subiram no mês (lista)]
VAR _listaC = [T4 · Obras que caíram no mês (lista)]
VAR _mais = [T4 · Tooltip mês · obras fora da lista]
VAR _obras =
    ADDCOLUMNS (
        VALUES ( dObra[Obra] ),
        "@r", [Resultado aplicado],
        "@p", [Resultado aplicado %],
        "@st", [Nota · status · um mês],
        "@pend", [Nota · pendente · um mês],
        "@selo", [Obra · selo]
    )
VAR _comAba = FILTER ( _obras, NOT ISBLANK ( [@r] ) ) /* geometria */
/* passou de 10 obras: as 9 de maior peso no mês (|R$|), na ordem de sempre, e a linha 'e mais N obras' */
VAR _mostra = TOPN ( IF ( _mais > 0, 9, 10 ), _comAba, ABS ( [@r] ), DESC, dObra[Obra], ASC ) /* geometria */
-- 2 · Textos
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _taA = ABS ( _ativ )
VAR _taNu = SWITCH ( TRUE (), _taA >= 99950000, FORMAT ( _taA / 1000000, "0.0", "pt-BR" ), _taA >= 999500, FORMAT ( _taA / 1000000, "0.00", "pt-BR" ), _taA >= 999.5, FORMAT ( _taA / 1000, "0", "pt-BR" ), FORMAT ( _taA, "#,0", "pt-BR" ) )
VAR _taUn = SWITCH ( TRUE (), _taA >= 999500, " mi", _taA >= 999.5, " mil", "" )
VAR _taN = _taNu & _taUn
VAR _taZero = _taN = "0"
VAR _taS = IF ( _taZero, "", IF ( _ativ < 0, "−", "" ) )
VAR _taTxt = IF ( ISBLANK ( _ativ ), "—", _taS & "R$ " & _taN )
VAR _taaA = ABS ( _ativAnt )
VAR _taaNu = SWITCH ( TRUE (), _taaA >= 99950000, FORMAT ( _taaA / 1000000, "0.0", "pt-BR" ), _taaA >= 999500, FORMAT ( _taaA / 1000000, "0.00", "pt-BR" ), _taaA >= 999.5, FORMAT ( _taaA / 1000, "0", "pt-BR" ), FORMAT ( _taaA, "#,0", "pt-BR" ) )
VAR _taaUn = SWITCH ( TRUE (), _taaA >= 999500, " mi", _taaA >= 999.5, " mil", "" )
VAR _taaN = _taaNu & _taaUn
VAR _taaZero = _taaN = "0"
VAR _taaS = IF ( _taaZero, "", IF ( _ativAnt < 0, "−", "" ) )
VAR _taaTxt = IF ( ISBLANK ( _ativAnt ), "—", _taaS & "R$ " & _taaN )
VAR _taKP = LEN ( _taNu ) > 0
VAR _taKN = IF ( _taKP, _taNu )
VAR _taKS = SUBSTITUTE ( SUBSTITUTE ( _taKN, ".", "" ), ",", "" )
VAR _taKT = IFERROR ( VALUE ( _taKS ), -1 )
VAR _taKOk = _taKP && _taKT >= 2 && FORMAT ( _taKT, REPT ( "0", LEN ( _taKS ) ) ) = _taKS
VAR _taKD = IF ( CONTAINSSTRING ( _taKN, "," ), LEN ( _taKN ) - SEARCH ( ",", _taKN ), 0 )
VAR _taKM = IF ( CONTAINSSTRING ( _taKN, "." ), "#,##0", "0" ) & IF ( _taKD > 0, "." & REPT ( "0", _taKD ) )
VAR _taKOd =
    IF (
        _taKOk,
        "<o-d><o-v>" & _taKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _taKN, FORMAT ( ROUND ( _taKT * [@odf] / 1000, 0 ) / POWER ( 10, _taKD ), _taKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _taNu
    )
VAR _taOd = IF ( ISBLANK ( _ativ ), _taTxt, _taS & "R$ " & _taKOd & _taUn )
VAR _lsN = IF ( ISBLANK ( _listaS ) || _listaS = "", 0, PATHLENGTH ( _listaS ) )
VAR _lsPos = IF ( _lsN >= 2, FIND ( "§", SUBSTITUTE ( _listaS, "|", "§", _lsN - 1 ) ) )
VAR _lsTxt = SWITCH ( TRUE (), _lsN = 0, "", _lsN = 1, _listaS, SUBSTITUTE ( LEFT ( _listaS, _lsPos - 1 ), "|", ", " ) & " e " & MID ( _listaS, _lsPos + 1, 999 ) )
VAR _lcN = IF ( ISBLANK ( _listaC ) || _listaC = "", 0, PATHLENGTH ( _listaC ) )
VAR _lcPos = IF ( _lcN >= 2, FIND ( "§", SUBSTITUTE ( _listaC, "|", "§", _lcN - 1 ) ) )
VAR _lcTxt = SWITCH ( TRUE (), _lcN = 0, "", _lcN = 1, _listaC, SUBSTITUTE ( LEFT ( _listaC, _lcPos - 1 ), "|", ", " ) & " e " & MID ( _listaC, _lcPos + 1, 999 ) )
VAR _txtSob = IF ( _primeiro, "RESULTADO MÊS A MÊS · " & _mesC & " · PRIMEIRO MÊS DO HISTÓRICO", "RESULTADO DA CARTEIRA, MÊS A MÊS · " & _mesC )
VAR _txtAtivAnt = IF ( ISBLANK ( _ativAnt ), "sem mês anterior", _mesAnt & " " & "⁅" & _taaTxt & "⁆" )
VAR _txtRod =
    SWITCH (
        TRUE (),
        _primeiro || _m = 0, "",
        _nC = _m, "Caiu em todas as " & SWITCH ( _m, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _m, "0" ) ) & " obras desde " & _mesAnt & ".",
        _nS = _m, "Subiu em todas as " & SWITCH ( _m, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _m, "0" ) ) & " obras desde " & _mesAnt & ".",
        _nC >= _nS,
            "Caiu em " & SWITCH ( _nC, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nC, "0" ) ) & " das " & SWITCH ( _m, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _m, "0" ) ) & " obras desde " & _mesAnt & IF ( _nS = 0, "; as outras ficaram iguais.", "; só " & _lsTxt & IF ( _nS = 1, " subiu.", " subiram." ) ),
        "Subiu em " & SWITCH ( _nS, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _nS, "0" ) ) & " das " & SWITCH ( _m, 0, "nenhuma", 1, "uma", 2, "duas", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", 11, "onze", 12, "doze", FORMAT ( _m, "0" ) ) & " obras desde " & _mesAnt & IF ( _nC = 0, "; nenhuma caiu.", "; só " & _lcTxt & IF ( _nC = 1, " caiu.", " caíram." ) )
    )
-- 3 · Geometria
VAR _max = MAXX ( _comAba, ABS ( [@r] ) ) /* geometria */
-- 4 · Marcação
VAR _htmlLinhas =
    CONCATENATEX (
        _mostra,
        VAR _r = [@r]
        VAR _vA = ABS ( _r )
        VAR _vNu = SWITCH ( TRUE (), _vA >= 999500, FORMAT ( _vA / 1000000, "0.00", "pt-BR" ), _vA >= 999.5, FORMAT ( _vA / 1000, "0", "pt-BR" ), FORMAT ( _vA, "#,0", "pt-BR" ) )
        VAR _vUn = SWITCH ( TRUE (), _vA >= 999500, " mi", _vA >= 999.5, " mil", "" )
        VAR _vS = IF ( _r < 0 && _vNu <> "0", "−", "" )
        VAR _vKP = LEN ( _vNu ) > 0
        VAR _vKN = IF ( _vKP, _vNu )
        VAR _vKS = SUBSTITUTE ( SUBSTITUTE ( _vKN, ".", "" ), ",", "" )
        VAR _vKT = IFERROR ( VALUE ( _vKS ), -1 )
        VAR _vKOk = _vKP && _vKT >= 2 && FORMAT ( _vKT, REPT ( "0", LEN ( _vKS ) ) ) = _vKS
        VAR _vKD = IF ( CONTAINSSTRING ( _vKN, "," ), LEN ( _vKN ) - SEARCH ( ",", _vKN ), 0 )
        VAR _vKM = IF ( CONTAINSSTRING ( _vKN, "." ), "#,##0", "0" ) & IF ( _vKD > 0, "." & REPT ( "0", _vKD ) )
        VAR _vKOd =
            IF (
                _vKOk,
                "<o-d><o-v>" & _vKN & "</o-v><o-t aria-hidden='true'>"
                    & CONCATENATEX (
                        _odQ,
                        IF ( [@odk] = 24, _vKN, FORMAT ( ROUND ( _vKT * [@odf] / 1000, 0 ) / POWER ( 10, _vKD ), _vKM, "pt-BR" ) ),
                        UNICHAR ( 10 ),
                        [@odk], ASC
                    )
                    & "</o-t></o-d>",
                _vNu
            )
        VAR _vTxt = _vS & "R$ " & _vNu & _vUn
        VAR _vOd = _vS & "R$ " & _vKOd & _vUn
        VAR _qR = ROUND ( [@p] * 100, 2 )
        VAR _qS = SWITCH ( TRUE (), _qR > 0, "+", _qR < 0, "−", "" )
        VAR _qNu = FORMAT ( ABS ( [@p] ) * 100, "0.00", "pt-BR" )
        VAR _qKP = LEN ( _qNu ) > 0
        VAR _qKN = IF ( _qKP, _qNu )
        VAR _qKS = SUBSTITUTE ( SUBSTITUTE ( _qKN, ".", "" ), ",", "" )
        VAR _qKT = IFERROR ( VALUE ( _qKS ), -1 )
        VAR _qKOk = _qKP && _qKT >= 2 && FORMAT ( _qKT, REPT ( "0", LEN ( _qKS ) ) ) = _qKS
        VAR _qKD = IF ( CONTAINSSTRING ( _qKN, "," ), LEN ( _qKN ) - SEARCH ( ",", _qKN ), 0 )
        VAR _qKM = IF ( CONTAINSSTRING ( _qKN, "." ), "#,##0", "0" ) & IF ( _qKD > 0, "." & REPT ( "0", _qKD ) )
        VAR _qKOd =
            IF (
                _qKOk,
                "<o-d><o-v>" & _qKN & "</o-v><o-t aria-hidden='true'>"
                    & CONCATENATEX (
                        _odQ,
                        IF ( [@odk] = 24, _qKN, FORMAT ( ROUND ( _qKT * [@odf] / 1000, 0 ) / POWER ( 10, _qKD ), _qKM, "pt-BR" ) ),
                        UNICHAR ( 10 ),
                        [@odk], ASC
                    )
                    & "</o-t></o-d>",
                _qNu
            )
        VAR _qTxt = _qS & _qNu & "%"
        VAR _qOd = _qS & _qKOd & "%"
        VAR _w = MAX ( 1, ROUND ( DIVIDE ( ABS ( _r ), _max ) * 72, 0 ) ) -- geometria
        VAR _x = IF ( _r >= 0, 240, 240 - _w ) -- geometria
        VAR _corre = IF ( _r < 0, " data-rp='left,width' data-r0-left='240px'" )
        VAR _clsBz = IF ( _r < 0, " ng", "" )
        VAR _ngV = IF ( _vS = "−", " ng", "" )
        VAR _ngQ = IF ( _qS = "−", " ng", "" )
        VAR _cls = IF ( [@pend] = 1, "m", IF ( ISBLANK ( [@st] ), "", [@st] & "" ) )
        RETURN
            "<div class='lc'>" & IF ( _cls = "", "", "<i class='mk mk" & _cls & "'></i>" ) & "<span class='nm'>" & dObra[Obra] & IF ( [@selo] = "REAL", "<span class='selo selo-r'>REAL</span>", "" ) & "</span>"
                & "<i class='bz" & _clsBz & "' style='left:" & _x & "px;width:" & _w & "px'" & _corre & " data-rk='" & dObra[Obra] & "' data-rd='" & ( RANKX ( _mostra, [@r], _r, DESC ) - 1 ) * 60 & "'></i>" /* geometria */
                & "<span class='v" & _ngV & "'>" & _vOd & "</span><span class='p" & _ngQ & "'>" & _qOd & "</span></div>",
        "",
        [@r], DESC,
        dObra[Obra], ASC
    )
VAR _htmlMais = IF ( _mais > 0, "<i class='vz mais'>e mais " & "⁅" & FORMAT ( _mais, "0" ) & "⁆" & " obras, com resultado mais perto de zero</i>" )
VAR _nLs = COUNTROWS ( _mostra ) + IF ( _mais > 0, 1, 0 ) /* lista */
VAR _saidaHtml =
    IF (
        _n > 0,
        "<div class='u tt'><div class='cab'><p class='vs'>" & _txtSob & "</p>"
            & "<div class='lin1'><div class='tit'><b>" & _mesL & "</b></div></div></div>"
            & "<div class='corpo lim'><div class='bh'><span class='vs'>RESULTADO APLICADO DE CADA OBRA · R$ NO MÊS</span>"
            & "<span class='vs'>% DO ORÇ.</span></div><div class='lsb" & " ls " & SWITCH ( TRUE (), _nLs <= 3, "e1", _nLs <= 6, "e2", _nLs <= 9, "e3", _nLs <= 12, "e4", "e5" ) & "' style='--n:" & _nLs & "'>" & _htmlLinhas & _htmlMais & "</div></div>"
            & "<div class='pe'><div class='dd'><span class='vs'>A REALIZAR (ATÉ O TRAÇO DA PLANILHA)</span>"
            & "<b>" & _taOd & "</b><span class='dt'>· " & _txtAtivAnt & "</span></div>"
            & IF ( _txtRod <> "", "<p class='rod'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txtRod, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" ) & "</p>" )
        & "</div></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida]
    )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
