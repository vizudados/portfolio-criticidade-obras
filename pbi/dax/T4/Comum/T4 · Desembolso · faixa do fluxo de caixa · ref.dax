/*
@pasta: T4 Resultado no tempo\Comum\Contas
@formato: 0
@descricao: [T4 · Desembolso · faixa do fluxo de caixa] no mês de referência (seletor do drawer; sem escolha, o último mês).
@oraculo: ago/26: POTENGI 2 · REDINHA 1 · TIROL 0
@gerado: pbi/scripts/contas_t4.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [T4 · Desembolso · faixa do fluxo de caixa], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
