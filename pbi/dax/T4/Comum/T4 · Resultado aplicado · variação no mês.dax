/*
@pasta: T4 Resultado no tempo\Comum\Contas
@formato: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
@descricao: Resultado aplicado do mês menos o do mês anterior, só das obras com aba nos dois meses (vazio sem nenhuma).
@oraculo: resultado aplicado de cada obra, mês − mês anterior
@gerado: pbi/scripts/contas_t4.py
*/
VAR _mesAnt = EDATE ( MAX ( dMes[Mes] ), -1 )
VAR _comp =
    FILTER (
        VALUES ( fAnaliseCritica[Obra] ),
        NOT ISBLANK ( [Resultado aplicado] )
            && NOT ISBLANK ( CALCULATE ( [Resultado aplicado], REMOVEFILTERS ( dMes ), dMes[Mes] = _mesAnt ) )
    )
RETURN
    IF (
        NOT ISEMPTY ( _comp ),
        SUMX ( _comp, [Resultado aplicado] - CALCULATE ( [Resultado aplicado], REMOVEFILTERS ( dMes ), dMes[Mes] = _mesAnt ) )
    )
