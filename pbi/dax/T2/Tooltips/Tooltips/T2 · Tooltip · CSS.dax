    & "iant-numeric:tabular-nums}.tt .lin.it{grid-template-columns:1fr 170px}.tt .lin.it .d2{font-size:15px;line-height:21px;overflow:hidden;text-overflow:ellipsis}.tt .lin.mais{display:b"
