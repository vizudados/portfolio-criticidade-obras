/*
@pasta: T2 Análise crítica\Tooltips
@formato: texto
@descricao: Tooltip de página do Desembolso do mês (obra em foco): os meses anteriores ao de referência na janela, do mais recente ao mais antigo, com a marca da faixa da previsão de caixa, o desvio (negativo em preto, decisão do Alisson), previsto × desembolsado e a justificativa (não exigida, preenchida ou em branco); as faixas do item lidas do modelo e, no pé, quantas exigidas foram preenchidas.
@gerado: pbi/scripts/tooltips_t2.py
*/
-- 1 · Leituras
VAR _ref = [Mês de referência]
VAR _mesRefC = [Mês de referência · curto]
VAR _obra = [Nota · obra em foco]
VAR _selo = [Obra em foco · selo]
VAR _faixas = [T2 · Desembolso · faixas da previsão de caixa]
VAR _nMes = [T2 · Desembolso · meses antes da referência · foco] + 0
VAR _nEx = [T2 · Desembolso · justificativas exigidas antes da referência · foco] + 0
VAR _nPre = [T2 · Desembolso · justificativas preenchidas antes da referência · foco] + 0
VAR _meses =
    ADDCOLUMNS (
        VALUES ( dMes[Mes] ),
        "@ate", [Série · mês até a referência],
        "@rot", [Mês · rótulo curto],
        "@pv", [Desembolso · previsto no mês · foco no mês],
        "@ds", [Desembolso · realizado no mês · foco no mês],
        "@d", [Desembolso · desvio no mês · foco no mês],
        "@e", [Justificativa · exigida · foco no mês],
        "@b", [Justificativa · em branco · foco no mês],
        "@pt", [T2 · Desembolso · pontos caixa · foco no mês],
        "@ps", [T2 · Desembolso · possíveis caixa · foco no mês]
    )
VAR _ant = FILTER ( _meses, [@ate] = 1 && dMes[Mes] < _ref && ( NOT ISBLANK ( [@pv] ) || NOT ISBLANK ( [@ds] ) ) ) /* lista */
VAR _nLs = COUNTROWS ( _ant ) /* lista */
-- 2 · Textos
VAR _txtSob = "DESEMBOLSO DO MÊS · " & UPPER ( _obra ) & IF ( _selo = "", "", " · " & _selo )
VAR _txtDir = "⁅" & _nMes & "⁆" & IF ( _nMes = 1, " mês antes de ", " meses antes de " ) & _mesRefC
VAR _txtRod =
    SWITCH (
        TRUE (),
        _nEx = 0, "nenhuma exigida: todo desvio ficou dentro de ±10%",
        _nPre = _nEx, IF ( _nEx = 1, "a única exigida foi preenchida", "todas as " & "⁅" & _nEx & "⁆" & " exigidas preenchidas" ),
        "⁅" & _nPre & "⁆" & " de " & "⁅" & _nEx & "⁆" & IF ( _nEx = 1, " exigida preenchida", " exigidas preenchidas" )
    )
-- 4 · Marcação
VAR _htmlLinhas =
    CONCATENATEX (
        _ant,
        VAR _d = [@d]
        VAR _dR = ROUND ( _d * 100, 0 )
        VAR _dTxt = IF ( ISBLANK ( _d ), "—", IF ( _dR > 0, "+", IF ( _dR < 0, "−", "" ) ) & "⁅" & FORMAT ( ABS ( _d ) * 100, "0", "pt-BR" ) & "⁆" & "%" )
        VAR _mk = IF ( IF ( ISBLANK ( [@pt] ), "", IF ( [@pt] >= [@ps], "0", IF ( [@pt] = 0, "2", "1" ) ) ) = "", "", "<i class='mk mk" & IF ( ISBLANK ( [@pt] ), "", IF ( [@pt] >= [@ps], "0", IF ( [@pt] = 0, "2", "1" ) ) ) & "'></i>" )
        VAR _dsTxt = IF ( ISBLANK ( [@ds] ), "nada desembolsado", "⁅" & "R$ " & SWITCH ( TRUE (), ABS ( [@ds] ) >= 999500, FORMAT ( ABS ( [@ds] ) / 1000000, "0.00", "pt-BR" ) & " mi", ABS ( [@ds] ) >= 999.5, FORMAT ( ABS ( [@ds] ) / 1000, "0", "pt-BR" ) & " mil", FORMAT ( ABS ( [@ds] ), "#,0", "pt-BR" ) ) & "⁆" )
        VAR _rsTxt = IF ( ISBLANK ( [@pv] ), "sem previsto · " & _dsTxt, "⁅" & "R$ " & SWITCH ( TRUE (), ABS ( [@pv] ) >= 999500, FORMAT ( ABS ( [@pv] ) / 1000000, "0.00", "pt-BR" ) & " mi", ABS ( [@pv] ) >= 999.5, FORMAT ( ABS ( [@pv] ) / 1000, "0", "pt-BR" ) & " mil", FORMAT ( ABS ( [@pv] ), "#,0", "pt-BR" ) ) & "⁆" & " × " & _dsTxt )
        VAR _jTxt =
            SWITCH (
                TRUE (),
                [@b] = 1, "<span class='chp'><i></i>Em branco</span>",
                [@e] = 1, "preenchida",
                ISBLANK ( [@e] ), "sem previsto",
                "não exigida"
            )
        RETURN
            "<div class='lin ds2'><span class='m'>" & [@rot] & "</span><span class='dv'>" & _mk & "<span>" & _dTxt & "</span></span>"
                & "<span class='rs'>" & _rsTxt & "</span><span class='j'>" & _jTxt & "</span></div>",
        "",
        dMes[Mes], DESC
    )
VAR _saidaHtml =
    IF (
        NOT ISBLANK ( _obra ),
        "<div class='u tt'><div class='cab sobre-preto'><p class='vs sob'>" & _txtSob & "</p>"
            & "<div class='tl'><div class='tit'><b>" & "Os meses anteriores" & "</b>" & "</div>"
            & "<p class='vs dir'>" & _txtDir & "</p></div></div>"
            & IF (
                _nLs = 0,
                "<div class='corpo'><p class='vz'>Nenhum mês antes de " & _mesRefC & " com desembolso na janela.</p></div>",
                "<div class='corpo crp'>"
                    & IF ( _faixas = "", "", "<p class='nt'>Faixas: " & SUBSTITUTE ( SUBSTITUTE ( _faixas, "<", "&lt;" ), ">", "&gt;" ) & "</p>" )
                    & "<div class='bh'><span class='vs'>Mês · desvio · previsto × desembolsado</span>"
                    & "<span class='vs'>Justificativa</span></div>"
                    & "<div class='lsb" & " ls " & SWITCH ( TRUE (), _nLs <= 3, "e1", _nLs <= 6, "e2", _nLs <= 9, "e3", _nLs <= 12, "e4", "e5" ) & "' style='--n:" & _nLs & "'>" & _htmlLinhas & "</div></div>"
                    & "<div class='rp'><div class='rg'></div>" & "<span class='vs'>" & "Justificativa exigida acima de ±10%" & "</span>" & "<p class='rod'>" & _txtRod & "</p></div>"
            )
        & "</div>" & [Comum · JS contador tooltip]
    )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
