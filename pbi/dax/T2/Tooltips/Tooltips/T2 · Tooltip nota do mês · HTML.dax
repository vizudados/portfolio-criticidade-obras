/*
@pasta: T2 Análise crítica\Tooltips
@formato: texto
@descricao: Tooltip de página do mês de A nota, mês a mês (obra em foco): a nota e o status no mês, os nove itens da nota com o valor no mês, os pontos (pílula cheio, parcial, zero, sem dado) e a variação contra o mês anterior, e no pé a nota do mês anterior. Primeiro mês do histórico: sem variação.
@gerado: pbi/scripts/tooltips_t2.py
*/
-- 1 · Leituras
VAR _mesL = [Mês · longo]
VAR _mesAntN = [Mês anterior · nome]
VAR _primeiro = [Mês · é o primeiro do histórico] = 1
VAR _obra = [Nota · obra em foco]
VAR _selo = [Obra em foco · selo]
VAR _nota = [Nota · nota final · foco no mês]
VAR _st = [Nota · status · foco no mês]
VAR _pend = [Nota · pendente · foco no mês]
VAR _obt = [Nota · pontos obtidos · foco no mês]
VAR _poss = [Nota · pontos possíveis · foco no mês]
VAR _notaA = [T2 · Nota do mês · nota no mês anterior · foco no mês]
VAR _stA = [T2 · Nota do mês · status no mês anterior · foco no mês]
VAR _pendA = [T2 · Nota do mês · pendente no mês anterior · foco no mês]
VAR _obtA = [T2 · Nota do mês · obtidos no mês anterior · foco no mês]
VAR _possA = [T2 · Nota do mês · possíveis no mês anterior · foco no mês]
VAR _itens =
    ADDCOLUMNS (
        VALUES ( dItemNota[Item] ),
        "@ord", [Nota · item · ordem],
        "@nome", [Nota · item · nome médio],
        "@pts", [Nota · item · pontos · foco no mês],
        "@ps", [Nota · item · possíveis · foco no mês],
        "@x", [T2 · Nota do mês · item · X · foco no mês],
        "@dv", [T2 · Nota do mês · item · variação de pontos · foco no mês]
    )
VAR _nIt = COUNTROWS ( _itens ) /* lista */
-- 2 · Textos
VAR _txtSob = "A NOTA, MÊS A MÊS · " & UPPER ( _obra ) & IF ( _selo = "", "", " · " & _selo )
VAR _txtDir =
    SWITCH (
        TRUE (),
        _pend = 1, "pendente · " & "⁅" & FORMAT ( _obt, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _poss, "0.0#", "pt-BR" ) & "⁆",
        ISBLANK ( _nota ), "sem nota no mês",
        "nota " & "⁅" & FORMAT ( _nota, "0.0#", "pt-BR" ) & "⁆" & " · " & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" )
    )
VAR _txtAnt =
    SWITCH (
        TRUE (),
        _primeiro, "primeiro mês do histórico",
        _pendA = 1, "pendente · " & "⁅" & FORMAT ( _obtA, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _possA, "0.0#", "pt-BR" ) & "⁆",
        ISBLANK ( _notaA ), "sem nota",
        "nota " & "⁅" & FORMAT ( _notaA, "0.0#", "pt-BR" ) & "⁆" & " · " & SWITCH ( TRUE (), _pendA = 1, "pendente", ISBLANK ( _stA ), "", _stA = 2, "crítico", _stA = 1, "atenção", "estável" )
    )
VAR _txtRotAnt = IF ( _primeiro, "Antes", "Em " & _mesAntN )
VAR _txtBhD = IF ( _primeiro, "Pontos", "Pontos · desde " & _mesAntN )
-- 4 · Marcação
VAR _htmlLinhas =
    CONCATENATEX (
        _itens,
        VAR _cod = dItemNota[Item]
        VAR _pts = [@pts]
        VAR _ps = [@ps]
        VAR _xA1 = ROUND ( ABS ( [@x] ) * 100, 1 )
        VAR _xPct = "⁅" & FORMAT ( _xA1, "0.0", "pt-BR" ) & "⁆" & "%"
        VAR _xMes = "⁅" & FORMAT ( ABS ( [@x] ), "0.0", "pt-BR" ) & "⁆" & IF ( ROUND ( ABS ( [@x] ), 1 ) <= 1, " mês", " meses" )
        VAR _txtX =
            SWITCH (
                TRUE (),
                ISBLANK ( _pts ), "",
                _cod = "custo", "<b class='" & IF ( [@x] < 1, "ng", "" ) & "'>IDC " & "⁅" & FORMAT ( [@x], "0.00", "pt-BR" ) & "⁆" & "</b>",
                _cod = "prazo",
                    "<b>" & IF ( ROUND ( [@x], 1 ) > 0, "atraso de " & _xMes, IF ( ROUND ( [@x], 1 ) < 0, "adiantada " & _xMes, "em dia" ) ) & "</b>",
                _cod = "acidentes", "<b>TF " & "⁅" & FORMAT ( [@x], "0.0", "pt-BR" ) & "⁆" & "</b>",
                _cod = "analise", "<b>" & "⁅" & FORMAT ( [@x], "0" ) & "⁆" & " de 3 checagens</b>",
                "<b>" & _xPct & "</b>"
            )
        VAR _kCls = SWITCH ( TRUE (), ISBLANK ( _pts ), "f", _ps = 0, "n", _pts >= _ps, "c", _pts = 0, "z", "p" )
        VAR _kTxt =
            SWITCH (
                TRUE (),
                ISBLANK ( _pts ), "sem dado",
                _ps = 0, "não conta",
                "⁅" & FORMAT ( _pts, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _ps, "0.0#", "pt-BR" ) & "⁆"
            )
        VAR _v = [@dv]
        VAR _vR = ROUND ( _v, 2 )
        VAR _dTxt =
            SWITCH (
                TRUE (),
                _primeiro || ISBLANK ( _v ), "",
                _vR = 0, "=",
                IF ( _vR > 0, "+", "−" ) & "⁅" & FORMAT ( ABS ( _v ), "0.0#", "pt-BR" ) & "⁆"
            )
        VAR _dCls = IF ( ISBLANK ( _v ), "", IF ( _vR < 0, " ng", IF ( _vR = 0, " ig", "" ) ) )
        RETURN
            "<div class='lin nt2'><span class='n'>" & [@nome] & "</span><span class='x'>" & _txtX & "</span>"
                & "<span class='p'><span class='chi chi-" & _kCls & "'><span>" & _kTxt & "</span></span></span>"
                & "<span class='dl" & _dCls & "'>" & _dTxt & "</span></div>",
        "",
        [@ord], ASC
    )
VAR _saidaHtml =
    IF (
        NOT ISBLANK ( _obra ),
        "<div class='u tt'><div class='cab sobre-preto'><p class='vs sob'>" & _txtSob & "</p>"
            & "<div class='tl'><div class='tit'><b>" & _mesL & "</b>" & "</div>"
            & "<p class='vs dir'>" & _txtDir & "</p></div></div>"
            & IF (
                ISBLANK ( _poss ) && ISBLANK ( _nota ),
                "<div class='corpo'><p class='vz'>Sem planilha da obra neste mês.</p></div>",
                "<div class='corpo crp'><div class='bh'><span class='vs'>Item · valor no mês</span>"
                    & "<span class='vs'>" & _txtBhD & "</span></div>"
                    & "<div class='lsb" & " ls " & SWITCH ( TRUE (), _nIt <= 3, "e1", _nIt <= 6, "e2", _nIt <= 9, "e3", _nIt <= 12, "e4", "e5" ) & "' style='--n:" & _nIt & "'>" & _htmlLinhas & "</div></div>"
                    & "<div class='rp'><div class='rg'></div>" & "<span class='vs'>" & _txtRotAnt & "</span>" & "<p class='rod'>" & _txtAnt & "</p></div>"
            )
        & "</div>" & [Comum · JS contador tooltip]
    )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
