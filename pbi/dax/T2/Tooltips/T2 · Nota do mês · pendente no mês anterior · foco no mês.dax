/*
@pasta: T2 Análise crítica\Tooltips\Contas
@formato: 0
@descricao: 1 quando a nota da obra em foco estava pendente no mês anterior ao do eixo (tooltip do mês de A nota, mês a mês); vazio sem nota no mês anterior.
@gerado: pbi/scripts/contas_t2.py
*/
VAR _mes = EDATE ( MAX ( dMes[Mes] ), -1 )
RETURN
    CALCULATE ( [Nota · pendente · foco no mês], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
