/*
@pasta: T2 Análise crítica\Tooltips\Contas
@formato: 0%
@descricao: [Desembolso · desvio no mês] da obra em foco no mês do eixo (tooltips e séries da T2).
@gerado: pbi/scripts/contas_t2.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    CALCULATE ( [Desembolso · desvio no mês], dObra[Obra] = _obra )
