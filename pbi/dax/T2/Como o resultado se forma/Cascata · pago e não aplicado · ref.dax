/*
@pasta: T2 Análise crítica\Como o resultado se forma\Contas
@formato: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
@descricao: [Cascata · pago e não aplicado] no mês de referência.
@gerado: pbi/scripts/contas_t2.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Cascata · pago e não aplicado], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
