/*
@pasta: T2 Análise crítica\Como o resultado se forma
@formato: texto
@descricao: Um degrau da cascata por entrada (granularidade dDegrau): valor agregado em preto (soma), custo aplicado em vermelho-claro com contorno vermelho (desconta), resultado aplicado, a realizar hachurado (o que a planilha conta e ainda não aconteceu) e o resultado da planilha (resultados em preto; vermelho quando negativos). A barra vai da base ao topo do degrau na mesma escala (y 20–218); a ligação leva o nível ao próximo degrau; o zero atravessa as colunas. O mouse abre o tooltip do degrau.
@gerado: pbi/scripts/desenho_t2.py
*/
-- 1 · Leituras
VAR _deg = SELECTEDVALUE ( dDegrau[Degrau] )
VAR _ordem = SELECTEDVALUE ( dDegrau[Ordem] )
VAR _rot = SELECTEDVALUE ( dDegrau[Rotulo] )
VAR _sinal = SELECTEDVALUE ( dDegrau[Sinal] )
VAR _aparece = [Cascata · degrau · aparece · foco]
VAR _v = [Cascata · degrau · valor · foco]
VAR _base = [Cascata · degrau · base · foco]
VAR _topo = [Cascata · degrau · topo · foco]
VAR _max = [Cascata · escala · máximo · foco]
VAR _min = [Cascata · escala · mínimo · foco]
-- 2 · Textos
VAR _tvA = ABS ( _v )
VAR _tvNu = SWITCH ( TRUE (), _tvA >= 99950000, FORMAT ( _tvA / 1000000, "0.0", "pt-BR" ), _tvA >= 999500, FORMAT ( _tvA / 1000000, "0.00", "pt-BR" ), _tvA >= 999.5, FORMAT ( _tvA / 1000, "0", "pt-BR" ), FORMAT ( _tvA, "#,0", "pt-BR" ) )
VAR _tvUn = SWITCH ( TRUE (), _tvA >= 999500, " mi", _tvA >= 999.5, " mil", "" )
VAR _tvN = _tvNu & _tvUn
VAR _tvZero = _tvN = "0"
VAR _tvS = IF ( _tvZero, "", IF ( _v < 0, "−", "" ) )
VAR _tvTxt = IF ( ISBLANK ( _v ), "—", _tvS & "R$ " & _tvN )
VAR _sinalTxt = SWITCH ( TRUE (), _sinal > 0, "+", _sinal < 0, "−", "" )
VAR _txtV = IF ( _sinal = 0 || _tvZero, _tvTxt, _sinalTxt & SUBSTITUTE ( _tvTxt, "−", "" ) )
VAR _vermelho = IF ( _sinal = 0, _v < 0, _sinal < 0 && NOT _tvZero )
VAR _txtRot =
    SWITCH (
        _deg,
        "ValorAgregado", "Valor<br>agregado",
        "CustoAplicado", "Custo<br>aplicado",
        "ResultadoAplicado", "Resultado<br>aplicado",
        "ARealizar", "A realizar",
        "Resultado", "Resultado da<br>planilha",
        _rot
    )
VAR _cls = SWITCH ( TRUE (), _sinal = 0, IF ( _v < 0, "kn", "k2" ), _sinal < 0, "kd", _deg = "ARealizar", "kr", "k2" )
-- 3 · Geometria
VAR _faixa = _max - _min -- geometria
VAR _yTopo = 20 + ROUND ( DIVIDE ( _max - _topo, _faixa ) * 198, 0 ) -- geometria
VAR _yBase = 20 + ROUND ( DIVIDE ( _max - _base, _faixa ) * 198, 0 ) -- geometria
VAR _h = MAX ( _yBase - _yTopo, 2 ) -- geometria
VAR _yZero = 20 + ROUND ( DIVIDE ( _max, _faixa ) * 198, 0 ) -- geometria
VAR _yLig = IF ( _sinal < 0, _yBase, _yTopo ) -- geometria
VAR _yRot = IF ( _sinal = 0 && _v < 0, _yTopo + _h + 4, _yTopo - 20 ) -- geometria
VAR _atraso = ( _ordem - 1 ) * 110 -- geometria
-- 4 · Marcação
VAR _saidaHtml =
    IF (
        _aparece = 1 && NOT ISBLANK ( _max ),
        "<div class='u cd'>"
            & "<i class='b " & _cls & "' style='top:" & _yTopo & "px;height:" & _h & "px' data-rk='" & _deg & "' data-rp='top,height' data-r0-top='" & _yLig & "px' data-r0-height='0px' data-rd='" & _atraso & "'></i>"
            & "<i class='z a-gx' style='top:" & _yZero & "px;animation-delay:" & _atraso & "ms'></i>"
            & IF ( _deg <> "Resultado", "<i class='lg a-gx' style='top:" & IF ( _sinal = 0, IF ( _v < 0, _yBase, _yTopo ), _yLig ) & "px;animation-delay:" & ( _atraso + 600 ) & "ms'></i>", "" )
            & "<span class='v" & IF ( _vermelho, " ng", "" ) & "' style='top:" & _yRot & "px'>" & "⁅" & _txtV & "⁆" & "</span>"
            & "<span class='n a-fd' style='animation-delay:" & _atraso & "ms'>" & _txtRot & "</span>"
        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
    )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
