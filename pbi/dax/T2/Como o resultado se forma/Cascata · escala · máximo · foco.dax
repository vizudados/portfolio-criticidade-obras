/*
@pasta: T2 Análise crítica\Como o resultado se forma\Contas
@formato: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
@descricao: Escala da cascata da obra em foco: o topo mais alto entre os degraus que aparecem (zero entra sempre).
@gerado: pbi/scripts/contas_t2.py
*/
VAR _deg =
    ADDCOLUMNS (
        ALL ( dDegrau ),
        "@a", [Cascata · degrau · aparece · foco],
        "@t", [Cascata · degrau · topo · foco],
        "@b", [Cascata · degrau · base · foco]
    )
RETURN
    MAXX ( FILTER ( _deg, [@a] = 1 ), [@t] )
