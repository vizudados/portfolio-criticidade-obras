/*
@pasta: T2 Análise crítica\Itens da nota
@formato: texto
@descricao: Um item da nota por entrada (granularidade dItemNota, na ordem de T2 · Itens · posição): nome, o chip de pontos de possíveis (cheio, parcial, zero; sem dado tracejado, com 'falta na base' ou 'sem dado na planilha' conforme a fonte), o X e a faixa atingida e, à direita, a minissérie dos pontos do item nos meses da janela (fração dos pontos; o mês de referência contornado). O mouse abre o tooltip do item.
@gerado: pbi/scripts/desenho_t2.py
*/
-- 1 · Leituras
VAR _cod = SELECTEDVALUE ( dItemNota[Item] )
VAR _nome = [Nota · item · nome médio]
VAR _fonte = [Nota · item · fonte]
VAR _max = [Nota · item · máximo]
VAR _pts = [Nota · item · pontos · foco]
VAR _poss = [Nota · item · possíveis · foco]
VAR _x = [Nota · item · X · foco]
VAR _fx = [Nota · item · faixa atingida · foco]
VAR _fora = [Nota · item · fora da faixa · foco]
VAR _temObra = NOT ISBLANK ( [Nota · pontos possíveis · ranking · foco] )
VAR _ref = [Mês de referência]
VAR _n = [Série · meses até a referência]
VAR _todos =
    ADDCOLUMNS (
        VALUES ( dMes[Mes] ),
        "@ate", [Série · mês até a referência],
        "@pos", [Série · posição na janela],
        "@v", [Nota · item · pontos · foco no mês],
        "@p", [Nota · item · possíveis · foco no mês]
    )
VAR _meses = FILTER ( _todos, [@ate] = 1 ) /* lista */
-- 2 · Textos
VAR _caTxt = IF ( ISBLANK ( _pts ), "sem dado na planilha", "⁅" & FORMAT ( _pts, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _poss, "0.0#", "pt-BR" ) & "⁆" )
VAR _caCls = SWITCH ( TRUE (), ISBLANK ( _pts ), "f", _pts >= _poss, "c", _pts = 0, "z", "p" )
VAR _caHtml = "<span class='a-pop chi chi-" & _caCls & "' style='animation-delay:" & 450 & "ms'><span>" & _caTxt & "</span></span>"
VAR _cbTxt = IF ( ISBLANK ( _pts ), "falta na base", "⁅" & FORMAT ( _pts, "0.0#", "pt-BR" ) & "⁆" & " de " & "⁅" & FORMAT ( _poss, "0.0#", "pt-BR" ) & "⁆" )
VAR _cbCls = SWITCH ( TRUE (), ISBLANK ( _pts ), "f", _pts >= _poss, "c", _pts = 0, "z", "p" )
VAR _cbHtml = "<span class='a-pop chi chi-" & _cbCls & "' style='animation-delay:" & 450 & "ms'><span>" & _cbTxt & "</span></span>"
VAR _tmxTxt = IF ( ISBLANK ( _max ), "—", FORMAT ( _max, "0.0#", "pt-BR" ) )
VAR _chip =
    SWITCH (
        TRUE (),
        NOT ISBLANK ( _pts ) && _poss = 0, "<span class='a-pop chi chi-n' style='animation-delay:450ms'>não conta</span>",
        ISBLANK ( _pts ) && _fora = 1, "<span class='a-pop chi chi-f' style='animation-delay:450ms'>fora da faixa</span>",
        _fonte = "Análise Crítica", _caHtml,
        _cbHtml
    )
VAR _xA1 = ROUND ( ABS ( _x ) * 100, 1 )
VAR _xPct = "⁅" & FORMAT ( _xA1, "0.0", "pt-BR" ) & "⁆" & "%"
VAR _xMes = "⁅" & FORMAT ( ABS ( _x ), "0.0", "pt-BR" ) & "⁆" & IF ( ROUND ( ABS ( _x ), 1 ) <= 1, " mês", " meses" )
VAR _txtX =
    SWITCH (
        TRUE (),
        ISBLANK ( _pts ), "",
        _cod = "custo", "<b class='" & IF ( _x < 1, "ng", "" ) & "'>IDC " & "⁅" & FORMAT ( _x, "0.00", "pt-BR" ) & "⁆" & "</b>",
        _cod = "prazo",
            "<b>" & IF ( ROUND ( _x, 1 ) > 0, "atraso de " & _xMes, IF ( ROUND ( _x, 1 ) < 0, "adiantada " & _xMes, "em dia" ) ) & "</b>",
        _cod = "acidentes", "<b>TF " & "⁅" & FORMAT ( _x, "0.0", "pt-BR" ) & "⁆" & "</b>",
        _cod = "analise", "<b>" & "⁅" & FORMAT ( _x, "0" ) & "⁆" & " de 3 checagens</b>",
        "<b>" & _xPct & "</b>"
    )
VAR _txtFaixa =
    SWITCH (
        TRUE (),
        ISBLANK ( _pts ), "vale até " & "⁅" & _tmxTxt & "⁆" & IF ( _max < 2, " ponto", " pontos" ),
        SUBSTITUTE ( SUBSTITUTE ( _fx, "<", "&lt;" ), ">", "&gt;" )
    )
-- 3 · Geometria
VAR _x0 = 141 - _n * 12 + 3 -- geometria
-- 4 · Marcação
VAR _serie =
    CONCATENATEX (
        _meses,
        VAR _xb = _x0 + ( [@pos] - 1 ) * 12 /* geometria */
        VAR _cls = SWITCH ( TRUE (), ISBLANK ( [@v] ) || [@p] = 0, "v", [@v] >= [@p], "c", [@v] = 0, "z", "p" )
        VAR _hb = IF ( _cls = "z", 3, MAX ( 3, ROUND ( DIVIDE ( [@v], [@p] ) * 26, 0 ) ) ) /* geometria */
        /* F4: a barra cresce da base (corrida; o traço do mês sem dado tem altura fixa e só aparece) */
        VAR _rd = ( [@pos] - 1 ) * 40 /* geometria */
        VAR _corre = IF ( _cls = "v", ";animation-delay:" & _rd & "ms'", "' data-rk='" & _cod & "|" & FORMAT ( dMes[Mes], "yyyymm" ) & "' data-rp='height' data-r0-height='0px' data-rd='" & _rd & "'" ) /* geometria */
        RETURN
            "<i class='" & _cls & IF ( _cls = "v", " a-fd", "" ) & IF ( dMes[Mes] = _ref, " r", "" ) & "' style='left:" & _xb & "px;height:" & _hb & "px" & _corre & "></i>",
        "",
        dMes[Mes], ASC
    )
VAR _saidaHtml =
    IF (
        _temObra && NOT ISBLANK ( _cod ),
        "<div class='u it' data-rr='" & _cod & "'><p class='nm'>" & _nome & "</p>" & _chip
            & "<p class='ln'>" & _txtX & IF ( _txtFaixa = "", "", "<span>" & _txtFaixa & "</span>" ) & "</p>"
            & "<div class='sr'>" & _serie & "</div>"
        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
    )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
