/*
@pasta: T2 Análise crítica\Cartões
@formato: texto
@descricao: Cartão 'Nota da obra' da obra em foco no mês de referência (o escuro): a nota e o chip de status (crítico, atenção, estável; com a trava, o motivo) ou, sem a base completa, pendente com os pontos obtidos de quantos já dá para calcular. O verso diz a régua e as faixas de status (lidas das medidas). Só lê contas · foco.
@gerado: pbi/scripts/desenho_t2.py
*/
-- 1 · Leituras
VAR _nota = [Nota · nota final · ranking · foco]
VAR _st = [Nota · status · ranking · foco]
VAR _pend = [Nota · pendente · ranking · foco]
VAR _ob = [Nota · pontos obtidos · ranking · foco]
VAR _po = [Nota · pontos possíveis · ranking · foco]
VAR _pe = [Nota · pontos perdidos · ranking · foco]
VAR _faltB = [Nota · itens faltando na base · foco]
VAR _faltP = [Nota · itens faltando na planilha · foco]
VAR _fora = [Nota · itens fora da faixa · foco]
VAR _trv = [Nota · trava · motivo · foco]
VAR _fxC = [Nota · status · faixa crítico]
VAR _fxA = [Nota · status · faixa atenção]
VAR _fxE = [Nota · status · faixa estável]
VAR _mesC = [Mês de referência · curto]
-- 2 · Textos
VAR _nN = FORMAT ( _nota, "0.0#", "pt-BR" )
VAR _nOb = FORMAT ( _ob, "0.0#", "pt-BR" )
VAR _nPo = FORMAT ( _po, "0.0#", "pt-BR" )
VAR _nTxt = SWITCH ( TRUE (), _pend = 1, "pendente · " & _nOb & " de " & _nPo, ISBLANK ( _nota ), "—", "nota " & _nN )
VAR _tpeTxt = IF ( ISBLANK ( _pe ), "—", FORMAT ( _pe, "0.0#", "pt-BR" ) )
VAR _semObra = ISBLANK ( _nota ) && _pend <> 1
VAR _txtFalt = SWITCH ( TRUE (), ( _fora + 0 ) > 0 && ( ( _faltB + 0 ) - ( _fora + 0 ) ) + ( _faltP + 0 ) > 0, IF ( ( ( _faltB + 0 ) - ( _fora + 0 ) ) + ( _faltP + 0 ) = 1, "falta 1", "faltam " & ( ( ( _faltB + 0 ) - ( _fora + 0 ) ) + ( _faltP + 0 ) ) ) & " · " & ( _fora + 0 ) & " fora", ( _fora + 0 ) > 0, IF ( ( _fora + 0 ) = 1, "1 item fora da faixa", ( _fora + 0 ) & " itens fora da faixa" ), SWITCH ( TRUE (), ( ( _faltB + 0 ) - ( _fora + 0 ) ) > 0 && ( _faltP + 0 ) > 0, "faltam " & ( ( ( _faltB + 0 ) - ( _fora + 0 ) ) + ( _faltP + 0 ) ) & " · " & ( _faltP + 0 ) & " da planilha", ( ( _faltB + 0 ) - ( _fora + 0 ) ) > 0, IF ( ( ( _faltB + 0 ) - ( _fora + 0 ) ) = 1, "falta 1 item na base", "faltam " & ( ( _faltB + 0 ) - ( _fora + 0 ) ) & " itens na base" ), ( _faltP + 0 ) > 0, IF ( ( _faltP + 0 ) = 1, "falta 1 item na planilha", "faltam " & ( _faltP + 0 ) & " itens na planilha" ), "" ) )
VAR _chip = SUBSTITUTE ( IF ( IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) = "", "", "<span class='chip chip" & IF ( _pend = 1, "m", IF ( ISBLANK ( _st ), "", _st & "" ) ) & "'><i></i>" & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & "</span>" ), "<span class='chip ", "<span style='animation-delay:450ms' class='a-pop chip " )
VAR _txtCtx =
    SWITCH (
        TRUE (),
        _semObra, "sem aba no mês",
        _pend = 1, _chip & "⁅" & _txtFalt & "⁆",
        _trv & "" <> "", _chip & "trava de " & SUBSTITUTE ( _trv, "|", " e " ),
        _chip & IF ( _pe = 0, "não perde ponto", "perde " & "⁅" & _tpeTxt & "⁆" & " pontos" )
    )
VAR _odV = IF ( _pend = 1, _ob, _nota )
VAR _tnN = FORMAT ( _odV, "0.0#", "pt-BR" )
VAR _tnTxt = IF ( _semObra, "—", _tnN )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _tnKP = LEN ( _tnN ) > 0
VAR _tnKN = IF ( _tnKP, _tnN )
VAR _tnKS = SUBSTITUTE ( SUBSTITUTE ( _tnKN, ".", "" ), ",", "" )
VAR _tnKT = IFERROR ( VALUE ( _tnKS ), -1 )
VAR _tnKOk = _tnKP && _tnKT >= 2 && FORMAT ( _tnKT, REPT ( "0", LEN ( _tnKS ) ) ) = _tnKS
VAR _tnKD = IF ( CONTAINSSTRING ( _tnKN, "," ), LEN ( _tnKN ) - SEARCH ( ",", _tnKN ), 0 )
VAR _tnKM = IF ( CONTAINSSTRING ( _tnKN, "." ), "#,##0", "0" ) & IF ( _tnKD > 0, "." & REPT ( "0", _tnKD ) )
VAR _tnKOd =
    IF (
        _tnKOk,
        "<o-d><o-v>" & _tnKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tnKN, FORMAT ( ROUND ( _tnKT * [@odf] / 1000, 0 ) / POWER ( 10, _tnKD ), _tnKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tnN
    )
VAR _tnOd = IF ( ISBLANK ( _odV ), _tnTxt, _tnKOd )
-- 4 · Marcação
VAR _saidaHtml =
    "<div class='u kc escuro' tabindex='0'>"
        & "<div class='lado frente'>"
            & "<p class='ab vs eb'>" & "Nota da obra · " & _mesC & "</p>"
            & "<div class='linha1'><span class='b6 hero'>" & _tnOd & "</span>" & "<span class='b5 lado2'>" & IF ( _pend = 1, "de " & "⁅" & _nPo & "⁆", "" ) & "</span>" & "</div>"
            & "<p class='ctx'>" & _txtCtx & "</p>"
        & "</div>"
        & "<div class='lado verso sobre-creme'>"
            & "<p class='ab vs v1'>COMO É CALCULADO</p>"
            & "<p class='regra'>Soma dos nove itens, de 0 a 10; IDC &lt; 0,90 ou atraso &gt; 3 meses: crítica.</p>"
            & "<div class='ond' style='top:82px'><span class='vs'>DE ONDE VEM</span><span>Planilha, base e cronograma</span></div>"
            & "<div class='regua'>" & "<i class='mk mk2'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxC, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mk1'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxA, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mk0'></i><span>" & SUBSTITUTE ( SUBSTITUTE ( _fxE, "<", "&lt;" ), ">", "&gt;" ) & "</span>" & "<i class='mk mkm'></i><span>pendente</span>" & "</div>"
        & "</div>"
    & "</div>" & [Comum · JS contador]
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
