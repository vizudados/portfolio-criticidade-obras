/*
@pasta: T2 Análise crítica\Leituras\Contas
@formato: dd/mm/yyyy
@descricao: Primeiro mês da janela em que a obra em foco tem aba (jan/26 na REDINHA com janela de 12 em ago/26; jun/26 na TIROL).
@gerado: pbi/scripts/contas_t2.py
*/
VAR _ref = [Mês de referência]
VAR _ini = [Série · primeiro mês]
VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@r", [Resultado da obra · foco no mês] )
RETURN
    MINX ( FILTER ( _meses, NOT ISBLANK ( [@r] ) ), dMes[Mes] )
