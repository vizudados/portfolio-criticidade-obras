/*
@pasta: T2 Análise crítica\Leituras\Contas
@formato: 0
@descricao: Em quantos meses da janela (do primeiro mês da janela ao de referência) a obra em foco tem aba Análise Crítica.
@gerado: pbi/scripts/contas_t2.py
*/
VAR _ref = [Mês de referência]
VAR _ini = [Série · primeiro mês]
VAR _meses = ADDCOLUMNS ( FILTER ( ALL ( dMes[Mes] ), dMes[Mes] >= _ini && dMes[Mes] <= _ref ), "@r", [Resultado da obra · foco no mês] )
RETURN
    COUNTROWS ( FILTER ( _meses, NOT ISBLANK ( [@r] ) ) ) + 0
