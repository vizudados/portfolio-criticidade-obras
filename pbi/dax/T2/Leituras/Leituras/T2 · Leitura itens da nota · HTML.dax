/*
@pasta: T2 Análise crítica\Leituras
@formato: texto
@descricao: Leitura do "?" de Itens da nota, sobre o painel (548 × 767, desde a F3; era 372 × 388): a nota e o status da obra em foco (ou, pendente, quantos itens faltam e quanto já perde) e de onde vêm os pontos perdidos; a matriz item × mês com as marcas dos pontos e a linha da obra com o status de cada mês. Só lê contas.
@gerado: pbi/scripts/leituras_t2.py
*/
-- 1 · Leituras
VAR _ref = [Mês de referência]
VAR _obra = [Nota · obra em foco]
VAR _mesC = [Mês de referência · curto maiúsculo]
VAR _mesN = [Mês de referência · nome]
VAR _nota = [Nota · nota final · ranking · foco]
VAR _st = [Nota · status · ranking · foco]
VAR _pend = [Nota · pendente · ranking · foco]
VAR _pe = [Nota · pontos perdidos · ranking · foco]
VAR _po = [Nota · pontos possíveis · ranking · foco]
VAR _faltB = [Nota · itens faltando na base · foco] + 0
VAR _faltP = [Nota · itens faltando na planilha · foco] + 0
VAR _fora = [Nota · itens fora da faixa · foco] + 0
VAR _fB = _faltB - _fora
VAR _plL = [Nota · itens faltando na planilha (lista) · foco] & ""
VAR _plF = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = PATHITEM ( _plL, 1 ) )
VAR _perdemCod = [T2 · Leitura · itens que perdem pontos (lista) · foco]
VAR _nPerdem = IF ( _perdemCod = "", 0, PATHLENGTH ( _perdemCod ) ) /* geometria */
VAR _c1 = PATHITEM ( _perdemCod, 1 )
VAR _c2 = PATHITEM ( _perdemCod, 2 )
VAR _c3 = PATHITEM ( _perdemCod, 3 )
VAR _nTopo = [T2 · Leitura · itens que mais perdem (quantos) · foco] + 0
VAR _mx = [T2 · Leitura · pontos de cada item, mês a mês (lista) · foco]
VAR _p1 = CALCULATE ( [Nota · item · perdidos · foco], dItemNota[Item] = _c1 )
VAR _p2 = CALCULATE ( [Nota · item · perdidos · foco], dItemNota[Item] = _c2 )
VAR _f1 = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c1 )
VAR _f2 = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c2 )
VAR _p3 = CALCULATE ( [Nota · item · perdidos · foco], dItemNota[Item] = _c3 )
VAR _f3 = CALCULATE ( [Nota · item · nome em frase], dItemNota[Item] = _c3 )
VAR _itens =
    ADDCOLUMNS (
        VALUES ( dItemNota[Item] ),
        "@o", [Nota · item · ordem],
        "@rot", [Nota · item · nome curto]
    )
VAR _meses =
    ADDCOLUMNS (
        VALUES ( dMes[Mes] ),
        "@ate", [Série · mês até a referência],
        "@ord", [Mês · ordem],
        "@rot", [Mês · abreviado]
    )
VAR _serie = FILTER ( _meses, [@ate] = 1 ) /* lista */
VAR _nCol = COUNTROWS ( _serie ) /* geometria */
-- 2 · Textos
VAR _nN = FORMAT ( _nota, "0.0#", "pt-BR" )
VAR _nOb = FORMAT ( [Nota · pontos obtidos · ranking · foco], "0.0#", "pt-BR" )
VAR _nPo = FORMAT ( _po, "0.0#", "pt-BR" )
VAR _nTxt = SWITCH ( TRUE (), _pend = 1, "pendente · " & _nOb & " de " & _nPo, ISBLANK ( _nota ), "—", "nota " & _nN )
VAR _tpeTxt = IF ( ISBLANK ( _pe ), "—", FORMAT ( _pe, "0.0#", "pt-BR" ) )
VAR _tpoTxt = IF ( ISBLANK ( _po ), "—", FORMAT ( _po, "0.0#", "pt-BR" ) )
VAR _tp1Txt = IF ( ISBLANK ( _p1 ), "—", FORMAT ( _p1, "0.0#", "pt-BR" ) )
VAR _tp2Txt = IF ( ISBLANK ( _p2 ), "—", FORMAT ( _p2, "0.0#", "pt-BR" ) )
VAR _txtSob = "LEITURA · ITENS DA NOTA · " & UPPER ( _obra ) & " · " & _mesC
VAR _de1 = SWITCH ( TRUE (), LEFT ( _f1, 3 ) = "os ", "dos " & MID ( _f1, 4, 99 ), LEFT ( _f1, 3 ) = "as ", "das " & MID ( _f1, 4, 99 ), LEFT ( _f1, 2 ) = "o ", "do " & MID ( _f1, 3, 99 ), LEFT ( _f1, 2 ) = "a ", "da " & MID ( _f1, 3, 99 ), _f1 )
VAR _de2 = SWITCH ( TRUE (), LEFT ( _f2, 3 ) = "os ", "dos " & MID ( _f2, 4, 99 ), LEFT ( _f2, 3 ) = "as ", "das " & MID ( _f2, 4, 99 ), LEFT ( _f2, 2 ) = "o ", "do " & MID ( _f2, 3, 99 ), LEFT ( _f2, 2 ) = "a ", "da " & MID ( _f2, 3, 99 ), _f2 )
VAR _de3 = SWITCH ( TRUE (), LEFT ( _f3, 3 ) = "os ", "dos " & MID ( _f3, 4, 99 ), LEFT ( _f3, 3 ) = "as ", "das " & MID ( _f3, 4, 99 ), LEFT ( _f3, 2 ) = "o ", "do " & MID ( _f3, 3, 99 ), LEFT ( _f3, 2 ) = "a ", "da " & MID ( _f3, 3, 99 ), _f3 )
VAR _em1 = SWITCH ( TRUE (), LEFT ( _f1, 3 ) = "os ", "nos " & MID ( _f1, 4, 99 ), LEFT ( _f1, 3 ) = "as ", "nas " & MID ( _f1, 4, 99 ), LEFT ( _f1, 2 ) = "o ", "no " & MID ( _f1, 3, 99 ), LEFT ( _f1, 2 ) = "a ", "na " & MID ( _f1, 3, 99 ), _f1 )
VAR _em2 = SWITCH ( TRUE (), LEFT ( _f2, 3 ) = "os ", "nos " & MID ( _f2, 4, 99 ), LEFT ( _f2, 3 ) = "as ", "nas " & MID ( _f2, 4, 99 ), LEFT ( _f2, 2 ) = "o ", "no " & MID ( _f2, 3, 99 ), LEFT ( _f2, 2 ) = "a ", "na " & MID ( _f2, 3, 99 ), _f2 )
VAR _em3 = SWITCH ( TRUE (), LEFT ( _f3, 3 ) = "os ", "nos " & MID ( _f3, 4, 99 ), LEFT ( _f3, 3 ) = "as ", "nas " & MID ( _f3, 4, 99 ), LEFT ( _f3, 2 ) = "o ", "no " & MID ( _f3, 3, 99 ), LEFT ( _f3, 2 ) = "a ", "na " & MID ( _f3, 3, 99 ), _f3 )
VAR _seg = _nTopo = 1 && _nPerdem >= 2 && ( _nPerdem = 2 || ROUND ( _p2 - _p3, 8 ) <> 0 )
VAR _deTopo = SWITCH ( _nTopo, 1, _de1, 2, _de1 & " e " & _de2, 3, _de1 & ", " & _de2 & " e " & _de3, "de " & SWITCH ( _nTopo, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _nTopo, "0" ) ) & " itens empatados" )
VAR _emTopo = SWITCH ( _nTopo, 1, _em1, 2, _em1 & " e " & _em2, 3, _em1 & ", " & _em2 & " e " & _em3, "em " & SWITCH ( _nTopo, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _nTopo, "0" ) ) & " itens empatados" )
VAR _txtOnde =
    SWITCH (
        TRUE (),
        _nPerdem = 1, "todos " & _de1,
        _nTopo = _nPerdem, "todos " & _deTopo & ", " & "⁅" & _tp1Txt & "⁆" & " cada",
        _nTopo > 3, _deTopo & ", " & "⁅" & _tp1Txt & "⁆" & " cada",
        _nTopo > 1, "mais " & _deTopo & ", " & "⁅" & _tp1Txt & "⁆" & " cada",
        _seg, "mais " & _de1 & " (" & "⁅" & _tp1Txt & "⁆" & ") e " & _de2 & " (" & "⁅" & _tp2Txt & "⁆" & ")",
        "mais " & _de1 & " (" & "⁅" & _tp1Txt & "⁆" & ")"
    )
VAR _txtTotal = IF ( _tpeTxt = _nN || _tpeTxt = _tp1Txt, "Os pontos perdidos", "Os " & "⁅" & _tpeTxt & "⁆" & " pontos perdidos" )
VAR _txtFalta =
    SWITCH ( TRUE (),
        _fB > 0 && _faltP > 0, "faltam " & SWITCH ( _fB + _faltP, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _fB + _faltP, "0" ) ) & " itens, " & SWITCH ( _faltP, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _faltP, "0" ) ) & " na planilha",
        _fB > 0, IF ( _fB = 1, "falta um item", "faltam " & SWITCH ( _fB, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _fB, "0" ) ) & " itens" ) & " na base",
        _faltP > 0, IF ( _faltP = 1, "falta " & _plF, "faltam " & SWITCH ( _faltP, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _faltP, "0" ) ) & " itens" ) & " na planilha",
        ""
    )
VAR _txtFora =
    IF ( _fora = 0, "",
        IF ( _txtFalta = "",
            IF ( _fora = 1, "um item está fora da faixa", SWITCH ( _fora, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _fora, "0" ) ) & " itens estão fora da faixa" ),
            "; " & IF ( _fora = 1, "um está fora da faixa", SWITCH ( _fora, 0, "nenhum", 1, "um", 2, "dois", 3, "três", 4, "quatro", 5, "cinco", 6, "seis", 7, "sete", 8, "oito", 9, "nove", 10, "dez", FORMAT ( _fora, "0" ) ) & " estão fora da faixa" ) ) )
VAR _txtAchado =
    SWITCH (
        TRUE (),
        _pend = 1,
            "Pendente: " & _txtFalta & _txtFora & ". "
            & IF ( _pe = 0, "No que já dá para calcular, não perde ponto.",
                "No que já dá para calcular, perde " & "⁅" & _tpeTxt & "⁆" & " de " & "⁅" & _tpoTxt & "⁆" & ", mais " & _emTopo & "." ),
        _pe = 0, "Nota " & "⁅" & _nN & "⁆" & ", " & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & ": não perde ponto em nenhum item.",
        "Nota " & "⁅" & _nN & "⁆" & ", " & IF ( _st = 1, "em ", "" ) & SWITCH ( TRUE (), _pend = 1, "pendente", ISBLANK ( _st ), "", _st = 2, "crítico", _st = 1, "atenção", "estável" ) & ". " & _txtTotal & " vêm " & _txtOnde & "."
    )
VAR _htmlCab =
    "<span></span>" & CONCATENATEX (
        _serie,
        VAR _vePar = _nCol <= 7 || MOD ( DATEDIFF ( dMes[Mes], _ref, MONTH ), 2 ) = 0
        RETURN
            "<span class='h a-fd" & IF ( dMes[Mes] = _ref, " ref", "" ) & "' style='animation-delay:" & ( [@ord] - 1 ) * 100 & "ms'>" & IF ( _vePar, [@rot], "" ) & "</span>",
        "",
        dMes[Mes], ASC
    )
VAR _htmlLinhas =
    CONCATENATEX (
        _itens,
        VAR _i = dItemNota[Item]
        RETURN
            "<span class='r'>" & [@rot] & "</span>"
                & CONCATENATEX (
                    _serie,
                    VAR _m = dMes[Mes]
                    VAR _k = _i & "@" & FORMAT ( _m, "yyyymm" ) & "="
                    VAR _pk = SEARCH ( _k, _mx, 1, 0 )
                    VAR _c = IF ( _pk = 0, "f", MID ( _mx, _pk + LEN ( _k ), 1 ) )
                    VAR _cls = SWITCH ( _c, "c", "mk0", "p", "mk1", "z", "mk2", "n", "mkn", "x", "mkx", "mkm" )
                    VAR _atraso = ( [@ord] - 1 ) * 100 -- geometria
                    RETURN
                        "<span class='c'><i class='mk " & _cls & "' style='animation-delay:" & _atraso & "ms'></i></span>",
                    "",
                    dMes[Mes], ASC
                ),
        "",
        [@o], ASC
    )
VAR _htmlObra =
    "<span class='r ob'>Obra</span>" & CONCATENATEX (
        _serie,
        VAR _atraso = 600 + ( [@ord] - 1 ) * 100 -- geometria
        VAR _k = "obra@" & FORMAT ( dMes[Mes], "yyyymm" ) & "="
        VAR _pk = SEARCH ( _k, _mx, 1, 0 )
        VAR _c = IF ( _pk = 0, "", MID ( _mx, _pk + LEN ( _k ), 1 ) )
        VAR _mk = IF ( _c IN { "", "|" }, "", "<i class='mk mk" & _c & "'></i>" )
        RETURN
            "<span class='c ob'>" & SUBSTITUTE ( _mk, "'></i>", "' style='animation-delay:" & _atraso & "ms'></i>" ) & "</span>",
        "",
        dMes[Mes], ASC
    )
VAR _htmlLeg =
    "<p class='lg'><i class='mk mk0'></i>cheio<i class='mk mk1'></i>parcial<i class='mk mk2'></i>zero"
        & "<i class='mk mkm'></i>sem dado" & IF ( SEARCH ( "=x", _mx, 1, 0 ) > 0, "<i class='mk mkx'></i>fora", "" ) & "</p>"
-- 4 · Marcação
VAR _corpo =
    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _txtAchado & "</h2>"
        & "<div class='sec' style='margin-top:10px'><span class='vs'>Pontos de cada item, mês a mês</span>"
        & "<div class='mx c8' style='grid-template-columns:132px repeat(" & _nCol & ",1fr)'>" & _htmlCab & _htmlLinhas & _htmlObra & "</div>" & _htmlLeg & "</div>"
VAR _saidaHtml =
    IF ( NOT ISBLANK ( _po ), "<div class='u lv' role='dialog' aria-label='" & "Leitura de Itens da nota" & "'><div class='pn e it'>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida] )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
