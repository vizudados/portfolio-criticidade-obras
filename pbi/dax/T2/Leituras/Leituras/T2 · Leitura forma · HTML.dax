/*
@pasta: T2 Análise crítica\Leituras
@formato: texto
@descricao: Leitura do "?" de Como o resultado se forma, sobre o painel (508 × 350, condensada): o que a obra agregou contra o que já virou obra (resultado aplicado e IDC), quanto da planilha ainda vai se realizar (saldo de contrato e equipamentos) e três destaques que contam. Só lê contas.
@gerado: pbi/scripts/leituras_t2.py
*/
-- 1 · Leituras
VAR _obra = [Nota · obra em foco]
VAR _va = [Crédito do orçamento · foco]
VAR _ca = [Custo aplicado · foco]
VAR _ra = [Resultado aplicado · foco]
VAR _ar = [A realizar · foco]
VAR _res = [Resultado da obra · foco]
VAR _idc = [IDC · foco]
VAR _divida = [Dívida da obra · foco]
-- 2 · Textos
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _tvaA = ABS ( _va )
VAR _tvaNu = SWITCH ( TRUE (), _tvaA >= 99950000, FORMAT ( _tvaA / 1000000, "0.0", "pt-BR" ), _tvaA >= 999500, FORMAT ( _tvaA / 1000000, "0.00", "pt-BR" ), _tvaA >= 999.5, FORMAT ( _tvaA / 1000, "0", "pt-BR" ), FORMAT ( _tvaA, "#,0", "pt-BR" ) )
VAR _tvaUn = SWITCH ( TRUE (), _tvaA >= 999500, " mi", _tvaA >= 999.5, " mil", "" )
VAR _tvaN = _tvaNu & _tvaUn
VAR _tvaZero = _tvaN = "0"
VAR _tvaS = IF ( _tvaZero, "", IF ( _va < 0, "−", "" ) )
VAR _tvaTxt = IF ( ISBLANK ( _va ), "—", _tvaS & "R$ " & _tvaN )
VAR _tcaA = ABS ( _ca )
VAR _tcaNu = SWITCH ( TRUE (), _tcaA >= 99950000, FORMAT ( _tcaA / 1000000, "0.0", "pt-BR" ), _tcaA >= 999500, FORMAT ( _tcaA / 1000000, "0.00", "pt-BR" ), _tcaA >= 999.5, FORMAT ( _tcaA / 1000, "0", "pt-BR" ), FORMAT ( _tcaA, "#,0", "pt-BR" ) )
VAR _tcaUn = SWITCH ( TRUE (), _tcaA >= 999500, " mi", _tcaA >= 999.5, " mil", "" )
VAR _tcaN = _tcaNu & _tcaUn
VAR _tcaZero = _tcaN = "0"
VAR _tcaS = IF ( _tcaZero, "", IF ( _ca < 0, "−", "" ) )
VAR _tcaTxt = IF ( ISBLANK ( _ca ), "—", _tcaS & "R$ " & _tcaN )
VAR _traA = ABS ( _ra )
VAR _traNu = SWITCH ( TRUE (), _traA >= 99950000, FORMAT ( _traA / 1000000, "0.0", "pt-BR" ), _traA >= 999500, FORMAT ( _traA / 1000000, "0.00", "pt-BR" ), _traA >= 999.5, FORMAT ( _traA / 1000, "0", "pt-BR" ), FORMAT ( _traA, "#,0", "pt-BR" ) )
VAR _traUn = SWITCH ( TRUE (), _traA >= 999500, " mi", _traA >= 999.5, " mil", "" )
VAR _traN = _traNu & _traUn
VAR _traZero = _traN = "0"
VAR _traS = IF ( _traZero, "", SWITCH ( TRUE (), _ra < 0, "−", _ra > 0, "+", "" ) )
VAR _traTxt = IF ( ISBLANK ( _ra ), "—", _traS & "R$ " & _traN )
VAR _tarA = ABS ( _ar )
VAR _tarNu = SWITCH ( TRUE (), _tarA >= 99950000, FORMAT ( _tarA / 1000000, "0.0", "pt-BR" ), _tarA >= 999500, FORMAT ( _tarA / 1000000, "0.00", "pt-BR" ), _tarA >= 999.5, FORMAT ( _tarA / 1000, "0", "pt-BR" ), FORMAT ( _tarA, "#,0", "pt-BR" ) )
VAR _tarUn = SWITCH ( TRUE (), _tarA >= 999500, " mi", _tarA >= 999.5, " mil", "" )
VAR _tarN = _tarNu & _tarUn
VAR _tarZero = _tarN = "0"
VAR _tarS = IF ( _tarZero, "", IF ( _ar < 0, "−", "" ) )
VAR _tarTxt = IF ( ISBLANK ( _ar ), "—", _tarS & "R$ " & _tarN )
VAR _tresA = ABS ( _res )
VAR _tresNu = SWITCH ( TRUE (), _tresA >= 99950000, FORMAT ( _tresA / 1000000, "0.0", "pt-BR" ), _tresA >= 999500, FORMAT ( _tresA / 1000000, "0.00", "pt-BR" ), _tresA >= 999.5, FORMAT ( _tresA / 1000, "0", "pt-BR" ), FORMAT ( _tresA, "#,0", "pt-BR" ) )
VAR _tresUn = SWITCH ( TRUE (), _tresA >= 999500, " mi", _tresA >= 999.5, " mil", "" )
VAR _tresN = _tresNu & _tresUn
VAR _tresZero = _tresN = "0"
VAR _tresS = IF ( _tresZero, "", SWITCH ( TRUE (), _res < 0, "−", _res > 0, "+", "" ) )
VAR _tresTxt = IF ( ISBLANK ( _res ), "—", _tresS & "R$ " & _tresN )
VAR _tdvA = ABS ( _divida )
VAR _tdvNu = SWITCH ( TRUE (), _tdvA >= 99950000, FORMAT ( _tdvA / 1000000, "0.0", "pt-BR" ), _tdvA >= 999500, FORMAT ( _tdvA / 1000000, "0.00", "pt-BR" ), _tdvA >= 999.5, FORMAT ( _tdvA / 1000, "0", "pt-BR" ), FORMAT ( _tdvA, "#,0", "pt-BR" ) )
VAR _tdvUn = SWITCH ( TRUE (), _tdvA >= 999500, " mi", _tdvA >= 999.5, " mil", "" )
VAR _tdvN = _tdvNu & _tdvUn
VAR _tdvZero = _tdvN = "0"
VAR _tdvS = IF ( _tdvZero, "", IF ( _divida < 0, "−", "" ) )
VAR _tdvTxt = IF ( ISBLANK ( _divida ), "—", _tdvS & "R$ " & _tdvN )
VAR _tvaKP = LEN ( _tvaNu ) > 0
VAR _tvaKN = IF ( _tvaKP, _tvaNu )
VAR _tvaKS = SUBSTITUTE ( SUBSTITUTE ( _tvaKN, ".", "" ), ",", "" )
VAR _tvaKT = IFERROR ( VALUE ( _tvaKS ), -1 )
VAR _tvaKOk = _tvaKP && _tvaKT >= 2 && FORMAT ( _tvaKT, REPT ( "0", LEN ( _tvaKS ) ) ) = _tvaKS
VAR _tvaKD = IF ( CONTAINSSTRING ( _tvaKN, "," ), LEN ( _tvaKN ) - SEARCH ( ",", _tvaKN ), 0 )
VAR _tvaKM = IF ( CONTAINSSTRING ( _tvaKN, "." ), "#,##0", "0" ) & IF ( _tvaKD > 0, "." & REPT ( "0", _tvaKD ) )
VAR _tvaKOd =
    IF (
        _tvaKOk,
        "<o-d><o-v>" & _tvaKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tvaKN, FORMAT ( ROUND ( _tvaKT * [@odf] / 1000, 0 ) / POWER ( 10, _tvaKD ), _tvaKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tvaNu
    )
VAR _tvaOd = IF ( ISBLANK ( _va ), _tvaTxt, _tvaS & "R$ " & _tvaKOd & _tvaUn )
VAR _tcaKP = LEN ( _tcaNu ) > 0
VAR _tcaKN = IF ( _tcaKP, _tcaNu )
VAR _tcaKS = SUBSTITUTE ( SUBSTITUTE ( _tcaKN, ".", "" ), ",", "" )
VAR _tcaKT = IFERROR ( VALUE ( _tcaKS ), -1 )
VAR _tcaKOk = _tcaKP && _tcaKT >= 2 && FORMAT ( _tcaKT, REPT ( "0", LEN ( _tcaKS ) ) ) = _tcaKS
VAR _tcaKD = IF ( CONTAINSSTRING ( _tcaKN, "," ), LEN ( _tcaKN ) - SEARCH ( ",", _tcaKN ), 0 )
VAR _tcaKM = IF ( CONTAINSSTRING ( _tcaKN, "." ), "#,##0", "0" ) & IF ( _tcaKD > 0, "." & REPT ( "0", _tcaKD ) )
VAR _tcaKOd =
    IF (
        _tcaKOk,
        "<o-d><o-v>" & _tcaKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tcaKN, FORMAT ( ROUND ( _tcaKT * [@odf] / 1000, 0 ) / POWER ( 10, _tcaKD ), _tcaKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tcaNu
    )
VAR _tcaOd = IF ( ISBLANK ( _ca ), _tcaTxt, _tcaS & "R$ " & _tcaKOd & _tcaUn )
VAR _tarKP = LEN ( _tarNu ) > 0
VAR _tarKN = IF ( _tarKP, _tarNu )
VAR _tarKS = SUBSTITUTE ( SUBSTITUTE ( _tarKN, ".", "" ), ",", "" )
VAR _tarKT = IFERROR ( VALUE ( _tarKS ), -1 )
VAR _tarKOk = _tarKP && _tarKT >= 2 && FORMAT ( _tarKT, REPT ( "0", LEN ( _tarKS ) ) ) = _tarKS
VAR _tarKD = IF ( CONTAINSSTRING ( _tarKN, "," ), LEN ( _tarKN ) - SEARCH ( ",", _tarKN ), 0 )
VAR _tarKM = IF ( CONTAINSSTRING ( _tarKN, "." ), "#,##0", "0" ) & IF ( _tarKD > 0, "." & REPT ( "0", _tarKD ) )
VAR _tarKOd =
    IF (
        _tarKOk,
        "<o-d><o-v>" & _tarKN & "</o-v><o-t aria-hidden='true'>"
            & CONCATENATEX (
                _odQ,
                IF ( [@odk] = 24, _tarKN, FORMAT ( ROUND ( _tarKT * [@odf] / 1000, 0 ) / POWER ( 10, _tarKD ), _tarKM, "pt-BR" ) ),
                UNICHAR ( 10 ),
                [@odk], ASC
            )
            & "</o-t></o-d>",
        _tarNu
    )
VAR _tarOd = IF ( ISBLANK ( _ar ), _tarTxt, _tarS & "R$ " & _tarKOd & _tarUn )
VAR _txtIdc = FORMAT ( _idc, "0.00", "pt-BR" )
VAR _txtSob = "LEITURA · COMO O RESULTADO SE FORMA · " & UPPER ( _obra ) & " · " & [Mês de referência · curto maiúsculo]
VAR _txtAchado =
    IF (
        _ra >= 0,
        "A obra agregou mais do que gastou no que executou: resultado aplicado de " & "<span class='nw'>" & "⁅" & _traTxt & "⁆" & "</span>" & ", IDC " & "⁅" & _txtIdc & "⁆" & ".",
        "A obra gastou mais do que agregou no que executou: resultado aplicado de " & "<span class='nw'>" & "<span class='ng'>" & "⁅" & _traTxt & "⁆" & "</span>" & "</span>" & ", IDC " & "⁅" & _txtIdc & "⁆" & "."
    )
VAR _txtExplica =
    SWITCH (
        TRUE (),
        ISBLANK ( _ar ) || _ar = 0, "A planilha não soma nada a realizar: o resultado dela é o aplicado.",
        _ra < 0 && _res >= 0, "A planilha mostra " & "<span class='nw'>" & "⁅" & _tresTxt & "⁆" & "</span>" & " porque soma " & "<span class='nw'>" & "⁅" & _tarTxt & "⁆" & "</span>" & " a realizar (saldo de contrato e equipamentos), que ainda não aconteceu.",
        "A planilha soma " & "<span class='nw'>" & "⁅" & _tarTxt & "⁆" & "</span>" & " a realizar (saldo de contrato e equipamentos) e chega a " & "<span class='nw'>" & "⁅" & _tresTxt & "⁆" & "</span>" & "."
    )
    & IF ( _divida > 0, " A dívida da obra (" & "<span class='nw'>" & "⁅" & _tdvTxt & "⁆" & "</span>" & ") entra no custo.", "" )
-- 4 · Marcação
VAR _htmlDst =
    "<div class='dst sobre-creme'>"
        & "<div><b>" & _tvaOd & "</b><span>" & "agregados: o executado vezes o orçamento" & "</span></div>"
        & "<div><b>" & _tcaOd & "</b><span>" & "de custo do que já virou obra, com a dívida" & "</span></div>"
        & "<div><b>" & _tarOd & "</b><span>" & "a realizar: a planilha conta e ainda não aconteceu" & "</span></div>"
    & "</div>"
VAR _corpo =
    "<span class='vs sob'>" & _txtSob & "</span><h2 class='ach'>" & _txtAchado & "</h2>"
        & "<p class='exp'>" & _txtExplica & "</p>" & _htmlDst
VAR _saidaHtml =
    IF ( NOT ISBLANK ( _res ), "<div class='u lv' role='dialog' aria-label='" & "Leitura de Como o resultado se forma" & "'><div class='pn '>" & _corpo & "</div><svg class='x' width='26' height='26' viewBox='0 0 26 26' aria-hidden='true'><circle cx='13' cy='13' r='12.375' fill='#FFFFFF' stroke='#3B3B3F' stroke-width='1.25'/><path d='M9 9L17 17M17 9L9 17' fill='none' stroke='#0B0B0C' stroke-width='1.5' stroke-linecap='round'/></svg></div>" & [Comum · JS contador tooltip] & [Comum · JS corrida] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
