/*
@pasta: T2 Análise crítica\O quadradinho\Contas
@formato: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
@descricao: [Item · valor] da obra em foco no mês do eixo (séries do tooltip do item).
@gerado: pbi/scripts/contas_t2.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    CALCULATE ( [Item · valor], dObra[Obra] = _obra )
