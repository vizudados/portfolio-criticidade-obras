/*
@pasta: T2 Análise crítica\Nota, mês a mês
@formato: texto
@descricao: A nota da obra em foco mês a mês na janela: barras na cor do status (pendente tracejado até os pontos obtidos) de 0 ao máximo da nota, linhas tracejadas nos limites de estável e de atenção (lidos das medidas), rótulo no mês de referência, na maior e na menor nota, e embaixo uma linha com o que a nota fez desde o primeiro mês da janela.
@gerado: pbi/scripts/desenho_t2.py
*/
-- 1 · Leituras
VAR _ref = [Mês de referência]
VAR _n = [Série · meses até a referência]
VAR _max = [Nota · nota · máximo]
VAR _limA = [Nota · status · nota mínima atenção]
VAR _limE = [Nota · status · nota mínima estável]
VAR _todos =
    ADDCOLUMNS (
        VALUES ( dMes[Mes] ),
        "@ate", [Série · mês até a referência],
        "@pos", [Série · posição na janela],
        "@rotAno", [Mês · rótulo curto],
        "@rot", [Mês · abreviado],
        "@nota", [Nota · nota final · foco no mês],
        "@st", [Nota · status · foco no mês],
        "@pend", [Nota · pendente · foco no mês],
        "@obt", [Nota · pontos obtidos · foco no mês]
    )
VAR _meses = FILTER ( _todos, [@ate] = 1 ) /* lista */
VAR _com = FILTER ( _meses, NOT ISBLANK ( [@nota] ) ) /* lista */
VAR _vMax = MAXX ( _com, [@nota] ) /* geometria */
VAR _vMin = MINX ( _com, [@nota] ) /* geometria */
VAR _mMax = MAXX ( FILTER ( _com, [@nota] = _vMax ), dMes[Mes] ) /* geometria */
VAR _mMin = MAXX ( FILTER ( _com, [@nota] = _vMin ), dMes[Mes] ) /* geometria */
VAR _ini = MINX ( _com, dMes[Mes] ) /* geometria */
VAR _nIni = MAXX ( FILTER ( _com, dMes[Mes] = _ini ), [@nota] ) /* geometria */
VAR _nRef = MAXX ( FILTER ( _com, dMes[Mes] = _ref ), [@nota] ) /* geometria */
-- 3 · Geometria
VAR _slot = DIVIDE ( 372, _n ) -- geometria
VAR _bw = MIN ( 24, ROUND ( _slot - 8, 0 ) ) -- geometria
VAR _k = DIVIDE ( 196, _max ) -- geometria
VAR _yA = 220 - ROUND ( _limA * _k, 0 ) -- geometria
VAR _yE = 220 - ROUND ( _limE * _k, 0 ) -- geometria
VAR _passo = ROUND ( DIVIDE ( 420, _n ), 0 ) -- geometria
-- 2 · Textos
VAR _txtVar =
    SWITCH (
        TRUE (),
        ISBLANK ( _nRef ), "sem nota no mês de referência",
        _ini = _ref || ISBLANK ( _nIni ), "primeiro mês com nota na janela",
        ROUND ( _nRef, 2 ) = ROUND ( _nIni, 2 ), "mesma nota de " & FORMAT ( _ini, "mmm/yy", "pt-BR" ),
        "de " & "⁅" & FORMAT ( _nIni, "0.0#", "pt-BR" ) & "⁆" & " em " & FORMAT ( _ini, "mmm/yy", "pt-BR" ) & " para " & "⁅" & FORMAT ( _nRef, "0.0#", "pt-BR" ) & "⁆" & " agora"
    )
-- 4 · Marcação
VAR _barras =
    CONCATENATEX (
        _meses,
        VAR _pd = [@pend] = 1
        VAR _v = IF ( _pd, [@obt], [@nota] )
        VAR _tem = NOT ISBLANK ( _v )
        VAR _h = IF ( _tem, MAX ( ROUND ( _v * _k, 0 ), 2 ), 0 ) /* geometria */
        VAR _xc = ROUND ( ( [@pos] - 0.5 ) * _slot, 0 ) /* geometria */
        VAR _cls = IF ( _pd, "sm", "s" & [@st] )
        VAR _ehRef = dMes[Mes] = _ref
        VAR _rotula = _tem && NOT _pd && ( _ehRef || dMes[Mes] = _mMax || dMes[Mes] = _mMin || _n <= 6 )
        VAR _rotMes = IF ( _n <= 6 || [@pos] = 1 || [@rot] = "jan", [@rotAno], [@rot] )
        VAR _mostraMes = _slot >= 40 || MOD ( _n - [@pos], 2 ) = 0
        VAR _rd = ( [@pos] - 1 ) * _passo /* geometria */
        RETURN
            IF ( _tem, "<i class='b " & _cls & "' style='left:" & ( _xc - ROUND ( _bw / 2, 0 ) ) & "px;width:" & _bw & "px;height:" & _h & "px' data-rk='n" & FORMAT ( dMes[Mes], "yyyymm" ) & "' data-rp='height' data-r0-height='0px' data-rd='" & _rd & "'></i>" ) /* geometria */
                & IF ( _rotula, "<span class='v' style='left:" & _xc & "px;top:" & ( 220 - _h - 19 ) & "px'>" & "⁅" & FORMAT ( _v, "0.0#", "pt-BR" ) & "⁆" & "</span>" )
                & IF ( _mostraMes, "<span class='ms a-fd" & IF ( _ehRef, " ref", IF ( _tem, "", " sem" ) ) & "' style='left:" & _xc & "px;top:226px;animation-delay:" & _rd & "ms'>" & _rotMes & "</span>" ),
        "",
        dMes[Mes], ASC
    )
VAR _saidaHtml =
    IF (
        NOT ISEMPTY ( _com ),
        "<div class='u nm2'><div class='ar'>"
            & "<i class='lm a-fd' style='top:" & _yE & "px'><span>estável</span></i>"
            & "<i class='lm a-fd' style='top:" & _yA & "px;animation-delay:80ms'><span>atenção</span></i>"
            & "<i class='z a-gx' style='top:220px'></i>" & _barras & "</div>"
            & "<p class='tx'>" & _txtVar & "</p>"
        & "</div>" & [Comum · JS contador] & [Comum · JS corrida]
    )
/* odômetro (spec/contadores-animacoes.md C2): quadro k de 0 a 24, fração f do easing 1−(1−t)³ em milésimos inteiros, a mesma tabela da capa */
VAR _odQ =
    SELECTCOLUMNS ( { ( 0, 0 ), ( 1, 120 ), ( 2, 230 ), ( 3, 330 ), ( 4, 421 ), ( 5, 504 ), ( 6, 578 ), ( 7, 645 ), ( 8, 704 ), ( 9, 756 ), ( 10, 802 ), ( 11, 841 ), ( 12, 875 ), ( 13, 904 ), ( 14, 928 ), ( 15, 947 ), ( 16, 963 ), ( 17, 975 ), ( 18, 984 ), ( 19, 991 ), ( 20, 995 ), ( 21, 998 ), ( 22, 999 ), ( 23, 1000 ), ( 24, 1000 ) }, "@odk", [Value1], "@odf", [Value2] )
VAR _mcK = LEN ( _saidaHtml ) - LEN ( SUBSTITUTE ( _saidaHtml, "⁅", "" ) )
/* o motor que ignora a cultura do FORMAT devolve 1.5: aí o núcleo troca ponto e vírgula (decimal sempre vírgula) */
VAR _mcEn = FORMAT ( 1.5, "0.0", "pt-BR" ) <> "1,5"
VAR _mcHtml =
    IF (
        _mcK = 0,
        _saidaHtml,
        CONCATENATEX (
            GENERATESERIES ( 1, _mcK ),
            VAR _mcj = [Value]
            VAR _mca = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁅", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf = FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj ) )
            VAR _mcf0 = IF ( _mcj = 1, 0, FIND ( UNICHAR ( 57344 ), SUBSTITUTE ( _saidaHtml, "⁆", UNICHAR ( 57344 ), _mcj - 1 ) ) )
            VAR _mcantes = MID ( _saidaHtml, _mcf0 + 1, MAX ( 0, _mca - _mcf0 - 1 ) )
            VAR _mcdepois = IF ( _mcj = _mcK, MID ( _saidaHtml, _mcf + 1, LEN ( _saidaHtml ) ), "" )
            VAR _mcsg = MID ( _saidaHtml, _mca + 1, MAX ( 0, _mcf - _mca - 1 ) )
            VAR _mci1 = SEARCH ( "¦", _mcsg, 1, 0 )
            VAR _mci2 = IF ( _mci1 > 0, SEARCH ( "¦", _mcsg, _mci1 + 1, 0 ), 0 )
            VAR _mcc = LEN ( _mcsg )
            VAR _mcp0 = MINX ( FILTER ( GENERATESERIES ( 1, MAX ( 1, _mcc ) ), CONTAINSSTRING ( "0123456789", MID ( _mcsg, [Value], 1 ) ) && _mcc > 0 ), [Value] ) /* lista */
            VAR _mcp1 = MINX ( FILTER ( GENERATESERIES ( MAX ( 1, _mcp0 ), _mcc + 1 ), [Value] > _mcc || NOT CONTAINSSTRING ( "0123456789.,", MID ( _mcsg, [Value], 1 ) ) ), [Value] ) /* lista */
            VAR _mcp2 = IF ( _mcp1 - 1 > _mcp0 && CONTAINSSTRING ( ".,", MID ( _mcsg, MAX ( 1, _mcp1 - 1 ), 1 ) ), _mcp1 - 1, _mcp1 )
            VAR _mcpre = IF ( _mci2 > 0, LEFT ( _mcsg, MAX ( 0, _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), _mcsg, LEFT ( _mcsg, MAX ( 0, _mcp0 - 1 ) ) ) )
            VAR _mcnum0 = IF ( _mci2 > 0, MID ( _mcsg, _mci1 + 1, MAX ( 0, _mci2 - _mci1 - 1 ) ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp0 ), MAX ( 0, _mcp2 - _mcp0 ) ) ) )
            VAR _mcnum = IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mcnum0, ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), _mcnum0 )
            VAR _mcsuf = IF ( _mci2 > 0, MID ( _mcsg, _mci2 + 1, _mcc ), IF ( ISBLANK ( _mcp0 ), "", MID ( _mcsg, MAX ( 1, _mcp2 ), _mcc ) ) )
            VAR _mcS = SUBSTITUTE ( SUBSTITUTE ( _mcnum, ".", "" ), ",", "" )
            VAR _mcT = IFERROR ( VALUE ( _mcS ), -1 )
            VAR _mcOk = _mcnum <> "" && _mcT >= 2 && FORMAT ( _mcT, REPT ( "0", LEN ( _mcS ) ) ) = _mcS
            VAR _mcD = IF ( CONTAINSSTRING ( _mcnum, "," ), LEN ( _mcnum ) - SEARCH ( ",", _mcnum, 1, 0 ), 0 )
            VAR _mcM = IF ( CONTAINSSTRING ( _mcnum, "." ), "#,##0", "0" ) & IF ( _mcD > 0, "." & REPT ( "0", _mcD ) )
            RETURN
                _mcantes
                    & IF (
                        _mcOk,
                        "<o-n>" & _mcpre & "<o-d><o-v>" & _mcnum & "</o-v><o-t aria-hidden='true'>"
                            & CONCATENATEX (
                                _odQ,
                                IF ( [@odk] = 24, _mcnum, IF ( _mcEn, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ), ",", UNICHAR ( 57344 ) ), ".", "," ), UNICHAR ( 57344 ), "." ), FORMAT ( ROUND ( _mcT * [@odf] / 1000, 0 ) / POWER ( 10, _mcD ), _mcM, "pt-BR" ) ) ),
                                UNICHAR ( 10 ),
                                [@odk], ASC
                            )
                            & "</o-t></o-d>" & _mcsuf & "</o-n>",
                        _mcpre & _mcnum & _mcsuf
                    )
                    & _mcdepois,
            "",
            [Value], ASC
        )
    )
RETURN
    _mcHtml
