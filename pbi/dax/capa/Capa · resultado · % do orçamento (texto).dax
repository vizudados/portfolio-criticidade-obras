/*
@pasta: Capa\Contas
@formato: texto
@descricao: Texto do número da capa: [Resultado % · ref] escrito com a regra dos cartões da T1 (percentual com duas casas e sinal (+ ou U+2212)). A capa só lê este texto; o cartão da T1 escreve o mesmo número com a mesma regra.
@oraculo: o texto da T1 (percentual ao lado do número no cartão 'Resultado da carteira' da T1); prova no motor por pbi/scripts/capa_provar.py
@gerado: pbi/scripts/capa_medidas.py
*/
VAR _v = [Resultado % · ref]
-- texto na regra dos cartões da T1 (desenho_projeto: percentual com duas casas e sinal (+ ou U+2212)); vazio = '—'
VAR _tN = FORMAT ( ABS ( _v ) * 100, "0.00", "pt-BR" )
VAR _tS = SWITCH ( TRUE (), ROUND ( _v * 100, 2 ) < 0, "−", ROUND ( _v * 100, 2 ) > 0, "+", "" )
VAR _tTxt = IF ( ISBLANK ( _v ), "—", _tS & _tN & "%" )
RETURN
    _tTxt
