/*
@pasta: Capa\Contas
@formato: texto
@descricao: Texto do número da capa: [Físico · desvio acumulado p.p. · ref] escrito com a regra dos cartões da T1 (pontos percentuais com uma casa e sinal (+ ou U+2212)). A capa só lê este texto; o cartão da T1 escreve o mesmo número com a mesma regra.
@oraculo: o texto da T1 (desvio em p.p. na linha de baixo do cartão 'Físico acumulado · ponderado' da T1); prova no motor por pbi/scripts/capa_provar.py
@gerado: pbi/scripts/capa_medidas.py
*/
VAR _v = [Físico · desvio acumulado p.p. · ref]
-- texto na regra dos cartões da T1 (desenho_projeto: pontos percentuais com uma casa e sinal (+ ou U+2212)); vazio = '—'
VAR _tN = FORMAT ( ABS ( _v ), "0.0", "pt-BR" )
VAR _tS = SWITCH ( TRUE (), ROUND ( _v, 1 ) < 0, "−", ROUND ( _v, 1 ) > 0, "+", "" )
VAR _tTxt = IF ( ISBLANK ( _v ), "—", _tS & _tN & " p.p." )
RETURN
    _tTxt
