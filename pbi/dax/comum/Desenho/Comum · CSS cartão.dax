/*
@pasta: Comum\Desenho
@formato: texto
@descricao: CSS dos cartões de KPI com flip (frente e verso no mesmo visual; hover ou foco desliza a frente para cima e o verso creme entra por baixo, docs/06-interacoes-spec.md §1.5).
@gerado: pbi/scripts/desenho_comum.py
*/
-- 4 · Marcação
[Comum · CSS base]
    & ".kc{position:fixed;inset:0;overflow:hidden;outline:none;cursor:default}.kc .lado{position:absolute;inset:0;transition:transform .22s cubic-bezier(.3,.7,.3,1)}.kc .verso{background:"
    & "#E9E0CF;transform:translateY(100%)}.kc:hover .frente,.kc:focus .frente,.kc:focus-within .frente{transform:translateY(-100%)}.kc:hover .verso,.kc:focus .verso,.kc:focus-within .vers"
    & "o{transform:translateY(0)}.kc .eb{left:20px;top:18px;font-size:15px;line-height:18px;letter-spacing:.03px;text-transform:none;color:#3B3B3F}.kc .linha1{position:absolute;left:20px;"
    & "top:40px;display:flex;align-items:baseline;gap:6px;white-space:nowrap}.kc .ctx .mk{margin-right:6px}.kc .hero{font-size:42px;line-height:50px}.kc .lado2{font-size:17px;line-height:"
    & "21px;color:#3B3B3F}.kc .ctx{position:absolute;left:20px;top:102px;width:262px;font-size:14px;line-height:19px;color:#3B3B3F;white-space:nowrap;overflow:hidden;text-overflow:ellipsi"
    & "s}.kc.escuro .frente .vs{color:#E9E0CF}.kc.escuro .frente .hero{color:#FFFFFF}.kc.escuro .frente .lado2{color:#E9E0CF}.kc.escuro .frente .ctx{color:rgba(233,224,207,.85)}.kc .verso"
    & "{display:flex;flex-direction:column;align-items:stretch;padding:14px 20px 9px;box-sizing:border-box}.kc .verso>*{position:static!important;flex:none;margin:0;max-width:262px}.kc .v"
    & "erso .v1{margin-bottom:5px}.kc .verso .regra{font-size:14px;line-height:19px;color:#0B0B0C;white-space:normal}.kc .verso .ond{margin-top:auto;padding-top:5px;display:flex;align-ite"
    & "ms:baseline;white-space:normal}.kc .verso .ond .vs{width:93px;flex:none}.kc .verso .ond span+span{flex:1 1 auto;min-width:0;font-size:14px;line-height:19px;color:#0B0B0C}.kc .verso"
    & " .regua{margin-top:3px;display:flex;flex-wrap:wrap;align-items:center;column-gap:6px;row-gap:1px;font-size:14px;line-height:19px;white-space:nowrap;color:#3B3B3F}.kc .verso.vz .reg"
    & "ra,.kc .verso.vz .ond span+span,.kc .verso.vz .regua{font-size:13px;line-height:17px}.kc .verso .regua .mk{margin-left:4px}.kc .verso .regua .mk:first-child{margin-left:0}.kc .vers"
    & "o .regua .it{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;margin-left:4px}.kc .verso .regua .it:first-child{margin-left:0}.kc .verso .regua .it .mk{margin-left"
    & ":0}"
