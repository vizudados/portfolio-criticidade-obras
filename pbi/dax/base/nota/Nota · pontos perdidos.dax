/*
@pasta: Base\Nota
@formato: 0.00
@descricao: Pontos possíveis − pontos obtidos: ordem das obras, obra em foco e 'onde a carteira perde pontos'.
@oraculo: pipeline/conferir_ficticios.py · prévia da nota (dados/_gabarito/nota_previa.csv)
@gerado: pbi/scripts/contas_base.py
*/
VAR _p = [Nota · pontos possíveis]
RETURN
    IF ( NOT ISBLANK ( _p ), ROUND ( _p - [Nota · pontos obtidos], 8 ) )
