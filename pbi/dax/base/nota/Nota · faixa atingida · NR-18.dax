/*
@pasta: Base\Nota
@formato: texto
@descricao: Faixa do canteiro (NR-18) em que o X caiu (rótulo gerado dos limites). Só com uma obra no contexto (com várias, vazio).
@oraculo: pipeline/conferir_ficticios.py · prévia da nota (dados/_gabarito/nota_previa.csv)
@gerado: pbi/scripts/contas_base.py
*/
IF (
    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
    VAR _x = [Nota · X NR-18]
    RETURN
        IF ( NOT ISBLANK ( _x ), SWITCH (
            TRUE (),
            _x >= 0.95, "conformidade ≥ 95%",
            _x >= 0.85, "85% ≤ conformidade < 95%",
            "conformidade < 85%"
        ) )
)
