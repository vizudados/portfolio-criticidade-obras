/*
@pasta: Base\Nota
@formato: texto
@descricao: Faixa da aprovação na 1.ª inspeção em que o X caiu (rótulo gerado dos limites). Só com uma obra no contexto (com várias, vazio).
@oraculo: pipeline/conferir_ficticios.py · prévia da nota (dados/_gabarito/nota_previa.csv)
@gerado: pbi/scripts/contas_base.py
*/
IF (
    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
    VAR _x = [Nota · X inspeção]
    RETURN
        IF ( NOT ISBLANK ( _x ), SWITCH (
            TRUE (),
            _x >= 0.95, "aprovação ≥ 95%",
            _x >= 0.9, "90% ≤ aprovação < 95%",
            _x >= 0.85, "85% ≤ aprovação < 90%",
            _x >= 0.8, "80% ≤ aprovação < 85%",
            "aprovação < 80%"
        ) )
)
