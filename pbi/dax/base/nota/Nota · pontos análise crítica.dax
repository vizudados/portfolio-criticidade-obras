/*
@pasta: Base\Nota
@formato: 0.00
@descricao: Pontos da análise crítica (máx. 0,5): 3 de 3 → 0,5 · 2 de 3 → 0,25 · 0 ou 1 de 3 → 0; vazio sem dado. Uma obra; com várias, soma.
@oraculo: pipeline/conferir_ficticios.py · prévia da nota (dados/_gabarito/nota_previa.csv)
@gerado: pbi/scripts/contas_base.py
*/
SUMX (
    VALUES ( dObra[Obra] ),
    VAR _x = [Nota · X análise crítica]
    RETURN
        IF ( NOT ISBLANK ( _x ), SWITCH (
            TRUE (),
            _x >= 3, 0.5,
            _x >= 2, 0.25,
            0
        ) )
)
