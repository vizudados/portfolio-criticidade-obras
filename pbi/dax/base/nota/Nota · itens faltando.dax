/*
@pasta: Base\Nota
@formato: 0
@descricao: Itens da nota sem dado (9 no total). Soma pelas obras presentes no contexto.
@oraculo: pipeline/conferir_ficticios.py · prévia da nota (dados/_gabarito/nota_previa.csv)
@gerado: pbi/scripts/contas_base.py
*/
SUMX (
    VALUES ( dObra[Obra] ),
    IF (
        [Nota · obra presente] = 1,
        9
            - (
                INT ( NOT ISBLANK ( [Nota · pontos custo] ) )
                + INT ( NOT ISBLANK ( [Nota · pontos prazo] ) )
                + INT ( NOT ISBLANK ( [Nota · pontos PPC] ) )
                + INT ( NOT ISBLANK ( [Nota · pontos caixa] ) )
                + INT ( NOT ISBLANK ( [Nota · pontos inspeção] ) )
                + INT ( NOT ISBLANK ( [Nota · pontos acidentes] ) )
                + INT ( NOT ISBLANK ( [Nota · pontos NR-18] ) )
                + INT ( NOT ISBLANK ( [Nota · pontos entregas] ) )
                + INT ( NOT ISBLANK ( [Nota · pontos análise crítica] ) )
            )
    )
)
