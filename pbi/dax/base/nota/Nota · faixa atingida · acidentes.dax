/*
@pasta: Base\Nota
@formato: texto
@descricao: Faixa da frequência de acidentes em que o X caiu (rótulo gerado dos limites). Só com uma obra no contexto (com várias, vazio).
@oraculo: pipeline/conferir_ficticios.py · prévia da nota (dados/_gabarito/nota_previa.csv)
@gerado: pbi/scripts/contas_base.py
*/
IF (
    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
    VAR _x = [Nota · X acidentes]
    RETURN
        IF ( NOT ISBLANK ( _x ), SWITCH (
            TRUE (),
            _x <= 0, "TF = 0",
            _x <= 7.5, "0 < TF ≤ 7,5",
            "TF > 7,5"
        ) )
)
