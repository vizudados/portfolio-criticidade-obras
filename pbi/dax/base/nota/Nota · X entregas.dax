/*
@pasta: Base\Nota
@formato: 0.00%
@descricao: PedidosNoPrazo ÷ PedidosPrevistos da base, arredondado em 8 casas; vazio sem PedidosPrevistos ou com a parte maior que o todo. Só com uma obra no contexto (com várias, vazio).
@oraculo: pipeline/conferir_ficticios.py · prévia da nota (dados/_gabarito/nota_previa.csv)
@gerado: pbi/scripts/contas_base.py
*/
IF (
    HASONEVALUE ( dObra[Obra] ),    -- uma obra no contexto; com várias, vazio
    VAR _n = SUM ( fBaseObra[PedidosNoPrazo] )
    VAR _d = SUM ( fBaseObra[PedidosPrevistos] )
    RETURN
        IF ( _d > 0 && NOT ISBLANK ( _n ) && _n >= 0 && _n <= _d, ROUND ( DIVIDE ( _n, _d ), 8 ) )
)
