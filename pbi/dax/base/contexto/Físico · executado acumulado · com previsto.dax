/*
@pasta: Base\Físico
@formato: 0.00%
@descricao: % executado acumulado só das abas que trazem o previsto, ponderado pelo orçamento: o mesmo grupo do previsto e do desvio da carteira (obra sem previsto, ex.: JANGADA, fica fora). Igual ao executado acumulado quando todas têm previsto.
@oraculo: carteira.exec_acum_ponderado (obras com previsto)
@gerado: pbi/scripts/contas_base.py
*/
VAR _linhas = FILTER ( fAnaliseCritica, NOT ISBLANK ( fAnaliseCritica[PrevAcum] ) && NOT ISBLANK ( fAnaliseCritica[ExecAcum] ) )
RETURN
    DIVIDE ( SUMX ( _linhas, fAnaliseCritica[ExecAcum] * fAnaliseCritica[Orcamento] ), SUMX ( _linhas, fAnaliseCritica[Orcamento] ) )
