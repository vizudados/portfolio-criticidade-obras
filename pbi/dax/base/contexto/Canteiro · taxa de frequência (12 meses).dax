/*
@pasta: Base\Canteiro
@formato: 0.0
@descricao: Taxa de frequência de acidentes com afastamento nos 12 meses até o mês (NBR 14280): acidentes × 1.000.000 ÷ HHT.
@gerado: pbi/scripts/contas_base.py
*/
VAR _h = [Canteiro · HHT 12 meses]
RETURN
    IF ( _h > 0, DIVIDE ( [Canteiro · acidentes 12 meses] * 1000000, _h ) )
