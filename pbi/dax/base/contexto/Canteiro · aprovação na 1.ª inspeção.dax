/*
@pasta: Base\Canteiro
@formato: 0.00%
@descricao: Serviços aprovados na primeira inspeção ÷ serviços verificados (na carteira, soma ÷ soma); vazio sem o denominador.
@gerado: pbi/scripts/contas_base.py
*/
VAR _d = [Canteiro · serviços verificados]
RETURN
    IF ( _d > 0, DIVIDE ( [Canteiro · aprovados na 1.ª inspeção], _d ) )
