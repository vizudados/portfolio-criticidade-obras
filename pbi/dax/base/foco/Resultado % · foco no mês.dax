/*
@pasta: Base\Obra em foco
@formato: 0.00%
@descricao: [Resultado %] da obra em foco (a que mais perde pontos na nota, ou a escolhida) no mês do eixo (séries da obra em foco).
@gerado: pbi/scripts/contas_base.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    CALCULATE ( [Resultado %], dObra[Obra] = _obra )
