/*
@pasta: Base\Obra em foco
@formato: texto
@descricao: [Nota · análise crítica · checagens (lista)] da obra em foco (a que mais perde pontos na nota, ou a escolhida), no mês de referência.
@gerado: pbi/scripts/contas_base.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    CALCULATE ( [Nota · análise crítica · checagens (lista) · ref], dObra[Obra] = _obra )
