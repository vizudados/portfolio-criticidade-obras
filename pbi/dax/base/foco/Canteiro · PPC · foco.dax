/*
@pasta: Base\Obra em foco
@formato: 0.00%
@descricao: [Canteiro · PPC] da obra em foco (a que mais perde pontos na nota, ou a escolhida), no mês de referência.
@gerado: pbi/scripts/contas_base.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    CALCULATE ( [Canteiro · PPC · ref], dObra[Obra] = _obra )
