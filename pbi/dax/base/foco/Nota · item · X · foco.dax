/*
@pasta: Base\Obra em foco
@formato: 0.0000
@descricao: [Nota · item · X] da obra em foco (a que mais perde pontos na nota, ou a escolhida), no mês de referência.
@gerado: pbi/scripts/contas_base.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    CALCULATE ( [Nota · item · X · ref], dObra[Obra] = _obra )
