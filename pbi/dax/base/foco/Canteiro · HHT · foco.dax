/*
@pasta: Base\Obra em foco
@formato: #,0
@descricao: [Canteiro · HHT] da obra em foco (a que mais perde pontos na nota, ou a escolhida), no mês de referência.
@gerado: pbi/scripts/contas_base.py
*/
VAR _obra = [Nota · obra em foco]
RETURN
    CALCULATE ( [Canteiro · HHT · ref], dObra[Obra] = _obra )
