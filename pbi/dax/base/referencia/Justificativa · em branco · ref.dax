/*
@pasta: Base\Referência
@formato: 0
@descricao: [Justificativa · em branco] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Justificativa · em branco], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
