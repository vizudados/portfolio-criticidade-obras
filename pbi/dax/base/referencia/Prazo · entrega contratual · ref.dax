/*
@pasta: Base\Referência
@formato: mmm/yy
@descricao: [Prazo · entrega contratual] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Prazo · entrega contratual], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
