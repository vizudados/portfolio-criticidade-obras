/*
@pasta: Base\Referência
@formato: 0
@descricao: [Carteira · justificativas preenchidas] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Carteira · justificativas preenchidas], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
