/*
@pasta: Base\Referência
@formato: 0.00
@descricao: [Nota · pontos NR-18] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Nota · pontos NR-18], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
