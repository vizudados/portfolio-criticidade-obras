/*
@pasta: Base\Referência
@formato: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
@descricao: [Resultado sem ativos] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Resultado sem ativos], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
