/*
@pasta: Base\Referência
@formato: 0.0
@descricao: [Canteiro · taxa de frequência (12 meses)] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Canteiro · taxa de frequência (12 meses)], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
