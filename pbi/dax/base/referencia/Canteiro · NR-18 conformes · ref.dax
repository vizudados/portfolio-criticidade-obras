/*
@pasta: Base\Referência
@formato: 0
@descricao: [Canteiro · NR-18 conformes] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Canteiro · NR-18 conformes], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
