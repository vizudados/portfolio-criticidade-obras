/*
@pasta: Base\Referência
@formato: 0.00
@descricao: [Nota · pontos possíveis] no mês de referência (seletor do drawer; sem escolha, o último mês), lida da linha de dRankingNota (a mesma medida, guardada no refresh), sem recalcular os itens.
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
VAR _p =
    SUMX (
        FILTER ( dRankingNota, dRankingNota[Mes] = _mes && dRankingNota[Obra] IN VALUES ( dObra[Obra] ) ),
        dRankingNota[Possiveis]
    )
RETURN
    IF ( NOT ISBLANK ( _p ), ROUND ( _p, 8 ) )
