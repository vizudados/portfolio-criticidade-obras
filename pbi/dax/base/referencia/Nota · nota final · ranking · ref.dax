/*
@pasta: Base\Referência
@formato: 0.00
@descricao: [Nota · nota final] no mês de referência (seletor do drawer; sem escolha, o último mês), lida da linha de dRankingNota (a mesma medida, guardada no refresh), sem recalcular os itens.
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
VAR _o = SELECTEDVALUE ( dObra[Obra] )
VAR _linha = FILTER ( dRankingNota, dRankingNota[Obra] = _o && dRankingNota[Mes] = _mes )
RETURN
    IF ( HASONEVALUE ( dObra[Obra] ), VAR _n = MAXX ( _linha, dRankingNota[NotaOrdem] ) RETURN IF ( _n <> 99, _n ) )
