/*
@pasta: Base\Referência
@formato: +0.00;-0.00;0.00
@descricao: [Resultado · variação p.p.] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Resultado · variação p.p.], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
