/*
@pasta: Base\Referência
@formato: 0.00
@descricao: [Nota · possíveis · caixa] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Nota · possíveis · caixa], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
