/*
@pasta: Base\Referência
@formato: 0.00%
@descricao: [Canteiro · aprovação na 1.ª inspeção] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Canteiro · aprovação na 1.ª inspeção], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
