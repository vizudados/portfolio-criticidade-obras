/*
@pasta: Base\Referência
@formato: 0.00%
@descricao: [Canteiro · entregas no prazo] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Canteiro · entregas no prazo], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
