/*
@pasta: Base\Referência
@formato: 0.00%
@descricao: [Físico · executado acumulado · com previsto] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Físico · executado acumulado · com previsto], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
