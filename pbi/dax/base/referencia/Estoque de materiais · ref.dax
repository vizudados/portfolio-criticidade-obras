/*
@pasta: Base\Referência
@formato: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
@descricao: [Estoque de materiais] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Estoque de materiais], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
