/*
@pasta: Base\Referência
@formato: texto
@descricao: [Justificativa do desembolso] no mês de referência (seletor do drawer; sem escolha, o último mês).
@gerado: pbi/scripts/contas_base.py
*/
VAR _mes = [Mês de referência]
RETURN
    CALCULATE ( [Justificativa do desembolso], REMOVEFILTERS ( dMes ), dMes[Mes] = _mes )
