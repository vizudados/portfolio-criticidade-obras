/*
@pasta: Base\Recorte
@formato: 0
@descricao: 1 quando a obra em foco foi escolhida no drawer; 0 quando vale a mais crítica do mês (linha automática).
@gerado: pbi/scripts/contas_base.py
*/
VAR _auto = SELECTEDVALUE ( dObraFoco[Automatico], TRUE () )
RETURN
    IF ( ISFILTERED ( dObraFoco ) && NOT _auto, 1, 0 )
